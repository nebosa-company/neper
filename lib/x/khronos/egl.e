// An entry point by C name: `eglGetProcAddress` first, then the library's export.
fn proc_address(a: *mem.Arena, context: usize, name: str) -> usize {
    if !loaded || name.len >= 127usize { ret 0usize }
    var buffer: [128]u8 = zero
    var k = 0usize
