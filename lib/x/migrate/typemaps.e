// An Airtable view type as an Appdor view type; anything unlisted is a `grid`, which shows every row.
fn airtable_view_type(key: str) -> str {
    if str.eq(key, "grid") { ret "grid" }
    if str.eq(key, "kanban") { ret "kanban" }
    if str.eq(key, "calendar") { ret "calendar" }
    if str.eq(key, "gallery") { ret "gallery" }
    if str.eq(key, "form") { ret "form" }
    if str.eq(key, "timeline") { ret "timeline" }
    if str.eq(key, "gantt") { ret "timeline" }
    if str.eq(key, "block") { ret "grid" }
    ret "grid"
}

// A monday view type as an Appdor view type; anything unlisted is a `grid`, which shows every row.
fn monday_view_type(key: str) -> str {
    if str.eq(key, "table") { ret "grid" }
    if str.eq(key, "kanban") { ret "kanban" }
    if str.eq(key, "calendar") { ret "calendar" }
    if str.eq(key, "timeline") { ret "timeline" }
    if str.eq(key, "gantt") { ret "timeline" }
    if str.eq(key, "form") { ret "form" }
    if str.eq(key, "chart") { ret "chart" }
    ret "grid"
}
