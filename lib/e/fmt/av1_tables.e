fn part0() -> str { ret "" }

fn part1() -> str { ret "" }

fn load(a: *mem.Arena) -> ([]i32, err) {
    let (raw, raw_error) = mem.alloc[u8](a, COUNT * 4usize + 16usize)
    if raw_error != ok { ret (zero, raw_error) }
    var at = 0usize
    let (got0, e0) = bytes.base64_decode(raw[at..], part0(), .Standard)
    if e0 != ok { ret (zero, Invalid) }
    at += got0.len
    let (got1, e1) = bytes.base64_decode(raw[at..], part1(), .Standard)
    if e1 != ok { ret (zero, Invalid) }
    at += got1.len
    if at != COUNT * 4usize { ret (zero, Invalid) }
    let (values, values_error) = mem.alloc[i32](a, COUNT)
    if values_error != ok { ret (zero, values_error) }
    var i = 0usize
    while i < COUNT {
        let (v, v_error) = bytes.load[i32](raw, i * 4usize, .Little)
        if v_error != ok { ret (zero, Invalid) }
        values[i] = v
        i += 1usize
    }
    ret (values, ok)
}
