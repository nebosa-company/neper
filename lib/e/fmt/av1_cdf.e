// init_coeff_cdfs for the quantizer context idx (0 to 3)
fn init_coeff(ctx: []u16, t: []const i32, idx: usize) {
    put(ctx, C_TXBSKIP, t, av1_tables.T_DEFAULT_TXB_SKIP_CDF + idx * L_TXBSKIP, L_TXBSKIP, 1usize)
    put(ctx, C_EOBPT16, t, av1_tables.T_DEFAULT_EOB_PT_16_CDF + idx * L_EOBPT16, L_EOBPT16, 1usize)
    put(ctx, C_EOBPT32, t, av1_tables.T_DEFAULT_EOB_PT_32_CDF + idx * L_EOBPT32, L_EOBPT32, 1usize)
    put(ctx, C_EOBPT64, t, av1_tables.T_DEFAULT_EOB_PT_64_CDF + idx * L_EOBPT64, L_EOBPT64, 1usize)
    put(ctx, C_EOBPT128, t, av1_tables.T_DEFAULT_EOB_PT_128_CDF + idx * L_EOBPT128, L_EOBPT128, 1usize)
    put(ctx, C_EOBPT256, t, av1_tables.T_DEFAULT_EOB_PT_256_CDF + idx * L_EOBPT256, L_EOBPT256, 1usize)
    put(ctx, C_EOBPT512, t, av1_tables.T_DEFAULT_EOB_PT_512_CDF + idx * L_EOBPT512, L_EOBPT512, 1usize)
    put(ctx, C_EOBPT1024, t, av1_tables.T_DEFAULT_EOB_PT_1024_CDF + idx * L_EOBPT1024, L_EOBPT1024, 1usize)
    put(ctx, C_EOBEXTRA, t, av1_tables.T_DEFAULT_EOB_EXTRA_CDF + idx * L_EOBEXTRA, L_EOBEXTRA, 1usize)
    put(ctx, C_DCSIGN, t, av1_tables.T_DEFAULT_DC_SIGN_CDF + idx * L_DCSIGN, L_DCSIGN, 1usize)
    put(ctx, C_COEFFBASEEOB, t, av1_tables.T_DEFAULT_COEFF_BASE_EOB_CDF + idx * L_COEFFBASEEOB, L_COEFFBASEEOB, 1usize)
    put(ctx, C_COEFFBASE, t, av1_tables.T_DEFAULT_COEFF_BASE_CDF + idx * L_COEFFBASE, L_COEFFBASE, 1usize)
    put(ctx, C_COEFFBR, t, av1_tables.T_DEFAULT_COEFF_BR_CDF + idx * L_COEFFBR, L_COEFFBR, 1usize)
}
