fn put(ctx: []u16, at: usize, t: []const i32, from: usize, n: usize, copies: usize) {
    var c = 0usize
    while c < copies {
        var i = 0usize
        while i < n {
            ctx[at + c * n + i] = u16(t[from + i])
            i += 1usize
        }
        c += 1usize
    }
}

