fn rules_for(a: *mem.Arena, env: sheet.MediaEnv, quirks: bool) -> (sheet.Loaded, err) {
    if !quirks {
        let (plain, pe) = rules(a, env)
        ret (plain, pe)
    }
    let text = try quirks_source(a)
    let (loaded, e) = sheet.parse_sheet(a, env, text)
    ret (loaded, e)
}
