// Time zones from TZif (RFC 8536) data: a database is a pack of zones -- "NPTZ", the
// IANA version, and each zone's name with its TZif bytes -- parsed once into the
// arena: the 64-bit transition block at_time the file has one, the local time types,
// and the POSIX TZ footer rule that governs everything after the last transition,
// which is how a slim tzdata file describes the future. `builtin` is the pack
// embedded below, pinned to the release `version` reports, over a chosen set of
// zones rather than all six hundred; `load` takes any pack in the same shape.
//
// `offset_at` answers from the transitions or the rule; `to_local` shifts by it;
// `resolve` tries the offsets in force a day either side of a local time and reports
// one, two or no instant, the gap's edges found by a binary search for the
// transition. Rules are the `Mm.w.d/time` form, which is every footer in the
// release; a `Jn` or `n` rule is `InvalidData`. Nothing here reads the host's zone.
use e.mem
use e.str
use e.time

type Database = struct { state: *void }
type Zone = struct { state: *const void }
type Local = struct { date: time.Date, time: time.Time }
type Offset = struct { seconds: i32, daylight: bool, abbreviation: str }
type Resolve = union enum u8 { Unique: time.Timestamp, Ambiguous: [2]time.Timestamp, Missing: [2]time.Timestamp }
error InvalidData
error NotFound
error TooLarge

const NANOS: i64 = 1000000000i64
const DAY: i64 = 86400i64

type Rule = struct { has_dst: bool, std_offset: i32, dst_offset: i32, std_name: str, dst_name: str, start_month: i64, start_week: i64, start_day: i64, start_time: i64, end_month: i64, end_week: i64, end_day: i64, end_time: i64 }
type ZoneData = struct { name: str, transitions: []i64, type_of: []u8, offsets: []i32, daylight: []bool, abbreviations: []str, rule: Rule, has_rule: bool }
type State = struct { version: str, zones: []ZoneData, zone_names: []str }

fn be32(data: []const u8, at: usize) -> i64 {
    let raw = (u32(data[at]) << 24u32) | (u32(data[at + 1usize]) << 16u32) | (u32(data[at + 2usize]) << 8u32) | u32(data[at + 3usize])
    if raw >= 2147483648u32 { ret i64(raw) - 4294967296i64 }
    ret i64(raw)
}

fn be64(data: []const u8, at: usize) -> i64 {
    let high = be32(data, at)
    let low = (u64(data[at + 4usize]) << 24u32) | (u64(data[at + 5usize]) << 16u32) | (u64(data[at + 6usize]) << 8u32) | u64(data[at + 7usize])
    ret high * 4294967296i64 + i64(low)
}

fn le16(data: []const u8, at: usize) -> usize {
    ret usize(data[at]) | (usize(data[at + 1usize]) << 8u32)
}

fn le32(data: []const u8, at: usize) -> usize {
    ret le16(data, at) | (le16(data, at + 2usize) << 16u32)
}

// --- The POSIX TZ footer.

// A name is letters, or anything inside `<...>`.
fn rule_name(text: str, at: usize) -> (str, usize, bool) {
    if at < text.len && text[at] == 60u8 {
        let (close, has_close) = str.find_from(text, ">", at)
        if !has_close { ret ("", at, false) }
        ret (text[at + 1usize..close], close + 1usize, true)
    }
    var stop = at
    while stop < text.len && str.is_ascii_alpha(text[stop]) { stop += 1usize }
    if stop - at < 3usize { ret ("", at, false) }
    ret (text[at..stop], stop, true)
}

// `[+-]h[:m[:s]]` in seconds; POSIX offsets are west-positive, so the caller negates.
fn rule_time(text: str, at: usize) -> (i64, usize, bool) {
    var cursor = at
    var sign = 1i64
    if cursor < text.len && (text[cursor] == 43u8 || text[cursor] == 45u8) {
        if text[cursor] == 45u8 { sign = -1i64 }
        cursor += 1usize
    }
    var parts: [3]i64 = zero
    var index = 0usize
    while index < 3usize {
        var digits = cursor
        var value = 0i64
        while digits < text.len && str.is_ascii_digit(text[digits]) {
            value = value * 10i64 + i64(text[digits] - 48u8)
            digits += 1usize
        }
        if digits == cursor { ret (0i64, at, false) }
        parts[index] = value
        cursor = digits
        index += 1usize
        if cursor >= text.len || text[cursor] != 58u8 { break }
        cursor += 1usize
    }
    ret (sign * (parts[0] * 3600i64 + parts[1] * 60i64 + parts[2]), cursor, true)
}

// `Mm.w.d[/time]`; the time defaults to 02:00.
fn rule_date(text: str, at: usize) -> (i64, i64, i64, i64, usize, bool) {
    if at >= text.len || text[at] != 77u8 { ret (0i64, 0i64, 0i64, 0i64, at, false) }
    var cursor = at + 1usize
    var fields: [3]i64 = zero
    var index = 0usize
    while index < 3usize {
        var digits = cursor
        var value = 0i64
        while digits < text.len && str.is_ascii_digit(text[digits]) {
            value = value * 10i64 + i64(text[digits] - 48u8)
            digits += 1usize
        }
        if digits == cursor { ret (0i64, 0i64, 0i64, 0i64, at, false) }
        fields[index] = value
        cursor = digits
        index += 1usize
        if index < 3usize {
            if cursor >= text.len || text[cursor] != 46u8 { ret (0i64, 0i64, 0i64, 0i64, at, false) }
            cursor += 1usize
        }
    }
    if fields[0] < 1i64 || fields[0] > 12i64 || fields[1] < 1i64 || fields[1] > 5i64 || fields[2] > 6i64 { ret (0i64, 0i64, 0i64, 0i64, at, false) }
    var at_time = 7200i64
    if cursor < text.len && text[cursor] == 47u8 {
        let (parsed, after, good) = rule_time(text, cursor + 1usize)
        if !good { ret (0i64, 0i64, 0i64, 0i64, at, false) }
        at_time = parsed
        cursor = after
    }
    ret (fields[0], fields[1], fields[2], at_time, cursor, true)
}

fn parse_rule(text: str) -> (Rule, bool) {
    var rule: Rule = zero
    let (std_name, after_std, std_good) = rule_name(text, 0usize)
    if !std_good { ret (rule, false) }
    let (std_west, after_offset, offset_good) = rule_time(text, after_std)
    if !offset_good { ret (rule, false) }
    rule.std_name = std_name
    rule.std_offset = i32(0i64 - std_west)
    if after_offset == text.len { ret (rule, true) }
    let (dst_name, after_dst, dst_good) = rule_name(text, after_offset)
    if !dst_good { ret (rule, false) }
    rule.has_dst = true
    rule.dst_name = dst_name
    rule.dst_offset = rule.std_offset + 3600i32
    var cursor = after_dst
    if cursor < text.len && text[cursor] != 44u8 {
        let (dst_west, after_dst_offset, dst_offset_good) = rule_time(text, cursor)
        if !dst_offset_good { ret (rule, false) }
        rule.dst_offset = i32(0i64 - dst_west)
        cursor = after_dst_offset
    }
    if cursor >= text.len || text[cursor] != 44u8 { ret (rule, false) }
    let (sm, sw, sd, st, after_start, start_good) = rule_date(text, cursor + 1usize)
    if !start_good || after_start >= text.len || text[after_start] != 44u8 { ret (rule, false) }
    let (em, ew, ed, et, after_end, end_good) = rule_date(text, after_start + 1usize)
    if !end_good || after_end != text.len { ret (rule, false) }
    rule.start_month = sm
    rule.start_week = sw
    rule.start_day = sd
    rule.start_time = st
    rule.end_month = em
    rule.end_week = ew
    rule.end_day = ed
    rule.end_time = et
    ret (rule, true)
}

// Seconds since the epoch of the rule's wall time in `year`, before the offset shift.
fn rule_instant(year: i64, month: i64, week: i64, weekday: i64, at_time: i64) -> i64 {
    let first = time.days_from_civil(year, month, 1i64)
    // 1970-01-01 was a Thursday; the count is floored for years before it.
    var first_weekday = (first + 4i64) % 7i64
    if first_weekday < 0i64 { first_weekday += 7i64 }
    var day = 1i64 + (weekday - first_weekday + 7i64) % 7i64 + (week - 1i64) * 7i64
    while day > time.days_in_month(year, month) { day -= 7i64 }
    ret time.days_from_civil(year, month, day) * DAY + at_time
}

fn floor_div(a: i64, b: i64) -> i64 {
    var q = a / b
    if (a % b != 0i64) && ((a < 0i64) != (b < 0i64)) { q -= 1i64 }
    ret q
}

fn rule_offset(rule: Rule, seconds: i64) -> Offset {
    if !rule.has_dst { ret Offset { seconds: rule.std_offset, daylight: false, abbreviation: rule.std_name } }
    let (year, month, day) = time.civil_from_days(floor_div(seconds + i64(rule.std_offset), DAY))
    let start = rule_instant(year, rule.start_month, rule.start_week, rule.start_day, rule.start_time) - i64(rule.std_offset)
    let stop = rule_instant(year, rule.end_month, rule.end_week, rule.end_day, rule.end_time) - i64(rule.dst_offset)
    var daylight = false
    if start < stop {
        daylight = seconds >= start && seconds < stop
    } else {
        daylight = seconds >= start || seconds < stop
    }
    if daylight { ret Offset { seconds: rule.dst_offset, daylight: true, abbreviation: rule.dst_name } }
    ret Offset { seconds: rule.std_offset, daylight: false, abbreviation: rule.std_name }
}

// --- TZif.

fn parse_tzif(a: *mem.Arena, name: str, data: []const u8) -> (ZoneData, err) {
    var zone_data: ZoneData = zero
    zone_data.name = name
    if data.len < 44usize || data[0] != 84u8 || data[1] != 90u8 || data[2] != 105u8 || data[3] != 102u8 { ret (zone_data, InvalidData) }
    let tzif_version = data[4]
    var header = 0usize
    var wide = false
    if tzif_version >= 50u8 {
        // Skip the 32-bit block to the second header.
        let v1_time = usize(be32(data, 32usize))
        let v1_type = usize(be32(data, 36usize))
        let v1_char = usize(be32(data, 40usize))
        let v1_leap = usize(be32(data, 28usize))
        let v1_isstd = usize(be32(data, 24usize))
        let v1_isut = usize(be32(data, 20usize))
        header = 44usize + v1_time * 5usize + v1_type * 6usize + v1_char + v1_leap * 8usize + v1_isstd + v1_isut
        if header + 44usize > data.len { ret (zone_data, InvalidData) }
        if data[header] != 84u8 || data[header + 1usize] != 90u8 { ret (zone_data, InvalidData) }
        wide = true
    }
    let isut = usize(be32(data, header + 20usize))
    let isstd = usize(be32(data, header + 24usize))
    let leap = usize(be32(data, header + 28usize))
    let timecnt = usize(be32(data, header + 32usize))
    let typecnt = usize(be32(data, header + 36usize))
    let charcnt = usize(be32(data, header + 40usize))
    if typecnt == 0usize || timecnt > 100000usize { ret (zone_data, InvalidData) }
    var time_width = 4usize
    var leap_width = 8usize
    if wide {
        time_width = 8usize
        leap_width = 12usize
    }
    let data_start = header + 44usize
    var at = data_start
    let block = timecnt * time_width + timecnt + typecnt * 6usize + charcnt + leap * leap_width + isstd + isut
    if at + block > data.len { ret (zone_data, InvalidData) }
    let (transitions, transitions_error) = mem.alloc[i64](a, timecnt)
    if transitions_error != ok { ret (zone_data, transitions_error) }
    var i = 0usize
    while i < timecnt {
        if wide { transitions[i] = be64(data, at + i * 8usize) } else { transitions[i] = be32(data, at + i * 4usize) }
        i += 1usize
    }
    at += timecnt * time_width
    let (type_of, type_of_error) = mem.alloc[u8](a, timecnt)
    if type_of_error != ok { ret (zone_data, type_of_error) }
    i = 0usize
    while i < timecnt {
        type_of[i] = data[at + i]
        if usize(type_of[i]) >= typecnt { ret (zone_data, InvalidData) }
        i += 1usize
    }
    at += timecnt
    let (offsets, offsets_error) = mem.alloc[i32](a, typecnt)
    if offsets_error != ok { ret (zone_data, offsets_error) }
    let (daylight, daylight_error) = mem.alloc[bool](a, typecnt)
    if daylight_error != ok { ret (zone_data, daylight_error) }
    let (abbreviations, abbreviations_error) = mem.alloc[str](a, typecnt)
    if abbreviations_error != ok { ret (zone_data, abbreviations_error) }
    let chars_at = at + typecnt * 6usize
    i = 0usize
    while i < typecnt {
        offsets[i] = i32(be32(data, at + i * 6usize))
        daylight[i] = data[at + i * 6usize + 4usize] != 0u8
        let index = usize(data[at + i * 6usize + 5usize])
        if index >= charcnt { ret (zone_data, InvalidData) }
        var stop = chars_at + index
        while stop < chars_at + charcnt && data[stop] != 0u8 { stop += 1usize }
        abbreviations[i] = data[chars_at + index..stop]
        i += 1usize
    }
    at = data_start + block
    zone_data.transitions = transitions
    zone_data.type_of = type_of
    zone_data.offsets = offsets
    zone_data.daylight = daylight
    zone_data.abbreviations = abbreviations
    // The footer: a newline, the rule, a newline.
    if wide && at + 2usize <= data.len && data[at] == 10u8 {
        var stop = at + 1usize
        while stop < data.len && data[stop] != 10u8 { stop += 1usize }
        let footer = data[at + 1usize..stop]
        if footer.len > 0usize {
            let (rule, rule_good) = parse_rule(footer)
            if !rule_good { ret (zone_data, InvalidData) }
            zone_data.rule = rule
            zone_data.has_rule = true
        }
    }
    ret (zone_data, ok)
}

fn load(a: *mem.Arena, source: []const u8) -> (Database, err) {
    if source.len < 10usize || source[0] != 78u8 || source[1] != 80u8 || source[2] != 84u8 || source[3] != 90u8 { ret (zero, InvalidData) }
    let version_len = le16(source, 4usize)
    if 6usize + version_len + 4usize > source.len { ret (zero, InvalidData) }
    let release = source[6usize..6usize + version_len]
    var at = 6usize + version_len
    let count = le32(source, at)
    at += 4usize
    if count > 65536usize { ret (zero, TooLarge) }
    let (zones, zones_error) = mem.alloc[ZoneData](a, count)
    if zones_error != ok { ret (zero, zones_error) }
    let (zone_names, names_error) = mem.alloc[str](a, count)
    if names_error != ok { ret (zero, names_error) }
    var i = 0usize
    while i < count {
        if at + 2usize > source.len { ret (zero, InvalidData) }
        let name_len = le16(source, at)
        at += 2usize
        if at + name_len + 4usize > source.len { ret (zero, InvalidData) }
        let name = source[at..at + name_len]
        at += name_len
        let data_len = le32(source, at)
        at += 4usize
        if data_len > 1048576usize { ret (zero, TooLarge) }
        if at + data_len > source.len { ret (zero, InvalidData) }
        let (parsed, parse_error) = parse_tzif(a, name, source[at..at + data_len])
        if parse_error != ok { ret (zero, parse_error) }
        zones[i] = parsed
        zone_names[i] = name
        at += data_len
        i += 1usize
    }
    let (storage, storage_error) = mem.alloc[State](a, 1usize)
    if storage_error != ok { ret (zero, storage_error) }
    storage[0].version = release
    storage[0].zones = zones
    storage[0].zone_names = zone_names
    var db: Database = zero
    db.state = mem.cast[*void](&storage[0])
    ret (db, ok)
}

fn version(db: *const Database) -> str {
    let s = mem.cast[*State](db.state)
    ret s.version
}

fn names(db: *const Database) -> []const str {
    let s = mem.cast[*State](db.state)
    ret s.zone_names[0..]
}

fn zone(db: *const Database, name: str) -> (Zone, err) {
    let s = mem.cast[*State](db.state)
    var i = 0usize
    while i < s.zones.len {
        if str.eq(s.zones[i].name, name) {
            var z: Zone = zero
            z.state = mem.cast[*const void](&s.zones[i])
            ret (z, ok)
        }
        i += 1usize
    }
    ret (zero, NotFound)
}

fn offset_at_seconds(z: *const ZoneData, seconds: i64) -> Offset {
    let n = z.transitions.len
    if n == 0usize || seconds < z.transitions[0] {
        if n == 0usize && z.has_rule { ret rule_offset(z.rule, seconds) }
        ret Offset { seconds: z.offsets[0], daylight: z.daylight[0], abbreviation: z.abbreviations[0] }
    }
    // The last transition at or before `seconds`.
    var low = 0usize
    var high = n
    while high - low > 1usize {
        let mid = (low + high) / 2usize
        if z.transitions[mid] <= seconds { low = mid } else { high = mid }
    }
    if low == n - 1usize && z.has_rule { ret rule_offset(z.rule, seconds) }
    let kind = usize(z.type_of[low])
    ret Offset { seconds: z.offsets[kind], daylight: z.daylight[kind], abbreviation: z.abbreviations[kind] }
}

fn offset_at(selected_zone: Zone, instant: time.Timestamp) -> Offset {
    let z = mem.cast[*const ZoneData](selected_zone.state)
    ret offset_at_seconds(z, floor_div(instant.nanos, NANOS))
}

fn to_local(selected_zone: Zone, instant: time.Timestamp) -> Local {
    let offset = offset_at(selected_zone, instant)
    let shifted = time.Timestamp { nanos: instant.nanos + i64(offset.seconds) * NANOS }
    ret Local { date: time.to_date(shifted), time: time.to_time(shifted) }
}

fn resolve(selected_zone: Zone, local: Local) -> (Resolve, err) {
    let z = mem.cast[*const ZoneData](selected_zone.state)
    let (as_utc, civil_error) = time.from_civil(local.date, local.time)
    if civil_error != ok { ret (zero, civil_error) }
    let wall = floor_div(as_utc.nanos, NANOS)
    let before = i64(offset_at_seconds(z, wall - DAY).seconds)
    let after = i64(offset_at_seconds(z, wall + DAY).seconds)
    let first = time.Timestamp { nanos: as_utc.nanos - before * NANOS }
    let second = time.Timestamp { nanos: as_utc.nanos - after * NANOS }
    let first_holds = i64(offset_at_seconds(z, wall - before).seconds) == before
    let second_holds = i64(offset_at_seconds(z, wall - after).seconds) == after
    if before == after || (first_holds && !second_holds) { ret (Resolve{ Unique: first }, ok) }
    if second_holds && !first_holds { ret (Resolve{ Unique: second }, ok) }
    if first_holds && second_holds {
        var pair: [2]time.Timestamp = zero
        if first.nanos < second.nanos {
            pair[0] = first
            pair[1] = second
        } else {
            pair[0] = second
            pair[1] = first
        }
        ret (Resolve{ Ambiguous: pair }, ok)
    }
    // A gap: the transition lies between the two candidates; find it to the second.
    var low = wall - before
    var high = wall - after
    if high < low {
        let swap = low
        low = high
        high = swap
    }
    let low_offset = offset_at_seconds(z, low).seconds
    while high - low > 1i64 {
        let mid = low + (high - low) / 2i64
        if offset_at_seconds(z, mid).seconds == low_offset { low = mid } else { high = mid }
    }
    var edges: [2]time.Timestamp = zero
    edges[0] = time.Timestamp { nanos: high * NANOS - 1i64 }
    edges[1] = time.Timestamp { nanos: high * NANOS }
    ret (Resolve{ Missing: edges }, ok)
}

fn builtin(a: *mem.Arena) -> (Database, err) {
    let (db, load_error) = load(a, builtin_pack())
    ret (db, load_error)
}

