fn read_le(t: str, at: usize) -> u32 {
    ret u32(t[at]) | (u32(t[at + 1usize]) << 8u32) | (u32(t[at + 2usize]) << 16u32) | (u32(t[at + 3usize]) << 24u32)
}

// The full upper-case mapping of `cp` when it expands: (first, second, third, count); count 0 when it does not.
fn upper_special(cp: u32) -> (u32, u32, u32, usize) {
    let t = upper_special_table()
    var lo = 0usize
    var hi = t.len / 16usize
    while lo < hi {
        let mid = (lo + hi) / 2usize
        let at = mid * 16usize
        let key = read_le(t, at)
        if key == cp {
            let a = read_le(t, at + 4usize)
            let b = read_le(t, at + 8usize)
            let c = read_le(t, at + 12usize)
            var n = 1usize
            if b != 0u32 { n = 2usize }
            if c != 0u32 { n = 3usize }
            ret (a, b, c, n)
        }
        if key < cp { lo = mid + 1usize } else { hi = mid }
    }
    ret (0u32, 0u32, 0u32, 0usize)
}
