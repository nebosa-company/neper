fn u01(g: *Gen) -> f64 { ret f64(next(g) >> 11u64) * 1.1102230246251565e-16f64 }

// generate_double_8bit_pair: a uniform and the bucket from bits 3..10 of the same draw
fn pair(g: *Gen) -> (f64, i64) {
    let x = next(g)
    ret (f64(x >> 11u64) * 1.1102230246251565e-16f64, i64((x >> 3u64) & 255u64))
}

// boost::random::exponential_distribution(1) by the ziggurat
fn unit_exp(g: *Gen, z: *const Zig) -> f64 {
    var shift = 0.0f64
    while true {
        let (r, i) = pair(g)
        let iu = usize(i)
        let x = r * z.ex[iu]
        if x < z.ex[iu + 1usize] { ret shift + x }
        if i == 0i64 {
            shift = shift + z.ex[1usize]
        } else {
            let y01 = u01(g)
            let y = z.ey[iu] + y01 * (z.ey[iu + 1usize] - z.ey[iu])
            let above_ub = (z.ex[iu] - z.ex[iu + 1usize]) * y01 - (z.ex[iu] - x)
            let above_lb = y - (z.ey[iu + 1usize] + (z.ex[iu + 1usize] - x) * z.ey[iu + 1usize])
            if above_ub < 0.0f64 && (above_lb < 0.0f64 || y < math.exp[f64](0.0f64 - x)) { ret x + shift }
        }
    }
    ret 0.0f64
}

fn normal_tail(g: *Gen, z: *const Zig) -> f64 {
    let start = z.nx[1usize]
    while true {
        let x = unit_exp(g, z) / start
        let y = unit_exp(g, z)
        if 2.0f64 * y > x * x { ret x + start }
    }
    ret 0.0f64
}

// boost::random::normal_distribution(0, 1) by the ziggurat
fn unit_norm(g: *Gen, z: *const Zig) -> f64 {
    while true {
        let (r, i0) = pair(g)
        let sign = f64((i0 & 1i64) * 2i64 - 1i64)
        let i = usize(i0 / 2i64)
        let x = r * z.nx[i]
        if x < z.nx[i + 1usize] { ret x * sign }
        if i == 0usize { ret normal_tail(g, z) * sign }
        let y01 = u01(g)
        let y = z.ny[i] + y01 * (z.ny[i + 1usize] - z.ny[i])
        var above_ub = 0.0f64
        var above_lb = 0.0f64
        if z.nx[i] >= 1.0f64 {
            above_ub = (z.nx[i] - z.nx[i + 1usize]) * y01 - (z.nx[i] - x)
            above_lb = y - (z.ny[i] + (z.nx[i] - x) * z.ny[i] * z.nx[i])
        } else {
            above_lb = (z.nx[i] - z.nx[i + 1usize]) * y01 - (z.nx[i] - x)
            above_ub = y - (z.ny[i] + (z.nx[i] - x) * z.ny[i] * z.nx[i])
        }
        if above_ub < 0.0f64 && (above_lb < 0.0f64 || y < math.exp[f64](0.0f64 - (x * x / 2.0f64))) { ret x * sign }
    }
    ret 0.0f64
}

// dqrnorm(1, mean, sd)
fn rnorm(g: *Gen, z: *const Zig, mean: f64, sd: f64) -> f64 { ret unit_norm(g, z) * sd + mean }

// dqrexp(1, rate)
fn rexp(g: *Gen, z: *const Zig, rate: f64) -> f64 { ret unit_exp(g, z) / rate }
