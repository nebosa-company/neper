fn is_stopword(lang: usize, w: str) -> bool {
    var lo = 0usize
    var hi = stop_n(lang)
    while lo < hi {
        let mid = (lo + hi) / 2usize
        let c = str.compare(stop_at(lang, mid), w)
        if c == 0i32 { ret true }
        if c < 0i32 { lo = mid + 1usize } else { hi = mid }
    }
    ret false
}
