fn row(a: *mem.Arena, s: str, line: str) -> str { ret join3(a, s, line, "\n") }

fn join3(a: *mem.Arena, x: str, y: str, z: str) -> str {
    let (out, e) = mem.alloc[u8](a, x.len + y.len + z.len)
    if e != ok { ret x }
    var n = 0usize
    var k = 0usize
    while k < x.len {
        out[n] = x[k]
        n += 1usize
        k += 1usize
    }
    k = 0usize
    while k < y.len {
        out[n] = y[k]
        n += 1usize
        k += 1usize
    }
    k = 0usize
    while k < z.len {
        out[n] = z[k]
        n += 1usize
        k += 1usize
    }
    ret out[0usize..n]
}

