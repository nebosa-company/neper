fn is_upc(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    if s.len != 12usize || !all_digits(s) { ret false }
    let (padded, e) = mem.alloc[u8](a, 13usize)
    if e != ok { ret false }
    padded[0usize] = 48u8
    var i = 0usize
    while i < 12usize {
        padded[i + 1usize] = s[i]
        i += 1usize
    }
    ret ean13_digits(padded[0usize..13usize])
}

