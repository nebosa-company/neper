fn cell(line: str, n: usize) -> str {
    var from = 0usize
    var index = 0usize
    var i = 0usize
    while i <= line.len {
        if i == line.len || line[i] == 124u8 {
            if index == n { ret line[from..i] }
            index += 1usize
            from = i + 1usize
        }
        i += 1usize
    }
    ret ""
}

// The section letter of a division code, or empty.
fn section_of(a: *mem.Arena, division: str) -> str {
    let table = nace_table(a)
    var start = 0usize
    var i = 0usize
    while i < table.len {
        if table[i] == 10u8 {
            let line = table[start..i]
            if line[0usize] == 86u8 && str.eq(cell(line, 1usize), division) { ret cell(line, 2usize) }
            start = i + 1usize
        }
        i += 1usize
    }
    ret ""
}

fn is_section_letter(a: *mem.Arena, letter: str) -> bool {
    if letter.len != 1usize { ret false }
    let table = nace_table(a)
    var start = 0usize
    var i = 0usize
    while i < table.len {
        if table[i] == 10u8 {
            let line = table[start..i]
            if line[0usize] == 83u8 && str.eq(cell(line, 1usize), letter) { ret true }
            start = i + 1usize
        }
        i += 1usize
    }
    ret false
}

// `isNaceSection`: the letter, upper-cased, is one of the twenty-two sections.
fn is_nace_section(a: *mem.Arena, letter: str) -> bool { ret is_section_letter(a, upper(a, letter)) }

// `isNaceDivision`: exactly one of the eighty-seven two-digit division codes (trimmed).
fn is_nace_division(a: *mem.Arena, code: str) -> bool {
    let s = trim(code)
    ret s.len == 2usize && section_of(a, s).len > 0usize
}

// The section letter owning `division`, or empty.
fn nace_section_of(a: *mem.Arena, division: str) -> str { ret section_of(a, trim(division)) }

// A title in `locale`: Bulgarian when the locale is `bg`, otherwise English (an unknown code is its own text).
fn nace_title(a: *mem.Arena, tag: u8, code: str, original: str, locale: str) -> str {
    let table = nace_table(a)
    let lang = trim(locale)
    var bulgarian = lang.len == 2usize && (lang[0usize] == 66u8 || lang[0usize] == 98u8) && (lang[1usize] == 71u8 || lang[1usize] == 103u8)
    var start = 0usize
    var i = 0usize
    while i < table.len {
        if table[i] == 10u8 {
            let line = table[start..i]
            if line[0usize] == tag && str.eq(cell(line, 1usize), code) {
                var first = 2usize
                if tag == 86u8 { first = 3usize }
                if bulgarian { ret cell(line, first + 1usize) }
                ret cell(line, first)
            }
            start = i + 1usize
        }
        i += 1usize
    }
    ret original
}

fn nace_section_title(a: *mem.Arena, letter: str, locale: str) -> str { ret nace_title(a, 83u8, upper(a, letter), letter, locale) }

fn nace_division_title(a: *mem.Arena, code: str, locale: str) -> str { ret nace_title(a, 86u8, trim(code), code, locale) }

// Split a NACE code into its levels: a section letter, a division (`41`), a group (`41.2`) or a class (`41.20`),
// optionally with a leading section letter that must agree with the division. A division that does not exist in
// Rev. 2.1 is refused.
fn parse_nace(a: *mem.Arena, value: str) -> (NaceCode, bool) {
    let none = NaceCode { level: "", section: "", division: "", code: "" }
    let raw = upper(a, trim(value))
    if raw.len == 0usize || !is_ascii(raw) { ret (none, false) }
    if raw.len == 1usize && is_upper(raw[0usize]) {
        if is_section_letter(a, raw) { ret (NaceCode { level: "section", section: raw, division: "", code: raw }, true) }
        ret (none, false)
    }
    var p = 0usize
    var letter = ""
    if is_upper(raw[0usize]) {
        letter = raw[0usize..1usize]
        p = 1usize
        // an optional `.` or white space after the letter
        if p < raw.len && (raw[p] == 46u8 || raw[p] == 32u8 || (raw[p] >= 9u8 && raw[p] <= 13u8)) { p += 1usize }
    }
    if p + 2usize > raw.len || !digits_in(raw, p, p + 2usize) { ret (none, false) }
    let division = raw[p..p + 2usize]
    p += 2usize
    var group = ""
    var cls = ""
    if p < raw.len {
        if raw[p] != 46u8 || p + 1usize >= raw.len || !is_digit(raw[p + 1usize]) { ret (none, false) }
        group = raw[p + 1usize..p + 2usize]
        p += 2usize
        if p < raw.len {
            if !is_digit(raw[p]) { ret (none, false) }
            cls = raw[p..p + 1usize]
            p += 1usize
        }
        if p != raw.len { ret (none, false) }
    }
    let section = section_of(a, division)
    if section.len == 0usize { ret (none, false) }
    if letter.len > 0usize && !str.eq(letter, section) { ret (none, false) }
    if cls.len > 0usize { ret (NaceCode { level: "class", section: section, division: division, code: join3(a, join3(a, division, ".", group), cls, "") }, true) }
    if group.len > 0usize { ret (NaceCode { level: "group", section: section, division: division, code: join3(a, division, ".", group) }, true) }
    ret (NaceCode { level: "division", section: section, division: division, code: division }, true)
}

fn is_nace(a: *mem.Arena, value: str) -> bool {
    let (code, good) = parse_nace(a, value)
    ret good
}

// --- barcodes --------------------------------------------------------------------------------------------------------

// A barcode check: `reason` is a stable slug and `message` is for the person holding the scanner.
type BarcodeResult = struct { valid: bool, reason: str, message: str, value: str, symbology: str }

fn barcode_fail(reason: str, message: str) -> BarcodeResult {
    ret BarcodeResult { valid: false, reason: reason, message: message, value: "", symbology: "" }
}

// The symbology's label and payload length (0 when variable) and check kind: `mod10`, `mod43` or `none`.
fn symbology_spec(name: str) -> (str, usize, str, bool) {
    if str.eq(name, "ean13") { ret ("EAN-13", 13usize, "mod10", true) }
    if str.eq(name, "ean8") { ret ("EAN-8", 8usize, "mod10", true) }
    if str.eq(name, "upca") { ret ("UPC-A", 12usize, "mod10", true) }
    if str.eq(name, "code39") { ret ("Code 39", 0usize, "mod43", true) }
    if str.eq(name, "code128") { ret ("Code 128", 0usize, "none", true) }
    if str.eq(name, "qr") { ret ("QR", 0usize, "none", true) }
    ret ("", 0usize, "", false)
}

fn number_text(a: *mem.Arena, n: usize) -> str {
    if n == 0usize { ret "0" }
    var buffer: [20]u8 = zero
    var at = 20usize
    var v = n
    while v > 0usize {
        at -= 1usize
        buffer[at] = u8(48usize + v % 10usize)
        v = v / 10usize
    }
    let (out, e) = mem.alloc[u8](a, 20usize - at)
    if e != ok { ret "0" }
    var k = 0usize
    while at < 20usize {
        out[k] = buffer[at]
        k += 1usize
        at += 1usize
    }
    ret out[0usize..k]
}

// The GS1 check digit of a payload, weights 3,1 from its right end.
fn mod10_check_digit(payload: str) -> usize {
    var sum = 0usize
    var i = 0usize
    while i < payload.len {
        let digit = usize(payload[payload.len - 1usize - i] - 48u8)
        if i % 2usize == 0usize { sum += digit * 3usize } else { sum += digit }
        i += 1usize
    }
    ret (10usize - sum % 10usize) % 10usize
}

fn code39_alphabet() -> str { ret "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-. $/+%" }

// The index of an alphabet character, or 43 for none.
fn code39_value(c: u8) -> usize {
    let alphabet = code39_alphabet()
    var i = 0usize
    while i < alphabet.len {
        if alphabet[i] == c { ret i }
        i += 1usize
    }
    ret 43usize
}

// UTF-16 length of a text.
fn utf16_len(s: str) -> usize {
    var n = 0usize
    var i = 0usize
    while i < s.len {
        if (s[i] & 192u8) != 128u8 { n += 1usize }
        if s[i] >= 240u8 { n += 1usize }
        i += 1usize
    }
    ret n
}

// Validate a decoded value against a symbology (`ean13`, `ean8`, `upca`, `code39`, `code128`, `qr`).
fn validate_barcode(a: *mem.Arena, value: str, symbology: str) -> BarcodeResult {
    let (label, length, kind, known) = symbology_spec(symbology)
    if !known { ret barcode_fail("unknown-symbology", join3(a, "Unknown symbology \"", symbology, "\".")) }
    let raw = trim(value)
    if raw.len == 0usize { ret barcode_fail("empty", "Nothing was scanned.") }
    if length > 0usize {
        if !all_digits(raw) { ret barcode_fail("not-numeric", join3(a, label, " codes are digits only.", "")) }
        if raw.len != length {
            let head = join3(a, label, " is ", number_text(a, length))
            let tail = join3(a, " digits; this scan has ", number_text(a, raw.len), ". Scan again.")
            ret barcode_fail("wrong-length", join3(a, head, tail, ""))
        }
    }
    if str.eq(kind, "mod10") {
        let expected = mod10_check_digit(raw[0usize..raw.len - 1usize])
        let actual = usize(raw[raw.len - 1usize] - 48u8)
        if expected != actual {
            let head = join3(a, "Check digit failed \xe2\x80\x94 expected ", number_text(a, expected), ", read ")
            ret barcode_fail("bad-check-digit", join3(a, head, number_text(a, actual), ". The label may be damaged."))
        }
    }
    if str.eq(kind, "mod43") && utf16_len(raw) >= 2usize {
        let charset = "Code 39 allows digits, A-Z and - . $ / + % only."
        // the last code point; an astral one leaves a lone surrogate in the payload, which is no character of the set
        var k = raw.len - 1usize
        while k > 0usize && (raw[k] & 192u8) == 128u8 { k -= 1usize }
        if raw.len - k > 1usize { ret barcode_fail("bad-charset", charset) }
        var sum = 0usize
        var i = 0usize
        while i < k {
            let v = code39_value(raw[i])
            if v == 43usize { ret barcode_fail("bad-charset", charset) }
            sum += v
            i += 1usize
        }
        let expected = code39_alphabet()[sum % 43usize]
        if expected != raw[k] && code39_value(raw[k]) == 43usize { ret barcode_fail("bad-charset", charset) }
    }
    ret BarcodeResult { valid: true, reason: "", message: "", value: raw, symbology: symbology }
}

// `isBarcodeValue`: only a numeric string of GS1 length (8, 12 or 13) has a check digit to fail.
fn is_barcode_value(a: *mem.Arena, value: str) -> bool {
    let raw = trim(value)
    if raw.len == 0usize { ret true }
    if !all_digits(raw) { ret true }
    if raw.len == 13usize { ret validate_barcode(a, raw, "ean13").valid }
    if raw.len == 12usize { ret validate_barcode(a, raw, "upca").valid }
    if raw.len == 8usize { ret validate_barcode(a, raw, "ean8").valid }
    ret true
}

// What this environment can do about scanning; `permission` is `granted`, `denied` or `prompt`.
type ScanEnvironment = struct { has_detector: bool, is_secure_context: bool, has_camera: bool, permission: str }

type ScanSupport = struct { available: bool, reason: str, message: str, needs_prompt: bool }

// Whether scanning is possible, and if not the one fact the person can act on (a secure connection first, then the
// browser, the device, and last the permission).
fn scan_support(env: ScanEnvironment) -> ScanSupport {
    if !env.is_secure_context {
        ret ScanSupport { available: false, reason: "insecure-context", message: "Scanning needs a secure connection (https). Type the code instead.", needs_prompt: false }
    }
    if !env.has_detector {
        ret ScanSupport { available: false, reason: "no-detector", message: "This browser cannot scan barcodes. Type the code instead.", needs_prompt: false }
    }
    if !env.has_camera {
        ret ScanSupport { available: false, reason: "no-camera", message: "No camera was found on this device. Type the code instead.", needs_prompt: false }
    }
    if str.eq(env.permission, "denied") {
        ret ScanSupport { available: false, reason: "permission-denied", message: "Camera access is blocked for this site. Allow it in your browser settings, or type the code.", needs_prompt: false }
    }
    ret ScanSupport { available: true, reason: "ok", message: "", needs_prompt: !str.eq(env.permission, "granted") }
}

// The format name a detector reports as a symbology key: letters and digits only, lower case.
fn symbology_key(a: *mem.Arena, format: str) -> str {
    let (out, e) = mem.alloc[u8](a, format.len + 1usize)
    if e != ok { ret "code128" }
    var n = 0usize
    var i = 0usize
    while i < format.len {
        var c = format[i]
        if c >= 65u8 && c <= 90u8 { c = c + 32u8 }
        if (c >= 97u8 && c <= 122u8) || is_digit(c) {
            out[n] = c
            n += 1usize
        }
        i += 1usize
    }
    ret out[0usize..n]
}

// Turn a detector result into a field write, or the reason there is none. `format` empty means `code128`;
// `accepted` narrows the symbologies the field takes (empty accepts any known one).
fn scan_to_value(a: *mem.Arena, raw_value: str, format: str, accepted: []const str) -> BarcodeResult {
    if raw_value.len == 0usize { ret barcode_fail("no-code", "No barcode detected.") }
    var key = "code128"
    if format.len > 0usize { key = symbology_key(a, format) }
    let (label, length, kind, known) = symbology_spec(key)
    var symbology = key
    if !known { symbology = "code128" }
    var any = false
    var allowed = false
    var names = ""
    var i = 0usize
    while i < accepted.len {
        let (l, n, k, ok_symbology) = symbology_spec(accepted[i])
        if ok_symbology {
            if any { names = join3(a, names, ", ", "") }
            names = join3(a, names, l, "")
            any = true
            if str.eq(accepted[i], symbology) { allowed = true }
        }
        i += 1usize
    }
    if any && !allowed {
        let (shown, n, k, s) = symbology_spec(symbology)
        ret barcode_fail("wrong-symbology", join3(a, join3(a, "This field accepts ", names, "; that code is "), shown, "."))
    }
    ret validate_barcode(a, raw_value, symbology)
}

// --- the registry of kinds --------------------------------------------------------------------------------------------

// The names `validate` knows, in appdor's order.
fn kinds() -> str {
    ret "iban lei isin isbn isbn10 isbn13 ean13 barcode vin credit-card imei bic vat mic duns hs-code unlocode incoterm icd10 snomed loinc ndc rxnorm mac upc nace"
}

// Validate `value` as `kind`: the answer, and whether the kind is known.
fn validate(a: *mem.Arena, kind: str, value: str) -> (bool, bool) {
    if str.eq(kind, "iban") { ret (is_iban(a, value), true) }
    if str.eq(kind, "lei") { ret (is_lei(a, value), true) }
    if str.eq(kind, "isin") { ret (is_isin(a, value), true) }
    if str.eq(kind, "isbn") { ret (is_isbn(a, value), true) }
    if str.eq(kind, "isbn10") { ret (is_isbn10(a, value), true) }
    if str.eq(kind, "isbn13") || str.eq(kind, "ean13") { ret (is_ean13(a, value), true) }
    if str.eq(kind, "barcode") { ret (is_barcode_value(a, value), true) }
    if str.eq(kind, "vin") { ret (is_vin(a, value), true) }
    if str.eq(kind, "credit-card") { ret (is_credit_card(a, value), true) }
    if str.eq(kind, "imei") { ret (is_imei(a, value), true) }
    if str.eq(kind, "bic") { ret (is_bic(a, value), true) }
    if str.eq(kind, "vat") { ret (is_eu_vat(a, value), true) }
    if str.eq(kind, "mic") { ret (is_mic(a, value), true) }
    if str.eq(kind, "duns") { ret (is_duns(a, value), true) }
    if str.eq(kind, "hs-code") { ret (is_hs_code(a, value), true) }
    if str.eq(kind, "unlocode") { ret (is_un_locode(a, value), true) }
    if str.eq(kind, "incoterm") { ret (is_incoterm(a, value), true) }
    if str.eq(kind, "icd10") { ret (is_icd10(a, value), true) }
    if str.eq(kind, "snomed") { ret (is_snomed(a, value), true) }
    if str.eq(kind, "loinc") { ret (is_loinc(a, value), true) }
    if str.eq(kind, "ndc") { ret (is_ndc(a, value), true) }
    if str.eq(kind, "rxnorm") { ret (is_rxcui(a, value), true) }
    if str.eq(kind, "mac") { ret (is_mac(a, value), true) }
    if str.eq(kind, "upc") { ret (is_upc(a, value), true) }
    if str.eq(kind, "nace") { ret (is_nace(a, value), true) }
    ret (false, false)
}
