// Identifier checksum validators (L030), after appdor's `src/fields/{specialized,barcode,nace}.js`: IBAN and LEI
// (ISO 7064 mod 97-10), Luhn, credit-card and IMEI lengths, ISBN-10, EAN-13/ISBN-13, UPC-A, ISIN, VIN, BIC, EU VAT
// structure per member state, MIC, DUNS, HS code, UN/LOCODE, Incoterms 2020, ICD-10, SNOMED CT (Verhoeff), LOINC,
// NDC, RxCUI, MAC address and NACE Rev. 2.1, plus the barcode symbology rules (GS1 mod 10, Code 39 mod 43), the
// scan-capability decision and the scan-to-field-value narrowing. Every function reads text as the original does:
// upper-cased, with white space and hyphens removed for the code types that tolerate them, and ASCII only in the
// character classes. `validate(kind, value)` is the registry the field types use (`kinds` lists the names).
//
// Upper casing is JavaScript's `toUpperCase` for what can matter to an ASCII-only class: a character that upper-cases
// to ASCII (dotless i, long s, sharp s, the f-ligatures) does so here too; any other non-ASCII character fails the
// character classes either way. White space is JavaScript's `\s`.

use e.mem
use e.str
use e.text.utf8 as utf8

// --- text helpers -------------------------------------------------------------------------------------------------

// JavaScript white space and line terminators.
fn js_space(u: u32) -> bool {
    if u == 32u32 || (u >= 9u32 && u <= 13u32) || u == 160u32 || u == 5760u32 || (u >= 8192u32 && u <= 8202u32) { ret true }
    ret u == 8232u32 || u == 8233u32 || u == 8239u32 || u == 8287u32 || u == 12288u32 || u == 65279u32
}

fn is_digit(c: u8) -> bool { ret c >= 48u8 && c <= 57u8 }

fn is_upper(c: u8) -> bool { ret c >= 65u8 && c <= 90u8 }

fn is_alnum_upper(c: u8) -> bool { ret is_digit(c) || is_upper(c) }

fn is_ascii(s: str) -> bool {
    var i = 0usize
    while i < s.len {
        if s[i] >= 128u8 { ret false }
        i += 1usize
    }
    ret true
}

// The text with white space trimmed from both ends, as `String.prototype.trim`.
fn trim(s: str) -> str {
    var from = 0usize
    var to = s.len
    var go = true
    while go && from < to {
        var it = utf8.iterator(s[from..to])
        let (scalar, got) = utf8.iterator_next(&it)
        if got && js_space(scalar) {
            if scalar < 128u32 {
                from += 1usize
            } else if scalar < 2048u32 {
                from += 2usize
            } else {
                from += 3usize
            }
        } else {
            go = false
        }
    }
    go = true
    while go && to > from {
        var k = to - 1usize
        while k > from && (s[k] & 192u8) == 128u8 { k -= 1usize }
        var it = utf8.iterator(s[k..to])
        let (scalar, got) = utf8.iterator_next(&it)
        if got && js_space(scalar) {
            to = k
        } else {
            go = false
        }
    }
    ret s[from..to]
}

// The text in upper case. ASCII letters map; the non-ASCII characters that upper-case to ASCII expand as
// JavaScript's do; everything else is kept.
fn upper(a: *mem.Arena, s: str) -> str {
    let (out, e) = mem.alloc[u8](a, s.len * 3usize + 1usize)
    if e != ok { ret s }
    var n = 0usize
    var it = utf8.iterator(s)
    var more = true
    while more {
        let (scalar, got) = utf8.iterator_next(&it)
        if !got {
            more = false
        } else if scalar < 128u32 {
            var c = u8(scalar)
            if c >= 97u8 && c <= 122u8 { c = c - 32u8 }
            out[n] = c
            n += 1usize
        } else if scalar == 305u32 {
            out[n] = 73u8
            n += 1usize
        } else if scalar == 383u32 {
            out[n] = 83u8
            n += 1usize
        } else if scalar == 223u32 {
            out[n] = 83u8
            out[n + 1usize] = 83u8
            n += 2usize
        } else if scalar >= 64256u32 && scalar <= 64262u32 {
            // ff fi fl ffi ffl st st
            if scalar == 64256u32 {
                out[n] = 70u8
                out[n + 1usize] = 70u8
                n += 2usize
            } else if scalar == 64257u32 {
                out[n] = 70u8
                out[n + 1usize] = 73u8
                n += 2usize
            } else if scalar == 64258u32 {
                out[n] = 70u8
                out[n + 1usize] = 76u8
                n += 2usize
            } else if scalar == 64259u32 {
                out[n] = 70u8
                out[n + 1usize] = 70u8
                out[n + 2usize] = 73u8
                n += 3usize
            } else if scalar == 64260u32 {
                out[n] = 70u8
                out[n + 1usize] = 70u8
                out[n + 2usize] = 76u8
                n += 3usize
            } else {
                out[n] = 83u8
                out[n + 1usize] = 84u8
                n += 2usize
            }
        } else {
            var piece: [4]u8 = zero
            let (width, we) = utf8.encode(scalar, piece[0..])
            var k = 0usize
            while k < usize(width) {
                out[n] = piece[k]
                n += 1usize
                k += 1usize
            }
        }
    }
    ret out[0usize..n]
}

// `String(value).toUpperCase().replace(/[\s-]/g, '')`.
fn clean(a: *mem.Arena, s: str) -> str {
    let up = upper(a, s)
    let (out, e) = mem.alloc[u8](a, up.len + 1usize)
    if e != ok { ret up }
    var n = 0usize
    var it = utf8.iterator(up)
    var more = true
    while more {
        let (scalar, got) = utf8.iterator_next(&it)
        if !got {
            more = false
        } else if !js_space(scalar) && scalar != 45u32 {
            var piece: [4]u8 = zero
            let (width, we) = utf8.encode(scalar, piece[0..])
            var k = 0usize
            while k < usize(width) {
                out[n] = piece[k]
                n += 1usize
                k += 1usize
            }
        }
    }
    ret out[0usize..n]
}

fn all_digits(s: str) -> bool {
    if s.len == 0usize { ret false }
    var i = 0usize
    while i < s.len {
        if !is_digit(s[i]) { ret false }
        i += 1usize
    }
    ret true
}

fn digits_in(s: str, from: usize, to: usize) -> bool {
    if to > s.len { ret false }
    var i = from
    while i < to {
        if !is_digit(s[i]) { ret false }
        i += 1usize
    }
    ret true
}

// --- check digit arithmetic ----------------------------------------------------------------------------------------

// ISO 7064 mod 97-10 over `s`, a letter being its two-digit value (A is 10). Only digits and A-Z are read.
fn mod97(s: str) -> u64 {
    var r = 0u64
    var i = 0usize
    while i < s.len {
        let c = s[i]
        if is_upper(c) {
            let v = u64(c) - 55u64
            r = (r * 10u64 + v / 10u64) % 97u64
            r = (r * 10u64 + v % 10u64) % 97u64
        } else {
            r = (r * 10u64 + u64(c) - 48u64) % 97u64
        }
        i += 1usize
    }
    ret r
}

// Luhn over an all-digit text.
fn luhn_digits(s: str) -> bool {
    var sum = 0u64
    var alt = false
    var i = s.len
    while i > 0usize {
        i -= 1usize
        var d = u64(s[i]) - 48u64
        if alt {
            d = d * 2u64
            if d > 9u64 { d = d - 9u64 }
        }
        sum += d
        alt = !alt
    }
    ret sum % 10u64 == 0u64
}

// `isLuhn`: the cleaned text must be digits.
fn is_luhn(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    if !all_digits(s) { ret false }
    ret luhn_digits(s)
}

fn is_credit_card(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    ret s.len >= 12usize && s.len <= 19usize && all_digits(s) && luhn_digits(s)
}

fn is_imei(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    ret s.len == 15usize && all_digits(s) && luhn_digits(s)
}

fn is_iban(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    if s.len < 14usize || s.len > 34usize || !is_ascii(s) { ret false }
    if !is_upper(s[0usize]) || !is_upper(s[1usize]) || !is_digit(s[2usize]) || !is_digit(s[3usize]) { ret false }
    var i = 4usize
    while i < s.len {
        if !is_alnum_upper(s[i]) { ret false }
        i += 1usize
    }
    let (out, e) = mem.alloc[u8](a, s.len)
    if e != ok { ret false }
    var n = 0usize
    i = 4usize
    while i < s.len {
        out[n] = s[i]
        n += 1usize
        i += 1usize
    }
    i = 0usize
    while i < 4usize {
        out[n] = s[i]
        n += 1usize
        i += 1usize
    }
    ret mod97(out[0usize..n]) == 1u64
}

fn is_lei(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    if s.len != 20usize || !is_ascii(s) { ret false }
    var i = 0usize
    while i < 18usize {
        if !is_alnum_upper(s[i]) { ret false }
        i += 1usize
    }
    if !is_digit(s[18usize]) || !is_digit(s[19usize]) { ret false }
    ret mod97(s) == 1u64
}

fn is_isbn10(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    if s.len != 10usize || !digits_in(s, 0usize, 9usize) { ret false }
    if !is_digit(s[9usize]) && s[9usize] != 88u8 { ret false }
    var sum = 0u64
    var i = 0usize
    while i < 9usize {
        sum += (u64(s[i]) - 48u64) * u64(10usize - i)
        i += 1usize
    }
    if s[9usize] == 88u8 { sum += 10u64 } else { sum += u64(s[9usize]) - 48u64 }
    ret sum % 11u64 == 0u64
}

fn ean13_digits(s: str) -> bool {
    var sum = 0u64
    var i = 0usize
    while i < 13usize {
        var w = 3u64
        if i % 2usize == 0usize { w = 1u64 }
        sum += (u64(s[i]) - 48u64) * w
        i += 1usize
    }
    ret sum % 10u64 == 0u64
}

fn is_ean13(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    ret s.len == 13usize && all_digits(s) && ean13_digits(s)
}

fn is_isbn(a: *mem.Arena, value: str) -> bool { ret is_isbn10(a, value) || is_ean13(a, value) }

fn is_isin(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    if s.len != 12usize || !is_ascii(s) { ret false }
    if !is_upper(s[0usize]) || !is_upper(s[1usize]) { ret false }
    var i = 2usize
    while i < 11usize {
        if !is_alnum_upper(s[i]) { ret false }
        i += 1usize
    }
    if !is_digit(s[11usize]) { ret false }
    // letters become two digits, then Luhn over the digit string
    let (digits, e) = mem.alloc[u8](a, 24usize)
    if e != ok { ret false }
    var n = 0usize
    i = 0usize
    while i < 12usize {
        let c = s[i]
        if is_upper(c) {
            let v = c - 55u8
            digits[n] = 48u8 + v / 10u8
            digits[n + 1usize] = 48u8 + v % 10u8
            n += 2usize
        } else {
            digits[n] = c
            n += 1usize
        }
        i += 1usize
    }
    ret luhn_digits(digits[0usize..n])
}

fn vin_value(c: u8) -> i64 {
    if is_digit(c) { ret i64(c) - 48i64 }
    if c == 65u8 || c == 74u8 { ret 1i64 }
    if c == 66u8 || c == 75u8 || c == 83u8 { ret 2i64 }
    if c == 67u8 || c == 76u8 || c == 84u8 { ret 3i64 }
    if c == 68u8 || c == 77u8 || c == 85u8 { ret 4i64 }
    if c == 69u8 || c == 78u8 || c == 86u8 { ret 5i64 }
    if c == 70u8 || c == 87u8 { ret 6i64 }
    if c == 71u8 || c == 80u8 || c == 88u8 { ret 7i64 }
    if c == 72u8 || c == 89u8 { ret 8i64 }
    if c == 82u8 || c == 90u8 { ret 9i64 }
    ret -1i64
}

fn vin_weight(i: usize) -> i64 {
    let w = "\x08\x07\x06\x05\x04\x03\x02\x0a\x00\x09\x08\x07\x06\x05\x04\x03\x02"
    ret i64(w[i])
}

fn is_vin(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    if s.len != 17usize || !is_ascii(s) { ret false }
    var sum = 0i64
    var i = 0usize
    while i < 17usize {
        let c = s[i]
        // [A-HJ-NPR-Z0-9]: no I, O or Q
        if !is_alnum_upper(c) || c == 73u8 || c == 79u8 || c == 81u8 { ret false }
        sum += vin_value(c) * vin_weight(i)
        i += 1usize
    }
    let check = sum % 11i64
    var expected = 88u8
    if check != 10i64 { expected = u8(48i64 + check) }
    ret s[8usize] == expected
}

fn is_bic(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    if (s.len != 8usize && s.len != 11usize) || !is_ascii(s) { ret false }
    var i = 0usize
    while i < 6usize {
        if !is_upper(s[i]) { ret false }
        i += 1usize
    }
    while i < s.len {
        if !is_alnum_upper(s[i]) { ret false }
        i += 1usize
    }
    ret true
}

// --- national and industry code structures ---------------------------------------------------------------------------

fn spec_class(c: u8, ch: u8) -> bool {
    if c == 100u8 { ret is_digit(ch) }
    if c == 97u8 { ret is_upper(ch) }
    if c == 110u8 { ret is_alnum_upper(ch) }
    if c == 112u8 { ret is_alnum_upper(ch) || ch == 43u8 || ch == 42u8 }
    if c == 122u8 { ret ch == 48u8 || ch == 49u8 }
    ret ch == c
}

// Match `s[at..]` against the tokens of `spec` from token `from`: a class letter (d digit, a letter, n alphanumeric,
// p alphanumeric or `+*`, z `0`/`1`; an upper-case letter is itself) and an optional count `n` or `n-m`, separated
// by commas. The whole text must be consumed.
fn match_spec(s: str, at: usize, spec: str, from: usize) -> bool {
    if from >= spec.len { ret at == s.len }
    let class = spec[from]
    var p = from + 1usize
    var low = 1usize
    var high = 1usize
    if p < spec.len && is_digit(spec[p]) {
        low = 0usize
        while p < spec.len && is_digit(spec[p]) {
            low = low * 10usize + usize(spec[p] - 48u8)
            p += 1usize
        }
        high = low
        if p < spec.len && spec[p] == 45u8 {
            p += 1usize
            high = 0usize
            while p < spec.len && is_digit(spec[p]) {
                high = high * 10usize + usize(spec[p] - 48u8)
                p += 1usize
            }
        }
    }
    var next = p
    if next < spec.len && spec[next] == 44u8 { next += 1usize }
    // greedy count, backing off to the minimum
    var run = 0usize
    while run < high && at + run < s.len && spec_class(class, s[at + run]) { run += 1usize }
    while true {
        if run < low { ret false }
        if match_spec(s, at + run, spec, next) { ret true }
        if run == 0usize { ret false }
        run -= 1usize
    }
    ret false
}

fn eu_vat_table() -> str {
    ret "AT|U,d8\nBE|d9\nBE|z,d9\nBG|d9-10\nCY|d8,a\nCZ|d8-10\nDE|d9\nDK|d8\nEE|d9\nEL|d9\nES|n,d7,n\nFI|d8\nFR|n2,d9\nHR|d11\nHU|d8\nIE|d7,a1-2\nIE|d,p,d5,a\nIT|d11\nLT|d9\nLT|d12\nLU|d8\nLV|d11\nMT|d8\nNL|d9,B,d2\nPL|d10\nPT|d9\nRO|d2-10\nSE|d12\nSI|d8\nSK|d10\n"
}

fn is_eu_vat(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    if s.len < 2usize || !is_ascii(s) { ret false }
    let table = eu_vat_table()
    var start = 0usize
    var i = 0usize
    var matched = false
    while i < table.len {
        if table[i] == 10u8 {
            let line = table[start..i]
            if line[0usize] == s[0usize] && line[1usize] == s[1usize] {
                if match_spec(s, 2usize, line[3usize..line.len], 0usize) { matched = true }
            }
            start = i + 1usize
        }
        i += 1usize
    }
    ret matched
}

fn is_mic(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    if s.len != 4usize { ret false }
    var i = 0usize
    while i < 4usize {
        if !is_alnum_upper(s[i]) { ret false }
        i += 1usize
    }
    ret true
}

fn is_duns(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    ret s.len == 9usize && all_digits(s)
}

fn is_hs_code(a: *mem.Arena, value: str) -> bool {
    let cleaned = clean(a, value)
    let (out, e) = mem.alloc[u8](a, cleaned.len + 1usize)
    if e != ok { ret false }
    var n = 0usize
    var i = 0usize
    while i < cleaned.len {
        if cleaned[i] != 46u8 {
            out[n] = cleaned[i]
            n += 1usize
        }
        i += 1usize
    }
    let s: str = out[0usize..n]
    if (s.len != 6usize && s.len != 8usize && s.len != 10usize) || !all_digits(s) { ret false }
    let chapter = u32(s[0usize] - 48u8) * 10u32 + u32(s[1usize] - 48u8)
    ret chapter != 0u32 && chapter != 77u32 && chapter <= 97u32
}

fn is_un_locode(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    if s.len != 5usize { ret false }
    if !is_upper(s[0usize]) || !is_upper(s[1usize]) { ret false }
    var i = 2usize
    while i < 5usize {
        if !is_upper(s[i]) && !(s[i] >= 50u8 && s[i] <= 57u8) { ret false }
        i += 1usize
    }
    ret true
}

fn is_incoterm(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    let terms = "EXW FCA FAS FOB CFR CIF CPT CIP DAP DPU DDP"
    var i = 0usize
    while i + 3usize <= terms.len {
        if str.eq(terms[i..i + 3usize], s) { ret true }
        i += 4usize
    }
    ret false
}

fn is_icd10(a: *mem.Arena, value: str) -> bool {
    let s = trim(upper(a, value))
    if s.len < 3usize || !is_ascii(s) { ret false }
    if !is_upper(s[0usize]) || !is_digit(s[1usize]) || !is_alnum_upper(s[2usize]) { ret false }
    if s.len == 3usize { ret true }
    if s[3usize] != 46u8 || s.len < 5usize || s.len > 8usize { ret false }
    var i = 4usize
    while i < s.len {
        if !is_alnum_upper(s[i]) { ret false }
        i += 1usize
    }
    ret true
}

// Verhoeff: the dihedral group's multiplication (10 x 10) and permutation (8 x 10) tables, one digit per character.
fn vh_d() -> str { ret "0123456789123406789523401789563401289567401239567859876043216598710432765982104387659321049876543210" }

fn vh_p() -> str { ret "01234567891576283094580379614289160435279453126870428657390127938064157046913258" }

fn verhoeff_valid(s: str) -> bool {
    let d = vh_d()
    let p = vh_p()
    var c = 0usize
    var i = 0usize
    while i < s.len {
        let digit = usize(s[s.len - 1usize - i] - 48u8)
        let permuted = usize(p[(i % 8usize) * 10usize + digit] - 48u8)
        c = usize(d[c * 10usize + permuted] - 48u8)
        i += 1usize
    }
    ret c == 0usize
}

fn is_snomed(a: *mem.Arena, value: str) -> bool {
    let s = clean(a, value)
    if s.len < 6usize || s.len > 18usize || !all_digits(s) || s[0usize] == 48u8 { ret false }
    ret verhoeff_valid(s)
}

fn is_loinc(a: *mem.Arena, value: str) -> bool {
    let s = trim(upper(a, value))
    // 1-7 digits, a hyphen, one digit
    if s.len < 3usize || s.len > 9usize || !is_ascii(s) { ret false }
    let dash = s.len - 2usize
    if s[dash] != 45u8 || !digits_in(s, 0usize, dash) || !is_digit(s[s.len - 1usize]) { ret false }
    let (joined, e) = mem.alloc[u8](a, s.len)
    if e != ok { ret false }
    var n = 0usize
    var i = 0usize
    while i < s.len {
        if i != dash {
            joined[n] = s[i]
            n += 1usize
        }
        i += 1usize
    }
    ret is_luhn(a, joined[0usize..n])
}

fn is_ndc(a: *mem.Arena, value: str) -> bool {
    let s = trim(value)
    if !is_ascii(s) { ret false }
    if all_digits(s) { ret s.len == 10usize || s.len == 11usize }
    // d{4,5}-d{3,4}-d{1,2}, ten or eleven digits in all
    var parts: [3]usize = zero
    var part = 0usize
    var i = 0usize
    var digits = 0usize
    while i < s.len {
        if is_digit(s[i]) {
            if part > 2usize { ret false }
            parts[part] += 1usize
            digits += 1usize
        } else if s[i] == 45u8 {
            part += 1usize
        } else {
            ret false
        }
        i += 1usize
    }
    if part != 2usize { ret false }
    if parts[0usize] < 4usize || parts[0usize] > 5usize || parts[1usize] < 3usize || parts[1usize] > 4usize || parts[2usize] < 1usize || parts[2usize] > 2usize { ret false }
    ret digits == 10usize || digits == 11usize
}

fn is_rxcui(a: *mem.Arena, value: str) -> bool {
    let s = trim(value)
    ret s.len >= 1usize && s.len <= 8usize && all_digits(s)
}

fn is_hex_upper(c: u8) -> bool { ret is_digit(c) || (c >= 65u8 && c <= 70u8) }

fn is_mac(a: *mem.Arena, value: str) -> bool {
    let s = trim(upper(a, value))
