}

fn i_abs(a: i64) -> i64 {
    if a < 0i64 { ret -a }
    ret a
}

fn f_sign(a: f64, b: f64) -> f64 { ret math.copysign[f64](math.abs[f64](a), b) }

fn i_sign(a: i64, b: i64) -> i64 {
    let m = i_abs(a)
