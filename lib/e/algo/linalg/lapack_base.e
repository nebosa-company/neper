// statement for statement from the Fortran sources so that arithmetic, rounding and branch decisions (and with them the
// signs of eigenvectors and singular vectors) are the ones R's bundled LAPACK makes. Array arguments are column-major
// slices; a scalar a routine modifies is passed as a pointer; Fortran GOTO structure is kept as a block dispatcher.
// Generated by a translator from the Fortran sources and not edited by hand: the Fortran source is the reference.
// This module holds the BLAS level 1-3 routines, the Householder family (dgeqrf, dorgqr, dormqr, ...) and the helpers.

use e.math

fn sl[T: type](x: []T, off: usize) -> []T {
    if off >= x.len { ret x[x.len..] }
    ret x[off..]
}

fn f_max(a: f64, b: f64) -> f64 {
    if a > b { ret a }
    ret b
}

fn f_min(a: f64, b: f64) -> f64 {
