}

fn ceq(a: str, b: str) -> bool {
    if a.len == 0usize || b.len == 0usize { ret false }
    ret a[0usize] == b[0usize]
}

fn lsame(ca: str, cb: str) -> bool { ret up_code(ca, 0usize) == up_code(cb, 0usize) }

