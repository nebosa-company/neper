// UTS #46 domain processing for the URL Standard's "domain to ASCII": the mapping step over the Unicode IDNA mapping table
// (`e.net.uts46_table`, generated by `scripts/gen_uts46.py`), NFC normalisation, and per label the validity criteria
// (nontransitional: deviation characters are kept, no hyphen checks, no STD3 rules unless `strict`), CheckJoiners and
// CheckBidi, then Punycode for the labels that are not ASCII. `xn--` labels are decoded and checked first.
//
// `to_ascii` answers the A-label form of a domain and false when the processing recorded an error (a disallowed code point,
// a bad Punycode label, a failed joiner or bidi rule). An empty result is for the caller to refuse.
//
// Memory: results and scratch live in the arena given.

use e.data.list as list
use e.mem
use e.net.idna as idna
use e.net.uts46_table as table
use e.text.normalize as normalize
use e.text.unicode as unicode
use e.text.utf8 as utf8

const VALID: u8 = 0u8
const IGNORED: u8 = 1u8
const MAPPED: u8 = 2u8
const DEVIATION: u8 = 3u8
const DISALLOWED: u8 = 4u8
const STD3_VALID: u8 = 5u8
const STD3_MAPPED: u8 = 6u8

type Rec = struct { status: u8, off: usize, len: usize }

fn rec_start(records: str, i: usize) -> u32 {
    let at = i * 7usize
    ret (u32(records[at]) << 16u32) | (u32(records[at + 1usize]) << 8u32) | u32(records[at + 2usize])
}

// The mapping record covering a code point.
fn lookup(cp: u32) -> Rec {
    let records = table.uts46_records()
    var lo = 0usize
    var hi = table.uts46_count()
    while hi - lo > 1usize {
        let mid = (lo + hi) / 2usize
        if rec_start(records, mid) <= cp { lo = mid } else { hi = mid }
    }
    let at = lo * 7usize
    ret Rec { status: records[at + 3usize], off: (usize(records[at + 4usize]) << 8usize) | usize(records[at + 5usize]), len: usize(records[at + 6usize]) }
}

fn pool_at(i: usize) -> u32 {
    let pool = table.uts46_pool()
    let at = i * 3usize
    ret (u32(pool[at]) << 16u32) | (u32(pool[at + 1usize]) << 8u32) | u32(pool[at + 2usize])
}

fn is_mark(cp: u32) -> bool {
    let c = unicode.category(cp)
    ret c == .Mn || c == .Mc || c == .Me
}

fn nfc_points(a: *mem.Arena, points: []const u32) -> bool {
    let (text, te) = mem.alloc[u8](a, points.len * 4usize + 4usize)
    if te != ok { ret false }
    var used = 0usize
    var i = 0usize
    while i < points.len {
        let (w, ee) = utf8.encode(points[i], text[used..])
        if ee != ok { ret false }
        used += usize(w)
        i += 1usize
    }
    let (yes, ce) = normalize.is_normalized(text[0usize..used], .Nfc)
    ret ce == ok && yes
}

fn status_ok(status: u8, strict: bool) -> bool {
    if status == VALID || status == DEVIATION { ret true }
    ret status == STD3_VALID && !strict
}

// The A-label form of `domain`; false when the processing found an error.
fn to_ascii(a: *mem.Arena, domain: str, strict: bool) -> (str, bool) {
    // 1. Map.
    let (mapped, me) = mem.alloc[u32](a, domain.len * 18usize + 8usize)
    if me != ok { ret ("", false) }
    var n = 0usize
    var bad = false
    var it = utf8.iterator(domain)
    while true {
        let (cp, more) = utf8.iterator_next(&it)
        if !more { break }
        let r = lookup(cp)
        if r.status == VALID || r.status == DEVIATION {
            mapped[n] = cp
            n += 1usize
        } else if r.status == IGNORED {
            n += 0usize
        } else if r.status == MAPPED || (r.status == STD3_MAPPED && !strict) {
            var k = 0usize
            while k < r.len {
                mapped[n] = pool_at(r.off + k)
                n += 1usize
                k += 1usize
            }
        } else if r.status == STD3_VALID && !strict {
            mapped[n] = cp
            n += 1usize
        } else {
            bad = true
            mapped[n] = cp
            n += 1usize
        }
    }
    if bad { ret ("", false) }
    // 2. Normalise.
    let (text, te) = mem.alloc[u8](a, n * 4usize + 8usize)
    if te != ok { ret ("", false) }
    var used = 0usize
    var i = 0usize
    while i < n {
        let (w, ee) = utf8.encode(mapped[i], text[used..])
        if ee != ok { ret ("", false) }
        used += usize(w)
        i += 1usize
    }
    let (points, pe) = mem.alloc[u32](a, used * 4usize + 8usize)
    if pe != ok { ret ("", false) }
    let (count, ne) = normalize.normalize_into(text[0usize..used], points, .Nfc)
    if ne != ok { ret ("", false) }
    // 3 and 4. Labels: validate, decode `xn--` labels, remember each label's code points for the bidi rule.
    let (out, oe) = mem.alloc[u8](a, count * 8usize + 64usize)
    if oe != ok { ret ("", false) }
    var out_len = 0usize
    let (label_pts, lpe) = list.init[usize](a, 8usize)
    if lpe != ok { ret ("", false) }
    var spans = label_pts
    var start = 0usize
    var any_rtl = false
    var all_bidi = true
    var idx = 0usize
    while idx <= count {
        if idx == count || points[idx] == 46u32 {
            let label = points[start..idx]
            var check = label
            var is_xn = false
            let (dec, de) = mem.alloc[u32](a, label.len * 4usize + 8usize)
            if de != ok { ret ("", false) }
            if label.len >= 4usize && label[0usize] == 120u32 && label[1usize] == 110u32 && label[2usize] == 45u32 && label[3usize] == 45u32 {
                is_xn = true
                // IgnoreInvalidPunycode: a label that does not decode or validate is kept as it is.
                var xn_valid = label.len - 4usize <= 120usize
                var rest_bytes: [128]u8 = zero
                var k = 4usize
                while xn_valid && k < label.len {
                    if label[k] >= 128u32 { xn_valid = false } else { rest_bytes[k - 4usize] = u8(label[k]) }
                    k += 1usize
                }
                var dn = 0usize
                if xn_valid && label.len > 4usize {
                    let (cnt, pe2) = idna.punycode_decode(rest_bytes[0usize..label.len - 4usize], dec)
                    if pe2 != ok { xn_valid = false } else { dn = cnt }
                }
                if xn_valid {
                    check = dec[0usize..dn]
                    var q = 0usize
                    while q < dn {
                        if !status_ok(lookup(dec[q]).status, strict) { xn_valid = false }
                        q += 1usize
                    }
                    if xn_valid && dn > 0usize && !nfc_points(a, check) { xn_valid = false }
                    if xn_valid && dn > 0usize && is_mark(check[0usize]) { xn_valid = false }
                    var jj = 0usize
                    while xn_valid && jj < dn {
                        if (check[jj] == 8204u32 || check[jj] == 8205u32) && !idna.contextj_ok(check, jj) { xn_valid = false }
                        jj += 1usize
                    }
                }
                if !xn_valid { check = label[0usize..0usize] }
            }
            if !is_xn {
                if check.len > 0usize && is_mark(check[0usize]) { ret ("", false) }
                var j = 0usize
                while j < check.len {
                    if (check[j] == 8204u32 || check[j] == 8205u32) && !idna.contextj_ok(check, j) { ret ("", false) }
                    j += 1usize
                }
            }
            // CheckBidi inputs.
            if check.len > 0usize && idna.has_rtl(check) { any_rtl = true }
            if check.len > 0usize && !idna.bidi_rule_ok(check) { all_bidi = false }
            // 5. ToASCII.
            if start > 0usize && out_len < out.len {
                out[out_len] = 46u8
                out_len += 1usize
            }
            var ascii = true
            var z = 0usize
            while z < label.len {
                if label[z] >= 128u32 { ascii = false }
                z += 1usize
            }
            if ascii || is_xn {
                z = 0usize
                while z < label.len && out_len < out.len {
                    out[out_len] = u8(label[z])
                    out_len += 1usize
                    z += 1usize
                }
            } else {
                if out_len + 4usize > out.len { ret ("", false) }
                out[out_len] = 120u8
                out[out_len + 1usize] = 110u8
                out[out_len + 2usize] = 45u8
                out[out_len + 3usize] = 45u8
                out_len += 4usize
                let (pn, ee2) = idna.punycode_encode(label, out[out_len..])
                if ee2 != ok { ret ("", false) }
                out_len += pn
            }
            start = idx + 1usize
        }
        idx += 1usize
    }
    if any_rtl && !all_bidi { ret ("", false) }
    ret (out[0usize..out_len], true)
}
