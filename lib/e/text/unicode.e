// UAX #31 identifiers by general category: a start is a letter (Lu Ll Lt Lm Lo),
// a letter number (Nl) or `_`; a continue adds the nonspacing and spacing marks (Mn
// Mc), decimal digits (Nd) and connectors (Pc). ponytail: this is the category
// approximation of XID_Start/XID_Continue, not the DerivedCoreProperties table --
// it keeps the handful of Other_ID_Start and Other_ID_Continue scalars (U+2118,
// U+212E, U+309B, U+309C, U+00B7, U+0387, U+1369..U+1371, U+19DA) out and admits a
// few Lo/Mn scalars NFKC would exclude; the property table is the upgrade.
fn is_id_start(scalar: u32) -> bool {
    if scalar == 95u32 { ret true }
    ret is_alphabetic(scalar)
}

fn is_id_continue(scalar: u32) -> bool {
    if is_id_start(scalar) { ret true }
    let c = category(scalar)
    ret c == .Mn || c == .Mc || c == .Nd || c == .Pc
}

// Whether `s` is a non-empty identifier: a start scalar then continue scalars, with
// malformed UTF-8 refused.
fn is_identifier(s: str) -> bool {
    if s.len == 0usize { ret false }
    var at = 0usize
    var first = true
    while at < s.len {
        let (scalar, width) = read_utf8(s, at)
        if scalar == 65533u32 && width == 1usize { ret false }
        if first && !is_id_start(scalar) { ret false }
        if !first && !is_id_continue(scalar) { ret false }
        first = false
        at += width
    }
    ret true
}
