// Unicode character properties from tables generated out of Python's unicodedata
// (the version `version` names) by the script beside the fixture: general category
// as runs of (start, category) searched by binary search, canonical combining class
// the same way, simple lower and upper case mappings and full case folding as
// sorted (scalar, mapping) pairs, White_Space by the property's own list, and
// alphabetic and numeric derived from the category. Graphemes are extended clusters
// by a reduced rule set -- CR LF, a base with its Mn/Mc/Me marks, ZWJ and variation
// selectors, a ZWJ joining the next scalar, regional indicators in pairs, Hangul
// jamo runs -- with the Grapheme_Cluster_Break table and the full UAX #29 rules as
// the upgrade, since what is here covers text that is not emoji-sequence heavy.
//
// ponytail: `is_alphabetic` is the letter categories and Nl, not the Alphabetic
// derived property (which adds Other_Alphabetic marks); tables are byte strings
// read little-endian, three or four bytes a scalar.
use e.mem

type Category = enum u8 { Lu, Ll, Lt, Lm, Lo, Mn, Mc, Me, Nd, Nl, No, Pc, Pd, Ps, Pe, Pi, Pf, Po, Sm, Sc, Sk, So, Zs, Zl, Zp, Cc, Cf, Cs, Co, Cn }
type Graphemes = struct { text: str, off: usize }

fn scalar_at(table: str, at: usize) -> u32 {
    ret u32(table[at]) | (u32(table[at + 1usize]) << 8u32) | (u32(table[at + 2usize]) << 16u32)
}

fn read_u32(table: str, at: usize) -> u32 {
    ret scalar_at(table, at) | (u32(table[at + 3usize]) << 24u32)
}

// The last run whose start is at or before `scalar`, in a table of 4-byte entries
// (3-byte start, 1-byte value).
fn run_value(table: str, scalar: u32) -> u8 {
    var low = 0usize
    var high = table.len / 4usize
    while high - low > 1usize {
        let mid = (low + high) / 2usize
        if scalar_at(table, mid * 4usize) <= scalar { low = mid } else { high = mid }
    }
    ret table[low * 4usize + 3usize]
}

fn category_of(code: u8) -> Category {
    if code == 0u8 { ret .Lu }
    if code == 1u8 { ret .Ll }
    if code == 2u8 { ret .Lt }
    if code == 3u8 { ret .Lm }
    if code == 4u8 { ret .Lo }
    if code == 5u8 { ret .Mn }
    if code == 6u8 { ret .Mc }
    if code == 7u8 { ret .Me }
    if code == 8u8 { ret .Nd }
    if code == 9u8 { ret .Nl }
    if code == 10u8 { ret .No }
    if code == 11u8 { ret .Pc }
    if code == 12u8 { ret .Pd }
    if code == 13u8 { ret .Ps }
    if code == 14u8 { ret .Pe }
    if code == 15u8 { ret .Pi }
    if code == 16u8 { ret .Pf }
    if code == 17u8 { ret .Po }
    if code == 18u8 { ret .Sm }
    if code == 19u8 { ret .Sc }
    if code == 20u8 { ret .Sk }
    if code == 21u8 { ret .So }
    if code == 22u8 { ret .Zs }
    if code == 23u8 { ret .Zl }
    if code == 24u8 { ret .Zp }
    if code == 25u8 { ret .Cc }
    if code == 26u8 { ret .Cf }
    if code == 27u8 { ret .Cs }
    if code == 28u8 { ret .Co }
    ret .Cn
}

fn category(scalar: u32) -> Category {
    if scalar > 1114111u32 { ret .Cn }
    ret category_of(run_value(category_table(), scalar))
}

fn combining_class(scalar: u32) -> u8 {
    if scalar > 1114111u32 { ret 0u8 }
    ret run_value(combining_table(), scalar)
}

fn is_whitespace(scalar: u32) -> bool {
    if scalar >= 9u32 && scalar <= 13u32 { ret true }
    if scalar == 32u32 || scalar == 133u32 || scalar == 160u32 || scalar == 5760u32 { ret true }
    if scalar >= 8192u32 && scalar <= 8202u32 { ret true }
    ret scalar == 8232u32 || scalar == 8233u32 || scalar == 8239u32 || scalar == 8287u32 || scalar == 12288u32
}

fn is_alphabetic(scalar: u32) -> bool {
    let c = category(scalar)
    ret c == .Lu || c == .Ll || c == .Lt || c == .Lm || c == .Lo || c == .Nl
}

fn is_numeric(scalar: u32) -> bool {
    let c = category(scalar)
    ret c == .Nd || c == .Nl || c == .No
}

// A sorted table of 8-byte (scalar, mapping) pairs, searched by binary search.
fn pair_lookup(table: str, scalar: u32) -> (u32, bool) {
    var low = 0usize
    var high = table.len / 8usize
    while low < high {
        let mid = (low + high) / 2usize
        let key = read_u32(table, mid * 8usize)
        if key == scalar { ret (read_u32(table, mid * 8usize + 4usize), true) }
        if key < scalar { low = mid + 1usize } else { high = mid }
    }
    ret (0u32, false)
}

fn to_lower_simple(scalar: u32) -> u32 {
    let (mapped, found) = pair_lookup(lower_table(), scalar)
    if found { ret mapped }
    ret scalar
}

fn to_upper_simple(scalar: u32) -> u32 {
    let (mapped, found) = pair_lookup(upper_table(), scalar)
    if found { ret mapped }
    ret scalar
}

fn utf8_length(scalar: u32) -> usize {
    if scalar < 128u32 { ret 1usize }
    if scalar < 2048u32 { ret 2usize }
    if scalar < 65536u32 { ret 3usize }
    ret 4usize
}

fn write_utf8(scalar: u32, dst: []u8, at: usize) -> usize {
    if scalar < 128u32 {
        dst[at] = u8(scalar)
        ret at + 1usize
    }
    if scalar < 2048u32 {
        dst[at] = u8(192u32 | (scalar >> 6u32))
        dst[at + 1usize] = u8(128u32 | (scalar & 63u32))
        ret at + 2usize
    }
    if scalar < 65536u32 {
        dst[at] = u8(224u32 | (scalar >> 12u32))
        dst[at + 1usize] = u8(128u32 | ((scalar >> 6u32) & 63u32))
        dst[at + 2usize] = u8(128u32 | (scalar & 63u32))
        ret at + 3usize
    }
    dst[at] = u8(240u32 | (scalar >> 18u32))
    dst[at + 1usize] = u8(128u32 | ((scalar >> 12u32) & 63u32))
    dst[at + 2usize] = u8(128u32 | ((scalar >> 6u32) & 63u32))
    dst[at + 3usize] = u8(128u32 | (scalar & 63u32))
    ret at + 4usize
}

// The scalar at `at` and its byte length; a malformed sequence reads as U+FFFD over
// one byte.
fn read_utf8(text: str, at: usize) -> (u32, usize) {
    let b0 = u32(text[at])
    if b0 < 128u32 { ret (b0, 1usize) }
    var need = 0usize
    var scalar = 0u32
    if b0 >= 194u32 && b0 < 224u32 {
        need = 1usize
        scalar = b0 & 31u32
    } else {
    if b0 >= 224u32 && b0 < 240u32 {
        need = 2usize
        scalar = b0 & 15u32
    } else {
    if b0 >= 240u32 && b0 < 245u32 {
        need = 3usize
        scalar = b0 & 7u32
    } else {
        ret (65533u32, 1usize)
    }
    }
    }
    if at + need >= text.len { ret (65533u32, 1usize) }
    var i = 1usize
    while i <= need {
        let b = u32(text[at + i])
        if b & 192u32 != 128u32 { ret (65533u32, 1usize) }
        scalar = (scalar << 6u32) | (b & 63u32)
        i += 1usize
    }
    if need == 2usize && (scalar < 2048u32 || (scalar >= 55296u32 && scalar <= 57343u32)) { ret (65533u32, 1usize) }
    if need == 3usize && (scalar < 65536u32 || scalar > 1114111u32) { ret (65533u32, 1usize) }
    ret (scalar, need + 1usize)
}

// Full case folding into the arena: the simple pairs, then the few that fold to
// two or three scalars (16-byte entries: scalar, count, up to three scalars).
fn casefold(a: *mem.Arena, s: str) -> (str, err) {
    let (out, out_error) = mem.alloc[u8](a, s.len * 3usize + 4usize)
    if out_error != ok { ret ("", out_error) }
    var at = 0usize
    var used = 0usize
    while at < s.len {
        let (scalar, width) = read_utf8(s, at)
        at += width
        let (simple, has_simple) = pair_lookup(fold_table(), scalar)
        if has_simple {
            used = write_utf8(simple, out, used)
            continue
        }
        let multi = fold_multi_table()
        var i = 0usize
        var expanded = false
        while i < multi.len {
            if read_u32(multi, i) == scalar {
                let count = usize(read_u32(multi, i + 4usize))
                var k = 0usize
                while k < count {
                    used = write_utf8(read_u32(multi, i + 8usize + k * 4usize), out, used)
                    k += 1usize
                }
                expanded = true
                break
            }
            i += 20usize
        }
        if !expanded { used = write_utf8(scalar, out, used) }
    }
    ret (out[..used], ok)
}

fn graphemes(s: str) -> Graphemes {
    ret Graphemes { text: s, off: 0usize }
}

fn is_extend(scalar: u32) -> bool {
    if scalar == 8205u32 { ret true }
    if scalar >= 65024u32 && scalar <= 65039u32 { ret true }
    if scalar >= 917760u32 && scalar <= 917999u32 { ret true }
    let c = category(scalar)
    ret c == .Mn || c == .Mc || c == .Me
}

fn is_regional(scalar: u32) -> bool { ret scalar >= 127462u32 && scalar <= 127487u32 }
fn is_hangul_l(scalar: u32) -> bool { ret scalar >= 4352u32 && scalar <= 4447u32 }
fn is_hangul_v(scalar: u32) -> bool { ret scalar >= 4448u32 && scalar <= 4519u32 }
fn is_hangul_t(scalar: u32) -> bool { ret scalar >= 4520u32 && scalar <= 4607u32 }
fn is_hangul_lv(scalar: u32) -> bool { ret scalar >= 44032u32 && scalar <= 55203u32 && (scalar - 44032u32) % 28u32 == 0u32 }
fn is_hangul_lvt(scalar: u32) -> bool { ret scalar >= 44032u32 && scalar <= 55203u32 && (scalar - 44032u32) % 28u32 != 0u32 }

// Whether a cluster may continue from `previous` into `current`.
fn joins(previous: u32, current: u32, regional_run: usize) -> bool {
    if previous == 13u32 && current == 10u32 { ret true }
    if previous == 13u32 || previous == 10u32 || current == 13u32 || current == 10u32 { ret false }
    let previous_category = category(previous)
    if previous_category == .Cc || category(current) == .Cc { ret false }
    if is_extend(current) { ret true }
    if previous == 8205u32 { ret true }
    if is_regional(previous) && is_regional(current) { ret regional_run % 2usize == 1usize }
    if is_hangul_l(previous) && (is_hangul_l(current) || is_hangul_v(current) || is_hangul_lv(current) || is_hangul_lvt(current)) { ret true }
    if (is_hangul_lv(previous) || is_hangul_v(previous)) && (is_hangul_v(current) || is_hangul_t(current)) { ret true }
    if (is_hangul_lvt(previous) || is_hangul_t(previous)) && is_hangul_t(current) { ret true }
    ret false
}

fn graphemes_next(it: *Graphemes) -> (str, bool) {
    if it.off >= it.text.len { ret ("", false) }
    let start = it.off
    let (first, first_width) = read_utf8(it.text, it.off)
    var at = it.off + first_width
    var previous = first
    var regional_run = 0usize
    if is_regional(first) { regional_run = 1usize }
    while at < it.text.len {
        let (current, width) = read_utf8(it.text, at)
        if !joins(previous, current, regional_run) { break }
        if is_regional(current) { regional_run += 1usize } else { regional_run = 0usize }
        previous = current
        at += width
    }
    it.off = at
    ret (it.text[start..at], true)
}

fn version() -> str { ret "15.0.0" }

