// Text segmentation over code points for Unicode 15.0: word boundaries by UAX #29
// section 4.1 (WB1-WB999, with WB4 skipping Extend/Format/ZWJ, the MidLetter and
// MidNum runs, Hebrew quotes, Katakana, ExtendNumLet and regional indicator pairs)
// and line break opportunities by UAX #14 (LB1-LB31 with LB9/LB10 attachment,
// LB25 as the number regex `(PR|PO)? (OP|HY)? NU (NU|SY|IS)* (CL|CP)? (PR|PO)?`
// that LineBreakTest.txt is generated with, LB30's East Asian wide OP/CP exclusion,
// LB30a pairs and LB30b's unassigned pictographs). Every decision is local: a
// boundary at position i is settled by walking back over attached characters from
// i-1 and forward over them from i, so `next_word` and `next_line_break` need no
// state and `words`/`line_breaks` are one pass of those decisions.
//
// Tables are byte strings generated from WordBreakProperty.txt, emoji-data.txt,
// LineBreak.txt (with the header's block defaults), EastAsianWidth.txt and
// DerivedGeneralCategory.txt by the script beside the fixture: 4-byte runs read
// little-endian (3-byte start, 1-byte value) searched by binary search as in
// `e.text.unicode`. The word value carries Extended_Pictographic in bit 7; the
// line value carries a variant bit 6 that means SA with gc Mn/Mc (resolving to CM),
// OP/CP with East_Asian_Width F/W/H, or ID that is Extended_Pictographic and Cn.
//
// ponytail: a boundary walks back over the attached run before it, so a text that
// is one long run of combining marks or spaces costs O(n^2); a forward pass carrying
// the last base class is the upgrade if that ever matters.

type WordBreak = enum u8 { Other, CR, LF, Newline, Extend, ZWJ, RegionalIndicator, Format, Katakana, HebrewLetter, ALetter, SingleQuote, DoubleQuote, MidNumLet, MidLetter, MidNum, Numeric, ExtendNumLet, WSegSpace }
type LineBreak = enum u8 { XX, AI, AL, B2, BA, BB, BK, CB, CJ, CL, CM, CP, CR, EB, EM, EX, GL, H2, H3, HL, HY, ID, IN, IS, JL, JT, JV, LF, NL, NS, NU, OP, PO, PR, QU, RI, SA, SG, SP, SY, WJ, ZW, ZWJ }
error TooSmall

const W_OTHER: u32 = 0u32
const W_CR: u32 = 1u32
const W_LF: u32 = 2u32
const W_NEWLINE: u32 = 3u32
const W_EXTEND: u32 = 4u32
const W_ZWJ: u32 = 5u32
const W_RI: u32 = 6u32
const W_FORMAT: u32 = 7u32
const W_KATAKANA: u32 = 8u32
const W_HL: u32 = 9u32
const W_ALETTER: u32 = 10u32
const W_SQ: u32 = 11u32
const W_DQ: u32 = 12u32
const W_MIDNUMLET: u32 = 13u32
const W_MIDLETTER: u32 = 14u32
const W_MIDNUM: u32 = 15u32
const W_NUMERIC: u32 = 16u32
const W_EXTENDNUMLET: u32 = 17u32
const W_WSEGSPACE: u32 = 18u32

const L_XX: u32 = 0u32
const L_AI: u32 = 1u32
const L_AL: u32 = 2u32
const L_B2: u32 = 3u32
const L_BA: u32 = 4u32
const L_BB: u32 = 5u32
const L_BK: u32 = 6u32
const L_CB: u32 = 7u32
const L_CJ: u32 = 8u32
const L_CL: u32 = 9u32
const L_CM: u32 = 10u32
const L_CP: u32 = 11u32
const L_CR: u32 = 12u32
const L_EB: u32 = 13u32
const L_EM: u32 = 14u32
const L_EX: u32 = 15u32
const L_GL: u32 = 16u32
const L_H2: u32 = 17u32
const L_H3: u32 = 18u32
const L_HL: u32 = 19u32
const L_HY: u32 = 20u32
const L_ID: u32 = 21u32
const L_IN: u32 = 22u32
const L_IS: u32 = 23u32
const L_JL: u32 = 24u32
const L_JT: u32 = 25u32
const L_JV: u32 = 26u32
const L_LF: u32 = 27u32
const L_NL: u32 = 28u32
const L_NS: u32 = 29u32
const L_NU: u32 = 30u32
const L_OP: u32 = 31u32
const L_PO: u32 = 32u32
const L_PR: u32 = 33u32
const L_QU: u32 = 34u32
const L_RI: u32 = 35u32
const L_SA: u32 = 36u32
const L_SG: u32 = 37u32
const L_SP: u32 = 38u32
const L_SY: u32 = 39u32
const L_WJ: u32 = 40u32
const L_ZW: u32 = 41u32
const L_ZWJ: u32 = 42u32
// Resolved variants: East Asian wide OP/CP (LB30) and an unassigned pictograph (LB30b).
const L_OP_EA: u32 = 64u32
const L_CP_EA: u32 = 65u32
const L_EB_CN: u32 = 66u32
const NONE: u32 = 255u32
const VARIANT: u32 = 64u32
const EP_BIT: u32 = 128u32

fn version() -> str { ret "15.0.0" }

fn scalar_at(table: str, pos: usize) -> u32 {
    ret u32(table[pos]) | (u32(table[pos + 1usize]) << 8u32) | (u32(table[pos + 2usize]) << 16u32)
}

// The last run whose start is at or before `scalar` (3-byte start, 1-byte value).
fn run_value(table: str, scalar: u32) -> u8 {
    var low = 0usize
    var high = table.len / 4usize
    while high - low > 1usize {
        let mid = (low + high) / 2usize
        if scalar_at(table, mid * 4usize) <= scalar { low = mid } else { high = mid }
    }
    ret table[low * 4usize + 3usize]
}

fn wb_raw(cp: u32) -> u32 {
    if cp > 1114111u32 { ret W_OTHER }
    ret u32(run_value(wb_table(), cp))
}

fn wb_code(cp: u32) -> u32 { ret wb_raw(cp) & 31u32 }

// Extended_Pictographic (emoji-data.txt).
fn is_extended_pictographic(cp: u32) -> bool { ret (wb_raw(cp) & EP_BIT) != 0u32 }

// The Word_Break property of WordBreakProperty.txt.
fn word_break_property(cp: u32) -> WordBreak {
    let code = wb_code(cp)
    if code == W_CR { ret .CR }
    if code == W_LF { ret .LF }
    if code == W_NEWLINE { ret .Newline }
    if code == W_EXTEND { ret .Extend }
    if code == W_ZWJ { ret .ZWJ }
    if code == W_RI { ret .RegionalIndicator }
    if code == W_FORMAT { ret .Format }
    if code == W_KATAKANA { ret .Katakana }
    if code == W_HL { ret .HebrewLetter }
    if code == W_ALETTER { ret .ALetter }
    if code == W_SQ { ret .SingleQuote }
    if code == W_DQ { ret .DoubleQuote }
    if code == W_MIDNUMLET { ret .MidNumLet }
    if code == W_MIDLETTER { ret .MidLetter }
    if code == W_MIDNUM { ret .MidNum }
    if code == W_NUMERIC { ret .Numeric }
    if code == W_EXTENDNUMLET { ret .ExtendNumLet }
    if code == W_WSEGSPACE { ret .WSegSpace }
    ret .Other
}

fn lb_raw(cp: u32) -> u32 {
    if cp > 1114111u32 { ret L_XX }
    ret u32(run_value(lb_table(), cp))
}

// The Line_Break property of LineBreak.txt (unresolved: AI, SA, SG, XX and CJ as listed).
fn line_break_class(cp: u32) -> LineBreak {
    let code = lb_raw(cp) & 63u32
    if code == L_AI { ret .AI }
    if code == L_AL { ret .AL }
    if code == L_B2 { ret .B2 }
    if code == L_BA { ret .BA }
    if code == L_BB { ret .BB }
    if code == L_BK { ret .BK }
    if code == L_CB { ret .CB }
    if code == L_CJ { ret .CJ }
    if code == L_CL { ret .CL }
    if code == L_CM { ret .CM }
    if code == L_CP { ret .CP }
    if code == L_CR { ret .CR }
    if code == L_EB { ret .EB }
    if code == L_EM { ret .EM }
    if code == L_EX { ret .EX }
    if code == L_GL { ret .GL }
    if code == L_H2 { ret .H2 }
    if code == L_H3 { ret .H3 }
    if code == L_HL { ret .HL }
    if code == L_HY { ret .HY }
    if code == L_ID { ret .ID }
    if code == L_IN { ret .IN }
    if code == L_IS { ret .IS }
    if code == L_JL { ret .JL }
    if code == L_JT { ret .JT }
    if code == L_JV { ret .JV }
    if code == L_LF { ret .LF }
    if code == L_NL { ret .NL }
    if code == L_NS { ret .NS }
    if code == L_NU { ret .NU }
    if code == L_OP { ret .OP }
    if code == L_PO { ret .PO }
    if code == L_PR { ret .PR }
    if code == L_QU { ret .QU }
    if code == L_RI { ret .RI }
    if code == L_SA { ret .SA }
    if code == L_SG { ret .SG }
    if code == L_SP { ret .SP }
    if code == L_SY { ret .SY }
    if code == L_WJ { ret .WJ }
    if code == L_ZW { ret .ZW }
    if code == L_ZWJ { ret .ZWJ }
    ret .XX
}

// --- UAX #29 word boundaries

fn is_efz(code: u32) -> bool { ret code == W_EXTEND || code == W_FORMAT || code == W_ZWJ }
fn is_ahletter(code: u32) -> bool { ret code == W_ALETTER || code == W_HL }
fn is_mid_letter_q(code: u32) -> bool { ret code == W_MIDLETTER || code == W_MIDNUMLET || code == W_SQ }
fn is_mid_num_q(code: u32) -> bool { ret code == W_MIDNUM || code == W_MIDNUMLET || code == W_SQ }
fn is_word_newline(code: u32) -> bool { ret code == W_NEWLINE || code == W_CR || code == W_LF }

// WB4: the base before position i skipping Extend/Format/ZWJ: (index, property), or NONE
// when only skipped characters precede i.
fn word_base_before(text: []const u32, i: usize) -> (usize, u32) {
    var j = i - 1usize
    while j > 0usize && is_efz(wb_code(text[j])) { j -= 1usize }
    let code = wb_code(text[j])
    if is_efz(code) { ret (0usize, NONE) }
    ret (j, code)
}

// Whether a word boundary lies at position i (between text[i-1] and text[i]); 0 and
// text.len are boundaries.
fn is_word_boundary(text: []const u32, i: usize) -> bool {
    let n = text.len
    if i == 0usize || i >= n { ret true }
    let prev = wb_code(text[i - 1usize])
    let cur = wb_code(text[i])
    if prev == W_CR && cur == W_LF { ret false }
    if is_word_newline(prev) || is_word_newline(cur) { ret true }
    if prev == W_ZWJ && is_extended_pictographic(text[i]) { ret false }
    if prev == W_WSEGSPACE && cur == W_WSEGSPACE { ret false }
    if is_efz(cur) { ret false }
    let (pj, p) = word_base_before(text, i)
    var pp = NONE
    if p != NONE && pj > 0usize {
        let (_, before) = word_base_before(text, pj)
        pp = before
    }
    var k = i + 1usize
    while k < n && is_efz(wb_code(text[k])) { k += 1usize }
    var nn = NONE
    if k < n { nn = wb_code(text[k]) }
    if is_ahletter(p) && is_ahletter(cur) { ret false }
    if is_ahletter(p) && is_mid_letter_q(cur) && is_ahletter(nn) { ret false }
    if is_ahletter(pp) && is_mid_letter_q(p) && is_ahletter(cur) { ret false }
    if p == W_HL && cur == W_SQ { ret false }
    if p == W_HL && cur == W_DQ && nn == W_HL { ret false }
    if pp == W_HL && p == W_DQ && cur == W_HL { ret false }
    if p == W_NUMERIC && cur == W_NUMERIC { ret false }
    if is_ahletter(p) && cur == W_NUMERIC { ret false }
    if p == W_NUMERIC && is_ahletter(cur) { ret false }
    if pp == W_NUMERIC && is_mid_num_q(p) && cur == W_NUMERIC { ret false }
    if p == W_NUMERIC && is_mid_num_q(cur) && nn == W_NUMERIC { ret false }
    if p == W_KATAKANA && cur == W_KATAKANA { ret false }
    if (is_ahletter(p) || p == W_NUMERIC || p == W_KATAKANA || p == W_EXTENDNUMLET) && cur == W_EXTENDNUMLET { ret false }
    if p == W_EXTENDNUMLET && (is_ahletter(cur) || cur == W_NUMERIC || cur == W_KATAKANA) { ret false }
    if p == W_RI && cur == W_RI {
        var count = 0usize
        var back = i
        var more = true
        while more {
            let (j, q) = word_base_before(text, back)
            if q == W_RI {
                count += 1usize
                back = j
                if back == 0usize { more = false }
            } else {
                more = false
            }
        }
        if count % 2usize == 1usize { ret false }
    }
    ret true
}

// The word boundary after `from` (text.len when none is nearer).
fn next_word(text: []const u32, from: usize) -> usize {
    var i = from + 1usize
    while i < text.len && !is_word_boundary(text, i) { i += 1usize }
    if i > text.len { ret text.len }
    ret i
}

// Every word boundary of `text` (0 and text.len included) into `boundaries`; the count.
fn words(text: []const u32, boundaries: []usize) -> (usize, err) {
    var count = 0usize
    var i = 0usize
    while i <= text.len {
        if is_word_boundary(text, i) {
            if count >= boundaries.len { ret (count, TooSmall) }
            boundaries[count] = i
            count += 1usize
        }
        i += 1usize
    }
    ret (count, ok)
}

// --- UAX #14 line break opportunities

// LB1 with the variant bit: AI/SG/XX to AL, SA to CM (marks) or AL, CJ to NS; wide
// OP/CP and unassigned pictographs keep their variant code.
fn lb_resolved(cp: u32) -> u32 {
    let raw = lb_raw(cp)
    let code = raw & 63u32
    let variant = (raw & VARIANT) != 0u32
    if code == L_AI || code == L_SG || code == L_XX { ret L_AL }
    if code == L_SA {
        if variant { ret L_CM }
        ret L_AL
    }
    if code == L_CJ { ret L_NS }
    if variant {
        if code == L_OP { ret L_OP_EA }
        if code == L_CP { ret L_CP_EA }
        if code == L_ID { ret L_EB_CN }
    }
    ret code
}

fn is_op(code: u32) -> bool { ret code == L_OP || code == L_OP_EA }
fn is_cp(code: u32) -> bool { ret code == L_CP || code == L_CP_EA }
fn is_id(code: u32) -> bool { ret code == L_ID || code == L_EB_CN }
fn is_alhl(code: u32) -> bool { ret code == L_AL || code == L_HL }
fn is_attachable(code: u32) -> bool { ret code == L_CM || code == L_ZWJ }
fn is_hangul(code: u32) -> bool { ret code == L_JL || code == L_JV || code == L_JT || code == L_H2 || code == L_H3 }
fn is_prefix(code: u32) -> bool { ret code == L_PR || code == L_PO }

// LB9's X: anything but BK, CR, LF, NL, SP or ZW.
fn refuses_attachment(code: u32) -> bool {
    ret code == L_BK || code == L_CR || code == L_LF || code == L_NL || code == L_SP || code == L_ZW
}

// LB9/LB10: the base of the character before position i: (index, effective class);
// a CM/ZWJ with nothing to attach to is AL.
fn line_base_before(text: []const u32, i: usize) -> (usize, u32) {
    var j = i - 1usize
    var code = lb_resolved(text[j])
    while is_attachable(code) {
        if j == 0usize { ret (j, L_AL) }
        let prev = lb_resolved(text[j - 1usize])
        if refuses_attachment(prev) { ret (j, L_AL) }
        j -= 1usize
        code = prev
    }
    ret (j, code)
}

// The break opportunity at position i: 0 none, 1 allowed, 2 mandatory (2 at text.len,
// 0 at 0).
fn line_break_at(text: []const u32, i: usize) -> u8 {
    let n = text.len
    if i == 0usize { ret 0u8 }
    if i >= n { ret 2u8 }
    let raw_prev = lb_resolved(text[i - 1usize])
    var cur = lb_resolved(text[i])
    let (pj, p) = line_base_before(text, i)
    if p == L_BK { ret 2u8 }
    if p == L_CR && cur == L_LF { ret 0u8 }
    if p == L_CR || p == L_LF || p == L_NL { ret 2u8 }
    if cur == L_BK || cur == L_CR || cur == L_LF || cur == L_NL { ret 0u8 }
    if cur == L_SP || cur == L_ZW { ret 0u8 }
    // The class before the run of spaces ending at i-1 (LB8, LB14-LB17).
    var ps = p
    if p == L_SP {
        var k = pj
        while k > 0usize && lb_resolved(text[k - 1usize]) == L_SP { k -= 1usize }
        ps = NONE
        if k > 0usize {
            let (_, before_spaces) = line_base_before(text, k)
            ps = before_spaces
        }
    }
    if ps == L_ZW { ret 1u8 }
    if raw_prev == L_ZWJ { ret 0u8 }
    if is_attachable(cur) {
        if !refuses_attachment(p) { ret 0u8 }
        cur = L_AL
    }
    if cur == L_WJ || p == L_WJ { ret 0u8 }
    if p == L_GL { ret 0u8 }
    if p != L_SP && p != L_BA && p != L_HY && cur == L_GL { ret 0u8 }
    if cur == L_CL || is_cp(cur) || cur == L_EX || cur == L_IS || cur == L_SY { ret 0u8 }
    if is_op(ps) { ret 0u8 }
    if ps == L_QU && is_op(cur) { ret 0u8 }
    if (ps == L_CL || is_cp(ps)) && cur == L_NS { ret 0u8 }
    if ps == L_B2 && cur == L_B2 { ret 0u8 }
    if p == L_SP { ret 1u8 }
    if cur == L_QU || p == L_QU { ret 0u8 }
    if cur == L_CB || p == L_CB { ret 1u8 }
    if cur == L_BA || cur == L_HY || cur == L_NS || p == L_BB { ret 0u8 }
    if (p == L_HY || p == L_BA) && pj > 0usize {
        let (_, before_hyphen) = line_base_before(text, pj)
        if before_hyphen == L_HL { ret 0u8 }
    }
    if p == L_SY && cur == L_HL { ret 0u8 }
    if cur == L_IN { ret 0u8 }
    if is_alhl(p) && cur == L_NU { ret 0u8 }
    if p == L_NU && is_alhl(cur) { ret 0u8 }
    if p == L_PR && (is_id(cur) || cur == L_EB || cur == L_EM) { ret 0u8 }
    if (is_id(p) || p == L_EB || p == L_EM) && cur == L_PO { ret 0u8 }
    if is_prefix(p) && is_alhl(cur) { ret 0u8 }
    if is_alhl(p) && is_prefix(cur) { ret 0u8 }
    // LB25 as the number regex: a prefix before NU, or before OP/HY that a NU follows.
    if is_prefix(p) {
        if cur == L_NU { ret 0u8 }
        if is_op(cur) || cur == L_HY {
            var ahead = i + 1usize
            while ahead < n && is_attachable(lb_resolved(text[ahead])) { ahead += 1usize }
            if ahead < n && lb_resolved(text[ahead]) == L_NU { ret 0u8 }
        }
    }
    if p == L_HY && cur == L_NU { ret 0u8 }
    // ... and NU (SY|IS)* before NU, or NU (SY|IS)* (CL|CP)? before a prefix.
    if cur == L_NU || is_prefix(cur) {
        var back = pj
        var q = p
        if is_prefix(cur) && (q == L_CL || is_cp(q)) {
            if back == 0usize {
                q = NONE
            } else {
                let (closer_base, before_closer) = line_base_before(text, back)
                back = closer_base
                q = before_closer
            }
        }
        while (q == L_SY || q == L_IS) && back > 0usize {
            let (mark_base, before_mark) = line_base_before(text, back)
            back = mark_base
            q = before_mark
        }
        if q == L_NU { ret 0u8 }
    }
    if p == L_JL && (cur == L_JL || cur == L_JV || cur == L_H2 || cur == L_H3) { ret 0u8 }
    if (p == L_JV || p == L_H2) && (cur == L_JV || cur == L_JT) { ret 0u8 }
    if (p == L_JT || p == L_H3) && cur == L_JT { ret 0u8 }
    if is_hangul(p) && cur == L_PO { ret 0u8 }
    if p == L_PR && is_hangul(cur) { ret 0u8 }
    if is_alhl(p) && is_alhl(cur) { ret 0u8 }
    if p == L_IS && is_alhl(cur) { ret 0u8 }
    if (is_alhl(p) || p == L_NU) && cur == L_OP { ret 0u8 }
    if p == L_CP && (is_alhl(cur) || cur == L_NU) { ret 0u8 }
    if p == L_RI && cur == L_RI {
        var count = 0usize
        var at_ri = i
        var more = true
        while more {
            let (j, code) = line_base_before(text, at_ri)
            if code == L_RI {
                count += 1usize
                at_ri = j
                if at_ri == 0usize { more = false }
            } else {
                more = false
            }
        }
        if count % 2usize == 1usize { ret 0u8 }
    }
    if (p == L_EB || p == L_EB_CN) && cur == L_EM { ret 0u8 }
    ret 1u8
}

// The break opportunity after `from`: (position, mandatory); (text.len, true) at the end.
fn next_line_break(text: []const u32, from: usize) -> (usize, bool) {
    var i = from + 1usize
    while i < text.len && line_break_at(text, i) == 0u8 { i += 1usize }
    if i >= text.len { ret (text.len, true) }
    ret (i, line_break_at(text, i) == 2u8)
}

// `opportunities[i]` for every position 0..text.len: 0 no break, 1 allowed, 2 mandatory.
fn line_breaks(text: []const u32, opportunities: []u8) -> err {
    if opportunities.len < text.len + 1usize { ret TooSmall }
    var i = 0usize
    while i <= text.len {
        opportunities[i] = line_break_at(text, i)
        i += 1usize
    }
    ret ok
