// The Encoding Standard's multi-byte decoders (tracker 1.4): gbk and gb18030, Big5, EUC-JP, ISO-2022-JP, Shift_JIS and
// EUC-KR, over the Standard's index tables (`e.text.charset_cjk_table`, generated by `scripts/gen_charset.py`). `decode`
// takes a canonical encoding name (see `e.text.charset.label_to_name`) and also answers for every encoding
// `e.text.charset` decodes, so a browser calls only this one.
//
// A byte sequence that is not valid in the encoding becomes U+FFFD and decoding goes on at the byte after the lead byte, as
// the Standard's decoders prescribe (an ASCII byte that broke a sequence is read again).
//
// Memory: results are allocated in the arena given.

use e.mem
use e.str
use e.text.charset as charset
use e.text.charset_cjk_table as cjk
use e.text.encoding as unicode_encoding

const NONE_CP: u32 = 16777215u32

fn entry(t: str, i: usize) -> u32 {
    let at = i * 3usize
    ret (u32(t[at]) << 16u32) | (u32(t[at + 1usize]) << 8u32) | u32(t[at + 2usize])
}

// A growing UTF-8 output over a fixed allocation.
type Out = struct { data: []u8, len: usize }

fn out_new(a: *mem.Arena, input_len: usize) -> (Out, err) {
    let (d, e) = mem.alloc[u8](a, input_len * 4usize + 8usize)
    if e != ok { ret (zero, e) }
    ret (Out { data: d, len: 0usize }, ok)
}

fn emit(o: *Out, cp: u32) {
    if o.len + 4usize > o.data.len { ret }
    o.len += unicode_encoding.write_utf8(cp, o.data, o.len)
}

fn error_mark(o: *Out) { emit(o, 65533u32) }

fn is_ascii(b: u8) -> bool { ret b < 128u8 }

// --- gbk and gb18030.

fn gb18030_range_cp(pointer: u32) -> u32 {
    if (pointer > 39419u32 && pointer < 189000u32) || pointer > 1237575u32 { ret NONE_CP }
    if pointer == 7457u32 { ret 59335u32 }
    let r = cjk.gb18030_ranges()
    var best = 0usize
    var i = 0usize
    let n = cjk.gb18030_ranges_len()
    while i < n {
        let at = i * 6usize
        let p = (u32(r[at]) << 16u32) | (u32(r[at + 1usize]) << 8u32) | u32(r[at + 2usize])
        if p <= pointer { best = i } else { break }
        i += 1usize
    }
    let at2 = best * 6usize
    let off_p = (u32(r[at2]) << 16u32) | (u32(r[at2 + 1usize]) << 8u32) | u32(r[at2 + 2usize])
    let off_cp = (u32(r[at2 + 3usize]) << 16u32) | (u32(r[at2 + 4usize]) << 8u32) | u32(r[at2 + 5usize])
    ret off_cp + pointer - off_p
}

fn decode_gb18030(a: *mem.Arena, bytes: []const u8) -> (str, err) {
    let (o, oe) = out_new(a, bytes.len)
    if oe != ok { ret ("", oe) }
    var out = o
    let idx = cjk.index_gb18030()
    var i = 0usize
    while i < bytes.len {
        let b = bytes[i]
        i += 1usize
        if b < 128u8 {
            emit(&out, u32(b))
        } else if b == 128u8 {
            emit(&out, 8364u32)
        } else if b == 255u8 {
            error_mark(&out)
        } else {
            // A lead byte 0x81..0xFE.
            if i >= bytes.len {
                error_mark(&out)
                break
            }
            let b2 = bytes[i]
            if b2 >= 48u8 && b2 <= 57u8 {
                // Four-byte form.
                if i + 2usize >= bytes.len {
                    // Not enough bytes: the Standard emits one error for the incomplete form.
                    error_mark(&out)
                    i = bytes.len
                    continue
                }
                let b3 = bytes[i + 1usize]
                let b4 = bytes[i + 2usize]
                if b3 >= 129u8 && b3 <= 254u8 && b4 >= 48u8 && b4 <= 57u8 {
                    let pointer = (u32(b) - 129u32) * 12600u32 + (u32(b2) - 48u32) * 1260u32 + (u32(b3) - 129u32) * 10u32 + (u32(b4) - 48u32)
                    let cp = gb18030_range_cp(pointer)
                    if cp == NONE_CP { error_mark(&out) } else { emit(&out, cp) }
                    i += 3usize
                } else {
                    error_mark(&out)
                    i += 1usize
                }
            } else {
                var cp = NONE_CP
                if (b2 >= 64u8 && b2 <= 126u8) || (b2 >= 128u8 && b2 <= 254u8) {
                    var offset = 65u32
                    if b2 < 127u8 { offset = 64u32 }
                    let pointer = (usize(b) - 129usize) * 190usize + (usize(b2) - usize(offset))
                    if pointer < cjk.index_gb18030_len() { cp = entry(idx, pointer) }
                }
                if cp == NONE_CP {
                    error_mark(&out)
                    if is_ascii(b2) {
                        // The ASCII byte is read again.
                    } else {
                        i += 1usize
                    }
                } else {
                    emit(&out, cp)
                    i += 1usize
                }
            }
        }
    }
    ret (out.data[0usize..out.len], ok)
}

// --- Big5.

fn decode_big5(a: *mem.Arena, bytes: []const u8) -> (str, err) {
    let (o, oe) = out_new(a, bytes.len)
    if oe != ok { ret ("", oe) }
    var out = o
    let idx = cjk.index_big5()
    var i = 0usize
    while i < bytes.len {
        let b = bytes[i]
        i += 1usize
        if b < 128u8 {
            emit(&out, u32(b))
        } else if b >= 129u8 && b <= 254u8 {
            if i >= bytes.len {
                error_mark(&out)
                break
            }
            let b2 = bytes[i]
            var cp = NONE_CP
            var pointer = 0usize
            var has_pointer = false
            if (b2 >= 64u8 && b2 <= 126u8) || (b2 >= 161u8 && b2 <= 254u8) {
                var offset = 98usize
                if b2 < 127u8 { offset = 64usize }
                pointer = (usize(b) - 129usize) * 157usize + (usize(b2) - offset)
                has_pointer = true
            }
            if has_pointer && pointer == 1133usize {
                emit(&out, 202u32)
                emit(&out, 772u32)
                i += 1usize
            } else if has_pointer && pointer == 1135usize {
                emit(&out, 202u32)
                emit(&out, 780u32)
                i += 1usize
            } else if has_pointer && pointer == 1164usize {
                emit(&out, 234u32)
                emit(&out, 772u32)
                i += 1usize
            } else if has_pointer && pointer == 1166usize {
                emit(&out, 234u32)
                emit(&out, 780u32)
                i += 1usize
            } else {
                if has_pointer && pointer < cjk.index_big5_len() { cp = entry(idx, pointer) }
                if cp == NONE_CP {
                    error_mark(&out)
                    if !is_ascii(b2) { i += 1usize }
                } else {
                    emit(&out, cp)
                    i += 1usize
                }
            }
        } else {
            error_mark(&out)
        }
    }
    ret (out.data[0usize..out.len], ok)
}

// --- EUC-KR.

fn decode_euc_kr(a: *mem.Arena, bytes: []const u8) -> (str, err) {
    let (o, oe) = out_new(a, bytes.len)
    if oe != ok { ret ("", oe) }
    var out = o
    let idx = cjk.index_euc_kr()
    var i = 0usize
    while i < bytes.len {
        let b = bytes[i]
        i += 1usize
        if b < 128u8 {
            emit(&out, u32(b))
        } else if b >= 129u8 && b <= 254u8 {
            if i >= bytes.len {
                error_mark(&out)
                break
            }
            let b2 = bytes[i]
            var cp = NONE_CP
            if b2 >= 65u8 && b2 <= 254u8 {
                let pointer = (usize(b) - 129usize) * 190usize + (usize(b2) - 65usize)
                if pointer < cjk.index_euc_kr_len() { cp = entry(idx, pointer) }
            }
            if cp == NONE_CP {
                error_mark(&out)
                if !is_ascii(b2) { i += 1usize }
            } else {
                emit(&out, cp)
                i += 1usize
            }
        } else {
            error_mark(&out)
        }
    }
    ret (out.data[0usize..out.len], ok)
}

// --- EUC-JP.

fn decode_euc_jp(a: *mem.Arena, bytes: []const u8) -> (str, err) {
    let (o, oe) = out_new(a, bytes.len)
    if oe != ok { ret ("", oe) }
    var out = o
    let j0208 = cjk.index_jis0208()
    let j0212 = cjk.index_jis0212()
    var i = 0usize
    while i < bytes.len {
        let b = bytes[i]
        i += 1usize
        if b < 128u8 {
            emit(&out, u32(b))
        } else if b == 142u8 || b == 143u8 || (b >= 161u8 && b <= 254u8) {
            if i >= bytes.len {
                error_mark(&out)
                break
            }
            let b2 = bytes[i]
            if b == 142u8 {
                if b2 >= 161u8 && b2 <= 223u8 {
                    emit(&out, 65377u32 - 161u32 + u32(b2))
                    i += 1usize
                } else {
                    error_mark(&out)
                    if !is_ascii(b2) { i += 1usize }
                }
            } else if b == 143u8 {
                // JIS X 0212: a third byte follows.
                if b2 >= 161u8 && b2 <= 254u8 && i + 1usize < bytes.len {
                    let b3 = bytes[i + 1usize]
                    var cp = NONE_CP
                    if b3 >= 161u8 && b3 <= 254u8 {
                        let pointer = (usize(b2) - 161usize) * 94usize + (usize(b3) - 161usize)
                        if pointer < cjk.index_jis0212_len() { cp = entry(j0212, pointer) }
                    }
                    if cp == NONE_CP {
                        error_mark(&out)
                        if !is_ascii(b3) { i += 2usize } else { i += 1usize }
                    } else {
                        emit(&out, cp)
                        i += 2usize
                    }
                } else {
                    error_mark(&out)
                    if i < bytes.len && !is_ascii(b2) { i += 1usize }
                }
            } else {
                var cp2 = NONE_CP
                if b2 >= 161u8 && b2 <= 254u8 {
                    let pointer2 = (usize(b) - 161usize) * 94usize + (usize(b2) - 161usize)
                    if pointer2 < cjk.index_jis0208_len() { cp2 = entry(j0208, pointer2) }
                }
                if cp2 == NONE_CP {
                    error_mark(&out)
                    if !is_ascii(b2) { i += 1usize }
                } else {
                    emit(&out, cp2)
                    i += 1usize
                }
            }
        } else {
            error_mark(&out)
        }
    }
    ret (out.data[0usize..out.len], ok)
}

// --- Shift_JIS.

fn decode_shift_jis(a: *mem.Arena, bytes: []const u8) -> (str, err) {
    let (o, oe) = out_new(a, bytes.len)
    if oe != ok { ret ("", oe) }
    var out = o
    let j0208 = cjk.index_jis0208()
    var i = 0usize
    while i < bytes.len {
        let b = bytes[i]
        i += 1usize
        if b < 129u8 {
            emit(&out, u32(b))
        } else if b >= 161u8 && b <= 223u8 {
            emit(&out, 65377u32 - 161u32 + u32(b))
        } else if (b >= 129u8 && b <= 159u8) || (b >= 224u8 && b <= 252u8) {
            if i >= bytes.len {
                error_mark(&out)
                break
            }
            let b2 = bytes[i]
            var offset = 65usize
            if b2 < 127u8 { offset = 64usize }
            var lead_offset = 193usize
            if b < 160u8 { lead_offset = 129usize }
            var cp = NONE_CP
            if (b2 >= 64u8 && b2 <= 126u8) || (b2 >= 128u8 && b2 <= 252u8) {
                let pointer = (usize(b) - lead_offset) * 188usize + usize(b2) - offset
                if pointer >= 8836usize && pointer <= 10715usize {
                    cp = 57344u32 - 8836u32 + u32(pointer)
                } else if pointer < cjk.index_jis0208_len() {
                    cp = entry(j0208, pointer)
                }
            }
            if cp == NONE_CP {
                error_mark(&out)
                if !is_ascii(b2) { i += 1usize }
            } else {
                emit(&out, cp)
                i += 1usize
            }
        } else {
            error_mark(&out)
        }
    }
    ret (out.data[0usize..out.len], ok)
}

// --- ISO-2022-JP (stateful: ASCII, Roman, katakana, two-byte JIS X 0208).

fn decode_iso_2022_jp(a: *mem.Arena, bytes: []const u8) -> (str, err) {
    let (o, oe) = out_new(a, bytes.len)
    if oe != ok { ret ("", oe) }
    var out = o
    let j0208 = cjk.index_jis0208()
    // Modes: 0 ASCII, 1 Roman, 2 Katakana, 3 lead byte, 4 trail byte.
    var mode = 0usize
    var out_mode = 0usize
    var lead = 0u8
    var out_flag = false
    var i = 0usize
    while i < bytes.len {
        let b = bytes[i]
        i += 1usize
        if b == 27u8 && (mode != 5usize) {
            // Escape: ESC ( B, ESC ( J, ESC $ @, ESC $ B (and ESC ( I for katakana).
            if i + 1usize < bytes.len {
                let c1 = bytes[i]
                let c2 = bytes[i + 1usize]
                var newmode = 99usize
                if c1 == 40u8 && c2 == 66u8 { newmode = 0usize }
                if c1 == 40u8 && c2 == 74u8 { newmode = 1usize }
                if c1 == 40u8 && c2 == 73u8 { newmode = 2usize }
                if c1 == 36u8 && (c2 == 64u8 || c2 == 66u8) { newmode = 3usize }
                if newmode != 99usize {
                    i += 2usize
                    if out_flag { error_mark(&out) }
                    out_mode = newmode
                    mode = newmode
                    out_flag = true
                    continue
                }
            }
            error_mark(&out)
            continue
        }
        if mode == 0usize || mode == 1usize {
            if b == 14u8 || b == 15u8 {
                error_mark(&out)
            } else if b <= 127u8 && b != 14u8 && b != 15u8 {
                if mode == 1usize && b == 92u8 {
                    emit(&out, 165u32)
                } else if mode == 1usize && b == 126u8 {
                    emit(&out, 8254u32)
                } else {
                    emit(&out, u32(b))
                }
                out_flag = false
            } else {
                error_mark(&out)
            }
        } else if mode == 2usize {
            if b >= 33u8 && b <= 95u8 {
                emit(&out, 65377u32 - 33u32 + u32(b))
                out_flag = false
            } else if b == 14u8 || b == 15u8 {
                error_mark(&out)
            } else if b <= 127u8 {
                emit(&out, u32(b))
                out_flag = false
            } else {
                error_mark(&out)
            }
        } else if mode == 3usize {
            if b >= 33u8 && b <= 126u8 {
                lead = b
                mode = 4usize
                out_flag = false
            } else if b == 14u8 || b == 15u8 {
                error_mark(&out)
            } else if b <= 127u8 {
                emit(&out, u32(b))
            } else {
                error_mark(&out)
            }
        } else {
            // Trail byte of a JIS X 0208 pair.
            mode = 3usize
            if b >= 33u8 && b <= 126u8 {
                let pointer = (usize(lead) - 33usize) * 94usize + usize(b) - 33usize
                var cp = NONE_CP
                if pointer < cjk.index_jis0208_len() { cp = entry(j0208, pointer) }
                if cp == NONE_CP { error_mark(&out) } else { emit(&out, cp) }
            } else {
                error_mark(&out)
            }
        }
    }
    if mode == 4usize { error_mark(&out) }
    ret (out.data[0usize..out.len], ok)
}

// Decodes `bytes` as the encoding `name` into UTF-8 (every encoding of the Standard).
fn decode(a: *mem.Arena, name: str, bytes: []const u8) -> (str, err) {
    if charset.eq_fold(name, "gbk") || charset.eq_fold(name, "gb18030") {
        let (t, e) = decode_gb18030(a, bytes)
        ret (t, e)
    }
    if charset.eq_fold(name, "Big5") {
        let (t, e) = decode_big5(a, bytes)
        ret (t, e)
    }
    if charset.eq_fold(name, "EUC-KR") {
        let (t, e) = decode_euc_kr(a, bytes)
        ret (t, e)
    }
    if charset.eq_fold(name, "EUC-JP") {
        let (t, e) = decode_euc_jp(a, bytes)
        ret (t, e)
    }
    if charset.eq_fold(name, "Shift_JIS") {
        let (t, e) = decode_shift_jis(a, bytes)
        ret (t, e)
    }
    if charset.eq_fold(name, "ISO-2022-JP") {
        let (t, e) = decode_iso_2022_jp(a, bytes)
        ret (t, e)
    }
    let (t2, e2) = charset.decode(a, name, bytes)
    ret (t2, e2)
}

// The Standard's "decode": a BOM overrides `name`.
fn decode_sniffing_bom(a: *mem.Arena, name: str, bytes: []const u8) -> (str, err) {
    if bytes.len >= 3usize && bytes[0usize] == 239u8 && bytes[1usize] == 187u8 && bytes[2usize] == 191u8 {
        let (t, e) = charset.decode(a, "UTF-8", bytes[3usize..])
        ret (t, e)
    }
    if bytes.len >= 2usize && bytes[0usize] == 254u8 && bytes[1usize] == 255u8 {
        let (t, e) = charset.decode(a, "UTF-16BE", bytes[2usize..])
        ret (t, e)
    }
    if bytes.len >= 2usize && bytes[0usize] == 255u8 && bytes[1usize] == 254u8 {
        let (t, e) = charset.decode(a, "UTF-16LE", bytes[2usize..])
        ret (t, e)
    }
    let (t2, e2) = decode(a, name, bytes)
    ret (t2, e2)
}
