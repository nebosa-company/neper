// The Unicode Bidirectional Algorithm (UAX #9, Unicode 15.0) over code points:
// `class_of` is the Bidi_Class from a run table generated out of
// DerivedBidiClass.txt (so unassigned code points carry the R/AL/ET/BN block
// defaults), `paragraph_level` is P2/P3, `resolve_levels` runs X1-X10 (the
// directional status stack to depth 125 with the overflow counters, X9 removal,
// BD13 isolating run sequences), W1-W7, N0 bracket pairs (BD16 with the
// BidiBrackets pairs and the U+2329/232A canonical equivalents), N1-N2 and I1-I2
// into caller levels; `reorder_line` is L1 (trailing whitespace back to the
// paragraph level) plus L2 (`reorder`: reverse from the highest level down to the
// lowest odd one) giving the visual-to-logical order of a line; `mirror` and
// `is_mirrored` are the BidiMirroring pairs for L4. Characters X9 removes (BN and
// the explicit embedding controls) take the level of the character before them
// (the paragraph level at the front) and count as whitespace in L1, so a line
// that keeps them reorders the same as one that drops them.
//
// `resolve_levels` needs `scratch.len >= 6 * text.len` (six u32 per code point:
// working classes, original classes, isolate matches, one run sequence, explicit
// levels, bracket pairs) and `levels.len >= text.len`. Tables are byte strings
// read little-endian as in `e.text.unicode`: the class table is 4-byte runs
// (3-byte start, 1-byte class), the bracket and mirror tables 8-byte sorted pairs.

type Class = enum u8 { L, R, AL, EN, ES, ET, AN, CS, NSM, BN, B, S, WS, ON, LRE, LRO, RLE, RLO, PDF, LRI, RLI, FSI, PDI }
error TooSmall
error Invalid

const K_L: u32 = 0u32
const K_R: u32 = 1u32
const K_AL: u32 = 2u32
const K_EN: u32 = 3u32
const K_ES: u32 = 4u32
const K_ET: u32 = 5u32
const K_AN: u32 = 6u32
const K_CS: u32 = 7u32
const K_NSM: u32 = 8u32
const K_BN: u32 = 9u32
const K_B: u32 = 10u32
const K_S: u32 = 11u32
const K_WS: u32 = 12u32
const K_ON: u32 = 13u32
const K_LRE: u32 = 14u32
const K_LRO: u32 = 15u32
const K_RLE: u32 = 16u32
const K_RLO: u32 = 17u32
const K_PDF: u32 = 18u32
const K_LRI: u32 = 19u32
const K_RLI: u32 = 20u32
const K_FSI: u32 = 21u32
const K_PDI: u32 = 22u32
const NEUTRAL: u32 = 255u32
const NONE: u32 = 4294967295u32
const MAX_DEPTH: u32 = 125u32
const MAX_OPENERS: usize = 63usize

fn version() -> str { ret "15.0.0" }

fn scalar_at(table: str, pos: usize) -> u32 {
    ret u32(table[pos]) | (u32(table[pos + 1usize]) << 8u32) | (u32(table[pos + 2usize]) << 16u32)
}

fn read_u32(table: str, pos: usize) -> u32 {
    ret scalar_at(table, pos) | (u32(table[pos + 3usize]) << 24u32)
}

// The last run whose start is at or before `scalar` (3-byte start, 1-byte value).
fn run_value(table: str, scalar: u32) -> u8 {
    var low = 0usize
    var high = table.len / 4usize
    while high - low > 1usize {
        let mid = (low + high) / 2usize
        if scalar_at(table, mid * 4usize) <= scalar { low = mid } else { high = mid }
    }
    ret table[low * 4usize + 3usize]
}

// A sorted table of 8-byte (scalar, value) pairs.
fn pair_lookup(table: str, scalar: u32) -> (u32, bool) {
    var low = 0usize
    var high = table.len / 8usize
    while low < high {
        let mid = (low + high) / 2usize
        let key = read_u32(table, mid * 8usize)
        if key == scalar { ret (read_u32(table, mid * 8usize + 4usize), true) }
        if key < scalar { low = mid + 1usize } else { high = mid }
    }
    ret (0u32, false)
}

// The class as its table code (the `Class` declaration order).
fn class_code(cp: u32) -> u32 {
    if cp > 1114111u32 { ret K_L }
    ret u32(run_value(bidi_table(), cp))
}

fn class_of(cp: u32) -> Class {
    let code = class_code(cp)
    if code == K_L { ret .L }
    if code == K_R { ret .R }
    if code == K_AL { ret .AL }
    if code == K_EN { ret .EN }
    if code == K_ES { ret .ES }
    if code == K_ET { ret .ET }
    if code == K_AN { ret .AN }
    if code == K_CS { ret .CS }
    if code == K_NSM { ret .NSM }
    if code == K_BN { ret .BN }
    if code == K_B { ret .B }
    if code == K_S { ret .S }
    if code == K_WS { ret .WS }
    if code == K_ON { ret .ON }
    if code == K_LRE { ret .LRE }
    if code == K_LRO { ret .LRO }
    if code == K_RLE { ret .RLE }
    if code == K_RLO { ret .RLO }
    if code == K_PDF { ret .PDF }
    if code == K_LRI { ret .LRI }
    if code == K_RLI { ret .RLI }
    if code == K_FSI { ret .FSI }
    ret .PDI
}

// X9 removes BN and the explicit embedding controls.
fn is_removed(code: u32) -> bool {
    ret code == K_BN || code == K_LRE || code == K_LRO || code == K_RLE || code == K_RLO || code == K_PDF
}

fn is_isolate_initiator(code: u32) -> bool { ret code == K_LRI || code == K_RLI || code == K_FSI }

// NI for N1/N2: neutrals and isolate formatting characters.
fn is_neutral(code: u32) -> bool {
    ret code == K_B || code == K_S || code == K_WS || code == K_ON || code == K_PDI || is_isolate_initiator(code)
}

// The strong direction a class counts as in N0-N2 (EN and AN count as R), else NEUTRAL.
fn strong_direction(code: u32) -> u32 {
    if code == K_L { ret K_L }
    if code == K_R || code == K_AL || code == K_EN || code == K_AN { ret K_R }
    ret NEUTRAL
}

// P2/P3 over text[start..end): the level of the first strong class outside any
// isolate (0 for L, 1 for R or AL, 0 when none). A PDI at depth zero ends the
// search when `stop_at_pdi` (the FSI case: the text between it and its match).
fn first_strong(text: []const u32, start: usize, end: usize, stop_at_pdi: bool) -> u8 {
    var depth = 0usize
    var i = start
    while i < end {
        let code = class_code(text[i])
        if code == K_B { ret 0u8 }
        if depth == 0usize {
            if code == K_L { ret 0u8 }
            if code == K_R || code == K_AL { ret 1u8 }
            if code == K_PDI && stop_at_pdi { ret 0u8 }
        }
        if is_isolate_initiator(code) {
            depth += 1usize
        } else if code == K_PDI && depth > 0usize {
            depth -= 1usize
        }
        i += 1usize
    }
    ret 0u8
}

// The paragraph embedding level of `text` by P2/P3.
fn paragraph_level(text: []const u32) -> u8 { ret first_strong(text, 0usize, text.len, false) }

fn next_odd(level: u32) -> u32 {
    if level % 2u32 == 0u32 { ret level + 1u32 }
    ret level + 2u32
}

fn next_even(level: u32) -> u32 {
    if level % 2u32 == 0u32 { ret level + 2u32 }
    ret level + 1u32
}

// BD9: `matches[i]` is the matching PDI of an isolate initiator, the initiator of
// a matched PDI, else NONE. `stack` is scratch of `orig.len`.
fn match_isolates(orig: []const u32, matches: []u32, stack: []u32) {
    var depth = 0usize
    var i = 0usize
    while i < orig.len {
        matches[i] = NONE
        let code = orig[i]
        if is_isolate_initiator(code) {
            stack[depth] = u32(i)
            depth += 1usize
        } else if code == K_PDI && depth > 0usize {
            depth -= 1usize
            matches[usize(stack[depth])] = u32(i)
            matches[i] = stack[depth]
        } else if code == K_B {
            depth = 0usize
        }
        i += 1usize
    }
}

// X1-X8: explicit embedding levels into `explicit`, overrides applied to `types`.
fn explicit_levels(text: []const u32, types: []u32, explicit: []u32, para: u32) {
    let n = text.len
    var stack_level: [128]u32 = zero
    var stack_override: [128]u32 = zero
    var stack_isolate: [128]u32 = zero
    stack_level[0usize] = para
    stack_override[0usize] = NEUTRAL
    var depth = 1usize
    var overflow_isolate = 0usize
    var overflow_embedding = 0usize
    var valid_isolate = 0usize
    var i = 0usize
    while i < n {
        let code = types[i]
        let cur = stack_level[depth - 1usize]
        explicit[i] = cur
        if code == K_RLE || code == K_LRE || code == K_RLO || code == K_LRO {
            var new_level = next_even(cur)
            if code == K_RLE || code == K_RLO { new_level = next_odd(cur) }
            if new_level <= MAX_DEPTH && overflow_isolate == 0usize && overflow_embedding == 0usize {
                stack_level[depth] = new_level
                stack_override[depth] = NEUTRAL
                if code == K_LRO { stack_override[depth] = K_L }
                if code == K_RLO { stack_override[depth] = K_R }
                stack_isolate[depth] = 0u32
                depth += 1usize
            } else if overflow_isolate == 0usize {
                overflow_embedding += 1usize
            }
        } else if is_isolate_initiator(code) {
            if stack_override[depth - 1usize] != NEUTRAL { types[i] = stack_override[depth - 1usize] }
            var rtl = code == K_RLI
            if code == K_FSI { rtl = first_strong(text, i + 1usize, n, true) == 1u8 }
            var new_level = next_even(cur)
            if rtl { new_level = next_odd(cur) }
            if new_level <= MAX_DEPTH && overflow_isolate == 0usize && overflow_embedding == 0usize {
                valid_isolate += 1usize
                stack_level[depth] = new_level
                stack_override[depth] = NEUTRAL
                stack_isolate[depth] = 1u32
                depth += 1usize
            } else {
                overflow_isolate += 1usize
            }
        } else if code == K_PDI {
            if overflow_isolate > 0usize {
                overflow_isolate -= 1usize
            } else if valid_isolate > 0usize {
                overflow_embedding = 0usize
                while stack_isolate[depth - 1usize] == 0u32 { depth -= 1usize }
                depth -= 1usize
                valid_isolate -= 1usize
            }
            explicit[i] = stack_level[depth - 1usize]
            if stack_override[depth - 1usize] != NEUTRAL { types[i] = stack_override[depth - 1usize] }
        } else if code == K_PDF {
            if overflow_isolate == 0usize {
                if overflow_embedding > 0usize {
                    overflow_embedding -= 1usize
                } else if stack_isolate[depth - 1usize] == 0u32 && depth >= 2usize {
                    depth -= 1usize
                }
            }
        } else if code == K_B {
            explicit[i] = para
        } else if code != K_BN {
            if stack_override[depth - 1usize] != NEUTRAL { types[i] = stack_override[depth - 1usize] }
        }
        i += 1usize
    }
}

// Whether position `i` (not removed) begins a level run: no non-removed
// character before it, or one at another explicit level.
fn starts_run(orig: []const u32, explicit: []const u32, i: usize) -> bool {
    var p = i
    while p > 0usize {
        p -= 1usize
        if !is_removed(orig[p]) { ret explicit[p] != explicit[i] }
    }
    ret true
}

// Bracket lookup: (paired bracket, 1 opening / 2 closing / 0 not a bracket).
fn bracket_lookup(cp: u32) -> (u32, u32) {
    let (value, found) = pair_lookup(bracket_table(), cp)
    if !found { ret (0u32, 0u32) }
    if (value & 2147483648u32) != 0u32 { ret (value & 2147483647u32, 1u32) }
    ret (value, 2u32)
}

// U+2329/U+232A are canonically equivalent to U+3008/U+3009 for pairing.
fn canonical_bracket(cp: u32) -> u32 {
    if cp == 9001u32 { ret 12296u32 }
    if cp == 9002u32 { ret 12297u32 }
    ret cp
}

// N0 over one isolating run sequence `seq` (positions into `types`).
fn resolve_brackets(text: []const u32, types: []u32, orig: []const u32, seq: []const u32, pairs: []u32, sos: u32, embed: u32) {
    let m = seq.len
    var open_paired: [63]u32 = zero
    var open_pos: [63]u32 = zero
    var depth = 0usize
    var count = 0usize
    var k = 0usize
    var searching = true
    while k < m && searching {
        let i = usize(seq[k])
        if types[i] == K_ON {
            let (paired, kind) = bracket_lookup(text[i])
            if kind == 1u32 {
                if depth == MAX_OPENERS {
                    searching = false
                } else {
                    open_paired[depth] = canonical_bracket(paired)
                    open_pos[depth] = u32(k)
                    depth += 1usize
                }
            } else if kind == 2u32 {
                let closer = canonical_bracket(text[i])
                var d = depth
                var matched = false
                while d > 0usize && !matched {
                    d -= 1usize
                    if open_paired[d] == closer {
                        matched = true
                        pairs[2usize * count] = open_pos[d]
                        pairs[2usize * count + 1usize] = u32(k)
                        count += 1usize
                        depth = d
                    }
                }
            }
        }
        k += 1usize
    }
    // Sort pairs by opener (ponytail: insertion sort; a sequence rarely holds many pairs).
    var s = 1usize
    while s < count {
        let o = pairs[2usize * s]
        let c = pairs[2usize * s + 1usize]
        var t = s
        while t > 0usize && pairs[2usize * (t - 1usize)] > o {
            pairs[2usize * t] = pairs[2usize * (t - 1usize)]
            pairs[2usize * t + 1usize] = pairs[2usize * (t - 1usize) + 1usize]
            t -= 1usize
        }
        pairs[2usize * t] = o
        pairs[2usize * t + 1usize] = c
        s += 1usize
    }
    var p = 0usize
    while p < count {
        let o = usize(pairs[2usize * p])
        let c = usize(pairs[2usize * p + 1usize])
        var found_embed = false
        var found_opposite = false
        var x = o + 1usize
        while x < c && !found_embed {
            let d = strong_direction(types[usize(seq[x])])
            if d == embed { found_embed = true } else if d != NEUTRAL { found_opposite = true }
            x += 1usize
        }
        var new_type = NEUTRAL
        if found_embed {
            new_type = embed
        } else if found_opposite {
            var before = sos
            var y = o
            var settled = false
            while y > 0usize && !settled {
                y -= 1usize
                let d = strong_direction(types[usize(seq[y])])
                if d != NEUTRAL {
                    before = d
                    settled = true
                }
            }
            new_type = embed
            if before != embed { new_type = before }
        }
        if new_type != NEUTRAL {
            var side = 0usize
            while side < 2usize {
                var pos = o
                if side == 1usize { pos = c }
                types[usize(seq[pos])] = new_type
                var z = pos + 1usize
                while z < m && orig[usize(seq[z])] == K_NSM {
                    types[usize(seq[z])] = new_type
                    z += 1usize
                }
                side += 1usize
            }
        }
        p += 1usize
    }
}

// W1-W7, N0-N2 and I1-I2 over one isolating run sequence.
fn resolve_sequence(text: []const u32, types: []u32, orig: []const u32, levels: []u8, explicit: []const u32, seq: []const u32, pairs: []u32, para: u32) {
    let n = orig.len
    let m = seq.len
    let first = usize(seq[0usize])
    let level = explicit[first]
    var prev_level = para
    var p = first
    var found = false
    while p > 0usize && !found {
        p -= 1usize
        if !is_removed(orig[p]) {
            found = true
            prev_level = explicit[p]
        }
    }
    var sos_level = level
    if prev_level > level { sos_level = prev_level }
    var sos = K_L
    if sos_level % 2u32 == 1u32 { sos = K_R }
    let last = usize(seq[m - 1usize])
    var next_level = para
    if !is_isolate_initiator(orig[last]) {
        var q = last + 1usize
        while q < n && is_removed(orig[q]) { q += 1usize }
        if q < n { next_level = explicit[q] }
    }
    var eos_level = level
    if next_level > level { eos_level = next_level }
    var eos = K_L
    if eos_level % 2u32 == 1u32 { eos = K_R }
    var embed = K_L
    if level % 2u32 == 1u32 { embed = K_R }
    // W1: NSM takes the previous type (ON after an isolate control).
    var prev = sos
    var k = 0usize
    while k < m {
        let i = usize(seq[k])
        if types[i] == K_NSM {
            types[i] = prev
            if is_isolate_initiator(prev) || prev == K_PDI { types[i] = K_ON }
        }
        prev = types[i]
        k += 1usize
    }
    // W2: EN after AL becomes AN; W3: AL becomes R.
    var strong = sos
    k = 0usize
    while k < m {
        let i = usize(seq[k])
        let t = types[i]
        if t == K_L || t == K_R || t == K_AL {
            strong = t
        } else if t == K_EN && strong == K_AL {
            types[i] = K_AN
        }
        k += 1usize
    }
    k = 0usize
    while k < m {
        if types[usize(seq[k])] == K_AL { types[usize(seq[k])] = K_R }
        k += 1usize
    }
    // W4: a single separator between two numbers of one kind.
    k = 1usize
    while k + 1usize < m {
        let i = usize(seq[k])
        let t = types[i]
        let before = types[usize(seq[k - 1usize])]
        let after = types[usize(seq[k + 1usize])]
        if (t == K_ES || t == K_CS) && before == K_EN && after == K_EN {
            types[i] = K_EN
        } else if t == K_CS && before == K_AN && after == K_AN {
            types[i] = K_AN
        }
        k += 1usize
    }
    // W5: ET runs adjacent to EN become EN.
    k = 0usize
    while k < m {
        if types[usize(seq[k])] == K_ET {
            var e = k
            while e < m && types[usize(seq[e])] == K_ET { e += 1usize }
            var adjacent = false
            if k > 0usize && types[usize(seq[k - 1usize])] == K_EN { adjacent = true }
            if e < m && types[usize(seq[e])] == K_EN { adjacent = true }
            if adjacent {
                var x = k
                while x < e {
                    types[usize(seq[x])] = K_EN
                    x += 1usize
                }
            }
            k = e
        } else {
            k += 1usize
        }
    }
    // W6: leftover separators and terminators are ON; W7: EN after L is L.
    strong = sos
    k = 0usize
    while k < m {
        let i = usize(seq[k])
        let t = types[i]
        if t == K_ES || t == K_ET || t == K_CS { types[i] = K_ON }
        if t == K_L || t == K_R {
            strong = t
        } else if t == K_EN && strong == K_L {
            types[i] = K_L
        }
        k += 1usize
    }
    resolve_brackets(text, types, orig, seq, pairs, sos, embed)
    // N1/N2: a neutral run takes the shared direction of its neighbours, else the embedding's.
    k = 0usize
    while k < m {
        if is_neutral(types[usize(seq[k])]) {
            var e = k
            while e < m && is_neutral(types[usize(seq[e])]) { e += 1usize }
            var before = sos
            if k > 0usize { before = strong_direction(types[usize(seq[k - 1usize])]) }
            var after = eos
            if e < m { after = strong_direction(types[usize(seq[e])]) }
            var fill = embed
            if before == after { fill = before }
            var x = k
            while x < e {
                types[usize(seq[x])] = fill
                x += 1usize
            }
            k = e
        } else {
            k += 1usize
        }
    }
    // I1/I2.
    k = 0usize
    while k < m {
        let i = usize(seq[k])
        let t = types[i]
        var resolved = explicit[i]
        if resolved % 2u32 == 0u32 {
            if t == K_R { resolved += 1u32 }
            if t == K_AN || t == K_EN { resolved += 2u32 }
        } else if t == K_L || t == K_EN || t == K_AN {
            resolved += 1u32
        }
        levels[i] = u8(resolved & 255u32)
        k += 1usize
    }
}

// Resolved embedding levels of one paragraph: `base_level` -1 applies P2/P3, 0 or 1
// forces the paragraph level. Answers the paragraph level; `levels.len >= text.len`
// and `scratch.len >= 6 * text.len` or TooSmall.
fn resolve_levels(text: []const u32, base_level: i8, levels: []u8, scratch: []u32) -> (u8, err) {
    let n = text.len
    if base_level < -1i8 || base_level > 1i8 { ret (0u8, Invalid) }
    if levels.len < n || scratch.len < 6usize * n { ret (0u8, TooSmall) }
    var para = 0u32
    if base_level == 1i8 { para = 1u32 }
    if base_level < 0i8 { para = u32(first_strong(text, 0usize, n, false)) }
    if n == 0usize { ret (u8(para), ok) }
    let types = scratch[..n]
    let orig = scratch[n..2usize * n]
    let matches = scratch[2usize * n..3usize * n]
    let seq = scratch[3usize * n..4usize * n]
    let explicit = scratch[4usize * n..5usize * n]
    let pairs = scratch[5usize * n..6usize * n]
    var i = 0usize
    while i < n {
        let code = class_code(text[i])
        types[i] = code
        orig[i] = code
        i += 1usize
    }
    match_isolates(orig, matches, seq)
    explicit_levels(text, types, explicit, para)
    i = 0usize
    while i < n {
        levels[i] = u8(explicit[i] & 255u32)
        i += 1usize
    }
    // X10: each isolating run sequence starts at a level run that is not a matched PDI's.
    i = 0usize
    while i < n {
        if !is_removed(orig[i]) && !(orig[i] == K_PDI && matches[i] != NONE) && starts_run(orig, explicit, i) {
            var m = 0usize
            var j = i
            let level = explicit[i]
            var more = true
            while more {
                while j < n && (is_removed(orig[j]) || explicit[j] == level) {
                    if !is_removed(orig[j]) {
                        seq[m] = u32(j)
                        m += 1usize
                    }
                    j += 1usize
                }
                let last = usize(seq[m - 1usize])
                more = false
                if is_isolate_initiator(orig[last]) && matches[last] != NONE {
                    j = usize(matches[last])
                    more = true
                }
            }
            resolve_sequence(text, types, orig, levels, explicit, seq[..m], pairs, para)
        }
        i += 1usize
    }
    i = 0usize
    while i < n {
        if is_removed(orig[i]) {
            levels[i] = u8(para)
            if i > 0usize { levels[i] = levels[i - 1usize] }
        }
        i += 1usize
    }
    ret (u8(para), ok)
}

// L2 over levels[line_start..line_end): `out_order[visual] = logical index`,
// reversing every run at or above each level from the highest down to the lowest odd.
fn reorder(levels: []const u8, line_start: usize, line_end: usize, out_order: []usize) -> err {
    if line_start > line_end || line_end > levels.len { ret Invalid }
    let count = line_end - line_start
    if out_order.len < count { ret TooSmall }
    var k = 0usize
    var highest = 0u32
    var lowest = 255u32
    while k < count {
        out_order[k] = line_start + k
        let level = u32(levels[line_start + k])
        if level > highest { highest = level }
        if level < lowest { lowest = level }
        k += 1usize
    }
    if count == 0usize { ret ok }
    if lowest % 2u32 == 0u32 { lowest += 1u32 }
    var level = highest
    while level >= lowest {
        var i = 0usize
        while i < count {
            if u32(levels[out_order[i]]) >= level {
                var j = i
                while j < count && u32(levels[out_order[j]]) >= level { j += 1usize }
                var lo = i
                var hi = j
                while hi - lo > 1usize {
                    hi -= 1usize
                    let swap = out_order[lo]
                    out_order[lo] = out_order[hi]
                    out_order[hi] = swap
                    lo += 1usize
                }
                i = j
            } else {
                i += 1usize
            }
        }
        level -= 1u32
    }
    ret ok
}

// L1 then L2 for the line text[line_start..line_end): segment and paragraph
// separators, and whitespace or isolate controls (and removed characters) running
// up to one or to the line end, go back to `para` in `levels` in place; then `reorder`.
fn reorder_line(text: []const u32, levels: []u8, para: u8, line_start: usize, line_end: usize, out_order: []usize) -> err {
    if line_start > line_end || line_end > levels.len || line_end > text.len { ret Invalid }
    var reset = true
    var i = line_end
    while i > line_start {
        i -= 1usize
        let code = class_code(text[i])
        if code == K_S || code == K_B {
            levels[i] = para
            reset = true
        } else if code == K_WS || code == K_PDI || is_isolate_initiator(code) || is_removed(code) {
            if reset { levels[i] = para }
        } else {
            reset = false
        }
    }
    ret reorder(levels, line_start, line_end, out_order)
}

// L4: the mirrored glyph's code point (BidiMirroring), or `cp` itself.
fn mirror(cp: u32) -> u32 {
    let (mirrored, found) = pair_lookup(mirror_table(), cp)
    if found { ret mirrored }
    ret cp
}

fn is_mirrored(cp: u32) -> bool {
    let (_, found) = pair_lookup(mirror_table(), cp)
    ret found
}

