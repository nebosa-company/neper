// Unicode normalization: the four forms of UAX #15 over the decomposition and
// composition data of the same Unicode version `e.text.unicode` reports.
//
// Two strings that look the same can differ in bytes -- `é` is one scalar or two -- and a
// comparison, a hash or a sort that does not normalize first answers by accident.
// Decomposition here is single-level as UnicodeData carries it and recursed at run time;
// composition is the standard algorithm with the exclusions already folded into the
// table (a pair is listed only if NFC actually recomposes it). Hangul is algorithmic in
// both directions and never touches a table.
//
// `is_normalized` has no arena, so it works segment by segment in a stack window. A
// segment is cut before a starter that neither decomposes nor can be the second of a
// composition -- ASCII, most letters -- because nothing normalization does can cross such
// a scalar. Most segments are one scalar and a few marks.

use e.mem
use e.text.utf8
use e.text.unicode

type Form = enum u8 { Nfc, Nfd, Nfkc, Nfkd }

error Invalid

const S_BASE: u32 = 44032u32
const L_BASE: u32 = 4352u32
const V_BASE: u32 = 4449u32
const T_BASE: u32 = 4519u32
const L_COUNT: u32 = 19u32
const V_COUNT: u32 = 21u32
const T_COUNT: u32 = 28u32
const N_COUNT: u32 = 588u32
const S_COUNT: u32 = 11172u32

fn wants_compat(form: Form) -> bool {
    ret form == .Nfkc || form == .Nfkd
}

fn composes(form: Form) -> bool {
    ret form == .Nfc || form == .Nfkc
}

// The decomposition entry for `scalar`: pool offset, count, found. Index entries are
// scalar(3) kind(1) offset(3) count(1), sorted by scalar; kind 1 is a compatibility
// mapping and is invisible to the canonical forms.
fn lookup(scalar: u32, compat: bool) -> (usize, usize, bool) {
    let table = decomposition_table()
    var low = 0usize
    var high = table.len / 8usize
    while low < high {
        let mid = (low + high) / 2usize
        let at = mid * 8usize
        let key = unicode.scalar_at(table, at)
        if key < scalar {
            low = mid + 1usize
        } else {
            if key > scalar {
                high = mid
            } else {
                if table[at + 3usize] == 1u8 && !compat { ret (0usize, 0usize, false) }
                ret (usize(unicode.scalar_at(table, at + 4usize)), usize(table[at + 7usize]), true)
            }
        }
    }
    ret (0usize, 0usize, false)
}

// The full decomposition of `scalar` written at out[used..]; answers the new used.
fn decompose(scalar: u32, compat: bool, out: []u32, used: usize) -> (usize, err) {
    if scalar >= S_BASE && scalar < S_BASE + S_COUNT {
        let index = scalar - S_BASE
        if used + 3usize > out.len { ret (used, Invalid) }
        out[used] = L_BASE + index / N_COUNT
        out[used + 1usize] = V_BASE + (index % N_COUNT) / T_COUNT
        let t = index % T_COUNT
        if t == 0u32 { ret (used + 2usize, ok) }
        out[used + 2usize] = T_BASE + t
        ret (used + 3usize, ok)
    }
    let (offset, count, found) = lookup(scalar, compat)
    if !found {
        if used >= out.len { ret (used, Invalid) }
        out[used] = scalar
        ret (used + 1usize, ok)
    }
    let pool = decomposition_pool()
    var at = used
    var i = 0usize
    while i < count {
        let (next, next_error) = decompose(unicode.scalar_at(pool, (offset + i) * 3usize), compat, out, at)
        if next_error != ok { ret (at, next_error) }
        at = next
        i += 1usize
    }
    ret (at, ok)
}

// Canonical ordering: a stable sort of each run of non-starters by combining class.
// Runs are short, so insertion is the right sort.
fn reorder(buf: []u32) {
    var i = 1usize
    while i < buf.len {
        let class = unicode.combining_class(buf[i])
        if class != 0u8 {
            var j = i
            while j > 0usize {
                if unicode.combining_class(buf[j - 1usize]) <= class { break }
                let held = buf[j]
                buf[j] = buf[j - 1usize]
                buf[j - 1usize] = held
                j = j - 1usize
            }
        }
        i += 1usize
    }
}

// The primary composite of a pair, if there is one. Hangul L+V and LV+T are arithmetic;
// everything else is the sorted table of first(3) second(3) composed(3).
fn pair(first: u32, second: u32) -> (u32, bool) {
    if first >= L_BASE && first < L_BASE + L_COUNT && second >= V_BASE && second < V_BASE + V_COUNT {
        ret (S_BASE + ((first - L_BASE) * V_COUNT + (second - V_BASE)) * T_COUNT, true)
    }
    if first >= S_BASE && first < S_BASE + S_COUNT && (first - S_BASE) % T_COUNT == 0u32 && second > T_BASE && second < T_BASE + T_COUNT {
        ret (first + (second - T_BASE), true)
    }
    let table = composition_table()
    let key = (u64(first) << 21u32) | u64(second)
    var low = 0usize
    var high = table.len / 9usize
    while low < high {
        let mid = (low + high) / 2usize
        let at = mid * 9usize
        let probe = (u64(unicode.scalar_at(table, at)) << 21u32) | u64(unicode.scalar_at(table, at + 3usize))
        if probe < key {
            low = mid + 1usize
        } else {
            if probe > key {
                high = mid
            } else {
                ret (unicode.scalar_at(table, at + 6usize), true)
            }
        }
    }
    ret (0u32, false)
}

// Canonical composition in place; answers the new length. A scalar composes with the
// last starter unless something between them has a combining class that is zero or
// not below its own -- that is what "blocked" means in UAX #15.
fn compose(buf: []u32) -> usize {
    if buf.len == 0usize { ret 0usize }
    var written = 1usize
    var starter = 0usize
    var has_starter = unicode.combining_class(buf[0usize]) == 0u8
    var last_class = unicode.combining_class(buf[0usize])
    var i = 1usize
    while i < buf.len {
        let scalar = buf[i]
        let class = unicode.combining_class(scalar)
        var composed = false
        if has_starter && (last_class == 0u8 || last_class < class) {
            let (joined, joins) = pair(buf[starter], scalar)
            if joins {
                buf[starter] = joined
                composed = true
            }
        }
        if !composed {
            if class == 0u8 {
                starter = written
                has_starter = true
            }
            last_class = class
            buf[written] = scalar
            written += 1usize
        }
        i += 1usize
    }
    ret written
}

// Decode, decompose, reorder and (for the composed forms) compose `s` into `out` as
// scalars; answers how many. `Invalid` is malformed UTF-8 or an `out` too small.
fn normalize_into(s: str, out: []u32, form: Form) -> (usize, err) {
    var used = 0usize
    var it = utf8.iterator(s)
    while true {
        let (scalar, more, scalar_error) = utf8.iterator_next_err(&it)
        if scalar_error != ok { ret (0usize, Invalid) }
        if !more { break }
        let (next, next_error) = decompose(scalar, wants_compat(form), out, used)
        if next_error != ok { ret (0usize, next_error) }
        used = next
    }
    reorder(out[..used])
    if composes(form) { used = compose(out[..used]) }
    ret (used, ok)
}

fn normalize(a: *mem.Arena, s: str, form: Form) -> (str, err) {
    if s.len == 0usize { ret ("", ok) }
    let (scalars, count_error) = utf8.count(s)
    if count_error != ok { ret ("", Invalid) }
    // NFD grows a scalar to at most 4, NFKD to at most 18 (U+FDFA).
    var factor = 4usize
    if wants_compat(form) { factor = 18usize }
    let (buffer, buffer_error) = mem.alloc[u32](a, scalars * factor)
    if buffer_error != ok { ret ("", buffer_error) }
    let (used, used_error) = normalize_into(s, buffer, form)
    if used_error != ok { ret ("", used_error) }
    let (out, out_error) = mem.alloc[u8](a, used * 4usize + 1usize)
    if out_error != ok { ret ("", out_error) }
    var at = 0usize
    var i = 0usize
    while i < used {
        let (width, width_error) = utf8.encode(buffer[i], out[at..])
        if width_error != ok { ret ("", Invalid) }
        at += usize(width)
        i += 1usize
    }
    ret (out[..at], ok)
}

// A starter that neither decomposes under this form nor can be the second of a
// composition: nothing normalization does crosses it, so a segment may end before it.
fn is_cut(scalar: u32, form: Form) -> bool {
    if unicode.combining_class(scalar) != 0u8 { ret false }
    if scalar >= S_BASE && scalar < S_BASE + S_COUNT { ret false }
    let (offset, count, found) = lookup(scalar, wants_compat(form))
    if found { ret false }
    let table = starter_seconds_table()
    var at = 0usize
    while at < table.len {
        if unicode.scalar_at(table, at) == scalar { ret false }
        at += 3usize
    }
    ret true
}

// Whether the bytes of `segment` are exactly the encoding of `scalars`.
fn same(segment: str, scalars: []const u32) -> bool {
    var at = 0usize
    var i = 0usize
    var piece: [4]u8 = zero
    while i < scalars.len {
        let (width, width_error) = utf8.encode(scalars[i], piece[..])
        if width_error != ok { ret false }
        var k = 0usize
        while k < usize(width) {
            if at >= segment.len || segment[at] != piece[k] { ret false }
            at += 1usize
            k += 1usize
        }
        i += 1usize
    }
    ret at == segment.len
}

// ponytail: a segment longer than the window after decomposition answers Invalid;
// raise it, or thread an arena, if real text ever hits it.
fn is_normalized(s: str, form: Form) -> (bool, err) {
    var window: [512]u32 = zero
    var start = 0usize
    while start < s.len {
        var end = start
        var first = true
        while end < s.len {
            let (d, d_error) = utf8.decode(s, end)
            if d_error != ok { ret (false, Invalid) }
            if !first && is_cut(d.scalar, form) { break }
            first = false
            end += usize(d.width)
        }
        let (used, used_error) = normalize_into(s[start..end], window[..], form)
        if used_error != ok { ret (false, used_error) }
        if !same(s[start..end], window[..used]) { ret (false, ok) }
        start = end
    }
    ret (true, ok)
}

