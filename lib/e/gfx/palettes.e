// The discrete palettes of R ggsci and ggthemes as data (palettes_data.e, generated by
// scripts/gen_palettes.R) and `colour`: the k-th colour of a palette's first n, packed as
// r * 2^24 + g * 2^16 + b * 2^8 + alpha, with alpha applied the way ggsci does (255 * alpha, truncated).
//
// Not here: the continuous palettes (pal_gsea, pal_material, pal_gradient...) and the ggthemes themes.

use e.gfx.palettes_data as data
use e.str

fn hex_digit(c: u8) -> u32 {
    if c >= 97u8 { ret u32(c - 87u8) }
    if c >= 65u8 { ret u32(c - 55u8) }
    ret u32(c - 48u8)
}

// the byte offset of the start of row `idx` (0-based) of the table
fn row_start(idx: usize) -> usize {
    let t = data.rows()
    var at = 0usize
    var r = 0usize
    while r < idx && at < t.len {
        while at < t.len && t[at] != 10u8 { at += 1usize }
        at += 1usize
        r += 1usize
    }
    ret at
}

// the number of rows
fn row_count() -> usize {
    let t = data.rows()
    var c = 0usize
    var i = 0usize
    while i < t.len {
        if t[i] == 10u8 { c += 1usize }
        i += 1usize
    }
    ret c
}

// the k-th (0-based) colour of row idx at the given alpha (0 < alpha <= 1); 0 when out of range
fn colour(idx: usize, k: usize, alpha: f64) -> u64 {
    let t = data.rows()
    var at = row_start(idx)
    while at < t.len && t[at] != 124u8 { at += 1usize }
    at += 1usize
    var j = 0usize
    while j < k {
        while at < t.len && t[at] != 44u8 && t[at] != 10u8 { at += 1usize }
        if at >= t.len || t[at] == 10u8 { ret 0u64 }
        at += 1usize
        j += 1usize
    }
    var v = 0u64
    var d = 1usize
    while d <= 6usize {
        v = v * 16u64 + u64(hex_digit(t[at + d]))
        d += 1usize
    }
    let a = u64(255.0f64 * alpha)
    ret v * 256u64 + a
}

// the number of colours of row idx
fn size(idx: usize) -> usize {
    let t = data.rows()
    var at = row_start(idx)
    var c = 0usize
    while at < t.len && t[at] != 10u8 {
        if t[at] == 35u8 { c += 1usize }
        at += 1usize
    }
    ret c
}
