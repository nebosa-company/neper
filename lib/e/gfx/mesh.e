// Marching cubes over an `nx` x `ny` x `nz` grid (x fastest) at `iso`, into
// `out` as a triangle soup (nine values per triangle) with normals pointing
// out of the inside (`field < iso`) in grid units; answers the triangle count.
fn marching_cubes(field: []const f64, nx: usize, ny: usize, nz: usize, iso: f64, out: []f64) -> (usize, err) {
    if nx < 2usize || ny < 2usize || nz < 2usize || field.len < nx * ny * nz { ret (0usize, Invalid) }
    let corners = cube_corners()
    let edges = cube_edges()
    let table = cube_table()
    var count = 0usize
    var z = 0usize
    while z + 1usize < nz {
        var y = 0usize
        while y + 1usize < ny {
            var x = 0usize
            while x + 1usize < nx {
                var value: [8]f64 = zero
                var code = 0usize
                var c = 0usize
                while c < 8usize {
                    let cx = x + usize(corners[3usize * c])
                    let cy = y + usize(corners[3usize * c + 1usize])
                    let cz = z + usize(corners[3usize * c + 2usize])
                    value[c] = field[cx + nx * (cy + ny * cz)]
                    if value[c] < iso { code |= 1usize << u32(c) }
                    c += 1usize
                }
                var k = 0usize
                while k < 15usize && table[16usize * code + k] != 255u8 {
                    if 9usize * count + 9usize > out.len { ret (count, TooSmall) }
                    var m = 0usize
                    while m < 3usize {
                        let e = usize(table[16usize * code + k + m])
                        let a = usize(edges[2usize * e])
                        let b = usize(edges[2usize * e + 1usize])
                        let t = (iso - value[a]) / (value[b] - value[a])
                        let o = 9usize * count + 3usize * m
                        out[o] = f64(x) + f64(corners[3usize * a]) + t * (f64(corners[3usize * b]) - f64(corners[3usize * a]))
                        out[o + 1usize] = f64(y) + f64(corners[3usize * a + 1usize]) + t * (f64(corners[3usize * b + 1usize]) - f64(corners[3usize * a + 1usize]))
                        out[o + 2usize] = f64(z) + f64(corners[3usize * a + 2usize]) + t * (f64(corners[3usize * b + 2usize]) - f64(corners[3usize * a + 2usize]))
                        m += 1usize
                    }
                    count += 1usize
                    k += 3usize
                }
                x += 1usize
            }
            y += 1usize
        }
        z += 1usize
    }
    ret (count, ok)
}

// Dual contouring of `sdf` over `nx` x `ny` x `nz` cells of size `cell` from
// (`x0`, `y0`, `z0`): one vertex per cell with a sign change, placed at the
// point closest to the tangent planes of its edge crossings (a few
// regularised normal-equation solves), and two triangles per crossed
// interior edge. `field` caches the corner samples ((nx+1)(ny+1)(nz+1)) and
// `scratch` holds one u32 per cell; answers (vertex count, triangle count).
fn dual_contouring[Ctx: type](ctx: *Ctx, sdf: fn(*Ctx, f64, f64, f64) -> f64, nx: usize, ny: usize, nz: usize, x0: f64, y0: f64, z0: f64, cell: f64, out_vertices: []f64, out_triangles: []u32, field: []f64, scratch: []u32) -> (usize, usize, err) {
    let sx = nx + 1usize
    let sy = ny + 1usize
    let sz = nz + 1usize
    if nx == 0usize || ny == 0usize || nz == 0usize || cell <= 0.0f64 { ret (0usize, 0usize, Invalid) }
    if field.len < sx * sy * sz || scratch.len < nx * ny * nz { ret (0usize, 0usize, TooSmall) }
    var k = 0usize
    while k < sz {
        var j = 0usize
        while j < sy {
            var i = 0usize
            while i < sx {
                field[i + sx * (j + sy * k)] = sdf(ctx, x0 + cell * f64(i), y0 + cell * f64(j), z0 + cell * f64(k))
                i += 1usize
            }
            j += 1usize
        }
        k += 1usize
    }
    let corners = cube_corners()
    let edges = cube_edges()
    let cells = scratch[..nx * ny * nz]
    var vertex_count = 0usize
    let h = cell * 0.001f64
    k = 0usize
    while k < nz {
        var j = 0usize
        while j < ny {
            var i = 0usize
            while i < nx {
                var value: [8]f64 = zero
                var c = 0usize
                while c < 8usize {
                    value[c] = field[i + usize(corners[3usize * c]) + sx * (j + usize(corners[3usize * c + 1usize]) + sy * (k + usize(corners[3usize * c + 2usize])))]
                    c += 1usize
                }
                var a: [6]f64 = zero
                var b: [3]f64 = zero
                var mass = g3.vec3(0.0f64, 0.0f64, 0.0f64)
                var crossings = 0usize
                var e = 0usize
                while e < 12usize {
                    let ca = usize(edges[2usize * e])
                    let cb = usize(edges[2usize * e + 1usize])
                    if (value[ca] < 0.0f64) != (value[cb] < 0.0f64) {
                        let t = value[ca] / (value[ca] - value[cb])
                        let px = x0 + cell * (f64(i) + f64(corners[3usize * ca]) + t * (f64(corners[3usize * cb]) - f64(corners[3usize * ca])))
                        let py = y0 + cell * (f64(j) + f64(corners[3usize * ca + 1usize]) + t * (f64(corners[3usize * cb + 1usize]) - f64(corners[3usize * ca + 1usize])))
                        let pz = z0 + cell * (f64(k) + f64(corners[3usize * ca + 2usize]) + t * (f64(corners[3usize * cb + 2usize]) - f64(corners[3usize * ca + 2usize])))
                        let normal = g3.normalize(g3.vec3(sdf(ctx, px + h, py, pz) - sdf(ctx, px - h, py, pz), sdf(ctx, px, py + h, pz) - sdf(ctx, px, py - h, pz), sdf(ctx, px, py, pz + h) - sdf(ctx, px, py, pz - h)))
                        let d = normal.x * px + normal.y * py + normal.z * pz
                        a[0usize] += normal.x * normal.x
                        a[1usize] += normal.x * normal.y
                        a[2usize] += normal.x * normal.z
                        a[3usize] += normal.y * normal.y
                        a[4usize] += normal.y * normal.z
                        a[5usize] += normal.z * normal.z
                        b[0usize] += normal.x * d
                        b[1usize] += normal.y * d
                        b[2usize] += normal.z * d
                        mass = g3.add(mass, g3.vec3(px, py, pz))
                        crossings += 1usize
                    }
                    e += 1usize
                }
                let cell_index = i + nx * (j + ny * k)
                cells[cell_index] = NONE
                if crossings > 0usize {
                    mass = g3.scale(mass, 1.0f64 / f64(crossings))
                    // Regularise toward the mass point, then solve by Cramer's rule.
                    let reg = 0.01f64
                    let m00 = a[0usize] + reg
                    let m11 = a[3usize] + reg
                    let m22 = a[5usize] + reg
                    let m01 = a[1usize]
                    let m02 = a[2usize]
                    let m12 = a[4usize]
                    let rx = b[0usize] + reg * mass.x
                    let ry = b[1usize] + reg * mass.y
                    let rz = b[2usize] + reg * mass.z
                    let det = m00 * (m11 * m22 - m12 * m12) - m01 * (m01 * m22 - m12 * m02) + m02 * (m01 * m12 - m11 * m02)
                    var p = mass
                    if math.abs[f64](det) > 1.0e-18f64 {
                        p.x = (rx * (m11 * m22 - m12 * m12) - m01 * (ry * m22 - m12 * rz) + m02 * (ry * m12 - m11 * rz)) / det
                        p.y = (m00 * (ry * m22 - m12 * rz) - rx * (m01 * m22 - m12 * m02) + m02 * (m01 * rz - ry * m02)) / det
                        p.z = (m00 * (m11 * rz - ry * m12) - m01 * (m01 * rz - ry * m02) + rx * (m01 * m12 - m11 * m02)) / det
                    }
                    let lo = g3.vec3(x0 + cell * f64(i), y0 + cell * f64(j), z0 + cell * f64(k))
                    if p.x < lo.x { p.x = lo.x }
                    if p.y < lo.y { p.y = lo.y }
                    if p.z < lo.z { p.z = lo.z }
                    if p.x > lo.x + cell { p.x = lo.x + cell }
                    if p.y > lo.y + cell { p.y = lo.y + cell }
                    if p.z > lo.z + cell { p.z = lo.z + cell }
                    if 3usize * vertex_count + 3usize > out_vertices.len { ret (vertex_count, 0usize, TooSmall) }
                    put(out_vertices, vertex_count, p)
                    cells[cell_index] = u32(vertex_count)
                    vertex_count += 1usize
                }
                i += 1usize
            }
            j += 1usize
        }
        k += 1usize
    }
    // Interior grid edges with a sign change: the four cells around each make a quad.
    var triangle_count = 0usize
    var axis = 0usize
    while axis < 3usize {
        k = 0usize
        while k < sz {
            var j = 0usize
            while j < sy {
                var i = 0usize
                while i < sx {
                    var i2 = i
                    var j2 = j
                    var k2 = k
                    if axis == 0usize { i2 += 1usize }
                    if axis == 1usize { j2 += 1usize }
                    if axis == 2usize { k2 += 1usize }
                    let interior = i2 < sx && j2 < sy && k2 < sz && (axis == 0usize || (i > 0usize && i < nx)) && (axis == 1usize || (j > 0usize && j < ny)) && (axis == 2usize || (k > 0usize && k < nz))
                    if interior {
                        let va = field[i + sx * (j + sy * k)]
                        let vb = field[i2 + sx * (j2 + sy * k2)]
                        if (va < 0.0f64) != (vb < 0.0f64) {
                            var quad: [4]u32 = zero
                            if axis == 0usize {
                                quad[0usize] = cells[i + nx * ((j - 1usize) + ny * (k - 1usize))]
                                quad[1usize] = cells[i + nx * (j + ny * (k - 1usize))]
                                quad[2usize] = cells[i + nx * (j + ny * k)]
                                quad[3usize] = cells[i + nx * ((j - 1usize) + ny * k)]
                            } else if axis == 1usize {
                                quad[0usize] = cells[(i - 1usize) + nx * (j + ny * (k - 1usize))]
                                quad[1usize] = cells[(i - 1usize) + nx * (j + ny * k)]
                                quad[2usize] = cells[i + nx * (j + ny * k)]
                                quad[3usize] = cells[i + nx * (j + ny * (k - 1usize))]
                            } else {
                                quad[0usize] = cells[(i - 1usize) + nx * ((j - 1usize) + ny * k)]
                                quad[1usize] = cells[i + nx * ((j - 1usize) + ny * k)]
                                quad[2usize] = cells[i + nx * (j + ny * k)]
                                quad[3usize] = cells[(i - 1usize) + nx * (j + ny * k)]
                            }
                            if quad[0usize] != NONE && quad[1usize] != NONE && quad[2usize] != NONE && quad[3usize] != NONE {
                                if 3usize * triangle_count + 6usize > out_triangles.len { ret (vertex_count, triangle_count, TooSmall) }
                                if va < 0.0f64 {
                                    let o = 3usize * triangle_count
                                    out_triangles[o] = quad[0usize]
                                    out_triangles[o + 1usize] = quad[1usize]
                                    out_triangles[o + 2usize] = quad[2usize]
                                    out_triangles[o + 3usize] = quad[0usize]
                                    out_triangles[o + 4usize] = quad[2usize]
                                    out_triangles[o + 5usize] = quad[3usize]
                                } else {
                                    let o = 3usize * triangle_count
                                    out_triangles[o] = quad[0usize]
                                    out_triangles[o + 1usize] = quad[2usize]
                                    out_triangles[o + 2usize] = quad[1usize]
                                    out_triangles[o + 3usize] = quad[0usize]
                                    out_triangles[o + 4usize] = quad[3usize]
                                    out_triangles[o + 5usize] = quad[2usize]
                                }
                                triangle_count += 2usize
                            }
                        }
                    }
                    i += 1usize
                }
                j += 1usize
            }
            k += 1usize
        }
        axis += 1usize
    }
    ret (vertex_count, triangle_count, ok)
}

// ---- distance --------------------------------------------------------------

// Signed distance from (`x`, `y`, `z`) to a closed mesh: the closest point
// over every triangle, negative inside, the sign from the pseudo-normal of the
// closest feature (face normal, the two face normals of an edge, or the
// angle-weighted normals around a vertex).
fn signed_distance(vertices: []const f64, triangles: []const u32, x: f64, y: f64, z: f64) -> f64 {
    let p = g3.vec3(x, y, z)
    let count = triangles.len / 3usize
    var best = infinity()
    var best_face = 0usize
    var best_bits = 0u32
    var best_q = g3.vec3(0.0f64, 0.0f64, 0.0f64)
    var f = 0usize
    while f < count {
        let a = g3.sub(point(vertices, usize(triangles[3usize * f])), p)
        let b = g3.sub(point(vertices, usize(triangles[3usize * f + 1usize])), p)
        let c = g3.sub(point(vertices, usize(triangles[3usize * f + 2usize])), p)
        let (q, bits) = g3.closest_on_triangle(a, b, c)
        let dd = g3.dot(q, q)
        if dd < best {
            best = dd
            best_face = f
            best_bits = bits
            best_q = q
        }
        f += 1usize
    }
    if count == 0usize { ret best }
    var normal = g3.vec3(0.0f64, 0.0f64, 0.0f64)
    if best_bits == 7u32 {
        normal = face_normal(vertices, triangles, best_face)
    } else {
        var va = NONE
        var vb = NONE
        var k = 0usize
        while k < 3usize {
            if ((best_bits >> u32(k)) & 1u32) == 1u32 {
                if va == NONE { va = triangles[3usize * best_face + k] } else { vb = triangles[3usize * best_face + k] }
            }
            k += 1usize
        }
        f = 0usize
        while f < count {
            var has_a = false
            var has_b = false
            var corner_a = 0usize
            k = 0usize
            while k < 3usize {
                if triangles[3usize * f + k] == va {
                    has_a = true
                    corner_a = k
                }
                if triangles[3usize * f + k] == vb { has_b = true }
                k += 1usize
            }
            if has_a && (vb == NONE || has_b) {
                let face_unit = g3.normalize(face_normal(vertices, triangles, f))
                if vb == NONE {
                    let o = point(vertices, usize(va))
                    let e1 = g3.sub(point(vertices, usize(triangles[3usize * f + (corner_a + 1usize) % 3usize])), o)
                    let e2 = g3.sub(point(vertices, usize(triangles[3usize * f + (corner_a + 2usize) % 3usize])), o)
                    var cosine = g3.dot(e1, e2) / (g3.length(e1) * g3.length(e2))
                    if cosine > 1.0f64 { cosine = 1.0f64 }
                    if cosine < 0.0f64 - 1.0f64 { cosine = 0.0f64 - 1.0f64 }
                    normal = g3.add(normal, g3.scale(face_unit, math.acos[f64](cosine)))
                } else {
                    normal = g3.add(normal, face_unit)
                }
            }
            f += 1usize
        }
    }
    let d = math.sqrt[f64](best)
    if g3.dot(best_q, normal) > 0.0f64 { ret 0.0f64 - d }
    ret d
}

// ---- geodesics -------------------------------------------------------------

// Kimmel-Sethian update of vertex `c` from `a` and `b` (both settled).
fn fast_marching_update(vertices: []const f64, ta: f64, tb: f64, a: usize, b: usize, c: usize) -> f64 {
    var t_a = ta
    var t_b = tb
    var pa = point(vertices, a)
    var pb = point(vertices, b)
    if t_b < t_a {
        t_a = tb
        t_b = ta
        pa = point(vertices, b)
        pb = point(vertices, a)
    }
    let pc = point(vertices, c)
    let ca = g3.sub(pa, pc)
    let cb = g3.sub(pb, pc)
    let len_b = g3.length(ca)
    let len_a = g3.length(cb)
    let cosine = g3.dot(ca, cb) / (len_a * len_b)
    let sine2 = 1.0f64 - cosine * cosine
    let u = t_b - t_a
    let qa = len_a * len_a + len_b * len_b - 2.0f64 * len_a * len_b * cosine
    let qb = 2.0f64 * len_b * u * (len_a * cosine - len_b)
    let qc = len_b * len_b * (u * u - len_a * len_a * sine2)
    let disc = qb * qb - 4.0f64 * qa * qc
    var fallback = len_b + t_a
    if len_a + t_b < fallback { fallback = len_a + t_b }
    if disc < 0.0f64 || qa == 0.0f64 { ret fallback }
    let t = (0.0f64 - qb + math.sqrt[f64](disc)) / (2.0f64 * qa)
    if u < t && t > 0.0f64 {
        let ratio = len_b * (t - u) / t
        if len_a * cosine < ratio && (cosine <= 0.0f64 || ratio < len_a / cosine) { ret t + t_a }
    }
    ret fallback
}

// Geodesic distance from `source` over the surface by fast marching with the
// Kimmel-Sethian triangle update (no unfolding of obtuse triangles); `state`
// holds one byte per vertex.
// ponytail: the narrow band is scanned for its minimum, O(V^2); a heap when
// meshes grow.
fn geodesic_fast_marching(vertices: []const f64, triangles: []const u32, source: u32, distance: []f64, state: []u8) -> err {
    let n = vertices.len / 3usize
    if triangles.len % 3usize != 0usize || usize(source) >= n { ret Invalid }
    if distance.len < n || state.len < n { ret TooSmall }
    fill(distance[..n], infinity())
    var i = 0usize
    while i < n {
        state[i] = 0u8
        i += 1usize
    }
    distance[usize(source)] = 0.0f64
    state[usize(source)] = 1u8
    while true {
        var best = NONE
        var best_d = infinity()
        i = 0usize
        while i < n {
            if state[i] == 1u8 && distance[i] < best_d {
                best_d = distance[i]
                best = u32(i)
            }
            i += 1usize
        }
        if best == NONE { break }
        state[usize(best)] = 2u8
        var f = 0usize
        while f * 3usize < triangles.len {
            var k = 0usize
            var has = false
            while k < 3usize {
                if triangles[3usize * f + k] == best { has = true }
                k += 1usize
            }
            if has {
                k = 0usize
                while k < 3usize {
                    let c = usize(triangles[3usize * f + k])
                    if state[c] != 2u8 {
                        let a = usize(triangles[3usize * f + (k + 1usize) % 3usize])
                        let b = usize(triangles[3usize * f + (k + 2usize) % 3usize])
                        var candidate = infinity()
                        if state[a] == 2u8 && state[b] == 2u8 {
                            candidate = fast_marching_update(vertices, distance[a], distance[b], a, b, c)
                        } else {
                            candidate = distance[usize(best)] + g3.length(g3.sub(point(vertices, c), point(vertices, usize(best))))
                        }
                        if candidate < distance[c] {
                            distance[c] = candidate
                            state[c] = 1u8
                        }
                    }
                    k += 1usize
                }
            }
            f += 1usize
        }
    }
    ret ok
}

// Cotangent at each triangle corner into `cot` (three per triangle) and the
// barycentric vertex areas into `mass`.
fn cotangents(vertices: []const f64, triangles: []const u32, cot: []f64, mass: []f64) {
    fill(mass, 0.0f64)
    var f = 0usize
    while f * 3usize < triangles.len {
        var k = 0usize
        let area = 0.5f64 * g3.length(face_normal(vertices, triangles, f))
        while k < 3usize {
            let o = point(vertices, usize(triangles[3usize * f + k]))
            let e1 = g3.sub(point(vertices, usize(triangles[3usize * f + (k + 1usize) % 3usize])), o)
            let e2 = g3.sub(point(vertices, usize(triangles[3usize * f + (k + 2usize) % 3usize])), o)
            let crossed = g3.length(g3.cross(e1, e2))
            if crossed > 1.0e-300f64 { cot[3usize * f + k] = g3.dot(e1, e2) / crossed } else { cot[3usize * f + k] = 0.0f64 }
            mass[usize(triangles[3usize * f + k])] += area / 3.0f64
            k += 1usize
        }
        f += 1usize
    }
}

// y = A x for the three matrix-free operators: the heat step M + t L, the
// cotangent Laplacian L (with a tiny mass term to pin the constant), and the
// LSCM normal equations with two vertices pinned.
fn apply(op: *const Operator, x: []const f64, y: []f64) {
    fill(y, 0.0f64)
    let triangles = op.triangles
    if op.kind == OP_LSCM {
        var f = 0usize
        while f * 3usize < triangles.len {
            var re = 0.0f64
            var im = 0.0f64
            var k = 0usize
            while k < 3usize {
                let j = usize(triangles[3usize * f + k])
                let wr = op.cot[6usize * f + 2usize * k]
                let wi = op.cot[6usize * f + 2usize * k + 1usize]
                re += wr * x[2usize * j] - wi * x[2usize * j + 1usize]
                im += wi * x[2usize * j] + wr * x[2usize * j + 1usize]
                k += 1usize
            }
            k = 0usize
            while k < 3usize {
                let j = usize(triangles[3usize * f + k])
                let wr = op.cot[6usize * f + 2usize * k]
                let wi = op.cot[6usize * f + 2usize * k + 1usize]
                y[2usize * j] += wr * re + wi * im
                y[2usize * j + 1usize] += wr * im - wi * re
                k += 1usize
            }
            f += 1usize
        }
        y[2usize * op.pin_a] = 0.0f64
        y[2usize * op.pin_a + 1usize] = 0.0f64
        y[2usize * op.pin_b] = 0.0f64
        y[2usize * op.pin_b + 1usize] = 0.0f64
        ret
    }
    var g = 0usize
    while g * 3usize < triangles.len {
        var m = 0usize
        while m < 3usize {
            let vi = usize(triangles[3usize * g + (m + 1usize) % 3usize])
            let vj = usize(triangles[3usize * g + (m + 2usize) % 3usize])
            let w = 0.5f64 * op.cot[3usize * g + m] * op.t
            y[vi] += w * (x[vi] - x[vj])
            y[vj] += w * (x[vj] - x[vi])
            m += 1usize
        }
        g += 1usize
    }
    var row = 0usize
    var mass_scale = 1.0f64
    if op.kind == OP_POISSON { mass_scale = 1.0e-9f64 }
    while row < y.len {
        y[row] += mass_scale * op.mass[row] * x[row]
        row += 1usize
    }
}

// Conjugate gradients on the operator: `x` starts as given (its pinned
// entries stay), `b` is the right-hand side; `r`, `p`, `q` are scratch.
fn conjugate_gradient(op: *const Operator, b: []const f64, x: []f64, r: []f64, p: []f64, q: []f64, iterations: usize) {
    apply(op, x, q)
    var i = 0usize
    var rr = 0.0f64
    while i < x.len {
        r[i] = b[i] - q[i]
        p[i] = r[i]
        rr += r[i] * r[i]
        i += 1usize
    }
    var it = 0usize
    while it < iterations && rr > 1.0e-28f64 {
        apply(op, p, q)
        var pq = 0.0f64
        i = 0usize
        while i < x.len {
            pq += p[i] * q[i]
            i += 1usize
        }
        if pq <= 0.0f64 { break }
        let alpha = rr / pq
        var rr_next = 0.0f64
        i = 0usize
        while i < x.len {
            x[i] += alpha * p[i]
            r[i] -= alpha * q[i]
            rr_next += r[i] * r[i]
            i += 1usize
        }
        let beta = rr_next / rr
        i = 0usize
        while i < x.len {
            p[i] = r[i] + beta * p[i]
            i += 1usize
        }
        rr = rr_next
        it += 1usize
    }
}

// Geodesic distance from `source` by the heat method (Crane, Weischedel,
// Wardetzky): heat for one step of the mean squared edge length, the
// normalised negative gradient, and a Poisson solve for its divergence, both
// by conjugate gradients of at most `iterations` steps. `scratch` holds
// three f64 per triangle plus six per vertex.
fn geodesic_heat(vertices: []const f64, triangles: []const u32, source: u32, iterations: usize, distance: []f64, scratch: []f64) -> err {
    let n = vertices.len / 3usize
    let t = triangles.len / 3usize
    if triangles.len % 3usize != 0usize || usize(source) >= n { ret Invalid }
    if distance.len < n || scratch.len < 3usize * t + 6usize * n { ret TooSmall }
    let cot = scratch[..3usize * t]
    let mass = scratch[3usize * t..3usize * t + n]
    let u = scratch[3usize * t + n..3usize * t + 2usize * n]
    let b = scratch[3usize * t + 2usize * n..3usize * t + 3usize * n]
    let r = scratch[3usize * t + 3usize * n..3usize * t + 4usize * n]
    let p = scratch[3usize * t + 4usize * n..3usize * t + 5usize * n]
    let q = scratch[3usize * t + 5usize * n..3usize * t + 6usize * n]
    cotangents(vertices, triangles, cot, mass)
    var edge_sum = 0.0f64
    var h = 0usize
    while h < triangles.len {
        let d = g3.sub(point(vertices, usize(triangles[h])), point(vertices, usize(triangles[h - h % 3usize + (h + 1usize) % 3usize])))
        edge_sum += g3.dot(d, d)
        h += 1usize
    }
    let step = edge_sum / f64(triangles.len)
    var op = Operator { triangles: triangles, cot: cot, mass: mass, t: step, kind: OP_HEAT, pin_a: 0usize, pin_b: 0usize }
    fill(b, 0.0f64)
    b[usize(source)] = 1.0f64
    fill(u, 0.0f64)
    conjugate_gradient(&op, b, u, r, p, q, iterations)
    // Divergence of the normalised negative gradient per vertex.
    fill(b, 0.0f64)
    var f = 0usize
    while f < t {
        let i0 = usize(triangles[3usize * f])
        let i1 = usize(triangles[3usize * f + 1usize])
        let i2 = usize(triangles[3usize * f + 2usize])
        let p0 = point(vertices, i0)
        let p1 = point(vertices, i1)
        let p2 = point(vertices, i2)
        let normal = g3.cross(g3.sub(p1, p0), g3.sub(p2, p0))
        let area2 = g3.length(normal)
        if area2 > 1.0e-300f64 {
            let unit = g3.scale(normal, 1.0f64 / area2)
            var grad = g3.scale(g3.cross(unit, g3.sub(p2, p1)), u[i0])
            grad = g3.add(grad, g3.scale(g3.cross(unit, g3.sub(p0, p2)), u[i1]))
            grad = g3.add(grad, g3.scale(g3.cross(unit, g3.sub(p1, p0)), u[i2]))
            let glen = g3.length(grad)
            if glen > 1.0e-300f64 {
                let xf = g3.scale(grad, 0.0f64 - 1.0f64 / glen)
                var k = 0usize
                while k < 3usize {
                    let vi = usize(triangles[3usize * f + k])
                    let vj = usize(triangles[3usize * f + (k + 1usize) % 3usize])
                    let vl = usize(triangles[3usize * f + (k + 2usize) % 3usize])
                    let e1 = g3.sub(point(vertices, vj), point(vertices, vi))
                    let e2 = g3.sub(point(vertices, vl), point(vertices, vi))
                    // The angle opposite e1 is at vl (corner k+2); opposite e2 at vj (corner k+1).
                    b[vi] += 0.5f64 * (cot[3usize * f + (k + 2usize) % 3usize] * g3.dot(e1, xf) + cot[3usize * f + (k + 1usize) % 3usize] * g3.dot(e2, xf))
                    k += 1usize
                }
            }
        }
        f += 1usize
    }
    var mean = 0.0f64
    var i = 0usize
    while i < n {
        mean += b[i]
        i += 1usize
    }
    mean /= f64(n)
    i = 0usize
    while i < n {
        b[i] = 0.0f64 - (b[i] - mean)
        i += 1usize
    }
    op.kind = OP_POISSON
    op.t = 1.0f64
    fill(distance[..n], 0.0f64)
    conjugate_gradient(&op, b, distance[..n], r, p, q, iterations)
    let shift = distance[usize(source)]
    i = 0usize
    while i < n {
        distance[i] -= shift
        i += 1usize
    }
    ret ok
}

// ---- parameterisation ------------------------------------------------------

// Least squares conformal map (Levy et al.) with `pin_a` at (0, 0) and
// `pin_b` at (1, 0), solved by conjugate gradients on the normal equations;
// `uv` holds two values per vertex and `scratch` six f64 per triangle plus
// eight per vertex.
fn parameterize_lscm(vertices: []const f64, triangles: []const u32, pin_a: u32, pin_b: u32, iterations: usize, uv: []f64, scratch: []f64) -> err {
    let n = vertices.len / 3usize
    let t = triangles.len / 3usize
    if triangles.len % 3usize != 0usize || usize(pin_a) >= n || usize(pin_b) >= n || pin_a == pin_b { ret Invalid }
    if uv.len < 2usize * n || scratch.len < 6usize * t + 8usize * n { ret TooSmall }
    let w = scratch[..6usize * t]
    let b = scratch[6usize * t..6usize * t + 2usize * n]
    let r = scratch[6usize * t + 2usize * n..6usize * t + 4usize * n]
    let p = scratch[6usize * t + 4usize * n..6usize * t + 6usize * n]
    let q = scratch[6usize * t + 6usize * n..6usize * t + 8usize * n]
    var f = 0usize
    while f < t {
        let p0 = point(vertices, usize(triangles[3usize * f]))
        let e01 = g3.sub(point(vertices, usize(triangles[3usize * f + 1usize])), p0)
        let e02 = g3.sub(point(vertices, usize(triangles[3usize * f + 2usize])), p0)
        let l01 = g3.length(e01)
        let area2 = g3.length(g3.cross(e01, e02))
        var scale = 0.0f64
        if area2 > 1.0e-300f64 && l01 > 0.0f64 { scale = 1.0f64 / math.sqrt[f64](area2) }
        // Local coordinates: P0 = (0, 0), P1 = (l01, 0), P2 = (x2, y2).
        var x2 = 0.0f64
        var y2 = 0.0f64
        if l01 > 0.0f64 {
            x2 = g3.dot(e02, e01) / l01
            y2 = area2 / l01
        }
        w[6usize * f] = (x2 - l01) * scale
        w[6usize * f + 1usize] = y2 * scale
        w[6usize * f + 2usize] = (0.0f64 - x2) * scale
        w[6usize * f + 3usize] = (0.0f64 - y2) * scale
        w[6usize * f + 4usize] = l01 * scale
        w[6usize * f + 5usize] = 0.0f64
        f += 1usize
    }
    let op = Operator { triangles: triangles, cot: w, mass: b, t: 1.0f64, kind: OP_LSCM, pin_a: usize(pin_a), pin_b: usize(pin_b) }
    fill(uv[..2usize * n], 0.0f64)
    uv[2usize * usize(pin_b)] = 1.0f64
    // The pins enter through the initial residual: b is zero and the pinned
    // rows of every product are dropped, so only the free entries move.
    fill(b, 0.0f64)
    conjugate_gradient(&op, b, uv[..2usize * n], r, p, q, iterations)
    ret ok
}

// ---- reconstruction --------------------------------------------------------

// Centre of the ball of radius `rho` through three points on the side of the
// normals; `false` when the circumradius exceeds `rho`.
fn ball_centre(points: []const f64, normals: []const f64, rho: f64, i: usize, j: usize, k: usize) -> (bool, g3.Vec3) {
    let a = point(points, i)
    let b = point(points, j)
    let c = point(points, k)
    let ab = g3.sub(b, a)
    let ac = g3.sub(c, a)
    let normal = g3.cross(ab, ac)
    let nn = g3.dot(normal, normal)
    if nn < 1.0e-24f64 { ret (false, a) }
    let to_centre = g3.scale(g3.sub(g3.scale(g3.cross(normal, ab), g3.dot(ac, ac)), g3.scale(g3.cross(normal, ac), g3.dot(ab, ab))), 0.5f64 / nn)
    let circumcentre = g3.add(a, to_centre)
    let rr = rho * rho - g3.dot(to_centre, to_centre)
    if rr < 0.0f64 { ret (false, a) }
    var unit = g3.scale(normal, 1.0f64 / math.sqrt[f64](nn))
    let side = g3.add(g3.add(point(normals, i), point(normals, j)), point(normals, k))
    if g3.dot(unit, side) < 0.0f64 { unit = g3.scale(unit, 0.0f64 - 1.0f64) }
    ret (true, g3.add(circumcentre, g3.scale(unit, math.sqrt[f64](rr))))
}

fn ball_empty(points: []const f64, centre: g3.Vec3, rho: f64, i: usize, j: usize, k: usize) -> bool {
    let limit = rho * rho * (1.0f64 - 1.0e-9f64)
    var m = 0usize
    while m * 3usize < points.len {
        if m != i && m != j && m != k {
            let d = g3.sub(point(points, m), centre)
            if g3.dot(d, d) < limit { ret false }
        }
        m += 1usize
    }
    ret true
}

// Pushes the directed edge (a, b) with opposite vertex c, or removes the
// reverse edge already on the front (gluing).
fn front_edge(edges: []u32, count: *usize, a: u32, b: u32, c: u32) -> err {
    var e = 0usize
    let n = *count
    while e < n {
        if edges[3usize * e] == b && edges[3usize * e + 1usize] == a {
            let last = n - 1usize
            edges[3usize * e] = edges[3usize * last]
            edges[3usize * e + 1usize] = edges[3usize * last + 1usize]
            edges[3usize * e + 2usize] = edges[3usize * last + 2usize]
            *count = last
            ret ok
        }
        e += 1usize
    }
    if 3usize * n + 3usize > edges.len { ret TooSmall }
    edges[3usize * n] = a
    edges[3usize * n + 1usize] = b
    edges[3usize * n + 2usize] = c
    *count = n + 1usize
    ret ok
}

fn push_triangle(out: []u32, count: *usize, a: u32, b: u32, c: u32) -> err {
    let n = *count
    if 3usize * n + 3usize > out.len { ret TooSmall }
    out[3usize * n] = a
    out[3usize * n + 1usize] = b
    out[3usize * n + 2usize] = c
    *count = n + 1usize
    ret ok
}

// Ball pivoting (Bernardini et al., simplified): a seed triangle whose ball of
// radius `rho` is empty, then the ball pivots around every front edge onto the
// first point it meets; `scratch` holds one u32 per point followed by the
// edge front (three u32 per edge); answers the triangle count.
// ponytail: candidates are scanned brute force, O(n) per pivot; a hash grid
// when clouds grow.
fn reconstruct_ball_pivot(points: []const f64, normals: []const f64, rho: f64, out_triangles: []u32, scratch: []u32) -> (usize, err) {
    let n = points.len / 3usize
    if normals.len < points.len || rho <= 0.0f64 { ret (0usize, Invalid) }
    if scratch.len < n + 9usize { ret (0usize, TooSmall) }
    let used = scratch[..n]
    let edges = scratch[n..]
    fill_u32(used, 0u32)
    var edge_count = 0usize
    var triangle_count = 0usize
    let reach = 4.0f64 * rho * rho
    var seed = 0usize
    while seed < n {
        if used[seed] == 0u32 {
            var found = false
            var j = 0usize
            while j < n && !found {
                let dj = g3.sub(point(points, j), point(points, seed))
                if j != seed && g3.dot(dj, dj) <= reach {
                    var k = j + 1usize
                    while k < n && !found {
                        let dk = g3.sub(point(points, k), point(points, seed))
                        if k != seed && g3.dot(dk, dk) <= reach {
                            let (fits, centre) = ball_centre(points, normals, rho, seed, j, k)
                            if fits && ball_empty(points, centre, rho, seed, j, k) {
                                var b = u32(j)
                                var c = u32(k)
                                let normal = g3.cross(g3.sub(point(points, j), point(points, seed)), g3.sub(point(points, k), point(points, seed)))
                                if g3.dot(normal, g3.sub(centre, point(points, seed))) < 0.0f64 {
                                    b = u32(k)
                                    c = u32(j)
                                }
                                let e = push_triangle(out_triangles, &triangle_count, u32(seed), b, c)
                                if e != ok { ret (triangle_count, e) }
                                let e1 = front_edge(edges, &edge_count, u32(seed), b, c)
                                if e1 != ok { ret (triangle_count, e1) }
                                let e2 = front_edge(edges, &edge_count, b, c, u32(seed))
                                if e2 != ok { ret (triangle_count, e2) }
                                let e3 = front_edge(edges, &edge_count, c, u32(seed), b)
                                if e3 != ok { ret (triangle_count, e3) }
                                used[seed] = 1u32
                                used[j] = 1u32
                                used[k] = 1u32
                                found = true
                            }
                        }
                        k += 1usize
                    }
                }
                j += 1usize
            }
            while edge_count > 0usize {
                edge_count -= 1usize
                let a = usize(edges[3usize * edge_count])
                let b = usize(edges[3usize * edge_count + 1usize])
                let c = usize(edges[3usize * edge_count + 2usize])
                let (fits, old_centre) = ball_centre(points, normals, rho, a, b, c)
                if fits {
                    let mid = g3.scale(g3.add(point(points, a), point(points, b)), 0.5f64)
                    let axis = g3.normalize(g3.sub(point(points, b), point(points, a)))
                    let v_old = g3.sub(old_centre, mid)
                    var sense = 1.0f64
                    if g3.dot(g3.cross(axis, v_old), g3.sub(point(points, c), mid)) > 0.0f64 { sense = 0.0f64 - 1.0f64 }
                    var best = NONE
                    var best_angle = infinity()
                    var m = 0usize
                    while m < n {
                        let dm = g3.sub(point(points, m), mid)
                        if m != a && m != b && m != c && g3.dot(dm, dm) <= reach {
                            let (fits_m, centre) = ball_centre(points, normals, rho, b, a, m)
                            if fits_m && ball_empty(points, centre, rho, a, b, m) {
                                let v_new = g3.sub(centre, mid)
                                var angle = math.atan2[f64](sense * g3.dot(g3.cross(v_old, v_new), axis), g3.dot(v_old, v_new))
                                if angle < 1.0e-9f64 { angle += 6.283185307179586f64 }
                                if angle < best_angle {
                                    best_angle = angle
                                    best = u32(m)
                                }
                            }
                        }
                        m += 1usize
                    }
                    if best != NONE {
                        let e = push_triangle(out_triangles, &triangle_count, u32(b), u32(a), best)
                        if e != ok { ret (triangle_count, e) }
                        let e1 = front_edge(edges, &edge_count, u32(a), best, u32(b))
                        if e1 != ok { ret (triangle_count, e1) }
                        let e2 = front_edge(edges, &edge_count, best, u32(b), u32(a))
                        if e2 != ok { ret (triangle_count, e2) }
                        used[usize(best)] = 1u32
                    }
                }
            }
        }
        seed += 1usize
    }
    ret (triangle_count, ok)
}

// A coarse screened-Poisson-style reconstruction: the normals are splatted
// (trilinearly) into an `nx` x `ny` x `nz` node grid of spacing `cell` from
// (`x0`, `y0`, `z0`), the Poisson equation for their divergence is solved by
// `iterations` Gauss-Seidel sweeps with zero at the boundary, and the answer
// is the iso value (the mean of the field at the samples) to hand to
// `marching_cubes` with `field`; inside is below it. `scratch` holds four f64
// per node. Simplification: one uniform grid and no screening term.
fn reconstruct_poisson(points: []const f64, normals: []const f64, nx: usize, ny: usize, nz: usize, x0: f64, y0: f64, z0: f64, cell: f64, iterations: usize, field: []f64, scratch: []f64) -> (f64, err) {
    let g = nx * ny * nz
    let n = points.len / 3usize
    if nx < 3usize || ny < 3usize || nz < 3usize || cell <= 0.0f64 || normals.len < points.len || n == 0usize { ret (0.0f64, Invalid) }
    if field.len < g || scratch.len < 4usize * g { ret (0.0f64, TooSmall) }
    let vx = scratch[..g]
    let vy = scratch[g..2usize * g]
    let vz = scratch[2usize * g..3usize * g]
    let rhs = scratch[3usize * g..4usize * g]
    fill(scratch[..4usize * g], 0.0f64)
    fill(field[..g], 0.0f64)
    var s = 0usize
    while s < n {
        let p = point(points, s)
        let normal = point(normals, s)
        let fx = (p.x - x0) / cell
        let fy = (p.y - y0) / cell
        let fz = (p.z - z0) / cell
        if fx >= 0.0f64 && fy >= 0.0f64 && fz >= 0.0f64 && fx < f64(nx - 1usize) && fy < f64(ny - 1usize) && fz < f64(nz - 1usize) {
            let ix = usize(math.floor[f64](fx))
            let iy = usize(math.floor[f64](fy))
            let iz = usize(math.floor[f64](fz))
            let tx = fx - f64(ix)
            let ty = fy - f64(iy)
            let tz = fz - f64(iz)
            var c = 0usize
            while c < 8usize {
                var wx = 1.0f64 - tx
                var wy = 1.0f64 - ty
                var wz = 1.0f64 - tz
                if c % 2usize == 1usize { wx = tx }
                if (c / 2usize) % 2usize == 1usize { wy = ty }
                if c / 4usize == 1usize { wz = tz }
                let node = (ix + c % 2usize) + nx * ((iy + (c / 2usize) % 2usize) + ny * (iz + c / 4usize))
                let weight = wx * wy * wz
                vx[node] += weight * normal.x
                vy[node] += weight * normal.y
                vz[node] += weight * normal.z
                c += 1usize
            }
        }
        s += 1usize
    }
    var k = 1usize
    while k + 1usize < nz {
        var j = 1usize
        while j + 1usize < ny {
            var i = 1usize
            while i + 1usize < nx {
                let node = i + nx * (j + ny * k)
                rhs[node] = (vx[node + 1usize] - vx[node - 1usize] + vy[node + nx] - vy[node - nx] + vz[node + nx * ny] - vz[node - nx * ny]) * 0.5f64 * cell
                i += 1usize
            }
            j += 1usize
        }
        k += 1usize
    }
    var it = 0usize
    while it < iterations {
        k = 1usize
        while k + 1usize < nz {
            var j = 1usize
            while j + 1usize < ny {
                var i = 1usize
                while i + 1usize < nx {
                    let node = i + nx * (j + ny * k)
                    field[node] = (field[node + 1usize] + field[node - 1usize] + field[node + nx] + field[node - nx] + field[node + nx * ny] + field[node - nx * ny] - rhs[node]) / 6.0f64
                    i += 1usize
                }
                j += 1usize
            }
            k += 1usize
        }
        it += 1usize
    }
    var iso = 0.0f64
    var counted = 0usize
    s = 0usize
    while s < n {
        let p = point(points, s)
        let fx = (p.x - x0) / cell + 0.5f64
        let fy = (p.y - y0) / cell + 0.5f64
        let fz = (p.z - z0) / cell + 0.5f64
        if fx >= 0.0f64 && fy >= 0.0f64 && fz >= 0.0f64 && fx < f64(nx) && fy < f64(ny) && fz < f64(nz) {
            iso += field[usize(math.floor[f64](fx)) + nx * (usize(math.floor[f64](fy)) + ny * usize(math.floor[f64](fz)))]
            counted += 1usize
        }
        s += 1usize
    }
    if counted > 0usize { iso /= f64(counted) }
    ret (iso, ok)
}

// ---- booleans --------------------------------------------------------------

// A CSG pool: triangles (nine f64 each) with their planes (four f64 each)
// and list links, and BSP nodes (a plane, two children, a polygon list).
fn csg(tri: []f64, plane: []f64, link: []u32, node_plane: []f64, node_front: []u32, node_back: []u32, node_polys: []u32) -> Csg {
    ret Csg { tri: tri, plane: plane, link: link, tri_count: 0usize, node_plane: node_plane, node_front: node_front, node_back: node_back, node_polys: node_polys, node_count: 0usize }
}

// Appends a triangle; NONE for a degenerate one.
fn csg_triangle(c: *Csg, a: g3.Vec3, b: g3.Vec3, d: g3.Vec3) -> (u32, err) {
    let normal = g3.cross(g3.sub(b, a), g3.sub(d, a))
    let nn = g3.dot(normal, normal)
    if nn < 1.0e-24f64 { ret (NONE, ok) }
    let t = c.tri_count
    if 9usize * t + 9usize > c.tri.len || 4usize * t + 4usize > c.plane.len || t >= c.link.len { ret (NONE, TooSmall) }
    put(c.tri, 3usize * t, a)
    put(c.tri, 3usize * t + 1usize, b)
    put(c.tri, 3usize * t + 2usize, d)
    let unit = g3.scale(normal, 1.0f64 / math.sqrt[f64](nn))
    c.plane[4usize * t] = unit.x
    c.plane[4usize * t + 1usize] = unit.y
    c.plane[4usize * t + 2usize] = unit.z
    c.plane[4usize * t + 3usize] = g3.dot(unit, a)
    c.link[t] = NONE
    c.tri_count = t + 1usize
    ret (u32(t), ok)
}

fn csg_node(c: *Csg) -> (u32, err) {
    let n = c.node_count
    if 4usize * n + 4usize > c.node_plane.len || n >= c.node_front.len || n >= c.node_back.len || n >= c.node_polys.len { ret (NONE, TooSmall) }
    c.node_plane[4usize * n] = 0.0f64
    c.node_plane[4usize * n + 1usize] = 0.0f64
    c.node_plane[4usize * n + 2usize] = 0.0f64
    c.node_plane[4usize * n + 3usize] = 0.0f64
    c.node_front[n] = NONE
    c.node_back[n] = NONE
    c.node_polys[n] = NONE
    c.node_count = n + 1usize
    ret (u32(n), ok)
}

fn csg_push(c: *Csg, head: *u32, t: u32) {
    c.link[usize(t)] = *head
    *head = t
}

fn csg_concat(c: *Csg, a: u32, b: u32) -> u32 {
    if a == NONE { ret b }
    var tail = a
    while c.link[usize(tail)] != NONE { tail = c.link[usize(tail)] }
    c.link[usize(tail)] = b
    ret a
}

fn csg_has_plane(c: *Csg, node: u32) -> bool {
    let o = 4usize * usize(node)
    ret c.node_plane[o] != 0.0f64 || c.node_plane[o + 1usize] != 0.0f64 || c.node_plane[o + 2usize] != 0.0f64
}

// Splits triangle `t` by the plane of `node` into the four lists (csg.js
// splitPolygon): coplanar front, coplanar back, front, back.
fn csg_split(c: *Csg, node: u32, t: u32, coplanar_front: *u32, coplanar_back: *u32, front: *u32, back: *u32) -> err {
    let o = 4usize * usize(node)
    let normal = g3.vec3(c.node_plane[o], c.node_plane[o + 1usize], c.node_plane[o + 2usize])
    let w = c.node_plane[o + 3usize]
    var kinds: [3]usize = zero
    var all = 0usize
    var k = 0usize
    while k < 3usize {
        let d = g3.dot(normal, point(c.tri, 3usize * usize(t) + k)) - w
        if d < 0.0f64 - csg_epsilon() { kinds[k] = 2usize } else if d > csg_epsilon() { kinds[k] = 1usize } else { kinds[k] = 0usize }
        all |= kinds[k]
        k += 1usize
    }
    if all == 0usize {
        let tn = g3.vec3(c.plane[4usize * usize(t)], c.plane[4usize * usize(t) + 1usize], c.plane[4usize * usize(t) + 2usize])
        if g3.dot(normal, tn) > 0.0f64 { csg_push(c, coplanar_front, t) } else { csg_push(c, coplanar_back, t) }
        ret ok
    }
    if all == 1usize {
        csg_push(c, front, t)
        ret ok
    }
    if all == 2usize {
        csg_push(c, back, t)
        ret ok
    }
    var fs: [4]g3.Vec3 = zero
    var bs: [4]g3.Vec3 = zero
    var fc = 0usize
    var bc = 0usize
    k = 0usize
    while k < 3usize {
        let j = (k + 1usize) % 3usize
        let vi = point(c.tri, 3usize * usize(t) + k)
        let vj = point(c.tri, 3usize * usize(t) + j)
        if kinds[k] != 2usize {
            fs[fc] = vi
            fc += 1usize
        }
        if kinds[k] != 1usize {
            bs[bc] = vi
            bc += 1usize
        }
        if (kinds[k] | kinds[j]) == 3usize {
            let s = (w - g3.dot(normal, vi)) / g3.dot(normal, g3.sub(vj, vi))
            let v = g3.add(vi, g3.scale(g3.sub(vj, vi), s))
            fs[fc] = v
            fc += 1usize
            bs[bc] = v
            bc += 1usize
        }
        k += 1usize
    }
    var piece = 1usize
    while piece + 1usize < fc {
        let (id, e) = csg_triangle(c, fs[0usize], fs[piece], fs[piece + 1usize])
        if e != ok { ret e }
        if id != NONE { csg_push(c, front, id) }
        piece += 1usize
    }
    piece = 1usize
    while piece + 1usize < bc {
        let (id, e) = csg_triangle(c, bs[0usize], bs[piece], bs[piece + 1usize])
        if e != ok { ret e }
        if id != NONE { csg_push(c, back, id) }
        piece += 1usize
    }
    ret ok
}

fn csg_build(c: *Csg, node: u32, list: u32) -> err {
    if list == NONE { ret ok }
    if !csg_has_plane(c, node) {
        var k = 0usize
        while k < 4usize {
            c.node_plane[4usize * usize(node) + k] = c.plane[4usize * usize(list) + k]
            k += 1usize
        }
    }
    var front = NONE
    var back = NONE
    var t = list
    while t != NONE {
        let following = c.link[usize(t)]
        let e = csg_split(c, node, t, &c.node_polys[usize(node)], &c.node_polys[usize(node)], &front, &back)
        if e != ok { ret e }
        t = following
    }
    if front != NONE {
        if c.node_front[usize(node)] == NONE {
            let (child, e) = csg_node(c)
            if e != ok { ret e }
            c.node_front[usize(node)] = child
        }
        let e = csg_build(c, c.node_front[usize(node)], front)
        if e != ok { ret e }
    }
    if back != NONE {
        if c.node_back[usize(node)] == NONE {
            let (child, e) = csg_node(c)
            if e != ok { ret e }
            c.node_back[usize(node)] = child
        }
        let e = csg_build(c, c.node_back[usize(node)], back)
        if e != ok { ret e }
    }
    ret ok
}

fn csg_invert(c: *Csg, node: u32) {
    var t = c.node_polys[usize(node)]
    while t != NONE {
        let b = point(c.tri, 3usize * usize(t) + 1usize)
        put(c.tri, 3usize * usize(t) + 1usize, point(c.tri, 3usize * usize(t) + 2usize))
        put(c.tri, 3usize * usize(t) + 2usize, b)
        var k = 0usize
        while k < 4usize {
            c.plane[4usize * usize(t) + k] = 0.0f64 - c.plane[4usize * usize(t) + k]
            k += 1usize
        }
        t = c.link[usize(t)]
    }
    var k = 0usize
    while k < 4usize {
        c.node_plane[4usize * usize(node) + k] = 0.0f64 - c.node_plane[4usize * usize(node) + k]
        k += 1usize
    }
    let front = c.node_front[usize(node)]
    c.node_front[usize(node)] = c.node_back[usize(node)]
    c.node_back[usize(node)] = front
    if c.node_front[usize(node)] != NONE { csg_invert(c, c.node_front[usize(node)]) }
    if c.node_back[usize(node)] != NONE { csg_invert(c, c.node_back[usize(node)]) }
}

// The polygons of `list` that lie outside the solid of `node`'s tree.
fn csg_clip_polygons(c: *Csg, node: u32, list: u32) -> (u32, err) {
    if !csg_has_plane(c, node) { ret (list, ok) }
    var front = NONE
    var back = NONE
    var t = list
    while t != NONE {
        let following = c.link[usize(t)]
        let e = csg_split(c, node, t, &front, &back, &front, &back)
        if e != ok { ret (NONE, e) }
        t = following
    }
    if c.node_front[usize(node)] != NONE {
        let (kept, e) = csg_clip_polygons(c, c.node_front[usize(node)], front)
        if e != ok { ret (NONE, e) }
        front = kept
    }
    if c.node_back[usize(node)] != NONE {
        let (kept, e) = csg_clip_polygons(c, c.node_back[usize(node)], back)
        if e != ok { ret (NONE, e) }
        back = kept
    } else {
        back = NONE
    }
    ret (csg_concat(c, front, back), ok)
}

fn csg_clip_to(c: *Csg, node: u32, other: u32) -> err {
    let (kept, e) = csg_clip_polygons(c, other, c.node_polys[usize(node)])
    if e != ok { ret e }
    c.node_polys[usize(node)] = kept
    if c.node_front[usize(node)] != NONE {
        let e1 = csg_clip_to(c, c.node_front[usize(node)], other)
        if e1 != ok { ret e1 }
    }
    if c.node_back[usize(node)] != NONE {
        let e2 = csg_clip_to(c, c.node_back[usize(node)], other)
        if e2 != ok { ret e2 }
    }
    ret ok
}

// Moves every polygon of the tree at `node` onto `list` (the nodes keep
// dangling heads, which the caller discards).
fn csg_all_polygons(c: *Csg, node: u32, list: *u32) {
    var t = c.node_polys[usize(node)]
    while t != NONE {
        let following = c.link[usize(t)]
        csg_push(c, list, t)
        t = following
    }
    if c.node_front[usize(node)] != NONE { csg_all_polygons(c, c.node_front[usize(node)], list) }
    if c.node_back[usize(node)] != NONE { csg_all_polygons(c, c.node_back[usize(node)], list) }
}

fn csg_load(c: *Csg, vertices: []const f64, triangles: []const u32) -> (u32, err) {
    var list = NONE
    var f = 0usize
    while f * 3usize + 3usize <= triangles.len {
        let (id, e) = csg_triangle(c, point(vertices, usize(triangles[3usize * f])), point(vertices, usize(triangles[3usize * f + 1usize])), point(vertices, usize(triangles[3usize * f + 2usize])))
        if e != ok { ret (NONE, e) }
        if id != NONE { csg_push(c, &list, id) }
        f += 1usize
    }
    ret (list, ok)
}

// The union, intersection or difference of two closed meshes by BSP clipping
// (csg.js); the pool is reset first. Answers the result as a triangle soup
// (nine values per triangle) in `out` and its triangle count.
fn boolean_bsp(c: *Csg, a_vertices: []const f64, a_triangles: []const u32, b_vertices: []const f64, b_triangles: []const u32, op: BooleanOp, out: []f64) -> (usize, err) {
    c.tri_count = 0usize
    c.node_count = 0usize
    let (la, la_error) = csg_load(c, a_vertices, a_triangles)
    if la_error != ok { ret (0usize, la_error) }
    let (lb, lb_error) = csg_load(c, b_vertices, b_triangles)
    if lb_error != ok { ret (0usize, lb_error) }
    let (a, a_error) = csg_node(c)
    if a_error != ok { ret (0usize, a_error) }
    let (b, b_error) = csg_node(c)
    if b_error != ok { ret (0usize, b_error) }
    let build_a = csg_build(c, a, la)
    if build_a != ok { ret (0usize, build_a) }
    let build_b = csg_build(c, b, lb)
    if build_b != ok { ret (0usize, build_b) }
    if op == .Union {
        let e1 = csg_clip_to(c, a, b)
        if e1 != ok { ret (0usize, e1) }
        let e2 = csg_clip_to(c, b, a)
        if e2 != ok { ret (0usize, e2) }
        csg_invert(c, b)
        let e3 = csg_clip_to(c, b, a)
        if e3 != ok { ret (0usize, e3) }
        csg_invert(c, b)
    } else if op == .Difference {
        csg_invert(c, a)
        let e1 = csg_clip_to(c, a, b)
        if e1 != ok { ret (0usize, e1) }
        let e2 = csg_clip_to(c, b, a)
        if e2 != ok { ret (0usize, e2) }
        csg_invert(c, b)
        let e3 = csg_clip_to(c, b, a)
        if e3 != ok { ret (0usize, e3) }
        csg_invert(c, b)
    } else {
        csg_invert(c, a)
        let e1 = csg_clip_to(c, b, a)
        if e1 != ok { ret (0usize, e1) }
        csg_invert(c, b)
        let e2 = csg_clip_to(c, a, b)
        if e2 != ok { ret (0usize, e2) }
        let e3 = csg_clip_to(c, b, a)
        if e3 != ok { ret (0usize, e3) }
    }
    var from_b = NONE
    csg_all_polygons(c, b, &from_b)
    let merged = csg_build(c, a, from_b)
    if merged != ok { ret (0usize, merged) }
    if op != .Union { csg_invert(c, a) }
    var result = NONE
    csg_all_polygons(c, a, &result)
    var count = 0usize
    var t = result
    while t != NONE {
        if 9usize * count + 9usize > out.len { ret (count, TooSmall) }
        var k = 0usize
        while k < 9usize {
            out[9usize * count + k] = c.tri[9usize * usize(t) + k]
            k += 1usize
        }
        count += 1usize
        t = c.link[usize(t)]
    }
    ret (count, ok)
}

// ---- sweeps ----------------------------------------------------------------

// Revolves a profile of (radius, height) pairs about the y axis in `segments`
// steps: vertex `p * segments + s` is profile point `p` at angle `s`, and each
// profile step gives two triangles per segment, wound outward when the
// profile rises with positive radius. Answers (vertex count, triangle count).
fn revolve(profile: []const f64, segments: usize, out_vertices: []f64, out_triangles: []u32) -> (usize, usize, err) {
    let m = profile.len / 2usize
    if m < 2usize || segments < 3usize { ret (0usize, 0usize, Invalid) }
    if out_vertices.len < 3usize * m * segments || out_triangles.len < 6usize * (m - 1usize) * segments { ret (0usize, 0usize, TooSmall) }
    var p = 0usize
    while p < m {
        var s = 0usize
        while s < segments {
            let angle = 6.283185307179586f64 * f64(s) / f64(segments)
            put(out_vertices, p * segments + s, g3.vec3(profile[2usize * p] * math.cos[f64](angle), profile[2usize * p + 1usize], profile[2usize * p] * math.sin[f64](angle)))
            s += 1usize
        }
        p += 1usize
    }
    var count = 0usize
    p = 0usize
    while p + 1usize < m {
        var s = 0usize
        while s < segments {
            let s1 = (s + 1usize) % segments
            let a = u32(p * segments + s)
            let b = u32((p + 1usize) * segments + s)
            let c = u32((p + 1usize) * segments + s1)
            let d = u32(p * segments + s1)
            out_triangles[3usize * count] = a
            out_triangles[3usize * count + 1usize] = b
            out_triangles[3usize * count + 2usize] = c
            out_triangles[3usize * count + 3usize] = a
            out_triangles[3usize * count + 4usize] = c
            out_triangles[3usize * count + 5usize] = d
            count += 2usize
            s += 1usize
        }
        p += 1usize
    }
    ret (m * segments, count, ok)
}
