// Triangle meshes over caller arrays: `vertices` are xyz triples (`[]f64`)
// and `triangles` index triples (`[]u32`), counter-clockwise seen from
// outside; a quad mesh is index quadruples. Nothing here allocates: every
// structure and every result lives in storage the caller hands over, and a
// result that does not fit answers `TooSmall` with nothing promised about
// what was written.
//
// `half_edge` builds the half-edge structure of any polygon mesh, and the
// subdivisions (`subdivide_loop`, `subdivide_catmull_clark`) build one in
// their scratch. `vertex_normals` are area weighted; `estimate_normals` fits
// a plane through the nearest neighbours of a point cloud. `smooth_laplacian`
// and `smooth_taubin` use umbrella weights, `decimate` collapses edges by
// quadric error. `marching_squares` and `marching_cubes` contour scalar
// grids (inside is `field < iso`; the cube table is generated by walking
// the faces, so two diagonal inside corners are never joined), and
// `dual_contouring` places one vertex per cell from Hermite data of a caller
// signed-distance function. `signed_distance` signs by the pseudo-normal of
// the closest feature. `geodesic_fast_marching` and `geodesic_heat` measure
// distance over the surface, `parameterize_lscm` flattens it, and
// `reconstruct_ball_pivot` / `reconstruct_poisson` build meshes from oriented
// point clouds. `boolean_bsp` is csg.js over a caller polygon pool, and
// `revolve` sweeps a profile.

use e.algo.geom3 as g3
use e.algo.sort
use e.math

type HalfEdge = struct { vertex: []u32, twin: []u32, next: []u32, face: []u32, count: usize, sides: usize }
type BooleanOp = enum u8 { Union, Intersection, Difference }
type Csg = struct { tri: []f64, plane: []f64, link: []u32, tri_count: usize, node_plane: []f64, node_front: []u32, node_back: []u32, node_polys: []u32, node_count: usize }
type Operator = struct { triangles: []const u32, cot: []const f64, mass: []const f64, t: f64, kind: usize, pin_a: usize, pin_b: usize }
error TooSmall
error Invalid

const NONE: u32 = 4294967295u32
const OP_HEAT: usize = 0usize
const OP_POISSON: usize = 1usize
const OP_LSCM: usize = 2usize

fn infinity() -> f64 { ret 1.0e300f64 }
fn csg_epsilon() -> f64 { ret 0.00001f64 }
fn point(v: []const f64, i: usize) -> g3.Vec3 { ret g3.vec3(v[3usize * i], v[3usize * i + 1usize], v[3usize * i + 2usize]) }

fn put(v: []f64, i: usize, p: g3.Vec3) {
    v[3usize * i] = p.x
    v[3usize * i + 1usize] = p.y
    v[3usize * i + 2usize] = p.z
}

fn add_to(v: []f64, i: usize, p: g3.Vec3) {
    v[3usize * i] += p.x
    v[3usize * i + 1usize] += p.y
    v[3usize * i + 2usize] += p.z
}

fn fill(v: []f64, x: f64) {
    var i = 0usize
    while i < v.len {
        v[i] = x
        i += 1usize
    }
}

fn fill_u32(v: []u32, x: u32) {
    var i = 0usize
    while i < v.len {
        v[i] = x
        i += 1usize
    }
}

// Twice the signed area vector of a triangle.
fn face_normal(vertices: []const f64, triangles: []const u32, f: usize) -> g3.Vec3 {
    let a = point(vertices, usize(triangles[3usize * f]))
    let b = point(vertices, usize(triangles[3usize * f + 1usize]))
    let c = point(vertices, usize(triangles[3usize * f + 2usize]))
    ret g3.cross(g3.sub(b, a), g3.sub(c, a))
}

// Signed volume enclosed by a closed mesh (positive when faces wind outward).
fn volume(vertices: []const f64, triangles: []const u32) -> f64 {
    var sum = 0.0f64
    var f = 0usize
    while f * 3usize + 3usize <= triangles.len {
        let a = point(vertices, usize(triangles[3usize * f]))
        let b = point(vertices, usize(triangles[3usize * f + 1usize]))
        let c = point(vertices, usize(triangles[3usize * f + 2usize]))
        sum += g3.dot(a, g3.cross(b, c))
        f += 1usize
    }
    ret sum / 6.0f64
}

// Signed volume of a triangle soup (nine values per triangle).
fn soup_volume(soup: []const f64) -> f64 {
    var sum = 0.0f64
    var f = 0usize
    while f * 9usize + 9usize <= soup.len {
        let a = point(soup, 3usize * f)
        let b = point(soup, 3usize * f + 1usize)
        let c = point(soup, 3usize * f + 2usize)
        sum += g3.dot(a, g3.cross(b, c))
        f += 1usize
    }
    ret sum / 6.0f64
}

// ---- half edges ------------------------------------------------------------

// Half-edge structure of `faces` (index tuples of `sides` corners): half-edge
// `h` leaves `vertex[h]`, `next[h]` follows it around `face[h]`, and `twin[h]`
// is the opposite half-edge or NONE on a boundary. Every array holds one entry
// per half-edge (`faces.len`); `scratch` is sorted to pair the twins.
fn half_edge(faces: []const u32, sides: usize, vertex: []u32, twin: []u32, next_he: []u32, face: []u32, scratch: []u32) -> (HalfEdge, err) {
    let count = faces.len
    if sides < 3usize || count % sides != 0usize { ret (zero, Invalid) }
    if vertex.len < count || twin.len < count || next_he.len < count || face.len < count || scratch.len < count { ret (zero, TooSmall) }
    var h = 0usize
    while h < count {
        let f = h / sides
        let k = h % sides
        vertex[h] = faces[h]
        next_he[h] = u32(f * sides + (k + 1usize) % sides)
        face[h] = u32(f)
        twin[h] = NONE
        scratch[h] = u32(h)
        h += 1usize
    }
    var he = HalfEdge { vertex: vertex[..count], twin: twin[..count], next: next_he[..count], face: face[..count], count: count, sides: sides }
    sort.in_place_by[u32, HalfEdge](scratch[..count], &he, edge_order)
    var i = 0usize
    while i + 1usize < count {
        let p = usize(scratch[i])
        let q = usize(scratch[i + 1usize])
        if edge_key(&he, p) == edge_key(&he, q) && he.vertex[p] != he.vertex[q] {
            he.twin[p] = u32(q)
            he.twin[q] = u32(p)
            i += 2usize
        } else {
            i += 1usize
        }
    }
    ret (he, ok)
}

fn edge_key(h: *HalfEdge, e: usize) -> u64 {
    let a = h.vertex[e]
    let b = h.vertex[usize(h.next[e])]
    if a < b { ret (u64(a) << 32u32) | u64(b) }
    ret (u64(b) << 32u32) | u64(a)
}

fn edge_order(h: *HalfEdge, a: u32, b: u32) -> i32 {
    let ka = edge_key(h, usize(a))
    let kb = edge_key(h, usize(b))
    if ka < kb { ret 0i32 - 1i32 }
    if ka > kb { ret 1i32 }
    ret 0i32
}

// Whether every half-edge has a twin (a closed manifold surface).
fn is_closed(h: *HalfEdge) -> bool {
    var i = 0usize
    while i < h.count {
        if h.twin[i] == NONE { ret false }
        i += 1usize
    }
    ret true
}

// Numbers the undirected edges: `ids[h]` is `base` + the edge's index, the
// same for a half-edge and its twin; answers the edge count.
fn number_edges(h: *HalfEdge, base: usize, ids: []u32) -> usize {
    var edges = 0usize
    var i = 0usize
    while i < h.count {
        let t = h.twin[i]
        if t == NONE || usize(t) > i {
            ids[i] = u32(base + edges)
            edges += 1usize
        } else {
            ids[i] = ids[usize(t)]
        }
        i += 1usize
    }
    ret edges
}

// ---- normals ---------------------------------------------------------------

// Area-weighted unit vertex normals (one xyz triple per vertex).
fn vertex_normals(vertices: []const f64, triangles: []const u32, normals: []f64) -> err {
    if triangles.len % 3usize != 0usize { ret Invalid }
    if normals.len < vertices.len { ret TooSmall }
    fill(normals[..vertices.len], 0.0f64)
    var f = 0usize
    while f * 3usize < triangles.len {
        let n = face_normal(vertices, triangles, f)
        add_to(normals, usize(triangles[3usize * f]), n)
        add_to(normals, usize(triangles[3usize * f + 1usize]), n)
        add_to(normals, usize(triangles[3usize * f + 2usize]), n)
        f += 1usize
    }
    var i = 0usize
    while i * 3usize < vertices.len {
        put(normals, i, g3.normalize(point(normals, i)))
        i += 1usize
    }
    ret ok
}

// PCA normals of a point cloud: the plane through the `k` nearest neighbours
// of each point (and the point itself), oriented away from the centroid of
// the cloud. `near` and `near_d` hold `k` entries of scratch.
// ponytail: brute-force neighbours, O(n^2 k); a k-d tree when clouds grow.
fn estimate_normals(points: []const f64, k: usize, normals: []f64, near: []u32, near_d: []f64) -> err {
    let n = points.len / 3usize
    if k == 0usize || k >= n { ret Invalid }
    if normals.len < points.len || near.len < k || near_d.len < k { ret TooSmall }
    var centroid = g3.vec3(0.0f64, 0.0f64, 0.0f64)
    var i = 0usize
    while i < n {
        centroid = g3.add(centroid, point(points, i))
        i += 1usize
    }
    centroid = g3.scale(centroid, 1.0f64 / f64(n))
    i = 0usize
    while i < n {
        let p = point(points, i)
        var found = 0usize
        var j = 0usize
        while j < n {
            if j != i {
                let d = g3.sub(point(points, j), p)
                let dd = g3.dot(d, d)
                var slot = found
                while slot > 0usize && near_d[slot - 1usize] > dd {
                    if slot < k {
                        near_d[slot] = near_d[slot - 1usize]
                        near[slot] = near[slot - 1usize]
                    }
                    slot -= 1usize
                }
                if slot < k {
                    near_d[slot] = dd
                    near[slot] = u32(j)
                    if found < k { found += 1usize }
                }
            }
            j += 1usize
        }
        var mean = p
        j = 0usize
        while j < found {
            mean = g3.add(mean, point(points, usize(near[j])))
            j += 1usize
        }
        mean = g3.scale(mean, 1.0f64 / f64(found + 1usize))
        var m: [9]f64 = zero
        j = 0usize
        while j <= found {
            var q = p
            if j < found { q = point(points, usize(near[j])) }
            let d = g3.sub(q, mean)
            m[0usize] += d.x * d.x
            m[1usize] += d.x * d.y
            m[2usize] += d.x * d.z
            m[4usize] += d.y * d.y
            m[5usize] += d.y * d.z
            m[8usize] += d.z * d.z
            j += 1usize
        }
        m[3usize] = m[1usize]
        m[6usize] = m[2usize]
        m[7usize] = m[5usize]
        var normal = smallest_eigenvector(m[..])
        if g3.dot(normal, g3.sub(p, centroid)) < 0.0f64 { normal = g3.scale(normal, 0.0f64 - 1.0f64) }
        put(normals, i, normal)
        i += 1usize
    }
    ret ok
}

// The unit eigenvector of the least eigenvalue of the symmetric 3x3 `m`
// (row-major, destroyed) by Jacobi rotations.
fn smallest_eigenvector(m: []f64) -> g3.Vec3 {
    var v: [9]f64 = zero
    v[0usize] = 1.0f64
    v[4usize] = 1.0f64
    v[8usize] = 1.0f64
    var sweep = 0usize
    while sweep < 50usize {
        var p = 0usize
        var q = 1usize
        var best = math.abs[f64](m[1usize])
        if math.abs[f64](m[2usize]) > best {
            p = 0usize
            q = 2usize
            best = math.abs[f64](m[2usize])
        }
        if math.abs[f64](m[5usize]) > best {
            p = 1usize
            q = 2usize
            best = math.abs[f64](m[5usize])
        }
        if best < 1.0e-18f64 { break }
        let apq = m[p * 3usize + q]
        let theta = (m[q * 3usize + q] - m[p * 3usize + p]) / (2.0f64 * apq)
        var t = 1.0f64 / (math.abs[f64](theta) + math.sqrt[f64](theta * theta + 1.0f64))
        if theta < 0.0f64 { t = 0.0f64 - t }
        let c = 1.0f64 / math.sqrt[f64](t * t + 1.0f64)
        let s = t * c
        var k = 0usize
        while k < 3usize {
            let akp = m[k * 3usize + p]
            let akq = m[k * 3usize + q]
            m[k * 3usize + p] = c * akp - s * akq
            m[k * 3usize + q] = s * akp + c * akq
            k += 1usize
        }
        k = 0usize
        while k < 3usize {
            let apk = m[p * 3usize + k]
            let aqk = m[q * 3usize + k]
            m[p * 3usize + k] = c * apk - s * aqk
            m[q * 3usize + k] = s * apk + c * aqk
            k += 1usize
        }
        k = 0usize
        while k < 3usize {
            let vkp = v[k * 3usize + p]
            let vkq = v[k * 3usize + q]
            v[k * 3usize + p] = c * vkp - s * vkq
            v[k * 3usize + q] = s * vkp + c * vkq
            k += 1usize
        }
        sweep += 1usize
    }
    var column = 0usize
    if m[4usize] < m[column * 3usize + column] { column = 1usize }
    if m[8usize] < m[column * 3usize + column] { column = 2usize }
    ret g3.normalize(g3.vec3(v[column], v[3usize + column], v[6usize + column]))
}

// ---- smoothing -------------------------------------------------------------

// One umbrella step: every vertex moves by `factor` of the way to the mean of
// its neighbours (a neighbour counts once per triangle sharing the edge).
fn laplacian_step(vertices: []f64, triangles: []const u32, factor: f64, scratch: []f64) -> err {
    let n = vertices.len / 3usize
    if triangles.len % 3usize != 0usize { ret Invalid }
    if scratch.len < 4usize * n { ret TooSmall }
    let sum = scratch[..3usize * n]
    let count = scratch[3usize * n..4usize * n]
    fill(sum, 0.0f64)
    fill(count, 0.0f64)
    var h = 0usize
    while h < triangles.len {
        let a = usize(triangles[h])
        let b = usize(triangles[h - h % 3usize + (h + 1usize) % 3usize])
        add_to(sum, a, point(vertices, b))
        add_to(sum, b, point(vertices, a))
        count[a] += 1.0f64
        count[b] += 1.0f64
        h += 1usize
    }
    var i = 0usize
    while i < n {
        if count[i] > 0.0f64 {
            let p = point(vertices, i)
            let mean = g3.scale(point(sum, i), 1.0f64 / count[i])
            put(vertices, i, g3.add(p, g3.scale(g3.sub(mean, p), factor)))
        }
        i += 1usize
    }
    ret ok
}

// Laplacian smoothing: `iterations` umbrella steps of size `lambda` in place;
// `scratch` holds four f64 per vertex.
fn smooth_laplacian(vertices: []f64, triangles: []const u32, lambda: f64, iterations: usize, scratch: []f64) -> err {
    var it = 0usize
    while it < iterations {
        let e = laplacian_step(vertices, triangles, lambda, scratch)
        if e != ok { ret e }
        it += 1usize
    }
    ret ok
}

// Taubin smoothing: each iteration is a `lambda` step followed by a `mu` step
// (`mu` negative, below `-lambda`) so the surface does not shrink.
fn smooth_taubin(vertices: []f64, triangles: []const u32, lambda: f64, mu: f64, iterations: usize, scratch: []f64) -> err {
    var it = 0usize
    while it < iterations {
        let e = laplacian_step(vertices, triangles, lambda, scratch)
        if e != ok { ret e }
        let e2 = laplacian_step(vertices, triangles, mu, scratch)
        if e2 != ok { ret e2 }
        it += 1usize
    }
    ret ok
}

// ---- subdivision -----------------------------------------------------------

// Marks the boundary vertices (bit 31 of `valence`) and replaces the sum of
// each boundary vertex's neighbours by the sum of its two boundary neighbours.
fn boundary_rule(h: *HalfEdge, vertices: []const f64, acc: []f64, valence: []u32) {
    var i = 0usize
    while i < h.count {
        if h.twin[i] == NONE {
            valence[usize(h.vertex[i])] |= 2147483648u32
            valence[usize(h.vertex[usize(h.next[i])])] |= 2147483648u32
        }
        i += 1usize
    }
    i = 0usize
    while i < valence.len {
        if valence[i] >= 2147483648u32 { put(acc, i, g3.vec3(0.0f64, 0.0f64, 0.0f64)) }
        i += 1usize
    }
    i = 0usize
    while i < h.count {
        if h.twin[i] == NONE {
            let a = usize(h.vertex[i])
            let b = usize(h.vertex[usize(h.next[i])])
            add_to(acc, a, point(vertices, b))
            add_to(acc, b, point(vertices, a))
        }
        i += 1usize
    }
}

// Loop subdivision; answers (vertex count, triangle count). `scratch` holds
// 18 u32 per input triangle plus one per input vertex; the outputs hold the
// old vertices first, then one per edge, and four triangles per input one.
fn subdivide_loop(vertices: []const f64, triangles: []const u32, out_vertices: []f64, out_triangles: []u32, scratch: []u32) -> (usize, usize, err) {
    let n = vertices.len / 3usize
    let hc = triangles.len
    if hc % 3usize != 0usize { ret (0usize, 0usize, Invalid) }
    if scratch.len < 6usize * hc + n || out_triangles.len < 4usize * hc { ret (0usize, 0usize, TooSmall) }
    let (built, he_error) = half_edge(triangles, 3usize, scratch[..hc], scratch[hc..2usize * hc], scratch[2usize * hc..3usize * hc], scratch[3usize * hc..4usize * hc], scratch[4usize * hc..5usize * hc])
    if he_error != ok { ret (0usize, 0usize, he_error) }
    var he = built
    let ids = scratch[5usize * hc..6usize * hc]
    let valence = scratch[6usize * hc..6usize * hc + n]
    let edges = number_edges(&he, n, ids)
    if out_vertices.len < 3usize * (n + edges) { ret (0usize, 0usize, TooSmall) }
    fill(out_vertices[..3usize * n], 0.0f64)
    fill_u32(valence, 0u32)
    var i = 0usize
    while i < hc {
        let o = usize(he.vertex[i])
        add_to(out_vertices, o, point(vertices, usize(he.vertex[usize(he.next[i])])))
        valence[o] += 1u32
        i += 1usize
    }
    boundary_rule(&he, vertices, out_vertices, valence)
    i = 0usize
    while i < n {
        let p = point(vertices, i)
        let acc = point(out_vertices, i)
        if valence[i] >= 2147483648u32 {
            put(out_vertices, i, g3.add(g3.scale(p, 0.75f64), g3.scale(acc, 0.125f64)))
        } else if valence[i] == 0u32 {
            put(out_vertices, i, p)
        } else {
            let k = f64(valence[i])
            let inner = 0.375f64 + 0.25f64 * math.cos[f64](6.283185307179586f64 / k)
            let beta = (0.625f64 - inner * inner) / k
            put(out_vertices, i, g3.add(g3.scale(p, 1.0f64 - k * beta), g3.scale(acc, beta)))
        }
        i += 1usize
    }
    i = 0usize
    while i < hc {
        let t = he.twin[i]
        if t == NONE || usize(t) > i {
            let a = point(vertices, usize(he.vertex[i]))
            let b = point(vertices, usize(he.vertex[usize(he.next[i])]))
            if t == NONE {
                put(out_vertices, usize(ids[i]), g3.scale(g3.add(a, b), 0.5f64))
            } else {
                let c = point(vertices, usize(he.vertex[usize(he.next[usize(he.next[i])])]))
                let d = point(vertices, usize(he.vertex[usize(he.next[usize(he.next[usize(t)])])]))
                put(out_vertices, usize(ids[i]), g3.add(g3.scale(g3.add(a, b), 0.375f64), g3.scale(g3.add(c, d), 0.125f64)))
            }
        }
        i += 1usize
    }
    var f = 0usize
    while f * 3usize < hc {
        let v0 = triangles[3usize * f]
        let v1 = triangles[3usize * f + 1usize]
        let v2 = triangles[3usize * f + 2usize]
        let e0 = ids[3usize * f]
        let e1 = ids[3usize * f + 1usize]
        let e2 = ids[3usize * f + 2usize]
        let o = 12usize * f
        out_triangles[o] = v0
        out_triangles[o + 1usize] = e0
        out_triangles[o + 2usize] = e2
        out_triangles[o + 3usize] = v1
        out_triangles[o + 4usize] = e1
        out_triangles[o + 5usize] = e0
        out_triangles[o + 6usize] = v2
        out_triangles[o + 7usize] = e2
        out_triangles[o + 8usize] = e1
        out_triangles[o + 9usize] = e0
        out_triangles[o + 10usize] = e1
        out_triangles[o + 11usize] = e2
        f += 1usize
    }
    ret (n + edges, 4usize * (hc / 3usize), ok)
}

// Catmull-Clark subdivision of a quad mesh (index quadruples) into quads;
// answers (vertex count, quad count). `scratch` holds 24 u32 per input quad
// plus one per vertex; the outputs hold the old vertices, then one per face,
// then one per edge, and four quads per input quad.
fn subdivide_catmull_clark(vertices: []const f64, quads: []const u32, out_vertices: []f64, out_quads: []u32, scratch: []u32) -> (usize, usize, err) {
    let n = vertices.len / 3usize
    let hc = quads.len
    let faces = hc / 4usize
    if hc % 4usize != 0usize { ret (0usize, 0usize, Invalid) }
    if scratch.len < 6usize * hc + n || out_quads.len < 4usize * hc { ret (0usize, 0usize, TooSmall) }
    let (built, he_error) = half_edge(quads, 4usize, scratch[..hc], scratch[hc..2usize * hc], scratch[2usize * hc..3usize * hc], scratch[3usize * hc..4usize * hc], scratch[4usize * hc..5usize * hc])
    if he_error != ok { ret (0usize, 0usize, he_error) }
    var he = built
    let ids = scratch[5usize * hc..6usize * hc]
    let valence = scratch[6usize * hc..6usize * hc + n]
    let edges = number_edges(&he, n + faces, ids)
    if out_vertices.len < 3usize * (n + faces + edges) { ret (0usize, 0usize, TooSmall) }
    var f = 0usize
    while f < faces {
        var centre = g3.vec3(0.0f64, 0.0f64, 0.0f64)
        var k = 0usize
        while k < 4usize {
            centre = g3.add(centre, point(vertices, usize(quads[4usize * f + k])))
            k += 1usize
        }
        put(out_vertices, n + f, g3.scale(centre, 0.25f64))
        f += 1usize
    }
    var i = 0usize
    while i < hc {
        let t = he.twin[i]
        if t == NONE || usize(t) > i {
            let a = point(vertices, usize(he.vertex[i]))
            let b = point(vertices, usize(he.vertex[usize(he.next[i])]))
            if t == NONE {
                put(out_vertices, usize(ids[i]), g3.scale(g3.add(a, b), 0.5f64))
            } else {
                let fa = point(out_vertices, n + usize(he.face[i]))
                let fb = point(out_vertices, n + usize(he.face[usize(t)]))
                put(out_vertices, usize(ids[i]), g3.scale(g3.add(g3.add(a, b), g3.add(fa, fb)), 0.25f64))
            }
        }
        i += 1usize
    }
    // Vertex points: (F + 2R + (k - 3) P) / k, with k (F + 2R) accumulated first.
    fill(out_vertices[..3usize * n], 0.0f64)
    fill_u32(valence, 0u32)
    i = 0usize
    while i < hc {
        let o = usize(he.vertex[i])
        let p = point(vertices, o)
        let q = point(vertices, usize(he.vertex[usize(he.next[i])]))
        add_to(out_vertices, o, point(out_vertices, n + usize(he.face[i])))
        add_to(out_vertices, o, g3.add(p, q))
        valence[o] += 1u32
        i += 1usize
    }
    boundary_rule(&he, vertices, out_vertices, valence)
    i = 0usize
    while i < n {
        let p = point(vertices, i)
        let acc = point(out_vertices, i)
        if valence[i] >= 2147483648u32 {
            put(out_vertices, i, g3.add(g3.scale(p, 0.75f64), g3.scale(acc, 0.125f64)))
        } else if valence[i] == 0u32 {
            put(out_vertices, i, p)
        } else {
            let k = f64(valence[i])
            put(out_vertices, i, g3.scale(g3.add(g3.scale(acc, 1.0f64 / k), g3.scale(p, k - 3.0f64)), 1.0f64 / k))
        }
        i += 1usize
    }
    f = 0usize
    while f < faces {
        let centre_id = u32(n + f)
        var k = 0usize
        while k < 4usize {
            let corner = quads[4usize * f + k]
            let e_out = ids[4usize * f + k]
            let e_in = ids[4usize * f + (k + 3usize) % 4usize]
            let o = 16usize * f + 4usize * k
            out_quads[o] = corner
            out_quads[o + 1usize] = e_out
            out_quads[o + 2usize] = centre_id
            out_quads[o + 3usize] = e_in
            k += 1usize
        }
        f += 1usize
    }
    ret (n + faces + edges, 4usize * faces, ok)
}

// ---- decimation ------------------------------------------------------------

// The point minimising the quadric `q` (10 upper-triangle entries) and its
// error; falls back to the best of `a`, `b` and their midpoint when the
// quadric is flat or its optimum lies further from the midpoint than the
// edge is long.
fn quadric_optimum(q: []const f64, a: g3.Vec3, b: g3.Vec3) -> (g3.Vec3, f64) {
    let det = q[0usize] * (q[4usize] * q[7usize] - q[5usize] * q[5usize]) - q[1usize] * (q[1usize] * q[7usize] - q[5usize] * q[2usize]) + q[2usize] * (q[1usize] * q[5usize] - q[4usize] * q[2usize])
    if math.abs[f64](det) > 1.0e-12f64 {
        let rx = 0.0f64 - q[3usize]
        let ry = 0.0f64 - q[6usize]
        let rz = 0.0f64 - q[8usize]
        let x = (rx * (q[4usize] * q[7usize] - q[5usize] * q[5usize]) - q[1usize] * (ry * q[7usize] - q[5usize] * rz) + q[2usize] * (ry * q[5usize] - q[4usize] * rz)) / det
        let y = (q[0usize] * (ry * q[7usize] - q[5usize] * rz) - rx * (q[1usize] * q[7usize] - q[5usize] * q[2usize]) + q[2usize] * (q[1usize] * rz - ry * q[2usize])) / det
        let z = (q[0usize] * (q[4usize] * rz - ry * q[5usize]) - q[1usize] * (q[1usize] * rz - ry * q[2usize]) + rx * (q[1usize] * q[5usize] - q[4usize] * q[2usize])) / det
        let p = g3.vec3(x, y, z)
        let off = g3.sub(p, g3.scale(g3.add(a, b), 0.5f64))
        let ab = g3.sub(b, a)
        if g3.dot(off, off) <= g3.dot(ab, ab) { ret (p, quadric_error(q, p)) }
    }
    var best = a
    var best_error = quadric_error(q, a)
    let eb = quadric_error(q, b)
    if eb < best_error {
        best = b
        best_error = eb
    }
    let mid = g3.scale(g3.add(a, b), 0.5f64)
    let em = quadric_error(q, mid)
    if em < best_error {
        best = mid
        best_error = em
    }
    ret (best, best_error)
}

fn quadric_error(q: []const f64, p: g3.Vec3) -> f64 {
    ret q[0usize] * p.x * p.x + 2.0f64 * q[1usize] * p.x * p.y + 2.0f64 * q[2usize] * p.x * p.z + 2.0f64 * q[3usize] * p.x + q[4usize] * p.y * p.y + 2.0f64 * q[5usize] * p.y * p.z + 2.0f64 * q[6usize] * p.y + q[7usize] * p.z * p.z + 2.0f64 * q[8usize] * p.z + q[9usize]
}

// Edge-collapse decimation by quadric error (Garland-Heckbert) until at most
// `goal` triangles remain, then compaction; answers (vertex count,
// triangle count) and rewrites both arrays in place. `quadrics` holds ten f64
// per vertex and `scratch` one u32 per vertex.
// ponytail: every collapse rescans all edges, O(T^2), and no fold-over test;
// a cost heap and a normal-flip check when meshes or targets grow.
fn decimate(vertices: []f64, triangles: []u32, goal: usize, quadrics: []f64, scratch: []u32) -> (usize, usize, err) {
    let n = vertices.len / 3usize
    if triangles.len % 3usize != 0usize { ret (0usize, 0usize, Invalid) }
    if quadrics.len < 10usize * n || scratch.len < n { ret (0usize, 0usize, TooSmall) }
    fill(quadrics[..10usize * n], 0.0f64)
    var live = triangles.len / 3usize
    var f = 0usize
    while f < live {
        let normal = g3.normalize(face_normal(vertices, triangles, f))
        let d = 0.0f64 - g3.dot(normal, point(vertices, usize(triangles[3usize * f])))
        var k = 0usize
        while k < 3usize {
            let q = quadrics[10usize * usize(triangles[3usize * f + k])..]
            q[0usize] += normal.x * normal.x
            q[1usize] += normal.x * normal.y
            q[2usize] += normal.x * normal.z
            q[3usize] += normal.x * d
            q[4usize] += normal.y * normal.y
            q[5usize] += normal.y * normal.z
            q[6usize] += normal.y * d
            q[7usize] += normal.z * normal.z
            q[8usize] += normal.z * d
            q[9usize] += d * d
            k += 1usize
        }
        f += 1usize
    }
    var sum: [10]f64 = zero
    while live > goal {
        var best_cost = infinity()
        var best_u = NONE
        var best_v = NONE
        var best_p = g3.vec3(0.0f64, 0.0f64, 0.0f64)
        var h = 0usize
        while h < 3usize * live {
            let u = triangles[h]
            let v = triangles[h - h % 3usize + (h + 1usize) % 3usize]
            if u < v {
                var k = 0usize
                while k < 10usize {
                    sum[k] = quadrics[10usize * usize(u) + k] + quadrics[10usize * usize(v) + k]
                    k += 1usize
                }
                let (p, cost) = quadric_optimum(sum[..], point(vertices, usize(u)), point(vertices, usize(v)))
                if cost < best_cost {
                    best_cost = cost
                    best_u = u
                    best_v = v
                    best_p = p
                }
            }
            h += 1usize
        }
        if best_u == NONE { break }
        put(vertices, usize(best_u), best_p)
        var k = 0usize
        while k < 10usize {
            quadrics[10usize * usize(best_u) + k] += quadrics[10usize * usize(best_v) + k]
            k += 1usize
        }
        f = 0usize
        while f < live {
            var c = 0usize
            while c < 3usize {
                if triangles[3usize * f + c] == best_v { triangles[3usize * f + c] = best_u }
                c += 1usize
            }
            let a = triangles[3usize * f]
            let b = triangles[3usize * f + 1usize]
            let cc = triangles[3usize * f + 2usize]
            if a == b || b == cc || a == cc {
                live -= 1usize
                triangles[3usize * f] = triangles[3usize * live]
                triangles[3usize * f + 1usize] = triangles[3usize * live + 1usize]
                triangles[3usize * f + 2usize] = triangles[3usize * live + 2usize]
            } else {
                f += 1usize
            }
        }
    }
    let remap = scratch[..n]
    fill_u32(remap, NONE)
    var h = 0usize
    while h < 3usize * live {
        remap[usize(triangles[h])] = 0u32
        h += 1usize
    }
    var kept = 0usize
    var v = 0usize
    while v < n {
        if remap[v] != NONE {
            remap[v] = u32(kept)
            put(vertices, kept, point(vertices, v))
            kept += 1usize
        }
        v += 1usize
    }
    h = 0usize
    while h < 3usize * live {
        triangles[h] = remap[usize(triangles[h])]
        h += 1usize
    }
    ret (kept, live, ok)
}

// ---- contouring ------------------------------------------------------------

// Iso-contour of a `width` x `height` grid (row-major, x fastest) at `iso`
// as x0 y0 x1 y1 segments into `out`, inside (`field < iso`) on the right;
// answers the segment count. An ambiguous cell keeps its inside corners apart.
fn marching_squares(field: []const f64, width: usize, height: usize, iso: f64, out: []f64) -> (usize, err) {
    if width < 2usize || height < 2usize || field.len < width * height { ret (0usize, Invalid) }
    var count = 0usize
    var y = 0usize
    while y + 1usize < height {
        var x = 0usize
        while x + 1usize < width {
            var cx: [4]f64 = zero
            var cy: [4]f64 = zero
            var cv: [4]f64 = zero
            cx[0usize] = f64(x)
            cy[0usize] = f64(y)
            cx[1usize] = f64(x + 1usize)
            cy[1usize] = f64(y)
            cx[2usize] = f64(x + 1usize)
            cy[2usize] = f64(y + 1usize)
            cx[3usize] = f64(x)
            cy[3usize] = f64(y + 1usize)
            cv[0usize] = field[y * width + x]
            cv[1usize] = field[y * width + x + 1usize]
            cv[2usize] = field[(y + 1usize) * width + x + 1usize]
            cv[3usize] = field[(y + 1usize) * width + x]
            var ex: [4]f64 = zero
            var ey: [4]f64 = zero
            var kind: [4]u8 = zero
            var crossings = 0usize
            var k = 0usize
            while k < 4usize {
                let j = (k + 1usize) % 4usize
                let ia = cv[k] < iso
                let ib = cv[j] < iso
                if ia != ib {
                    let t = (iso - cv[k]) / (cv[j] - cv[k])
                    ex[crossings] = cx[k] + t * (cx[j] - cx[k])
                    ey[crossings] = cy[k] + t * (cy[j] - cy[k])
                    if ib { kind[crossings] = 1u8 } else { kind[crossings] = 0u8 }
                    crossings += 1usize
                }
                k += 1usize
            }
            k = 0usize
            while k < crossings {
                if kind[k] == 1u8 {
                    let j = (k + 1usize) % crossings
                    if 4usize * count + 4usize > out.len { ret (count, TooSmall) }
                    out[4usize * count] = ex[k]
                    out[4usize * count + 1usize] = ey[k]
                    out[4usize * count + 2usize] = ex[j]
                    out[4usize * count + 3usize] = ey[j]
                    count += 1usize
                }
                k += 1usize
            }
            x += 1usize
        }
        y += 1usize
    }
    ret (count, ok)
}

