// Shell completion scripts and man pages from an `e.cli` command spec, the way clap_complete
// and clap_mangen do for clap: `bash`, `zsh` and `fish` write a script that completes the
// command's options and subcommands (and files after an option that takes a value), and
// `man_page` writes a roff page for one command. Installing either is host policy -- these
// only produce the text.
//
// Names (commands, long options) are limited to letters, digits and `_ . + -`, since they
// are written into shell syntax unquoted; anything else is `Invalid`. Help text is escaped
// per target. A subcommand name that appears at two levels completes at both in fish.
use e.cli
use e.mem
use e.str

error Invalid

// One command of the tree, flattened: its space-joined path from the root and its parent's
// index (the root is its own parent).
type Node = struct { path: str, command: *const cli.Command, parent: usize }

fn valid_name(s: str) -> bool {
    if s.len == 0usize { ret false }
    var i = 0usize
    while i < s.len {
        let c = s[i]
        let ok_char = (c >= 48u8 && c <= 57u8) || (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8) || c == 95u8 || c == 46u8 || c == 43u8 || c == 45u8
        if !ok_char { ret false }
        i += 1usize
    }
    ret true
}

fn count_commands(c: *const cli.Command) -> usize {
    var n = 1usize
    var i = 0usize
    while i < c.subcommands.len {
        n += count_commands(&c.subcommands[i])
        i += 1usize
    }
    ret n
}

fn joined(a: *mem.Arena, prefix: str, name: str) -> (str, err) {
    let (b0, e) = str.builder(a, prefix.len + name.len + 2usize)
    if e != ok { ret ("", e) }
    var b = b0
    try str.push(&b, prefix)
    try str.push_byte(&b, 32u8)
    try str.push(&b, name)
    ret (str.done(&b), ok)
}

// The tree breadth-first: a node's children follow every node of its own level.
fn flatten(a: *mem.Arena, root: *const cli.Command) -> ([]Node, err) {
    let total = count_commands(root)
    let (nodes, ne) = mem.alloc[Node](a, total)
    if ne != ok { ret (zero, ne) }
    if !valid_name(root.name) { ret (zero, Invalid) }
    nodes[0] = Node{ path: root.name, command: root, parent: 0usize }
    var used = 1usize
    var i = 0usize
    while i < used {
        let c = nodes[i].command
        var k = 0usize
        while k < c.subcommands.len {
            let sub = &c.subcommands[k]
            if !valid_name(sub.name) { ret (zero, Invalid) }
            let (p, pe) = joined(a, nodes[i].path, sub.name)
            if pe != ok { ret (zero, pe) }
            nodes[used] = Node{ path: p, command: sub, parent: i }
            used += 1usize
            k += 1usize
        }
        var j = 0usize
        while j < c.options.len {
            if !valid_name(c.options[j].long) { ret (zero, Invalid) }
            j += 1usize
        }
        i += 1usize
    }
    ret (nodes[0usize..used], ok)
}

fn takes_value(o: *const cli.Option) -> bool { ret o.kind != .Bool }

fn push_ident(b: *str.Builder, s: str) -> err {
    var i = 0usize
    while i < s.len {
        let c = s[i]
        let word = (c >= 48u8 && c <= 57u8) || (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8)
        if word { try str.push_byte(b, c) } else { try str.push_byte(b, 95u8) }
        i += 1usize
    }
    ret ok
}

fn push_short(b: *str.Builder, o: *const cli.Option) -> err {
    try str.push_byte(b, 45u8)
    ret str.push_byte(b, o.short)
}

// ---- bash ----------------------------------------------------------------------------

fn bash(a: *mem.Arena, root: *const cli.Command) -> (str, err) {
    let (nodes, fe) = flatten(a, root)
    if fe != ok { ret ("", fe) }
    var cap = 1024usize
    var i = 0usize
    while i < nodes.len {
        cap += nodes[i].path.len * 8usize + 256usize + nodes[i].command.options.len * (nodes[i].path.len * 2usize + 96usize) + nodes[i].command.subcommands.len * 64usize
        i += 1usize
    }
    let (b0, be) = str.builder(a, cap)
    if be != ok { ret ("", be) }
    var b = b0
    try str.push(&b, "# bash completion for ")
    try str.push(&b, root.name)
    try str.push(&b, " (generated by e.cli.complete)\n_")
    try push_ident(&b, root.name)
    try str.push(&b, "() {\n    local cur prev cmd i opts\n    COMPREPLY=()\n    cur=\"${COMP_WORDS[COMP_CWORD]}\"\n    prev=\"\"\n    if [ \"$COMP_CWORD\" -gt 0 ]; then prev=\"${COMP_WORDS[COMP_CWORD-1]}\"; fi\n    cmd=\"")
    try str.push(&b, root.name)
    try str.push(&b, "\"\n    for ((i = 1; i < COMP_CWORD; i++)); do\n        case \"$cmd:${COMP_WORDS[i]}\" in\n")
    i = 1usize
    while i < nodes.len {
        try str.push(&b, "            \"")
        try str.push(&b, nodes[nodes[i].parent].path)
        try str.push_byte(&b, 58u8)
        try str.push(&b, nodes[i].command.name)
        try str.push(&b, "\") cmd=\"")
        try str.push(&b, nodes[i].path)
        try str.push(&b, "\" ;;\n")
        i += 1usize
    }
    try str.push(&b, "        esac\n    done\n    case \"$cmd:$prev\" in\n")
    i = 0usize
    while i < nodes.len {
        let c = nodes[i].command
        var k = 0usize
        while k < c.options.len {
            if takes_value(&c.options[k]) {
                try str.push(&b, "        \"")
                try str.push(&b, nodes[i].path)
                try str.push(&b, ":--")
                try str.push(&b, c.options[k].long)
                try str.push_byte(&b, 34u8)
                if c.options[k].short != 0u8 {
                    try str.push(&b, "|\"")
                    try str.push(&b, nodes[i].path)
                    try str.push_byte(&b, 58u8)
                    try push_short(&b, &c.options[k])
                    try str.push_byte(&b, 34u8)
                }
                try str.push(&b, ")\n            COMPREPLY=($(compgen -f -- \"$cur\"))\n            return 0\n            ;;\n")
            }
            k += 1usize
        }
        i += 1usize
    }
    try str.push(&b, "    esac\n    case \"$cmd\" in\n")
    i = 0usize
    while i < nodes.len {
        let c = nodes[i].command
        try str.push(&b, "        \"")
        try str.push(&b, nodes[i].path)
        try str.push(&b, "\") opts=\"")
        var first = true
        var k = 0usize
        while k < c.options.len {
            if !first { try str.push_byte(&b, 32u8) }
            first = false
            try str.push(&b, "--")
            try str.push(&b, c.options[k].long)
            if c.options[k].short != 0u8 {
                try str.push_byte(&b, 32u8)
                try push_short(&b, &c.options[k])
            }
            k += 1usize
        }
        k = 0usize
        while k < c.subcommands.len {
            if !first { try str.push_byte(&b, 32u8) }
            first = false
            try str.push(&b, c.subcommands[k].name)
            k += 1usize
        }
        try str.push(&b, "\" ;;\n")
        i += 1usize
    }
    try str.push(&b, "    esac\n    COMPREPLY=($(compgen -W \"$opts\" -- \"$cur\"))\n    return 0\n}\ncomplete -F _")
    try push_ident(&b, root.name)
    try str.push(&b, " -o bashdefault -o default ")
    try str.push(&b, root.name)
    try str.push_byte(&b, 10u8)
    ret (str.done(&b), ok)
}

// ---- fish ----------------------------------------------------------------------------

// Single-quoted fish text: `\` and `'` escaped; newlines flattened to spaces.
fn push_fish_text(b: *str.Builder, s: str) -> err {
    var i = 0usize
    while i < s.len {
        let c = s[i]
        if c == 92u8 || c == 39u8 {
            try str.push_byte(b, 92u8)
            try str.push_byte(b, c)
        } else if c == 10u8 {
            try str.push_byte(b, 32u8)
        } else {
            try str.push_byte(b, c)
        }
        i += 1usize
    }
    ret ok
}

// The `-n` condition of a node: root or inside the subcommand path, and not yet inside a
// child.
fn push_fish_condition(b: *str.Builder, nodes: []const Node, i: usize) -> err {
    let c = nodes[i].command
    // the path words after the root, as a chain of `__fish_seen_subcommand_from`
    var chain: [16]usize = zero
    var depth = 0usize
    var at = i
    while at != 0usize && depth < 16usize {
        chain[depth] = at
        depth += 1usize
        at = nodes[at].parent
    }
    var first = true
    var d = depth
    while d > 0usize {
        d -= 1usize
        if !first { try str.push(b, "; and ") }
        first = false
        try str.push(b, "__fish_seen_subcommand_from ")
        try str.push(b, nodes[chain[d]].command.name)
    }
    if c.subcommands.len > 0usize {
        if !first { try str.push(b, "; and ") }
        first = false
        try str.push(b, "not __fish_seen_subcommand_from")
        var k = 0usize
        while k < c.subcommands.len {
            try str.push_byte(b, 32u8)
            try str.push(b, c.subcommands[k].name)
            k += 1usize
        }
    }
    ret ok
}

fn fish(a: *mem.Arena, root: *const cli.Command) -> (str, err) {
    let (nodes, fe) = flatten(a, root)
    if fe != ok { ret ("", fe) }
    var cap = 1024usize
    var i = 0usize
    while i < nodes.len {
        let c = nodes[i].command
        var help_bytes = c.help.len * 2usize
        var k = 0usize
        while k < c.options.len {
            help_bytes += c.options[k].help.len * 2usize + c.options[k].long.len + 96usize
            k += 1usize
        }
        k = 0usize
        while k < c.subcommands.len {
            help_bytes += c.subcommands[k].help.len * 2usize + c.subcommands[k].name.len + 96usize
            k += 1usize
        }
        cap += help_bytes + (c.options.len + c.subcommands.len + 1usize) * (root.name.len + 200usize + c.subcommands.len * 24usize) + nodes[i].path.len * 4usize
        i += 1usize
    }
    let (b0, be) = str.builder(a, cap)
    if be != ok { ret ("", be) }
    var b = b0
    try str.push(&b, "# fish completion for ")
    try str.push(&b, root.name)
    try str.push(&b, " (generated by e.cli.complete)\n")
    i = 0usize
    while i < nodes.len {
        let c = nodes[i].command
        var k = 0usize
        while k < c.options.len {
            let o = &c.options[k]
            try str.push(&b, "complete -c ")
            try str.push(&b, root.name)
            if i > 0usize || c.subcommands.len > 0usize {
                try str.push(&b, " -n \"")
                try push_fish_condition(&b, nodes, i)
                try str.push_byte(&b, 34u8)
            }
            if o.short != 0u8 {
                try str.push(&b, " -s ")
                try str.push_byte(&b, o.short)
            }
            try str.push(&b, " -l ")
            try str.push(&b, o.long)
            if takes_value(o) { try str.push(&b, " -r") }
            if o.help.len > 0usize {
                try str.push(&b, " -d '")
                try push_fish_text(&b, o.help)
                try str.push_byte(&b, 39u8)
            }
            try str.push_byte(&b, 10u8)
            k += 1usize
        }
        k = 0usize
        while k < c.subcommands.len {
            try str.push(&b, "complete -c ")
            try str.push(&b, root.name)
            try str.push(&b, " -n \"")
            try push_fish_condition(&b, nodes, i)
            try str.push(&b, "\" -f -a '")
            try str.push(&b, c.subcommands[k].name)
            try str.push_byte(&b, 39u8)
            if c.subcommands[k].help.len > 0usize {
                try str.push(&b, " -d '")
                try push_fish_text(&b, c.subcommands[k].help)
                try str.push_byte(&b, 39u8)
            }
            try str.push_byte(&b, 10u8)
            k += 1usize
        }
        i += 1usize
    }
    ret (str.done(&b), ok)
}

// ---- zsh -----------------------------------------------------------------------------

// A zsh `_arguments` description: inside `[...]` inside single quotes.
fn push_zsh_text(b: *str.Builder, s: str) -> err {
    var i = 0usize
    while i < s.len {
        let c = s[i]
        if c == 39u8 {
            try str.push(b, "'\\''")
        } else if c == 91u8 || c == 93u8 || c == 92u8 || c == 58u8 {
            try str.push_byte(b, 92u8)
            try str.push_byte(b, c)
        } else if c == 10u8 {
            try str.push_byte(b, 32u8)
        } else {
            try str.push_byte(b, c)
        }
        i += 1usize
    }
    ret ok
}

fn push_zsh_function(b: *str.Builder, nodes: []const Node, i: usize) -> err {
    try str.push_byte(b, 95u8)
    // `_tool_sub_subsub`, from the path
    var j = 0usize
    let p = nodes[i].path
    while j < p.len {
        let c = p[j]
        let word = (c >= 48u8 && c <= 57u8) || (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8)
        if word { try str.push_byte(b, c) } else { try str.push_byte(b, 95u8) }
        j += 1usize
    }
    ret ok
}

fn zsh(a: *mem.Arena, root: *const cli.Command) -> (str, err) {
    let (nodes, fe) = flatten(a, root)
    if fe != ok { ret ("", fe) }
    var cap = 1024usize
    var i = 0usize
    while i < nodes.len {
        let c = nodes[i].command
        var help_bytes = c.help.len * 3usize
        var k = 0usize
        while k < c.options.len {
            help_bytes += c.options[k].help.len * 3usize + c.options[k].long.len * 2usize + 96usize
            k += 1usize
        }
        k = 0usize
        while k < c.subcommands.len {
            help_bytes += c.subcommands[k].help.len * 3usize + c.subcommands[k].name.len * 2usize + 96usize
            k += 1usize
        }
        cap += help_bytes + nodes[i].path.len * 6usize + 512usize
        i += 1usize
    }
    let (b0, be) = str.builder(a, cap)
    if be != ok { ret ("", be) }
    var b = b0
    try str.push(&b, "#compdef ")
    try str.push(&b, root.name)
    try str.push(&b, "\n# zsh completion for ")
    try str.push(&b, root.name)
    try str.push(&b, " (generated by e.cli.complete)\n")
    i = 0usize
    while i < nodes.len {
        let c = nodes[i].command
        try push_zsh_function(&b, nodes, i)
        try str.push(&b, "() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n")
        var k = 0usize
        while k < c.options.len {
            let o = &c.options[k]
            try str.push(&b, "        '")
            if o.short != 0u8 {
                // `(-o --out)` exclusion keeps either spelling from repeating
                if !o.repeated {
                    try str.push(&b, "(-")
                    try str.push_byte(&b, o.short)
                    try str.push(&b, " --")
                    try str.push(&b, o.long)
                    try str.push_byte(&b, 41u8)
                }
                try str.push(&b, "{-")
                try str.push_byte(&b, o.short)
                try str.push(&b, ",--")
                try str.push(&b, o.long)
                try str.push_byte(&b, 125u8)
            } else {
                if !o.repeated {
                    try str.push(&b, "(--")
                    try str.push(&b, o.long)
                    try str.push_byte(&b, 41u8)
                }
                try str.push(&b, "--")
                try str.push(&b, o.long)
            }
            try str.push_byte(&b, 91u8)
            try push_zsh_text(&b, o.help)
            try str.push_byte(&b, 93u8)
            if takes_value(o) { try str.push(&b, ":value:_files") }
            try str.push(&b, "' \\\n")
            k += 1usize
        }
        if c.subcommands.len > 0usize {
            try str.push(&b, "        '1: :->subcommand' \\\n        '*:: :->args' && return 0\n    case $state in\n        subcommand)\n            local -a commands\n            commands=(\n")
            k = 0usize
            while k < c.subcommands.len {
                try str.push(&b, "                '")
                try str.push(&b, c.subcommands[k].name)
                try str.push_byte(&b, 58u8)
                try push_zsh_text(&b, c.subcommands[k].help)
                try str.push(&b, "'\n")
                k += 1usize
            }
            try str.push(&b, "            )\n            _describe -t commands 'command' commands\n            ;;\n        args)\n            case $line[1] in\n")
            // the children of this node are the nodes whose parent is `i`
            var m = 1usize
            while m < nodes.len {
                if nodes[m].parent == i {
                    try str.push(&b, "                ")
                    try str.push(&b, nodes[m].command.name)
                    try str.push(&b, ") ")
                    try push_zsh_function(&b, nodes, m)
                    try str.push(&b, " ;;\n")
                }
                m += 1usize
            }
            try str.push(&b, "            esac\n            ;;\n    esac\n}\n\n")
        } else {
            try str.push(&b, "        '*:: :_files'\n}\n\n")
        }
        i += 1usize
    }
    try push_zsh_function(&b, nodes, 0usize)
    try str.push(&b, " \"$@\"\n")
    ret (str.done(&b), ok)
}

// ---- man page ------------------------------------------------------------------------

// roff text: `\` doubled, `-` as `\-`, a line starting with `.` or `'` guarded by `\&`.
fn push_roff(b: *str.Builder, s: str) -> err {
    var line_start = true
    var i = 0usize
    while i < s.len {
        let c = s[i]
        if line_start && (c == 46u8 || c == 39u8) { try str.push(b, "\\&") }
        line_start = false
        if c == 92u8 {
            try str.push(b, "\\\\")
        } else if c == 45u8 {
            try str.push(b, "\\-")
        } else if c == 10u8 {
            try str.push_byte(b, 10u8)
            line_start = true
        } else {
            try str.push_byte(b, c)
        }
        i += 1usize
    }
    ret ok
}

fn push_upper(b: *str.Builder, s: str) -> err {
    var i = 0usize
    while i < s.len {
        let c = s[i]
        if c >= 97u8 && c <= 122u8 {
            try str.push_byte(b, c - 32u8)
        } else if c == 32u8 {
            try str.push_byte(b, 45u8)
        } else {
            try str.push_byte(b, c)
        }
        i += 1usize
    }
    ret ok
}

// The page for `command`, titled `title` (the root's name, or `tool sub` for a subcommand);
// `section` is the manual section (1), `date` and `version` go in the header and footer.
fn man_page(a: *mem.Arena, command: *const cli.Command, title: str, section: u8, date: str, version: str) -> (str, err) {
    if !valid_name(command.name) || title.len == 0usize { ret ("", Invalid) }
    var cap = 2048usize + title.len * 8usize + command.help.len * 3usize + date.len + version.len
    var i = 0usize
    while i < command.options.len {
        cap += command.options[i].long.len * 4usize + command.options[i].help.len * 3usize + command.options[i].env.len * 2usize + 160usize
        i += 1usize
    }
    i = 0usize
    while i < command.subcommands.len {
        cap += command.subcommands[i].name.len * 2usize + command.subcommands[i].help.len * 3usize + 64usize
        i += 1usize
    }
    let (b0, be) = str.builder(a, cap)
    if be != ok { ret ("", be) }
    var b = b0
    try str.push(&b, ".TH ")
    try push_upper(&b, title)
    try str.push_byte(&b, 32u8)
    try str.push_byte(&b, section)
    try str.push(&b, " \"")
    try push_roff(&b, date)
    try str.push(&b, "\" \"")
    try push_roff(&b, version)
    try str.push(&b, "\"\n.SH NAME\n")
    try push_roff(&b, title)
    if command.help.len > 0usize {
        try str.push(&b, " \\- ")
        try push_roff(&b, command.help)
    }
    try str.push(&b, "\n.SH SYNOPSIS\n\\fB")
    try push_roff(&b, title)
    try str.push(&b, "\\fR")
    if command.options.len > 0usize { try str.push(&b, " [\\fIOPTIONS\\fR]") }
    if command.subcommands.len > 0usize { try str.push(&b, " [\\fICOMMAND\\fR]") }
    try str.push_byte(&b, 10u8)
    if command.help.len > 0usize {
        try str.push(&b, ".SH DESCRIPTION\n")
        try push_roff(&b, command.help)
        try str.push_byte(&b, 10u8)
    }
    if command.options.len > 0usize {
        try str.push(&b, ".SH OPTIONS\n")
        i = 0usize
        while i < command.options.len {
            let o = &command.options[i]
            try str.push(&b, ".TP\n")
            if o.short != 0u8 {
                try str.push(&b, "\\fB\\-")
                try str.push_byte(&b, o.short)
                try str.push(&b, "\\fR, ")
            }
            try str.push(&b, "\\fB\\-\\-")
            try push_roff(&b, o.long)
            try str.push(&b, "\\fR")
            if takes_value(o) { try str.push(&b, "=\\fIVALUE\\fR") }
            try str.push_byte(&b, 10u8)
            if o.help.len > 0usize {
                try push_roff(&b, o.help)
                try str.push_byte(&b, 10u8)
            }
            if o.required { try str.push(&b, "Required.\n") }
            if o.repeated { try str.push(&b, "May be given more than once.\n") }
            i += 1usize
        }
    }
    if command.subcommands.len > 0usize {
        try str.push(&b, ".SH COMMANDS\n")
        i = 0usize
        while i < command.subcommands.len {
            try str.push(&b, ".TP\n\\fB")
            try push_roff(&b, command.subcommands[i].name)
            try str.push(&b, "\\fR\n")
            if command.subcommands[i].help.len > 0usize {
                try push_roff(&b, command.subcommands[i].help)
                try str.push_byte(&b, 10u8)
            }
            i += 1usize
        }
    }
    var has_env = false
    i = 0usize
    while i < command.options.len {
        if command.options[i].env.len > 0usize { has_env = true }
        i += 1usize
    }
    if has_env {
        try str.push(&b, ".SH ENVIRONMENT\n")
        i = 0usize
        while i < command.options.len {
            let o = &command.options[i]
            if o.env.len > 0usize {
                try str.push(&b, ".TP\n\\fB")
                try push_roff(&b, o.env)
                try str.push(&b, "\\fR\nRead for \\fB\\-\\-")
                try push_roff(&b, o.long)
                try str.push(&b, "\\fR when the option is absent.\n")
            }
            i += 1usize
        }
    }
    ret (str.done(&b), ok)
}
