// Round 87, lane x: Windows and Windows Dark completion. datagrid.e and collection.e call this file with plain values.

use e.mem
use e.gfx.paint
use e.ui.style
use e.ui.widget

error TooLarge

// The group box chip, hot or pressed, of the 1:1 capture (data_grid_group2, the pressed Edition chip, #BCDCF4): a flat 66 x 19 box without
// the ring; the sort triangle (8 x 8) and the filter button (10 x 10) are cut from it. The hot pair (7 x 8 and 10 x 10, on #D9EBF9) is cut from the hot
// Edition header of data_grid_group; the hot chip uses it too (the 1:1 set has no hot chip).
fn chip_tri_pressed() -> str { ret "" }
fn chip_filter_pressed() -> str { ret "" }
fn chip_tri_hot() -> str { ret "" }
fn chip_filter_hot() -> str { ret "" }

// The current row's arrow of the 1:1 capture (data_grid_group, 10 x 10 on white; the same pixels in every crisp grid)
fn row_arrow() -> str { ret "" }

fn one_of(a: *mem.Arena, node: widget.Node) -> []widget.Node {
    let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
    if held_error != ok { ret zero }
    held[0usize] = node
    ret held[0usize..1usize]
}

fn px(a: *mem.Arena, x: f32, y: f32, w: f32, h: f32, color: u32) -> widget.Node {
    var s = style.defaults()
    s.width = style.Length { Px: w }
    s.height = style.Length { Px: h }
    s.background = paint.Brush { Solid: style.hex_raw(color) }
    var none: []const widget.Node = zero
    ret widget.positioned(0u64, x, y, style.defaults(), one_of(a, widget.box(0u64, s, none)))
}

// The pressed or hot vertical thumb of the 1:1 capture (data_grid_top4): a pill 6 wide on whole pixels, `h` rows: the end rows 4 wide (#BABABA,
// #8C8C8C, #8C8C8C, #B4B4B4), the next rows #B3B3B3 and #BABABA at the edges, the third and the third from last #8C8C8C at the edges, #858585 between.
fn pill(a: *mem.Arena, h: f32) -> (widget.Node, err) {
    let (parts, parts_error) = mem.alloc[widget.Node](a, 16usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = px(a, 1.0, 0.0, 1.0, 1.0, 0xBABABAu32)
    parts[1usize] = px(a, 2.0, 0.0, 2.0, 1.0, 0x8C8C8Cu32)
    parts[2usize] = px(a, 4.0, 0.0, 1.0, 1.0, 0xB4B4B4u32)
    parts[3usize] = px(a, 0.0, 1.0, 1.0, 1.0, 0xB3B3B3u32)
    parts[4usize] = px(a, 5.0, 1.0, 1.0, 1.0, 0xBABABAu32)
    parts[5usize] = px(a, 0.0, 2.0, 1.0, 1.0, 0x8C8C8Cu32)
    parts[6usize] = px(a, 5.0, 2.0, 1.0, 1.0, 0x8C8C8Cu32)
    parts[7usize] = px(a, 0.0, h - 3.0, 1.0, 1.0, 0x8C8C8Cu32)
    parts[8usize] = px(a, 5.0, h - 3.0, 1.0, 1.0, 0x8C8C8Cu32)
    parts[9usize] = px(a, 0.0, h - 2.0, 1.0, 1.0, 0xBABABAu32)
    parts[10usize] = px(a, 5.0, h - 2.0, 1.0, 1.0, 0xB4B4B4u32)
    parts[11usize] = px(a, 1.0, h - 1.0, 1.0, 1.0, 0xB3B3B3u32)
    parts[12usize] = px(a, 2.0, h - 1.0, 2.0, 1.0, 0x8C8C8Cu32)
    parts[13usize] = px(a, 4.0, h - 1.0, 1.0, 1.0, 0xBBBBBBu32)
    parts[14usize] = px(a, 1.0, 1.0, 4.0, h - 2.0, 0x858585u32)
    parts[15usize] = px(a, 0.0, 3.0, 6.0, h - 6.0, 0x858585u32)
    ret (widget.stack(0u64, style.defaults(), parts[0usize..16usize]), ok)
}

// The favourite star for the Windows Dark grid header, 16 x 17: the light star's coverage (white to #CCCCCC) from #2B2B2B to #8E8E8E, 4.3 : 1 on the face
fn star_dark() -> str { ret "" }
