fn wedit_measure(ctx: *void, limits: ui_layout.Constraints) -> geometry.Size {
    ret geometry.Size { width: 0.0, height: 0.0 }
}

fn wedit_rect(b: *scene.Builder, x: f32, y: f32, w: f32, h: f32, argb: u32) -> err {
    ret scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.Rect { x: x, y: y, width: w, height: h }, brush: paint.Brush { Solid: style.hex(argb & 0xFFFFFFu32) } } })
}

// The row's place in the models (0, 1, 19, 20, 21 -> 0..4) or 99 for a row that is plain face.
fn wedit_row_index(r: usize) -> usize {
    if r == 0usize { ret 0usize }
    if r == 1usize { ret 1usize }
    if r == 19usize { ret 2usize }
    if r == 20usize { ret 3usize }
    if r == 21usize { ret 4usize }
    ret 99usize
}

// One channel (0 red, 1 green, 2 blue) of row `row_index` of the model `state` at window y `y`.
fn wedit_model(models: [90]f32, state: u32, row_index: usize, channel: usize, y: f32) -> i32 {
    let at = ((usize(state) * 5usize + row_index) * 3usize + channel) * 2usize
    var v = models[at] + models[at + 1usize] * y
    if v < 0.0 { v = 0.0 }
    if v > 255.0 { v = 255.0 }
    ret i32(v + 0.5)
}

fn wedit_clamp(v: i32) -> u32 {
    if v < 0 { ret 0u32 }
    if v > 255 { ret 255u32 }
    ret u32(v)
}

// A tile cell `cell` (0xFFRRGGBB) of tile row `r`, re-based from the capture's y (`y_capture`) to `y`.
fn wedit_cell(models: [90]f32, model_state: u32, cell: u32, r: usize, y: f32, y_capture: f32) -> u32 {
    let ri = wedit_row_index(r)
    if ri == 99usize { ret cell }
    let red = i32((cell >> 16u32) & 255u32) + wedit_model(models, model_state, ri, 0usize, y) - wedit_model(models, model_state, ri, 0usize, y_capture)
    let green = i32((cell >> 8u32) & 255u32) + wedit_model(models, model_state, ri, 1usize, y) - wedit_model(models, model_state, ri, 1usize, y_capture)
    let blue = i32(cell & 255u32) + wedit_model(models, model_state, ri, 2usize, y) - wedit_model(models, model_state, ri, 2usize, y_capture)
    ret 0xFF000000u32 | (wedit_clamp(red) << 16u32) | (wedit_clamp(green) << 8u32) | wedit_clamp(blue)
}

// Greys a button's arrow pixel (ink toward the 250 face), as v3 draws an arrow that cannot step: a guess, not captured.
fn wedit_dim(cell: u32) -> u32 {
    let red = i32((cell >> 16u32) & 255u32)
    let lifted = red + ((250 - red) * 6) / 10
    if lifted <= red { ret cell }
    let v = u32(lifted)
    ret 0xFF000000u32 | (v << 16u32) | (v << 8u32) | v
}

fn wedit_in_arrows(arrows: []const u32, dim: u32, c: usize, r: usize) -> bool {
    var i = 0usize
    while i * 4usize < arrows.len {
        if (dim & (1u32 << u32(i))) != 0u32 {
            let ax = usize(arrows[i * 4usize])
            let ay = usize(arrows[i * 4usize + 1usize])
            if c >= ax && c < ax + usize(arrows[i * 4usize + 2usize]) && r >= ay && r < ay + usize(arrows[i * 4usize + 3usize]) { ret true }
        }
        i += 1usize
    }
    ret false
}

// The source row of tile row (0..21) that output row `r` of an edit `height` high draws: the top rows and the three
// foot rows are the capture's, every row between repeats a middle row.
fn wedit_src_row(r: usize, height: usize) -> usize {
    if r <= 2usize || height == 22usize { ret r }
    if r + 3usize >= height { ret r + 22usize - height }
    ret 10usize
}

// The model y of output row `r`: the foot follows the bottom of a tall edit.
fn wedit_row_y(r: usize, height: usize, y: f32) -> f32 {
    if r <= 2usize { ret y }
    ret y + f32(height) - 22.0
}

fn wedit_value(models: [90]f32, model_state: u32, cells: []const u32, slopes: []const f32, cols: usize, c: usize, r: usize, height: usize, y: f32, y_capture: f32, arrows: []const u32, dim: u32) -> u32 {
    let sr = wedit_src_row(r, height)
    let v = cells[sr * cols + c]
    if v == 0u32 { ret 0u32 }
    var out = v
    let ry = wedit_row_y(r, height, y)
    if slopes.len != 0usize {
        let at = (sr * cols + c) * 3usize
        let red = i32((v >> 16u32) & 255u32) + i32(slopes[at] * (ry - y_capture) + 0.5)
        let green = i32((v >> 8u32) & 255u32) + i32(slopes[at + 1usize] * (ry - y_capture) + 0.5)
        let blue = i32(v & 255u32) + i32(slopes[at + 2usize] * (ry - y_capture) + 0.5)
        out = 0xFF000000u32 | (wedit_clamp(red) << 16u32) | (wedit_clamp(green) << 8u32) | wedit_clamp(blue)
    } else {
        out = wedit_cell(models, model_state, v, sr, ry, y_capture)
    }
    if dim != 0u32 && wedit_in_arrows(arrows, dim, c, sr) { out = wedit_dim(out) }
    ret out
}

// Paints the `cols` x `height` block drawn from the 22-row tile `cells` at (x0, y0), runs of one colour as one rect.
fn wedit_block(b: *scene.Builder, models: [90]f32, model_state: u32, cells: []const u32, slopes: []const f32, cols: usize, height: usize, x0: f32, y0: f32, y: f32, y_capture: f32, arrows: []const u32, dim: u32) -> err {
    var r = 0usize
    while r < height {
        var c = 0usize
        while c < cols {
            let v = wedit_value(models, model_state, cells, slopes, cols, c, r, height, y, y_capture, arrows, dim)
            if v != 0u32 {
                var n = 1usize
                while c + n < cols {
                    let next = wedit_value(models, model_state, cells, slopes, cols, c + n, r, height, y, y_capture, arrows, dim)
                    if next != v { break }
                    n += 1usize
                }
                try wedit_rect(b, x0 + f32(c), y0 + f32(r), f32(n), 1.0, v)
                c += n
            } else {
                c += 1usize
            }
        }
        r += 1usize
    }
    ret ok
}

fn wedit_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let d = mem.cast[*Chrome](ctx)
    var y = d.window_y
    if y < 0.0 { y = area.y }
    let height = usize(d.height + 0.5)
    var model_state = d.state
    if model_state == 3u32 { model_state = 1u32 }
    let models = wedit_models()
    // The tile set: a state a kind was not captured in borrows the nearest one (disabled spin: rest, dimmed).
    var tile_state = d.state
    var dim = d.dim
    if d.kind != 3u32 && d.state == 3u32 { tile_state = 1u32 }
    if d.kind == 1u32 || d.kind == 2u32 {
        if d.state == 2u32 {
            tile_state = 0u32
            dim = 15u32
        }
    }
    var right: [1100]u32 = zero
    let (n, right_y) = wedit_right(d.kind, tile_state, right[0usize..1100usize])
    if n == 0usize { ret ok }
    let k = n / 22usize
    var right_slopes: [3300]f32 = zero
    var has_right_slopes = wedit_slopes(d.kind, tile_state, right_slopes[0usize..3300usize])
    var left_slopes: [198]f32 = zero
    var left: [66]u32 = zero
    var left_state = d.state
    if left_state == 3u32 { left_state = 1u32 }
    let left_y = wedit_left(left_state, left[0usize..66usize])
    let w = d.width + 1.0
    var arrow_store: [16]u32 = zero
    let arrow_count = wedit_arrows(d.kind, arrow_store[0usize..16usize])
    let arrows = arrow_store[0usize..arrow_count]
    // The middle: only the rows that are not plain face.
    var r = 0usize
    while r < height {
        let sr = wedit_src_row(r, height)
        let ri = wedit_row_index(sr)
        if ri != 99usize {
            let ry = wedit_row_y(r, height, y)
            let red = wedit_model(models, model_state, ri, 0usize, ry)
            let green = wedit_model(models, model_state, ri, 1usize, ry)
            let blue = wedit_model(models, model_state, ri, 2usize, ry)
            let argb = 0xFF000000u32 | (wedit_clamp(red) << 16u32) | (wedit_clamp(green) << 8u32) | wedit_clamp(blue)
            try wedit_rect(b, area.x + 3.0, area.y + f32(r), w - 3.0 - f32(k), 1.0, argb)
        }
        r += 1usize
    }
    var left_s: []const f32 = zero
    if wedit_left_slopes(left_state, left_slopes[0usize..198usize]) { left_s = left_slopes[0usize..198usize] }
    var right_s: []const f32 = zero
    if has_right_slopes { right_s = right_slopes[0usize..n * 3usize] }
    try wedit_block(b, models, left_state, left[0usize..66usize], left_s, 3usize, height, area.x, area.y, y, left_y, zero, 0u32)
    try wedit_block(b, models, model_state, right[0usize..n], right_s, k, height, area.x + w - f32(k), area.y, y, right_y, arrows, dim)
    ret ok
}

// The chrome node for an edit of DFM width `width` (it paints `width + 1` x `height` (22 for a one-line edit) from its origin).
fn chrome(a: *mem.Arena, kind: u32, state: u32, width: f32, height: f32, window_y: f32, dim: u32) -> (widget.Node, err) {
    let (made, made_error) = mem.alloc[Chrome](a, 1usize)
    if made_error != ok { ret (zero, made_error) }
    made[0usize] = Chrome { kind: kind, state: state, width: width, height: height, window_y: window_y, dim: dim }
    var s = style.defaults()
    s.width = style.Length { Px: width + 1.0 }
    s.height = style.Length { Px: height }
    var none: []const widget.Node = zero
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&made[0usize]), measure: wedit_measure, paint: wedit_paint, state: widget.bytes_of[Chrome](&made[0usize]) } }, style: s, children: none }, ok)
}
