fn light_glow() -> str { ret "" }
fn dark_glow() -> str { ret "" }
// alert card shadow, light: columns from -36, rows from -29 relative to the card corner, 183 x 212
fn light_alert_shadow() -> str { ret "" }
fn light_alert_shadow_at() -> [4]i32 { ret [4]i32{ -36, -29, 183, 212 } }
