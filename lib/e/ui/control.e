// `ProgressOptions.delayed` does for the bar and ring.
fn skeleton_of(a: *mem.Arena, key: widget.Key, t: *const Theme, width: f32, height: f32, options: SkeletonOptions) -> (widget.Node, err) {
    var h = height
    var radius = options.radius
