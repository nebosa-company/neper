                    r += 1usize
                }
                column[0usize] = widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, sheet_style, shaded[0usize..suggestions.len + 1usize])
            }
        }
