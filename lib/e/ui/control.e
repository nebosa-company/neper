        let (popup, popup_error) = mem.alloc[widget.Node](a, 1usize)
        if popup_error != ok { ret (zero, TooLarge) }
        popup[0usize] = widget.semantics(0u64, list_sem, style.defaults(), column[0usize..1usize])
