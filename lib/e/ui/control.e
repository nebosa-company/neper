// A list box (TcxListBox): v3 has none of its own, so this is the list its customization window
// shows (TcxCustomGridItemsInnerListBox, measured on ref/windows/dialogs/view-show-columns at
// 100 %): white rows 19 tall with the text 4 in, a #C1C1C1 line above, #A1A1A1 on the left, #EAEAEA on
// the right and #F8F8F8 below, the chosen row #D9EBF9 and, while a row has the focus, the dotted
// focus rectangle round it. Past `rows` rows it scrolls. Rows are keyed `key + 1 + index`.
type Win3Lines = struct { shade: f32 }

fn win3_lines_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let x = area.x
    let y = area.y
    // round 10: the dark list face is the native list's #202020 (listbox-*, combo-*-open)
    var list_face = style.hex(16777215u32)
    if style.windark_active() { list_face = style.hex_raw(0x202020u32) }
    try win3_rect(b, x + 1.0, y + 1.0, area.width - 3.0, area.height - 2.0, list_face)
    // round 12: the dark list frame is the native dark list's line (combo-*-open: #7A7A7A, 3.8 : 1 against the #202020 page), all round
    if style.windark_active() {
        let line = style.hex_raw(0x7A7A7Au32)
        try win3_rect(b, x, y, area.width - 1.0, 1.0, line)
        try win3_rect(b, x, y + 1.0, 1.0, area.height - 1.0, line)
        try win3_rect(b, x + area.width - 2.0, y + 1.0, 1.0, area.height - 2.0, line)
        ret win3_rect(b, x + 1.0, y + area.height - 1.0, area.width - 3.0, 1.0, line)
    }
    try win3_rect(b, x, y, area.width - 1.0, 1.0, style.hex(12698049u32))
    try win3_rect(b, x, y + 1.0, 1.0, area.height - 1.0, style.hex(10592673u32))
    try win3_rect(b, x + area.width - 2.0, y + 1.0, 1.0, area.height - 2.0, style.hex(15395562u32))
    try win3_rect(b, x + 1.0, y + area.height - 1.0, area.width - 3.0, 1.0, style.hex(16316664u32))
    // looks5 group d: the second row under the top line is #DCDCDC (a chosen first row covers it), measured on the states grabs.
    try win3_rect(b, x + 1.0, y + 1.0, area.width - 4.0, 1.0, style.hex(14474460u32))
    // looks4: the column past the right line (#FAFAFA, #F1F1F1 at the top, #F5F5F5 below it), measured on the states grabs.
    try win3_rect(b, x + area.width - 1.0, y + 2.0, 1.0, area.height - 3.0, style.hex(16448250u32))
    try win3_rect(b, x + area.width - 1.0, y, 1.0, 1.0, style.hex(15855857u32))
    ret win3_rect(b, x + area.width - 1.0, y + 1.0, 1.0, 1.0, style.hex(16119285u32))
