    if pair_error != ok { ret (zero, pair_error) }
    let (big_buttons, big_shortcuts, big_error) = step_pair(a, t, key + 4u64, key + 5u64, value, low, high, step * 10i64, change)
    if big_error != ok { ret (zero, big_error) }
