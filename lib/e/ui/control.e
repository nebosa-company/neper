type DisclosureOptions = struct { meta: str, supporting: str, enabled: bool, width: f32, has_icon: bool, icon: GlyphKind }

fn disclosure_options() -> DisclosureOptions {
    var out: DisclosureOptions = zero
    out.enabled = true
    ret out
}

