// A scrolling viewport `width` x `height` over `children` whose content is `content` px long along
// `axis`, scrolled to `offset`: the theme's own bar over the viewport, or, under the Windows
// look, v3's bar beside it (the viewport's own thumb stays, invisible, for dragging and wheel).
fn scroll_area(a: *mem.Arena, key: widget.Key, t: *const Theme, axis: ui_layout.Axis, width: f32, height: f32, offset: f32, content: f32, children: []const widget.Node) -> (widget.Node, err) {
    let vertical = axis == .Vertical
    var thumb = with_alpha(style.color(t.tokens, .OnSurfaceVariant), 0.5)
    // The Cupertino indicator: the label colour at 35 %, a thin pill that needs no track (iOS; macOS overlay scrollers).
    if t.tokens.profile == .CupertinoLike { thumb = with_alpha(style.color(t.tokens, .Text), 0.35) }
    var view = sized_style(width, height)
    view.overflow = .Clip
    var along = height
    if !vertical { along = width }
    // The Linux look (worker l3): GNOME's overlay indicator, shown only while the content moves, in the slider colour.
    if t.tokens.profile == .Linux {
        ret (widget.scroll(key, widget.Scroll { axis: axis, offset: offset, overscroll: .Clamp, momentum: true, scrollbar: true, thumb: linux_slider(t, true), change: zero, virtual_first: 0usize, virtual_count: 0usize, virtual_extent: 0.0, fades: true, virtual_extras: zero }, view, children), ok)
    }
    if t.tokens.profile != .Windows {
        ret (widget.scroll(key, widget.Scroll { axis: axis, offset: offset, overscroll: .Clamp, momentum: true, scrollbar: true, thumb: thumb, change: zero, virtual_first: 0usize, virtual_count: 0usize, virtual_extent: 0.0, fades: false, virtual_extras: zero }, view, children), ok)
    }
    thumb = with_alpha(thumb, 0.0)
    if vertical { view = sized_style(width - 16.0, height) } else { view = sized_style(width, height - 16.0) }
    view.overflow = .Clip
    let (bar, bar_error) = windows_scroll_bar(a, key + 3300u64, t, vertical, along, along, content, offset)
    if bar_error != ok { ret (zero, bar_error) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = widget.scroll(key, widget.Scroll { axis: axis, offset: offset, overscroll: .Clamp, momentum: true, scrollbar: true, thumb: thumb, change: zero, virtual_first: 0usize, virtual_count: 0usize, virtual_extent: 0.0, fades: false, virtual_extras: zero }, view, children)
    parts[1usize] = bar
    var direction: ui_layout.Axis = .Horizontal
    if !vertical { direction = .Vertical }
    ret (widget.flex(0u64, ui_layout.Flex { axis: direction, main: .Start, cross: .Start, gap: 0.0 }, style.defaults(), parts[0usize..2usize]), ok)
}

fn scroll_bar_gesture(ctx: *void, g: widget.Gesture) -> err { ret ok }

// ---- the Linux look, scroll bar (worker l3, round 20) ----------------------------------------------------------------
// GtkScrollbar in libadwaita 1.5: a strip 20 across, no trough, holding an 8 across pill (#d3d3d3 Light, #505050 Dark; #f5f5f5 /
// #2c2c2c when insensitive) centred in it. Along the strip the pill is `length * length / content` long and sits at
// `offset / content * length`. Dragging is the viewport's own (as under the Windows look).
fn linux_slider(t: *const Theme, enabled: bool) -> paint.Color {
    if t.tokens.palette == .Dark {
        if !enabled { ret style.hex_raw(0x2C2C2Cu32) }
        ret style.hex_raw(0x505050u32)
    }
    if !enabled { ret style.hex_raw(0xF5F5F5u32) }
    ret style.hex_raw(0xD3D3D3u32)
}

fn linux_scroll_bar(a: *mem.Arena, key: widget.Key, t: *const Theme, vertical: bool, length: f32, content: f32, offset: f32, enabled: bool) -> (widget.Node, err) {
    var strip = sized_style(20.0, length)
    if !vertical { strip = sized_style(length, 20.0) }
    var count = 0usize
    let (parts, parts_error) = mem.alloc[widget.Node](a, 1usize)
    if parts_error != ok { ret (zero, TooLarge) }
    if content > 0.0 {
        var span = length * length / content
        if span > length { span = length }
        var at = offset / content * length
        if at > length - span { at = length - span }
        if at < 0.0 { at = 0.0 }
        var pill = sized_style(8.0, span)
        pill.margin = style.EdgeLengths { left: style.Length { Px: 6.0 }, top: style.Length { Px: at }, right: style.Length { Px: 0.0 }, bottom: style.Length { Px: 0.0 } }
        if !vertical {
            pill = sized_style(span, 8.0)
            pill.margin = style.EdgeLengths { left: style.Length { Px: at }, top: style.Length { Px: 6.0 }, right: style.Length { Px: 0.0 }, bottom: style.Length { Px: 0.0 } }
        }
        pill.radius = 4.0
        pill.background = paint.Brush { Solid: linux_slider(t, enabled) }
        pill.position = .Absolute
        parts[0usize] = widget.box(key + 1u64, pill, zero)
        count = 1usize
    }
    var sem: widget.Semantics = zero
    sem.role = 17u8
    sem.label = "Scroll bar"
    if !enabled { sem.states = accessibility.STATE_DISABLED }
    ret (widget.semantics(key, sem, style.defaults(), mem_one_node(a, widget.stack(0u64, strip, parts[0usize..count]))), ok)
}
// ---- end the Linux look, scroll bar ---------------------------------------------------------------------------------

// ---- The Windows look, bars (docs/ui/looks, group `bars`): toolbar buttons, menu text and the
// shared bar helpers. v3's DevExpress bars draw Tahoma 8 pt (11 px) on the #F0F0F0 face; the
// colours below are measured from docs/grid-parity (main window and popup menu captures at
// 150 %), except the hover and pressed blues, which are guesses (no capture shows them).

// The theme the Windows bars draw with: the second font first (the rig registers Tahoma as
// the second; Segoe UI leads every other control) and 11 px body text.
fn windows_bar_theme(a: *mem.Arena, t: *const Theme) -> (Theme, err) {
    let (copies, copies_error) = mem.alloc[style.ThemeTokens](a, 1usize)
    if copies_error != ok { ret (*t, TooLarge) }
    copies[0usize] = *t.tokens
    let small = style.TextStyle { size: 12.0, line_height: 15.0, weight: 400u16, italic: false }
    copies[0usize].text[1usize] = small
    copies[0usize].text[17usize] = small
    var fonts = t.fonts
    if t.fonts.len >= 2usize {
        let (swapped, swapped_error) = mem.alloc[shape.Font](a, t.fonts.len)
        if swapped_error != ok { ret (*t, TooLarge) }
        var i = 0usize
        while i < t.fonts.len {
            swapped[i] = t.fonts[i]
            i += 1usize
        }
        swapped[0usize] = t.fonts[1usize]
        swapped[1usize] = t.fonts[0usize]
        fonts = swapped
    }
    ret (Theme { tokens: &copies[0usize], fonts: fonts, language: t.language, runtime: t.runtime }, ok)
}

// (looks) The bar theme with its body text bold: Tahoma Bold (the rig's fourth font) leads the
// chain when it is there (popup menu group headers).
fn windows_bar_theme_bold(a: *mem.Arena, t: *const Theme) -> (Theme, err) {
    let (base, base_error) = windows_bar_theme(a, t)
    if base_error != ok { ret (base, base_error) }
    let (copies, copies_error) = mem.alloc[style.ThemeTokens](a, 1usize)
    if copies_error != ok { ret (base, TooLarge) }
    copies[0usize] = *base.tokens
    var heavy = copies[0usize].text[1usize]
    heavy.weight = 700u16
    copies[0usize].text[1usize] = heavy
    var fonts = base.fonts
    if base.fonts.len >= 4usize {
        let (swapped, swapped_error) = mem.alloc[shape.Font](a, base.fonts.len)
        if swapped_error != ok { ret (base, TooLarge) }
        var i = 0usize
        while i < base.fonts.len {
            swapped[i] = base.fonts[i]
            i += 1usize
        }
        swapped[0usize] = base.fonts[3usize]
        swapped[3usize] = base.fonts[0usize]
        fonts = swapped
    }
    ret (Theme { tokens: &copies[0usize], fonts: fonts, language: base.language, runtime: base.runtime }, ok)
}

// The look of a flat bar button (toolbar button, menu title): no face at rest, a light blue
// face and border hovered, a deeper one pressed or checked. Guessed blues.
fn windows_bar_look(state: style.ControlState, ink: paint.Color) -> style.ResolvedControl {
    var face = paint.rgba(0.0, 0.0, 0.0, 0.0)
    var edge = face
    var face_ink = ink
    if state.hovered && !state.pressed && !state.selected {
        face = style.hex(13428991u32)
        edge = style.hex(10080767u32)
    }
    if state.pressed || state.selected {
        face = style.hex(11064568u32)
        edge = style.hex(6730480u32)
    }
    if style.windows_dark_on() {
        // (round 7) Windows 11 dark: neutral washes (#3C3C3C hot, #333333 pressed), accent tint when checked
        if state.hovered && !state.pressed && !state.selected {
            face = style.hex_raw(0x3C3C3Cu32)
            edge = style.hex_raw(0x4A4A4Au32)
        }
        if state.pressed {
            face = style.hex_raw(0x333333u32)
            edge = style.hex_raw(0x5A5A5Au32)
        }
        if state.selected {
            face = style.hex_raw(0x264F78u32)
            edge = style.hex_raw(0x4CC2FFu32)
        }
    }
    if state.disabled {
        face = paint.rgba(0.0, 0.0, 0.0, 0.0)
        edge = face
        face_ink = style.hex(10526880u32)
    }
    ret style.ResolvedControl { background: face, foreground: face_ink, border: edge, border_width: 1.0, focus_ring: 0.0, opacity: 1.0, radius: 0.0, elevation: 0u8, padding: 2.0, padding_start: 0.0, padding_y: 2.0, custom_padding: true, min_width: 23.0, min_height: 22.0, corners: zero }
}

// (looks5-f) A grey that drifts along the main window: `table` holds one digit per measured toolbar button
// (x 384, 407, 466, 489, 512, 617, 640 of the 800 px window) as an offset from `base`; between them it
// interpolates, past them it holds.
fn windows_tool_drift(along: f32, table: str, base: f32) -> u32 {
    var k = 0usize
    var x0: f32 = 384.0
    var x1: f32 = 407.0
    if along >= 407.0 {
        k = 1usize
        x0 = 407.0
        x1 = 466.0
    }
    if along >= 466.0 {
        k = 2usize
        x0 = 466.0
        x1 = 489.0
    }
    if along >= 489.0 {
        k = 3usize
        x0 = 489.0
        x1 = 512.0
    }
    if along >= 512.0 {
        k = 4usize
        x0 = 512.0
        x1 = 617.0
    }
    if along >= 617.0 {
        k = 5usize
        x0 = 617.0
        x1 = 640.0
    }
    var frac = (along - x0) / (x1 - x0)
    if frac < 0.0 { frac = 0.0 }
    if frac > 1.0 { frac = 1.0 }
    let v0 = f32(u32(table[k]) - 48u32)
    let v1 = f32(u32(table[k + 1usize]) - 48u32)
    ret u32(base + v0 + (v1 - v0) * frac + 0.5)
}

fn windows_tool_part(x: f32, y: f32, w: f32, h: f32, grey: u32) -> widget.Node {
    var s = style.defaults()
    s.background = paint.Brush { Solid: style.hex(grey * 65793u32) }
    s.width = style.Length { Px: w }
    s.height = style.Length { Px: h }
    ret widget.positioned(0u64, x, y, s, zero)
}

// (looks5-f) The 2 px box of a hot or pressed toolbar button, 24 x 23 with its top left at the cell's (0, -1) (the
// pixels of states/hover-toolbar-button-search-*, drifting along the window as the bar greys do; `along` is the
// button's x in the 800 px window): hot is raised (#FA and #F5 above and left, #BE, #D2 and #B9 below and right),
// pressed sunken (#BD, #D3 and #B8 dark above and left, #F9, #F6 light below and right, #F0 inside). Parts are
// placed by the caller at (-2, -3) from the content's origin, which the button's 2 px padding puts at (2, 2) of the cell.
fn windows_tool_box(a: *mem.Arena, pressed: bool, along: f32) -> (widget.Node, err) {
    let (parts, parts_error) = mem.alloc[widget.Node](a, 24usize)
    if parts_error != ok { ret (zero, TooLarge) }
    let ox: f32 = 0.0
    let oy: f32 = 0.0
    var n = 0usize
    if !pressed {
        let l0 = windows_tool_drift(along, "3222110", 249.0)
        let l1 = windows_tool_drift(along, "0111223", 243.0)
        let l1_top = windows_tool_drift(along, "0000011", 248.0)
        let corner = windows_tool_drift(along, "1111100", 246.0)
        let r0_top = windows_tool_drift(along, "013459:", 203.0)
        let r0_second = windows_tool_drift(along, "01467<=", 180.0)
        let r0 = windows_tool_drift(along, "01456;<", 179.0)
        let r0_foot = windows_tool_drift(along, "0122245", 167.0)
        let r1_top = windows_tool_drift(along, "8755410", 220.0)
        let r1 = windows_tool_drift(along, "<;87610", 209.0)
        let r1_foot = windows_tool_drift(along, "5433310", 228.0)
        let l_foot = windows_tool_drift(along, "0023366", 206.0)
        let l_last = windows_tool_drift(along, "0122355", 216.0)
        parts[n] = windows_tool_part(ox, oy, 1.0, 1.0, corner)
        parts[n + 1usize] = windows_tool_part(ox + 1.0, oy, 21.0, 1.0, 250u32)
        parts[n + 2usize] = windows_tool_part(ox + 22.0, oy, 1.0, 1.0, r0_top)
        parts[n + 3usize] = windows_tool_part(ox + 23.0, oy, 1.0, 1.0, r1_top)
        parts[n + 4usize] = windows_tool_part(ox, oy + 1.0, 1.0, 20.0, l0)
        parts[n + 5usize] = windows_tool_part(ox + 1.0, oy + 1.0, 1.0, 1.0, l1_top)
        parts[n + 6usize] = windows_tool_part(ox + 1.0, oy + 2.0, 1.0, 19.0, l1)
        parts[n + 7usize] = windows_tool_part(ox + 2.0, oy + 1.0, 20.0, 1.0, 245u32)
        parts[n + 8usize] = windows_tool_part(ox + 22.0, oy + 1.0, 1.0, 1.0, r0_second)
        parts[n + 9usize] = windows_tool_part(ox + 22.0, oy + 2.0, 1.0, 19.0, r0)
        parts[n + 10usize] = windows_tool_part(ox + 23.0, oy + 1.0, 1.0, 21.0, r1)
        parts[n + 11usize] = windows_tool_part(ox, oy + 21.0, 1.0, 1.0, l_foot)
        parts[n + 12usize] = windows_tool_part(ox + 1.0, oy + 21.0, 1.0, 1.0, 192u32)
        parts[n + 13usize] = windows_tool_part(ox + 2.0, oy + 21.0, 20.0, 1.0, 190u32)
        parts[n + 14usize] = windows_tool_part(ox + 22.0, oy + 21.0, 1.0, 1.0, r0_foot)
        parts[n + 15usize] = windows_tool_part(ox, oy + 22.0, 1.0, 1.0, l_last)
        parts[n + 16usize] = windows_tool_part(ox + 1.0, oy + 22.0, 22.0, 1.0, 210u32)
        parts[n + 17usize] = windows_tool_part(ox + 23.0, oy + 22.0, 1.0, 1.0, r1_foot)
        n += 18usize
    } else {
        let corner = windows_tool_drift(along, "0000111", 203.0)
        let r0_top = windows_tool_drift(along, "1111000", 231.0)
        let l0 = windows_tool_drift(along, "0001222", 182.0)
        let l1_top = windows_tool_drift(along, "1111000", 196.0)
        let r0_second = windows_tool_drift(along, "1111000", 241.0)
        let r1 = windows_tool_drift(along, "0001111", 244.0)
        let l1 = windows_tool_drift(along, "2221000", 216.0)
        let r0 = windows_tool_drift(along, "1111000", 250.0)
        let l1_foot = windows_tool_drift(along, "1111000", 240.0)
        parts[n] = windows_tool_part(ox, oy, 1.0, 1.0, corner)
        parts[n + 1usize] = windows_tool_part(ox + 1.0, oy, 21.0, 1.0, 189u32)
        parts[n + 2usize] = windows_tool_part(ox + 22.0, oy, 1.0, 1.0, r0_top)
        parts[n + 3usize] = windows_tool_part(ox + 23.0, oy, 1.0, 1.0, 243u32)
        parts[n + 4usize] = windows_tool_part(ox, oy + 1.0, 1.0, 20.0, l0)
        parts[n + 5usize] = windows_tool_part(ox + 1.0, oy + 1.0, 1.0, 1.0, l1_top)
        parts[n + 6usize] = windows_tool_part(ox + 1.0, oy + 2.0, 1.0, 19.0, l1)
        parts[n + 7usize] = windows_tool_part(ox + 2.0, oy + 1.0, 20.0, 1.0, 211u32)
        parts[n + 8usize] = windows_tool_part(ox + 22.0, oy + 1.0, 1.0, 1.0, r0_second)
        parts[n + 9usize] = windows_tool_part(ox + 22.0, oy + 2.0, 1.0, 19.0, r0)
        parts[n + 10usize] = windows_tool_part(ox + 23.0, oy + 1.0, 1.0, 21.0, r1)
        parts[n + 11usize] = windows_tool_part(ox, oy + 21.0, 1.0, 1.0, 225u32)
        parts[n + 12usize] = windows_tool_part(ox + 1.0, oy + 21.0, 1.0, 1.0, l1_foot)
        parts[n + 13usize] = windows_tool_part(ox + 2.0, oy + 21.0, 20.0, 1.0, 249u32)
        parts[n + 14usize] = windows_tool_part(ox + 22.0, oy + 21.0, 1.0, 1.0, 253u32)
        parts[n + 15usize] = windows_tool_part(ox, oy + 22.0, 1.0, 1.0, 244u32)
        parts[n + 16usize] = windows_tool_part(ox + 1.0, oy + 22.0, 22.0, 1.0, 246u32)
        parts[n + 17usize] = windows_tool_part(ox + 23.0, oy + 22.0, 1.0, 1.0, 242u32)
        n += 18usize
    }
    ret (widget.stack(0u64, sized_style(24.0, 23.0), parts[0usize..n]), ok)
}

// A TdxBarButton with a picture: 22 square, the 16 glyph in a dark ink (v3 draws bitmaps). Hot and pressed draw v3's
// 2 px box (windows_tool_box); a checked button keeps the guessed deeper blue.
fn windows_glyph_toggle(a: *mem.Arena, key: widget.Key, t: *const Theme, kind: GlyphKind, label: str, action: *const widget.Submit, enabled: bool, checked: bool) -> (widget.Node, err) {
    let (node, node_error) = windows_glyph_toggle_at(a, key, t, kind, label, action, enabled, checked, 466.0)
    ret (node, node_error)
}

// The same for a button at x `along` of v3's 800 px window (the greys of the box drift along it).
fn windows_glyph_toggle_at(a: *mem.Arena, key: widget.Key, t: *const Theme, kind: GlyphKind, label: str, action: *const widget.Submit, enabled: bool, checked: bool, along: f32) -> (widget.Node, err) {
    let (node, node_error) = windows_glyph_toggle_art(a, key, t, kind, label, action, enabled, checked, along, 1000usize)
    ret (node, node_error)
}

// The same with v3's own picture `art` (a tile of e.ui.wintoolicon; 1000 = none, the drawn glyph) in the Windows light look.
fn windows_glyph_toggle_art(a: *mem.Arena, key: widget.Key, t: *const Theme, kind: GlyphKind, label: str, action: *const widget.Submit, enabled: bool, checked: bool, along: f32, art: usize) -> (widget.Node, err) {
    style.windows_dark_enter(t.tokens)
    let state = control_state(t, key, enabled, checked)
    var look = windows_bar_look(state, style.hex(4210752u32))
    // v3's disabled pictures are pale bitmaps (mean #D4D4D4 over the glyph area, measured);
    // a drawn glyph in #C8C8C8 stands in.
    var ink = look.foreground
    if !enabled { ink = style.hex(13158600u32) }
    if !enabled && style.windows_dark_on() { ink = style.hex_raw(0x6B6B6Bu32) }
    var mark: widget.Node = zero
    if art < 1000usize && !style.windows_dark_on() {
        let atlas = wintoolicon.atlas()
        let (tile, tile_error) = wintile.tile_node(a, 16usize, 17usize, atlas[art * 272usize..art * 272usize + 272usize])
        if tile_error != ok { ret (zero, tile_error) }
        let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
        if held_error != ok { ret (zero, held_error) }
        held[0usize] = tile
        mark = widget.padded(0u64, f32(wintoolicon.dx(art)), 0.0, 0.0, 0.0, sized_style(16.0, 16.0), held[0usize..1usize])
    } else {
        let (glyph_mark, glyph_error) = icon_square(a, ink, kind, 16.0)
        if glyph_error != ok { ret (zero, glyph_error) }
        mark = glyph_mark
    }
    var content = mark
    let boxed = enabled && !state.selected && (state.hovered || state.pressed) && !style.windows_dark_on()
    if enabled && state.pressed && style.windows_dark_on() {
        let (shifted_dark, shifted_dark_error) = mem.alloc[widget.Node](a, 1usize)
        if shifted_dark_error != ok { ret (zero, TooLarge) }
        shifted_dark[0usize] = mark
        content = widget.padded(0u64, 1.0, 1.0, 0.0, 0.0, sized_style(16.0, 16.0), shifted_dark[0usize..1usize])
    }
    if boxed {
        look.background = paint.rgba(0.0, 0.0, 0.0, 0.0)
        look.border = paint.rgba(0.0, 0.0, 0.0, 0.0)
        if state.pressed {
            let (shifted, shifted_error) = mem.alloc[widget.Node](a, 1usize)
            if shifted_error != ok { ret (zero, TooLarge) }
            shifted[0usize] = mark
            content = widget.padded(0u64, 1.0, 1.0, 0.0, 0.0, sized_style(16.0, 16.0), shifted[0usize..1usize])
        }
    }
    let (node, node_error) = pressable(a, key, t, 3u8, label, look, enabled, checked, action, content)
    if node_error != ok { ret (zero, node_error) }
    // The box lies 1 px above and 1 px right of the 23 x 22 cell, so the cell sits in a 24 x 23 stack that claims
    // only the cell's room (margins of -1 above and at the right).
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    let (cell, cell_error) = mem.alloc[widget.Node](a, 1usize)
    if cell_error != ok { ret (zero, TooLarge) }
    cell[0usize] = node
    var n = 0usize
    if boxed {
        let (box, box_error) = windows_tool_box(a, state.pressed, along)
        if box_error != ok { ret (zero, box_error) }
        let (box_held, box_held_error) = mem.alloc[widget.Node](a, 1usize)
        if box_held_error != ok { ret (zero, TooLarge) }
        box_held[0usize] = box
        parts[n] = widget.positioned(0u64, 0.0, 0.0, sized_style(24.0, 23.0), box_held[0usize..1usize])
        n += 1usize
    }
    parts[n] = widget.positioned(0u64, 0.0, 1.0, style.defaults(), cell[0usize..1usize])
    n += 1usize
    var wrap = sized_style(24.0, 23.0)
    wrap.margin = style.EdgeLengths { left: style.Length { Px: 0.0 }, top: style.Length { Px: -1.0 }, right: style.Length { Px: -1.0 }, bottom: style.Length { Px: 0.0 } }
    ret (widget.stack(0u64, wrap, parts[0usize..n]), ok)
}

// A TdxBarButton with a caption: the same flat button, 6 at its sides, Tahoma 11.
fn windows_bar_button(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, action: *const widget.Submit, enabled: bool, checked: bool) -> (widget.Node, err) {
    let (bar_t, bar_error) = windows_bar_theme(a, t)
    if bar_error != ok { ret (zero, bar_error) }
    let state = control_state(t, key, enabled, checked)
    var look = windows_bar_look(state, style.hex(0u32))
    look.padding = 6.0
    look.min_width = 0.0
    var caption = text_options()
    caption.role = .BodyMedium
    caption.wrap = .None
    let (said, said_error) = colored_text(a, 0u64, label, &bar_t, caption, look.foreground)
    if said_error != ok { ret (zero, said_error) }
    let (node, node_error) = pressable(a, key, t, 3u8, label, look, enabled, checked, action, said)
    ret (node, node_error)
}

// ===================================================================================
// The Windows look of the pickers (docs/ui/looks; combo box, image combo box, date edit,
// list box): v3's DevExpress edit with its native-style frame (#FDFDFD face, 1 px #D2D2D2
// border, radius 4, 21 tall, a thin chevron at the right) and the classic drop-down list
// (white, the row under the pointer or the chosen one in #0078D7 with white text, 15 per
// row). Measured from docs/grid-parity (tcxgrid/00b, 00c, IC1); guesses are listed in
// docs/ui/looks/status.d/pickers.json.
// ===================================================================================

type WinLook = struct { face: paint.Color, edge: paint.Color, edge_width: f32, ink: paint.Color, chevron: paint.Color }

fn win_row_height() -> f32 { ret 15.0 }

// round 12: the Windows dark look proper (the Neper dark look draws the same controls with its own palette and keeps its sizes).
fn win_dark(t: *const Theme) -> bool { ret t.tokens.palette == .Dark && t.tokens.profile == .Windows }
fn win_icon_row_height() -> f32 { ret 18.0 }
fn win_drop_rows() -> usize { ret 8usize }

// The frame's colours by state. Measured: face, border, chevron at rest. Guessed: hover,
// open or focused (the accent border of the pilot button), read-only and disabled.
fn win_look(t: *const Theme, hovered: bool, pressed: bool, focused: bool, open: bool, enabled: bool, read_only: bool) -> WinLook {
    var face = style.color(t.tokens, .SurfaceContainerLowest)
    var ink = style.color(t.tokens, .Text)
    var edge = style.color(t.tokens, .Border)
    var chevron = style.hex(7368816u32)
    var edge_width = t.tokens.borders.regular
    // looks5 group d: the edit under the pointer is as at rest (ref/windows/states/hover-combo-box-edit-*), so no hover tint.
    if hovered { chevron = ink }
    if pressed { face = style.layer(face, ink, 0.06) }
    if open || focused {
        edge = style.hex(2723289u32)
        edge_width = 1.33
    }
    if read_only { chevron = style.color(t.tokens, .TextMuted) }
    if !enabled {
        let ground = style.color(t.tokens, .Background)
        face = style.mix(face, ground, 0.5)
        ink = style.mix(ink, style.color(t.tokens, .SurfaceContainerLowest), 0.55)
        edge = style.mix(edge, ground, 0.5)
        chevron = ink
        edge_width = t.tokens.borders.regular
    }
    ret WinLook { face: face, edge: edge, edge_width: edge_width, ink: ink, chevron: chevron }
}

// A read-only head: a face that opens the list (keyed `key`), the value (or the label,
// muted, before a choice) after an optional `lead` pic, the chevron at the end.
fn win_head(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, shown: str, chosen: bool, open: bool, toggle: *const widget.Submit, enabled: bool, lead: []const widget.Node, width: f32, edge_y: f32, edge_x: f32) -> (widget.Node, err) {
    let state = control_state(t, key, enabled, false)
    var c = win_look(t, state.hovered, state.pressed, false, open, enabled, false)
    let dark = t.tokens.palette == .Dark
    // round 10: the native dark list-style combo: white text, #6D6D6D disabled
    if dark {
        c.ink = style.hex_raw(0xFFFFFFu32)
        if !enabled { c.ink = style.hex_raw(0x6D6D6Du32) }
    }
    // looks3 group d: the frame is the theme's bitmap (win3_frame); the head itself is bare.
    var head_w: f32 = 112.0
    if width > 0.0 { head_w = width }
    // round 15: the dark head is the native list-style combo (22 + 1 high, Segoe UI 9 pt, text from x 4), as `combo_box` draws it
    var head_h: f32 = 21.0
    var text_h: f32 = 21.0
    if dark {
        head_h = 23.0
        text_h = 22.0
    }
    var look = style.ResolvedControl { background: paint.rgba(0.0, 0.0, 0.0, 0.0), foreground: c.ink, border: paint.rgba(0.0, 0.0, 0.0, 0.0), border_width: 0.0, focus_ring: 0.0, opacity: 1.0, radius: 0.0, elevation: 0u8, padding: 0.0, padding_start: 0.0, padding_y: 0.0, custom_padding: true, min_width: head_w, min_height: head_h, corners: zero }
    var words = text_options()
    words.role = .BodyMedium
    words.wrap = .None
    var value_color = c.ink
    if !chosen && enabled { value_color = style.color(t.tokens, .TextMuted) }
    var (bar_t, bar_error) = win3_dialog_theme(a, t)
    if dark { (bar_t, bar_error) = windows_edit_theme(a, t, 15.0) }
    if bar_error != ok { ret (zero, bar_error) }
    let (value_node, value_error) = colored_text(a, 0u64, shown, &bar_t, words, value_color)
    if value_error != ok { ret (zero, value_error) }
    // The chevron: darker under the pointer (unmeasured), paler disabled; wide table while focused.
    var chevron_scale: f32 = 1.0
    // looks5 group d: no chevron change under the pointer (the captured hovers have the rest chevron).
    if !enabled { chevron_scale = 0.5 }
    if dark { chevron_scale = 0.0 }
    let focused = state.focused && enabled
    let (chevron, chevron_error) = win3_chevron(a, c.ink, focused, false, chevron_scale)
    if chevron_error != ok { ret (zero, chevron_error) }
    let (bits, bits_error) = mem.alloc[widget.Node](a, 4usize)
    if bits_error != ok { ret (zero, TooLarge) }
    bits[0usize] = value_node
    if lead.len == 1usize {
        bits[2usize] = lead[0usize]
        bits[3usize] = value_node
        bits[0usize] = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 3.0 }, style.defaults(), bits[2usize..4usize])
    }
    bits[1usize] = chevron
    var spread = style.defaults()
    spread.width = style.Length { Px: head_w }
    spread.height = style.Length { Px: text_h }
    spread.padding = edges(3.0, 0.0, 0.0, 0.0)
    if dark { spread.padding = edges(4.0, 0.0, 0.0, 0.0) }
    let row = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .SpaceBetween, cross: .Center, gap: 0.0 }, spread, bits[0usize..2usize])
    var tone: f32 = 0.0
    if !enabled { tone = 0.5 }
    var head_look = 0u32
    if open && enabled { head_look = 1u32 }
    if state.pressed && enabled { head_look = 2u32 }
    // looks5 group d: only the drop button's pointer shows the hot frame (v3's edit under the pointer is as at rest).
    if enabled && !open && !state.pressed && control_state(t, key + 1048703u64, enabled, false).hovered { head_look = 4u32 }
    var frame: widget.Node = zero
    var frame_error: err = ok
    if dark {
        var native_state = 0u32
        if focused { native_state = 1u32 }
        if open || state.pressed { native_state = 3u32 }
        if !enabled { native_state = 2u32 }
        let (made_frame, made_error) = winedit.native_combo(a, 1u32, native_state, head_w, text_h)
        frame = made_frame
        frame_error = made_error
    } else {
        let (made_frame, made_error) = win3_frame(a, c.face, style.color(t.tokens, .Background), tone, false, head_w, 21.0, edge_y, edge_x, head_look)
        frame = made_frame
        frame_error = made_error
    }
    if frame_error != ok { ret (zero, frame_error) }
    let (layers, layers_error) = mem.alloc[widget.Node](a, 4usize)
    if layers_error != ok { ret (zero, TooLarge) }
    layers[0usize] = frame
    layers[1usize] = row
    var count = 2usize
    if focused && !dark {
        // v3 rings a focused list-style combo's text area with its dotted focus rectangle.
        let (dots, dots_error) = win3_dots(a, style.color(t.tokens, .Text), max_zero(head_w - 22.0), 16.0)
        if dots_error != ok { ret (zero, dots_error) }
        let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
        if held_error != ok { ret (zero, TooLarge) }
        held[0usize] = dots
        layers[2usize] = widget.positioned(0u64, 3.0, 3.0, style.defaults(), held[0usize..1usize])
        count = 3usize
    }
    var zone_style = sized_style(17.0, head_h)
    zone_style.overflow = .Visible
    let (zone_held, zone_held_error) = mem.alloc[widget.Node](a, 1usize)
    if zone_held_error != ok { ret (zero, TooLarge) }
    var zone_none: []const widget.Node = zero
    zone_held[0usize] = widget.region(key + 1048703u64, widget.Region { gesture: widget.GestureAction { ctx: mem.cast[*void](toggle), invoke: press_tap }, gestures: 1u8 | 4u8, enabled: enabled, focusable: false }, zone_style, zone_none)
    layers[count] = widget.positioned(0u64, head_w - 17.0, 0.0, zone_style, zone_held[0usize..1usize])
    count += 1usize
    var content_w = head_w
    if dark { content_w = head_w + 1.0 }
    let content = widget.stack(0u64, sized_style(content_w, head_h), layers[0usize..count])
    var states = 0u32
    if open { states = accessibility.STATE_EXPANDED }
    let (head_node, head_error) = pressable_states(a, key, t, 3u8, shown, look, enabled, false, states, accessibility.ACTION_SHOW_MENU, key + 1u64, toggle, content)
    ret (head_node, head_error)
}

// The row of the drop-down that stands lit: the one under the pointer, else `active`.
fn win_lit_row(t: *const Theme, first: widget.Key, count: usize, active: usize) -> usize {
    if mem.address_of(t.runtime) == 0usize { ret active }
    var i = 0usize
    while i < count {
        if widget.interaction(t.runtime, first + u64(i)).hovered { ret i }
        i += 1usize
    }
    ret active
}

// A drop-down row: `label` (after an optional pic) 4 in, 15 tall (18 with an pic);
// lit, #0078D7 under white text.
// round 12: whether the lit row of a drop list wears the XOR focus rectangle: the native dark list-style combo does, the editable one does not.
var win_drop_dots: bool = true
// round 13: the parity of the index of the row being built (a dark list's XOR rectangle phase, see win4_xor_paint)
var win_row_parity: usize = 0usize

fn win_row(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, lit: bool, action: *const widget.Submit, pic: []const widget.Node, focusable: bool, line: f32) -> (widget.Node, err) {
    var ink = style.color(t.tokens, .Text)
    var fill = paint.rgba(0.0, 0.0, 0.0, 0.0)
    if lit {
        ink = style.hex_raw(16777215u32)
        fill = style.hex(30935u32)
        // round 10: the native dark list's selected row is the system #0078D7 (combo-*-open, listbox-selected-*)
        if t.tokens.palette == .Dark { fill = style.hex_raw(0x0078D7u32) }
    }
    var h = line
    if pic.len == 1usize { h = win_icon_row_height() }
    var words = text_options()
    words.role = .BodyMedium
    words.wrap = .None
    var (dialog_t, dialog_error) = win3_dialog_theme(a, t)
    if dialog_error != ok { ret (zero, dialog_error) }
    // round 12: the native dark drop list rows are 15 high Segoe UI 9 pt (combo-*-open), text origin x 3
    let native_row = t.tokens.palette == .Dark && t.tokens.profile == .Windows && line >= 15.0
    if native_row {
        let (dark_t, dark_error) = windows_edit_theme(a, t, 15.0)
        if dark_error != ok { ret (zero, dark_error) }
        dialog_t = dark_t
    }
    let (plain_node, label_error) = colored_text(a, 0u64, label, &dialog_t, words, ink)
    if label_error != ok { ret (zero, label_error) }
    var label_node = plain_node
    if pic.len == 1usize {
        // looks12: the Sort list (the only list with pictures) is Tahoma 12 px at GDI's whole-pixel advances: "Ascending" is 56 wide, the outline text 50
        let (gdi_node, _, gdi_error) = win_gdi_glyphs(a, &dialog_t, words, ink, label)
        if gdi_error != ok { ret (zero, gdi_error) }
        label_node = gdi_node
    }
    // round 17: the native dark list sets its text one row higher than the line box centres it (combo-list-open: ink rows 71 to 79 in a 15 row)
    if native_row && pic.len == 0usize {
        label_node = widget.positioned(0u64, 0.0, 0.0 - 1.0, style.defaults(), widget_one_of(a, label_node))
    }
    let (bits, bits_error) = mem.alloc[widget.Node](a, 2usize)
    if bits_error != ok { ret (zero, TooLarge) }
    var used = 1usize
    bits[0usize] = label_node
    if pic.len == 1usize {
        bits[0usize] = pic[0usize]
        bits[1usize] = label_node
        used = 2usize
    }
    var line_style = style.defaults()
    line_style.width = style.Length { Percent: 100.0 }
    line_style.height = style.Length { Px: h }
    var pad_left: f32 = 4.0
    var pad_under: f32 = 0.0
    if h < 14.0 {
        // looks4 group d: a TcxComboBox list (13 tall rows) starts its text 3 in and 1 higher.
        pad_left = 2.0
        pad_under = 2.0
    }
    if native_row { pad_left = 2.0 }
    line_style.padding = style.EdgeLengths { left: style.Length { Px: pad_left }, top: style.Length { Px: 0.0 }, right: style.Length { Px: 4.0 }, bottom: style.Length { Px: pad_under } }
    let (body, body_error) = mem.alloc[widget.Node](a, 1usize)
    if body_error != ok { ret (zero, TooLarge) }
    // looks12: the picture sits 2 px before the text in the captured Sort list (16 px picture, text ink at +18.7), not 4
    var row_gap: f32 = 4.0
    if pic.len == 1usize { row_gap = 2.0 }
    if pic.len == 1usize && pic[0usize].key == 7u64 { row_gap = 0.0 } // a row with no picture inside a list of picture rows (key 7: the Sort list's "None")
    body[0usize] = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: row_gap }, line_style, bits[0usize..used])
    if lit && win_drop_dots {
        // looks4 group d: the lit row carries v3's XOR focus rectangle (orange on the blue).
        let (dots, dots_error) = win4_xor_dots(a, t.tokens.palette == .Dark && t.tokens.profile == .Windows, f32(win_row_parity))
        if dots_error != ok { ret (zero, dots_error) }
        let (pair, pair_error) = mem.alloc[widget.Node](a, 2usize)
        if pair_error != ok { ret (zero, TooLarge) }
        pair[0usize] = body[0usize]
        pair[1usize] = dots
        var stack_box = style.defaults()
        stack_box.width = style.Length { Percent: 100.0 }
        stack_box.height = style.Length { Px: h }
        body[0usize] = widget.stack(0u64, stack_box, pair[0usize..2usize])
    }
    var row_style = style.defaults()
    row_style.width = style.Length { Percent: 100.0 }
    row_style.height = style.Length { Px: h }
    row_style.background = paint.Brush { Solid: fill }
    row_style.overflow = .Clip
    ret (widget.region(key, widget.Region { gesture: widget.GestureAction { ctx: mem.cast[*void](action), invoke: press_tap }, gestures: 1u8 | 4u8, enabled: true, focusable: focusable }, row_style, body[0usize..1usize]), ok)
}

fn win_drop_row(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, lit: bool, action: *const widget.Submit) -> (widget.Node, err) {
    var none: []const widget.Node = zero
    var row_line: f32 = 13.0
    if win_dark(t) { row_line = 15.0 }
    let (made, made_error) = win_row(a, key, t, label, lit, action, none, false, row_line)
    ret (made, made_error)
}

// The drop-down's frame round `items`: white, a 1 px grey edge, square; past
// `win_drop_rows` rows the rows scroll in a viewport (keyed `scroll_key`).
fn win_sheet(a: *mem.Arena, t: *const Theme, scroll_key: widget.Key, items: []const widget.Node, row_h: f32, max_rows: usize, lit: usize, ground: u32) -> (widget.Node, err) {
    // looks4 group d: the popup is a 1 px #0078D7 box (measured on TcxComboBoxPopupWindow grabs), no
    // shadow inside the window rect, and past eight rows a 16 wide #F0F0F0 scroll track with a 2 wide thumb.
    var frame_style = style.defaults()
    frame_style.background = paint.Brush { Solid: style.color(t.tokens, .Surface) }
    if ground != 0u32 { frame_style.background = paint.Brush { Solid: style.hex(ground) } }
    frame_style.border = style.Border { width: 1.0, color: style.hex(30935u32) }
    // round 10: the native dark drop list is #202020 inside a 1 px #7A7A7A line (combo-edit-open, combo-list-open)
    if t.tokens.palette == .Dark {
        frame_style.background = paint.Brush { Solid: style.hex_raw(0x202020u32) }
        frame_style.border = style.Border { width: 1.0, color: style.hex_raw(0x7A7A7Au32) }
    }
    frame_style.padding = edges(1.0, 1.0, 1.0, 1.0)
    if win_dark(t) {
        // the native dark drop list: the rows and its 1 px line, nothing more (combo-*-open: 8 rows of 15 in 122)
        var shown_rows = items.len
        if shown_rows > max_rows { shown_rows = max_rows }
        frame_style.height = style.Length { Px: f32(shown_rows) * row_h + 2.0 }
    }
    frame_style.min_width = style.Length { Px: 40.0 }
    frame_style.overflow = .Clip
    var shown: []const widget.Node = items
    if items.len > max_rows {
        var view_style = style.defaults()
        view_style.width = style.Length { Flex: 1.0 }
        view_style.height = style.Length { Px: f32(max_rows) * row_h }
        view_style.overflow = .Clip
        let (stacked, stacked_error) = mem.alloc[widget.Node](a, 1usize)
        if stacked_error != ok { ret (zero, TooLarge) }
        stacked[0usize] = widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Start, gap: 0.0 }, style.defaults(), items)
        let view = widget.scroll(scroll_key, widget.Scroll { axis: .Vertical, offset: 0.0, overscroll: .Clamp, momentum: true, scrollbar: false, thumb: paint.rgba(0.0, 0.0, 0.0, 0.0), change: zero, virtual_first: 0usize, virtual_count: 0usize, virtual_extent: 0.0, fades: false, virtual_extras: zero }, view_style, stacked[0usize..1usize])
        // looks5 group d: the track is painted at the list's right edge (16 wide, inside the 1 px frame).
        let (cells, cells_error) = mem.alloc[Win4Track](a, 1usize)
        if cells_error != ok { ret (zero, TooLarge) }
        cells[0usize] = Win4Track { rows: u32(items.len) }
        var none: []const widget.Node = zero
        var fill = style.defaults()
        fill.width = style.Length { Percent: 100.0 }
        fill.height = style.Length { Percent: 100.0 }
        let track = widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: win3_measure, paint: win5_track_paint, state: widget.bytes_of[Win4Track](&cells[0usize]) } }, style: fill, children: none }
        view_style.width = style.Length { Percent: 100.0 }
        let wide_view = widget.scroll(scroll_key, widget.Scroll { axis: .Vertical, offset: 0.0, overscroll: .Clamp, momentum: true, scrollbar: false, thumb: paint.rgba(0.0, 0.0, 0.0, 0.0), change: zero, virtual_first: 0usize, virtual_count: 0usize, virtual_extent: 0.0, fades: false, virtual_extras: zero }, view_style, stacked[0usize..1usize])
        let (pair, pair_error) = mem.alloc[widget.Node](a, 2usize)
        if pair_error != ok { ret (zero, TooLarge) }
        pair[0usize] = wide_view
        pair[1usize] = track
        let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
        if held_error != ok { ret (zero, TooLarge) }
        var across = style.defaults()
        across.width = style.Length { Percent: 100.0 }
        across.height = style.Length { Px: f32(max_rows) * row_h }
        held[0usize] = widget.stack(0u64, across, pair[0usize..2usize])
        shown = held[0usize..1usize]
    }
    let framed = widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, frame_style, shown)
    // looks5 group d: v3's popup frames land between pixels for some list sizes (measured per size on the
    // popup grabs): 3 rows of 13 (Row Color), 3 of 15 (Card Art Position), 15 of 15 (Condition) show a
    // soft bottom line (67 % blue), and the right line is absent (Row Color, Card Art) or half (Condition).
    var soft_bottom: f32 = 1.0
    var soft_right: f32 = 1.0
    var inner = 16777215u32
    if items.len == 3usize && row_h == 13.0 {
        soft_bottom = 0.675
        soft_right = 0.0
        inner = 16580095u32
    }
    if items.len == 3usize && row_h == 15.0 {
        soft_bottom = 0.67
        soft_right = 0.0
        inner = 16580095u32
    }
    if items.len == 15usize && row_h == 15.0 {
        soft_bottom = 0.667
        soft_right = 0.5
        inner = 16711423u32
    }
    if lit + 1usize == items.len { soft_bottom = 1.0 }
    if soft_bottom == 1.0 && soft_right == 1.0 { ret (framed, ok) }
    let (cells, cells_error) = mem.alloc[Win5Edges](a, 1usize)
    if cells_error != ok { ret (zero, TooLarge) }
    cells[0usize] = Win5Edges { bottom: soft_bottom, right: soft_right, inner: inner, lit: u32(lit), rows: u32(items.len), row_h: row_h }
    var none: []const widget.Node = zero
    var fill = style.defaults()
    fill.width = style.Length { Percent: 100.0 }
    fill.height = style.Length { Percent: 100.0 }
    let (pair, pair_error) = mem.alloc[widget.Node](a, 2usize)
    if pair_error != ok { ret (zero, TooLarge) }
    pair[0usize] = framed
    pair[1usize] = widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: win3_measure, paint: win5_edges_paint, state: widget.bytes_of[Win5Edges](&cells[0usize]) } }, style: fill, children: none }
    var across = style.defaults()
    across.width = style.Length { Percent: 100.0 }
    across.height = style.Length { Px: f32(items.len) * row_h + 2.0 }
    ret (widget.stack(0u64, across, pair[0usize..2usize]), ok)
}

fn win5_track_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    ret win4_track_paint(ctx, b, geometry.Rect { x: area.x + area.width - 16.0, y: area.y, width: 16.0, height: area.height })
}

fn win5_flat_ring_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    // The ring and the 12 wide drop button at the right of the 127 wide control (cells measured on the
    // toolbar of the live main window): x 114 and 125 are the frame's and the button's right lines.
    let x = area.x
    let y = area.y
    let w = area.width
    let h = area.height
    try win3_rect(b, x, y, w - 1.0, 1.0, style.hex(16448250u32))
    try win3_rect(b, x + w - 1.0, y, 1.0, 1.0, style.hex(16119285u32))
    // (the card name combo's frame sides are white, the Mode combo's #F9F9F9 and #F7F7F7)
    var side_left = style.hex(16382457u32)
    var side_right = style.hex(16250871u32)
    if w != 127.0 {
        side_left = style.hex(16777215u32)
        side_right = style.hex(16777215u32)
    }
    try win3_rect(b, x, y + 1.0, 1.0, h - 1.0, side_left)
    try win3_rect(b, x + w - 13.0, y + 1.0, 1.0, 1.0, style.hex(16448250u32))
    try win3_rect(b, x + w - 13.0, y + 2.0, 1.0, h - 3.0, side_right)
    var corner_low = style.hex(16579836u32)
    if w != 127.0 { corner_low = style.hex(16777215u32) } // looks12: the card combo's button corner is white in the capture (255), the Mode combo's #FCFCFC
    try win3_rect(b, x + w - 13.0, y + h - 1.0, 1.0, 1.0, corner_low)
    try win3_rect(b, x + w - 12.0, y + 1.0, 10.0, 1.0, style.hex(16119285u32))
    try win3_rect(b, x + w - 12.0, y + 2.0, 10.0, h - 3.0, style.hex(15790320u32))
    try win3_rect(b, x + w - 12.0, y + h - 1.0, 10.0, 1.0, style.hex(16448250u32))
    try win3_rect(b, x + w - 2.0, y + 1.0, 1.0, 1.0, style.hex(16448250u32))
    try win3_rect(b, x + w - 2.0, y + 2.0, 1.0, h - 3.0, style.hex(16316664u32))
    try win3_rect(b, x + w - 2.0, y + h - 1.0, 1.0, 1.0, style.hex(16579836u32))
    ret win3_rect(b, x + w - 1.0, y + 1.0, 1.0, h - 1.0, style.hex(16250871u32))
}

type Win5Edges = struct { bottom: f32, right: f32, inner: u32, lit: u32, rows: u32, row_h: f32 }

fn win5_edges_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let m = mem.cast[*Win5Edges](ctx)
    let blue = style.hex(30935u32)
    let white = style.hex(16777215u32)
    let pale = style.hex(m.inner)
    var r = 0u32
    while r < m.rows {
        let top = area.y + 1.0 + f32(r) * m.row_h
        if r == m.lit {
            if m.right < 1.0 { try win3_rect(b, area.x + area.width - 2.0, top, 2.0, m.row_h, blue) }
        } else {
            if m.right < 1.0 { try win3_rect(b, area.x + area.width - 1.0, top, 1.0, m.row_h, style.mix(white, blue, m.right)) }
            try win3_rect(b, area.x + 1.0, top, 1.0, m.row_h, pale)
        }
        r += 1u32
    }
    // looks11: where the right line is absent the tint under the top line runs to the last column (Row Color, Card Art Position).
    var tint_w = area.width - 2.0
    if m.right == 0.0 { tint_w = area.width - 1.0 }
    if m.lit != 0u32 { try win3_rect(b, area.x + 1.0, area.y + 1.0, tint_w, 1.0, pale) }
    if m.bottom < 1.0 { try win3_rect(b, area.x + 1.0, area.y + area.height - 1.0, area.width - 1.0, 1.0, style.mix(white, blue, m.bottom)) }
    ret ok
}

// The open list under a head: a modal overlay keyed `overlay_key` of the rows keyed
// `first + index`, matching the anchor's width; a press outside fires `dismiss`.
fn win_drop(a: *mem.Arena, overlay_key: widget.Key, anchor: widget.Key, first: widget.Key, t: *const Theme, label: str, options: []const str, icons: []const widget.Node, selected: usize, picks: []const widget.Submit, dismiss: *const widget.Submit) -> (widget.Node, err) {
    let (body, body_error) = win_drop_body(a, overlay_key, first, t, label, options, icons, selected, picks, 0.0, 15usize, 0u32)
    if body_error != ok { ret (zero, body_error) }
    let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
    if held_error != ok { ret (zero, TooLarge) }
    held[0usize] = body
    ret (widget.overlay(overlay_key, widget.Overlay { anchor: anchor, placement: .BelowMatch, offset: geometry.Point { x: 0.0, y: 0.0 }, modal: true, dismiss: *dismiss }, style.defaults(), held[0usize..1usize]), ok)
}

// looks5 group d: the open list on its own, `width` wide (the popup window of a capture, without its head),
// rows keyed `key + 1 + index`; `selected` is the lit row. Windows look only.
fn win_list_standalone(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, options: []const str, icons: []const widget.Node, selected: usize, picks: []const widget.Submit, width: f32, row_h: f32, max_rows: usize, ground: u32) -> (widget.Node, err) {
    let (body, body_error) = win_drop_body(a, key, key + 1u64, t, label, options, icons, selected, picks, row_h, max_rows, ground)
    if body_error != ok { ret (zero, body_error) }
    var box = style.defaults()
    box.width = style.Length { Px: width }
    let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
    if held_error != ok { ret (zero, TooLarge) }
    held[0usize] = body
    ret (widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, box, held[0usize..1usize]), ok)
}

fn win_drop_body(a: *mem.Arena, overlay_key: widget.Key, first: widget.Key, t: *const Theme, label: str, options: []const str, icons: []const widget.Node, selected: usize, picks: []const widget.Submit, row_h: f32, max_rows: usize, ground: u32) -> (widget.Node, err) {
    let (items, items_error) = mem.alloc[widget.Node](a, options.len)
    if items_error != ok { ret (zero, TooLarge) }
    let lit = win_lit_row(t, first, options.len, selected)
    var rowh = win_row_height()
    if icons.len == options.len { rowh = win_icon_row_height() }
    if row_h > 0.0 { rowh = row_h }
    var i = 0usize
    while i < options.len {
        var pic: []const widget.Node = zero
        if icons.len == options.len { pic = icons[i..i + 1usize] }
        win_row_parity = i % 2usize
        let (row, row_error) = win_row(a, first + u64(i), t, options[i], i == lit, &picks[i], pic, false, rowh)
        if row_error != ok { ret (zero, row_error) }
        var entry: widget.Semantics = zero
        entry.role = accessibility.ROLE_OPTION
        entry.label = options[i]
        if i == selected { entry.states = accessibility.STATE_SELECTED }
        let (wrapped, wrapped_error) = mem.alloc[widget.Node](a, 1usize)
        if wrapped_error != ok { ret (zero, TooLarge) }
        wrapped[0usize] = row
        var stretched = style.defaults()
        stretched.width = style.Length { Percent: 100.0 }
        items[i] = widget.semantics(0u64, entry, stretched, wrapped[0usize..1usize])
        i += 1usize
    }
    let (sheet_node, sheet_error) = win_sheet(a, t, overlay_key + 1048576u64, items[0usize..options.len], rowh, max_rows, lit, ground)
    if sheet_error != ok { ret (zero, sheet_error) }
    var list_sem: widget.Semantics = zero
    list_sem.role = accessibility.ROLE_LISTBOX
    list_sem.label = label
    list_sem.row_count = u32(options.len)
    let (inner, inner_error) = mem.alloc[widget.Node](a, 1usize)
    if inner_error != ok { ret (zero, TooLarge) }
    inner[0usize] = sheet_node
    ret (widget.semantics(0u64, list_sem, style.defaults(), inner[0usize..1usize]), ok)
}

// A select (and so a picker's popup): the head, and open, the drop-down keyed `key + 1`
// with rows keyed `key + 2 + index`; no motion, as v3's list appears at once.
fn win_select(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, options: []const str, selected: usize, open: bool, toggle: *const widget.Submit, picks: []const widget.Submit) -> (widget.Node, err) {
    var none: []const widget.Node = zero
    let (made, made_error) = win_image_select(a, key, t, label, options, none, selected, open, true, toggle, picks, 0.0, 0.0, 0.0)
    ret (made, made_error)
}

// An image combo box (TcxImageComboBox): a select whose rows, and head, lead with an
// pic (`icons`, one 16 x 16 node per option, or none). Under the other looks it is the
// plain select: no icons.
fn image_select(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, options: []const str, icons: []const widget.Node, selected: usize, open: bool, enabled: bool, toggle: *const widget.Submit, picks: []const widget.Submit) -> (widget.Node, err) {
    if t.tokens.profile == .MaterialLike {
        let (pictured, pictured_error) = select_led(a, key, t, label, options, selected, open, toggle, picks, icons)
        if pictured_error != ok { ret (zero, pictured_error) }
        if enabled { ret (pictured, ok) }
        // Disabled: the whole field at the M3 `on-surface` 38 % content level.
        var dimmed = style.defaults()
        dimmed.opacity = t.tokens.states.disabled_content
        dimmed.padding.top = style.Length { Px: 10.0 }
        let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
        if held_error != ok { ret (zero, TooLarge) }
        held[0usize] = pictured
        ret (widget.box(0u64, dimmed, held[0usize..1usize]), ok)
    }
    if t.tokens.profile != .Windows {
        let (plain, plain_error) = select_icons(a, key, t, label, options, icons, selected, open, enabled, toggle, picks)
        if plain_error != ok { ret (zero, plain_error) }
        // Neper dark: the disabled select is the whole field at the disabled content level (the light Neper picture is unchanged).
        if !enabled && t.tokens.profile == .Neper && t.tokens.palette == .Dark {
            var dimmed = style.defaults()
            dimmed.opacity = t.tokens.states.disabled_content
            // the label stands on the frame's top edge, above the head's box: the dimmed box takes it in and gives the room back
            dimmed.padding.top = style.Length { Px: 10.0 }
            dimmed.margin.top = style.Length { Px: -10.0 }
            let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
            if held_error != ok { ret (zero, TooLarge) }
            held[0usize] = plain
            ret (widget.box(0u64, dimmed, held[0usize..1usize]), ok)
        }
        ret (plain, ok)
    }
    let (made, made_error) = win_image_select(a, key, t, label, options, icons, selected, open, enabled, toggle, picks, 0.0, 0.0, 0.0)
    ret (made, made_error)
}

// `image_select` with the head `width` wide (v3's TcxImageComboBox has its own Width); 0 is the
// default of at least 112. Under the other looks the plain select, whose width the caller sets.
fn image_select_wide(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, options: []const str, icons: []const widget.Node, selected: usize, open: bool, enabled: bool, toggle: *const widget.Submit, picks: []const widget.Submit, width: f32) -> (widget.Node, err) {
    if t.tokens.profile != .Windows {
        let (plain, plain_error) = select_icons(a, key, t, label, options, icons, selected, open, enabled, toggle, picks)
        ret (plain, plain_error)
    }
    let (made, made_error) = win_image_select(a, key, t, label, options, icons, selected, open, enabled, toggle, picks, width, 0.0, 0.0)
    ret (made, made_error)
}

// `image_select_wide` with the head's window y (v3's frame phase drifts with it: see win3_frame_paint).
fn image_select_at(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, options: []const str, icons: []const widget.Node, selected: usize, open: bool, enabled: bool, toggle: *const widget.Submit, picks: []const widget.Submit, width: f32, edge_y: f32, edge_x: f32) -> (widget.Node, err) {
    if t.tokens.profile != .Windows {
        let (plain, plain_error) = select_icons(a, key, t, label, options, icons, selected, open, enabled, toggle, picks)
        ret (plain, plain_error)
    }
    let (made, made_error) = win_image_select(a, key, t, label, options, icons, selected, open, enabled, toggle, picks, width, edge_y, edge_x)
    ret (made, made_error)
}

fn win_image_select(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, options: []const str, icons: []const widget.Node, selected: usize, open: bool, enabled: bool, toggle: *const widget.Submit, picks: []const widget.Submit, width: f32, edge_y: f32, edge_x: f32) -> (widget.Node, err) {
    let (made, made_error) = win_image_select_head(a, key, t, label, options, icons, selected, selected, open, enabled, toggle, picks, width, edge_y, edge_x)
    ret (made, made_error)
}

