    stack[0usize] = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .SpaceBetween, cross: .Center, gap: 8.0 }, bar, bits[0usize..2usize])
    var rule = sized_style(inner, t.tokens.sizes.divider)
