    let rest_r: [3][6]u32 = [3][6]u32{
        [6]u32{ 0xBABABAu32, 0xBABABAu32, 0xBABABAu32, 0xBABABAu32, 0xBFBFBFu32, 0xDFDFDFu32 },
        [6]u32{ 0x858585u32, 0x858585u32, 0x858585u32, 0x858585u32, 0x8E8E8Eu32, 0xCECECEu32 },
        [6]u32{ 0xBABABAu32, 0xBABABAu32, 0xBABABAu32, 0xBABABAu32, 0xBFBFBFu32, 0xDFDFDFu32 } }
    let rest_m: [3]u32 = [3]u32{ 0xBABABAu32, 0x858585u32, 0xBABABAu32 }
    let rest_h: [3]f32 = [3]f32{ 1.0, 8.0, 1.0 }
    // hot: 3 top rows, 8 body rows, 3 bottom rows
    let hot_l: [7][6]u32 = [7][6]u32{
        [6]u32{ 0xF0F0F0u32, 0xDCDCDCu32, 0xC4C4C4u32, 0xBBBBBBu32, 0xBABABAu32, 0xBABABAu32 },
        [6]u32{ 0xDADADAu32, 0xADADADu32, 0x8F8F8Fu32, 0x868686u32, 0x858585u32, 0x858585u32 },
        [6]u32{ 0xB5B5B5u32, 0x8C8C8Cu32, 0x858585u32, 0x858585u32, 0x858585u32, 0x858585u32 },
        [6]u32{ 0xA7A7A7u32, 0x878787u32, 0x858585u32, 0x858585u32, 0x858585u32, 0x858585u32 },
        [6]u32{ 0xB8B8B8u32, 0x8D8D8Du32, 0x858585u32, 0x858585u32, 0x858585u32, 0x858585u32 },
        [6]u32{ 0xDCDCDCu32, 0xABABABu32, 0x8E8E8Eu32, 0x868686u32, 0x858585u32, 0x858585u32 },
        [6]u32{ 0xF0F0F0u32, 0xDADADAu32, 0xC3C3C3u32, 0xBBBBBBu32, 0xBABABAu32, 0xBABABAu32 } }
    let hot_r: [7][6]u32 = [7][6]u32{
        [6]u32{ 0xBABABAu32, 0xBABABAu32, 0xBCBCBCu32, 0xCACACAu32, 0xE5E5E5u32, 0xF0F0F0u32 },
        [6]u32{ 0x858585u32, 0x858585u32, 0x878787u32, 0x959595u32, 0xC0C0C0u32, 0xE6E6E6u32 },
        [6]u32{ 0x858585u32, 0x858585u32, 0x858585u32, 0x858585u32, 0x989898u32, 0xD4D4D4u32 },
        [6]u32{ 0x858585u32, 0x858585u32, 0x858585u32, 0x858585u32, 0x898989u32, 0xCCCCCCu32 },
        [6]u32{ 0x858585u32, 0x858585u32, 0x858585u32, 0x858585u32, 0x969696u32, 0xD3D3D3u32 },
        [6]u32{ 0x858585u32, 0x858585u32, 0x878787u32, 0x979797u32, 0xC0C0C0u32, 0xE5E5E5u32 },
        [6]u32{ 0xBABABAu32, 0xBABABAu32, 0xBCBCBCu32, 0xCDCDCDu32, 0xE6E6E6u32, 0xF0F0F0u32 } }
    let hot_m: [7]u32 = [7]u32{ 0xBABABAu32, 0x858585u32, 0x858585u32, 0x858585u32, 0x858585u32, 0x858585u32, 0xBABABAu32 }
    let hot_h: [7]f32 = [7]f32{ 1.0, 1.0, 1.0, 8.0, 1.0, 1.0, 1.0 }
    var rows = 3usize
    if hot { rows = 7usize }
    var y: f32 = 0.0
    var r = 0usize
    while r < rows {
        var h: f32 = 0.0
        var m: u32 = 0u32
        if hot {
            h = hot_h[r]
            m = hot_m[r]
        } else {
            h = rest_h[r]
            m = rest_m[r]
        }
        // the row as runs of equal pixels (#F0F0F0 is the track: left out)
        var run_value: u32 = 0u32
        var run_start: f32 = 0.0
        var c = 0usize
        while c <= 13usize {
            var value: u32 = 0u32
            var cx: f32 = 0.0
            var cw: f32 = 1.0
            if c < 6usize {
                cx = f32(c)
                if hot { value = hot_l[r][c] } else { value = rest_l[r][c] }
            } else if c == 6usize {
                cx = 6.0
                cw = w - 12.0
                value = m
            } else if c < 13usize {
                cx = w - 6.0 + f32(c - 7usize)
                if hot { value = hot_r[r][c - 7usize] } else { value = rest_r[r][c - 7usize] }
            } else {
                cx = w
                value = 1u32
            }
            if c == 0usize {
                run_value = value
                run_start = 0.0
            } else if value != run_value || c == 13usize {
                if run_value != 0xF0F0F0u32 {
                    var piece = sized_style(cx - run_start, h)
                    piece.background = paint.Brush { Solid: gl.rgb(run_value) }
                    parts[n] = widget.positioned(0u64, run_start, y, style.defaults(), one_widget(a, widget.box(0u64, piece, zero)))
                    n += 1usize
                }
                run_value = value
                run_start = cx
            }
            c += 1usize
        }
        y += h
        r += 1usize
    }
    ret (widget.stack(0u64, style.defaults(), parts[0usize..n]), ok)
}

// round 13: the 7 wide pill of a hot or held vertical thumb of the live main window (states/hover-scroll-bar-vertical-thumb): per column the
// end pixels (top, then bottom) round a constant body; columns 0 and 6 start a row lower. `h` is the pill's height.
fn windows_pill(a: *mem.Arena, h: f32) -> (widget.Node, err) {
    let (parts, parts_error) = mem.alloc[widget.Node](a, 48usize)
    if parts_error != ok { ret (zero, TooLarge) }
    var n = 0usize
    let tops: [7][4]u32 = [7][4]u32{
        [4]u32{ 0xDCDCDCu32, 0xC2C2C2u32, 0xB7B7B7u32, 0u32 },
        [4]u32{ 0xDEDEDEu32, 0xB0B0B0u32, 0x8F8F8Fu32, 0x868686u32 },
        [4]u32{ 0xC0C0C0u32, 0x909090u32, 0u32, 0u32 },
        [4]u32{ 0xB3B3B3u32, 0x888888u32, 0u32, 0u32 },
        [4]u32{ 0xC0C0C0u32, 0x909090u32, 0u32, 0u32 },
        [4]u32{ 0xDFDFDFu32, 0xB5B5B5u32, 0x929292u32, 0x868686u32 },
        [4]u32{ 0xE1E1E1u32, 0xCACACAu32, 0xC0C0C0u32, 0u32 } }
    let feet: [7][4]u32 = [7][4]u32{
        [4]u32{ 0xB8B8B8u32, 0xC9C9C9u32, 0xE4E4E4u32, 0u32 },
        [4]u32{ 0x878787u32, 0x959595u32, 0xBBBBBBu32, 0xE3E3E3u32 },
        [4]u32{ 0x949494u32, 0xCFCFCFu32, 0u32, 0u32 },
        [4]u32{ 0x898989u32, 0xC8C8C8u32, 0u32, 0u32 },
        [4]u32{ 0x989898u32, 0xD2D2D2u32, 0u32, 0u32 },
        [4]u32{ 0x878787u32, 0x969696u32, 0xC1C1C1u32, 0xE6E6E6u32 },
        [4]u32{ 0xC1C1C1u32, 0xCDCDCDu32, 0xE5E5E5u32, 0u32 } }
    let ends: [7]usize = [7]usize{ 3usize, 4usize, 2usize, 2usize, 2usize, 4usize, 3usize }
    let first: [7]usize = [7]usize{ 1usize, 0usize, 0usize, 0usize, 0usize, 0usize, 1usize }
    let body: [7]u32 = [7]u32{ 0xB6B6B6u32, 0x858585u32, 0x858585u32, 0x858585u32, 0x858585u32, 0x858585u32, 0xBFBFBFu32 }
    var c = 0usize
    while c < 7usize {
        let col = f32(c)
        let k = ends[c]
        let top_at = f32(first[c])
        let foot_at = h - f32(first[c]) - f32(k)
        var j = 0usize
        while j < k {
            var st = sized_style(1.0, 1.0)
            st.background = paint.Brush { Solid: gl.rgb(tops[c][j]) }
            parts[n] = widget.positioned(0u64, col, top_at + f32(j), style.defaults(), one_widget(a, widget.box(0u64, st, zero)))
            n += 1usize
            var sf = sized_style(1.0, 1.0)
            sf.background = paint.Brush { Solid: gl.rgb(feet[c][j]) }
            parts[n] = widget.positioned(0u64, col, foot_at + f32(j), style.defaults(), one_widget(a, widget.box(0u64, sf, zero)))
            n += 1usize
            j += 1usize
        }
        var sb = sized_style(1.0, h - 2.0 * (top_at + f32(k)))
        sb.background = paint.Brush { Solid: gl.rgb(body[c]) }
        parts[n] = widget.positioned(0u64, col, top_at + f32(k), style.defaults(), one_widget(a, widget.box(0u64, sb, zero)))
        n += 1usize
        c += 1usize
    }
    ret (widget.stack(0u64, style.defaults(), parts[0usize..n]), ok)
}

fn one_widget(a: *mem.Arena, node: widget.Node) -> []widget.Node {
    let (nodes, nodes_error) = mem.alloc[widget.Node](a, 1usize)
    if nodes_error != ok { ret zero }
    nodes[0usize] = node
    ret nodes[0usize..1usize]
}

// ---- round 15: the native Windows 11 SysLink (syslink-* of docs/ui/looks/ref/windows-native/{light,dark}) -----------------------------------
// "Text with a link and another." in Segoe UI 12 px, 15 high, cap top on row 3: the plain runs white (dark) or black (light), grey #6D6D6D
// when disabled in the dark gallery (light disabled is its rest look), the two links #0066CC in every state with a one row underline
// 13 under the top across the whole run; focused, the first link carries the dotted rectangle (DrawFocusRect over the run, 15 high,
// the page colour and black on every other pixel from the corner, even pixels lit). Each run starts on the whole pixel after the
// advance of the runs before it.
fn windows_syslink(a: *mem.Arena, t: *const Theme, lead: str, first: str, mid: str, second: str, tail: str, focus_first: bool, enabled: bool) -> (widget.Node, err) {
    let (ft, ft_error) = windows_edit_theme(a, t, 13.0)
    if ft_error != ok { ret (zero, ft_error) }
    var options = text_options()
    options.face = 7u32
    options.size = 12.0
    options.weight = 400u32
    options.wrap = .None
    var plain = style.hex_raw(0x000000u32)
    var page: u32 = 0xF0F0F0u32
    if t.tokens.palette == .Dark {
        plain = style.hex_raw(0xFFFFFFu32)
        if !enabled { plain = style.hex_raw(0x6D6D6Du32) }
        page = 0xDFDFDFu32
    }
    let link_ink = style.hex_raw(0x0066CCu32)
    let runs = [5]str{ lead, first, mid, second, tail }
    let (layers, layers_error) = mem.alloc[widget.Node](a, 8usize)
    if layers_error != ok { ret (zero, TooLarge) }
    var n = 0usize
    var x: f32 = 0.0
    var focus_at: f32 = 0.0
    var focus_w: f32 = 0.0
    var i = 0usize
    while i < 5usize {
        let is_link = i == 1usize || i == 3usize
        var ink = plain
        if is_link { ink = link_ink }
        let (words, words_error) = colored_text(a, 0u64, runs[i], &ft, options, ink)
        if words_error != ok { ret (zero, words_error) }
        var (advance, fit, base, metrics_error) = run_metrics_faced(a, &ft, options, runs[i])
        if metrics_error != ok { ret (zero, metrics_error) }
        // GDI sets a run on the font's whole pixel advances where it has them
        let (look, look_error) = text_style_faced(a, &ft, options)
        if look_error != ok { ret (zero, look_error) }
        if look.fonts.len != 0usize {
            var whole: f32 = 0.0
            var whole_ok = true
            var k = 0usize
            while k < runs[i].len {
                let (step, has_step) = winhint.advance(look.fonts[0usize].font, u32(look.fonts[0usize].size + 0.5), u32(runs[i][k]))
                if !has_step { whole_ok = false }
                whole += f32(step)
                k += 1usize
            }
            if whole_ok { advance = whole }
        }
        let at = f32(i32(x + 0.5))
        layers[n] = widget.positioned(0u64, at, 0.0 - 1.0, style.defaults(), mem_one_node(a, words))
        n += 1usize
        if is_link {
            var line = sized_style(f32(i32(advance + 0.5)), 1.0)
            line.background = paint.Brush { Solid: ink }
            layers[n] = widget.positioned(0u64, at, 13.0, style.defaults(), mem_one_node(a, widget.box(0u64, line, zero)))
            n += 1usize
            if i == 1usize {
                focus_at = at
                focus_w = f32(i32(advance + 0.5))
            }
        }
        x += advance
        i += 1usize
    }
    if focus_first && enabled {
        let (dots, dots_error) = dark_dots_phase(a, focus_w, 15.0, page, 1)
        if dots_error != ok { ret (zero, dots_error) }
        layers[n] = widget.positioned(0u64, focus_at, 0.0, style.defaults(), mem_one_node(a, dots))
        n += 1usize
    }
    ret (widget.stack(0u64, sized_style(x + 2.0, 15.0), layers[0usize..n]), ok)

}
// ---- round 15 (looks15-w3): pixels that never take the Windows dark map ----------------------------------------------
// A `w` x `h` bitmap of `pix` (RRGGBB per pixel) painted exactly as given: `gl.pixels` maps its colours through the dark map, a native
// dark capture's pixels must not be.
type RawPix = struct { pix: str, cols: usize }

fn raw_pixel_digit(c: u8) -> u32 {
    if c >= 97u8 { ret u32(c - 87u8) }
    if c >= 65u8 { ret u32(c - 55u8) }
    ret u32(c - 48u8)
}

fn raw_pixels_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let m = mem.cast[*RawPix](ctx)
    var n = 0usize
    var at = 0usize
    while at + 6usize <= m.pix.len {
        var run = 1usize
        let col = n % m.cols
        while col + run < m.cols && at + (run + 1usize) * 6usize <= m.pix.len {
            var same = true
            var d = 0usize
            while d < 6usize {
                if m.pix[at + d] != m.pix[at + run * 6usize + d] { same = false }
                d += 1usize
            }
            if !same { break }
            run += 1usize
        }
        var v = 0u32
        var d2 = 0usize
        while d2 < 6usize {
            v = v * 16u32 + raw_pixel_digit(m.pix[at + d2])
            d2 += 1usize
        }
        try winpx.fill(b, f32(i64(area.x + 0.5)) + f32(col), f32(i64(area.y + 0.5)) + f32(n / m.cols), f32(run), 1.0, style.hex_raw(v))
        at += 6usize * run
        n += run
    }
    ret ok
}

fn raw_pixels(a: *mem.Arena, pix: str, w: f32, h: f32) -> (widget.Node, err) {
    let (cells, cells_error) = mem.alloc[RawPix](a, 1usize)
    if cells_error != ok { ret (zero, TooLarge) }
    cells[0usize] = RawPix { pix: pix, cols: usize(w) }
    var none: []const widget.Node = zero
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: mark_measure, paint: raw_pixels_paint, state: widget.bytes_of[RawPix](&cells[0usize]) } }, style: sized_style(w, h), children: none }, ok)

}
// ---- round 15: the dark multi-line edit's scroll column -----------------------------------------------------------------
// Measured on ref/windows-native/dark/edit-multiline-explorer: a 17 wide #171717 column (x 149 of the 168 wide edit, rows 2 to 87), the
// thumb 2 wide at x 157 (#959595, its end rows #858585); its length is the track (the column less two 17 px arrow rows) times the
// visible lines over all lines (33 rows for 5 of 8), its top the track times the first line over all lines.
type WinDarkBar = struct { first: u32, rows: u32, lines: u32, classic: bool }

fn win_dark_bar_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let m = mem.cast[*WinDarkBar](ctx)
    // the unthemed bar (edit-multiline-vscroll): a #F0F0F0 column with a white left line and a #858585 thumb whose end rows are #929292
    if m.classic {
        try win3_rect(b, area.x, area.y, area.width, area.height, style.hex_raw(0xF0F0F0u32))
        try win3_rect(b, area.x, area.y, 1.0, area.height, style.hex_raw(0xFFFFFFu32))
        let classic_track = area.height - 34.0
        var classic_long = f32(u32(classic_track * f32(m.rows) / f32(m.lines) + 0.5))
        if classic_long < 8.0 { classic_long = 8.0 }
        let classic_top = area.y + 17.0 + f32(u32(classic_track * f32(m.first) / f32(m.lines) + 0.5))
        try win3_rect(b, area.x + 8.0, classic_top, 2.0, classic_long, style.hex_raw(0x858585u32))
        try win3_rect(b, area.x + 8.0, classic_top, 1.0, 1.0, style.hex_raw(0x929292u32))
        try win3_rect(b, area.x + 9.0, classic_top, 1.0, 1.0, style.hex_raw(0x939393u32))
        try win3_rect(b, area.x + 8.0, classic_top + classic_long - 1.0, 1.0, 1.0, style.hex_raw(0x929292u32))
        ret win3_rect(b, area.x + 9.0, classic_top + classic_long - 1.0, 1.0, 1.0, style.hex_raw(0x939393u32))
    }
    try win3_rect(b, area.x, area.y, area.width, area.height, style.hex_raw(0x171717u32))
    let track = area.height - 34.0
    var long = f32(u32(track * f32(m.rows) / f32(m.lines) + 0.5))
    if long < 8.0 { long = 8.0 }
    let top = area.y + 17.0 + f32(u32(track * f32(m.first) / f32(m.lines) + 0.5))
    try win3_rect(b, area.x + 8.0, top, 2.0, long, style.hex_raw(0x959595u32))
    try win3_rect(b, area.x + 8.0, top, 2.0, 1.0, style.hex_raw(0x858585u32))
    ret win3_rect(b, area.x + 8.0, top + long - 1.0, 2.0, 1.0, style.hex_raw(0x858585u32))

}
// ---- round 22: the DarkMode_Explorer edit frame (edit-multiline-explorer): a two row white rim with rounded corners and a grey foot ---
// Rows from the top: #ECECEC then #FEFEFE (corners #5D5D5D #D6D6D6 / #DCDCDC #FAFAFA); at the foot #FEFEFE (corners #DFDFDF #DDDDDD) then #838383
// (corners #696969 #8C8C8C); the left columns #ECECEC and #FEFEFE, the right ones #F7F7F7 and #E6E6E6.
