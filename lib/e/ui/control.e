// (D1261, docs/ux/components/TextField, password) A password field with its
// reveal toggle: while `revealed` the value is plain text, else bullets (never
// copied). A round `visibility` icon button (keyed `key + 1`) stands inside the
// field's end -- `primary` and `visibility-off` while revealed -- a toggle
// button named "Show password" reporting Checked while revealed; it takes no
// Tab stop, so the focus stays in the field. Masking again on blur or submit is
// the caller's, through `revealed`.
// (D1261) A toggle's Press from the tree fires its Submit.
fn reveal_semantic_action(ctx: *void, action: u32) -> err {
    if action != accessibility.ACTION_PRESS { ret ok }
    ret widget.fire_submit(*mem.cast[*const widget.Submit](ctx))
}

fn password_field_with(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, buffer: []u8, len: usize, change: widget.Change[str], submit: widget.Submit, options: FieldOptions, revealed: bool, reveal: *const widget.Submit) -> (widget.Node, err) {
    if t.tokens.profile == .Linux {
        let (gtk, gtk_error) = linux_password(a, key, t, label, buffer, len, change, submit, options, revealed, reveal)
        ret (gtk, gtk_error)
    }
    let touch = t.tokens.metrics.control_height > t.tokens.sizes.control_sm
    var side = t.tokens.sizes.control_sm
    var glyph = t.tokens.sizes.icon_sm
    if touch {
        side = t.tokens.sizes.control_md
        glyph = t.tokens.sizes.icon_md
    }
    var roomy = options
    roomy.rows = 1u32
    roomy.end_space = max_zero(side - 8.0)
    let (editor, editor_error) = field(a, key, t, label, buffer, len, change, submit, roomy, !revealed)
    if editor_error != ok { ret (zero, editor_error) }
    let state = control_state(t, key + 1u64, true, revealed)
    var ink = style.color(t.tokens, .OnSurfaceVariant)
    var eye: GlyphKind = .Visibility
    if revealed {
        ink = style.color(t.tokens, .Primary)
        eye = .VisibilityOff
    }
    let (mark, mark_error) = icon_square(a, ink, eye, glyph)
    if mark_error != ok { ret (zero, mark_error) }
    let (held, held_error) = mem.alloc[widget.Node](a, 4usize)
    if held_error != ok { ret (zero, TooLarge) }
    held[0usize] = mark
    var disc = sized_style(side, side)
    disc.radius = side * 0.5
    disc.background = paint.Brush { Solid: with_alpha(ink, state_opacity(t, state)) }
    held[1usize] = widget.aligned(0u64, .Center, .Center, disc, held[0usize..1usize])
    held[2usize] = widget.region(key + 1u64, widget.Region { gesture: widget.GestureAction { ctx: mem.cast[*void](reveal), invoke: press_tap }, gestures: 1u8 | 4u8, enabled: true, focusable: false }, style.defaults(), held[1usize..2usize])
    var sem: widget.Semantics = zero
    sem.role = 3u8
    sem.label = "Show password"
    sem.actions = accessibility.ACTION_PRESS
    sem.on_action = widget.Change[u32] { ctx: mem.cast[*void](reveal), invoke: reveal_semantic_action }
    if revealed { sem.states = accessibility.STATE_CHECKED }
    held[3usize] = widget.semantics(0u64, sem, style.defaults(), held[2usize..3usize])
    let h = t.tokens.metrics.control_height + 16.0
    let (layers, layers_error) = mem.alloc[widget.Node](a, 2usize)
    if layers_error != ok { ret (zero, TooLarge) }
    layers[0usize] = editor
    layers[1usize] = widget.positioned(0u64, options.width - 4.0 - side, max_zero((h - side) * 0.5), style.defaults(), held[3usize..4usize])
    ret (widget.stack(0u64, style.defaults(), layers[0usize..2usize]), ok)
}

// A search field: a single line whose Enter is the search (`submit`), with a clear
// button (keyed `key + 1`, the caller's `clear` action) beside it while it holds
// anything, and "Search" for a placeholder when none is given.
fn search_field(a: *mem.Arena, key: widget.Key, t: *const Theme, buffer: []u8, len: usize, change: widget.Change[str], submit: widget.Submit, clear: *const widget.Submit, options: FieldOptions) -> (widget.Node, err) {
    if t.tokens.profile == .CupertinoLike {
        let (cup, cup_error) = cupertino_search(a, key, t, buffer, len, change, submit, clear, options)
        ret (cup, cup_error)
    }
    if t.tokens.profile == .Linux {
        let (gtk, gtk_error) = linux_search(a, key, t, buffer, len, change, submit, clear, options)
        ret (gtk, gtk_error)
    }
    // v2 (D952, docs/ux/components/SearchBar): a `surface-container-high` pill,
    // 40 tall with a pointer and 56 on touch, with a trailing clear button.
    // The query is body-medium (body-large on touch) over its variant placeholder.
    // ponytail: no expanded/docked view, grouped suggestions, result announcement
    // or shortcut/open-close model; add `overlay.search_view` when product search needs it.
    let touch = t.tokens.metrics.control_height > t.tokens.sizes.control_sm
    var state = control_state(t, key, options.enabled, false)
    // Android: the runtime hovers regions, not editors, so the bar answers through a hover region round it.
    if t.tokens.profile == .MaterialLike {
        let region_state = control_state(t, key + 1048650u64, options.enabled, false)
        if region_state.hovered { state.hovered = true }
        if region_state.pressed { state.pressed = true }
    }
    var h = t.tokens.sizes.control_md
    var lead: f32 = 12.0
    var trail: f32 = 4.0
    var role: style.TextRole = .BodyMedium
    if touch {
        h = t.tokens.sizes.control_xl
        lead = 16.0
        trail = 8.0
        role = .BodyLarge
    }
    var prompt = options.placeholder
    if prompt.len == 0usize { prompt = "Search" }
    let (text_look, style_error) = text_style(a, t, role)
    if style_error != ok { ret (zero, style_error) }
    let line = style.text_style(t.tokens, role).line_height
    let (layers, layers_error) = mem.alloc[widget.Node](a, 2usize)
    if layers_error != ok { ret (zero, TooLarge) }
    var at = 0usize
    if len == 0usize {
        var hint = text_options()
        hint.role = role
        hint.color = .OnSurfaceVariant
        hint.wrap = .None
        let (hint_node, hint_error) = text_node(a, 0u64, prompt, t, hint)
        if hint_error != ok { ret (zero, hint_error) }
        layers[at] = hint_node
        at += 1usize
    }
    var editor_style = style.defaults()
    editor_style.width = style.Length { Percent: 100.0 }
    editor_style.min_height = style.Length { Px: line }
    layers[at] = widget.edit(key, widget.Edit { buffer: buffer, len: len, style: text_look, color: style.color(t.tokens, .OnSurface), selection: style.color(t.tokens, .TextSelection), change: change, submit: submit, enabled: options.enabled, read_only: false, multiline: false, secret: false, marked: zero, caret: material_caret(t), untabbed: false, ringed: false }, editor_style)
    var search_name = options.placeholder
    if search_name.len == 0usize { search_name = "Search" }
    let (named_search, named_search_error) = named_editor(a, key, "", search_name, false, editor_style, layers[at])
    if named_search_error != ok { ret (zero, named_search_error) }
    layers[at] = named_search
    at += 1usize
    var count = 1usize
    if len != 0usize { count = 2usize }
    var first = 0usize
    let android = t.tokens.profile == .MaterialLike
    if android { count += 1usize }
    let (parts, parts_error) = mem.alloc[widget.Node](a, count)
    if parts_error != ok { ret (zero, TooLarge) }
    var grow = style.defaults()
    grow.width = style.Length { Flex: 1.0 }
    if android {
        // Android (md.comp.search-bar): the 24 dp search icon in `on-surface` at the start, a 40 dp cross icon button to clear.
        let (lens, lens_error) = icon_square(a, style.color(t.tokens, .OnSurface), .Search, 24.0)
        if lens_error != ok { ret (zero, lens_error) }
        parts[0usize] = lens
        first = 1usize
    }
    parts[first] = widget.stack(0u64, grow, layers[0usize..at])
    if len != 0usize {
        if android {
            let (cross, cross_error) = material_icon_button(a, key + 1u64, t, .Cross, "Clear", clear, .Plain, options.enabled, false)
            if cross_error != ok { ret (zero, cross_error) }
            parts[first + 1usize] = cross
        } else {
            var plain = button_options()
            plain.variant = .Plain
            let (clear_button, clear_error) = button(a, key + 1u64, t, "Clear", clear, plain)
            if clear_error != ok { ret (zero, clear_error) }
            parts[first + 1usize] = clear_button
        }
    }
    var bar = style.defaults()
    bar.width = style.Length { Px: options.width }
    bar.min_height = style.Length { Px: h }
    var fill = style.color(t.tokens, .SurfaceContainerHigh)
    if state.hovered { fill = style.layer(fill, style.color(t.tokens, .OnSurface), t.tokens.states.hover) }
    if state.pressed && android { fill = style.layer(style.color(t.tokens, .SurfaceContainerHigh), style.color(t.tokens, .OnSurface), t.tokens.states.pressed) }
    if android && !options.enabled { fill = style.layer(fill, style.color(t.tokens, .OnSurface), 0.0) }
    bar.background = paint.Brush { Solid: fill }
    bar.radius = h * 0.5
    var pad_y = style.Length { Px: max_zero((h - line) * 0.5) }
    // Android: the bar is centred on its 56 dp, a taller clear button must not grow it.
    if android { pad_y = style.Length { Px: 0.0 } }
    bar.padding = style.EdgeLengths { left: style.Length { Px: lead }, top: pad_y, right: style.Length { Px: trail }, bottom: pad_y }
    if android && !options.enabled {
        // Disabled: the bar at the 38 % content level.
        bar.opacity = t.tokens.states.disabled_content
    }
    // Android: 16 dp between the search icon and the query (md.comp.search-bar).
    var bar_gap: f32 = 12.0
    if android { bar_gap = 16.0 }
    let bar_node = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: bar_gap }, bar, parts[0usize..count])
    if t.tokens.profile == .MaterialLike {
        var no_gesture: widget.GestureAction = zero
        let (held_bar, held_bar_error) = mem.alloc[widget.Node](a, 1usize)
        if held_bar_error != ok { ret (zero, TooLarge) }
        held_bar[0usize] = bar_node
        ret (widget.region(key + 1048650u64, widget.Region { gesture: no_gesture, gestures: 4u8, enabled: options.enabled, focusable: false }, style.defaults(), held_bar[0usize..1usize]), ok)
    }
    ret (bar_node, ok)
}

