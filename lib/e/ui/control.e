            var inner = sized_style(w, thumb_len - 2.0)
            inner.margin = style.EdgeLengths { left: style.Length { Px: side }, top: style.Length { Px: at + lift + 1.0 }, right: style.Length { Px: 0.0 }, bottom: style.Length { Px: 0.0 } }
