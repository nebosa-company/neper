            inner.margin = style.EdgeLengths { left: style.Length { Px: at + 1.0 }, top: style.Length { Px: 8.0 }, right: style.Length { Px: 0.0 }, bottom: style.Length { Px: 0.0 } }
            inner.background = paint.Brush { Solid: body }
