        if gear_error != ok { ret (zero, gear_error) }
        bits[2usize] = marked
        bits[3usize] = gear
        bits[1usize] = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 0.0 }, style.defaults(), bits[2usize..4usize])
    }
    var bar = sized_style(inner, 56.0)
