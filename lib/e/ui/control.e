    }
    root_parts[root_count] = widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Start, gap: 8.0 }, body_style, body_parts)
    root_count += 1usize
    let (made, made_error) = card_render(a, key, t, options, true, root_parts[0usize..root_count])
    ret (made, made_error)
}

// The group box's frame and row hairlines. Neper dark's OutlineVariant (#434653) is 1.98:1 on the page, and the
// frame is all that marks the group, so it takes Outline (#8D909E, 5.8:1, the text field's frame; a hairline a third
