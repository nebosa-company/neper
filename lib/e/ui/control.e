// `windows_radio_sized` for a radio of the Options pages' groups (their discs are resampled, see e.ui.winmark).
fn windows_radio_options(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, selected: bool, action: *const widget.Submit, enabled: bool, high: f32) -> (widget.Node, err) {
    let (row, row_error) = windows_choice_high(a, key, t, 5u8, label, selected, false, true, action, enabled, high, true, Phase { context: 6u32, x: 0.0 - 1.0, y: 0.0 - 1.0 })
    ret (row, row_error)
}

// looks5: a radio of the window `context` (2 Missing Set Cards, 3 Search for Card, 4 the Filter window's Blocks row,
// 5 its Match group, 6 the Options pages' groups), `window_y` px down its window.
fn windows_radio_phase(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, selected: bool, action: *const widget.Submit, enabled: bool, high: f32, context: u32, window_x: f32, window_y: f32) -> (widget.Node, err) {
    let (row, row_error) = windows_choice_high(a, key, t, 5u8, label, selected, false, true, action, enabled, high, true, Phase { context: context, x: window_x, y: window_y })
    ret (row, row_error)
}

// A group with its frame and caption at v3's measured geometry (100 % captures), `width` x
// `height` as the DFM gives them; `body` are children already placed (`widget.positioned`) relative
// to the group's top left. TcxGroupBox (and a TcxRadioGroup with Style.BorderStyle = ebsFlat): a 1 unit
// #DCDCDC square frame whose top line runs 6.35 below the top and bottom line 0.65 above the bottom;
// the Options pages' TcxRadioGroup (`in_radio_group`): the same square lines on fractional positions,
// 0.15 in at the left, 6.45 down, 0.5 past the right and 0.45 up (looks4: the capture's corner pixels
// are those of square lines, not of a rounded frame). The caption (v3 captions end in a space) starts
// 8 in, on the dialog face, 2 above the frame's top so its middle sits on the line.
fn windows_group_sized(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, enabled: bool, width: f32, height: f32, in_radio_group: bool, body: []const widget.Node) -> (widget.Node, err) {
    var left: f32 = 0.0
    var top: f32 = 6.35
    var right = width
    var bottom = height - 0.65
    if in_radio_group {
        left = 0.15
        top = 6.45
        right = width + 0.5
        bottom = height - 0.45
    }
    let (framed, framed_error) = windows_group_exact(a, key, t, label, enabled, width, height, left, top, right, bottom, body)
    ret (framed, framed_error)
}

// The frame's four lines (1 unit, #DCDCDC) on explicit outer extents relative to the group's top left.
type GroupFrame = struct { left: f32, top: f32, right: f32, bottom: f32, color: paint.Color }

fn group_frame_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let g = mem.cast[*GroupFrame](ctx)
    let brush = paint.Brush { Solid: g.color }
    let x = area.x + g.left
    let y = area.y + g.top
    let w = g.right - g.left
    let h = g.bottom - g.top
    // looks5: the side lines run from the row under the top line's first row to the bottom line's first row, on whole
    // rows: the capture's corner pixels are the full line colour (a blend of the sides with the 65 % rows gives 5 to 7 levels).
    let side_top = f32(i32(y)) + 1.0
    let side_end = f32(i32(y + h - 1.0)) + 1.0
    try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(x, y, w, 1.0), brush: brush } })
    try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(x, y + h - 1.0, w, 1.0), brush: brush } })
    try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(x, side_top, 1.0, side_end - side_top), brush: brush } })
    ret scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(x + w - 1.0, side_top, 1.0, side_end - side_top), brush: brush } })
}

// `windows_group_sized` with the frame's outer extents given: (`left`, `top`) to (`right`, `bottom`) in
// the group's units (fractional: the captures place some frames between pixels).
fn windows_group_exact(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, enabled: bool, width: f32, height: f32, left: f32, top: f32, right: f32, bottom: f32, body: []const widget.Node) -> (widget.Node, err) {
    let (made, made_error) = windows_group_on(a, key, t, label, enabled, width, height, left, top, right, bottom, style.color(t.tokens, .Background), body)
    ret (made, made_error)
}

// looks5: `windows_group_exact` on a surface of `face` (the Filter window's tab page is #F9F9F9, not the dialog's
// #F0F0F0: the caption's cut-out takes its colour).
fn windows_group_on(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, enabled: bool, width: f32, height: f32, left: f32, top: f32, right: f32, bottom: f32, face: paint.Color, body: []const widget.Node) -> (widget.Node, err) {
    var ink = style.color(t.tokens, .Text)
    if !enabled { ink = style.mix(ink, face, 0.55) }
    let (frames, frames_error) = mem.alloc[GroupFrame](a, 1usize)
    if frames_error != ok { ret (zero, TooLarge) }
    frames[0usize] = GroupFrame { left: left, top: top, right: right, bottom: bottom, color: style.color(t.tokens, .OutlineVariant) }
    var fill = style.defaults()
    fill.width = style.Length { Percent: 100.0 }
    fill.height = style.Length { Percent: 100.0 }
    var none: []const widget.Node = zero
    let frame = widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&frames[0usize]), measure: mark_measure, paint: group_frame_paint, state: widget.bytes_of[GroupFrame](&frames[0usize]) } }, style: fill, children: none }
    let (dialog_t, dialog_error) = windows_dialog_theme(a, t)
    if dialog_error != ok { ret (zero, dialog_error) }
    var caption = text_options()
    caption.wrap = .None
    caption.role = .BodyMedium
    caption.size = 11.0
    // looks5: a '&' in the caption marks its mnemonic (the Filter window's "&Match"), underlined at the baseline.
    let (shown, mark_at, mark_error) = winbutton.mnemonic(a, label)
    if mark_error != ok { ret (zero, mark_error) }
    let (words, heading_width, heading_error) = choices_words(a, &dialog_t, caption, ink, shown)
    if heading_error != ok { ret (zero, heading_error) }
    var heading = words
    if mark_at < shown.len {
        let (metric, metric_fit, heading_base, metric_error) = run_metrics_faced(a, &dialog_t, caption, shown)
        if metric_error != ok { ret (zero, metric_error) }
        let (rule, rule_error) = under_node(a, ink, choices_hinted_width(shown[mark_at..mark_at + 1usize]), 0.0, 0.333, 1.0)
        if rule_error != ok { ret (zero, rule_error) }
        let (pair, pair_error) = mem.alloc[widget.Node](a, 2usize)
        if pair_error != ok { ret (zero, TooLarge) }
        pair[0usize] = words
        pair[1usize] = widget.positioned(0u64, choices_hinted_width(shown[0usize..mark_at]), f32(i32(heading_base + 1.0 + 0.5)), style.defaults(), mem_one_node(a, rule))
        heading = widget.stack(0u64, sized_style(heading_width, 15.0), pair[0usize..2usize])
    }
    var cut = style.defaults()
    cut.background = paint.Brush { Solid: face }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize + body.len)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = frame
    parts[1usize] = widget.positioned(0u64, 8.0, -1.0, cut, widget_one_of(a, heading))
    var i = 0usize
    while i < body.len {
        parts[2usize + i] = body[i]
        i += 1usize
    }
    var sem: widget.Semantics = zero
    sem.role = 2u8
    sem.label = shown
    ret (widget.semantics(key, sem, style.defaults(), widget_one_of(a, widget.stack(0u64, sized_style(width, height), parts[0usize..2usize + body.len]))), ok)
}

// A TcxRadioGroup at its DFM size (`width` x `height`): its radios stand 8 in, the first 18 down,
// each 42 tall (v3's items fill the group), the mark flush at the left and the caption centred
// beside it. `selected` is the chosen index (past the end: none). Windows look only.
fn windows_radio_group_sized(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, labels: []const str, selected: usize, actions: []const widget.Submit, enabled: bool, width: f32, height: f32) -> (widget.Node, err) {
    let (made, made_error) = windows_radio_group_kind(a, key, t, label, labels, selected, actions, enabled, width, height, false, 0.0 - 1.0, 0.0 - 1.0)
    ret (made, made_error)
}

// A TcxRadioGroup with Style.BorderStyle = ebsFlat (the Search for Card dialog's): the square frame of a
// TcxGroupBox in place of the Options pages' fractional one.
fn windows_radio_group_flat(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, labels: []const str, selected: usize, actions: []const widget.Submit, enabled: bool, width: f32, height: f32) -> (widget.Node, err) {
    let (made, made_error) = windows_radio_group_kind(a, key, t, label, labels, selected, actions, enabled, width, height, true, 0.0 - 1.0, 0.0 - 1.0)
    ret (made, made_error)
}

// looks5: either group `window_y` px down its window (the discs' sub-pixel phase follows it).
fn windows_radio_group_at(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, labels: []const str, selected: usize, actions: []const widget.Submit, enabled: bool, width: f32, height: f32, flat: bool, window_x: f32, window_y: f32) -> (widget.Node, err) {
    let (made, made_error) = windows_radio_group_kind(a, key, t, label, labels, selected, actions, enabled, width, height, flat, window_x, window_y)
    ret (made, made_error)
}

fn windows_radio_group_kind(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, labels: []const str, selected: usize, actions: []const widget.Submit, enabled: bool, width: f32, height: f32, flat: bool, window_x: f32, window_y: f32) -> (widget.Node, err) {
    if actions.len != labels.len { ret (zero, TooLarge) }
    let (items, items_error) = mem.alloc[widget.Node](a, labels.len)
    if items_error != ok { ret (zero, TooLarge) }
    var i = 0usize
    while i < labels.len {
        var item: widget.Node = zero
        var item_y: f32 = 0.0 - 1.0
        var item_x: f32 = 0.0 - 1.0
        if window_y >= 0.0 && window_x >= 0.0 {
            item_y = window_y + 18.0 + 42.0 * f32(i)
            item_x = window_x + 8.0
        }
        var context = 6u32
        if flat { context = 3u32 }
        let (made, made_error) = windows_radio_phase(a, key + 1u64 + u64(i), t, labels[i], i == selected, &actions[i], enabled, 42.0, context, item_x, item_y)
        if made_error != ok { ret (zero, made_error) }
        item = made
        items[i] = widget.positioned(0u64, 8.0, 18.0 + 42.0 * f32(i), style.defaults(), widget_one_of(a, item))
        i += 1usize
    }
    let (framed, framed_error) = windows_group_sized(a, key, t, label, enabled, width, height, !flat, items[0usize..labels.len])
    ret (framed, framed_error)
}
// ---- looks3 group d: the Windows 11 native tab strip of v3's lfOffice11 page controls ------------
// The Filter window's tabs and the Customization window's (NativeStyle = True): unselected tabs 20 tall (#E9E9E9 top edge, #EEEEEE, #F3F3F3 face, #EAEAEA / #F2F2F2 rows under
// them that are the page's top edge), the chosen tab 22 tall on the page's #F9F9F9 face with its
// left edge #E5E5E5, a 1 px #E5E5E5 left edge on every tab (the last also closes on the right).
// Measured on ref/windows/dialogs/search-filter-top, view-show-columns. Text is Tahoma 11 px.
type Win3Tab = struct { chosen: bool, closes: bool, ground: paint.Color, lit: bool, bare_left: bool, abuts: bool, cropped: bool }

fn win3_tab_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let f = mem.cast[*Win3Tab](ctx)
    let x = area.x
    let y = area.y
    let w = area.width
    let h = area.height
    let edge = style.hex(15066597u32)
    if f.chosen {
        try win3_rect(b, x + 1.0, y + 2.0, w - 1.0, h - 2.0, style.hex(16382457u32))
        // looks4: top rows #EEEEEE, #F2F2F2 (measured on the focused Filter tab), its corner #F2F2F2 / #E8E8E8.
        var top = style.hex(15329769u32)
        if f.lit { top = style.hex(15658734u32) }
        // (a tab cropped by the capture's edge runs its rows to the last column)
        var rows_w = w - 2.0
        if f.cropped { rows_w = w - 1.0 }
        try win3_rect(b, x + 1.0, y, rows_w, 1.0, top)
        try win3_rect(b, x + 1.0, y + 1.0, rows_w, 1.0, style.hex(15921906u32))
        // looks5 group d: the Customization strip's chosen first tab has no left edge (ref/windows/states/tab-pressed-customization-columns).
        // looks9: next to an unchosen tab on its left the chosen tab's edge stops a row short (the strip's line passes under it)
        var edge_h = h - 1.0
        if f.abuts { edge_h = h - 2.0 }
        // (a chosen first tab without a left edge carries both top rows over its first column: held Bands of the Customization strip)
        if f.bare_left {
            try win3_rect(b, x, y, 1.0, 1.0, top)
            try win3_rect(b, x, y + 1.0, 1.0, 1.0, style.hex(15921906u32))
            try win3_rect(b, x, y + 2.0, 1.0, h - 2.0, style.hex(16382457u32))
        } else { try win3_rect(b, x, y + 1.0, 1.0, edge_h, edge) }
        if f.lit {
            try win3_rect(b, x, y, 1.0, 1.0, style.hex(15921906u32))
            try win3_rect(b, x, y + 1.0, 1.0, 1.0, style.hex(15198440u32))
        }
        if f.closes { try win3_rect(b, x + w - 1.0, y + 1.0, 1.0, h - 1.0, edge) }
        ret ok
    }
    try win3_rect(b, x + 1.0, y + 1.0, w - 1.0, h - 3.0, style.hex(15987699u32))
    // looks9: an unchosen tab right before the chosen one carries its top rows through its last column
    var top_w = w - 2.0
    if f.abuts { top_w = w - 1.0 }
    try win3_rect(b, x + 1.0, y, top_w, 1.0, style.hex(15329769u32))
    try win3_rect(b, x + 1.0, y + 1.0, top_w, 1.0, style.hex(15658734u32))
    try win3_rect(b, x, y + h - 2.0, w, 1.0, style.hex(15395562u32))
    try win3_rect(b, x, y + h - 1.0, w, 1.0, style.hex(15921906u32))
    // looks9: an unchosen tab's edge runs down over the first of the strip's two lines (h - 2 rows from the top)
    try win3_rect(b, x, y + 1.0, 1.0, h - 2.0, edge)
    if f.closes { try win3_rect(b, x + w - 1.0, y + 1.0, 1.0, h - 3.0, edge) }
    ret ok
}

fn win3_tab_face(a: *mem.Arena, chosen: bool, closes: bool, ground: paint.Color, lit: bool, bare_left: bool, abuts: bool, cropped: bool) -> (widget.Node, err) {
    let (cells, cells_error) = mem.alloc[Win3Tab](a, 1usize)
    if cells_error != ok { ret (zero, TooLarge) }
    cells[0usize] = Win3Tab { chosen: chosen, closes: closes, ground: ground, lit: lit, bare_left: bare_left, abuts: abuts, cropped: cropped }
    var none: []const widget.Node = zero
    var fill = style.defaults()
    fill.width = style.Length { Percent: 100.0 }
    fill.height = style.Length { Percent: 100.0 }
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: win3_measure, paint: win3_tab_paint, state: widget.bytes_of[Win3Tab](&cells[0usize]) } }, style: fill, children: none }, ok)
}

// The strip behind the tabs: the page's top edge (#E9E9E9, #F2F2F2) at its foot.
fn win3_strip_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    // looks5 group d: the Customization strip has no #F5F5F5 line on top (`shade` 1).
    if mem.cast[*Win3Lines](ctx).shade == 0.0 { try win3_rect(b, area.x, area.y, area.width, 1.0, style.hex(16119285u32)) }
    try win3_rect(b, area.x, area.y + area.height - 2.0, area.width, 1.0, style.hex(15329769u32))
    ret win3_rect(b, area.x, area.y + area.height - 1.0, area.width, 1.0, style.hex(15921906u32))
}

fn win3_strip_face(a: *mem.Arena, plain: bool) -> (widget.Node, err) {
    let (cells, cells_error) = mem.alloc[Win3Lines](a, 1usize)
    if cells_error != ok { ret (zero, TooLarge) }
    var shade: f32 = 0.0
    if plain { shade = 1.0 }
    cells[0usize] = Win3Lines { shade: shade }
    var none: []const widget.Node = zero
    var fill = style.defaults()
    fill.width = style.Length { Percent: 100.0 }
    fill.height = style.Length { Percent: 100.0 }
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: win3_measure, paint: win3_strip_paint, state: widget.bytes_of[Win3Lines](&cells[0usize]) } }, style: fill, children: none }, ok)
}

// looks5 group d: the boxes (left edge to the next tab's left edge, `closes` included) of the two captured
// native strips, per chosen tab, measured on ref/windows/states/tab-selected-filter-* and the Customization
// grabs: v3 sets whole-pixel boxes that move by a pixel with the chosen tab. `lead` is the strip's blank
// start before an unchosen first tab. width 0: not a captured strip (the unhinted layout).
// looks9: `nudge` the caption's extra offset right (v3 centres the caption in a whole pixel box, so it moves by a pixel or three with the chosen tab).
type Win5Box = struct { lead: f32, width: f32, nudge: f32 }

fn win5_native_box(labels: []const str, selected: usize, i: usize) -> Win5Box {
    if labels.len == 3usize && (strs.eq(labels[1usize], "Cards") || strs.eq(labels[1usize], "&Cards")) && (strs.eq(labels[2usize], "Options") || strs.eq(labels[2usize], "&Options")) {
        if selected == 0usize {
            if i == 0usize { ret Win5Box { lead: 0.0, width: 140.0, nudge: 0.0 } }
            if i == 1usize { ret Win5Box { lead: 0.0, width: 40.0, nudge: 1.0 } }
            ret Win5Box { lead: 0.0, width: 48.0, nudge: 2.0 }
        }
        if selected == 1usize {
            if i == 0usize { ret Win5Box { lead: 2.0, width: 135.0, nudge: 0.0 } }
            if i == 1usize { ret Win5Box { lead: 0.0, width: 45.0, nudge: 0.0 } }
            ret Win5Box { lead: 0.0, width: 46.0, nudge: 0.0 }
        }
        if i == 0usize { ret Win5Box { lead: 2.0, width: 136.0, nudge: 0.0 } }
        if i == 1usize { ret Win5Box { lead: 0.0, width: 41.0, nudge: 3.0 } }
        // looks9: the chosen Options tab runs to the strip's last column (229 = 2 + 136 + 41 + 50); the capture is cropped there, so no right edge shows
        ret Win5Box { lead: 0.0, width: 50.0, nudge: 0.0 }
    }
    if labels.len == 2usize && strs.eq(labels[0usize], "Bands") && strs.eq(labels[1usize], "Columns") {
        if selected == 0usize {
            if i == 0usize { ret Win5Box { lead: 0.0, width: 43.0, nudge: 0.0 - 3.0 } }
            ret Win5Box { lead: 0.0, width: 49.0, nudge: 0.0 }
        }
        if i == 0usize { ret Win5Box { lead: 0.0, width: 40.0, nudge: 0.0 } }
        ret Win5Box { lead: 0.0, width: 56.0, nudge: 0.0 }
    }
    ret Win5Box { lead: 0.0, width: 0.0, nudge: 0.0 }
}

// One native tab: the text (Tahoma 11) 5 in (6 chosen) of its left edge, the focus rectangle round
// it while the chosen tab has the keyboard focus.
fn win3_native_tab(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, chosen: bool, closes: bool, enabled: bool, raw_state: style.ControlState, action: *const widget.Submit, fixed_w: f32, nudge: f32, abuts: bool) -> (widget.Node, err) {
    let (dialog_t, dialog_error) = win3_dialog_theme(a, t)
    if dialog_error != ok { ret (zero, dialog_error) }
    var state = raw_state
    state.hovered = false
    var ink = style.color(t.tokens, .Text)
    if !enabled { ink = style.mix(ink, style.color(t.tokens, .Background), 0.6) }
    var caption = text_options()
    caption.role = .BodyMedium
    caption.wrap = .None
    // looks9: v3 sets the captions on GDI's whole pixel advances and underlines the mnemonic ('&Cards'): the hinted label
    let (plain_label, mark_at, mark_error) = winbutton.mnemonic(a, label)
    if mark_error != ok { ret (zero, mark_error) }
    let (said, said_error) = windows_label(a, t, label, 11.0, 400u32, ink, false, 0.0)
    if said_error != ok { ret (zero, said_error) }
    let (look_style, look_error) = text_style_faced(a, &dialog_t, caption)
    if look_error != ok { ret (zero, look_error) }
    let (laid, laid_error) = layout.layout(a, plain_label, look_style, layout.Options { width: 100000.0, max_lines: 0u32, align: .Start, wrap: .None, ellipsis: "", notdef: false })
    if laid_error != ok { ret (zero, laid_error) }
    var pad: f32 = 11.0
    var h: f32 = 20.0
    var lift: f32 = 0.0
    var left: f32 = 4.0
    if chosen {
        pad = 13.0
        h = 22.0
        lift = 2.0
        left = 7.5
    }
    var w = laid.bounds.width + pad
    if closes { w += 1.0 }
    if fixed_w > 0.0 { w = fixed_w }
    let (face, face_error) = win3_tab_face(a, chosen, closes && !(chosen && fixed_w == 50.0), style.color(t.tokens, .Background), state.focused && state.focus_visible, chosen && fixed_w == 43.0, abuts, chosen && fixed_w == 50.0)
    if face_error != ok { ret (zero, face_error) }
    var line = style.defaults()
    line.width = style.Length { Percent: 100.0 }
    line.height = style.Length { Px: h }
    // looks9: the chosen tab's caption sits 2 px higher than the lift of its face (measured on the Filter strips)
    var text_top = lift
    if chosen { text_top = 0.0 }
    line.padding = edges(left + nudge, text_top, 0.0, 1.0 + lift + (lift - text_top))
    let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
    if held_error != ok { ret (zero, TooLarge) }
    held[0usize] = said
    let (layers, layers_error) = mem.alloc[widget.Node](a, 3usize)
    if layers_error != ok { ret (zero, TooLarge) }
    layers[0usize] = face
    layers[1usize] = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 0.0 }, line, held[0usize..1usize])
    var count = 2usize
    if chosen && state.focused && state.focus_visible {
        // looks9: the chosen Options tab is cropped at the strip's end: its focus rectangle is that of a 53 wide tab
        var dots_w = w - 6.0
        if fixed_w == 50.0 { dots_w = w - 3.0 }
        let (dots, dots_error) = win3_dots(a, style.color(t.tokens, .Text), max_zero(dots_w), h - 5.0)
        if dots_error != ok { ret (zero, dots_error) }
        let (dot_held, dot_held_error) = mem.alloc[widget.Node](a, 1usize)
        if dot_held_error != ok { ret (zero, TooLarge) }
        dot_held[0usize] = dots
        layers[2usize] = widget.positioned(0u64, 3.0, 3.0, style.defaults(), dot_held[0usize..1usize])
        count = 3usize
    }
    let content = widget.stack(0u64, sized_style(w, h), layers[0usize..count])
    let bare = style.ResolvedControl { background: paint.rgba(0.0, 0.0, 0.0, 0.0), foreground: ink, border: paint.rgba(0.0, 0.0, 0.0, 0.0), border_width: 0.0, focus_ring: 0.0, opacity: 1.0, radius: 0.0, elevation: 0u8, padding: 0.0, padding_start: 0.0, padding_y: 0.0, custom_padding: true, min_width: w, min_height: h, corners: zero }
    let (press, press_error) = pressable_states(a, key, t, 19u8, label, bare, enabled, chosen, 0u32, 0u32, 0u64, action, content)
    ret (press, press_error)
}

// ---- end looks3 group d (native tabs) ----------------------------------------------------------

// ---- looks3 group d: the ultra-flat tab strip of v3's lfUltraFlat page controls, at 100 % ---------
// Statistics and About windows (NativeStyle = False): a white strip starting 5 px before the first tab,
// the chosen tab a face-coloured box framed 1 px black left and right and by two grey rows on top
// (#555555, #A0A0A0: a 1 px line between pixels), the strip's bottom line the same two rows under every
// other tab, a 1 px #A0A0A0 hairline 14 tall between unchosen tabs; Tahoma 11 px, a 16 px picture and
// a 6 px gap before the caption, 4 px of room each side. Measured on ref/windows/dialogs/deck-statistics
// and help-about. kind: 0 the chosen tab, 1 an unchosen one, 2 the strip's lines, 3 a hairline.
type Win3Ultra = struct { kind: u32 }

fn win3_ultra_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let f = mem.cast[*Win3Ultra](ctx)
    let x = area.x
    let y = area.y
    let w = area.width
    let h = area.height
    let dark = style.hex(5592405u32)
    let light = style.hex(10526880u32)
    if f.kind == 0u32 {
        try win3_rect(b, x, y, w, h, style.hex(15790320u32))
        try win3_rect(b, x, y, w, 1.0, dark)
        try win3_rect(b, x + 1.0, y + 1.0, w - 2.0, 1.0, light)
        try win3_rect(b, x, y + 1.0, 1.0, h - 2.0, style.hex(0u32))
        try win3_rect(b, x + w - 1.0, y + 1.0, 1.0, h - 2.0, style.hex(0u32))
        try win3_rect(b, x, y + h - 1.0, 1.0, 1.0, light)
        ret win3_rect(b, x + w - 1.0, y + h - 1.0, 1.0, 1.0, light)
    }
    if f.kind == 3u32 {
        try win3_rect(b, x, y + 3.0, 1.0, 1.0, style.hex(12632256u32))
        try win3_rect(b, x, y + 4.0, 1.0, 14.0, light)
        ret win3_rect(b, x, y + 18.0, 1.0, 1.0, style.hex(14671839u32))
    }
    if f.kind == 1u32 { ret ok }
    // looks5 group d: kind 4, the strip of tabs without pictures (About), sits on another phase: #5A5A5A, #9B9B9B.
    if f.kind == 4u32 {
        try win3_rect(b, x, y + h - 2.0, w, 1.0, style.hex(5921370u32))
        ret win3_rect(b, x, y + h - 1.0, w, 1.0, style.hex(10197915u32))
    }
    try win3_rect(b, x, y + h - 2.0, w, 1.0, dark)
    ret win3_rect(b, x, y + h - 1.0, w, 1.0, light)
}

fn win3_ultra_node(a: *mem.Arena, kind: u32, w: f32, h: f32) -> (widget.Node, err) {
    let (cells, cells_error) = mem.alloc[Win3Ultra](a, 1usize)
    if cells_error != ok { ret (zero, TooLarge) }
    cells[0usize] = Win3Ultra { kind: kind }
    var none: []const widget.Node = zero
    var box = style.defaults()
    if w > 0.0 {
        box.width = style.Length { Px: w }
    } else {
        box.width = style.Length { Percent: 100.0 }
    }
    if h > 0.0 {
        box.height = style.Length { Px: h }
    } else {
        box.height = style.Length { Percent: 100.0 }
    }
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: win3_measure, paint: win3_ultra_paint, state: widget.bytes_of[Win3Ultra](&cells[0usize]) } }, style: box, children: none }, ok)
}

// looks5 group d: v3 sets a tab's text width with GDI's hinted advances (whole pixels); the unhinted layout
// is off by up to a pixel and a half. The widths of the captured Statistics tabs are measured (tab width
// minus 30 in the captures); any other label rounds the unhinted width.
fn win5_tab_text(label: str, unhinted: f32, chosen: bool) -> f32 {
    if strs.eq(label, "Colors") && !chosen { ret 31.0 }
    if strs.eq(label, "Advanced") && chosen { ret 48.0 }
    if strs.eq(label, "Rarity") { ret 29.0 }
    if strs.eq(label, "Card Type") { ret 50.0 }
    if strs.eq(label, "Editions") { ret 37.0 }
    if strs.eq(label, "Mana Analyser") { ret 71.0 }
    if strs.eq(label, "Mana Product") { ret 66.0 }
    if strs.eq(label, "Power Analyser") { ret 75.0 }
    if strs.eq(label, "Probability") { ret 50.0 }
    if strs.eq(label, "Mana Slots") { ret 52.0 }
    if strs.eq(label, "Start Hand") { ret 52.0 }
    ret f32(u32(unhinted + 0.5))
}

// One ultra-flat tab (and, for `sep`, the hairline after it as a second node).
fn win3_ultra_tab(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, chosen: bool, enabled: bool, raw_state: style.ControlState, action: *const widget.Submit, has_icon: bool, picture_kind: GlyphKind) -> (widget.Node, err) {
    let (dialog_t, dialog_error) = win3_dialog_theme(a, t)
    if dialog_error != ok { ret (zero, dialog_error) }
    var state = raw_state
    state.hovered = false
    var ink = style.color(t.tokens, .Text)
    if state.hovered && enabled && !chosen { ink = style.hex(26316u32) }
    if !enabled { ink = style.mix(ink, style.color(t.tokens, .Surface), 0.6) }
    var caption = text_options()
    caption.role = .BodyMedium
    caption.wrap = .None
    // looks9: the caption without its '&' (the width tables key on the plain words), the mnemonic underlined at the baseline
    let (plain_label, mark_at, mark_error) = winbutton.mnemonic(a, label)
    if mark_error != ok { ret (zero, mark_error) }
    let (word, said_error) = colored_text(a, 0u64, plain_label, &dialog_t, caption, ink)
    if said_error != ok { ret (zero, said_error) }
    var said = word
    if mark_at < plain_label.len {
        let (before, before_fit, before_base, before_error) = run_metrics_faced(a, &dialog_t, caption, plain_label[0usize..mark_at])
        if before_error != ok { ret (zero, before_error) }
        let (mark_adv, mark_fit, mark_base, mark_error_two) = run_metrics_faced(a, &dialog_t, caption, plain_label[mark_at..mark_at + 1usize])
        if mark_error_two != ok { ret (zero, mark_error_two) }
        let (whole, whole_fit, whole_base, whole_error) = run_metrics_faced(a, &dialog_t, caption, plain_label)
        if whole_error != ok { ret (zero, whole_error) }
        var rule = sized_style(mark_adv, 1.0)
        rule.background = paint.Brush { Solid: ink }
        let (pair, pair_error) = mem.alloc[widget.Node](a, 2usize)
        if pair_error != ok { ret (zero, TooLarge) }
        pair[0usize] = word
        pair[1usize] = widget.positioned(0u64, before, whole_base + 1.0, style.defaults(), mem_one_node(a, widget.box(0u64, rule, zero)))
        said = widget.stack(0u64, style.defaults(), pair[0usize..2usize])
    }
    let (look_style, look_error) = text_style_faced(a, &dialog_t, caption)
    if look_error != ok { ret (zero, look_error) }
    let (laid, laid_error) = layout.layout(a, plain_label, look_style, layout.Options { width: 100000.0, max_lines: 0u32, align: .Start, wrap: .None, ellipsis: "", notdef: false })
    if laid_error != ok { ret (zero, laid_error) }
    var h: f32 = 21.0
    var w = win5_tab_text(plain_label, laid.bounds.width, chosen) + 7.0
    let (row_parts, row_error) = mem.alloc[widget.Node](a, 2usize)
    if row_error != ok { ret (zero, TooLarge) }
    var count = 1usize
    row_parts[0usize] = said
    if has_icon {
        let (picture, picture_error) = icon_square(a, ink, picture_kind, 16.0)
        if picture_error != ok { ret (zero, picture_error) }
        row_parts[0usize] = picture
        // v3's own bitmap of the tab (e.ui.winpageicon), in the light look only
        let art = winpageicon.find(plain_label)
        if art < 1000usize && !win_dark(t) {
            let atlas = winpageicon.atlas()
            let (tile, tile_error) = wintile.tile_node(a, 16usize, 16usize, atlas[art * 256usize..art * 256usize + 256usize])
            if tile_error != ok { ret (zero, tile_error) }
            row_parts[0usize] = tile
            // looks33: the pictures stand at y 36 of the live Statistics captures, 2 px above the tab line box's middle
            if true {
                let (lifted, lifted_error) = mem.alloc[widget.Node](a, 1usize)
                if lifted_error != ok { ret (zero, TooLarge) }
                lifted[0usize] = tile
                var lift = style.defaults()
                lift.margin = style.EdgeLengths { left: style.Length { Px: 0.0 - 1.0 }, top: style.Length { Px: 0.0 }, right: style.Length { Px: 0.0 }, bottom: style.Length { Px: 0.0 } }
                row_parts[0usize] = widget.padded(0u64, 0.0, 0.0, 0.0, 4.0, lift, lifted[0usize..1usize])
            }
        }
        row_parts[1usize] = said
        if chosen && !win_dark(t) {
            // the chosen tab's caption stands a pixel higher than the others' (live captures)
            let (said_held, said_held_error) = mem.alloc[widget.Node](a, 1usize)
            if said_held_error != ok { ret (zero, TooLarge) }
            said_held[0usize] = said
            row_parts[1usize] = widget.padded(0u64, 0.0, 0.0, 0.0, 2.0, style.defaults(), said_held[0usize..1usize])
        }
        count = 2usize
        h = 22.0
        w += 22.0
    }
    if chosen { w += 2.0 }
    var face_kind = 1u32
    if chosen { face_kind = 0u32 }
    let (face, face_error) = win3_ultra_node(a, face_kind, 0.0, 0.0)
    if face_error != ok { ret (zero, face_error) }
    var line = style.defaults()
    line.width = style.Length { Percent: 100.0 }
    line.height = style.Length { Px: h }
    var left: f32 = 2.5
    if has_icon { left = 4.0 }
    if chosen { left = 4.0 }
    // looks33: the chosen tab of the live Statistics captures holds its picture and caption a pixel further right
    if chosen && has_icon && !win_dark(t) { left = 5.0 }
    var below: f32 = 2.0
    if has_icon { below = 0.0 }
    line.padding = edges(left, 2.0, 0.0, below)
    let (layers, layers_error) = mem.alloc[widget.Node](a, 3usize)
    if layers_error != ok { ret (zero, TooLarge) }
    layers[0usize] = face
    // looks5 group d: an unchosen tab's caption stands 2 closer to its picture (measured on the Statistics captures' ink boxes).
    var picture_gap: f32 = 6.0
    // round 31: under ClearType the light look's hinted caption stands where the live one does (6 after the picture, chosen or not)
    if win_dark(t) && !chosen && has_icon && !strs.eq(plain_label, "Colors") { picture_gap = 4.0 }
    layers[1usize] = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: picture_gap }, line, row_parts[0usize..count])
    var shown = 2usize
    if chosen && state.focused && state.focus_visible {
        let (dots, dots_error) = win3_dots(a, style.color(t.tokens, .Text), max_zero(w - 4.0), h - 4.0)
        if dots_error != ok { ret (zero, dots_error) }
        let (dot_held, dot_held_error) = mem.alloc[widget.Node](a, 1usize)
        if dot_held_error != ok { ret (zero, TooLarge) }
        dot_held[0usize] = dots
        layers[2usize] = widget.positioned(0u64, 2.0, 2.0, style.defaults(), dot_held[0usize..1usize])
        shown = 3usize
    }
    let content = widget.stack(0u64, sized_style(w, h), layers[0usize..shown])
    let bare = style.ResolvedControl { background: paint.rgba(0.0, 0.0, 0.0, 0.0), foreground: ink, border: paint.rgba(0.0, 0.0, 0.0, 0.0), border_width: 0.0, focus_ring: 0.0, opacity: 1.0, radius: 0.0, elevation: 0u8, padding: 0.0, padding_start: 0.0, padding_y: 0.0, custom_padding: true, min_width: w, min_height: h, corners: zero }
    let (press, press_error) = pressable_states(a, key, t, 19u8, label, bare, enabled, chosen, 0u32, 0u32, 0u64, action, content)
    ret (press, press_error)
}
// ---- end looks3 group d (ultra tabs) -----------------------------------------------------------

// ---- looks4 group d: popup lists ---------------------------------------------------------------
// The XOR focus rectangle of a lit drop-down row: dots on (x + y) odd offsets along the row's
// perimeter, orange (#FF8728, white XOR the #0078D7 fill) on the blue. Measured on the popup grabs.
fn win4_xor_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let dot = style.hex(16746280u32)
    let w = u32(area.width) - 1u32
    let h = u32(area.height) - 1u32
    let m = mem.cast[*Win3Lines](ctx)
    if m.shade > 0.5 {
        // round 13: the native dark list XORs its focus rectangle where (client x + client y) is odd; the row's client origin is its list's
        // (rows are 15 high), so a dot of the row's own (i, j) is on when i + j + the row's index is odd (`shade` is 1 + the index's parity)
        let par = u32(m.shade) - 1u32
        var i = 0u32
        while i <= w {
            if ((i + par) & 1u32) == 1u32 { try win3_rect(b, area.x + f32(i), area.y, 1.0, 1.0, dot) }
            if ((i + h + par) & 1u32) == 1u32 { try win3_rect(b, area.x + f32(i), area.y + f32(h), 1.0, 1.0, dot) }
            i += 1u32
        }
        var k = 1u32
        while k < h {
            if ((k + par) & 1u32) == 1u32 { try win3_rect(b, area.x, area.y + f32(k), 1.0, 1.0, dot) }
            if ((w + k + par) & 1u32) == 1u32 { try win3_rect(b, area.x + f32(w), area.y + f32(k), 1.0, 1.0, dot) }
            k += 1u32
        }
        ret ok
    }
    var i = 1u32
    while i < w {
        if (i & 1u32) == 1u32 {
            try win3_rect(b, area.x + f32(i), area.y, 1.0, 1.0, dot)
            if (h & 1u32) == 0u32 { try win3_rect(b, area.x + f32(i), area.y + f32(h), 1.0, 1.0, dot) }
        }
        i += 1u32
    }
    var j = 1u32
    while j < h {
        if (j & 1u32) == 1u32 {
            try win3_rect(b, area.x, area.y + f32(j), 1.0, 1.0, dot)
            try win3_rect(b, area.x + f32(w), area.y + f32(j), 1.0, 1.0, dot)
        }
        j += 1u32
    }
    ret ok
}

fn win4_xor_dots(a: *mem.Arena, dark: bool, parity: f32) -> (widget.Node, err) {
    let (cells, cells_error) = mem.alloc[Win3Lines](a, 1usize)
    if cells_error != ok { ret (zero, TooLarge) }
    var tint: f32 = 0.0
    if dark { tint = 1.0 + parity }
    cells[0usize] = Win3Lines { shade: tint }
    var none: []const widget.Node = zero
    var fill = style.defaults()
    fill.width = style.Length { Percent: 100.0 }
    fill.height = style.Length { Percent: 100.0 }
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: win3_measure, paint: win4_xor_paint, state: widget.bytes_of[Win3Lines](&cells[0usize]) } }, style: fill, children: none }, ok)
}

// The popup's scroll track: 16 wide, #F0F0F0, a 2 wide thumb (#858585, #929292 at its ends) 17 px
// below the top (past the arrow button's room), as long as the visible share of the 70 px between.
type Win4Track = struct { rows: u32 }

fn win4_track_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let m = mem.cast[*Win4Track](ctx)
    try win3_rect(b, area.x, area.y, area.width, area.height, style.hex(15790320u32))
    let room = area.height - 34.0
    var long = room * f32(win_drop_rows()) / f32(m.rows)
    if long < 8.0 { long = 8.0 }
    long = f32(u32(long + 0.5))
    let top = area.y + 17.0
    let at = area.x + 7.0
    try win3_rect(b, at, top, 2.0, long, style.hex(8750469u32))
    try win3_rect(b, at, top, 2.0, 1.0, style.hex(9605778u32))
    ret win3_rect(b, at, top + long - 1.0, 2.0, 1.0, style.hex(9605778u32))
}

fn win4_track(a: *mem.Arena, high: f32, rows: usize) -> (widget.Node, err) {
    let (cells, cells_error) = mem.alloc[Win4Track](a, 1usize)
    if cells_error != ok { ret (zero, TooLarge) }
    cells[0usize] = Win4Track { rows: u32(rows) }
    var none: []const widget.Node = zero
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: win3_measure, paint: win4_track_paint, state: widget.bytes_of[Win4Track](&cells[0usize]) } }, style: sized_style(16.0, high), children: none }, ok)
}
// ---- end looks4 group d (popup lists) ----------------------------------------------------------

// A list-style (read-only) combo shows no text caret in v3: the runtime draws a caret in the text
// colour when none is given, so a read-only one gets the face colour (it sits in blank space after the text).
fn win4_caret(read_only: bool, face: paint.Color) -> paint.Color {
    // looks9: invisible, not the face colour: the 2 px caret would otherwise paint over the first glyph column.
    if looks_caret_hidden || read_only { ret with_alpha(face, 0.001) }
    ret zero
}

// Piecewise linear through four (x, v) anchors, clamped at the ends.
fn win4_lerp4(x: f32, x0: f32, x1: f32, x2: f32, x3: f32, v0: f32, v1: f32, v2: f32, v3: f32) -> f32 {
    if x <= x0 { ret v0 }
    if x >= x3 { ret v3 }
    if x <= x1 { ret v0 + (v1 - v0) * (x - x0) / (x1 - x0) }
    if x <= x2 { ret v1 + (v2 - v1) * (x - x1) / (x2 - x1) }
    ret v2 + (v3 - v2) * (x - x2) / (x3 - x2)
}

// The rounded frame while its list is open (look 1) or its drop button is held down (look 2): the
// native theme's blue face (#CCE4F7) inside a #005499 stroke whose four rows and four columns are
// coverage values that drift with the control's window position (`edge_y`, `edge_x`), measured on the
// settled grabs ref/windows/states/combo-box-open-dialog-* and ...-drop-button-pressed-... Look 3 is the
// first frame after the click, #D0E6F7 with a paler stroke: the rest frame under the settled one at 92 %
// (measured on the four first grabs: Row Color, Font Size, Card Art Position, Condition).
fn win4_curve(x: f32, xs: []const f32, vs: []const f32) -> f32 {
    if x <= xs[0usize] { ret vs[0usize] }
    var i = 1usize
    while i < xs.len {
        if x <= xs[i] { ret vs[i - 1usize] + (vs[i] - vs[i - 1usize]) * (x - xs[i - 1usize]) / (xs[i] - xs[i - 1usize]) }
        i += 1usize
    }
    ret vs[xs.len - 1usize]
}

fn win4_hot_paint(f: *const Win3Frame, b: *scene.Builder, x: f32, y: f32, w: f32, h: f32, alpha: f32) -> err {
    var face = style.hex(13427959u32)
    var stroke = style.hex(21657u32)
    if f.look == 4u32 {
        // looks5 group d: the drop button under the pointer, the same frame in #E0EEF9 with a #0078D7 stroke (hover-combo-box-drop-*).
        face = style.hex(14741241u32)
        stroke = style.hex(30935u32)
    }
    var stroke_foot = stroke
    if f.look == 4u32 { stroke_foot = style.hex(27328u32) }
    let ground = f.ground
    var wy: f32 = 71.0
    if f.edge_y > 0.0 { wy = f.edge_y }
    let ys = [5]f32{ 41.0, 71.0, 99.0, 159.0, 278.0 }
    let top = [5]f32{ 0.667, 0.636, 0.617, 0.575, 0.484 }
    let top1 = [5]f32{ 0.333, 0.362, 0.382, 0.426, 0.514 }
    let bot1 = [5]f32{ 0.667, 0.627, 0.604, 0.558, 0.471 }
    let bot = [5]f32{ 0.333, 0.379, 0.399, 0.441, 0.533 }
    try win3_rect(b, x + 2.0, y + 2.0, w - 4.0, h - 4.0, with_alpha(face, alpha))
    try win3_rect(b, x + 5.0, y, w - 10.0, 1.0, with_alpha(win4_mix(ground, stroke, win4_curve(wy, ys[0usize..5usize], top[0usize..5usize])), alpha))
    try win3_rect(b, x + 5.0, y + 1.0, w - 10.0, 1.0, with_alpha(win4_mix(face, stroke, win4_curve(wy, ys[0usize..5usize], top1[0usize..5usize])), alpha))
    try win3_rect(b, x + 5.0, y + h - 2.0, w - 10.0, 1.0, with_alpha(win4_mix(face, stroke_foot, win4_curve(wy, ys[0usize..5usize], bot1[0usize..5usize])), alpha))
    try win3_rect(b, x + 5.0, y + h - 1.0, w - 10.0, 1.0, with_alpha(win4_mix(ground, stroke_foot, win4_curve(wy, ys[0usize..5usize], bot[0usize..5usize])), alpha))
    var wx: f32 = 321.0
    if f.edge_x > 0.0 { wx = f.edge_x }
    let right = wx + w - 1.0
    let lx = [5]f32{ 149.0, 321.0, 371.0, 406.0, 407.0 }
    let lo = [5]f32{ 1.0, 0.770, 0.735, 0.708, 0.708 }
    let li = [5]f32{ 0.0, 0.230, 0.270, 0.294, 0.294 }
    let rx = [5]f32{ 292.0, 557.0, 560.0, 706.0, 710.0 }
    let ri = [5]f32{ 1.0, 0.598, 0.595, 0.489, 0.486 }
    let ro = [5]f32{ 0.0, 0.404, 0.407, 0.513, 0.516 }
    // round 15: a pure stroke column (weight 1: the left edge at x 149, the right one at 292) is the capture's #0078D4, not the mixed fit's #0078D7
    var stroke_left = stroke
    if f.look == 4u32 && win4_curve(wx, lx[0usize..5usize], lo[0usize..5usize]) > 0.999 { stroke_left = style.hex(30932u32) }
    var stroke_right = stroke
    if f.look == 4u32 && win4_curve(right, rx[0usize..5usize], ri[0usize..5usize]) > 0.999 { stroke_right = style.hex(30932u32) }
    try win3_rect(b, x, y + 5.0, 1.0, h - 10.0, with_alpha(win4_mix(ground, stroke_left, win4_curve(wx, lx[0usize..5usize], lo[0usize..5usize])), alpha))
    try win3_rect(b, x + 1.0, y + 5.0, 1.0, h - 10.0, with_alpha(win4_mix(face, stroke, win4_curve(wx, lx[0usize..5usize], li[0usize..5usize])), alpha))
    try win3_rect(b, x + w - 2.0, y + 5.0, 1.0, h - 10.0, with_alpha(win4_mix(face, stroke_right, win4_curve(right, rx[0usize..5usize], ri[0usize..5usize])), alpha))
    try win3_rect(b, x + w - 1.0, y + 5.0, 1.0, h - 10.0, with_alpha(win4_mix(ground, stroke, win4_curve(right, rx[0usize..5usize], ro[0usize..5usize])), alpha))
    try win4_hot_corner(f, b, face, stroke, win3_corner_tl(), x, y, false, false, alpha)
    try win4_hot_corner(f, b, face, stroke, win3_corner_tr(), x + w - 5.0, y, true, false, alpha)
    try win4_hot_corner(f, b, face, stroke, win3_corner_bl(), x, y + h - 5.0, false, true, alpha)
    ret win4_hot_corner(f, b, face, stroke, win3_corner_br(), x + w - 5.0, y + h - 5.0, true, true, alpha)
}

fn win4_hot_corner(f: *const Win3Frame, b: *scene.Builder, face: paint.Color, stroke: paint.Color, table: str, x: f32, y: f32, flip_x: bool, flip_y: bool, alpha: f32) -> err {
    var j = 0usize
    while j < 5usize {
        var i = 0usize
        while i < 5usize {
            let v = win3_byte(table, j * 5usize + i)
            // looks12: a plain face pixel of the tile (v 253) inside the rectangle painted above is skipped: at alpha 0.92 (the first
            // frame after a click) the second coat made it #CCE4F7 where the capture has #D0E6F7.
            if v < 256u32 && !(v >= 253u32 && i >= 2usize && j >= 2usize) {
                var px = x + f32(i)
                var py = y + f32(j)
                if flip_x { px = x + f32(4usize - i) }
                if flip_y { py = y + f32(4usize - j) }
                var k = (253.0 - f32(v)) / 43.0
                if k < 0.0 { k = 0.0 }
                if k > 1.0 { k = 1.0 }
                k = k * 1.05
                var under = face
                if v >= 238u32 && v < 252u32 { under = face }
                try win3_rect(b, px, py, 1.0, 1.0, with_alpha(win4_mix(under, stroke, k * 0.85), alpha))
            }
            i += 1usize
        }
        j += 1usize
    }
    ret ok
}

// The held drop button of an editable combo: 17 wide, 22 tall (its bottom row is the frame's bleed).
fn win4_held_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let lines = mem.cast[*Win3Lines](ctx)
    let x = area.x
    let y = area.y
    // Round 6: shade 1 is the pointer over the drop button of the focused editable combo (states/hover-combo-box-drop-search):
    // the same box in #E5F1FB inside the #0078D4 frame, its rows 0, 1, 20 and 21 measured as the held one's.
    var frame = style.hex(24503u32)
    var face = style.hex(13427959u32)
    if lines.shade > 0.5 {
        frame = style.hex(30932u32)
        face = style.hex(15069691u32)
    }
    var row: f32 = 0.0
    while row < 22.0 {
        var left = frame
        var mid = face
        var right = frame
        if lines.shade > 0.5 {
            if row == 0.0 {
                left = style.hex(12047335u32)
                mid = style.hex(5284061u32)
                right = style.hex(11719143u32)
            }
            if row == 1.0 {
                left = style.hex(4233435u32)
                mid = style.hex(10078702u32)
                right = style.hex(3970778u32)
            }
            if row == 20.0 {
                left = style.hex(28874u32)
                mid = style.hex(5021921u32)
                right = style.hex(1145549u32)
            }
            if row == 21.0 {
                left = style.hex(10535904u32)
                mid = style.hex(10537191u32)
                right = style.hex(11127268u32)
            }
        } else {
            if row == 0.0 {
                left = style.hex(12045793u32)
                mid = style.hex(5279690u32)
                right = style.hex(11717601u32)
            }
            if row == 1.0 {
                left = style.hex(4228806u32)
                mid = style.hex(8960226u32)
                right = style.hex(3965892u32)
            }
            if row == 20.0 {
                left = style.hex(25530u32)
                mid = style.hex(4492236u32)
                right = style.hex(1141950u32)
            }
            if row == 21.0 {
                left = style.hex(10535647u32)
                mid = style.hex(10535133u32)
                right = style.hex(11126496u32)
            }
        }
        try win3_rect(b, x, y + row, 1.0, 1.0, left)
        try win3_rect(b, x + 1.0, y + row, 15.0, 1.0, mid)
        try win3_rect(b, x + 16.0, y + row, 1.0, 1.0, right)
        row += 1.0
    }
    ret ok
}

fn win4_held_box(a: *mem.Arena, shade: f32) -> (widget.Node, err) {
    let (cells, cells_error) = mem.alloc[Win3Lines](a, 1usize)
    if cells_error != ok { ret (zero, TooLarge) }
    cells[0usize] = Win3Lines { shade: shade }
    var none: []const widget.Node = zero
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: win3_measure, paint: win4_held_paint, state: widget.bytes_of[Win3Lines](&cells[0usize]) } }, style: sized_style(17.0, 22.0), children: none }, ok)
}

fn win4_mix(a: paint.Color, b: paint.Color, share: f32) -> paint.Color {
    var k = share
    if k < 0.0 { k = 0.0 }
    if k > 1.0 { k = 1.0 }
    ret style.mix(a, b, k)
}

// ---- Android look (profile MaterialLike): Material Design 3 geometry --------------------------------
// The `material_*` helpers below draw what the Neper default does not: the error state of the selection
// controls, the switch's thumb icon, floating-label text fields and the like. Spec values are the published
// M3 component tokens (md.comp.*) in dp; where one is an approximation the sheet's status notes say so.

// A check box or radio mark in its 40 dp state layer (md.comp.checkbox, md.comp.radio-button): an 18 dp box (2 dp
// corners) or a 20 dp ring, 2 dp `on-surface-variant` outline, `primary` once chosen; `invalid` colours the outline,
// the fill and the layer `error`; disabled is `on-surface` at 38 %, a checked box keeping its fill in that with a
// `surface` tick.
fn material_choice_mark(a: *mem.Arena, t: *const Theme, state: style.ControlState, chosen: bool, mixed: bool, round: bool, enabled: bool, invalid: bool, share: f32) -> (widget.Node, err) {
    var mark: f32 = 18.0
    if round { mark = 20.0 }
    var accent = style.color(t.tokens, .Primary)
    var tick = style.color(t.tokens, .OnPrimary)
    if invalid {
        accent = style.color(t.tokens, .Error)
        tick = style.color(t.tokens, .OnError)
    }
    let filled = chosen || mixed
    let quiet = with_alpha(style.color(t.tokens, .OnSurface), t.tokens.states.disabled_content)
    var idle = style.color(t.tokens, .OnSurfaceVariant)
    // Material Web (checkbox-styles.css hover/focus/pressed-outline-color, radio icon-color) and the M3 spec: on-surface once touched.
    if state.hovered || state.focus_visible || state.pressed { idle = style.color(t.tokens, .OnSurface) }
    if invalid { idle = style.color(t.tokens, .Error) }
    var edge = style.mix(idle, accent, share)
    if !enabled {
        edge = quiet
        tick = style.color(t.tokens, .Surface)
    }
    var mark_style = sized_style(mark, mark)
    mark_style.border = style.Border { width: 2.0, color: edge }
    mark_style.radius = 2.0
    let (inside, inside_error) = mem.alloc[widget.Node](a, 1usize)
    if inside_error != ok { ret (zero, TooLarge) }
    if round {
        mark_style.radius = mark * 0.5
        let across = mark * 0.5 * share
        var dot = sized_style(across, across)
        dot.radius = across * 0.5
        dot.background = paint.Brush { Solid: edge }
        inside[0usize] = widget.box(0u64, dot, zero)
    } else {
        var fill_ink = edge
        // Pressed, a chosen box is darkened by the state layer lying over it (md-checkbox draws the layer above the container).
        if state.pressed && filled && enabled { fill_ink = style.layer(fill_ink, style.color(t.tokens, .OnSurface), state_opacity(t, state)) }
        mark_style.background = paint.Brush { Solid: with_alpha(fill_ink, fill_ink.alpha * share) }
        // A translucent edge over a translucent fill would double on the 2 dp rim: a settled chosen box is the fill alone.
        if filled && share > 0.99 { mark_style.border = style.Border { width: 0.0, color: edge } }
        var kind: GlyphKind = .Check
        if mixed { kind = .Dash }
        let (drawn, drawn_error) = stroked_glyph(a, with_alpha(tick, tick.alpha * share), kind, mark - 4.0, 2.0)
        if drawn_error != ok { ret (zero, drawn_error) }
        inside[0usize] = drawn
    }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 1usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = widget.aligned(0u64, .Center, .Center, mark_style, inside[0usize..1usize])
    var layer_ink = style.color(t.tokens, .OnSurface)
    if filled { layer_ink = style.color(t.tokens, .Primary) }
    // M3: unselected hovers and focuses on-surface and presses primary; selected is the other way round.
    if state.pressed { layer_ink = style.color(t.tokens, .Primary) }
    if state.pressed && filled { layer_ink = style.color(t.tokens, .OnSurface) }
    if invalid { layer_ink = style.color(t.tokens, .Error) }
    var circle_style = sized_style(40.0, 40.0)
    circle_style.radius = 20.0
    circle_style.background = paint.Brush { Solid: with_alpha(layer_ink, state_opacity(t, state)) }
    ret (widget.aligned(0u64, .Center, .Center, circle_style, parts[0usize..1usize]), ok)
}

// A 48 dp touch target holding `content` at its start, a tap region keyed `key`, semantics `role`.
fn material_target(a: *mem.Arena, key: widget.Key, role: u8, label: str, states: u32, action: *const widget.Submit, enabled: bool, content: widget.Node) -> (widget.Node, err) {
    var target_style = style.defaults()
    target_style.min_height = style.Length { Px: 48.0 }
    target_style.min_width = style.Length { Px: 48.0 }
    // The switch's mark (52 track in a 60 box) is wider than the target: the target grows to it rather than overhang.
    if role == 18u8 { target_style.min_width = style.Length { Px: 60.0 } }
    let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
    if held_error != ok { ret (zero, TooLarge) }
    held[0usize] = content
    let (centred, centred_error) = mem.alloc[widget.Node](a, 1usize)
    if centred_error != ok { ret (zero, TooLarge) }
    centred[0usize] = widget.aligned(0u64, .Start, .Center, target_style, held[0usize..1usize])
    let (inner, inner_error) = mem.alloc[widget.Node](a, 1usize)
    if inner_error != ok { ret (zero, TooLarge) }
    inner[0usize] = widget.region(key, widget.Region { gesture: widget.GestureAction { ctx: mem.cast[*void](action), invoke: press_tap }, gestures: 1u8 | 4u8, enabled: enabled, focusable: enabled }, style.defaults(), centred[0usize..1usize])
    var sem: widget.Semantics = zero
    sem.role = role
    sem.label = label
    sem.actions = accessibility.ACTION_PRESS
    sem.states = states
    if !enabled { sem.states = sem.states | accessibility.STATE_DISABLED }
    ret (widget.semantics(0u64, sem, style.defaults(), inner[0usize..1usize]), ok)
}

// A mark and its `body-large` label in a row, `gap` apart.
fn material_labelled(a: *mem.Arena, t: *const Theme, mark: widget.Node, label: str, enabled: bool, gap: f32) -> (widget.Node, err) {
    var caption = text_options()
    caption.role = .BodyLarge
    caption.wrap = .None
    var words = style.color(t.tokens, .OnSurface)
    if !enabled { words = with_alpha(words, t.tokens.states.disabled_content) }
    let (label_node, label_error) = colored_text(a, 0u64, label, t, caption, words)
    if label_error != ok { ret (zero, label_error) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = mark
    parts[1usize] = label_node
    ret (widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: gap }, style.defaults(), parts[0usize..2usize]), ok)
}

// The row of `choosable` under the Android look: the mark in a 48 dp touch target, the label `body-large`, `invalid`
// the M3 error state.
fn material_choice(a: *mem.Arena, key: widget.Key, t: *const Theme, role: u8, label: str, chosen: bool, mixed: bool, round: bool, action: *const widget.Submit, enabled: bool, invalid: bool) -> (widget.Node, err) {
    var state = control_state(t, key, enabled, false)
    state.invalid = invalid
    var goal: f32 = 0.0
    if chosen || mixed { goal = 1.0 }
    var millis = t.tokens.durations.short2
    if round { millis = t.tokens.durations.short3 }
    let chosen_share = eased_on(t, key, key + 1048593u64, goal, false, millis)
    let (mark_node, mark_error) = material_choice_mark(a, t, state, chosen, mixed, round, enabled, invalid, chosen_share)
    if mark_error != ok { ret (zero, mark_error) }
    // The 40 dp layer sits centred in the 48 dp target (4 dp in), the label right after it.
    let (slot, slot_error) = mem.alloc[widget.Node](a, 1usize)
    if slot_error != ok { ret (zero, TooLarge) }
    slot[0usize] = mark_node
    let seated = widget.aligned(0u64, .End, .Center, sized_style(44.0, 40.0), slot[0usize..1usize])
    var row = seated
    if label.len > 0usize {
        let (with_text, row_error) = material_labelled(a, t, seated, label, enabled, 0.0)
        if row_error != ok { ret (zero, row_error) }
        row = with_text
    }
    var states = 0u32
    if chosen { states = accessibility.STATE_CHECKED }
    if mixed { states = states | accessibility.STATE_MIXED }
    let (node, node_error) = material_target(a, key, role, label, states, action, enabled, row)
    ret (node, node_error)
}

fn material_checkbox(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, checked: bool, mixed: bool, action: *const widget.Submit, enabled: bool, invalid: bool) -> (widget.Node, err) {
    let (node, node_error) = material_choice(a, key, t, 4u8, label, checked, mixed, false, action, enabled, invalid)
    ret (node, node_error)
}

fn material_radio(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, selected: bool, action: *const widget.Submit, enabled: bool, invalid: bool) -> (widget.Node, err) {
    let (node, node_error) = material_choice(a, key, t, 5u8, label, selected, false, true, action, enabled, invalid)
    ret (node, node_error)
}

// The switch's parts `share` of the way from off to on (md.comp.switch): a 52 x 32 track (off `surface-container-highest`
// in a 2 dp `outline` edge, on `primary`), the thumb 16 dp off, 24 dp on or with its icon, 28 dp pressed, in the 40 dp
// state layer; the icon is 16 dp, a cross off in `surface-container-highest` and a tick on in `on-primary-container`.
fn material_switch_mark(a: *mem.Arena, t: *const Theme, state: style.ControlState, share: f32, enabled: bool, with_icon: bool) -> (widget.Node, err) {
    let ink = style.color(t.tokens, .OnSurface)
    let highest = style.color(t.tokens, .SurfaceContainerHighest)
    let active = state.hovered || state.pressed || state.focus_visible
    var off_thumb = style.color(t.tokens, .Outline)
    if active { off_thumb = style.color(t.tokens, .OnSurfaceVariant) }
    var on_thumb = style.color(t.tokens, .OnPrimary)
    if active { on_thumb = style.color(t.tokens, .PrimaryContainer) }
    var off_fill = highest
    var on_fill = style.color(t.tokens, .Primary)
    var edge = style.color(t.tokens, .Outline)
    var on_icon = style.color(t.tokens, .OnPrimaryContainer)
    if !enabled {
        let faint = with_alpha(ink, t.tokens.states.disabled_container)
        off_fill = with_alpha(highest, t.tokens.states.disabled_container)
        edge = faint
        off_thumb = with_alpha(ink, t.tokens.states.disabled_content)
        on_fill = faint
        on_thumb = style.color(t.tokens, .Surface)
        on_icon = with_alpha(ink, t.tokens.states.disabled_content)
    }
    let track_fill = style.mix(off_fill, on_fill, share)
    let thumb = style.mix(off_thumb, on_thumb, share)
    let halo = style.mix(ink, style.color(t.tokens, .Primary), share)
    let edge_width = 2.0 * (1.0 - share)
    var d: f32 = 16.0 + 8.0 * share
    if with_icon { d = 24.0 }
    let cx: f32 = 16.0 + 20.0 * share
    if state.pressed && enabled { d = 28.0 }
    let (layers, layers_error) = mem.alloc[widget.Node](a, 3usize)
    if layers_error != ok { ret (zero, TooLarge) }
    var track = sized_style(52.0, 32.0)
    track.radius = 16.0
    track.background = paint.Brush { Solid: track_fill }
    track.border = style.Border { width: edge_width, color: edge }
    layers[0usize] = widget.positioned(0u64, 4.0, 4.0, track, zero)
    var circle = sized_style(40.0, 40.0)
    circle.radius = 20.0
    circle.background = paint.Brush { Solid: with_alpha(halo, state_opacity(t, state)) }
    layers[1usize] = widget.positioned(0u64, 4.0 + cx - 20.0, 0.0, circle, zero)
    var knob = sized_style(d, d)
    knob.radius = d * 0.5
    knob.background = paint.Brush { Solid: thumb }
    let (glyph_slot, glyph_slot_error) = mem.alloc[widget.Node](a, 1usize)
    if glyph_slot_error != ok { ret (zero, TooLarge) }
    var glyph_count = 0usize
    if with_icon {
        var kind: GlyphKind = .Cross
        var ink_icon = highest
        if share > 0.5 {
            kind = .Check
            ink_icon = on_icon
        }
        let (glyph, glyph_error) = stroked_glyph(a, ink_icon, kind, 16.0, 2.0)
        if glyph_error != ok { ret (zero, glyph_error) }
        glyph_slot[0usize] = glyph
        glyph_count = 1usize
    }
    let (knob_node, knob_error) = mem.alloc[widget.Node](a, 1usize)
    if knob_error != ok { ret (zero, TooLarge) }
    knob_node[0usize] = widget.aligned(0u64, .Center, .Center, knob, glyph_slot[0usize..glyph_count])
    layers[2usize] = widget.positioned(0u64, 4.0 + cx - d * 0.5, 20.0 - d * 0.5, style.defaults(), knob_node[0usize..1usize])
    ret (widget.stack(0u64, sized_style(60.0, 40.0), layers[0usize..3usize]), ok)
}

// The switch row under the Android look: the mark with its label `body-large` after it, in a 48 dp target.
fn material_switch(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, on: bool, with_icon: bool, action: *const widget.Submit, enabled: bool) -> (widget.Node, err) {
    let state = control_state(t, key, enabled, false)
    var goal: f32 = 0.0
    if on { goal = 1.0 }
    let share = eased_on(t, key, key + 1048592u64, goal, false, t.tokens.durations.short3)
    let (mark, mark_error) = material_switch_mark(a, t, state, share, enabled, with_icon)
    if mark_error != ok { ret (zero, mark_error) }
    var row = mark
    if label.len > 0usize {
        let (with_text, row_error) = material_labelled(a, t, mark, label, enabled, 8.0)
        if row_error != ok { ret (zero, row_error) }
        row = with_text
    }
    var states = 0u32
    if on { states = accessibility.STATE_CHECKED }
    let (node, node_error) = material_target(a, key, 18u8, label, states, action, enabled, row)
    ret (node, node_error)
}
// A snackbar (md.comp.snackbar): `inverse-surface` container, 4 dp corners, elevation 3, at least 48 dp high (68 with two
// lines or a long action), 16 dp at the start and 8 at the end; the supporting text `body-medium` in `inverse-on-surface`,
// the action a text button in `inverse-primary`, the dismiss a 24 dp cross in `inverse-on-surface` in a 48 dp target.
fn material_snackbar(a: *mem.Arena, key: widget.Key, t: *const Theme, text_value: str, action_label: str, action: *const widget.Submit, dismiss: *const widget.Submit, width: f32) -> (widget.Node, err) {
    let ink = style.color(t.tokens, .InverseOnSurface)
    var caption = text_options()
    caption.role = .BodyMedium
    let (message, message_error) = colored_text(a, 0u64, text_value, t, caption, ink)
    if message_error != ok { ret (zero, message_error) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 3usize)
    if parts_error != ok { ret (zero, TooLarge) }
    // md.comp.snackbar: 14 dp above and below the text (48 for a line, 68 for two).
    let (message_held, message_held_error) = mem.alloc[widget.Node](a, 1usize)
    if message_held_error != ok { ret (zero, TooLarge) }
    message_held[0usize] = message
    var grown = widget.padded(0u64, 0.0, 14.0, 0.0, 14.0, style.defaults(), message_held[0usize..1usize])
    grown.style.width = style.Length { Flex: 1.0 }
    parts[0usize] = grown
    var at = 1usize
    if action_label.len != 0usize {
        let (act, act_error) = tinted_button_min(a, key + 1u64, t, action_label, action, style.color(t.tokens, .InversePrimary), 0.0)
        if act_error != ok { ret (zero, act_error) }
        parts[at] = act
        at += 1usize
    }
    if widget.submit_set(dismiss.invoke) {
        let (close, close_error) = tinted_glyph_button(a, key + 2u64, t, .Cross, "Dismiss", dismiss, 40.0, 24.0, ink)
        if close_error != ok { ret (zero, close_error) }
        parts[at] = close
        at += 1usize
    }
    var sheet = style.defaults()
    sheet.background = paint.Brush { Solid: style.color(t.tokens, .InverseSurface) }
    sheet.radius = 4.0
    sheet.width = style.Length { Px: width }
    sheet.min_height = style.Length { Px: 48.0 }
    sheet.shade = 3u8
    sheet.padding = style.EdgeLengths { left: style.Length { Px: 16.0 }, top: style.Length { Px: 0.0 }, right: style.Length { Px: 8.0 }, bottom: style.Length { Px: 0.0 } }
    let (row, row_error) = mem.alloc[widget.Node](a, 1usize)
    if row_error != ok { ret (zero, TooLarge) }
    row[0usize] = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 8.0 }, sheet, parts[0usize..at])
    var sem: widget.Semantics = zero
    sem.role = 26u8
    sem.label = text_value
    sem.live = 1u8
    ret (widget.semantics(key, sem, style.defaults(), row[0usize..1usize]), ok)
}

// A floating action button drawn from a glyph (md.comp.fab): `primary-container` with the icon in
// `on-primary-container`, elevation 3 (4 hovered); small 40 dp with 12 dp corners, regular 56 with 16, large 96 with 28
// and a 36 dp icon, extended 56 tall with 16 dp before the icon, 8 between and 20 after.
type FabTone = enum u8 { Primary, Secondary, Tertiary, Surface }

fn material_fab(a: *mem.Arena, key: widget.Key, t: *const Theme, kind: GlyphKind, label: str, action: *const widget.Submit, size: FabSize) -> (widget.Node, err) {
    let (node, node_error) = material_fab_toned(a, key, t, kind, label, action, size, .Primary)
    ret (node, node_error)
}

// The FAB in one of the four M3 colour roles: primary, secondary and tertiary container under their `on` colours, or
// `surface-container-high` under a `primary` icon.
fn material_fab_toned(a: *mem.Arena, key: widget.Key, t: *const Theme, kind: GlyphKind, label: str, action: *const widget.Submit, size: FabSize, tone: FabTone) -> (widget.Node, err) {
    let fab_state = control_state(t, key, true, false)
    var look = style.resolve(t.tokens, .Container, fab_state)
    if tone != .Primary {
        var fill = style.color(t.tokens, .SecondaryContainer)
        var ink = style.color(t.tokens, .OnSecondaryContainer)
        if tone == .Tertiary {
            fill = style.color(t.tokens, .TertiaryContainer)
            ink = style.color(t.tokens, .OnTertiaryContainer)
        }
        if tone == .Surface {
            fill = style.color(t.tokens, .SurfaceContainerHigh)
            ink = style.color(t.tokens, .Primary)
        }
        look.background = style.layer(fill, ink, state_opacity(t, fab_state))
        look.foreground = ink
    }
    var side: f32 = 56.0
    var icon_size: f32 = 24.0
    look.radius = 16.0
    if size == .Small {
        side = 40.0
        look.radius = 12.0
    }
    if size == .Large {
        side = 96.0
        icon_size = 36.0
        look.radius = 28.0
    }
    look.custom_padding = true
    look.padding = (side - icon_size) * 0.5
    look.padding_y = look.padding
    look.min_width = side
    look.min_height = side
    let (mark, mark_error) = icon_square(a, look.foreground, kind, icon_size)
    if mark_error != ok { ret (zero, mark_error) }
    var content = mark
    var name = "Floating action button"
    if size == .Extended {
        look.padding_start = 16.0
        look.padding = 20.0
        look.min_width = 80.0
        var caption = text_options()
        caption.role = .LabelLarge
        caption.wrap = .None
        let (label_node, label_error) = colored_text(a, 0u64, label, t, caption, look.foreground)
        if label_error != ok { ret (zero, label_error) }
        let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
        if parts_error != ok { ret (zero, TooLarge) }
        parts[0usize] = mark
        parts[1usize] = label_node
        content = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 12.0 }, style.defaults(), parts[0usize..2usize])
        name = label
    }
    let (node, node_error) = pressable(a, key, t, 3u8, name, look, true, false, action, content)
    ret (node, node_error)
}

// An icon button (md.comp.icon-button): a 40 dp circle round a 24 dp icon (standard: no container, `on-surface-variant`;
// filled: `primary`; tonal: `secondary-container`; outlined: a 1 dp `outline`); `toggled` is the selected form (standard
// `primary` icon, filled `primary`, the others as their selected container); disabled is `on-surface` at 38 % / 12 %.
fn material_icon_button(a: *mem.Arena, key: widget.Key, t: *const Theme, kind: GlyphKind, label: str, action: *const widget.Submit, variant: style.ControlVariant, enabled: bool, toggled: bool) -> (widget.Node, err) {
    let state = control_state(t, key, enabled, false)
    var shown = variant
    var look = style.resolve(t.tokens, shown, state)
    if variant == .Plain {
        look.foreground = style.color(t.tokens, .OnSurfaceVariant)
        if toggled { look.foreground = style.color(t.tokens, .Primary) }
        look.background = style.layer(paint.rgba(0.0, 0.0, 0.0, 0.0), look.foreground, state_opacity(t, state))
    }
    if variant == .Outlined {
        look.foreground = style.color(t.tokens, .OnSurfaceVariant)
        if toggled {
            look.background = style.color(t.tokens, .InverseSurface)
            look.foreground = style.color(t.tokens, .InverseOnSurface)
            look.border_width = 0.0
            look.background = style.layer(look.background, look.foreground, state_opacity(t, state))
        } else {
            // md-outlined-icon-button: the icon and the hover and focus layers are on-surface-variant, the pressed layer on-surface.
            var layer_ink = look.foreground
            if state.pressed { layer_ink = style.color(t.tokens, .OnSurface) }
            look.background = style.layer(paint.rgba(0.0, 0.0, 0.0, 0.0), layer_ink, state_opacity(t, state))
        }
    }
    if variant == .Tonal && !toggled {
        // md-filled-tonal-icon-button, unselected toggle: surface-container-highest under an on-surface-variant icon and state layer.
        look.foreground = style.color(t.tokens, .OnSurfaceVariant)
        look.background = style.layer(style.color(t.tokens, .SurfaceContainerHighest), look.foreground, state_opacity(t, state))
    }
    if variant == .Filled && !toggled {
        look.background = style.layer(style.color(t.tokens, .SurfaceContainerHighest), style.color(t.tokens, .Primary), state_opacity(t, state))
        look.foreground = style.color(t.tokens, .Primary)
    }
    look.elevation = 0u8
    if !enabled { look = style.disabled_look(t.tokens, look) }
    look.radius = 20.0
    look.custom_padding = true
    look.padding = 8.0
    look.padding_y = 8.0
    look.min_width = 40.0
    look.min_height = 40.0
    let (mark, mark_error) = icon_square(a, look.foreground, kind, 24.0)
    if mark_error != ok { ret (zero, mark_error) }
    let (node, node_error) = pressable(a, key, t, 3u8, label, look, enabled, toggled, action, mark)
    ret (node, node_error)
}

// A top app bar (md.comp.top-app-bar) drawn from glyphs: `size` 0 small (64 dp, `title-large` after the leading icon),
// 1 centre-aligned, 2 medium (112 dp, `headline-small` on its own line 20 dp above the bottom edge), 3 large (152 dp,
// `headline-medium`, 28 dp above the bottom edge); container `surface` (`surface-container` once `scrolled`), the leading
// icon `on-surface`, the trailing ones `on-surface-variant`, 24 dp icons in 48 dp targets with 4 dp side padding.
fn material_app_bar(a: *mem.Arena, key: widget.Key, t: *const Theme, title: str, leading: GlyphKind, has_leading: bool, trailing: []const GlyphKind, size: u8, scrolled: bool, action: *const widget.Submit, width: f32) -> (widget.Node, err) {
    let ink = style.color(t.tokens, .OnSurface)
    let muted = style.color(t.tokens, .OnSurfaceVariant)
    var ground = style.color(t.tokens, .Surface)
    if scrolled { ground = style.color(t.tokens, .SurfaceContainer) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, trailing.len + 3usize)
    if parts_error != ok { ret (zero, TooLarge) }
    var at = 0usize
    if has_leading {
        let (lead, lead_error) = tinted_glyph_button(a, key + 1u64, t, leading, "Navigation", action, 48.0, 24.0, ink)
        if lead_error != ok { ret (zero, lead_error) }
        parts[at] = lead
        at += 1usize
    }
    var small_title = size < 2u8
    var caption = text_options()
    caption.role = .TitleLarge
    caption.wrap = .None
    caption.max_lines = 1u32
    caption.ellipsis = "..."
    var title_node: widget.Node = zero
    if small_title {
        let (made, made_error) = colored_text(a, 0u64, title, t, caption, ink)
        if made_error != ok { ret (zero, made_error) }
        title_node = made
    } else {
        title_node = widget.spacer(0u64, 0.0)
    }
    var grown = title_node
    grown.style.width = style.Length { Flex: 1.0 }
    if size == 1u8 {
        let (centred, centred_error) = mem.alloc[widget.Node](a, 1usize)
        if centred_error != ok { ret (zero, TooLarge) }
        centred[0usize] = title_node
        grown = widget.aligned(0u64, .Center, .Center, style.defaults(), centred[0usize..1usize])
        grown.style.width = style.Length { Flex: 1.0 }
    }
    if small_title && has_leading && size == 0u8 {
        var inset = style.defaults()
        inset.padding = style.EdgeLengths { left: style.Length { Px: 4.0 }, top: style.Length { Px: 0.0 }, right: style.Length { Px: 0.0 }, bottom: style.Length { Px: 0.0 } }
        inset.width = style.Length { Flex: 1.0 }
        let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
        if held_error != ok { ret (zero, TooLarge) }
        held[0usize] = title_node
        grown = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 0.0 }, inset, held[0usize..1usize])
    }
    if small_title && !has_leading && size == 0u8 {
        var inset = style.defaults()
        inset.padding = style.EdgeLengths { left: style.Length { Px: 12.0 }, top: style.Length { Px: 0.0 }, right: style.Length { Px: 0.0 }, bottom: style.Length { Px: 0.0 } }
        inset.width = style.Length { Flex: 1.0 }
        let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
        if held_error != ok { ret (zero, TooLarge) }
        held[0usize] = title_node
        grown = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 0.0 }, inset, held[0usize..1usize])
    }
    parts[at] = grown
    at += 1usize
    var i = 0usize
    while i < trailing.len {
        let (act, act_error) = tinted_glyph_button(a, key + 9u64 + u64(i), t, trailing[i], "Action", action, 48.0, 24.0, muted)
        if act_error != ok { ret (zero, act_error) }
        parts[at] = act
        at += 1usize
        i += 1usize
    }
    var row_style = style.defaults()
    row_style.width = style.Length { Percent: 100.0 }
    row_style.height = style.Length { Px: 64.0 }
    row_style.padding = style.EdgeLengths { left: style.Length { Px: 4.0 }, top: style.Length { Px: 0.0 }, right: style.Length { Px: 4.0 }, bottom: style.Length { Px: 0.0 } }
    let (rows, rows_error) = mem.alloc[widget.Node](a, 3usize)
    if rows_error != ok { ret (zero, TooLarge) }
    rows[0usize] = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 0.0 }, row_style, parts[0usize..at])
    var total: f32 = 64.0
    var lines = 1usize
    if size >= 2u8 {
        var headline = text_options()
        headline.role = .HeadlineSmall
        var bottom: f32 = 20.0
        total = 112.0
        if size == 3u8 {
            headline.role = .HeadlineMedium
            bottom = 28.0
            total = 152.0
        }
        headline.wrap = .None
        headline.max_lines = 1u32
        headline.ellipsis = "..."
        let (big, big_error) = colored_text(a, 0u64, title, t, headline, ink)
        if big_error != ok { ret (zero, big_error) }
        let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
        if held_error != ok { ret (zero, TooLarge) }
        held[0usize] = big
        var line_style = style.defaults()
        line_style.width = style.Length { Percent: 100.0 }
        line_style.height = style.Length { Flex: 1.0 }
        line_style.padding = style.EdgeLengths { left: style.Length { Px: 16.0 }, top: style.Length { Px: 0.0 }, right: style.Length { Px: 16.0 }, bottom: style.Length { Px: bottom } }
        rows[1usize] = widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .End, cross: .Start, gap: 0.0 }, line_style, held[0usize..1usize])
        lines = 2usize
    }
    var bar = sized_style(width, total)
    bar.background = paint.Brush { Solid: ground }
    var sem: widget.Semantics = zero
    sem.role = 2u8
    sem.label = title
    let (column, column_error) = mem.alloc[widget.Node](a, 1usize)
    if column_error != ok { ret (zero, TooLarge) }
    column[0usize] = widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, bar, rows[0usize..lines])
    ret (widget.semantics(key, sem, style.defaults(), column[0usize..1usize]), ok)
}

// ---- end Android look block ---------------------------------------------------------------------------

// ---- the Cupertino look (profile CupertinoLike, docs/ui/looks/cupertino) -------------------------------
// Controls drawn the Apple way: marks painted as paths (check, chevrons, magnifier, spinner ticks, the
// switch thumb with its soft shadow) and faces from style.cupertino_resolve. A geometry value marked HIG is
// a published Apple value; the rest is approximated (see the notes in docs/ui/looks/status.d/zzzz-cupertino.json).

type CupMark = struct { kind: u32, color: paint.Color, other: paint.Color, a: f32, b: f32, c: f32, arena: *mem.Arena }

fn cup_mark_measure(ctx: *void, limits: ui_layout.Constraints) -> geometry.Size {
    ret geometry.Size { width: 0.0, height: 0.0 }
}

fn cup_pt(x: f32, y: f32) -> geometry.Point {
    ret geometry.Point { x: x, y: y }
}

fn cup_stroke(b: *scene.Builder, path: geometry.Path, color: paint.Color, width: f32) -> err {
    ret scene.push(b, scene.Command { StrokePath: scene.StrokePath { path: path, brush: paint.Brush { Solid: color }, stroke: paint.Stroke { width: width, cap: .Round, join: .Round, miter_limit: 4.0 } } })
}

fn cup_line(m: *CupMark, b: *scene.Builder, x0: f32, y0: f32, x1: f32, y1: f32, color: paint.Color, width: f32) -> err {
    let (pb, pb_error) = geometry.path_builder(m.arena, 2usize, 2usize)
    if pb_error != ok { ret TooLarge }
    var builder = pb
    try geometry.move_to(&builder, cup_pt(x0, y0))
    try geometry.line_to(&builder, cup_pt(x1, y1))
    ret cup_stroke(b, geometry.finish(&builder), color, width)
}

fn cup_poly(m: *CupMark, b: *scene.Builder, x0: f32, y0: f32, x1: f32, y1: f32, x2: f32, y2: f32, color: paint.Color, width: f32) -> err {
    let (pb, pb_error) = geometry.path_builder(m.arena, 3usize, 3usize)
    if pb_error != ok { ret TooLarge }
    var builder = pb
    try geometry.move_to(&builder, cup_pt(x0, y0))
    try geometry.line_to(&builder, cup_pt(x1, y1))
    try geometry.line_to(&builder, cup_pt(x2, y2))
    ret cup_stroke(b, geometry.finish(&builder), color, width)
}

fn cup_circle_path(builder: *geometry.PathBuilder, cx: f32, cy: f32, r: f32) -> err {
    let k = r * 0.5523
    try geometry.move_to(builder, cup_pt(cx + r, cy))
    try geometry.cubic_to(builder, cup_pt(cx + r, cy + k), cup_pt(cx + k, cy + r), cup_pt(cx, cy + r))
    try geometry.cubic_to(builder, cup_pt(cx - k, cy + r), cup_pt(cx - r, cy + k), cup_pt(cx - r, cy))
    try geometry.cubic_to(builder, cup_pt(cx - r, cy - k), cup_pt(cx - k, cy - r), cup_pt(cx, cy - r))
    try geometry.cubic_to(builder, cup_pt(cx + k, cy - r), cup_pt(cx + r, cy - k), cup_pt(cx + r, cy))
    ret geometry.close_path(builder)
}

fn cup_disc(m: *CupMark, b: *scene.Builder, cx: f32, cy: f32, r: f32, color: paint.Color) -> err {
    let (pb, pb_error) = geometry.path_builder(m.arena, 6usize, 13usize)
    if pb_error != ok { ret TooLarge }
    var builder = pb
    try cup_circle_path(&builder, cx, cy, r)
    ret scene.push(b, scene.Command { FillPath: scene.FillPath { path: geometry.finish(&builder), brush: paint.Brush { Solid: color } } })
}

fn cup_ring(m: *CupMark, b: *scene.Builder, cx: f32, cy: f32, r: f32, color: paint.Color, width: f32) -> err {
    let (pb, pb_error) = geometry.path_builder(m.arena, 6usize, 13usize)
    if pb_error != ok { ret TooLarge }
    var builder = pb
    try cup_circle_path(&builder, cx, cy, r)
    ret cup_stroke(b, geometry.finish(&builder), color, width)
}

fn cup_tick_alpha(i: usize, head: usize, count: usize) -> f32 {
    var age = head + count - i
    if age >= count { age -= count }
    ret 1.0 - 0.85 * f32(age) / f32(count)
}

// kind: 1 check, 2 dash, 3 chevron down, 4 chevron up, 5 chevron right, 6 chevron left, 7 up/down chevrons,
// 8 magnifier, 9 clear (disc `color`, cross `other`), 10 spinner (a stroke, b turn 0..1), 11 thumb (a radius,
// `other` the shadow ink), 12 plus, 13 minus, 14 disc, 15 ring (a stroke), 16 filled up triangle, 17 filled down triangle.
fn cup_mark_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let m = mem.cast[*CupMark](ctx)
    let w = area.width
    let h = area.height
    let x = area.x
    let y = area.y
    let cx = x + w * 0.5
    let cy = y + h * 0.5
    if m.kind == 1u32 { ret cup_poly(m, b, x + w * 0.2, y + h * 0.54, x + w * 0.41, y + h * 0.76, x + w * 0.8, y + h * 0.26, m.color, m.a) }
    if m.kind == 2u32 { ret cup_line(m, b, x + w * 0.22, cy, x + w * 0.78, cy, m.color, m.a) }
    if m.kind == 3u32 { ret cup_poly(m, b, x + w * 0.18, y + h * 0.36, cx, y + h * 0.64, x + w * 0.82, y + h * 0.36, m.color, m.a) }
    if m.kind == 4u32 { ret cup_poly(m, b, x + w * 0.18, y + h * 0.64, cx, y + h * 0.36, x + w * 0.82, y + h * 0.64, m.color, m.a) }
    if m.kind == 5u32 { ret cup_poly(m, b, x + w * 0.36, y + h * 0.18, x + w * 0.64, cy, x + w * 0.36, y + h * 0.82, m.color, m.a) }
    if m.kind == 6u32 { ret cup_poly(m, b, x + w * 0.64, y + h * 0.18, x + w * 0.36, cy, x + w * 0.64, y + h * 0.82, m.color, m.a) }
    if m.kind == 7u32 {
        try cup_poly(m, b, x + w * 0.24, y + h * 0.42, cx, y + h * 0.18, x + w * 0.76, y + h * 0.42, m.color, m.a)
        ret cup_poly(m, b, x + w * 0.24, y + h * 0.58, cx, y + h * 0.82, x + w * 0.76, y + h * 0.58, m.color, m.a)
    }
    if m.kind == 8u32 {
        try cup_ring(m, b, x + w * 0.42, y + h * 0.42, w * 0.3, m.color, m.a)
        ret cup_line(m, b, x + w * 0.64, y + h * 0.64, x + w * 0.88, y + h * 0.88, m.color, m.a)
    }
    if m.kind == 9u32 {
        var r = w * 0.5
        if h < w { r = h * 0.5 }
        try cup_disc(m, b, cx, cy, r, m.color)
        try cup_line(m, b, cx - r * 0.34, cy - r * 0.34, cx + r * 0.34, cy + r * 0.34, m.other, m.a)
        ret cup_line(m, b, cx + r * 0.34, cy - r * 0.34, cx - r * 0.34, cy + r * 0.34, m.other, m.a)
    }
    if m.kind == 10u32 {
        var r = w * 0.5
        if h < w { r = h * 0.5 }
        let count = 12usize
        let head = usize(m.b * 12.0) % count
        var i = 0usize
        while i < count {
            let angle = 6.2831853 * f32(i) / 12.0
            let dx = math.sin[f32](angle)
            let dy = 0.0 - math.cos[f32](angle)
            var color = m.color
            color.alpha = m.color.alpha * cup_tick_alpha(i, head, count)
            try cup_line(m, b, cx + dx * r * 0.52, cy + dy * r * 0.52, cx + dx * (r - m.a * 0.5), cy + dy * (r - m.a * 0.5), color, m.a)
            i += 1usize
        }
        ret ok
    }
    if m.kind == 11u32 {
        // The soft drop shadow of a raised thumb, built of stacked low-alpha discs (no blur primitive).
        let r = m.a
        var shade = m.other
        shade.alpha = m.other.alpha * 0.05
        try cup_disc(m, b, cx, cy + 2.4, r + 3.0, shade)
        try cup_disc(m, b, cx, cy + 2.2, r + 2.0, shade)
        try cup_disc(m, b, cx, cy + 1.8, r + 1.0, shade)
        shade.alpha = m.other.alpha * 0.10
        try cup_disc(m, b, cx, cy + 1.2, r + 0.5, shade)
        shade.alpha = m.other.alpha * 0.22
        try cup_disc(m, b, cx, cy + 0.5, r + 0.25, shade)
        ret cup_disc(m, b, cx, cy, r, m.color)
    }
    if m.kind == 12u32 {
        try cup_line(m, b, x + w * 0.2, cy, x + w * 0.8, cy, m.color, m.a)
        ret cup_line(m, b, cx, y + h * 0.2, cx, y + h * 0.8, m.color, m.a)
    }
    if m.kind == 13u32 { ret cup_line(m, b, x + w * 0.2, cy, x + w * 0.8, cy, m.color, m.a) }
    if m.kind == 14u32 {
        var r = w * 0.5
        if h < w { r = h * 0.5 }
        ret cup_disc(m, b, cx, cy, r, m.color)
    }
    if m.kind == 15u32 {
        var r = w * 0.5
        if h < w { r = h * 0.5 }
        ret cup_ring(m, b, cx, cy, r - m.a * 0.5, m.color, m.a)
    }
    if m.kind == 20u32 {
        // The Apple mark, simplified: two shoulders, a waist, a leaf and a bite (`other`: the ground colour).
        try cup_disc(m, b, x + w * 0.34, y + h * 0.62, w * 0.34, m.color)
        try cup_disc(m, b, x + w * 0.66, y + h * 0.62, w * 0.34, m.color)
        try cup_disc(m, b, x + w * 0.5, y + h * 0.78, w * 0.3, m.color)
        try cup_disc(m, b, x + w * 0.5, y + h * 0.40, w * 0.18, m.color)
        try cup_disc(m, b, x + w * 0.62, y + h * 0.12, w * 0.12, m.color)
        ret cup_disc(m, b, x + w * 0.98, y + h * 0.5, w * 0.17, m.other)
    }
    if m.kind == 19u32 {
        // A bare cross.
        try cup_line(m, b, x + w * 0.25, y + h * 0.25, x + w * 0.75, y + h * 0.75, m.color, m.a)
        ret cup_line(m, b, x + w * 0.75, y + h * 0.25, x + w * 0.25, y + h * 0.75, m.color, m.a)
    }
    if m.kind == 18u32 {
        // The ellipsis: three discs of radius `a`, `b` apart.
        try cup_disc(m, b, cx - m.b, cy, m.a, m.color)
        try cup_disc(m, b, cx, cy, m.a, m.color)
        ret cup_disc(m, b, cx + m.b, cy, m.a, m.color)
    }
    if m.kind == 16u32 || m.kind == 17u32 {
        let (pb, pb_error) = geometry.path_builder(m.arena, 4usize, 4usize)
        if pb_error != ok { ret TooLarge }
        var builder = pb
        if m.kind == 16u32 {
            try geometry.move_to(&builder, cup_pt(x, y + h))
            try geometry.line_to(&builder, cup_pt(cx, y))
            try geometry.line_to(&builder, cup_pt(x + w, y + h))
        }
        if m.kind == 17u32 {
            try geometry.move_to(&builder, cup_pt(x, y))
            try geometry.line_to(&builder, cup_pt(cx, y + h))
            try geometry.line_to(&builder, cup_pt(x + w, y))
        }
        try geometry.close_path(&builder)
        ret scene.push(b, scene.Command { FillPath: scene.FillPath { path: geometry.finish(&builder), brush: paint.Brush { Solid: m.color } } })
    }
    ret ok
}

// A drawn mark `width` x `height`. `stroke` is its line width (or the thumb's radius).
fn cup_mark(a: *mem.Arena, kind: u32, color: paint.Color, other: paint.Color, stroke: f32, turn: f32, width: f32, height: f32) -> (widget.Node, err) {
    let (marks, marks_error) = mem.alloc[CupMark](a, 1usize)
    if marks_error != ok { ret (zero, TooLarge) }
    marks[0usize] = CupMark { kind: kind, color: color, other: other, a: stroke, b: turn, c: 0.0, arena: a }
    var none: []const widget.Node = zero
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&marks[0usize]), measure: cup_mark_measure, paint: cup_mark_paint, state: widget.bytes_of[CupMark](&marks[0usize]) } }, style: sized_style(width, height), children: none }, ok)
}

// A label in a Cupertino size and weight.
fn cup_label(a: *mem.Arena, t: *const Theme, value: str, size: f32, weight: u32, color: paint.Color) -> (widget.Node, err) {
    var caption = text_options()
    caption.role = .Label
    caption.wrap = .None
    caption.size = size
    caption.weight = weight
    let (node, node_error) = colored_text(a, 0u64, value, t, caption, color)
    ret (node, node_error)
}

// The label size and weight of a button by its height and variant: iOS 15 / 15 / 17 semibold for small /
// medium / large; the macOS bezel 13 regular at 22 tall and 15 above.
fn cup_button_size(height: f32, variant: style.ControlVariant) -> f32 {
    if variant == .Outlined {
        if height <= 24.0 { ret 13.0 }
        ret 15.0
    }
    if height >= 40.0 { ret 17.0 }
    ret 15.0
}

fn cup_button_weight(variant: style.ControlVariant) -> u32 {
    if variant == .Outlined || variant == .Plain { ret 400u32 }
    ret 600u32
}

// The Cupertino button: iOS configuration sizes 28 / 34 / 50 (options.height; 0 is 34, or 22 for the macOS
// bezel `Outlined`), `picture` before the caption when `has_icon`, a spinner over the hidden caption when loading.
fn cupertino_button(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, picture: widget.Node, has_icon: bool, action: *const widget.Submit, options: ButtonOptions) -> (widget.Node, err) {
    let state = control_state(t, key, options.enabled, false)
    var height = options.height
    if !(height > 0.0) {
        height = 34.0
        if options.variant == .Outlined { height = 22.0 }
    }
    var look = style.cupertino_resolve(t.tokens, options.variant, state, height)
    if options.width > 0.0 { look.min_width = options.width }
    let size = cup_button_size(height, options.variant)
    var ink = look.foreground
    if options.loading { ink.alpha = 0.0 }
    let (word, word_error) = cup_label(a, t, label, size, cup_button_weight(options.variant), ink)
    if word_error != ok { ret (zero, word_error) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    var count = 0usize
    if has_icon && !options.loading {
        parts[count] = picture
        count += 1usize
    }
    if label.len > 0usize {
        parts[count] = word
        count += 1usize
    }
    var row = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 6.0 }, style.defaults(), parts[0usize..count])
    var states = 0u32
    if options.loading {
        let (ring, ring_error) = cup_mark(a, 10u32, look.foreground, look.foreground, 1.8, progress_turn(t, 0.0 - 1.0, time.seconds(1i64)), 17.0, 17.0)
        if ring_error != ok { ret (zero, ring_error) }
        var caption = text_options()
        caption.role = .Label
        caption.wrap = .None
        caption.size = size
        caption.weight = cup_button_weight(options.variant)
        let (advance, fit, baseline, metrics_error) = run_metrics_faced(a, t, caption, label)
        if metrics_error != ok { ret (zero, metrics_error) }
        let (layers, layers_error) = mem.alloc[widget.Node](a, 2usize)
        if layers_error != ok { ret (zero, TooLarge) }
        layers[0usize] = row
        layers[1usize] = widget.aligned(0u64, .Center, .Center, sized_style(max_of(fit, 17.0), 20.0), widget_one_of(a, ring))
        row = widget.stack(0u64, style.defaults(), layers[0usize..2usize])
        states = accessibility.STATE_BUSY
    }
    var fill = style.defaults()
    fill.min_width = style.Length { Px: max_zero(look.min_width - look.padding * 2.0 - look.border_width * 2.0) }
    fill.min_height = style.Length { Px: max_zero(look.min_height - look.border_width * 2.0) }
    let content = widget.aligned(0u64, .Center, .Center, fill, widget_one_of(a, row))
    let (node, node_error) = pressable_states(a, key, t, 3u8, label, look, options.enabled, false, states, 0u32, 0u64, action, content)
    ret (node, node_error)
}
// ---- end the Cupertino look (block 1) ---------------------------------------------------------------

// ---- the Cupertino look, block 2: checkbox, radio, switch, segmented control, slider ------------------

fn cup_rrect_path(builder: *geometry.PathBuilder, x: f32, y: f32, w: f32, h: f32, radius: f32) -> err {
    var r = radius
    if r > w * 0.5 { r = w * 0.5 }
    if r > h * 0.5 { r = h * 0.5 }
    let k = r * 0.4477
    try geometry.move_to(builder, cup_pt(x + r, y))
    try geometry.line_to(builder, cup_pt(x + w - r, y))
    try geometry.cubic_to(builder, cup_pt(x + w - k, y), cup_pt(x + w, y + k), cup_pt(x + w, y + r))
    try geometry.line_to(builder, cup_pt(x + w, y + h - r))
    try geometry.cubic_to(builder, cup_pt(x + w, y + h - k), cup_pt(x + w - k, y + h), cup_pt(x + w - r, y + h))
    try geometry.line_to(builder, cup_pt(x + r, y + h))
    try geometry.cubic_to(builder, cup_pt(x + k, y + h), cup_pt(x, y + h - k), cup_pt(x, y + h - r))
    try geometry.line_to(builder, cup_pt(x, y + r))
    try geometry.cubic_to(builder, cup_pt(x, y + k), cup_pt(x + k, y), cup_pt(x + r, y))
    ret geometry.close_path(builder)
}

fn cup_rrect(m: *CupMark, b: *scene.Builder, x: f32, y: f32, w: f32, h: f32, radius: f32, color: paint.Color) -> err {
    let (pb, pb_error) = geometry.path_builder(m.arena, 12usize, 24usize)
    if pb_error != ok { ret TooLarge }
    var builder = pb
    try cup_rrect_path(&builder, x, y, w, h, radius)
    ret scene.push(b, scene.Command { FillPath: scene.FillPath { path: geometry.finish(&builder), brush: paint.Brush { Solid: color } } })
}

// A raised pill: the stacked-alpha drop shadow of iOS's switch thumb and segmented selection (no blur
// primitive: five widening low-alpha pills approximate `0 3 8 rgba(0,0,0,.15), 0 1 1 rgba(0,0,0,.16)`), then the fill.
fn cup_pill_paint(m: *CupMark, b: *scene.Builder, area: geometry.Rect) -> err {
    let r = m.a
    var shade = m.other
    let s = m.c
    shade.alpha = m.other.alpha * 0.035 * s
    try cup_rrect(m, b, area.x - 3.0, area.y - 1.0, area.width + 6.0, area.height + 6.0, r + 3.0, shade)
    shade.alpha = m.other.alpha * 0.04 * s
    try cup_rrect(m, b, area.x - 2.0, area.y, area.width + 4.0, area.height + 4.0, r + 2.0, shade)
    shade.alpha = m.other.alpha * 0.05 * s
    try cup_rrect(m, b, area.x - 1.0, area.y + 0.5, area.width + 2.0, area.height + 3.0, r + 1.0, shade)
    shade.alpha = m.other.alpha * 0.10 * s
    try cup_rrect(m, b, area.x - 0.4, area.y + 0.5, area.width + 0.8, area.height + 1.6, r + 0.4, shade)
    shade.alpha = m.other.alpha * 0.16 * s
    try cup_rrect(m, b, area.x, area.y + 0.4, area.width, area.height + 0.8, r, shade)
    ret cup_rrect(m, b, area.x, area.y, area.width, area.height, r, m.color)
}

fn cup_pill_node(a: *mem.Arena, color: paint.Color, shadow: paint.Color, radius: f32, strength: f32, width: f32, height: f32) -> (widget.Node, err) {
    let (marks, marks_error) = mem.alloc[CupMark](a, 1usize)
    if marks_error != ok { ret (zero, TooLarge) }
    marks[0usize] = CupMark { kind: 18u32, color: color, other: shadow, a: radius, b: 0.0, c: strength, arena: a }
    var none: []const widget.Node = zero
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&marks[0usize]), measure: cup_mark_measure, paint: cup_pill_dispatch, state: widget.bytes_of[CupMark](&marks[0usize]) } }, style: sized_style(width, height), children: none }, ok)
}

fn cup_pill_dispatch(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    ret cup_pill_paint(mem.cast[*CupMark](ctx), b, area)
}

fn cup_clear() -> paint.Color {
    ret paint.rgba(0.0, 0.0, 0.0, 0.0)
}

// A macOS check box or radio button (14 x 14, HIG): white face and 1 px edge unchecked, the accent filled with a
// white tick, dash or 6 px dot when chosen; the label 13 regular, 6 px after the box.
fn cupertino_choice(a: *mem.Arena, key: widget.Key, t: *const Theme, role: u8, label: str, chosen: bool, mixed: bool, round: bool, action: *const widget.Submit, enabled: bool) -> (widget.Node, err) {
    let state = control_state(t, key, enabled, false)
    let dark = t.tokens.palette == .Dark
    let accent = style.color(t.tokens, .Primary)
    let filled = chosen || mixed
    var face = style.hexa(0xFFFFFFu32, 1.0)
    var edge = style.hexa(0x000000u32, 0.30)
    if dark {
        face = style.hexa(0xFFFFFFu32, 0.10)
        edge = style.hexa(0xFFFFFFu32, 0.30)
    }
    if state.pressed && !filled {
        face = style.hex(0xE2E2E2u32)
        if dark { face = style.hexa(0xFFFFFFu32, 0.24) }
    }
    var edge_w: f32 = 1.0
    if filled {
        face = accent
        edge = cup_clear()
        edge_w = 0.0
        if state.pressed { face = style.mix(accent, style.hex(0x000000u32), 0.22) }
    }
    var mark_ink = style.hex(0xFFFFFFu32)
    var words = style.color(t.tokens, .Text)
    var veil: f32 = 1.0
    if !enabled {
        veil = 0.4
        words = style.cup_alpha(words, 0.3)
        if filled { face = style.cup_alpha(accent, 0.8) }
    }
    var box = sized_style(14.0, 14.0)
    box.background = paint.Brush { Solid: face }
    box.border = style.Border { width: edge_w, color: edge }
    box.radius = 3.5
    if round { box.radius = 7.0 }
    box.opacity = veil
    let (mark_parts, mark_error) = mem.alloc[widget.Node](a, 1usize)
    if mark_error != ok { ret (zero, TooLarge) }
    var drawn = 0usize
    if filled && round {
        var dot = sized_style(6.0, 6.0)
        dot.background = paint.Brush { Solid: mark_ink }
        dot.radius = 3.0
        mark_parts[0usize] = widget.box(0u64, dot, zero)
        drawn = 1usize
    }
    if filled && !round {
        var kind = 1u32
        if mixed && !chosen { kind = 2u32 }
        if mixed { kind = 2u32 }
        let (tick, tick_error) = cup_mark(a, kind, mark_ink, mark_ink, 1.9, 0.0, 10.0, 10.0)
        if tick_error != ok { ret (zero, tick_error) }
        mark_parts[0usize] = tick
        drawn = 1usize
    }
    var mark = widget.aligned(0u64, .Center, .Center, box, mark_parts[0usize..drawn])
    if round {
        // Painted circles: the box radius of the style path reads as a rounded square at 14.
        let (disc, disc_error) = cup_mark(a, 14u32, face, face, 0.0, 0.0, 14.0, 14.0)
        if disc_error != ok { ret (zero, disc_error) }
        let (rim, rim_error) = cup_mark(a, 15u32, edge, edge, edge_w, 0.0, 14.0, 14.0)
        if rim_error != ok { ret (zero, rim_error) }
        let (dot_mark, dot_error) = cup_mark(a, 14u32, mark_ink, mark_ink, 0.0, 0.0, 6.0, 6.0)
        if dot_error != ok { ret (zero, dot_error) }
        let (layers, layers_error) = mem.alloc[widget.Node](a, 3usize)
        if layers_error != ok { ret (zero, TooLarge) }
        layers[0usize] = disc
        var used = 1usize
        if !filled {
            layers[used] = rim
            used += 1usize
        }
        if filled {
            layers[used] = widget.positioned(0u64, 4.0, 4.0, style.defaults(), widget_one_of(a, dot_mark))
            used += 1usize
        }
        var ground = sized_style(14.0, 14.0)
        ground.opacity = veil
        mark = widget.stack(0u64, ground, layers[0usize..used])
    }
    let (word, word_error) = cup_label(a, t, label, 13.0, 400u32, words)
    if word_error != ok { ret (zero, word_error) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = mark
    parts[1usize] = word
    let row = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 6.0 }, style.defaults(), parts[0usize..2usize])
    var target_style = style.defaults()
    target_style.min_height = style.Length { Px: 20.0 }
    target_style.padding = style.EdgeLengths { left: style.Length { Px: 2.0 }, top: style.Length { Px: 0.0 }, right: style.Length { Px: 4.0 }, bottom: style.Length { Px: 0.0 } }
    let centred = widget.aligned(0u64, .Start, .Center, target_style, widget_one_of(a, row))
    var region_style = style.defaults()
    region_style.radius = 4.0
    let inner = widget.region(key, widget.Region { gesture: widget.GestureAction { ctx: mem.cast[*void](action), invoke: press_tap }, gestures: 1u8 | 4u8, enabled: enabled, focusable: enabled }, region_style, widget_one_of(a, centred))
    var sem: widget.Semantics = zero
    sem.role = role
    sem.label = label
    sem.actions = accessibility.ACTION_PRESS
    if chosen { sem.states = accessibility.STATE_CHECKED }
    if mixed { sem.states = sem.states | accessibility.STATE_MIXED }
    if !enabled { sem.states = sem.states | accessibility.STATE_DISABLED }
    ret (widget.semantics(0u64, sem, style.defaults(), widget_one_of(a, inner)), ok)
}

// The iOS switch (HIG 51 x 31): a green track when on, tertiary fill when off, a 27 white thumb with a soft
// shadow, 2 in; the thumb stretches by 6 under the finger. The label (17) leads, 12 before the track.
fn cupertino_switch(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, on: bool, action: *const widget.Submit, enabled: bool) -> (widget.Node, err) {
    let state = control_state(t, key, enabled, false)
    let dark = t.tokens.palette == .Dark
    var goal: f32 = 0.0
    if on { goal = 1.0 }
    let share = eased_on(t, key, key + 1048592u64, goal, false, 220u32)
    var off_fill = style.hexa(0x787880u32, 0.16)
    if dark { off_fill = style.hexa(0x787880u32, 0.32) }
    let on_fill = style.color(t.tokens, .Success)
    var track = sized_style(51.0, 31.0)
    track.radius = 15.5
    track.background = paint.Brush { Solid: style.mix(off_fill, on_fill, share) }
    var thumb_w: f32 = 27.0
    if state.pressed && enabled { thumb_w = 33.0 }
    let left = 2.0 + share * (51.0 - 4.0 - thumb_w)
    let (thumb, thumb_error) = cup_pill_node(a, style.hex(0xFFFFFFu32), style.hex(0x000000u32), 13.5, 1.0, thumb_w, 27.0)
    if thumb_error != ok { ret (zero, thumb_error) }
    let (layers, layers_error) = mem.alloc[widget.Node](a, 2usize)
    if layers_error != ok { ret (zero, TooLarge) }
    layers[0usize] = widget.box(0u64, track, zero)
    layers[1usize] = widget.positioned(0u64, left, 2.0, style.defaults(), widget_one_of(a, thumb))
    var mark_style = sized_style(51.0, 31.0)
    if !enabled { mark_style.opacity = 0.5 }
    let mark = widget.stack(0u64, mark_style, layers[0usize..2usize])
    var words = style.color(t.tokens, .Text)
    if !enabled { words = style.cup_alpha(words, 0.3) }
    let (word, word_error) = cup_label(a, t, label, 17.0, 400u32, words)
    if word_error != ok { ret (zero, word_error) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = word
    parts[1usize] = mark
    let row = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 12.0 }, style.defaults(), parts[0usize..2usize])
    var target_style = style.defaults()
    target_style.min_height = style.Length { Px: 44.0 }
    let centred = widget.aligned(0u64, .Start, .Center, target_style, widget_one_of(a, row))
    var region_style = style.defaults()
    region_style.radius = 8.0
    let inner = widget.region(key, widget.Region { gesture: widget.GestureAction { ctx: mem.cast[*void](action), invoke: press_tap }, gestures: 1u8 | 4u8, enabled: enabled, focusable: enabled }, region_style, widget_one_of(a, centred))
    var sem: widget.Semantics = zero
    sem.role = 18u8
    sem.label = label
    sem.actions = accessibility.ACTION_PRESS
    if on { sem.states = accessibility.STATE_CHECKED }
    if !enabled { sem.states = sem.states | accessibility.STATE_DISABLED }
    ret (widget.semantics(0u64, sem, style.defaults(), widget_one_of(a, inner)), ok)
}

// The iOS segmented control (HIG 32 tall): a tertiary-fill track, the selected segment a raised white (dark
// #636366) pill 2 in with a soft shadow, hairline dividers between segments that touch neither the pill nor
// the ends, labels 13 (semibold when selected). Segments are equal, as wide as the longest label plus 28.
// `height` and `font` size it (a tab strip: 24 and 13); `item_role` is the segments' tree role; `off` marks
// disabled segments by index.
fn cup_segments(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, labels: []const str, selected: usize, actions: []const widget.Submit, enabled: bool, height: f32, font: f32, item_role: u8, group_role: u8, off: []const bool) -> (widget.Node, err) {
    if actions.len != labels.len || labels.len == 0usize { ret (zero, TooLarge) }
    let dark = t.tokens.palette == .Dark
    var probe = text_options()
    probe.role = .Label
    probe.wrap = .None
    probe.size = font
    probe.weight = 600u32
    var widest: f32 = 0.0
    var n = 0usize
    while n < labels.len {
        let (advance, fit, baseline, metrics_error) = run_metrics_faced(a, t, probe, labels[n])
        if metrics_error != ok { ret (zero, metrics_error) }
        if fit > widest { widest = fit }
        n += 1usize
    }
    let seg = widest + 28.0
    let total = seg * f32(labels.len) + 4.0
    let inner_h = height - 4.0
    var track = sized_style(total, height)
    track.radius = height * 0.28
    track.background = paint.Brush { Solid: style.cup_fill(t.tokens, 1.0) }
    var raised = style.hex(0xFFFFFFu32)
    if dark { raised = style.hex(0x636366u32) }
    let rule_ink = style.hexa(0x3C3C43u32, 0.29)
    let rule_dark = style.hexa(0x98989Fu32, 0.5)
    let (layers, layers_error) = mem.alloc[widget.Node](a, labels.len * 2usize + 2usize)
    if layers_error != ok { ret (zero, TooLarge) }
    var used = 0usize
    layers[used] = widget.box(0u64, track, zero)
    used += 1usize
    let (pill, pill_error) = cup_pill_node(a, raised, style.hex(0x000000u32), inner_h * 0.25, 1.0, seg, inner_h)
    if pill_error != ok { ret (zero, pill_error) }
    layers[used] = widget.positioned(0u64, 2.0 + f32(selected) * seg, 2.0, style.defaults(), widget_one_of(a, pill))
    used += 1usize
    var i = 1usize
    while i < labels.len {
        if i != selected && i - 1usize != selected {
            var rule = sized_style(1.0, height * 0.44)
            rule.background = paint.Brush { Solid: rule_ink }
            if dark { rule.background = paint.Brush { Solid: rule_dark } }
            layers[used] = widget.positioned(0u64, 2.0 + f32(i) * seg - 0.5, height * 0.28, style.defaults(), widget_one_of(a, widget.box(0u64, rule, zero)))
            used += 1usize
        }
        i += 1usize
    }
    let (items, items_error) = mem.alloc[widget.Node](a, labels.len)
    if items_error != ok { ret (zero, TooLarge) }
    var k = 0usize
    while k < labels.len {
        let item_key = key + 1u64 + u64(k)
        let chosen = k == selected
        let live = enabled && !(k < off.len && off[k])
        let state = control_state(t, item_key, live, chosen)
        var look = style.resolve(t.tokens, .Plain, state)
        look.background = cup_clear()
        if state.pressed && !chosen { look.background = style.cup_fill(t.tokens, 1.2) }
        look.border_width = 0.0
        look.border = cup_clear()
        look.opacity = 1.0
        look.elevation = 0u8
        look.radius = inner_h * 0.25
        look.corners = style.Corners { top_left: 0.0, top_right: 0.0, bottom_right: 0.0, bottom_left: 0.0 }
        look.custom_padding = true
        look.padding = 0.0
        look.padding_y = 0.0
        look.padding_start = 0.0
        look.min_width = seg
        look.min_height = inner_h
        var words = style.color(t.tokens, .Text)
        if !live { words = style.cup_alpha(words, 0.3) }
        var weight = 400u32
        if chosen { weight = 600u32 }
        let (word, word_error) = cup_label(a, t, labels[k], font, weight, words)
        if word_error != ok { ret (zero, word_error) }
        let content = widget.aligned(0u64, .Center, .Center, sized_style(seg, inner_h), widget_one_of(a, word))
        let (item, item_error) = pressable(a, item_key, t, item_role, labels[k], look, live, chosen, &actions[k], content)
        if item_error != ok { ret (zero, item_error) }
        items[k] = item
        k += 1usize
    }
    layers[used] = widget.positioned(0u64, 2.0, 2.0, style.defaults(), widget_one_of(a, widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Start, gap: 0.0 }, style.defaults(), items[0usize..labels.len])))
    used += 1usize
    let frame = widget.stack(0u64, sized_style(total, height), layers[0usize..used])
    var sem: widget.Semantics = zero
    sem.role = group_role
    sem.label = label
    if group_role == 20u8 { sem.column_count = u32(labels.len) }
    ret (widget.semantics(key, sem, style.defaults(), widget_one_of(a, frame)), ok)
}

fn cupertino_segmented(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, labels: []const str, selected: usize, actions: []const widget.Submit, enabled: bool) -> (widget.Node, err) {
    let (made, made_error) = cup_segments(a, key, t, label, labels, selected, actions, enabled, 32.0, 13.0, 3u8, 2u8, zero)
    ret (made, made_error)
}

// The iOS slider: a 4 px track in the fill colour, the accent (minimum track) up to a 28 white thumb with a soft
// shadow. The runtime's slider element, drawn in no colour, sits over it for the pointer, keys and the tree; its
// geometry (the thumb centre 8 in, 8 out, from slider_at) is the one painted here.
fn cupertino_slider(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, value: f32, low: f32, high: f32, step: f32, change: widget.Change[f32], enabled: bool) -> (widget.Node, err) {
    let dark = t.tokens.palette == .Dark
    let width: f32 = 200.0
    var share: f32 = 0.0
    if high > low { share = (value - low) / (high - low) }
    if share < 0.0 { share = 0.0 }
    if share > 1.0 { share = 1.0 }
    let centre = 8.0 + share * (width - 16.0)
    var rest = style.hexa(0x787880u32, 0.16)
    if dark { rest = style.hexa(0x787880u32, 0.32) }
    let accent = style.color(t.tokens, .Primary)
    var track = sized_style(width - 16.0, 4.0)
    track.radius = 2.0
    track.background = paint.Brush { Solid: rest }
    var lit = sized_style(max_zero(centre - 8.0), 4.0)
    lit.radius = 2.0
    lit.background = paint.Brush { Solid: accent }
    let state = control_state(t, key, enabled, false)
    let (thumb, thumb_error) = cup_pill_node(a, style.hex(0xFFFFFFu32), style.hex(0x000000u32), 14.0, 1.0, 28.0, 28.0)
    if thumb_error != ok { ret (zero, thumb_error) }
    let clear = cup_clear()
    let hidden = widget.Slider { value: value, second: value, range: false, low: low, high: high, step: step, vertical: false, rtl: t.tokens.direction == .RightToLeft, track: clear, fill: clear, thumb: clear, change: change, change_second: zero, enabled: enabled, halo: clear, handle: 4.0, tick_on: clear, tick_off: clear }
    let (layers, layers_error) = mem.alloc[widget.Node](a, 4usize)
    if layers_error != ok { ret (zero, TooLarge) }
    layers[0usize] = widget.positioned(0u64, 14.0, 12.0, style.defaults(), widget_one_of(a, widget.box(0u64, track, zero)))
    layers[1usize] = widget.positioned(0u64, 14.0, 12.0, style.defaults(), widget_one_of(a, widget.box(0u64, lit, zero)))
    layers[2usize] = widget.positioned(0u64, 6.0 + centre - 14.0, 0.0, style.defaults(), widget_one_of(a, thumb))
    layers[3usize] = widget.positioned(0u64, 6.0, 0.0, style.defaults(), widget_one_of(a, widget.slider(key, hidden, sized_style(width, 28.0))))
    var frame_style = sized_style(width + 12.0, 28.0)
    if !enabled { frame_style.opacity = 0.4 }
    let frame = widget.stack(0u64, frame_style, layers[0usize..4usize])
    var sem: widget.Semantics = zero
    sem.role = 15u8
    sem.label = label
    let (said, said_error) = mem.alloc[u8](a, 21usize)
    if said_error != ok { ret (zero, TooLarge) }
    var rounded = value + 0.5
    if value < 0.0 { rounded = value - 0.5 }
    let said_len = write_i64(said, i64(rounded))
    sem.value = said[0usize..said_len]
    sem.actions = accessibility.ACTION_INCREMENT | accessibility.ACTION_DECREMENT | accessibility.ACTION_SET_VALUE
    if !enabled { sem.states = accessibility.STATE_DISABLED }
    // The frame is 6 wider each side than the slider element, so the thumb at either end is not clipped.
    ret (widget.semantics(0u64, sem, style.defaults(), widget_one_of(a, frame)), ok)
}
