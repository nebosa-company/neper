            n += 1usize
        }
        i += 1usize
    }
    var sem: widget.Semantics = zero
    sem.role = 20u8
    sem.column_count = u32(labels.len)
    ret (widget.semantics(key, sem, style.defaults(), mem_one_node(a, widget.stack(0u64, face, layers[0usize..n]))), ok)
