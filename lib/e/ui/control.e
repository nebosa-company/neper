// The panel of a macOS menu: a flat light (dark) face with a hairline edge, 10 round, 5 in on every side, a soft low
// shadow (one hard 2 px step: there is no blur primitive). `rim` is the room above and below the rows.
fn cupertino_menu_sheet_style(t: *const Theme, rim: f32) -> style.Style {
    var s = style.defaults()
    if t.tokens.palette == .Dark {
        s.background = paint.Brush { Solid: style.hex(0x2C2C2Eu32) }
        s.border = style.Border { width: 1.0, color: style.hexa(0xFFFFFFu32, 0.14) }
    }
    if t.tokens.palette != .Dark {
        s.background = paint.Brush { Solid: style.hex(0xF6F6F6u32) }
        s.border = style.Border { width: 1.0, color: style.hexa(0x000000u32, 0.13) }
    }
    s.radius = 10.0
    s.shadow = style.Shadow { offset: geometry.Point { x: 0.0, y: 1.0 }, color: paint.rgba(0.0, 0.0, 0.0, 0.10) }
    let side = style.Length { Px: 5.0 }
    s.padding = style.EdgeLengths { left: side, top: style.Length { Px: rim + 1.0 }, right: side, bottom: style.Length { Px: rim + 1.0 } }
    ret s
}

// A macOS menu row (22 tall, 13 pt): a 16 slot for the check or dot, the label, the shortcut and a submenu chevron in
// the secondary colour; hovered (or its submenu open) the row fills with the accent and everything on it goes white,
// 5 round; disabled is the label at 25 %. Returns the look and the row's content for `pressable_states`.
fn cupertino_menu_row_parts(a: *mem.Arena, t: *const Theme, key: widget.Key, label: str, shortcut: str, checked: bool, radio_mark: bool, enabled: bool, destructive: bool, has_submenu: bool, opened: bool, slotted: bool) -> (style.ResolvedControl, widget.Node, err) {
    var none: []const widget.Node = zero
    let (look, content, content_error) = cupertino_menu_row_icon(a, t, key, label, shortcut, checked, radio_mark, enabled, destructive, has_submenu, opened, slotted, none)
    ret (look, content, content_error)
}

// The same with a picture (at most one node) between the check slot and the label.
fn cupertino_menu_row_icon(a: *mem.Arena, t: *const Theme, key: widget.Key, label: str, shortcut: str, checked: bool, radio_mark: bool, enabled: bool, destructive: bool, has_submenu: bool, opened: bool, slotted: bool, pictures: []const widget.Node) -> (style.ResolvedControl, widget.Node, err) {
    var state = control_state(t, key, enabled, false)
    if opened { state.hovered = true }
    let hot = enabled && (state.hovered || state.pressed)
    var face = cup_clear()
    var ink = style.cup_alpha(style.color(t.tokens, .Text), 0.85)
    var muted = style.color(t.tokens, .TextMuted)
    if destructive { ink = style.color(t.tokens, .Error) }
    if !enabled {
        ink = style.cup_alpha(style.color(t.tokens, .Text), 0.25)
        muted = ink
    }
    if hot {
        face = style.color(t.tokens, .Primary)
        if state.pressed { face = style.mix(face, style.hex(0x000000u32), 0.15) }
        ink = style.hex(0xFFFFFFu32)
        muted = style.hexa(0xFFFFFFu32, 0.8)
    }
    var look = style.resolve(t.tokens, .Plain, state)
    look.background = face
    look.foreground = ink
    look.border_width = 0.0
    look.border = cup_clear()
    look.opacity = 1.0
    look.elevation = 0u8
    look.radius = 5.0
    look.corners = style.Corners { top_left: 0.0, top_right: 0.0, bottom_right: 0.0, bottom_left: 0.0 }
    look.custom_padding = true
    look.padding = 8.0
    look.padding_start = 4.0
    look.padding_y = 0.0
    look.min_height = 22.0
    look.min_width = 24.0
    let (parts, parts_error) = mem.alloc[widget.Node](a, 6usize)
    if parts_error != ok { ret (look, zero, TooLarge) }
    var n = 0usize
    if slotted {
        var slot_nodes: []const widget.Node = zero
        if checked && radio_mark {
            let (dot, dot_error) = cup_mark(a, 14u32, ink, ink, 0.0, 0.0, 5.0, 5.0)
            if dot_error != ok { ret (look, zero, dot_error) }
            slot_nodes = widget_one_of(a, dot)
        }
        if checked && !radio_mark {
            let (tick, tick_error) = cup_mark(a, 1u32, ink, ink, 1.8, 0.0, 11.0, 11.0)
            if tick_error != ok { ret (look, zero, tick_error) }
            slot_nodes = widget_one_of(a, tick)
        }
        parts[n] = widget.aligned(0u64, .Center, .Center, sized_style(16.0, 16.0), slot_nodes)
        n += 1usize
    }
    if pictures.len == 1usize {
        parts[n] = pictures[0usize]
        n += 1usize
    }
    let (word, word_error) = cup_label(a, t, label, 13.0, 400u32, ink)
    if word_error != ok { ret (look, zero, word_error) }
    parts[n] = word
    n += 1usize
    parts[n] = widget.spacer(0u64, 1.0)
    n += 1usize
    if shortcut.len > 0usize && !has_submenu {
        let (keys, keys_error) = cup_label(a, t, shortcut, 13.0, 400u32, muted)
        if keys_error != ok { ret (look, zero, keys_error) }
        parts[n] = widget.padded(0u64, 16.0, 0.0, 0.0, 0.0, style.defaults(), widget_one_of(a, keys))
        n += 1usize
    }
    if has_submenu {
        let (arrow, arrow_error) = cup_mark(a, 5u32, muted, muted, 1.6, 0.0, 9.0, 11.0)
        if arrow_error != ok { ret (look, zero, arrow_error) }
        parts[n] = arrow
        n += 1usize
    }
    var line_style = style.defaults()
    line_style.width = style.Length { Percent: 100.0 }
    let content = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 4.0 }, line_style, parts[0usize..n])
    ret (look, content, ok)
}
// ---- end the Cupertino look (block 5) ---------------------------------------------------------------

// The selected tab's frame: v3's near-black #2B2B2B; in the Windows dark look a #9D9D9D line (black on the dark strip would be invisible, white too harsh).
fn win_tab_edge() -> paint.Color {
    if style.windark_active() { ret style.hex_raw(0x9D9D9Du32) }
    ret style.hex(2829099u32)
}

// ---- looks9: the list box's focus rectangle on its chosen row ---------------------------------------------------
// The live Customization list draws the dotted focus rectangle 20 rows tall (the row plus the line under it) in greys that
// the chosen row's blue fill tints: top rows #7C7169 / #93979A, side dots #6D6966 / #929699, bottom rows #716E6C / #A69F99
// (measured on ref/windows/states/list-box-row-selected-focused-customization). Same two-row dot pattern as `win3_dots`.
fn win_list_dots_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let top_dark = style.hex(8155497u32)
    let top_light = style.hex(9672602u32)
    let side_dark = style.hex(7170406u32)
    let side_light = style.hex(9606809u32)
    let low_dark = style.hex(7433836u32)
    let low_light = style.hex(10919833u32)
    var x: f32 = 1.0
    while x < area.width - 1.0 {
        try win3_rect(b, area.x + x, area.y, 1.0, 1.0, top_dark)
        try win3_rect(b, area.x + x, area.y + 1.0, 1.0, 1.0, top_light)
        try win3_rect(b, area.x + x, area.y + area.height - 2.0, 1.0, 1.0, low_dark)
        try win3_rect(b, area.x + x, area.y + area.height - 1.0, 1.0, 1.0, low_light)
        x += 2.0
    }
    var y: f32 = 1.0
    while y < area.height - 1.0 {
        var edge = side_light
        if (u32(y) & 1u32) == 1u32 { edge = side_dark }
        try win3_rect(b, area.x, area.y + y, 1.0, 1.0, edge)
        try win3_rect(b, area.x + area.width - 1.0, area.y + y, 1.0, 1.0, edge)
        y += 1.0
    }
    ret ok
}

fn win_list_dots(a: *mem.Arena, w: f32, h: f32) -> (widget.Node, err) {
    let (cells, cells_error) = mem.alloc[Win3Dots](a, 1usize)
    if cells_error != ok { ret (zero, TooLarge) }
    cells[0usize] = Win3Dots { ink: style.hex(0u32) }
    var none: []const widget.Node = zero
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: win3_measure, paint: win_list_dots_paint, state: widget.bytes_of[Win3Dots](&cells[0usize]) } }, style: sized_style(w, h), children: none }, ok)
}
// ---- end looks9 -------------------------------------------------------------------------------------------------

// ---- looks9: the caret in its blink-off phase ------------------------------------------------------------------
// The live captures of a focused edit show no caret (it blinks); a looks sheet that compares with one calls this before
// it builds, and the Windows edits then draw the caret in the face colour. Default off.
var looks_caret_hidden: bool = false

fn set_caret_hidden(hidden: bool) { looks_caret_hidden = hidden }

// The Android look's caret: `primary`, 2 dp (md.comp.filled-text-field.caret); invisible while a sheet compares with a capture
// whose caret is in its blink-off phase.
fn material_caret(t: *const Theme) -> paint.Color {
    if t.tokens.profile != .MaterialLike { ret zero }
    let primary = style.color(t.tokens, .Primary)
    if looks_caret_hidden { ret paint.rgba(primary.red, primary.green, primary.blue, 0.001) }
    ret paint.rgba(primary.red, primary.green, primary.blue, 0.999)
}

// round 15: the native dark edit's own caret (a system overlay that blinks) in its off phase, for the next edits built.
var looks_native_caret_off: bool = false

fn set_native_caret_off(off: bool) { looks_native_caret_off = off }

fn native_caret_phase(face: paint.Color) -> paint.Color {
    if looks_native_caret_off { ret widget.native_caret_off(face) }
    ret widget.native_caret(face)
}
// ---- end looks9 --------------------------------------------------------------------------------------------------

// ---- looks9: the list-style combo's focus rectangle on its white face ------------------------------------------
// As `win3_dots`, but with the live grab's greys (ref/windows/states/combo-box-focused-options-row-color): the dots blur into
// their gaps, so the top and bottom rows alternate #838383 / #D8D8D8 (second row #B7B7B7 / #E8E8E8; at the foot #858585 /
// #D8D8D8 and #B5B5B5 / #E7E7E7) and the sides #838383 / #B6B6B6.
fn win_combo_dots_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let top_dot = style.hex(8618883u32)
    let top_gap = style.hex(14211288u32)
    let top2_dot = style.hex(12040119u32)
    let top2_gap = style.hex(15263976u32)
    let low_dot = style.hex(8750469u32)
    let low2_dot = style.hex(11908533u32)
    let low2_gap = style.hex(15198183u32)
    let side_dark = style.hex(8618883u32)
    let side_light = style.hex(11974326u32)
    var x: f32 = 1.0
    while x < area.width - 1.0 {
        var odd = (u32(x) & 1u32) == 1u32
        var c0 = top_gap
        var c1 = top2_gap
        var c2 = top_gap
        var c3 = low2_gap
        if odd {
            c0 = top_dot
            c1 = top2_dot
            c2 = low_dot
            c3 = low2_dot
        }
        try win3_rect(b, area.x + x, area.y, 1.0, 1.0, c0)
        try win3_rect(b, area.x + x, area.y + 1.0, 1.0, 1.0, c1)
        try win3_rect(b, area.x + x, area.y + area.height - 2.0, 1.0, 1.0, c2)
        try win3_rect(b, area.x + x, area.y + area.height - 1.0, 1.0, 1.0, c3)
        x += 1.0
    }
    var y: f32 = 1.0
    while y < area.height - 1.0 {
        var edge = side_light
        if (u32(y) & 1u32) == 1u32 { edge = side_dark }
        try win3_rect(b, area.x, area.y + y, 1.0, 1.0, edge)
        try win3_rect(b, area.x + area.width - 1.0, area.y + y, 1.0, 1.0, edge)
        y += 1.0
    }
    ret ok
}

// looks11: the focus dots of the two captured focused list-style combos, which the v3 grabs show as 1 px black dots on a pitch of 2
// shifted by a fraction of a pixel (so their greys are the dot's coverage of the pixels it straddles): `fy` down, and across `fx0`
// at the left edge to `fxr` at the right one. Measured: states/combo-box-focused-options-row-color (fy 0.37, fx 0.23 to 0.5, the
// pairs at the right edge equal) and the Conditional Formatting Show combo (fy 0.336, fx 0). Whole pixels are drawn in black
// at the dot's covered share (alpha), so dots that share a pixel at a corner compound.
type Win11Dots = struct { fy: f32, fx0: f32, fxr: f32 }

fn win11_dot(b: *scene.Builder, x: f32, y: f32) -> err {
    let ix = f32(u32(x))
    let iy = f32(u32(y))
    let fx = x - ix
    let fy = y - iy
    var k = 0usize
    while k < 4usize {
        var px = ix
        var py = iy
        var share = (1.0 - fx) * (1.0 - fy)
        if k == 1usize {
            px = ix + 1.0
            share = fx * (1.0 - fy)
        }
        if k == 2usize {
            py = iy + 1.0
            share = (1.0 - fx) * fy
        }
        if k == 3usize {
            px = ix + 1.0
            py = iy + 1.0
            share = fx * fy
        }
        if share > 0.004 {
            try win3_rect(b, px, py, 1.0, 1.0, with_alpha(style.hex(0u32), share))
        }
        k += 1usize
    }
    ret ok
}

fn win11_dots_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let d = mem.cast[*Win11Dots](ctx)
    let span = area.width - 1.0
    var x: f32 = 1.0
    while x < area.width - 1.0 {
        let fx = d.fx0 + (d.fxr - d.fx0) * x / span
        try win11_dot(b, area.x + x + fx, area.y + d.fy)
        try win11_dot(b, area.x + x + fx, area.y + area.height - 2.0 + d.fy)
        x += 2.0
    }
    var y: f32 = 1.0
    while y < area.height - 1.0 {
        try win11_dot(b, area.x + d.fx0, area.y + y + d.fy)
        try win11_dot(b, area.x + area.width - 1.0 + d.fxr, area.y + y + d.fy)
        y += 2.0
    }
    ret ok
}

fn win_combo_dots(a: *mem.Arena, w: f32, h: f32) -> (widget.Node, err) {
    let (cells, cells_error) = mem.alloc[Win3Dots](a, 1usize)
    if cells_error != ok { ret (zero, TooLarge) }
    cells[0usize] = Win3Dots { ink: style.hex(0u32) }
    var none: []const widget.Node = zero
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: win3_measure, paint: win_combo_dots_paint, state: widget.bytes_of[Win3Dots](&cells[0usize]) } }, style: sized_style(w, h), children: none }, ok)
}
// ---- end looks9 -------------------------------------------------------------------------------------------------

// ---- the Linux look (profile Linux, libadwaita 1.5) -------------------------------------------------
// The width GTK gives a label: Pango with hinted metrics (GTK's default) rounds every glyph advance to a whole pixel, so
// "Button" is 48 px where its unhinted advance is 46.3. The sum of the rounded one-letter advances stands for it (kerning is
// ignored); a caption with a non-ASCII letter takes its plain advance rounded.
fn linux_label_width(a: *mem.Arena, t: *const Theme, caption: TextOptions, label: str) -> (f32, err) {
    var ascii = true
    var i = 0usize
    while i < label.len {
        if label[i] >= 128u8 { ascii = false }
        i += 1usize
    }
    if !ascii {
        let (advance, fit, baseline, whole_error) = run_metrics_faced(a, t, caption, label)
        ret (f32(u32(fit + 0.5)), whole_error)
    }
    var sum: f32 = 0.0
    i = 0usize
    while i < label.len {
        let (advance, fit, baseline, letter_error) = run_metrics_faced(a, t, caption, label[i..i + 1usize])
        if letter_error != ok { ret (0.0, letter_error) }
        sum += f32(u32(advance + 0.5))
        i += 1usize
    }
    ret (sum, ok)
}

// A GTK button: a 34 high face (`style.adwaita_resolve`) holding an optional 16 px picture, 6 px from the caption;
// `circular` makes a picture-only button a 34 circle (the `circular` style class), otherwise 6 px corners.
fn linux_button(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, picture: widget.Node, has_icon: bool, action: *const widget.Submit, options: ButtonOptions) -> (widget.Node, err) {
    let (node, node_error) = linux_button_shaped(a, key, t, label, picture, has_icon, action, options, zero)
    ret (node, node_error)
}

// `linux_button` with its own corner radii (a button of a linked group keeps 6 px on the outer corners only); a zero `corners`
// is the plain button. A captioned `circular` button is libadwaita's `pill`: a capsule with 32 px sides.
fn linux_button_shaped(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, picture: widget.Node, has_icon: bool, action: *const widget.Submit, options: ButtonOptions, corners: style.Corners) -> (widget.Node, err) {
    var state = control_state(t, key, options.enabled, false)
    if options.focused && options.enabled { state.focus_visible = true }
    var look = style.adwaita_resolve(t.tokens, options.variant, state)
    let alone = label.len == 0usize
    if alone {
        look.padding = 9.0
        look.padding_y = look.padding
        look.min_width = 34.0
        if options.circular { look.radius = 17.0 }
    }
    // libadwaita: `button.text-button` has 17 px sides; a button with a picture (an AdwButtonContent) keeps the 10.
    if !alone && !has_icon { look.padding = 17.0 }
    if !alone && options.circular {
        look.padding = 32.0
        look.radius = 22.0
        look.padding_y = look.padding_y + 5.0
    }
    look.corners = corners
    if corners.top_left > 0.0 || corners.top_right > 0.0 || corners.bottom_right > 0.0 || corners.bottom_left > 0.0 { look.radius = 0.0 }
    if !alone { look.padding_y = look.padding_y - 1.0 }
    if options.width > 0.0 { look.min_width = options.width }
    if options.height > 0.0 { look.min_height = options.height }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    var count = 0usize
    var label_w: f32 = 0.0
    if has_icon {
        parts[count] = picture
        count += 1usize
    }
    if !alone {
        var caption = text_options()
        caption.role = .Label
        caption.wrap = .None
        let (word, word_error) = colored_text(a, 0u64, label, t, caption, look.foreground)
        if word_error != ok { ret (zero, word_error) }
        // GTK lays a label out in whole pixels (the box is the caption's width rounded) and sits the Cantarell line
        // 1 px above the middle (measured on the library's own buttons): a 21 high holder, the line 2 px off its foot.
        let (wide, wide_error) = linux_label_width(a, t, caption, label)
        if wide_error != ok { ret (zero, wide_error) }
        label_w = wide
        let held = widget.padded(0u64, 0.0, 0.0, 0.0, 2.0, style.defaults(), mem_one_node(a, word))
        parts[count] = widget.aligned(0u64, .Center, .Center, sized_style(wide, 21.0), mem_one_node(a, held))
        count += 1usize
    }
    let row = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Center, cross: .Center, gap: 6.0 }, style.defaults(), parts[0usize..count])
    var name = label
    if alone { name = "Button" }
    // A coloured button is its colour under a wash, and wears its focus ring outside (round 22, lb): see linux_coloured_button.
    let (coloured, base, wash) = style.adwaita_layers(t.tokens, options.variant, state)
    if coloured {
        let (made, made_error) = linux_coloured_button(a, key, t, name, look, base, wash, state, alone, has_icon, label_w, action, options, row)
        ret (made, made_error)
    }
    let (node, node_error) = pressable(a, key, t, 3u8, name, look, options.enabled, false, action, row)
    ret (node, node_error)
}
// The ring a coloured Linux button wears: 2 px wide, 1 px off the box (`outline-offset: 1px`), painted outside the node's area.
type LinuxOutset = struct { arena: *mem.Arena, color: paint.Color, radius: f32 }

fn linux_outset_measure(ctx: *void, limits: ui_layout.Constraints) -> geometry.Size {
    ret geometry.Size { width: 0.0, height: 0.0 }
}

// The ring node: absolute over a `width` x `height` box whose corners are `radius`, painted just outside it.
fn linux_outset_node(a: *mem.Arena, width: f32, height: f32, radius: f32, color: paint.Color) -> (widget.Node, err) {
    let (rings, rings_error) = mem.alloc[LinuxOutset](a, 1usize)
    if rings_error != ok { ret (zero, TooLarge) }
    rings[0usize] = LinuxOutset { arena: a, color: color, radius: radius }
    var fill = sized_style(width, height)
    fill.position = .Absolute
    var none: []const widget.Node = zero
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&rings[0usize]), measure: linux_outset_measure, paint: linux_outset_paint, state: widget.bytes_of[LinuxOutset](&rings[0usize]) } }, style: fill, children: none }, ok)
}

fn linux_outset_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let ring = mem.cast[*LinuxOutset](ctx)
    let grown = geometry.Rect { x: area.x - 3.0, y: area.y - 3.0, width: area.width + 6.0, height: area.height + 6.0 }
    let corner = ring.radius + 3.0
    ret widget.fill_ring(ring.arena, b, grown, style.Corners { top_left: corner, top_right: corner, bottom_right: corner, bottom_left: corner }, 2.0, ring.color)
}

// A suggested or destructive button as GTK composes it (round 22, lb): the accent or destructive colour as its own layer, the hover or
// pressed wash as the pressable's face over it (each layer antialiased alone at the corners), the label above, and the keyboard
// focus ring OUTSIDE the box (2 px wide, 1 px off: `outline-offset: 1px`), where a plain button's is inside. The whole is one layer
// group so a disabled button fades as one. The box size is worked out here (label, 6 px gap, picture, padding): the layers are
// absolute and need it.
fn linux_coloured_button(a: *mem.Arena, key: widget.Key, t: *const Theme, name: str, resolved: style.ResolvedControl, base: paint.Color, wash: paint.Color, state: style.ControlState, alone: bool, has_icon: bool, label_w: f32, action: *const widget.Submit, options: ButtonOptions, row: widget.Node) -> (widget.Node, err) {
    var look = resolved
    let fade = look.opacity
    look.opacity = 1.0
    look.background = wash
    var inner: f32 = label_w
    if has_icon { inner = inner + 16.0 }
    if has_icon && !alone { inner = inner + 6.0 }
    var width = inner + 2.0 * look.padding
    let floor_w = max_of(t.tokens.metrics.hit_target, look.min_width)
    if floor_w > width { width = floor_w }
    let height = max_of(t.tokens.metrics.control_height, look.min_height)
    let (pressed, pressed_error) = pressable(a, key, t, 3u8, name, look, options.enabled, false, action, row)
    if pressed_error != ok { ret (zero, pressed_error) }
    var base_style = sized_style(width, height)
    base_style.position = .Absolute
    base_style.background = paint.Brush { Solid: base }
    base_style.radius = look.radius
    base_style.corners = look.corners
    let ringed = state.focus_visible && options.enabled
    let (layers, layers_error) = mem.alloc[widget.Node](a, 3usize)
    if layers_error != ok { ret (zero, TooLarge) }
    layers[0usize] = widget.box(0u64, base_style, zero)
    layers[1usize] = pressed
    var count = 2usize
    if ringed {
        let (ring, ring_error) = linux_outset_node(a, width, height, look.radius, style.color(t.tokens, .FocusRing))
        if ring_error != ok { ret (zero, ring_error) }
        layers[2usize] = ring
        count = 3usize
    }
    var whole = sized_style(width, height)
    whole.opacity = fade
    ret (widget.stack(0u64, whole, layers[0usize..count]), ok)
}

// ---- the Linux look, toggle buttons (worker l3, round 20) ----------------------------------------------------------
// GtkToggleButton: a button whose checked state is the pressed wash (black 23.6 %, white 29.2 % Dark; the default Tonal face
// unchecked). The icon form is the flat 34 px button (9 px padding round a 16 px glyph).
fn linux_glyph_toggle(a: *mem.Arena, key: widget.Key, t: *const Theme, kind: GlyphKind, label: str, action: *const widget.Submit, side: f32, glyph_size: f32, selected: bool) -> (widget.Node, err) {
    let state = control_state(t, key, true, selected)
    var look = style.adwaita_resolve(t.tokens, .Plain, state)
    look.padding = (side - glyph_size) * 0.5
    look.padding_y = look.padding
    look.min_width = side
    look.min_height = side
    let (mark, mark_error) = icon_square(a, look.foreground, kind, glyph_size)
    if mark_error != ok { ret (zero, mark_error) }
    let (node, node_error) = pressable(a, key, t, 3u8, label, look, true, selected, action, mark)
    ret (node, node_error)
}

// The same with an Adwaita symbolic icon (e.ui.adwicon_l2) as the picture (round 22, lb).
fn linux_svg_toggle(a: *mem.Arena, key: widget.Key, t: *const Theme, svg: str, label: str, action: *const widget.Submit, side: f32, glyph_size: f32, selected: bool) -> (widget.Node, err) {
    let state = control_state(t, key, true, selected)
    var look = style.adwaita_resolve(t.tokens, .Plain, state)
    look.padding = (side - glyph_size) * 0.5
    look.padding_y = look.padding
    look.min_width = side
    look.min_height = side
    // a disabled button dims its icon again by half (the label is not: `button:disabled label` has no filter)
    var ink = look.foreground
    if state.disabled { ink = with_alpha(ink, ink.alpha * 0.5) }
    let (mark, mark_error) = adwicon.icon(a, svg, ink, glyph_size)
    if mark_error != ok { ret (zero, mark_error) }
    let (node, node_error) = pressable(a, key, t, 3u8, label, look, true, selected, action, mark)
    ret (node, node_error)
}

// A Linux button of any variant whose picture is an Adwaita symbolic icon, with an optional caption after it.
fn button_with_svg(a: *mem.Arena, key: widget.Key, t: *const Theme, svg: str, label: str, action: *const widget.Submit, options: ButtonOptions) -> (widget.Node, err) {
    let state = control_state(t, key, options.enabled, false)
    var ink = style.adwaita_resolve(t.tokens, options.variant, state).foreground
    if state.disabled { ink = with_alpha(ink, ink.alpha * 0.5) }
    let (mark, mark_error) = adwicon.icon(a, svg, ink, 16.0)
    if mark_error != ok { ret (zero, mark_error) }
    let (node, node_error) = linux_button(a, key, t, label, mark, true, action, options)
    ret (node, node_error)
}

fn linux_toggle_button(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, selected: bool, action: *const widget.Submit, options: ButtonOptions) -> (widget.Node, err) {
    var state = control_state(t, key, options.enabled, selected)
    if options.focused && options.enabled { state.focus_visible = true }
    var look = style.adwaita_resolve(t.tokens, .Tonal, state)
    look.padding = 17.0
    look.padding_y = look.padding_y - 1.0
    if options.width > 0.0 { look.min_width = options.width }
    if options.height > 0.0 { look.min_height = options.height }
    var caption = text_options()
    caption.role = .Label
    caption.wrap = .None
    let (word, word_error) = colored_text(a, 0u64, label, t, caption, look.foreground)
    if word_error != ok { ret (zero, word_error) }
    let (wide, wide_error) = linux_label_width(a, t, caption, label)
    if wide_error != ok { ret (zero, wide_error) }
    let held = widget.padded(0u64, 0.0, 0.0, 0.0, 2.0, style.defaults(), mem_one_node(a, word))
    let row = widget.aligned(0u64, .Center, .Center, sized_style(wide, 21.0), mem_one_node(a, held))
    let (node, node_error) = pressable(a, key, t, 3u8, label, look, options.enabled, selected, action, row)
    ret (node, node_error)
}
// ---- end the Linux look, toggle buttons -------------------------------------------------------------------------------
// ---- end the Linux look ---------------------------------------------------------------------------------

// ---- round 20, l2: the Linux look's edits (text, search, password; libadwaita 1.5 `entry`) ------------------------------
// An entry is 34 high with 6 px corners and a flat face: black 8 % over what it sits on (white 9.6 % Dark); error, warning and
// success tint it with their colour at 10 % and colour the text. A focused entry (any focus, not only the keyboard's) wears the
// 2 px accent ring at 50 % inside its edge, as the button does. Disabled is the whole entry at 50 %. The placeholder is the text
// colour at 55 %. FieldOptions.chrome_kind is read here as the tone of a Linux entry: 1 warning, 2 success (invalid is the error).
fn linux_tone(options: FieldOptions) -> u32 {
    if options.invalid { ret 3u32 }
    if options.chrome_kind == 1u32 || options.chrome_kind == 2u32 { ret options.chrome_kind }
    ret 0u32
}

fn linux_tone_color(t: *const Theme, tone: u32) -> paint.Color {
    if tone == 1u32 { ret style.color(t.tokens, .Warning) }
    if tone == 2u32 { ret style.color(t.tokens, .Success) }
    if tone == 3u32 { ret style.color(t.tokens, .Error) }
    ret style.color(t.tokens, .Text)
}

// The face of an entry, a spin button or a drop down: an alpha tint, so it takes what it sits on.
fn linux_entry_face(t: *const Theme, tone: u32) -> paint.Color {
    var strength: f32 = 0.08
    if t.tokens.palette == .Dark { strength = 0.096 }
    if tone != 0u32 {
        let c = linux_tone_color(t, tone)
        ret paint.Color { red: c.red, green: c.green, blue: c.blue, alpha: 0.1 }
    }
    if t.tokens.palette == .Dark { ret paint.rgba(1.0, 1.0, 1.0, strength) }
    ret paint.rgba(0.0, 0.0, 0.0, strength)
}

fn linux_ring_color(t: *const Theme, tone: u32) -> paint.Color {
    if tone == 0u32 { ret style.color(t.tokens, .FocusRing) }
    ret with_alpha(linux_tone_color(t, tone), 0.5)
}

// The editor of a Linux entry: the text in `ink` at body size, its selection the accent at 30 %.
fn linux_editor(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, buffer: []u8, len: usize, change: widget.Change[str], submit: widget.Submit, options: FieldOptions, secret: bool, ink: paint.Color, multiline: bool, rows: u32) -> (widget.Node, err) {
    var value_options = text_options()
    value_options.role = .Body
    value_options.mono = options.mono
    // an entry's text takes Pango's whole pixel advances; the text view's does not (its lines match as they are)
    var hinted = Theme { tokens: t.tokens, fonts: t.fonts, language: t.language, runtime: t.runtime }
    if !multiline { hinted.language = "pngo" }
    if !multiline && t.language.len == 4usize && t.language[0usize] == 116u8 && t.language[2usize] == 107u8 { hinted.language = "tnkn" }
    let (text_look, style_error) = text_style_faced(a, &hinted, value_options)
    if style_error != ok { ret (zero, style_error) }
    var editor_style = style.defaults()
    editor_style.width = style.Length { Percent: 100.0 }
    editor_style.min_height = style.Length { Px: f32(rows) * 19.0 }
    var caret: paint.Color = zero
    if looks_native_caret_off { caret = paint.rgba(0.0, 0.0, 0.0, 0.0001) }
    let selection = with_alpha(style.color(t.tokens, .Primary), 0.3)
    let (named, named_error) = named_editor(a, key, label, options.placeholder, options.invalid, editor_style, widget.edit(key, widget.Edit { buffer: buffer, len: len, style: text_look, color: ink, selection: selection, change: change, submit: submit, enabled: options.enabled, read_only: options.read_only, multiline: multiline, secret: secret, marked: zero, caret: caret, untabbed: false, ringed: false }, editor_style))
    ret (named, named_error)
}

// The value stack of a Linux entry: the placeholder (while empty) under the editor.
fn linux_value(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, buffer: []u8, len: usize, change: widget.Change[str], submit: widget.Submit, options: FieldOptions, secret: bool, ink: paint.Color, multiline: bool, rows: u32) -> (widget.Node, err) {
    let (layers, layers_error) = mem.alloc[widget.Node](a, 2usize)
    if layers_error != ok { ret (zero, TooLarge) }
    var at = 0usize
    if len == 0usize && options.placeholder.len != 0usize {
        var hint = text_options()
        hint.role = .Body
        hint.wrap = .None
        let (hint_node, hint_error) = colored_text(a, 0u64, options.placeholder, t, hint, with_alpha(ink, ink.alpha * 0.55))
        if hint_error != ok { ret (zero, hint_error) }
        layers[at] = hint_node
        at += 1usize
    }
    let (editor, editor_error) = linux_editor(a, key, t, label, buffer, len, change, submit, options, secret, ink, multiline, rows)
    if editor_error != ok { ret (zero, editor_error) }
    layers[at] = editor
    at += 1usize
    var grow = style.defaults()
    grow.width = style.Length { Flex: 1.0 }
    grow.overflow = .Clip
    // GTK sits the Cantarell line 1 px above the middle of the entry: a 2 px foot under the line.
    ret (widget.padded(0u64, 0.0, 0.0, 0.0, 1.0, grow, widget_one_of(a, widget.stack(0u64, style.defaults(), layers[0usize..at]))), ok)
}

// The frame of a Linux entry round `parts`: width, height, face, the ring while `ringed`, 50 % when disabled.
fn linux_frame(a: *mem.Arena, t: *const Theme, width: f32, height: f32, face: paint.Color, ring: paint.Color, ringed: bool, enabled: bool, left: f32, right: f32, parts: []const widget.Node) -> widget.Node {
    var none: []const widget.Node = zero
    ret linux_frame_over(a, t, width, height, face, ring, ringed, enabled, left, right, parts, none)
}

// The same with `over` laid above the face and below the ring (a spin button's arrows, as positioned nodes).
fn linux_frame_over(a: *mem.Arena, t: *const Theme, width: f32, height: f32, face: paint.Color, ring: paint.Color, ringed: bool, enabled: bool, left: f32, right: f32, parts: []const widget.Node, over: []const widget.Node) -> widget.Node {
    var frame = style.defaults()
    frame.width = style.Length { Px: width }
    frame.min_height = style.Length { Px: height }
    frame.background = paint.Brush { Solid: face }
    frame.radius = 6.0
    frame.padding = style.EdgeLengths { left: style.Length { Px: left }, top: style.Length { Px: 0.0 }, right: style.Length { Px: right }, bottom: style.Length { Px: 0.0 } }
    let boxed = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 6.0 }, frame, parts)
    // The focus ring is its own layer over the face (its own layer keeps the face unshifted); the layer
    // is always there, clear at rest, so the tree keeps its shape when the focus arrives.
    let (layers, layers_error) = mem.alloc[widget.Node](a, 2usize + over.len)
    if layers_error != ok { ret boxed }
    layers[0usize] = boxed
    var at = 1usize
    var k = 0usize
    while k < over.len {
        layers[at] = over[k]
        at += 1usize
        k += 1usize
    }
    layers[at] = linux_focus_layer(a, width, height, ring, ringed, 6.0, 6.0)
    at += 1usize
    var whole = sized_style(width, height)
    if !enabled { whole.opacity = 0.5 }
    ret widget.stack(0u64, whole, layers[0usize..at])
}

fn linux_field(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, buffer: []u8, len: usize, change: widget.Change[str], submit: widget.Submit, options: FieldOptions, secret: bool) -> (widget.Node, err) {
    let state = control_state(t, key, options.enabled, false)
    let focused = state.focused && options.enabled
    let tone = linux_tone(options)
    var h = options.height
    if !(h > 0.0) { h = 34.0 }
    let multiline = options.rows > 1u32
    if multiline {
        let (view, view_error) = linux_textview(a, key, t, label, buffer, len, change, options)
        ret (view, view_error)
    }
    let (value, value_error) = linux_value(a, key, t, label, buffer, len, change, submit, options, secret, linux_tone_color(t, tone), multiline, options.rows)
    if value_error != ok { ret (zero, value_error) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 1usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = value
    let boxed = linux_frame(a, t, options.width, h, linux_entry_face(t, tone), linux_ring_color(t, tone), focused, options.enabled, 9.0 + options.start_space, 9.0 + options.end_space, parts[0usize..1usize])
    var sem: widget.Semantics = zero
    sem.role = 2u8
    ret (widget.semantics(0u64, sem, style.defaults(), widget_one_of(a, boxed)), ok)
}
// An icon button inside an entry (the peek eye, the search clear): a 16 px symbolic icon at 70 % of the text colour.
fn linux_icon_hit(a: *mem.Arena, key: widget.Key, t: *const Theme, svg: str, ink: paint.Color, action: *const widget.Submit, name: str, enabled: bool) -> (widget.Node, err) {
    let (mark, mark_error) = adwicon.icon(a, svg, with_alpha(ink, ink.alpha * 0.7), 16.0)
    if mark_error != ok { ret (zero, mark_error) }
    let region = widget.region(key, widget.Region { gesture: widget.GestureAction { ctx: mem.cast[*void](action), invoke: press_tap }, gestures: 1u8 | 4u8, enabled: enabled, focusable: false }, style.defaults(), widget_one_of(a, mark))
    var sem: widget.Semantics = zero
    sem.role = 3u8
    sem.label = name
    sem.actions = accessibility.ACTION_PRESS
    ret (widget.semantics(0u64, sem, style.defaults(), widget_one_of(a, region)), ok)
}

// round 22, la: the flex solver shrinks every child when the row overflows, and an editor wants the whole row, so the icons beside a
// value shrank to 14 px. The value is given the room that is left instead.
fn linux_room(a: *mem.Arena, node: widget.Node, width: f32) -> widget.Node {
    var held = style.defaults()
    held.width = style.Length { Px: width }
    held.overflow = .Clip
    ret widget.box(0u64, held, widget_one_of(a, node))
}

// A password entry: the entry with the peek eye 9 px from its end (`view-reveal`, `view-conceal` while the text shows).
fn linux_password(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, buffer: []u8, len: usize, change: widget.Change[str], submit: widget.Submit, options: FieldOptions, revealed: bool, reveal: *const widget.Submit) -> (widget.Node, err) {
    let state = control_state(t, key, options.enabled, false)
    let focused = state.focused && options.enabled
    let tone = linux_tone(options)
    let ink = linux_tone_color(t, tone)
    let (value, value_error) = linux_value(a, key, t, label, buffer, len, change, submit, options, !revealed, ink, false, 1u32)
    if value_error != ok { ret (zero, value_error) }
    var svg = adwicon.view_reveal()
    if revealed { svg = adwicon.view_conceal() }
    let (eye, eye_error) = linux_icon_hit(a, key + 1u64, t, svg, ink, reveal, "Show password", options.enabled)
    if eye_error != ok { ret (zero, eye_error) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = linux_room(a, value, options.width - 18.0 - 6.0 - 16.0)
    parts[1usize] = eye
    var h = options.height
    if !(h > 0.0) { h = 34.0 }
    let boxed = linux_frame(a, t, options.width, h, linux_entry_face(t, tone), linux_ring_color(t, tone), focused, options.enabled, 9.0, 9.0, parts[0usize..2usize])
    var sem: widget.Semantics = zero
    sem.role = 2u8
    ret (widget.semantics(0u64, sem, style.defaults(), widget_one_of(a, boxed)), ok)
}

// A search entry (GtkSearchEntry): the magnifier 9 px from the start, the clear icon 9 px from the end while it holds text.
fn linux_search(a: *mem.Arena, key: widget.Key, t: *const Theme, buffer: []u8, len: usize, change: widget.Change[str], submit: widget.Submit, clear: *const widget.Submit, options: FieldOptions) -> (widget.Node, err) {
    let state = control_state(t, key, options.enabled, false)
    let focused = state.focused && options.enabled
    let ink = style.color(t.tokens, .Text)
    var shown = options
    if shown.placeholder.len == 0usize { shown.placeholder = "Search" }
    let (value, value_error) = linux_value(a, key, t, "", buffer, len, change, submit, shown, false, ink, false, 1u32)
    if value_error != ok { ret (zero, value_error) }
    let (lens, lens_error) = adwicon.icon(a, adwicon.edit_find(), with_alpha(ink, ink.alpha * 0.7), 16.0)
    if lens_error != ok { ret (zero, lens_error) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 3usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = lens
    var room = options.width - 18.0 - 6.0 - 16.0
    if len != 0usize { room -= 6.0 + 16.0 }
    parts[1usize] = linux_room(a, value, room)
    var count = 2usize
    if len != 0usize {
        let (cross, cross_error) = linux_icon_hit(a, key + 1u64, t, adwicon.edit_clear(), ink, clear, "Clear", options.enabled)
        if cross_error != ok { ret (zero, cross_error) }
        parts[2usize] = cross
        count = 3usize
    }
    var h = options.height
    if !(h > 0.0) { h = 34.0 }
    let boxed = linux_frame(a, t, options.width, h, linux_entry_face(t, 0u32), linux_ring_color(t, 0u32), focused, options.enabled, 9.0, 9.0, parts[0usize..count])
    var sem: widget.Semantics = zero
    sem.role = 2u8
    ret (widget.semantics(0u64, sem, style.defaults(), widget_one_of(a, boxed)), ok)
}

// A text view (GtkTextView in a framed scrolled window): square, the view colour in a 1 px frame, 8 px of margin round the
// text, no focus ring. The frame colours are the measured #ddd (Light) and #454545 (Dark).
fn linux_textview(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, buffer: []u8, len: usize, change: widget.Change[str], options: FieldOptions) -> (widget.Node, err) {
    var ink = style.color(t.tokens, .Text)
    var view = style.color(t.tokens, .Surface)
    // Disabled, the view and its text are at half strength and the frame keeps its colour.
    if !options.enabled {
        ink = with_alpha(ink, ink.alpha * 0.5)
        view = with_alpha(view, 0.5)
    }
    let (editor, editor_error) = linux_editor(a, key, t, label, buffer, len, change, zero, options, false, ink, true, options.rows)
    if editor_error != ok { ret (zero, editor_error) }
    var frame = style.defaults()
    frame.width = style.Length { Px: options.width }
    var h = options.height
    if !(h > 0.0) { h = f32(options.rows) * 19.0 + 18.0 }
    frame.min_height = style.Length { Px: h }
    frame.background = paint.Brush { Solid: view }
    var edge = style.hex(0xDDDDDDu32)
    if t.tokens.palette == .Dark { edge = style.hex(0x454545u32) }
    frame.border = style.Border { width: 1.0, color: edge }
    frame.overflow = .Clip
    frame.padding = style.EdgeLengths { left: style.Length { Px: 9.0 }, top: style.Length { Px: 9.0 }, right: style.Length { Px: 8.0 }, bottom: style.Length { Px: 8.0 } }
    ret (widget.box(0u64, frame, widget_one_of(a, editor)), ok)
}

// A spin button's arrow (libadwaita `spinbutton > button`): 33 x 34, a flat face that takes the button's flat tints (black 5.6 % hovered,
// 12.4 % pressed; white 6.8 / 15.1 % Dark), a 1 px divider on its left (black 7.8 %, white 9.6 % Dark, which the tint darkens too) and
// the 16 px symbolic icon in the text colour. An arrow that cannot step has the icon at 15 % and the divider at 27 %. `last` rounds
// the right corners with the spin button's. Not a Tab stop (GTK's arrows are not).
fn linux_spin_arrow(a: *mem.Arena, key: widget.Key, t: *const Theme, svg: str, label: str, action: *const widget.Submit, usable: bool, last: bool, tall: bool) -> (widget.Node, err) {
    let state = control_state(t, key, usable, false)
    let dark = t.tokens.palette == .Dark
    var tint = paint.rgba(0.0, 0.0, 0.0, 0.0)
    var rule = paint.rgba(0.0, 0.0, 0.0, 0.078)
    var over: f32 = 0.0
    if state.hovered && !state.pressed { over = 0.056 }
    if state.pressed { over = 0.124 }
    if dark {
        rule = paint.rgba(1.0, 1.0, 1.0, 0.096)
        if state.hovered && !state.pressed { over = 0.068 }
        if state.pressed { over = 0.151 }
    }
    if dark { tint = paint.rgba(1.0, 1.0, 1.0, over) } else { tint = paint.rgba(0.0, 0.0, 0.0, over) }
    let ink = style.color(t.tokens, .Text)
    var shown = ink
    if !usable {
        shown = with_alpha(ink, ink.alpha * 0.15)
        rule = with_alpha(rule, rule.alpha * 0.27)
    }
    let (mark, mark_error) = adwicon.icon(a, svg, shown, 16.0)
    if mark_error != ok { ret (zero, mark_error) }
    var line = style.defaults()
    line.width = style.Length { Px: 1.0 }
    line.height = style.Length { Px: 34.0 }
    line.background = paint.Brush { Solid: rule }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = widget.box(0u64, line, zero)
    parts[1usize] = widget.aligned(0u64, .Center, .Center, sized_style(32.0, 34.0), widget_one_of(a, mark))
    var face = sized_style(33.0, 34.0)
    face.background = paint.Brush { Solid: tint }
    if last { face.corners = style.Corners { top_left: 0.0, top_right: 6.0, bottom_right: 6.0, bottom_left: 0.0 } }
    var row = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 0.0 }, face, parts[0usize..2usize])
    if tall {
        // The `vertical` style class on a horizontal button (the capture "spin-vertical"): 34 x 35, no divider on the left, the up button
        // keeps a 1 px border on its top.
        var tall_face = sized_style(34.0, 35.0)
        tall_face.background = paint.Brush { Solid: tint }
        if last { tall_face.corners = style.Corners { top_left: 0.0, top_right: 6.0, bottom_right: 6.0, bottom_left: 0.0 } }
        let (layers, layers_error) = mem.alloc[widget.Node](a, 2usize)
        if layers_error != ok { ret (zero, TooLarge) }
        layers[0usize] = widget.aligned(0u64, .Center, .Center, sized_style(34.0, 35.0), widget_one_of(a, mark))
        layers[1usize] = linux_top_rule(a, 34.0, 35.0, rule)
        var count = 1usize
        if last { count = 2usize }
        row = widget.stack(0u64, tall_face, layers[0usize..count])
    }
    let region = widget.region(key, widget.Region { gesture: widget.GestureAction { ctx: mem.cast[*void](action), invoke: press_tap }, gestures: 1u8 | 4u8, enabled: usable, focusable: false }, style.defaults(), widget_one_of(a, row))
    var sem: widget.Semantics = zero
    sem.role = 3u8
    sem.label = label
    sem.actions = accessibility.ACTION_PRESS
    if !usable { sem.states = accessibility.STATE_DISABLED }
    ret (widget.semantics(0u64, sem, style.defaults(), widget_one_of(a, region)), ok)
}

// A spin button (GtkSpinButton): the entry's flat face holding the value and, 54 px in, the two arrows (`key + 2` up, `key + 1` down).
fn linux_spin(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, buffer: []u8, value: i64, low: i64, high: i64, step: i64, change: widget.Change[i64], typed: widget.Change[str], width: f32, enabled: bool, invalid: bool) -> (widget.Node, err) {
    let (made, made_error) = linux_spin_core(a, key, t, label, buffer, value, low, high, step, change, typed, width, enabled, invalid, false)
    ret (made, made_error)
}

// The spin button of the capture "spin-vertical": libadwaita's `vertical` class on a horizontal spin button (98 x 35, the value flush left).
fn spin_box_linux_tall(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, buffer: []u8, value: i64, low: i64, high: i64, step: i64, change: widget.Change[i64], typed: widget.Change[str], width: f32) -> (widget.Node, err) {
    let (made, made_error) = linux_spin_core(a, key, t, label, buffer, value, low, high, step, change, typed, width, true, false, true)
    ret (made, made_error)
}

fn linux_spin_core(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, buffer: []u8, value: i64, low: i64, high: i64, step: i64, change: widget.Change[i64], typed: widget.Change[str], width: f32, enabled: bool, invalid: bool, tall: bool) -> (widget.Node, err) {
    var arrows_w: f32 = 66.0
    var tall_h: f32 = 34.0
    var pad: f32 = 6.0
    if tall {
        arrows_w = 68.0
        tall_h = 35.0
        pad = 0.0
    }
    let (buttons, shortcuts, pair_error) = step_pair_enabled(a, t, key + 1u64, key + 2u64, value, low, high, step, change, enabled)
    if pair_error != ok { ret (zero, pair_error) }
    let len = write_i64(buffer, value)
    var options = field_options()
    options.width = width
    options.enabled = enabled
    options.invalid = invalid
    let state = control_state(t, key, enabled, false)
    let focused = state.focused && enabled
    let tone = linux_tone(options)
    // a GtkSpinButton sets its figures tabular
    let tabular = Theme { tokens: t.tokens, fonts: t.fonts, language: "tnkn", runtime: t.runtime }
    let (editor, editor_error) = linux_value(a, key, &tabular, label, buffer, len, typed, zero, options, false, linux_tone_color(t, tone), false, 1u32)
    if editor_error != ok { ret (zero, editor_error) }
    let (down, down_error) = linux_spin_arrow(a, key + 1u64, t, adwicon.value_decrease(), "Decrease", &shortcuts[0usize].action, enabled && value > low, false, tall)
    if down_error != ok { ret (zero, down_error) }
    let (up, up_error) = linux_spin_arrow(a, key + 2u64, t, adwicon.value_increase(), "Increase", &shortcuts[1usize].action, enabled && value < high, true, tall)
    if up_error != ok { ret (zero, up_error) }
    let (pair, pair_nodes_error) = mem.alloc[widget.Node](a, 2usize)
    if pair_nodes_error != ok { ret (zero, TooLarge) }
    pair[0usize] = down
    pair[1usize] = up
    let arrows = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 0.0 }, style.defaults(), pair[0usize..2usize])
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = editor
    let (over, over_error) = mem.alloc[widget.Node](a, 1usize)
    if over_error != ok { ret (zero, TooLarge) }
    over[0usize] = widget.positioned(0u64, width - arrows_w, 0.0, style.defaults(), widget_one_of(a, arrows))
    let boxed = linux_frame_over(a, t, width, tall_h, linux_entry_face(t, tone), linux_ring_color(t, tone), focused, enabled, pad, arrows_w, parts[0usize..1usize], over[0usize..1usize])
    var none: []widget.Node = zero
    let (made, made_error) = stepped(a, key + 3u64, t, label, value, boxed, none, shortcuts, accessibility.ROLE_SPIN_BUTTON)
    ret (made, made_error)
}

// ---- round 20, l2: the Linux look's combo boxes (GtkDropDown and GtkComboBoxText with an entry) ----------------------------
// A read-only combo box is libadwaita's drop down: the default button (black 8 % / 11.6 % / 23.6 %; the open list leaves it at rest) holding the bold value at 10 px and the `pan-down` arrow; with room to spare the arrow sits 17 px from the end (a natural-width
// drop down puts it 10 px in). An editable one is the entry with a 36 px arrow button on the end (a 1 px divider, the flat tints, right
// corners 6); a focused editor wears the ring round the entry part only.
fn linux_ring_layer(a: *mem.Arena, width: f32, height: f32, ring: paint.Color, ringed: bool, left_radius: f32, right_radius: f32) -> widget.Node {
    ret linux_focus_layer(a, width, height, ring, ringed, left_radius, right_radius)
}

fn linux_dropdown(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, buffer: []u8, len: usize, choices: []const str, active: usize, open: bool, picks: []const widget.Submit, activate: widget.Change[usize], toggle: *const widget.Submit, options: FieldOptions) -> (widget.Node, err) {
    // A drop down shows the chosen item.
    var shown = ""
    if active < choices.len { shown = choices[active] }
    var h: f32 = 34.0
    if options.height > 0.0 { h = options.height }
    let (made, made_error) = linux_dropdown_core(a, key, t, label, shown, zero, false, options.width, h, options.enabled, open, choices, active, picks, activate, toggle)
    ret (made, made_error)
}

// A drop down with an optional 16 px picture before the value (an image combo box); `width` 0 is its natural width.
fn linux_dropdown_core(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, shown: str, lead: widget.Node, has_lead: bool, width: f32, height: f32, enabled: bool, open: bool, choices: []const str, active: usize, picks: []const widget.Submit, activate: widget.Change[usize], toggle: *const widget.Submit) -> (widget.Node, err) {
    let (boxed, w, boxed_error) = linux_menu_button(a, key, t, label, shown, lead, has_lead, width, height, enabled, open, toggle, false)
    if boxed_error != ok { ret (zero, boxed_error) }
    var none: []const widget.Node = zero
    let (made, made_error) = suggesting_wide(a, key, t, label, boxed, none, key + 2u64, key + 3u64, choices, active, open, picks, activate, toggle, w)
    ret (made, made_error)
}

// `linux_label_width` with an advance of exactly a half pixel (a digit of the bold face is 8.5) rounded down, as Pango's hinted metrics do.
fn linux_label_width_half_down(a: *mem.Arena, t: *const Theme, caption: TextOptions, label: str) -> (f32, err) {
    var ascii = true
    var i = 0usize
    while i < label.len {
        if label[i] >= 128u8 { ascii = false }
        i += 1usize
    }
    if !ascii {
        let (advance, fit, baseline, whole_error) = run_metrics_faced(a, t, caption, label)
        ret (f32(u32(fit + 0.5)), whole_error)
    }
    var sum: f32 = 0.0
    i = 0usize
    while i < label.len {
        let (advance, fit, baseline, letter_error) = run_metrics_faced(a, t, caption, label[i..i + 1usize])
        if letter_error != ok { ret (0.0, letter_error) }
        sum += f32(u32(advance + 0.49))
        i += 1usize
    }
    ret (sum, ok)
}

// The face of a drop down or menu button (see linux_dropdown); answers the node and the width it came to.
fn linux_menu_button(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, shown: str, lead: widget.Node, has_lead: bool, width: f32, height: f32, enabled: bool, open: bool, toggle: *const widget.Submit, tight: bool) -> (widget.Node, f32, err) {
    let state = control_state(t, key, enabled, false)
    var look = style.adwaita_resolve(t.tokens, .Tonal, state)
    look.border_width = 0.0
    look.border = paint.rgba(0.0, 0.0, 0.0, 0.0)
    var caption = text_options()
    caption.role = .Label
    caption.wrap = .None
    let (word, word_error) = colored_text(a, 0u64, shown, t, caption, look.foreground)
    if word_error != ok { ret (zero, 0.0, word_error) }
    let (wide, wide_error) = linux_label_width_half_down(a, t, caption, shown)
    if wide_error != ok { ret (zero, 0.0, wide_error) }
    var picture_w: f32 = 0.0
    if has_lead { picture_w = 16.0 + 6.0 }
    // A GtkMenuButton (a date edit's) keeps its arrow 3 px from the label and 9 from the end.
    var gap: f32 = 6.0
    var rim: f32 = 10.0
    var start: f32 = 10.0
    if tight {
        // the label a pixel further left than a plain button's, the arrow where it was
        start = 9.0
        gap = 4.0
        rim = 9.0
    }
    let natural = start + picture_w + wide + gap + 16.0 + rim
    var w = width
    if !(w > 0.0) { w = natural }
    var end_pad: f32 = rim
    let label_w = max_zero(w - start - end_pad - picture_w - gap - 16.0)
    let held = widget.padded(0u64, 0.0, 0.0, 0.0, 2.0, style.defaults(), mem_one_node(a, word))
    let (arrow, arrow_error) = adwicon.icon(a, adwicon.pan_down(), look.foreground, 16.0)
    if arrow_error != ok { ret (zero, 0.0, arrow_error) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 3usize)
    if parts_error != ok { ret (zero, 0.0, TooLarge) }
    var clipped = style.defaults()
    clipped.width = style.Length { Px: label_w }
    clipped.height = style.Length { Px: 21.0 }
    clipped.overflow = .Clip
    var used = 0usize
    if has_lead {
        parts[used] = lead
        used += 1usize
    }
    parts[used] = widget.box(0u64, clipped, mem_one_node(a, held))
    used += 1usize
    parts[used] = arrow
    used += 1usize
    let row = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: gap }, style.defaults(), parts[0usize..used])
    look.custom_padding = true
    look.padding_start = start
    look.padding = end_pad
    look.padding_y = max_zero((height - 21.0) * 0.5)
    look.min_width = w
    look.min_height = height
    var states = 0u32
    if open { states = accessibility.STATE_EXPANDED }
    let (face_button, face_button_error) = pressable_states(a, key, t, 3u8, label, look, enabled, false, states, accessibility.ACTION_SHOW_MENU, key + 2u64, toggle, row)
    if face_button_error != ok { ret (zero, 0.0, face_button_error) }
    let (layers, layers_error) = mem.alloc[widget.Node](a, 2usize)
    if layers_error != ok { ret (zero, 0.0, TooLarge) }
    layers[0usize] = face_button
    layers[1usize] = linux_ring_layer(a, w, height, linux_ring_color(t, 0u32), state.focus_visible && enabled, 6.0, 6.0)
    ret (widget.stack(0u64, sized_style(w, height), layers[0usize..2usize]), w, ok)
}

fn linux_combo_entry(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, buffer: []u8, len: usize, typed: widget.Change[str], choices: []const str, active: usize, open: bool, picks: []const widget.Submit, activate: widget.Change[usize], toggle: *const widget.Submit, options: FieldOptions) -> (widget.Node, err) {
    let state = control_state(t, key, options.enabled, false)
    let focused = state.focused && options.enabled
    let ink = style.color(t.tokens, .Text)
    var edit_options = options
    edit_options.invalid = false
    let (value, value_error) = linux_value(a, key, t, label, buffer, len, typed, zero, edit_options, false, ink, false, 1u32)
    if value_error != ok { ret (zero, value_error) }
    let side = control_state(t, key + 1u64, options.enabled, open)
    let dark = t.tokens.palette == .Dark
    var tint = paint.rgba(0.0, 0.0, 0.0, 0.0)
    var rule = paint.rgba(0.0, 0.0, 0.0, 0.078)
    var over: f32 = 0.0
    if side.hovered && !side.pressed { over = 0.056 }
    if side.pressed || open { over = 0.124 }
    if dark {
        rule = paint.rgba(1.0, 1.0, 1.0, 0.096)
        if side.hovered && !side.pressed { over = 0.068 }
        if side.pressed || open { over = 0.151 }
        tint = paint.rgba(1.0, 1.0, 1.0, over)
    } else {
        tint = paint.rgba(0.0, 0.0, 0.0, over)
    }
    let (arrow, arrow_error) = adwicon.icon(a, adwicon.pan_down(), ink, 16.0)
    if arrow_error != ok { ret (zero, arrow_error) }
    var line = style.defaults()
    line.width = style.Length { Px: 1.0 }
    line.height = style.Length { Px: 34.0 }
    line.background = paint.Brush { Solid: rule }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = widget.box(0u64, line, zero)
    parts[1usize] = widget.positioned(0u64, 10.0, 9.0, style.defaults(), widget_one_of(a, arrow))
    var face = sized_style(36.0, 34.0)
    face.background = paint.Brush { Solid: tint }
    face.corners = style.Corners { top_left: 0.0, top_right: 6.0, bottom_right: 6.0, bottom_left: 0.0 }
    let side_box = widget.stack(0u64, face, parts[0usize..2usize])
    let region = widget.region(key + 1u64, widget.Region { gesture: widget.GestureAction { ctx: mem.cast[*void](toggle), invoke: press_tap }, gestures: 1u8 | 4u8, enabled: options.enabled, focusable: false }, style.defaults(), widget_one_of(a, side_box))
    var sem: widget.Semantics = zero
    sem.role = 3u8
    sem.label = "Choices"
    sem.actions = accessibility.ACTION_PRESS | accessibility.ACTION_SHOW_MENU
    if open { sem.states = accessibility.STATE_EXPANDED }
    sem.controls = key + 2u64
    let opener = widget.semantics(0u64, sem, style.defaults(), widget_one_of(a, region))
    let (layers, layers_error) = mem.alloc[widget.Node](a, 2usize)
    if layers_error != ok { ret (zero, TooLarge) }
    // the button (its divider) lies over the ring's end, as in GTK
    layers[1usize] = widget.positioned(0u64, options.width - 36.0, 0.0, style.defaults(), widget_one_of(a, opener))
    layers[0usize] = linux_ring_layer(a, options.width - 35.0, 34.0, linux_ring_color(t, 0u32), focused, 6.0, 0.0)
    let (parts_in, parts_in_error) = mem.alloc[widget.Node](a, 1usize)
    if parts_in_error != ok { ret (zero, TooLarge) }
    parts_in[0usize] = value
    let boxed = linux_frame_over(a, t, options.width, 34.0, linux_entry_face(t, 0u32), linux_ring_color(t, 0u32), false, options.enabled, 9.0, 45.0, parts_in[0usize..1usize], layers[0usize..2usize])
    var none: []const widget.Node = zero
    let (made, made_error) = suggesting_wide(a, key, t, label, boxed, none, key + 2u64, key + 3u64, choices, active, open, picks, activate, toggle, options.width)
    ret (made, made_error)
}
// A row of a Linux drop-down list (a GtkListView row in the popover): 35.5 high (a 19.5 line and 8 above and below), 12 px sides,
// the value in the regular weight, the `object-select` check 6 px after the chosen one's text, the flat button tints under the pointer.
fn linux_list_row(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, chosen: bool, action: *const widget.Submit) -> (widget.Node, err) {
    let state = control_state(t, key, true, false)
    let ink = style.color(t.tokens, .Text)
    var tint = paint.rgba(0.0, 0.0, 0.0, 0.0)
    if state.hovered || state.pressed {
        var over: f32 = 0.056
        if state.pressed { over = 0.124 }
        if t.tokens.palette == .Dark {
            over = 0.068
            if state.pressed { over = 0.151 }
            tint = paint.rgba(1.0, 1.0, 1.0, over)
        } else {
            tint = paint.rgba(0.0, 0.0, 0.0, over)
        }
    }
    var look = style.resolve(t.tokens, .Plain, state)
    look.foreground = ink
    look.background = tint
    look.border_width = 0.0
    look.radius = 6.0
    look.custom_padding = true
    look.padding_start = 12.0
    look.padding = 12.0
    look.padding_y = 8.0
    look.min_height = 35.5
    var caption = text_options()
    caption.role = .Body
    caption.wrap = .None
    let (word, word_error) = colored_text(a, 0u64, label, t, caption, ink)
    if word_error != ok { ret (zero, word_error) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[0usize] = widget.padded(0u64, 0.0, 0.0, 0.0, 1.0, style.defaults(), mem_one_node(a, word))
    var count = 1usize
    if chosen {
        let (tick, tick_error) = adwicon.icon(a, adwicon.object_select(), ink, 16.0)
        if tick_error != ok { ret (zero, tick_error) }
        parts[1usize] = tick
        count = 2usize
    }
    let row = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 6.0 }, style.defaults(), parts[0usize..count])
    let (node, node_error) = pressable_states_fill(a, key, t, 3u8, label, look, true, false, 0u32, accessibility.ACTION_PRESS, 0u64, action, true, row)
    ret (node, node_error)
}

// The popover that holds a Linux list (`popover > contents`): the popover colour, 12 px corners, 6 px of padding at the sides and 6.15
// above and below the rows, `menu_w` less 2 wide when the anchor's width is known.
fn linux_popover_style(t: *const Theme, menu_w: f32, rows: usize) -> style.Style {
    var sheet = style.defaults()
    sheet.background = paint.Brush { Solid: style.color(t.tokens, .SurfaceBright) }
    sheet.radius = 12.0
    sheet.padding = style.EdgeLengths { left: style.Length { Px: 6.0 }, top: style.Length { Px: 6.15 }, right: style.Length { Px: 6.0 }, bottom: style.Length { Px: 6.15 } }
    if menu_w > 0.0 { sheet.width = style.Length { Px: menu_w - 2.0 } }
    sheet.height = style.Length { Px: 12.3 + 35.5 * f32(rows) }
    ret sheet
}

// ---- round 22, la: the Linux focus ring ----------------------------------------------------------------------------------------
// GTK's ring is a 2 px band inside the widget whose outer corners measure 6 px and whose inner corners 4.1 px (round 24, fitted on the settled captures: the corner pixels now agree within 4 levels) (the generic border draws 5.7 / 3.7),
// so the band is filled here as an outer path with an inner path of opposite winding. `left` and `right` are the outer radii of
// the two ends (the inner ones are 1.85 less, a straight end stays straight).
type LinuxFocus = struct { arena: *mem.Arena, color: paint.Color, on: bool, left: f32, right: f32 }

fn linux_trace4(builder: *geometry.PathBuilder, r: geometry.Rect, tl: f32, tr: f32, br: f32, bl: f32, reversed: bool) -> err {
    let x0 = r.x
    let y0 = r.y
    let x1 = r.x + r.width
    let y1 = r.y + r.height
    if reversed {
        try geometry.move_to(builder, geometry.Point { x: x0 + tl, y: y0 })
        if tl > 0.0 { try widget.corner_curve(builder, geometry.Point { x: x0 + tl, y: y0 }, geometry.Point { x: x0, y: y0 }, geometry.Point { x: x0, y: y0 + tl }) }
        try geometry.line_to(builder, geometry.Point { x: x0, y: y1 - bl })
        if bl > 0.0 { try widget.corner_curve(builder, geometry.Point { x: x0, y: y1 - bl }, geometry.Point { x: x0, y: y1 }, geometry.Point { x: x0 + bl, y: y1 }) }
        try geometry.line_to(builder, geometry.Point { x: x1 - br, y: y1 })
        if br > 0.0 { try widget.corner_curve(builder, geometry.Point { x: x1 - br, y: y1 }, geometry.Point { x: x1, y: y1 }, geometry.Point { x: x1, y: y1 - br }) }
        try geometry.line_to(builder, geometry.Point { x: x1, y: y0 + tr })
        if tr > 0.0 { try widget.corner_curve(builder, geometry.Point { x: x1, y: y0 + tr }, geometry.Point { x: x1, y: y0 }, geometry.Point { x: x1 - tr, y: y0 }) }
        ret geometry.close_path(builder)
    }
    try geometry.move_to(builder, geometry.Point { x: x0 + tl, y: y0 })
    try geometry.line_to(builder, geometry.Point { x: x1 - tr, y: y0 })
    if tr > 0.0 { try widget.corner_curve(builder, geometry.Point { x: x1 - tr, y: y0 }, geometry.Point { x: x1, y: y0 }, geometry.Point { x: x1, y: y0 + tr }) }
    try geometry.line_to(builder, geometry.Point { x: x1, y: y1 - br })
    if br > 0.0 { try widget.corner_curve(builder, geometry.Point { x: x1, y: y1 - br }, geometry.Point { x: x1, y: y1 }, geometry.Point { x: x1 - br, y: y1 }) }
    try geometry.line_to(builder, geometry.Point { x: x0 + bl, y: y1 })
    if bl > 0.0 { try widget.corner_curve(builder, geometry.Point { x: x0 + bl, y: y1 }, geometry.Point { x: x0, y: y1 }, geometry.Point { x: x0, y: y1 - bl }) }
    try geometry.line_to(builder, geometry.Point { x: x0, y: y0 + tl })
    if tl > 0.0 { try widget.corner_curve(builder, geometry.Point { x: x0, y: y0 + tl }, geometry.Point { x: x0, y: y0 }, geometry.Point { x: x0 + tl, y: y0 }) }
    ret geometry.close_path(builder)
}

fn linux_focus_trace(builder: *geometry.PathBuilder, r: geometry.Rect, left: f32, right: f32, reversed: bool) -> err {
    ret linux_trace4(builder, r, left, right, right, left, reversed)
}

// A button's 1 px top border with a rounded top right corner (libadwaita's `spinbutton.vertical > button.up`): the button's shape less
// the same shape one pixel lower, so the band tapers to nothing down the corner.
type LinuxTopRule = struct { arena: *mem.Arena, color: paint.Color }

fn linux_top_rule_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let f = mem.cast[*LinuxTopRule](ctx)
    let (pb, pb_error) = geometry.path_builder(f.arena, 24usize, 80usize)
    if pb_error != ok { ret TooLarge }
    var builder = pb
    try linux_trace4(&builder, area, 0.0, 6.0, 0.0, 0.0, false)
    try linux_trace4(&builder, geometry.Rect { x: area.x, y: area.y + 1.0, width: area.width, height: area.height - 1.0 }, 0.0, 6.0, 0.0, 0.0, true)
    ret scene.push(b, scene.Command { FillPath: scene.FillPath { path: geometry.finish(&builder), brush: paint.Brush { Solid: f.color } } })
}

fn linux_top_rule(a: *mem.Arena, width: f32, height: f32, color: paint.Color) -> widget.Node {
    var none: []const widget.Node = zero
    let (held, held_error) = mem.alloc[LinuxTopRule](a, 1usize)
    if held_error != ok { ret widget.box(0u64, sized_style(width, height), none) }
    held[0usize] = LinuxTopRule { arena: a, color: color }
    ret widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&held[0usize]), measure: linux_focus_measure, paint: linux_top_rule_paint, state: widget.bytes_of[LinuxTopRule](&held[0usize]) } }, style: sized_style(width, height), children: none }
}

fn linux_focus_measure(ctx: *void, limits: ui_layout.Constraints) -> geometry.Size {
    ret geometry.Size { width: 0.0, height: 0.0 }
}

fn linux_focus_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let f = mem.cast[*LinuxFocus](ctx)
    if !f.on { ret ok }
    let (pb, pb_error) = geometry.path_builder(f.arena, 24usize, 80usize)
    if pb_error != ok { ret TooLarge }
    var builder = pb
    try linux_focus_trace(&builder, area, f.left, f.right, false)
    var inner_left = f.left - 1.9
    var inner_right = f.right - 1.9
    if inner_left < 0.0 { inner_left = 0.0 }
    if inner_right < 0.0 { inner_right = 0.0 }
    try linux_focus_trace(&builder, geometry.Rect { x: area.x + 2.0, y: area.y + 2.0, width: area.width - 4.0, height: area.height - 4.0 }, inner_left, inner_right, true)
    ret scene.push(b, scene.Command { FillPath: scene.FillPath { path: geometry.finish(&builder), brush: paint.Brush { Solid: f.color } } })
}

// The ring layer: always in the tree (the shape keeps when the focus arrives), painting nothing unless `on`.
fn linux_focus_layer(a: *mem.Arena, width: f32, height: f32, ring: paint.Color, on: bool, left: f32, right: f32) -> widget.Node {
