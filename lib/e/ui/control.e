// The section header of v3's option pages (a plain panel with a grey gradient): 24 tall,
// #808080 at the left running to #C0C0C0 at the right, the title bold white 8 in, `aside`
// (may be empty) in black at the right end. `width` 0 stretches to the parent.
type SectionBar = struct { stops: [2]paint.Stop }

// v3's TGradient (gradient.pas): GDI+ fills (0,0,w-1,h-1) from Gray to Silver and draws a 1 px Gray
// border over it. looks4: fitted to the live 100 % capture's border pixels (fill compositing included):
// the border rectangle sits 0.15 right and 0.34 below the control's pixel, 505.35 wide and 24.01 tall
// for the control's 505 x 24 (GDI+ resampling), and the gradient fills only the whole pixels inside it
// (a fill reaching the border's soft outer pixels would count twice), then the four border lines.
fn section_bar_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let s = mem.cast[*SectionBar](ctx)
    let x0 = area.x + 0.15
    let y0 = area.y + 0.34
    let w = area.width + 0.35
    let h = area.height + 0.01
    let brush = paint.Brush { Linear: paint.LinearGradient { start: geometry.Point { x: x0, y: y0 }, end: geometry.Point { x: x0 + w, y: y0 }, stops: s.stops[0usize..2usize] } }
    try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(area.x + 1.0, area.y + 1.0, area.width - 1.0, area.height - 1.0), brush: brush } })
    let edge = paint.Brush { Solid: s.stops[0usize].color }
    try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(x0, y0, w, 1.0), brush: edge } })
    try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(x0, y0 + h - 1.0, w, 1.0), brush: edge } })
    try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(x0, y0, 1.0, h), brush: edge } })
    ret scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(x0 + w - 1.0, y0, 1.0, h), brush: edge } })
}

// The header bar of v3's Options pages: a TGradient 505 x 24 (`width` 0 stretches), its title
// (Tahoma bold, white) at (4.8, 3.75) and `aside` (the page group, Tahoma, black, right aligned in a
// 153 wide label ending 26 short of the right edge) at (width - 179, 3). The 16 px page icon the
// control draws at its right is not drawn (an image list entry).
fn windows_section_header(a: *mem.Arena, key: widget.Key, t: *const Theme, title: str, aside: str, width: f32) -> (widget.Node, err) {
    let (bars, bars_error) = mem.alloc[SectionBar](a, 1usize)
    if bars_error != ok { ret (zero, TooLarge) }
    bars[0usize].stops[0usize] = paint.Stop { offset: 0.0, color: style.hex(8421504u32) }
    bars[0usize].stops[1usize] = paint.Stop { offset: 1.0, color: style.hex(12632256u32) }
    // Windows 11 dark: the TGradient runs #4A4A4A to #2B2B2B under a white title and a #C5C5C5 aside.
    var title_ink = style.hex(16777215u32)
    var aside_ink = style.hex(0u32)
    if t.tokens.palette == .Dark {
        bars[0usize].stops[0usize] = paint.Stop { offset: 0.0, color: style.hex_raw(0x4A4A4Au32) }
        bars[0usize].stops[1usize] = paint.Stop { offset: 1.0, color: style.hex_raw(0x2B2B2Bu32) }
        title_ink = style.hex_raw(0xFFFFFFu32)
        aside_ink = style.hex_raw(0xC5C5C5u32)
    }
    var fill = style.defaults()
    fill.width = style.Length { Percent: 100.0 }
    fill.height = style.Length { Percent: 100.0 }
    var none: []const widget.Node = zero
    let (nodes, nodes_error) = mem.alloc[widget.Node](a, 3usize)
    if nodes_error != ok { ret (zero, TooLarge) }
    nodes[0usize] = widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&bars[0usize]), measure: mark_measure, paint: section_bar_paint, state: widget.bytes_of[SectionBar](&bars[0usize]) } }, style: fill, children: none }
    let (dialog_t, dialog_error) = windows_dialog_theme(a, t)
    if dialog_error != ok { ret (zero, dialog_error) }
    // Tahoma Bold (font id 10) leads the bold title's chain.
    var bold_t = dialog_t
    let (ordered, ordered_error) = mem.alloc[shape.Font](a, dialog_t.fonts.len)
    if ordered_error != ok { ret (zero, TooLarge) }
    var put = 1usize
    var n = 0usize
    while n < dialog_t.fonts.len {
        if dialog_t.fonts[n].id == 10u32 {
            ordered[0usize] = dialog_t.fonts[n]
        } else {
            ordered[put] = dialog_t.fonts[n]
            put += 1usize
        }
        n += 1usize
    }
    if put == dialog_t.fonts.len { bold_t.fonts = ordered }
    var heading = text_options()
    heading.wrap = .None
    heading.weight = 700u32
    let (head_shaped, head_error) = colored_text(a, 0u64, title, &bold_t, heading, title_ink)
    if head_error != ok { ret (zero, head_error) }
    var head_node = head_shaped
    // round 13: v3's GDI sets the bold caption on whole pixel hdmx advances (the shaped run was 1 to 2 px short: Interface (F2) ends at
    // 95, not 93 of the capture)
    if t.tokens.profile == .Windows && t.tokens.palette != .Dark {
        var hinted_options = heading
        hinted_options.face = 8u32
        hinted_options.size = 11.0
        let (hinted_row, hinted_w, hinted_before, hinted_mark, hinted_ok, hinted_error) = windows_hinted_row(a, &dialog_t, hinted_options, title, title.len, title_ink, false)
        if hinted_error != ok { ret (zero, hinted_error) }
        if hinted_ok { head_node = hinted_row }
    }
    var side = text_options()
    side.wrap = .None
    let (side_node, side_error) = colored_text(a, 0u64, aside, &dialog_t, side, aside_ink)
    if side_error != ok { ret (zero, side_error) }
    var span = width
    if !(span > 0.0) { span = 505.0 }
    // Both labels are 17 tall, their text vertically centred.
    var tall = style.defaults()
    tall.height = style.Length { Px: 17.0 }
    nodes[1usize] = widget.positioned(0u64, 4.8, 2.75, style.defaults(), widget_one_of(a, widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 0.0 }, tall, widget_one_of(a, head_node))))
    nodes[2usize] = widget.positioned(0u64, span - 181.5, 3.0, style.defaults(), widget_one_of(a, widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .End, cross: .Center, gap: 0.0 }, sized_style(153.0, 17.0), widget_one_of(a, side_node))))
    var holder = sized_style(span, 24.0)
    ret (widget.stack(key, holder, nodes[0usize..3usize]), ok)
}

// ---- looks: Windows (v3) page control tabs, appended block ----
// v3's TcxPageControl is lfUltraFlat with HotTrack (statistics.vcl.form.dfm; measured on
// 09b-statistics-probability-v3.png at 150 %): a white strip 22 tall, tabs 21 with 8 sides and no
// chrome, a 1 px #2B2B2B line under the strip, #B0B0B0 hairlines between tabs; the selected tab
// is a #2B2B2B frame open at the bottom on the dialog face; the hot tab's label is blue.

fn v3_tab_line() -> style.Style {
    var s = style.defaults()
    s.height = style.Length { Px: 1.0 }
    s.background = paint.Brush { Solid: win_tab_edge() }
    ret s
}

// One tab and the hairline that follows it (`with_sep`; else a 1 px gap carrying only the
// strip's bottom line). Both are 22 tall.
fn windows_tab(a: *mem.Arena, t: *const Theme, tab_key: widget.Key, label: str, chosen: bool, enabled: bool, raw_state: style.ControlState, action: *const widget.Submit, with_sep: bool, bottom: bool, first: bool, has_icon: bool, picture_kind: GlyphKind) -> (widget.Node, widget.Node, err) {
    // looks5 group d: a tab under the pointer is as at rest (ref/windows/states/hover-tab-left-*).
    var state = raw_state
    state.hovered = false
    var ink = style.color(t.tokens, .Text)
    if state.hovered && enabled { ink = style.hex(26316u32) }
    if !enabled { ink = style.mix(ink, style.color(t.tokens, .Surface), 0.6) }
    var caption = text_options()
    caption.wrap = .None
    var label_ink_node: widget.Node = zero
    if label.len != 0usize || !has_icon {
        // looks9: v3 underlines the mnemonic ('&Rarity'): the caption without its '&', a 1 px line under that letter at the baseline
        let (plain_label, mark_at, mark_error) = winbutton.mnemonic(a, label)
        if mark_error != ok { ret (zero, zero, mark_error) }
        let (said, said_error) = colored_text(a, 0u64, plain_label, t, caption, ink)
        if said_error != ok { ret (zero, zero, said_error) }
        label_ink_node = said
        if mark_at < plain_label.len {
            let (before, before_fit, before_base, before_error) = run_metrics_faced(a, t, caption, plain_label[0usize..mark_at])
            if before_error != ok { ret (zero, zero, before_error) }
            let (mark_adv, mark_fit, mark_base, mark_error_two) = run_metrics_faced(a, t, caption, plain_label[mark_at..mark_at + 1usize])
            if mark_error_two != ok { ret (zero, zero, mark_error_two) }
            let (whole, whole_fit, whole_base, whole_error) = run_metrics_faced(a, t, caption, plain_label)
            if whole_error != ok { ret (zero, zero, whole_error) }
            var line = sized_style(mark_adv, 1.0)
            line.background = paint.Brush { Solid: ink }
            let (pair, pair_error) = mem.alloc[widget.Node](a, 2usize)
            if pair_error != ok { ret (zero, zero, TooLarge) }
            pair[0usize] = said
            pair[1usize] = widget.positioned(0u64, before, whole_base + 1.0, style.defaults(), mem_one_node(a, widget.box(0u64, line, zero)))
            label_ink_node = widget.stack(0u64, style.defaults(), pair[0usize..2usize])
        }
    }
    if has_icon {
        // A tab picture (v3's image list), 16 square before the caption (3 apart).
        let (picture, picture_error) = icon_square(a, ink, picture_kind, 16.0)
        if picture_error != ok { ret (zero, zero, picture_error) }
        if label.len == 0usize {
            label_ink_node = picture
        } else {
            let (pair, pair_error) = mem.alloc[widget.Node](a, 2usize)
            if pair_error != ok { ret (zero, zero, TooLarge) }
            pair[0usize] = picture
            pair[1usize] = label_ink_node
            label_ink_node = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 3.0 }, style.defaults(), pair[0usize..2usize])
        }
    }
    var look = style.resolve(t.tokens, .Plain, state)
    look.background = paint.rgba(0.0, 0.0, 0.0, 0.0)
    if chosen { look.background = style.color(t.tokens, .Background) }
    look.foreground = ink
    look.border_width = 0.0
    look.radius = 0.0
    look.opacity = 1.0
    look.custom_padding = true
    look.padding = 8.0
    look.padding_y = 3.0
    if chosen { look.padding_y = 2.0 }
    look.min_height = 21.0
    // A tab at the bottom (tpBottom, measured at 100 % in the v3 main window): the strip's two rule
    // rows lie above it; a chosen tab's face runs up into the page, framed left and right and closed
    // by two rows below.
    if bottom && chosen { look.min_height = 20.0 }
    if has_icon && label.len == 0usize { look.padding_y = 2.0 }
    if has_icon && label.len == 0usize && !chosen { look.padding_y = 2.5 }
    let (press, press_error) = pressable_states(a, tab_key, t, 19u8, label, look, enabled, chosen, 0u32, 0u32, 0u64, action, label_ink_node)
    if press_error != ok { ret (zero, zero, press_error) }
    let (held, held_error) = mem.alloc[widget.Node](a, 4usize)
    if held_error != ok { ret (zero, zero, TooLarge) }
    held[0usize] = press
    var tab = press
    if bottom && chosen {
        // looks15: the frame columns run one row lower than the face (the strip's first rule row crosses their top), through
        // the third row; the left one is #010101, the right one #060606.
        held[1usize] = press
        held[2usize] = v3_tab_rule(10329501u32)
        held[3usize] = v3_tab_rule(5789784u32)
        let middle = widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, style.defaults(), held[1usize..4usize])
        let (cols, cols_error) = mem.alloc[widget.Node](a, 3usize)
        if cols_error != ok { ret (zero, zero, TooLarge) }
        var left_rgb = 65793u32
        var right_rgb = 394758u32
        if !first {
            left_rgb = 394758u32
            right_rgb = 657930u32
        }
        let (left_edge, left_error) = v3_tab_edge(a, left_rgb)
        if left_error != ok { ret (zero, zero, left_error) }
        let (right_edge, right_error) = v3_tab_edge(a, right_rgb)
        if right_error != ok { ret (zero, zero, right_error) }
        cols[0usize] = left_edge
        cols[1usize] = middle
        cols[2usize] = right_edge
        tab = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Stretch, gap: 0.0 }, style.defaults(), cols[0usize..3usize])
    } else if bottom {
        held[1usize] = v3_tab_rule(10132122u32)
        held[2usize] = v3_tab_rule(5987163u32)
        held[3usize] = press
        tab = widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, style.defaults(), held[1usize..4usize])
    } else if chosen {
        var frame = style.defaults()
        frame.background = paint.Brush { Solid: win_tab_edge() }
        frame.padding = style.EdgeLengths { left: style.Length { Px: 1.0 }, top: style.Length { Px: 1.0 }, right: style.Length { Px: 1.0 }, bottom: style.Length { Px: 0.0 } }
        tab = widget.box(0u64, frame, held[0usize..1usize])
    } else {
        held[1usize] = widget.box(0u64, v3_tab_line(), zero)
        tab = widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, style.defaults(), held[0usize..2usize])
    }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 3usize)
    if parts_error != ok { ret (zero, zero, TooLarge) }
    var mark = style.defaults()
    mark.width = style.Length { Px: 1.0 }
    mark.height = style.Length { Px: 14.0 }
    mark.margin = style.EdgeLengths { left: style.Length { Px: 0.0 }, top: style.Length { Px: 3.0 }, right: style.Length { Px: 0.0 }, bottom: style.Length { Px: 4.0 } }
    if with_sep { mark.background = paint.Brush { Solid: style.hex(11579568u32) } }
    if bottom && chosen {
        // looks15: right of a chosen bottom tab the strip has a pale #F9F9F9 column (20 rows) instead of the hairline.
        mark.height = style.Length { Px: 20.0 }
        mark.margin = style.EdgeLengths { left: style.Length { Px: 0.0 }, top: style.Length { Px: 0.0 }, right: style.Length { Px: 0.0 }, bottom: style.Length { Px: 0.0 } }
        mark.background = paint.Brush { Solid: style.hex(16382457u32) }
        if !first { mark.background = paint.Brush { Solid: style.hex(16053492u32) } }
    }
    var column = style.defaults()
    column.width = style.Length { Px: 1.0 }
    if bottom {
        // The hairline of a bottom strip: the strip's two rule rows, then the hairline.
        parts[0usize] = v3_tab_rule(10132122u32)
        parts[1usize] = v3_tab_rule(5987163u32)
        parts[2usize] = widget.box(0u64, mark, zero)
        let bottom_sep = widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, column, parts[0usize..3usize])
        ret (tab, bottom_sep, ok)
    }
    parts[0usize] = widget.box(0u64, mark, zero)
    parts[1usize] = widget.box(0u64, v3_tab_line(), zero)
    let sep = widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, column, parts[0usize..2usize])
    ret (tab, sep, ok)
}

// A 1 px tall rule of colour `rgb` (a bottom strip's rule rows, two grays as the capture shows them).
// looks15: a 1 px column of a chosen bottom tab's frame: the strip's first rule row, 20 rows of `rgb`, the strip's second rule row.
fn v3_tab_edge(a: *mem.Arena, rgb: u32) -> (widget.Node, err) {
    let (rows, rows_error) = mem.alloc[widget.Node](a, 3usize)
    if rows_error != ok { ret (zero, rows_error) }
    var dark = style.defaults()
    dark.height = style.Length { Px: 20.0 }
    dark.background = paint.Brush { Solid: style.hex(rgb) }
    rows[0usize] = v3_tab_rule(10132122u32)
    rows[1usize] = widget.box(0u64, dark, zero)
    rows[2usize] = v3_tab_rule(5789784u32)
    var column = style.defaults()
    column.width = style.Length { Px: 1.0 }
    ret (widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, column, rows[0usize..3usize]), ok)
}

fn v3_tab_rule(rgb: u32) -> widget.Node {
    var s = style.defaults()
    s.height = style.Length { Px: 1.0 }
    s.background = paint.Brush { Solid: style.hex(rgb) }
    ret widget.box(0u64, s, zero)
}

// The `width` wide start of a bottom strip: its two rule rows.
fn windows_tab_lead(a: *mem.Arena, width: f32) -> widget.Node {
    let (rows, rows_error) = mem.alloc[widget.Node](a, 2usize)
    if rows_error != ok { ret widget.spacer(0u64, width) }
    rows[0usize] = v3_tab_rule(10132122u32)
    rows[1usize] = v3_tab_rule(5987163u32)
    var lead = style.defaults()
    lead.width = style.Length { Px: width }
    ret widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, lead, rows[0usize..2usize])
}

// The strip's bottom line to the right of the last tab.
fn windows_tab_filler(a: *mem.Arena, t: *const Theme, bottom: bool) -> widget.Node {
    var none: []const widget.Node = zero
    if bottom {
        let (rows, rows_error) = mem.alloc[widget.Node](a, 2usize)
        if rows_error != ok { ret widget.spacer(0u64, 1.0) }
        rows[0usize] = v3_tab_rule(10132122u32)
        rows[1usize] = v3_tab_rule(5987163u32)
        var down = style.defaults()
        down.width = style.Length { Flex: 1.0 }
        down.height = style.Length { Px: 23.0 }
        ret widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, down, rows[0usize..2usize])
    }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret widget.spacer(0u64, 1.0) }
    parts[0usize] = widget.spacer(0u64, 1.0)
    parts[1usize] = widget.box(0u64, v3_tab_line(), none)
    var column = style.defaults()
    column.width = style.Length { Flex: 1.0 }
    column.height = style.Length { Px: 22.0 }
    ret widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, column, parts[0usize..2usize])
}

// ---- looks: Windows (v3) scroll bar, appended block ----
// v3's grid scroll bar (docs/grid-parity SB1/SB2, `gridlook.v3()`): a 16 wide #F0F0F0 track
// whose arrow slots (16 at each end) are empty at rest, and a slim #858585 thumb, 2.7 wide,
// thickening to 6 under the pointer. Hover thickness, the pressed colour and the hover arrows
// are guesses. `collection.e` still draws the grid's own bar by hand; this is the same bar as
// a control, `scroll_area` below.

type ScrollArrows = struct { vertical: bool, ink: paint.Color }

fn scroll_arrows_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let s = mem.cast[*ScrollArrows](ctx)
    if s.vertical {
        try v3_chevron(b, area.x + area.width * 0.5, area.y + 8.0, 0u8, s.ink)
        ret v3_chevron(b, area.x + area.width * 0.5, area.y + area.height - 8.0, 1u8, s.ink)
    }
    try v3_chevron(b, area.x + 8.0, area.y + area.height * 0.5, 2u8, s.ink)
    ret v3_chevron(b, area.x + area.width - 8.0, area.y + area.height * 0.5, 3u8, s.ink)
}

// round 13: the native Windows 11 dark scroll bar arrow glyphs, as pixels (vscroll/hscroll-pressed-arrow: the held arrow, #AFAFAF,
// on a #171717 button; vscroll/hscroll-disabled: both arrows, #505050). `kind` 0 held, 1 disabled; `end` 0 the start arrow (up, left),
// 1 the end one (down, right) as the start mirror image; the button square behind the held arrow is painted by the caller.
type DarkArrow = struct { vertical: bool, kind: u32, end: u32, length: f32 }

fn dark_gray(g: u8) -> paint.Color {
    let v = u32(g)
    ret style.hex_raw((v << 16u32) | (v << 8u32) | v)
}

fn dark_arrow_table(b: *scene.Builder, area: geometry.Rect, rows: usize, cols: usize, table: []const u8, x0: f32, y0: f32, flip_x: bool, flip_y: bool, length: f32) -> err {
    var r = 0usize
    while r < rows {
        var c = 0usize
        while c < cols {
            var x = x0 + f32(c)
            var y = y0 + f32(r)
            if flip_x { x = length - 1.0 - x }
            if flip_y { y = length - y }
            try winpx.fill(b, area.x + x, area.y + y, 1.0, 1.0, dark_gray(table[r * cols + c]))
            c += 1usize
        }
        r += 1usize
    }
    ret ok
}

fn dark_arrow_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let d = mem.cast[*DarkArrow](ctx)
    let held_v = [80]u8{ 23, 23, 23, 24, 60, 60, 24, 23, 23, 23, 23, 23, 23, 102, 175, 175, 102, 23, 23, 23, 23, 23, 58, 173, 175, 175, 173, 58, 23, 23, 23, 30, 154, 175, 175, 175, 175, 154, 30, 23, 23, 113, 175, 175, 175, 175, 175, 175, 113, 23, 62, 175, 175, 175, 175, 175, 175, 175, 175, 62, 92, 175, 175, 175, 175, 175, 175, 175, 175, 94, 28, 80, 90, 90, 90, 90, 90, 90, 80, 28 }
    let held_h = [80]u8{ 23, 23, 23, 23, 23, 62, 91, 28, 23, 23, 23, 30, 113, 175, 175, 80, 23, 23, 58, 154, 175, 175, 175, 90, 24, 102, 173, 175, 175, 175, 175, 90, 69, 175, 175, 175, 175, 175, 175, 90, 69, 175, 175, 175, 175, 175, 175, 90, 24, 102, 173, 175, 175, 175, 175, 90, 23, 23, 58, 154, 175, 175, 175, 90, 23, 23, 23, 30, 113, 175, 175, 80, 23, 23, 23, 23, 23, 62, 93, 28 }
    let off_v = [48]u8{ 23, 23, 34, 73, 73, 34, 23, 23, 23, 25, 70, 80, 80, 70, 25, 23, 23, 55, 80, 80, 80, 80, 55, 23, 37, 80, 80, 80, 80, 80, 80, 37, 73, 80, 80, 80, 80, 80, 80, 73, 70, 80, 80, 80, 80, 80, 80, 70 }
    let off_h = [64]u8{ 23, 23, 23, 37, 73, 70, 23, 23, 23, 25, 55, 80, 80, 80, 23, 23, 34, 70, 80, 80, 80, 80, 23, 23, 74, 80, 80, 80, 80, 80, 23, 23, 74, 80, 80, 80, 80, 80, 23, 23, 34, 70, 80, 80, 80, 80, 23, 23, 23, 25, 55, 80, 80, 80, 23, 23, 23, 23, 23, 37, 73, 70, 23, 23 }
    let flip = d.end == 1u32
    if d.vertical {
        if d.kind == 0u32 { ret dark_arrow_table(b, area, 8usize, 10usize, held_v[0usize..80usize], 4.0, 5.0, false, flip, d.length) }
        ret dark_arrow_table(b, area, 6usize, 8usize, off_v[0usize..48usize], 5.0, 6.0, false, flip, d.length)
    }
    if d.kind == 0u32 { ret dark_arrow_table(b, area, 10usize, 8usize, held_h[0usize..80usize], 4.0, 4.0, flip, false, d.length) }
    ret dark_arrow_table(b, area, 8usize, 8usize, off_h[0usize..64usize], 5.0, 5.0, flip, false, d.length)
}

// The bar alone: `length` long along `vertical`, for a viewport of `view` px over `content`
// px scrolled to `offset`. Keyed `key` (its hover and press state).
// looks5-e: a dialog's list bar (the Filter tree): a white first pixel and the thumb on whole pixels, as the grids of the dialogs
var scroll_bar_crisp: bool = false
fn set_scroll_bar_crisp(on: bool) { scroll_bar_crisp = on }
// round 18: the crisp bar held on an arrow keeps its thin thumb (the native pressed-up capture)
var scroll_bar_thin: bool = false
fn set_scroll_bar_thin(on: bool) { scroll_bar_thin = on }

// ---- round 13: the native light bar's states v3 never showed (ref/windows-native/light/vscroll-disabled, hscroll-disabled, *-pressed-arrow) ----
// Windows 11's disabled bar: a 17 wide (or high) bar of the face colour with a white first line and two light grey arrows 4 in from the
// line, 6 from each end; the pressed upper (left) arrow is the dark #686868 one. Pixel strings from scripts/looks_bar_native.py.
var scroll_bar_disabled: bool = false
fn set_scroll_bar_disabled(on: bool) { scroll_bar_disabled = on }
fn native_arrow_up_disabled() -> str { ret "" }
fn native_arrow_down_disabled() -> str { ret "" }
fn native_arrow_left_disabled() -> str { ret "" }
fn native_arrow_right_disabled() -> str { ret "" }
fn native_arrow_up_pressed() -> str { ret "" }
fn native_arrow_left_pressed() -> str { ret "" }

fn windows_scroll_bar_disabled(a: *mem.Arena, t: *const Theme, vertical: bool, length: f32) -> (widget.Node, err) {
    let (parts, parts_error) = mem.alloc[widget.Node](a, 4usize)
    if parts_error != ok { ret (zero, TooLarge) }
    var line = sized_style(1.0, length)
    if !vertical { line = sized_style(length, 1.0) }
    line.background = paint.Brush { Solid: style.hex(16777215u32) }
    parts[0usize] = widget.box(0u64, line, zero)
    var first = native_arrow_up_disabled()
    var second = native_arrow_down_disabled()
    var aw: f32 = 10.0
    var ah: f32 = 6.0
    if !vertical {
        first = native_arrow_left_disabled()
        second = native_arrow_right_disabled()
        aw = 6.0
        ah = 10.0
    }
    let (arrow_a, arrow_a_error) = gl.pixels(a, first, aw, ah)
    if arrow_a_error != ok { ret (zero, arrow_a_error) }
    let (arrow_b, arrow_b_error) = gl.pixels(a, second, aw, ah)
    if arrow_b_error != ok { ret (zero, arrow_b_error) }
    if vertical {
        parts[1usize] = widget.positioned(0u64, 4.0, 6.0, style.defaults(), one_widget(a, arrow_a))
        parts[2usize] = widget.positioned(0u64, 4.0, length - 11.0, style.defaults(), one_widget(a, arrow_b))
    } else {
        parts[1usize] = widget.positioned(0u64, 5.0, 4.0, style.defaults(), one_widget(a, arrow_a))
        parts[2usize] = widget.positioned(0u64, length - 11.0, 4.0, style.defaults(), one_widget(a, arrow_b))
    }
    var face = sized_style(17.0, length)
    if !vertical { face = sized_style(length, 17.0) }
    face.background = paint.Brush { Solid: style.color(t.tokens, .Background) }
    ret (widget.stack(0u64, face, parts[0usize..3usize]), ok)
}

fn windows_scroll_bar(a: *mem.Arena, key: widget.Key, t: *const Theme, vertical: bool, length: f32, view: f32, content: f32, offset: f32) -> (widget.Node, err) {
    style.windows_dark_enter(t.tokens)
    if scroll_bar_disabled && !style.windows_dark_on() {
        let (off_bar, off_bar_error) = windows_scroll_bar_disabled(a, t, vertical, length)
        ret (off_bar, off_bar_error)
    }
    var state = control_state(t, key, true, false)
    // round 13: the native dark bar looks like its rest capture under a plain hover (vscroll-hover-*, hscroll-hover-arrow and -thumb are
    // pixel-identical to rest); held on an end arrow it is the expanded bar (a #1E1E1E track, that arrow lit on its #171717 button, the thumb
    // dim: *-pressed-arrow); with nothing to scroll both arrows show dim (*-disabled).
    var dark_zone = 0u32
    if style.windows_dark_on() {
        if state.pressed && mem.address_of(t.runtime) != 0usize {
            let (bar_box, has_bar_box) = keyed_bounds(t.runtime, key)
            if has_bar_box {
                let at = widget.pointer_position(t.runtime)
                var along = at.y - bar_box.y
                if !vertical { along = at.x - bar_box.x }
                if along < 17.0 { dark_zone = 1u32 }
                if along > length - 17.0 { dark_zone = 2u32 }
            }
        }
        state.hovered = false
        state.pressed = false
    }
    // round 12: the native dark bar is the 17 wide pixel bar of vscroll-rest (crisp: thumb columns 8 and 9)
    let crisp = scroll_bar_crisp || style.windows_dark_on()
    // Measured at 100 % in the v3 main window (ref/windows/main-window@1x.png): the vertical bar's
    // thumb is 2 wide (#858585, square ends) on its 16 wide track; the horizontal bar of a grid
    // (in the navigator row) is a 9 thick #858585 block with square ends.
    // looks4-e (states captures): the vertical thumb is 2 wide, 0.4 right of the track's middle, a 6 wide pill while pressed;
    // the horizontal thumb is 8 thick inside a 1 px #BABABA rim, 12 thick with rounded ends while pressed; the colour is
    // #858585 pressed or not and no arrows show while the thumb is pressed
    var w: f32 = 2.0
    if !vertical { w = 8.0 }
    // round 12: the native dark bar is thin both ways: the thumb is 2 thick on rows 8 and 9 of the 17 (hscroll-rest)
    if style.windows_dark_on() && !vertical { w = 2.0 }
    var ink = style.hex(8750469u32)
    // round 13: the 6 px pill shows only while the pointer is on the thumb (live captures: over the track or an arrow the thumb stays thin)
    var pill_hot = state.hovered || state.pressed
    if vertical && !crisp && (state.hovered || state.pressed) && mem.address_of(t.runtime) != 0usize && length > 32.0 && content > view {
        let (pill_box, has_pill_box) = keyed_bounds(t.runtime, key)
        if has_pill_box {
            let pill_y = widget.pointer_position(t.runtime).y - pill_box.y
            let pill_room = length - 32.0
            var pill_len = pill_room * view / content
            if pill_len < 17.0 { pill_len = 17.0 }
            if pill_len > pill_room { pill_len = pill_room }
            var pill_share = offset / (content - view)
            if pill_share < 0.0 { pill_share = 0.0 }
            if pill_share > 1.0 { pill_share = 1.0 }
            let pill_at = 16.0 + (pill_room - pill_len) * pill_share
            pill_hot = pill_y >= pill_at && pill_y < pill_at + pill_len
        }
    }
    if scroll_bar_thin { pill_hot = false }
    if state.hovered && vertical && pill_hot { w = 6.0 }
    if state.pressed && pill_hot { w = 6.0 }
    if state.pressed && !vertical { w = 12.0 }
    let hot_pill = pill_hot && (state.hovered || state.pressed)
    let room = length - 32.0
    var dark_track = style.hex_raw(0x171717u32)
    var thick = style.defaults()
    var track = sized_style(16.0, length)
    if crisp { track = sized_style(17.0, length) }
    if !vertical { track = sized_style(length, 16.0) }
    if !vertical && style.windows_dark_on() { track = sized_style(length, 17.0) }
    track.background = paint.Brush { Solid: style.color(t.tokens, .Background) }
    if style.windows_dark_on() {
        // (round 7) Windows 11 dark: #2B2B2B track, #8A8A8A thumb (#A0A0A0 hot, #B8B8B8 held), no light rim
        // (round 10) native Windows 11 dark (ref/windows-native/dark/vscroll-*): track #171717 with no lighter edge line,
        // thumb #858585 (rest; hot and held captures are pixel-identical to rest, so the colour stays), track #1E1E1E while
        // the bar is expanded under the pointer (vscroll-pressed-arrow)
        dark_track = style.hex_raw(0x171717u32)
        if dark_zone != 0u32 { dark_track = style.hex_raw(0x1E1E1Eu32) }
        track.background = paint.Brush { Solid: dark_track }
        ink = style.hex_raw(0x858585u32)
        if dark_zone != 0u32 { ink = style.hex_raw(0x303030u32) }
    }
    // (round 12) the native thumb body is #959595 between 1 px #858585 end rows
    var body = style.hex_raw(0x959595u32)
    if dark_zone != 0u32 { body = style.hex_raw(0x333333u32) }
    let (layers, layers_error) = mem.alloc[widget.Node](a, 8usize)
    if layers_error != ok { ret (zero, TooLarge) }
    var count = 0usize
    // looks4-e: the track's first pixel line, towards the content, is #F7F7F7 (live captures, scroll_bar_live*.png)
    var edge = sized_style(1.0, length)
    if !vertical { edge = sized_style(length, 1.0) }
    edge.background = paint.Brush { Solid: style.hex(16250871u32) }
    if crisp { edge.background = paint.Brush { Solid: style.hex(16777215u32) } }
    if style.windows_dark_on() { edge.background = paint.Brush { Solid: dark_track } }
    if vertical || crisp || style.windows_dark_on() {
        layers[count] = widget.box(0u64, edge, zero)
        count += 1usize
    }
    if content > view && room > 0.0 {
        var thumb_len = room * view / content
        if thumb_len < 17.0 { thumb_len = 17.0 }
        if thumb_len > room { thumb_len = room }
        var share = offset / (content - view)
        if share < 0.0 { share = 0.0 }
        if share > 1.0 { share = 1.0 }
        let at = 17.0 + (room - thumb_len) * share
        var side = (16.0 - w) * 0.5 + 0.46
        // looks5-e: pressed, the pill stands on whole pixels (live captures: 6 px, #858585, 294 to 299 on a bar that starts at 289)
        var lift: f32 = 0.47
        if crisp {
            side = 8.0
            if (state.pressed || state.hovered) && !scroll_bar_thin { side = 6.0 }
            lift = 0.0
        }
        if state.pressed && vertical && !crisp && pill_hot {
            side = (16.0 - w) * 0.5
            lift = 0.0
        }
        thick = sized_style(w, thumb_len)
        thick.margin = style.EdgeLengths { left: style.Length { Px: side }, top: style.Length { Px: at + lift }, right: style.Length { Px: 0.0 }, bottom: style.Length { Px: 0.0 } }
        thick.radius = w * 0.5
        if !vertical {
            side = (16.0 - (w + 2.0)) * 0.5
            thick = sized_style(thumb_len, w + 2.0)
            thick.margin = style.EdgeLengths { left: style.Length { Px: at }, top: style.Length { Px: side }, right: style.Length { Px: 0.0 }, bottom: style.Length { Px: 0.0 } }
            thick.border = style.Border { width: 1.0, color: style.hex(12237498u32) }
            if style.windows_dark_on() { thick.border = style.Border { width: 1.0, color: dark_track } }
            thick.radius = 0.0
            if state.pressed { thick.radius = 4.0 }
            if style.windows_dark_on() {
                thick = sized_style(thumb_len, 2.0)
                thick.margin = style.EdgeLengths { left: style.Length { Px: at }, top: style.Length { Px: 8.0 }, right: style.Length { Px: 0.0 }, bottom: style.Length { Px: 0.0 } }
            }
        }
        thick.background = paint.Brush { Solid: ink }
        if !vertical && !crisp && !style.windows_dark_on() && thumb_len >= 14.0 {
            thick.background = paint.Brush { Solid: paint.rgba(0.0, 0.0, 0.0, 0.0) }
