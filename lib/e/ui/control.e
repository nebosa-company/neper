// A tab view: the tab list (keyed `key + 1`) above the selected page alone, a group
// labelled by the selected tab.
fn tab_view(a: *mem.Arena, key: widget.Key, t: *const Theme, labels: []const str, selected: usize, picks: []const widget.Submit, pages: []const widget.Node) -> (widget.Node, err) {
    if pages.len != labels.len || selected >= labels.len { ret (zero, TooLarge) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    let (strip, strip_error) = tabs(a, key + 1u64, t, labels, selected, picks)
    if strip_error != ok { ret (zero, strip_error) }
    parts[0usize] = strip
    let (body, body_error) = mem.alloc[widget.Node](a, 1usize)
    if body_error != ok { ret (zero, TooLarge) }
    body[0usize] = pages[selected]
    var sem: widget.Semantics = zero
    sem.role = 2u8
    sem.labelled_by = key + 2u64 + u64(selected)
    parts[1usize] = widget.semantics(key, sem, style.defaults(), body[0usize..1usize])
    // v2 (D972): the page stands directly below the bar.
    ret (widget.flex(0u64, ui_layout.Flex { axis: .Vertical, main: .Start, cross: .Stretch, gap: 0.0 }, style.defaults(), parts[0usize..2usize]), ok)
}

// A pane handle's state for the frame: where the pane is, its limits, and whom to
// tell. A drag reports the pointer's distance from the pane's origin, the pointer
// taken as the handle's middle; a nudge
// reports the size moved by a step; both are clamped to `low..high`, and with no
// `high` to the extent of the element `bound` names less `reserve` (no bound: no
// upper limit).
// (D1212) The sash keeps, across frames, the size it was first built at (what a
// double-click restores) and the size a drag began at, whether a drag is under
// way, and whether Escape cancelled it (its later moves are ignored).
// (D1310) `collapsible`: a wish below half of `low` reports 0, the pane shut.
// `from` is the size at the press of the drag under way (D1598), for a sash whose
// cell is not made yet; the cell's `start` otherwise.
type Handle = struct { runtime: *widget.Runtime, pane: widget.Key, bound: widget.Key, vertical: bool, size: f32, thick: f32, low: f32, high: f32, reserve: f32, change: widget.Change[f32], cell: *SashCell, has_cell: bool, collapsible: bool, from: f32 }
type Nudge = struct { handle: *Handle, amount: f32 }
// (D1356) `open` is the last size above 0, which a collapse eases down from.
type SashCell = struct { initial: f32, start: f32, dragging: bool, cancelled: bool, open: f32 }

fn sash_cell(runtime: *widget.Runtime, key: widget.Key, size: f32) -> (*SashCell, bool) {
    var none: *SashCell = zero
    if mem.address_of(runtime) == 0usize { ret (none, false) }
    let (s, state_error) = widget.state_of(runtime)
    if state_error != ok { ret (none, false) }
    let (id, found) = widget.find_by_key(s, key)
    if found != 1usize { ret (none, false) }
    var build = widget.BuildContext { runtime: runtime, element: id, frame: 0u64 }
    let (kept, _, kept_error) = widget.state[SashCell](&build, key, SashCell { initial: size, start: size, dragging: false, cancelled: false, open: size })
    if kept_error != ok { ret (none, false) }
    ret (kept, true)
}

// (D1550, docs/ux/components/ResizablePane, reset) The size a pane (keyed `key`,
// its sash `key + 2`) restores on a double-click, when the caller has one of its
// own rather than the size the pane was first built at; called after the pane is
// built each frame (the sash's first frame keeps the built size).
fn pane_default(t: *const Theme, key: widget.Key, size: f32) {
    let (kept, has_kept) = sash_cell(t.runtime, key + 2u64, size)
    if has_kept { kept.initial = size }
}

// (D1212) Escape during a drag: back to the size the drag began at.
fn handle_cancel(ctx: *void) -> err {
    let h = mem.cast[*Handle](ctx)
    if !h.has_cell || !h.cell.dragging { ret ok }
    h.cell.cancelled = true
    ret handle_report(h, h.cell.start)
}

fn keyed_bounds(runtime: *widget.Runtime, key: widget.Key) -> (geometry.Rect, bool) {
    let (s, state_error) = widget.state_of(runtime)
    if state_error != ok { ret (zero, false) }
    let (id, count) = widget.find_by_key(s, key)
    if count == 0usize { ret (zero, false) }
    let (area, has_area) = widget.bounds_of(runtime, id)
    ret (area, has_area)
}

// (D1598) The handle keeps the size it reports, as the caller's next build would:
// a drag moves from it, a key nudges it, and an Escape knows where the drag began.
fn handle_report(h: *Handle, wanted: f32) -> err {
    if h.collapsible && wanted < h.low * 0.5 {
        h.size = 0.0
        ret widget.fire_change[f32](h.change, 0.0)
    }
    var value = wanted
    if h.high > 0.0 {
        if value > h.high { value = h.high }
    } else {
        if h.bound != 0u64 {
            let (area, has_area) = keyed_bounds(h.runtime, h.bound)
            if has_area {
                var extent = area.width
                if h.vertical { extent = area.height }
                if value > extent - h.reserve { value = extent - h.reserve }
            }
        }
    }
    if value < h.low { value = h.low }
    h.size = value
    ret widget.fire_change[f32](h.change, value)
}

fn handle_drag(ctx: *void, g: widget.Gesture) -> err {
    let h = mem.cast[*Handle](ctx)
    switch g {
    case .DragStart as p:
        if h.has_cell {
            h.cell.start = h.size
            h.cell.dragging = true
            h.cell.cancelled = false
        }
        h.from = h.size
        // (D1598) The travel that made the press a drag arrives with the start.
        let now = widget.pointer_position(h.runtime)
        var travel = now.x - p.x
        if h.vertical { travel = now.y - p.y }
        if travel == 0.0 { ret ok }
        ret handle_report(h, h.size + travel)
    case .DragEnd as p:
        if h.has_cell {
            h.cell.dragging = false
            h.cell.cancelled = false
        }
        ret ok
    case .DoubleTap as p:
        if h.has_cell { ret handle_report(h, h.cell.initial) }
        ret ok
    case .DragMove as d:
        if h.has_cell && h.cell.cancelled { ret ok }
        let (_, has_area) = keyed_bounds(h.runtime, h.pane)
        if !has_area { ret ok }
        // (D1598) The size moves by the pointer's travel, not to the pointer: the
        // sash takes input 24 across, so where in it the pointer lands must not
        // move the edge. With its cell, the size at the press plus the whole
        // travel, so a limit or a fold on the way does not eat it; without, each
        // move's travel from the size last reported.
        var travel = d.delta.x
        var whole = d.position.x - d.start.x
        if h.vertical {
            travel = d.delta.y
            whole = d.position.y - d.start.y
        }
        if h.has_cell && h.cell.dragging { ret handle_report(h, h.cell.start + whole) }
        ret handle_report(h, h.from + whole)
    default:
        ret ok
    }
}

fn handle_nudge(ctx: *void) -> err {
    let n = mem.cast[*Nudge](ctx)
    ret handle_report(n.handle, n.handle.size + n.amount)
}

// A resizable pane: the content sized `size` along `axis` (the caller keeps the
// size and hears each change), the sash of D966 after it, between `low` and
// `high` (0: no limit). The pane is keyed `key + 1`, the sash `key + 2`, a
// separator in the tree named "Resize " and `label`, its value the size in px.
fn resizable_pane(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, axis: ui_layout.Axis, size: f32, low: f32, high: f32, change: widget.Change[f32], content: widget.Node) -> (widget.Node, err) {
    let (named, named_error) = mem.alloc[u8](a, label.len + 7usize)
    if named_error != ok { ret (zero, TooLarge) }
    var n = copy_text(named, "Resize ")
    n += copy_text(named[n..named.len], label)
    let (made, made_error) = pane_with_reserve(a, key, t, named[0usize..n], axis, size, low, high, 0u64, 0.0, change, content, false)
    ret (made, made_error)
}

// A sash's paint (D966): the line across the sash's middle (on whole pixels),
// `line_width` thick, and a 4 x 48 fully rounded grip on it (none while `grip`
// is clear), or, as a dock layout's, a 4px bar in place of the line.
// The Windows look (v3's TcxSplitter, simple hot zone): `v3` paints `face` over the strip and
// a hot zone `hot_len` long, `edge` framed, with a chevron toward the first pane at each end
// (`ink`) and a dotted line (`dots`) between them.
type Sash = struct { line: paint.Color, line_width: f32, grip: paint.Color, across: bool, arena: *mem.Arena, v3: bool, face: paint.Color, edge: paint.Color, dots: paint.Color, ink: paint.Color, hot_len: f32, hot_face: paint.Color, held: bool }

// ---- looks: Windows (v3) splitter, appended block ----

// A 7 x 4 chevron of 2-thick strokes centred on (cx, cy); dir 0 up, 1 down, 2 left, 3 right.
fn v3_chevron(b: *scene.Builder, cx: f32, cy: f32, dir: u8, ink: paint.Color) -> err {
    var c: f32 = -3.0
    while c <= 3.0 {
        var o = c
        if o < 0.0 { o = 0.0 - o }
        var r = geometry.rect(cx + c, cy - 2.5 + o, 1.5, 2.0)
        if dir == 1u8 { r = geometry.rect(cx + c, cy + 0.5 - o, 1.5, 2.0) }
        if dir == 2u8 { r = geometry.rect(cx - 2.5 + o, cy + c, 2.0, 1.5) }
        if dir == 3u8 { r = geometry.rect(cx + 0.5 - o, cy + c, 2.0, 1.5) }
        try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: r, brush: paint.Brush { Solid: ink } } })
        c += 1.0
    }
    ret ok
}

// A run of the hot zone: `u` along the strip, `v` across it, `n` px long along it and 1 across;
// the strip lying (`across`) swaps the axes.
fn v3_zone_px(b: *scene.Builder, across: bool, ax: f32, ay: f32, u: f32, v: f32, n: f32, color: paint.Color) -> err {
    if across { ret scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(ax + u, ay + v, n, 1.0), brush: paint.Brush { Solid: color } } }) }
    ret scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(ax + v, ay + u, 1.0, n), brush: paint.Brush { Solid: color } } })
}

// The "<" chevron of the hot zone, 4 across by 8 along, measured at 100 % on the Filter window's
// splitter (ref/windows/dialogs/search-filter-top): grey values row by row (".." empty).
fn v3_zone_chevron() -> str { ret "......50....5000..5000a05000a0..a00050....a00050....a000......a0" }

// The hot zone of v3's TcxSplitter (simple style), 8 thick and 0.3 of the strip long (and 2 more, down
// to a whole pixel: 463 -> 140, 497 -> 151, 387 -> 118 in the captures), centred; the zone is a
// #A0A0A0 (the button shadow) frame with a #BBBBBB top and foot, a lighter row and a white column
// inside, a #D5D5D5 shadow row under it, a "<" chevron toward the first pane 6 from each end and
// a dotted line between them (1 x 2 blue dots every 3).
fn sash_paint_v3(s: *Sash, b: *scene.Builder, sized: geometry.Rect) -> err {
    // On whole pixels (the capture's zone is pixel-sharp whatever the strip's place).
    let left = f32(i64(sized.x + 0.5))
    let top = f32(i64(sized.y + 0.5))
    // TcxSplitter is 8 thick (DFM Width/Height 8); the layout hands over a fractional 7.x.
    var area = geometry.rect(left, top, 8.0, f32(i64(sized.y + sized.height + 0.5)) - top)
    if s.across { area = geometry.rect(left, top, f32(i64(sized.x + sized.width + 0.5)) - left, 8.0) }
    try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: area, brush: paint.Brush { Solid: s.face } } })
    var along = area.height
    var thick = area.width
    if s.across {
        along = area.width
        thick = area.height
    }
    // looks4 group d: the strip's first row along it is #F3F3F3 (measured on the Filter window's splitter;
    // a held strip (WM_LBUTTONDOWN grabs) is the same as at rest, so no press tint).
    var first_v: f32 = 0.0
    // looks9: the 574 px held / hot strip's first column is the plain face (ref/windows/states/splitter-pressed-main-horizontal).
    if s.across && s.held { first_v = thick }
    while first_v < thick {
        try v3_zone_px(b, s.across, area.x, area.y, 0.0, first_v, 1.0, style.hex(15987699u32))
        first_v += 1.0
    }
    var len = f32(i64(along * 0.3 + 2.0))
    if s.hot_len > 0.0 { len = s.hot_len }
    if len > along - 2.0 { len = along - 2.0 }
    if len < 24.0 { ret ok }
    let ax = area.x
    let ay = area.y
    let u0 = f32(i64((along - len) * 0.5 + 1.0))
    if !s.across && len == 140.0 && s.held { ret win5_zone_paint(b, false, ax, ay, u0, 140usize, win5_zone_upright_held()) }
    // looks9: the 574 px held / hot strip's zone starts at 200 (the capture), not 201.
    if s.across && len == 174.0 && s.held { ret win5_zone_paint(b, true, ax, ay, u0 - 1.0, 174usize, win5_zone_lying_held()) }
    if !s.across && len == 140.0 { ret win5_zone_paint(b, false, ax, ay, u0, 140usize, win5_zone_upright()) }
    if s.across && len == 151.0 { ret win5_zone_paint(b, true, ax, ay, u0, 151usize, win5_zone_lying()) }
    let last = thick - 1.0
    let frame = s.edge
    let top_row = style.hex(12303291u32)
    var v: f32 = 0.0
    while v < thick {
        try v3_zone_px(b, s.across, ax, ay, u0, v, 1.0, top_row)
        try v3_zone_px(b, s.across, ax, ay, u0 + len - 2.0, v, 1.0, top_row)
        try v3_zone_px(b, s.across, ax, ay, u0 + len - 1.0, v, 1.0, style.hex(14013909u32))
        v += 1.0
    }
    // The sides, the face between them, the light row (u 1) and the paler one (u 2), the white column.
    try v3_zone_px(b, s.across, ax, ay, u0 + 1.0, 0.0, len - 3.0, frame)
    try v3_zone_px(b, s.across, ax, ay, u0 + 1.0, last, len - 3.0, frame)
    try v3_zone_px(b, s.across, ax, ay, u0 + len - 2.0, 0.0, 1.0, frame)
    try v3_zone_px(b, s.across, ax, ay, u0 + len - 2.0, last, 1.0, frame)
    v = 1.0
    while v < last {
        try v3_zone_px(b, s.across, ax, ay, u0 + 1.0, v, len - 3.0, s.hot_face)
        v += 1.0
    }
    v = 1.0
    while v < last {
        var edge_row = style.hex(14671839u32)
        try v3_zone_px(b, s.across, ax, ay, u0 + 1.0, v, 1.0, edge_row)
        if v > 1.0 { try v3_zone_px(b, s.across, ax, ay, u0 + 2.0, v, 1.0, style.hex(16119285u32)) }
        v += 1.0
    }
    try v3_zone_px(b, s.across, ax, ay, u0 + 2.0, 1.0, len - 4.0, style.hex(16777215u32))
    try v3_zone_px(b, s.across, ax, ay, u0 + len - 2.0, 1.0, 1.0, style.hex(12632256u32))
    let table = v3_zone_chevron()
    var row: f32 = 0.0
    while row < 8.0 {
        var col: f32 = 0.0
        while col < 4.0 {
            let g = win3_byte(table, usize(row) * 4usize + usize(col))
            if g < 256u32 {
                let ink = style.hex(g * 65793u32)
                try v3_zone_px(b, s.across, ax, ay, u0 + 6.0 + row, 2.0 + col, 1.0, ink)
                try v3_zone_px(b, s.across, ax, ay, u0 + len - 13.0 + row, 2.0 + col, 1.0, ink)
            }
            col += 1.0
        }
        row += 1.0
    }
    var at: f32 = 16.0
    while at < len - 16.0 {
        try v3_zone_px(b, s.across, ax, ay, u0 + at, 4.0, 1.0, s.dots)
        try v3_zone_px(b, s.across, ax, ay, u0 + at + 1.0, 4.0, 1.0, style.hex(10537192u32))
        try v3_zone_px(b, s.across, ax, ay, u0 + at - 1.0, 3.0, 1.0, style.hex(16448250u32))
        try v3_zone_px(b, s.across, ax, ay, u0 + at, 3.0, 1.0, style.hex(16119285u32))
        at += 3.0
    }
    ret ok
}

// ---- looks5 group d: the main window's two splitters, from the captured pixels ------------------
// The main window's splitters sit between pixels (the dialog's does not): their 8 thick, 140 and 151 long hot
// zones are the capture's own pixels (rows along the strip, 8 across, "rrggbb" each): the upright one is
// ref/windows/main-window@1x at x 287 to 294, y 271 to 410, the lying one x 468 to 618, y 322 to 329.
fn win5_zone_upright() -> str { ret "" }
fn win5_zone_upright_held() -> str { ret "" }
fn win5_zone_lying_held() -> str { ret "" }
fn win5_zone_lying() -> str { ret "" }

fn win5_hex6(table: str, at: usize) -> u32 {
    var v = 0u32
    var k = 0usize
    while k < 6usize {
        v = v * 16u32 + win3_nibble(table[at * 6usize + k])
        k += 1usize
    }
    ret v
}

fn win5_zone_paint(b: *scene.Builder, across: bool, ax: f32, ay: f32, u0: f32, len: usize, table: str) -> err {
    var u = 0usize
    while u < len {
        var v = 0usize
        while v < 8usize {
            try v3_zone_px(b, across, ax, ay, u0 + f32(u), f32(v), 1.0, style.hex(win5_hex6(table, u * 8usize + v)))
            v += 1usize
        }
        u += 1usize
    }
    ret ok
}
// ---- looks5 group d: the image combo box as a grid's in-place editor ---------------------------------------
// The Sort window's Sort Order cell with its editor active (ref/windows/states/image-combo-box-cell-editor-sort and
// ...-open-dialog-sort, at 100 percent): a 21 tall #EFEFEF cell with a #E8E8E8 line on top and a #F3F3F3 one under it,
// the dotted focus rectangle round it (as a list-style combo's), the value 23 in, and a 17 wide drop button
// 3 down and 18 from the right: #FDFDFD in a #D2D2D2 frame with a grey chevron, or, with its list open, #CCE4F7 in a
// #005FB7 frame (the button is the capture's own pixels).
fn win5_cell_button_rest() -> str { ret "" }
fn win5_cell_button_held() -> str { ret "" }

type Win5Cell = struct { held: bool }

fn win5_cell_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let m = mem.cast[*Win5Cell](ctx)
    try win3_rect(b, area.x, area.y, area.width, 21.0, style.hex(15724527u32))
    try win3_rect(b, area.x, area.y, area.width, 1.0, style.hex(15263976u32))
    try win3_rect(b, area.x, area.y + 20.0, area.width, 1.0, style.hex(15987699u32))
    var table = win5_cell_button_rest()
    if m.held { table = win5_cell_button_held() }
    var j = 0usize
    while j < 15usize {
        var i = 0usize
        while i < 17usize {
            try win3_rect(b, area.x + area.width - 18.0 + f32(i), area.y + 3.0 + f32(j), 1.0, 1.0, style.hex(win5_hex6(table, j * 17usize + i)))
            i += 1usize
        }
        j += 1usize
    }
    ret ok
}

fn image_select_cell(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, width: f32, held: bool) -> (widget.Node, err) {
    let (cells, cells_error) = mem.alloc[Win5Cell](a, 1usize)
    if cells_error != ok { ret (zero, TooLarge) }
    cells[0usize] = Win5Cell { held: held }
    var none: []const widget.Node = zero
    let face = widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: win3_measure, paint: win5_cell_paint, state: widget.bytes_of[Win5Cell](&cells[0usize]) } }, style: sized_style(width, 21.0), children: none }
    let (dialog_t, dialog_error) = win3_dialog_theme(a, t)
    if dialog_error != ok { ret (zero, dialog_error) }
    var words = text_options()
    words.role = .BodyMedium
    words.wrap = .None
    let (said, said_error) = colored_text(a, 0u64, label, &dialog_t, words, style.color(t.tokens, .Text))
    if said_error != ok { ret (zero, said_error) }
    let (dots, dots_error) = win3_dots(a, style.color(t.tokens, .Text), width + 1.0, 19.0)
    if dots_error != ok { ret (zero, dots_error) }
    let (layers, layers_error) = mem.alloc[widget.Node](a, 3usize)
    if layers_error != ok { ret (zero, TooLarge) }
    let (held_text, held_text_error) = mem.alloc[widget.Node](a, 1usize)
    if held_text_error != ok { ret (zero, TooLarge) }
    held_text[0usize] = said
    let (held_dots, held_dots_error) = mem.alloc[widget.Node](a, 1usize)
    if held_dots_error != ok { ret (zero, TooLarge) }
    held_dots[0usize] = dots
    layers[0usize] = face
    // The rectangle's left side is hidden by the column line: the dots start one left of the cell, clipped to it.
    var clip = sized_style(width, 19.0)
    clip.overflow = .Clip
    let (nudged, nudged_error) = mem.alloc[widget.Node](a, 1usize)
    if nudged_error != ok { ret (zero, TooLarge) }
    nudged[0usize] = widget.positioned(0u64, 0.0 - 1.0, 0.0, sized_style(width + 1.0, 19.0), held_dots[0usize..1usize])
    layers[1usize] = widget.positioned(0u64, 0.0, 1.0, clip, nudged[0usize..1usize])
    var line = style.defaults()
    line.height = style.Length { Px: 21.0 }
    line.padding = edges(23.0, 0.0, 0.0, 0.0)
    layers[2usize] = widget.flex(0u64, ui_layout.Flex { axis: .Horizontal, main: .Start, cross: .Center, gap: 0.0 }, line, held_text[0usize..1usize])
    ret (widget.stack(key, sized_style(width, 21.0), layers[0usize..3usize]), ok)
}
// ---- end looks5 group d (cell editor) ------------------------------------------------------------------------

// ---- looks5 group d: the toolbar combo under the pointer ----------------------------------------------------
// The hot item of a toolbar combo (ref/windows/states/hover-toolbar-combo-*; the edit and the drop button give the
// same pixels): a 2 px ring round the control (#BCBCBC then #D4D4D4 on top, #FAFAFA then #F5F5F5 under it) and
// its sides, which take the neighbours' colours. Rows 0 to 20 of the 131 (Mode, 127 wide) or 150 (the card name,
// 146 wide) columns: the first 3 and last 17 columns are the capture's own pixels, the rows 0, 1, 19 and 20 are flat between.
fn win5_hot_left_mode() -> str { ret "" }
fn win5_hot_right_mode() -> str { ret "" }
fn win5_hot_left_card() -> str { ret "" }
fn win5_hot_right_card() -> str { ret "" }

type Win5Hot = struct { card: bool }

fn win5_hot_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let m = mem.cast[*Win5Hot](ctx)
    var left = win5_hot_left_mode()
    var right = win5_hot_right_mode()
    if m.card {
        left = win5_hot_left_card()
        right = win5_hot_right_card()
    }
    var r = 0usize
    while r < 21usize {
        var i = 0usize
        while i < 3usize {
            try win3_rect(b, area.x + f32(i), area.y + f32(r), 1.0, 1.0, style.hex(win5_hex6(left, r * 3usize + i)))
            i += 1usize
        }
        i = 0usize
        while i < 17usize {
            try win3_rect(b, area.x + area.width - 17.0 + f32(i), area.y + f32(r), 1.0, 1.0, style.hex(win5_hex6(right, r * 17usize + i)))
            i += 1usize
        }
        var fill: u32 = 0u32
        if r == 0usize { fill = 12303291u32 }
        if r == 1usize { fill = 13948116u32 }
        if r == 19usize { fill = 16448250u32 }
        if r == 20usize { fill = 16119285u32 }
        if fill != 0u32 { try win3_rect(b, area.x + 3.0, area.y + f32(r), area.width - 20.0, 1.0, style.hex(fill)) }
        r += 1usize
    }
    ret ok
}
// ---- end looks5 group d (hot toolbar combo) ------------------------------------------------------------------

// ---- looks5 group d: v3's hint windows -----------------------------------------------------------------------
// A toolbar button's hint (TdxBarHintWindow, ref/windows/states/hover-hint-toolbar-*): #FFFFE1 with a 1 px bevel, #E3E3E3 on top
// and left, #696969 at the bottom and right, Tahoma 11 text 3 in and 2 down. A grid's hint (TcxHintWindow, hover-hint-grid-header-name):
// a #F9F9F9 face (#F6F6F6 under the top line) in a #646464 line on top and left, #949494 at the foot, the text 7 in and 5 down in grey.
// `width` and `height` 0: the text's (7 over it and 20 tall; 10 and 25).
type Win5Hint = struct { grid: bool, neper_dark: bool, face: paint.Color }

fn win5_hint_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let m = mem.cast[*Win5Hint](ctx)
    let x = area.x
    let y = area.y
    let w = area.width
    let h = area.height
    if m.neper_dark {
        // Neper dark: the palette's own tooltip (inverse surface, as the rich hint), not the v3 bevel
        ret win3_rect(b, x, y, w, h, m.face)
    }
    if m.grid {
        try win3_rect(b, x, y, w, h, style.hex(16382457u32))
        try win3_rect(b, x, y + 1.0, w, 1.0, style.hex(16119286u32))
        try win3_rect(b, x + 1.0, y + 1.0, 1.0, h - 2.0, style.hex(16119286u32))
        try win3_rect(b, x + 1.0, y + 1.0, 1.0, 1.0, style.hex(15987699u32))
        try win3_rect(b, x, y, w, 1.0, style.hex(6579300u32))
        try win3_rect(b, x, y, 1.0, h, style.hex(6579300u32))
        try win3_rect(b, x + 1.0, y + h - 1.0, w - 1.0, 1.0, style.hex(9737364u32))
        ret win3_rect(b, x + 1.0, y + h - 1.0, 1.0, 1.0, style.hex(9671571u32))
    }
    if style.windark_active() {
        // The Windows 11 dark tooltip (native capture ref/windows-native/dark/tooltip-rest): a #2B2B2B face in a 1 px #767676 frame, white text.
        try win3_rect(b, x, y, w, h, style.hex_raw(0x767676u32))
        ret win3_rect(b, x + 1.0, y + 1.0, w - 2.0, h - 2.0, style.hex_raw(0x2B2B2Bu32))
    }
    try win3_rect(b, x, y, w, h, style.hex(16777185u32))
    try win3_rect(b, x, y, w, 1.0, style.hex(14935011u32))
    try win3_rect(b, x, y, 1.0, h, style.hex(14935011u32))
    try win3_rect(b, x, y + h - 1.0, w, 1.0, style.hex(6908265u32))
    ret win3_rect(b, x + w - 1.0, y, 1.0, h, style.hex(6908265u32))
}

fn win5_hint(a: *mem.Arena, key: widget.Key, t: *const Theme, hint_text: str, grid: bool, width: f32, height: f32) -> (widget.Node, err) {
    // The toolbar's hint is Tahoma 12 (measured by ink width on the captures), the grid's Tahoma 11.
    var hint_px: f32 = 12.3
    if grid { hint_px = 11.1 }
    if style.windark_active() && !grid { hint_px = 12.0 }
    let (tahoma_t, dialog_error) = windows_tahoma_theme(a, t, hint_px)
    if dialog_error != ok { ret (zero, dialog_error) }
    // The native dark tooltip is Segoe UI 12 px (the faces stay in the theme's order).
    var dialog_t = tahoma_t
    if style.windark_active() && !grid { dialog_t.fonts = t.fonts }
    var words = text_options()
    words.role = .BodyMedium
    words.wrap = .None
    var ink = style.color(t.tokens, .Text)
    if grid { ink = style.hex(6713980u32) }
    let neper_dark = t.tokens.profile == .Neper && t.tokens.palette == .Dark
    if neper_dark { ink = style.color(t.tokens, .InverseOnSurface) }
    // looks9: v3 sets the hint's characters on GDI's whole pixel advances (Tahoma 12 px on the toolbar's, 11 px on the grid's): the hinted
    // label (it keeps a pixel of inset left and above, which the offsets below leave out)
    var one_line = true
    var line_break = 0usize
    while line_break < hint_text.len {
        if hint_text[line_break] == 10u8 { one_line = false }
        line_break += 1usize
    }
    var said_node: widget.Node = zero
    var said_error: err = ok
    if one_line {
        var tahoma_px: f32 = 12.0
        if grid { tahoma_px = 11.0 }
        let (hinted_said, hinted_error) = windows_label_faced(a, t, hint_text, tahoma_px, 400u32, ink, false, 0.0, 8u32, 0.0, 0.0, grid)
        said_node = hinted_said
        said_error = hinted_error
    } else {
        let (plain_said, plain_error) = colored_text(a, 0u64, hint_text, &dialog_t, words, ink)
        said_node = plain_said
        said_error = plain_error
    }
    let said = said_node
    if said_error != ok { ret (zero, said_error) }
    let (look_style, look_error) = text_style_faced(a, &dialog_t, words)
    if look_error != ok { ret (zero, look_error) }
    let (laid, laid_error) = layout.layout(a, hint_text, look_style, layout.Options { width: 100000.0, max_lines: 0u32, align: .Start, wrap: .None, ellipsis: "", notdef: false })
    if laid_error != ok { ret (zero, laid_error) }
    var over: f32 = 7.0
    var tall: f32 = 20.0
    var left: f32 = 3.0
    var drop: f32 = 3.0
    if style.windark_active() && !grid {
        over = 12.0
        left = 5.0
        drop = 2.0
    }
    if grid {
        over = 10.0
        tall = 25.0
        left = 6.0
        drop = 7.0
    }
    var w = width
    if w == 0.0 { w = f32(u32(laid.bounds.width + 0.5)) + over }
    var h = height
    if h == 0.0 {
        h = tall
        // (v3's hint carries its own line breaks: each one adds a 15 tall line; a guess for more than one line)
        var k = 0usize
        while k < hint_text.len {
            if hint_text[k] == 10u8 { h += 15.0 }
            k += 1usize
        }
    }
    let (cells, cells_error) = mem.alloc[Win5Hint](a, 1usize)
    if cells_error != ok { ret (zero, TooLarge) }
    cells[0usize] = Win5Hint { grid: grid, neper_dark: neper_dark, face: style.color(t.tokens, .InverseSurface) }
    var none: []const widget.Node = zero
    let face = widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&cells[0usize]), measure: win3_measure, paint: win5_hint_paint, state: widget.bytes_of[Win5Hint](&cells[0usize]) } }, style: sized_style(w, h), children: none }
    let (layers, layers_error) = mem.alloc[widget.Node](a, 2usize)
    if layers_error != ok { ret (zero, TooLarge) }
    let (held, held_error) = mem.alloc[widget.Node](a, 1usize)
    if held_error != ok { ret (zero, TooLarge) }
    held[0usize] = said
    layers[0usize] = face
    var inset_x = left
    var inset_y = drop
    if one_line {
        inset_x = left - 1.0
        inset_y = drop - 2.0
    }
    layers[1usize] = widget.positioned(0u64, inset_x, inset_y, style.defaults(), held[0usize..1usize])
    ret (widget.stack(key, sized_style(w, h), layers[0usize..2usize]), ok)
}
// ---- end looks5 group d (hints) -------------------------------------------------------------------------------

// ---- end looks5 group d (splitters) --------------------------------------------------------------

fn sash_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let s = mem.cast[*Sash](ctx)
    if s.v3 { ret sash_paint_v3(s, b, area) }
    // `across`: the sash lies along x (a bottom panel's), else along y.
    if s.across {
        try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(area.x, area.y + f32(i64((area.height - s.line_width) * 0.5)), area.width, s.line_width), brush: paint.Brush { Solid: s.line } } })
    } else {
        try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(area.x + f32(i64((area.width - s.line_width) * 0.5)), area.y, s.line_width, area.height), brush: paint.Brush { Solid: s.line } } })
    }
    if !(s.grip.alpha > 0.0) { ret ok }
    let cx = area.x + area.width * 0.5
    let cy = area.y + area.height * 0.5
    let (pb, pb_error) = geometry.path_builder(s.arena, 32usize, 64usize)
    if pb_error != ok { ret TooLarge }
    var builder = pb
    if s.across {
        try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(cx - 22.0, cy - 2.0, 44.0, 4.0), brush: paint.Brush { Solid: s.grip } } })
        try oval(&builder, cx - 22.0, cy, 2.0, 2.0)
        try oval(&builder, cx + 22.0, cy, 2.0, 2.0)
    } else {
        try scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.rect(cx - 2.0, cy - 22.0, 4.0, 44.0), brush: paint.Brush { Solid: s.grip } } })
        try oval(&builder, cx, cy - 22.0, 2.0, 2.0)
        try oval(&builder, cx, cy + 22.0, 2.0, 2.0)
    }
    ret scene.push(b, scene.Command { FillPath: scene.FillPath { path: geometry.finish(&builder), brush: paint.Brush { Solid: s.grip } } })
}

// v2 (D966, docs/ux/components/ResizablePane): the sash is an 8 hit strip (24 on
// touch) on the pane's inner edge, transparent, with a centred 1px
// `outline-variant` line; a 4 x 48 fully rounded grip on it shows `outline` on
// hover and keyboard focus (always, `on-surface-variant`, on touch) and, dragged,
// the line is 2px `primary` and the grip `primary`. As a dock layout's (`bar`),
// hover and drag draw a 4px `primary` bar and no grip. Arrows move it 8, 48 with
// Shift; Home and End go to the limits. A separator in the tree named `label`, its
// value the size ("240 px"), controlling the pane. (D1212) A double-click restores
// the size the pane was first built at, and Escape during a drag restores the
// size the drag began at and ignores the rest of that drag.
// (D1550) `pane_default` gives the double-click a size of the caller's.
fn pane_with_reserve(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, axis: ui_layout.Axis, size: f32, low: f32, high: f32, bound: widget.Key, reserve: f32, change: widget.Change[f32], content: widget.Node, bar: bool) -> (widget.Node, err) {
    let (made, made_error) = pane_with_collapse(a, key, t, label, axis, size, low, high, bound, reserve, change, content, bar, false)
    ret (made, made_error)
}

// (D1310, docs/ux/components/ResizablePane, collapsible) A resizable pane that
// snaps shut: dragged below half of `low` it reports 0; any nudge, drag past
// `low` or the sash's double-click opens it again.
// (D1333) While its sash is dragged it shows its size in a plain tooltip.
// (D1334) Over or dragging its sash, the pointer is the resize cursor.
// (D1356) Collapse and reopen ease the size over `duration-medium-2`
// (D1376: decelerating open, accelerating shut).
fn resizable_pane_with(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, axis: ui_layout.Axis, size: f32, low: f32, high: f32, change: widget.Change[f32], content: widget.Node, collapsible: bool) -> (widget.Node, err) {
    let (named, named_error) = mem.alloc[u8](a, label.len + 7usize)
    if named_error != ok { ret (zero, TooLarge) }
    var n = copy_text(named, "Resize ")
    n += copy_text(named[n..named.len], label)
    let (made, made_error) = pane_with_collapse(a, key, t, named[0usize..n], axis, size, low, high, 0u64, 0.0, change, content, false, collapsible)
    if made_error != ok { ret (zero, made_error) }
    // (D1333, docs/ux/components/ResizablePane, readout) While the sash is
    // dragged, a plain tooltip over the pane says its size ("240 px"): `body-small`
    // `inverse-on-surface` on `inverse-surface`, `radius-xs`, 4 by 8 in, 8 from the
    // top just past the sash (keyed `key + 1048577`), out of the tree.
    let (kept, has_kept) = sash_cell(t.runtime, key + 2u64, size)
    if !has_kept || !kept.dragging || kept.cancelled { ret (made, ok) }
    let (said, said_error) = mem.alloc[u8](a, 24usize)
    if said_error != ok { ret (zero, TooLarge) }
    var said_len = write_i64(said, i64(size))
    said_len += copy_text(said[said_len..24usize], " px")
    var small = text_options()
    small.role = .BodySmall
    small.wrap = .None
    let (words, words_error) = colored_text(a, 0u64, said[0usize..said_len], t, small, style.color(t.tokens, .InverseOnSurface))
    if words_error != ok { ret (zero, words_error) }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 5usize)
    if parts_error != ok { ret (zero, TooLarge) }
    parts[4usize] = words
    var tip = style.defaults()
    tip.background = paint.Brush { Solid: style.color(t.tokens, .InverseSurface) }
    tip.radius = t.tokens.radii.xs
    tip.padding = style.EdgeLengths { left: style.Length { Px: 8.0 }, top: style.Length { Px: 4.0 }, right: style.Length { Px: 8.0 }, bottom: style.Length { Px: 4.0 } }
    var quiet: widget.Semantics = zero
    quiet.hidden = true
    parts[3usize] = widget.semantics(0u64, quiet, style.defaults(), parts[4usize..5usize])
    parts[2usize] = widget.box(key + 1048577u64, tip, parts[3usize..4usize])
    var tip_x = size + 12.0
    var tip_y: f32 = 8.0
    if axis == .Vertical {
        tip_x = 8.0
        tip_y = size + 12.0
    }
    parts[1usize] = widget.positioned(0u64, tip_x, tip_y, style.defaults(), parts[2usize..3usize])
    parts[0usize] = made
    ret (widget.stack(0u64, style.defaults(), parts[0usize..2usize]), ok)
}

fn pane_with_collapse(a: *mem.Arena, key: widget.Key, t: *const Theme, label: str, axis: ui_layout.Axis, size: f32, low: f32, high: f32, bound: widget.Key, reserve: f32, change: widget.Change[f32], content: widget.Node, bar: bool, collapsible: bool) -> (widget.Node, err) {
    let vertical = axis == .Vertical
    let touch = t.tokens.metrics.control_height > t.tokens.sizes.control_sm
    var hit: f32 = 8.0
    if touch { hit = 24.0 }
    let cupertino = t.tokens.profile == .CupertinoLike
    // macOS: the thick divider is 9 across with a 1 px separator line in it.
    if cupertino { hit = 9.0 }
    // libadwaita's GtkPaned: a 1 px #dddddd handle between the panes (worker l3).
    let linux = t.tokens.profile == .Linux
    if linux { hit = 1.0 }
    let (handles, handles_error) = mem.alloc[Handle](a, 1usize)
    if handles_error != ok { ret (zero, TooLarge) }
    let (kept, has_kept) = sash_cell(t.runtime, key + 2u64, size)
    // (D1356, docs/ux/components/ResizablePane, collapse) A collapsible pane eases
    // shut from its last open size and open to its new one; drags stay direct.
    var shown = size
    if collapsible && has_kept {
        if size > 0.0 { kept.open = size }
        var open_goal: f32 = 0.0
        if size > 0.0 { open_goal = 1.0 }
        let opened = eased_emphasized(t, key + 2u64, key + 3u64, open_goal, false, t.tokens.durations.medium2)
        shown = kept.open * opened
    }
    handles[0usize] = Handle { runtime: t.runtime, pane: key, bound: bound, vertical: vertical, size: size, thick: hit, low: low, high: high, reserve: reserve, change: change, cell: kept, has_cell: has_kept, collapsible: collapsible, from: size }
    let (nudges, nudges_error) = mem.alloc[Nudge](a, 6usize)
    if nudges_error != ok { ret (zero, TooLarge) }
    nudges[0usize] = Nudge { handle: &handles[0usize], amount: -8.0 }
    nudges[1usize] = Nudge { handle: &handles[0usize], amount: 8.0 }
    nudges[2usize] = Nudge { handle: &handles[0usize], amount: -48.0 }
    nudges[3usize] = Nudge { handle: &handles[0usize], amount: 48.0 }
    nudges[4usize] = Nudge { handle: &handles[0usize], amount: -1.0e9 }
    nudges[5usize] = Nudge { handle: &handles[0usize], amount: 1.0e9 }
    let (parts, parts_error) = mem.alloc[widget.Node](a, 2usize)
    if parts_error != ok { ret (zero, TooLarge) }
    let (body, body_error) = mem.alloc[widget.Node](a, 1usize)
    if body_error != ok { ret (zero, TooLarge) }
    body[0usize] = content
    var pane_style = style.defaults()
    pane_style.overflow = .Clip
    var grip = style.defaults()
    let full = style.Length { Percent: 100.0 }
    // (D1598) With a pointer the sash stands 8 in the layout but takes input 24
    // across, WCAG 2.5.8's minimum: it reaches 8 over each side, its line centred.
    var reach: f32 = 0.0
    if !touch { reach = 8.0 }
    if cupertino { reach = 6.0 }
    if t.tokens.profile == .Windows { reach = 0.0 }
    if linux { reach = 8.0 }
    let over = style.Length { Px: 0.0 - reach }
    let flat = style.Length { Px: 0.0 }
    if vertical {
        pane_style.height = style.Length { Px: shown }
        pane_style.width = full
        grip.height = style.Length { Px: hit + 2.0 * reach }
        grip.width = full
        grip.margin = style.EdgeLengths { left: flat, top: over, right: flat, bottom: over }
    } else {
        pane_style.width = style.Length { Px: shown }
        pane_style.height = full
        grip.width = style.Length { Px: hit + 2.0 * reach }
        grip.height = full
        grip.margin = style.EdgeLengths { left: over, top: flat, right: over, bottom: flat }
    }
    parts[0usize] = widget.box(key + 1u64, pane_style, body[0usize..1usize])
    // The sash's look in its state.
    let state = control_state(t, key + 2u64, true, false)
    // (D1334) Over or dragging the sash, the resize cursor.
    if (state.hovered || state.pressed) && mem.address_of(t.runtime) != 0usize {
        var cursor_shape = 4u8
        if vertical { cursor_shape = 5u8 }
        widget.request_cursor(t.runtime, cursor_shape)
    }
    // (D1598) `outline`, not D966's `outline-variant`: the line is all that shows
    // the sash is there, and WCAG 1.4.11 asks 3:1 of it (`outline-variant` is 1.3-2).
    var sashes_line = style.color(t.tokens, .Outline)
    var line_width: f32 = 1.0
    var grip_color = paint.rgba(0.0, 0.0, 0.0, 0.0)
    if touch { grip_color = style.color(t.tokens, .OnSurfaceVariant) }
    if state.hovered || state.focus_visible { grip_color = style.color(t.tokens, .Outline) }
    if state.pressed {
        sashes_line = style.color(t.tokens, .Primary)
        line_width = 2.0
        grip_color = sashes_line
    }
    if cupertino {
        // The separator line; a dimple shows under the pointer; held or keyboard-focused the line takes the accent.
        sashes_line = style.cupertino_separator(t.tokens)
        if t.tokens.palette == .Dark { sashes_line = style.hex(0x48484Au32) }
        if !(t.tokens.palette == .Dark) { sashes_line = style.hex(0xD1D1D6u32) }
        line_width = 1.0
        grip_color = paint.rgba(0.0, 0.0, 0.0, 0.0)
        if state.hovered { grip_color = style.color(t.tokens, .TextMuted) }
        if state.pressed {
            sashes_line = style.color(t.tokens, .Primary)
            grip_color = style.color(t.tokens, .Primary)
        }
        if state.focus_visible && !state.pressed {
            sashes_line = style.color(t.tokens, .Primary)
            line_width = 2.0
        }
    }
    if linux {
        sashes_line = linux_rule(t)
        line_width = 1.0
        grip_color = paint.rgba(0.0, 0.0, 0.0, 0.0)
    }
    if bar {
        grip_color = paint.rgba(0.0, 0.0, 0.0, 0.0)
        if state.hovered || state.pressed {
            sashes_line = style.color(t.tokens, .Primary)
            line_width = 4.0
        }
    }
    let (sashes, sashes_error) = mem.alloc[Sash](a, 1usize)
    if sashes_error != ok { ret (zero, TooLarge) }
    sashes[0usize] = Sash { line: sashes_line, line_width: line_width, grip: grip_color, across: vertical, arena: a, v3: false, face: sashes_line, edge: sashes_line, dots: sashes_line, ink: sashes_line, hot_len: 0.0, hot_face: sashes_line, held: false }
    if t.tokens.profile == .Windows {
        // v3 (ref/windows/dialogs/search-filter-top at 100 %; the 150 % and main-window captures agree
        // with it to a tint): the strip is the dialog face, the hot zone a #A0A0A0 frame with #50A0DF
        // dots whose length follows one rule (see sash_paint_v3). Hover and press tints are guesses.
        let zone_edge = style.hex(10526880u32)
        let zone_dots = style.hex(5284063u32)
        let zone_len: f32 = 0.0
        let zone_face = style.color(t.tokens, .Background)
        // looks5 group d: a held strip is as at rest (ref/windows/states/splitter-pressed-filter is the rest crop).
        // (the strip under the pointer is as at rest too: ref/windows/states/hover-splitter-* are pixel for pixel the held and rest strips)
        sashes[0usize] = Sash { line: sashes_line, line_width: line_width, grip: paint.rgba(0.0, 0.0, 0.0, 0.0), across: vertical, arena: a, v3: true, face: style.color(t.tokens, .Background), edge: zone_edge, dots: zone_dots, ink: style.hex(1250067u32), hot_len: zone_len, hot_face: zone_face, held: state.pressed || state.hovered }
    }
    var paint_style = style.defaults()
    paint_style.width = full
    paint_style.height = full
    var none: []const widget.Node = zero
    let (drawn, drawn_error) = mem.alloc[widget.Node](a, 1usize)
    if drawn_error != ok { ret (zero, TooLarge) }
