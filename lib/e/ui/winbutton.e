// Which ring: 0 rest, 1 default (accent), 2 disabled.
type Ring = struct { kind: u32, face: u32, tint: u32 }

fn ring_rect(b: *scene.Builder, x: f32, y: f32, w: f32, h: f32, value: u32) -> err {
    ret scene.push(b, scene.Command { FillRect: scene.FillRect { rect: geometry.Rect { x: x, y: y, width: w, height: h }, brush: paint.Brush { Solid: style.hex(value & 0xFFFFFFu32) } } })
}

// One channel of a corner cell for another face: the cell is a blend of the ring colour `edge` and the captured face
// `baked`; the share of face it holds moves to the new face `face`.
// The ring line is always darker than the face, so a cell's share of face is (v - edge) / (baked - edge), clamped.
fn ring_channel(v: u32, baked: u32, edge: u32, face: u32) -> u32 {
    let span = i32(baked) - i32(edge)
    var near = i32(v) - i32(edge)
    if near < 0 { near = 0 }
    if near > span { near = span }
    var out = i32(v)
    if span > 0 { out = i32(v) + (near * (i32(face) - i32(baked)) * 2 + span) / (span * 2) }
    if out < 0 { out = 0 }
    if out > 255 { out = 255 }
    ret u32(out)
}

// A corner cell `value` (0xFFRRGGBB) re-faced from the captured `baked` face to `face` (0xRRGGBB); `edge` is the ring colour.
fn ring_pick(value: u32, baked: u32, edge: u32, face: u32) -> u32 {
    let vb = value % 256u32
    let bb = baked % 256u32
    let eb = edge % 256u32
    let fb = face % 256u32
    let blue = ring_channel(vb, bb, eb, fb)
    let vg = (value / 256u32) % 256u32
    let bg = (baked / 256u32) % 256u32
    let eg = (edge / 256u32) % 256u32
    let fg = (face / 256u32) % 256u32
    let green = ring_channel(vg, bg, eg, fg)
    let vr = (value / 65536u32) % 256u32
    let br = (baked / 65536u32) % 256u32
    let er = (edge / 65536u32) % 256u32
    let fr = (face / 65536u32) % 256u32
    let red = ring_channel(vr, br, er, fr)
    ret 4278190080u32 + red * 65536u32 + green * 256u32 + blue
}

fn ring_measure(ctx: *void, limits: ui_layout.Constraints) -> geometry.Size {
    ret geometry.Size { width: 0.0, height: 0.0 }
}

fn ring_cell(kind: u32, i: usize) -> u32 {
    if kind == 1u32 {
        let table = ring_default_corners()
        ret table[i]
    }
    if kind == 2u32 {
        let table = ring_disabled_corners()
        ret table[i]
    }
    let table = ring_normal_corners()
    ret table[i]
}

fn ring_edge(kind: u32, i: usize) -> u32 {
    if kind == 1u32 {
        let table = ring_default_edges()
        ret table[i]
    }
    if kind == 2u32 {
        let table = ring_disabled_edges()
        ret table[i]
    }
    let table = ring_normal_edges()
    ret table[i]
}

fn ring_baked(kind: u32) -> u32 {
    if kind == 1u32 { ret ring_default_face() }
    if kind == 2u32 { ret ring_disabled_face() }
    ret ring_normal_face()
}

// The colour of the ring line, to tell a corner cell's face share from its edge share.
fn ring_line(kind: u32) -> u32 {
    if kind == 1u32 { ret 0x0078D4u32 }
    if kind == 2u32 { ret 0xE9E9E9u32 }
    ret 0xD0D0D0u32
}

fn ring_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let d = mem.cast[*Ring](ctx)
    let w = f32(u32(area.width + 0.5))
    let h = f32(u32(area.height + 0.5))
    let x0 = area.x
    let y0 = area.y
    try ring_rect(b, x0 + 6.0, y0 + 1.0, w - 12.0, h - 2.0, d.face)
    try ring_rect(b, x0 + 1.0, y0 + 6.0, 5.0, h - 12.0, d.face)
    try ring_rect(b, x0 + w - 6.0, y0 + 6.0, 5.0, h - 12.0, d.face)
    try ring_rect(b, x0 + 6.0, y0, w - 12.0, 1.0, ring_edge(d.kind, 0usize))
    try ring_rect(b, x0 + 6.0, y0 + 1.0, w - 12.0, 1.0, ring_edge(d.kind, 1usize))
    // bottom: edge 2 is the row h - 2, edge 3 the row h - 1
    try ring_rect(b, x0 + 6.0, y0 + h - 2.0, w - 12.0, 1.0, ring_edge(d.kind, 2usize))
    try ring_rect(b, x0 + 6.0, y0 + h - 1.0, w - 12.0, 1.0, ring_edge(d.kind, 3usize))
    try ring_rect(b, x0, y0 + 6.0, 1.0, h - 12.0, ring_edge(d.kind, 4usize))
    try ring_rect(b, x0 + w - 1.0, y0 + 6.0, 1.0, h - 12.0, ring_edge(d.kind, 7usize))
    let baked = ring_baked(d.kind)
    let line = ring_line(d.kind)
    var c = 0usize
    while c < 4usize {
        var ox: f32 = 0.0
        var oy: f32 = 0.0
        if c == 1usize || c == 3usize { ox = w - 6.0 }
        if c >= 2usize { oy = h - 6.0 }
        var k = 0usize
        while k < 36usize {
            let cell = ring_cell(d.kind, c * 36usize + k)
            if cell != 0u32 {
                try ring_rect(b, x0 + ox + f32(k % 6usize), y0 + oy + f32(k / 6usize), 1.0, 1.0, ring_pick(cell, baked, line, d.face))
            }
            k += 1usize
        }
        c += 1usize
    }
    ret ok
}

// The ring, `width` x `height` (the visible box), over a face 0xRRGGBB; `kind` as in `Ring`. A node to put under a button's label.
fn ring_node(a: *mem.Arena, kind: u32, face: u32, width: f32, height: f32) -> (widget.Node, err) {
    let (rings, rings_error) = mem.alloc[Ring](a, 1usize)
    if rings_error != ok { ret (zero, rings_error) }
    rings[0usize] = Ring { kind: kind, face: face, tint: 0u32 }
    var s = style.defaults()
    s.width = style.Length { Px: width }
    s.height = style.Length { Px: height }
    var none: []const widget.Node = zero
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&rings[0usize]), measure: ring_measure, paint: ring_paint, state: widget.bytes_of[Ring](&rings[0usize]) } }, style: s, children: none }, ok)
}

// A caption with a mnemonic ("&Apply"): the caption without its '&' and the byte index of the underlined character
// (the length of the caption when there is none; "&&" is a literal '&' and not handled).
fn mnemonic(a: *mem.Arena, label: str) -> (str, usize, err) {
    var i = 0usize
    while i < label.len {
        if label[i] == 38u8 && i + 1usize < label.len {
            let (shown, shown_error) = strs.concat(a, label[0usize..i], label[i + 1usize..])
            if shown_error != ok { ret ("", 0usize, shown_error) }
            ret (shown, i, ok)
        }
        i += 1usize
    }
    ret (label, label.len, ok)
}
