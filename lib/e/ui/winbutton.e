// Which ring: 0 rest, 1 default (accent), 2 disabled, 3 pressed.
// `dx`, `dy` (looks5): the sub-pixel shift of v3's DPI-scaled forms, `dots` the focus rectangle drawn with the ring (0 none, 1
// normal, 2 pressed) when it is shifted too.
type Ring = struct { kind: u32, face: u32, tint: u32, dx: f32, dy: f32, dots: u32, dark: bool }

// `value` is 0xAARRGGBB; an alpha byte of 0 (a plain 0xRRGGBB) is opaque. looks5: the outer rows and corner cells of a
// ring carry the share of ring over the dialog face they sit on (v3's Filter dialog is #F9F9F9, the others #F0F0F0).
fn ring_rect(b: *scene.Builder, x: f32, y: f32, w: f32, h: f32, value: u32) -> err {
    var color = style.hex_raw(value & 0xFFFFFFu32)
    let alpha = value / 16777216u32
    if alpha != 0u32 && alpha < 255u32 { color.alpha = f32(alpha) / 255.0 }
    ret winpx.fill(b, x, y, w, h, color)
}

// One channel of a corner cell for another face: the cell is a blend of the ring colour `edge` and the captured face
// `baked`; the share of face it holds moves to the new face `face`.
// The ring line is always darker than the face, so a cell's share of face is (v - edge) / (baked - edge), clamped.
fn ring_channel(v: u32, baked: u32, edge: u32, face: u32) -> u32 {
    let span = i32(baked) - i32(edge)
    var near = i32(v) - i32(edge)
    if near < 0 { near = 0 }
    if near > span { near = span }
    var out = i32(v)
    if span > 0 { out = i32(v) + (near * (i32(face) - i32(baked)) * 2 + span) / (span * 2) }
    if out < 0 { out = 0 }
    if out > 255 { out = 255 }
    ret u32(out)
}

// A corner cell `value` (0xFFRRGGBB) re-faced from the captured `baked` face to `face` (0xRRGGBB); `edge` is the ring colour.
fn ring_pick(value: u32, baked: u32, edge: u32, face: u32) -> u32 {
    let vb = value % 256u32
    let bb = baked % 256u32
    let eb = edge % 256u32
    let fb = face % 256u32
    let blue = ring_channel(vb, bb, eb, fb)
    let vg = (value / 256u32) % 256u32
    let bg = (baked / 256u32) % 256u32
    let eg = (edge / 256u32) % 256u32
    let fg = (face / 256u32) % 256u32
    let green = ring_channel(vg, bg, eg, fg)
    let vr = (value / 65536u32) % 256u32
    let br = (baked / 65536u32) % 256u32
    let er = (edge / 65536u32) % 256u32
    let fr = (face / 65536u32) % 256u32
    let red = ring_channel(vr, br, er, fr)
    var alpha = value / 16777216u32
    if alpha == 0u32 { alpha = 255u32 }
    ret alpha * 16777216u32 + red * 65536u32 + green * 256u32 + blue
}

fn ring_measure(ctx: *void, limits: ui_layout.Constraints) -> geometry.Size {
    ret geometry.Size { width: 0.0, height: 0.0 }
}

fn ring_cell(kind: u32, i: usize) -> u32 {
    if kind == 3u32 {
        let table = ring_pressed_corners()
        ret table[i]
    }
    if kind == 1u32 {
        let table = ring_default_corners()
        ret table[i]
    }
    if kind == 2u32 {
        let table = ring_disabled_corners()
        ret table[i]
    }
    let table = ring_normal_corners()
    ret table[i]
}

fn ring_edge(kind: u32, i: usize) -> u32 {
    if kind == 3u32 {
        let table = ring_pressed_edges()
        ret table[i]
    }
    if kind == 1u32 {
        let table = ring_default_edges()
        ret table[i]
    }
    if kind == 2u32 {
        let table = ring_disabled_edges()
        ret table[i]
    }
    let table = ring_normal_edges()
    ret table[i]
}

fn ring_baked(kind: u32) -> u32 {
    if kind == 3u32 { ret ring_pressed_face() }
    if kind == 1u32 { ret ring_default_face() }
    if kind == 2u32 { ret ring_disabled_face() }
    ret ring_normal_face()
}

// The colour of the ring line, to tell a corner cell's face share from its edge share.
fn ring_line(kind: u32) -> u32 {
    if kind == 3u32 { ret 0x005499u32 }
    if kind == 1u32 { ret 0x0078D4u32 }
    if kind == 2u32 { ret 0xE9E9E9u32 }
    ret 0xD0D0D0u32
}

// The inner rows next to the face (edges 1 and 2: top1 and bottom1) are the ring line over the face it was captured on: the same
// re-facing as a corner cell, so a hovered button (face #E0EEF9) shows them over its own face.

// ---- the dark palette ---------------------------------------------------------------------------------------------------
// A dark ring is the same tables with the colours mapped (winpx.dark_argb, family 2): the ring line of a plain button becomes the
// #6B6B6B stroke, an accent line (default, focused) the dark accent #4CC2FF, the disabled line #3A3A3A; a corner cell or inner
// row keeps its share of line over face and re-faces to `d.face` (the dark face of the state).
fn ring_line_dark(kind: u32) -> u32 {
    if kind == 1u32 || kind == 3u32 { ret 0x4CC2FFu32 }
    if kind == 2u32 { ret 0x3A3A3Au32 }
    ret 0x6B6B6Bu32
}

// An outer-row or side value of the ring: the table's own, or in the dark palette its mapped colour (alpha kept).
fn ring_edge_c(d: *const Ring, which: usize) -> u32 {
    let v = ring_edge(d.kind, which)
    if !d.dark { ret v }
    ret winpx.dark_argb(v, 2u32, d.face)
}

// A corner cell or inner row `value` re-faced to the ring's face: the light share of line over face (read from the red channel, the
// channel that tells every line from its face), painted as the same share of the dark line over the dark face.
fn ring_cell_c(d: *const Ring, value: u32) -> u32 {
    if !d.dark { ret ring_pick(value, ring_baked(d.kind), ring_line(d.kind), d.face) }
    let line = ring_line(d.kind)
    let baked = ring_baked(d.kind)
    let vr = i32((value >> 16u32) & 255u32)
    let er = i32((line >> 16u32) & 255u32)
    let br = i32((baked >> 16u32) & 255u32)
    var share: i32 = 256
    if br != er { share = ((vr - er) * 256) / (br - er) }
    if share < 0 { share = 0 }
    if share > 256 { share = 256 }
    let edge = ring_line_dark(d.kind)
    var alpha = value / 16777216u32
    if alpha == 0u32 { alpha = 255u32 }
    let r = darkmix((edge >> 16u32) & 255u32, (d.face >> 16u32) & 255u32, share)
    let g = darkmix((edge >> 8u32) & 255u32, (d.face >> 8u32) & 255u32, share)
    let b = darkmix(edge & 255u32, d.face & 255u32, share)
    ret alpha * 16777216u32 + r * 65536u32 + g * 256u32 + b
}

fn darkmix(edge: u32, face: u32, share: i32) -> u32 {
    let v = i32(edge) + ((i32(face) - i32(edge)) * share + 128) / 256
    if v < 0 { ret 0u32 }
    if v > 255 { ret 255u32 }
    ret u32(v)
}

fn ring_edge_faced(d: *const Ring, which: usize) -> u32 {
    ret ring_cell_c(d, ring_edge(d.kind, which))
}

fn ring_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let d = mem.cast[*Ring](ctx)
    if d.dx != 0.0 || d.dy != 0.0 {
        ret ring_paint_shifted(d, b, area)
    }
    let w = f32(u32(area.width + 0.5))
    let h = f32(u32(area.height + 0.5))
    let x0 = area.x
    let y0 = area.y
    try ring_rect(b, x0 + 6.0, y0 + 1.0, w - 12.0, h - 2.0, d.face)
    try ring_rect(b, x0 + 1.0, y0 + 6.0, 5.0, h - 12.0, d.face)
    try ring_rect(b, x0 + w - 6.0, y0 + 6.0, 5.0, h - 12.0, d.face)
    try ring_rect(b, x0 + 6.0, y0, w - 12.0, 1.0, ring_edge_c(d, 0usize))
    try ring_rect(b, x0 + 6.0, y0 + 1.0, w - 12.0, 1.0, ring_edge_faced(d, 1usize))
    // bottom: edge 2 is the row h - 2, edge 3 the row h - 1
    try ring_rect(b, x0 + 6.0, y0 + h - 2.0, w - 12.0, 1.0, ring_edge_faced(d, 2usize))
    try ring_rect(b, x0 + 6.0, y0 + h - 1.0, w - 12.0, 1.0, ring_edge_c(d, 3usize))
    try ring_rect(b, x0, y0 + 6.0, 1.0, h - 12.0, ring_edge_c(d, 4usize))
    try ring_rect(b, x0 + w - 1.0, y0 + 6.0, 1.0, h - 12.0, ring_edge_c(d, 7usize))
    var c = 0usize
    while c < 4usize {
        var ox: f32 = 0.0
        var oy: f32 = 0.0
        if c == 1usize || c == 3usize { ox = w - 6.0 }
        if c >= 2usize { oy = h - 6.0 }
        var k = 0usize
        while k < 36usize {
            let cell = ring_cell(d.kind, c * 36usize + k)
            if cell != 0u32 {
                try ring_rect(b, x0 + ox + f32(k % 6usize), y0 + oy + f32(k / 6usize), 1.0, 1.0, ring_cell_c(d, cell))
            }
            k += 1usize
        }
        c += 1usize
    }
    ret ok
}

// ---- looks5: v3's DPI-scaled forms ------------------------------------------------------------------------------------------
// Options, Deck Properties, Deck Legality and About draw every button as the crisp one moved by a sub-pixel offset that grows
// with its position in the form (about x / 1440 across and y / 1000 down: measured, `fitshift.py` fits it per capture) with
// bilinear mixing, a blur at the ring, the focus rectangle and the caption. The renderer fills a rectangle on whole pixels, so
// the shifted ring is mixed here pixel by pixel and painted as runs of equal colour.

// The ring's pixel (x, y) of the visible box `w` x `h` as 0xAARRGGBB, 0 where it is not painted (outside the rounded corner).
fn ring_value(d: *const Ring, x: i32, y: i32, w: i32, h: i32) -> u32 {
    if x < 0 || y < 0 || x >= w || y >= h { ret 0u32 }
    let face = 0xFF000000u32 | d.face
    var corner: i32 = -1
    var cx: i32 = 0
    var cy: i32 = 0
    if x < 6 && y < 6 {
        corner = 0
        cx = x
        cy = y
    }
    if x >= w - 6 && y < 6 {
        corner = 1
        cx = x - (w - 6)
        cy = y
    }
    if x < 6 && y >= h - 6 {
        corner = 2
        cx = x
        cy = y - (h - 6)
    }
    if x >= w - 6 && y >= h - 6 {
        corner = 3
        cx = x - (w - 6)
        cy = y - (h - 6)
    }
    if corner >= 0 {
        let cell = ring_cell(d.kind, usize(corner * 36 + cy * 6 + cx))
        if cell == 0u32 { ret 0u32 }
        ret ring_cell_c(d, cell)
    }
    if y < 6 || y >= h - 6 {
        if y == 0 { ret ring_edge_c(d, 0usize) }
        if y == 1 { ret ring_edge_faced(d, 1usize) }
        if y == h - 2 { ret ring_edge_faced(d, 2usize) }
        if y == h - 1 { ret ring_edge_c(d, 3usize) }
        ret face
    }
    if x == 0 { ret ring_edge_c(d, 4usize) }
    if x == w - 1 { ret ring_edge_c(d, 7usize) }
    ret face
}

// The focus rectangle's pixel (x, y) of the visible box (`focus_paint` below as a query), 0 where there is none.
fn dot_value(d: *const Ring, x: i32, y: i32, w: i32, h: i32) -> u32 {
    if d.dots == 0u32 { ret 0u32 }
    var dark = 0xFF555555u32
    var light = 0xFFAAAAAAu32
    var dark_corner = 0xFF505355u32
    var light_corner = 0xFF9FA4A8u32
    if d.dots == 2u32 {
        dark = 0xFF665E57u32
        light = 0xFF99A1A8u32
        dark_corner = 0xFF615B55u32
        light_corner = 0xFF919BA4u32
    }
    if d.dark {
        dark = winpx.dark_argb(dark, 3u32, 0u32)
        light = winpx.dark_argb(light, 3u32, 0u32)
        dark_corner = winpx.dark_argb(dark_corner, 3u32, 0u32)
        light_corner = winpx.dark_argb(light_corner, 3u32, 0u32)
    }
    let rx = x + 1
    let ry = y + 1
    let rw = w + 2
    let rh = h + 1
    var out = 0u32
    let run = rx >= 6 && rx <= rw - 7 && (rx - 6) % 2 == 0
    if ry == 3 {
        if rx == 4 || rx == rw - 5 { out = dark_corner }
        if run { out = dark }
    }
    if ry == 4 {
        if rx == 3 { out = dark }
        if rx == 4 { out = light }
        if rx == rw - 5 { out = light }
        if rx == rw - 4 { out = dark }
        if run { out = light }
    }
    if ry == rh - 4 {
        if rx == 4 || rx == rw - 5 { out = dark }
        if run { out = dark }
    }
    if ry == rh - 3 {
        if rx == 4 || rx == rw - 5 { out = light_corner }
        if run { out = light }
    }
    if (rx == 3 || rx == rw - 4) && ry >= 5 && ry <= rh - 4 {
        out = light
        if ry % 2 == 0 { out = dark }
    }
    ret out
}

// The pixel as the button shows it: the focus rectangle over the ring.
fn raster_value(d: *const Ring, x: i32, y: i32, w: i32, h: i32) -> u32 {
    let dot = dot_value(d, x, y, w, h)
    if dot != 0u32 { ret dot }
    ret ring_value(d, x, y, w, h)
}

fn channel_of(v: u32, shift: u32) -> f32 {
    ret f32((v >> shift) & 255u32)
}

fn ring_paint_shifted(d: *const Ring, b: *scene.Builder, area: geometry.Rect) -> err {
    let w = i32(area.width + 0.5)
    let h = i32(area.height + 0.5)
    let fx = d.dx
    let fy = d.dy
    let w00 = (1.0 - fx) * (1.0 - fy)
    let w10 = fx * (1.0 - fy)
    let w01 = (1.0 - fx) * fy
    let w11 = fx * fy
    var oy: i32 = 0
    while oy <= h {
        var run_from: i32 = 0
        var run_value = 0u32
        var ox: i32 = 0
        while ox <= w + 1 {
            var value = 0u32
            if ox <= w {
                let s00 = raster_value(d, ox, oy, w, h)
                let s10 = raster_value(d, ox - 1, oy, w, h)
                let s01 = raster_value(d, ox, oy - 1, w, h)
                let s11 = raster_value(d, ox - 1, oy - 1, w, h)
                var alpha: f32 = 0.0
                var red: f32 = 0.0
                var green: f32 = 0.0
                var blue: f32 = 0.0
                var k = 0usize
                while k < 4usize {
                    var v = s00
                    var weight = w00
                    if k == 1usize {
                        v = s10
                        weight = w10
                    }
                    if k == 2usize {
                        v = s01
                        weight = w01
                    }
                    if k == 3usize {
                        v = s11
                        weight = w11
                    }
                    if v != 0u32 && weight > 0.0 {
                        var a = v / 16777216u32
                        if a == 0u32 { a = 255u32 }
                        let covered = weight * f32(a) / 255.0
                        alpha += covered
                        red += covered * channel_of(v, 16u32)
                        green += covered * channel_of(v, 8u32)
                        blue += covered * channel_of(v, 0u32)
                    }
                    k += 1usize
                }
                if alpha > 0.004 {
                    let q = u32(alpha * 255.0 + 0.5)
                    value = (q << 24u32) | (u32(red / alpha + 0.5) << 16u32) | (u32(green / alpha + 0.5) << 8u32) | u32(blue / alpha + 0.5)
                }
            }
            // a run of equal pixels ends here
            if ox > 0 && value != run_value {
                if run_value != 0u32 {
                    try ring_rect(b, area.x + f32(run_from), area.y + f32(oy), f32(ox - run_from), 1.0, run_value)
                }
                run_from = ox
            }
            run_value = value
            ox += 1
        }
        oy += 1
    }
    ret ok
}

// The ring, `width` x `height` (the visible box), over a face 0xRRGGBB; `kind` as in `Ring`. A node to put under a button's label.
fn ring_node(a: *mem.Arena, kind: u32, face: u32, width: f32, height: f32, dx: f32, dy: f32, dots: u32, dark: bool) -> (widget.Node, err) {
    let (rings, rings_error) = mem.alloc[Ring](a, 1usize)
    if rings_error != ok { ret (zero, rings_error) }
    rings[0usize] = Ring { kind: kind, face: face, tint: 0u32, dx: dx, dy: dy, dots: dots, dark: dark }
    var s = style.defaults()
    s.width = style.Length { Px: width }
    s.height = style.Length { Px: height }
    var none: []const widget.Node = zero
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&rings[0usize]), measure: ring_measure, paint: ring_paint, state: widget.bytes_of[Ring](&rings[0usize]) } }, style: s, children: none }, ok)
}

// A caption with a mnemonic ("&Apply"): the caption without its '&' and the byte index of the underlined character
// (the length of the caption when there is none; "&&" is a literal '&' and not handled).
fn mnemonic(a: *mem.Arena, label: str) -> (str, usize, err) {
    var i = 0usize
    while i < label.len {
        if label[i] == 38u8 && i + 1usize < label.len {
            let (shown, shown_error) = strs.concat(a, label[0usize..i], label[i + 1usize..])
            if shown_error != ok { ret ("", 0usize, shown_error) }
            ret (shown, i, ok)
        }
        i += 1usize
    }
    ret (label, label.len, ok)
}

// ---- looks4 group a: v3's dotted focus rectangle, pixel for pixel -------------------------------------------------
// Captured on the focused Invert of Filter Card Pool and on every pressed button (states/button-focused-filter-invert,
// button-pressed-sort-ok; both 75 x 23 rects). In rect coordinates (the box plus 1 above and left): two rows at y = 3
// and 4 (and h - 4 and h - 3) of dots every 2 px from x = 6 to w - 7, two columns at x = 3 and w - 4 that alternate
// per row, and four corner cells that are blends. The dot colours depend on the face: grey #555555 / #AAAAAA on the
// #FDFDFD face, #665E57 / #99A1A8 on the pressed face.
type FocusDots = struct { pressed: bool, dark: bool }

fn focus_measure(ctx: *void, limits: ui_layout.Constraints) -> geometry.Size {
    ret geometry.Size { width: 0.0, height: 0.0 }
}

// One pixel at rect coordinates (rx, ry).
fn focus_px(b: *scene.Builder, area: geometry.Rect, rx: f32, ry: f32, value: u32) -> err {
    ret ring_rect(b, area.x + rx - 1.0, area.y + ry - 1.0, 1.0, 1.0, value)
}

fn focus_paint(ctx: *void, b: *scene.Builder, area: geometry.Rect) -> err {
    let d = mem.cast[*FocusDots](ctx)
    let w = f32(u32(area.width + 0.5)) + 2.0
    let h = f32(u32(area.height + 0.5)) + 1.0
    var dark = 0x555555u32
    var light = 0xAAAAAAu32
    var dark_corner = 0x505355u32
    var light_corner = 0x9FA4A8u32
    if d.pressed {
        dark = 0x665E57u32
        light = 0x99A1A8u32
        dark_corner = 0x615B55u32
        light_corner = 0x919BA4u32
    }
    if d.dark {
        dark = winpx.dark_argb(dark, 3u32, 0u32)
        light = winpx.dark_argb(light, 3u32, 0u32)
        dark_corner = winpx.dark_argb(dark_corner, 3u32, 0u32)
        light_corner = winpx.dark_argb(light_corner, 3u32, 0u32)
    }
    // the top rows: x = 4 and w - 5 are the corner cells
    try focus_px(b, area, 4.0, 3.0, dark_corner)
    try focus_px(b, area, w - 5.0, 3.0, dark_corner)
    try focus_px(b, area, 3.0, 4.0, dark)
    try focus_px(b, area, 4.0, 4.0, light)
    try focus_px(b, area, w - 5.0, 4.0, light)
    try focus_px(b, area, w - 4.0, 4.0, dark)
    // the bottom rows
    try focus_px(b, area, 4.0, h - 4.0, dark)
    try focus_px(b, area, w - 5.0, h - 4.0, dark)
    try focus_px(b, area, 4.0, h - 3.0, light_corner)
    try focus_px(b, area, w - 5.0, h - 3.0, light_corner)
    var x: f32 = 6.0
    while x <= w - 7.0 {
        try focus_px(b, area, x, 3.0, dark)
        try focus_px(b, area, x, 4.0, light)
        try focus_px(b, area, x, h - 4.0, dark)
        try focus_px(b, area, x, h - 3.0, light)
        x += 2.0
    }
    // the side columns alternate per row: dark on even rows, light on odd ones
    var y: f32 = 5.0
    while y <= h - 4.0 {
        var v = light
        if (u32(y) % 2u32) == 0u32 { v = dark }
        try focus_px(b, area, 3.0, y, v)
        try focus_px(b, area, w - 4.0, y, v)
        y += 1.0
    }
    ret ok
}

// The focus rectangle over a ring box of `width` x `height` (the visible box); `pressed` for the pressed face.
fn focus_node(a: *mem.Arena, pressed: bool, width: f32, height: f32, dark: bool) -> (widget.Node, err) {
    let (dots, dots_error) = mem.alloc[FocusDots](a, 1usize)
    if dots_error != ok { ret (zero, dots_error) }
    dots[0usize] = FocusDots { pressed: pressed, dark: dark }
    var s = style.defaults()
    s.width = style.Length { Px: width }
    s.height = style.Length { Px: height }
    var none: []const widget.Node = zero
    ret (widget.Node { key: 0u64, kind: widget.Kind { Custom: widget.Custom { ctx: mem.cast[*void](&dots[0usize]), measure: focus_measure, paint: focus_paint, state: widget.bytes_of[FocusDots](&dots[0usize]) } }, style: s, children: none }, ok)
}
