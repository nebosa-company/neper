// The icon `name` (a function above, as text) as a `size` px square in `color`.
fn icon(a: *mem.Arena, svg: str, color: paint.Color, size: f32) -> (widget.Node, err) {
    let (node, node_error) = gl.svg_mark(a, svg, color, size, size)
    ret (node, node_error)
}

