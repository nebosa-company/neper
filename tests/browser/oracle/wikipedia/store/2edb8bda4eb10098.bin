<th id="mwEkA"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pop-up_ad" title="Pop-up ad" id="mwEkE">Pop-up</a> blocking<sup about="#mwt3252" class="mw-ref reference" id="cite_ref-popupblock_143-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"popupblock","group":"lower-alpha"},"body":{"html":""},"parts":[{"template":{"target":{"wt":"efn","href":"./Template:Efn"},"params":{"name":{"wt":"popupblock"}},"i":0}}]}'><a href="#cite_note-popupblock-143" data-mw-group="lower-alpha" id="mwEkI"><span class="mw-reflink-text" id="mwEkM"><span class="cite-bracket" id="mwEkQ">[</span>a<span class="cite-bracket" id="mwEkU">]</span></span></a></sup></th>
<th id="mwEkY">Auto-play blocking</th>
<th id="mwEkc"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Incremental_search" title="Incremental search" id="mwEkg">Incremental search</a></th>
