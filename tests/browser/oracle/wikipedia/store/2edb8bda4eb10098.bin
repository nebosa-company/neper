<span class="mw-empty-elt" about="#mwt1754" typeof="mw:Transclusion" id="mwCpw" data-mw='{"parts":[{"template":{"target":{"wt":"notelist","href":"./Template:Notelist"},"params":{"refs":{"wt":"{{efn|name=chromeppc|Google Chrome is not available for [[PowerPC]].}}\n{{efn|name=Dillodistro|Dillo is included in some [[Linux distribution]]s, i.e. [[Damn Small Linux]] and [[Feather Linux]].}}\n{{efn|name=edge-windows|Microsoft Edge is included in Windows 10 and 11 and also supported on Windows 7 and later.}}\n{{efn|name=FFdistro|Most [[Linux distribution]]s which include a [[graphical user interface]] include a version of Firefox or a rebranded version of Firefox such as [[GNU IceCat]].}}\n{{efn|name=icecat-bin|Binaries are not released.}}\n{{efn|name=ie4mac|Dropped 5.2.}}\n{{efn|name=ie4unix|Dropped 5.0. [[Internet Explorer for UNIX]] was available for [[Solaris (operating system)|Solaris]] and [[HP-UX]].}}\n{{efn|name=ios-opera|Opera Mini and Coast are available for iOS.}}\n{{efn|name=safari-windows|Dropped 5.1.7.}}"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1327269900" about="#mwt1755" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Reflist/styles.css"}}'/></span><div about="#mwt1754" id="mwCp0">
<div class="mw-references-wrap" typeof="mw:Extension/references" about="#mwt1774" id="mwCp4" data-mw='{"name":"references","attrs":{"group":"lower-alpha","responsive":"1"},"body":{"extsrc":"{{#parsoid\u0000fragment:293}}\n{{#parsoid\u0000fragment:294}}\n{{#parsoid\u0000fragment:295}}\n{{#parsoid\u0000fragment:296}}\n{{#parsoid\u0000fragment:297}}\n{{#parsoid\u0000fragment:298}}\n{{#parsoid\u0000fragment:299}}\n{{#parsoid\u0000fragment:300}}\n{{#parsoid\u0000fragment:301}}"}}'><ol class="mw-references references" data-mw-group="lower-alpha" id="mwCp8"><li about="#cite_note-chromeppc-106" id="cite_note-chromeppc-106" data-mw-footnote-number="a"><span class="mw-cite-backlink" id="mwCqA"><a href="#cite_ref-chromeppc_106-0" data-mw-group="lower-alpha" rel="mw:referencedBy" id="mwCqE"><span class="mw-linkback-text" id="mwCqI">↑</span></a></span> <span id="mw-reference-text-cite_note-chromeppc-106" class="mw-reference-text reference-text" data-mw-group="lower-alpha">Google Chrome is not available for <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/PowerPC" title="PowerPC" id="mwCqM">PowerPC</a>.</span></li>
<li about="#cite_note-Dillodistro-107" id="cite_note-Dillodistro-107" data-mw-footnote-number="b"><span class="mw-cite-backlink" id="mwCqQ"><a href="#cite_ref-Dillodistro_107-0" data-mw-group="lower-alpha" rel="mw:referencedBy" id="mwCqU"><span class="mw-linkback-text" id="mwCqY">↑</span></a></span> <span id="mw-reference-text-cite_note-Dillodistro-107" class="mw-reference-text reference-text" data-mw-group="lower-alpha">Dillo is included in some <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Linux_distribution" title="Linux distribution" id="mwCqc">Linux distributions</a>, i.e. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Damn_Small_Linux" title="Damn Small Linux" id="mwCqg">Damn Small Linux</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Feather_Linux" title="Feather Linux" class="mw-redirect" id="mwCqk">Feather Linux</a>.</span></li>
<li about="#cite_note-edge-windows-108" id="cite_note-edge-windows-108" data-mw-footnote-number="c"><span class="mw-cite-backlink" id="mwCqo"><a href="#cite_ref-edge-windows_108-0" data-mw-group="lower-alpha" rel="mw:referencedBy" id="mwCqs"><span class="mw-linkback-text" id="mwCqw">↑</span></a></span> <span id="mw-reference-text-cite_note-edge-windows-108" class="mw-reference-text reference-text" data-mw-group="lower-alpha">Microsoft Edge is included in Windows 10 and 11 and also supported on Windows 7 and later.</span></li>
<li about="#cite_note-FFdistro-109" id="cite_note-FFdistro-109" data-mw-footnote-number="d"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwCq0"><a href="#cite_ref-FFdistro_109-0" data-mw-group="lower-alpha" id="mwCq4"><span class="mw-linkback-text" id="mwCq8">1</span></a> <a href="#cite_ref-FFdistro_109-1" data-mw-group="lower-alpha" id="mwCrA"><span class="mw-linkback-text" id="mwCrE">2</span></a></span> <span id="mw-reference-text-cite_note-FFdistro-109" class="mw-reference-text reference-text" data-mw-group="lower-alpha">Most <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Linux_distribution" title="Linux distribution" id="mwCrI">Linux distributions</a> which include a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Graphical_user_interface" title="Graphical user interface" id="mwCrM">graphical user interface</a> include a version of Firefox or a rebranded version of Firefox such as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/GNU_IceCat" title="GNU IceCat" id="mwCrQ">GNU IceCat</a>.</span></li>
<li about="#cite_note-icecat-bin-111" id="cite_note-icecat-bin-111" data-mw-footnote-number="e"><span class="mw-cite-backlink" id="mwCrU"><a href="#cite_ref-icecat-bin_111-0" data-mw-group="lower-alpha" rel="mw:referencedBy" id="mwCrY"><span class="mw-linkback-text" id="mwCrc">↑</span></a></span> <span id="mw-reference-text-cite_note-icecat-bin-111" class="mw-reference-text reference-text" data-mw-group="lower-alpha">Binaries are not released.</span></li>
<li about="#cite_note-ie4mac-112" id="cite_note-ie4mac-112" data-mw-footnote-number="f"><span class="mw-cite-backlink" id="mwCrg"><a href="#cite_ref-ie4mac_112-0" data-mw-group="lower-alpha" rel="mw:referencedBy" id="mwCrk"><span class="mw-linkback-text" id="mwCro">↑</span></a></span> <span id="mw-reference-text-cite_note-ie4mac-112" class="mw-reference-text reference-text" data-mw-group="lower-alpha">Dropped 5.2.</span></li>
<li about="#cite_note-ie4unix-113" id="cite_note-ie4unix-113" data-mw-footnote-number="g"><span class="mw-cite-backlink" id="mwCrs"><a href="#cite_ref-ie4unix_113-0" data-mw-group="lower-alpha" rel="mw:referencedBy" id="mwCrw"><span class="mw-linkback-text" id="mwCr0">↑</span></a></span> <span id="mw-reference-text-cite_note-ie4unix-113" class="mw-reference-text reference-text" data-mw-group="lower-alpha">Dropped 5.0. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Explorer_for_UNIX" title="Internet Explorer for UNIX" id="mwCr4">Internet Explorer for UNIX</a> was available for <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Solaris_(operating_system)" title="Solaris (operating system)" class="mw-redirect" id="mwCr8">Solaris</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/HP-UX" title="HP-UX" id="mwCsA">HP-UX</a>.</span></li>
<li about="#cite_note-ios-opera-114" id="cite_note-ios-opera-114" data-mw-footnote-number="h"><span class="mw-cite-backlink" id="mwCsE"><a href="#cite_ref-ios-opera_114-0" data-mw-group="lower-alpha" rel="mw:referencedBy" id="mwCsI"><span class="mw-linkback-text" id="mwCsM">↑</span></a></span> <span id="mw-reference-text-cite_note-ios-opera-114" class="mw-reference-text reference-text" data-mw-group="lower-alpha">Opera Mini and Coast are available for iOS.</span></li>
<li about="#cite_note-safari-windows-115" id="cite_note-safari-windows-115" data-mw-footnote-number="i"><span class="mw-cite-backlink" id="mwCsQ"><a href="#cite_ref-safari-windows_115-0" data-mw-group="lower-alpha" rel="mw:referencedBy" id="mwCsU"><span class="mw-linkback-text" id="mwCsY">↑</span></a></span> <span id="mw-reference-text-cite_note-safari-windows-115" class="mw-reference-text reference-text" data-mw-group="lower-alpha">Dropped 5.1.7.</span></li>
</ol></div></div>

