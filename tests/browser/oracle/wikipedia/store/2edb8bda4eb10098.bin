<th id="mwGMY"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/XHTML" title="XHTML" id="mwGMc">XHTML</a><sup about="#mwt4450" class="mw-ref reference" id="cite_ref-XHTML_198-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"XHTML","group":"lower-alpha"},"body":{"html":""},"parts":[{"template":{"target":{"wt":"efn","href":"./Template:Efn"},"params":{"name":{"wt":"XHTML"}},"i":0}}]}'><a href="#cite_note-XHTML-198" data-mw-group="lower-alpha" id="mwGMg"><span class="mw-reflink-text" id="mwGMk"><span class="cite-bracket" id="mwGMo">[</span>d<span class="cite-bracket" id="mwGMs">]</span></span></a></sup></th>
