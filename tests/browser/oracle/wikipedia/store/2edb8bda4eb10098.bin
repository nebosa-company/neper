<th id="mwIis">Browser</th>
<th id="mwIiw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/HTTP/2" title="HTTP/2" id="mwIi0">HTTP/2</a></th>
<th id="mwIi4"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/File_Transfer_Protocol" title="File Transfer Protocol" id="mwIi8">FTP</a><sup about="#mwt6367" class="mw-ref reference" id="cite_ref-External2_231-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"External2","group":"lower-alpha"},"body":{"html":""},"parts":[{"template":{"target":{"wt":"efn","href":"./Template:Efn"},"params":{"name":{"wt":"External2"}},"i":0}}]}'><a href="#cite_note-External2-231" data-mw-group="lower-alpha" id="mwIjA"><span class="mw-reflink-text" id="mwIjE"><span class="cite-bracket" id="mwIjI">[</span>b<span class="cite-bracket" id="mwIjM">]</span></span></a></sup></th>
<th id="mwIjQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Network_News_Transfer_Protocol" title="Network News Transfer Protocol" id="mwIjU">NNTP</a><sup about="#mwt6370" class="mw-ref reference" id="cite_ref-External3_232-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"External3","group":"lower-alpha"},"body":{"html":""},"parts":[{"template":{"target":{"wt":"efn","href":"./Template:Efn"},"params":{"name":{"wt":"External3"}},"i":0}}]}'><a href="#cite_note-External3-232" data-mw-group="lower-alpha" id="mwIjY"><span class="mw-reflink-text" id="mwIjc"><span class="cite-bracket" id="mwIjg">[</span>c<span class="cite-bracket" id="mwIjk">]</span></span></a></sup></th>
<th id="mwIjo"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Transport_Layer_Security" title="Transport Layer Security" id="mwIjs">SSL</a></th>
<th id="mwIjw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Extended_Validation_Certificate" title="Extended Validation Certificate" id="mwIj0">EV</a></th>
<th id="mwIj4"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Relay_Chat" title="Internet Relay Chat" class="mw-redirect" id="mwIj8">IRC</a></th>
<th id="mwIkA"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Gopher_(protocol)" title="Gopher (protocol)" id="mwIkE">Gopher</a></th>
<th id="mwIkI"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internationalized_domain_name" title="Internationalized domain name" id="mwIkM">IDN</a></th>
<th id="mwIkQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Data_URI_scheme" title="Data URI scheme" id="mwIkU">data:URI</a></th>
<th id="mwIkY"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/BitTorrent_(protocol)" title="BitTorrent (protocol)" class="mw-redirect" id="mwIkc">BitTorrent</a></th>
<th id="mwIkg"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Protocol_version_6" title="Internet Protocol version 6" class="mw-redirect" id="mwIkk">IPv6</a></th>
<th id="mwIko"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Proxy_server" title="Proxy server" id="mwIks">Proxy</a></th>
