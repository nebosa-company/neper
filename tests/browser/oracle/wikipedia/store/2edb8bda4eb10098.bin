<th style="background: #F4E3FF; color: black; vertical-align: middle; text-align: left; font-weight: bolder; " scope="row" class="rh heading table-rh" about="#mwt2613" typeof="mw:ExpandedAttrs" id="mwDz4" data-mw='{"attribs":[[{"txt":"style","html":"&lt;span about=\"#mwt2612\" typeof=\"mw:Transclusion\" id=\"mwDz0\" data-mw=&apos;{\"parts\":[{\"template\":{\"target\":{\"wt\":\"rh2\",\"href\":\"./Template:Rh2\"},\"params\":{},\"i\":0}}]}&apos;>style=\"background: &lt;/span>&lt;span typeof=\"mw:Nowiki\" about=\"#mwt2612\">#F4E3FF&lt;/span>&lt;span about=\"#mwt2612\">; color: black; vertical-align: middle; text-align: left; font-weight: bolder; \" scope=\"row\" class=\"rh heading table-rh\"&lt;/span>"},{"html":""}]]}'><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/AOL_Explorer" title="AOL Explorer" id="mwDz8">AOL Explorer</a></th>
