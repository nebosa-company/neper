<th id="mwElE"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Full_text_search" title="Full text search" class="mw-redirect" id="mwElI">Full text search</a> of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Web_browsing_history" title="Web browsing history" id="mwElM">history</a></th>
<th id="mwElQ">Content-<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Modal_window" title="Modal window" id="mwElU">modal</a> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Dialog_box" title="Dialog box" id="mwElY">dialogs</a><sup about="#mwt3258" class="mw-ref reference" id="cite_ref-Mozilla_Developer_Network_–_Using_tab-modal_prompts_145-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Mozilla Developer Network – Using tab-modal prompts","group":"lower-alpha"},"body":{"html":""},"parts":[{"template":{"target":{"wt":"efn","href":"./Template:Efn"},"params":{"name":{"wt":"Mozilla Developer Network – Using tab-modal prompts"}},"i":0}}]}'><a href="#cite_note-Mozilla_Developer_Network_–_Using_tab-modal_prompts-145" data-mw-group="lower-alpha" id="mwElc"><span class="mw-reflink-text" id="mwElg"><span class="cite-bracket" id="mwElk">[</span>c<span class="cite-bracket" id="mwElo">]</span></span></a></sup></th>
