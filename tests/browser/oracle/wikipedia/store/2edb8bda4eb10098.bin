<table class="wikitable sortable sticky-header-multi" style="font-size: 85%; text-align: center; width: auto;" id="mwDg">
<tbody id="mwDw"><tr id="mwEA">
<th rowspan="2" id="mwEQ">Browser</th>
<th rowspan="2" id="mwEg">Developer</th>
<th rowspan="2" id="mwEw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Browser_engine" title="Browser engine" id="mwFA">Layout engine</a></th>
<th rowspan="2" id="mwFQ">Platform</th>
<th colspan="2" id="mwFg">Latest release</th>
<th rowspan="2" id="mwFw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Software_license" title="Software license" id="mwGA">License</a></th>
<th rowspan="2" id="mwGQ">Cost (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/United_States_dollar" title="United States dollar" id="mwGg">USD</a>)</th></tr>
