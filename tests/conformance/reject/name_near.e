use e.mem

// An unknown name within two edits of a local (D445, H09): the diagnostic names
// the nearest name in scope and offers it as a `maybe` fix over the token.
fn main(a: *mem.Arena, args: []str) -> err {
    let total: i32 = 3i32
    let doubled = totl + total
    if doubled != 6i32 { ret mem.Exhausted }
    ret ok
}
