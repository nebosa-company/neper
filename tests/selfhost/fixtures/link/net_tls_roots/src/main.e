fn one(a: *mem.Arena, text: str) -> x509.Certificate {
    let (found, parse_error) = x509.parse_pem(a, text)
    if parse_error != ok || found.len != 1usize { os.exit(90i32) }
    ret found[0usize]
}

// The server-identity check a TLS client runs, with `trust` as its configured roots.
fn verify(a: *mem.Arena, leaf: x509.Certificate, chain: []const x509.Certificate, trust: []const u8, server_name: str, now: i64) -> err {
    var no_alpn: [1]str = zero
    var no_entropy: [1]u8 = zero
    let config = tls.ClientConfig { server_name: server_name, trust_roots: trust, alpn: no_alpn[0usize..0usize], entropy: no_entropy[0usize..0usize], now: time.Timestamp { nanos: now } }
    let set = tls.CertificateSet { leaf: leaf, intermediates: chain }
    let mark = mem.mark(a)
    let result = tls.verify_certificate_set(a, set, config)
    mem.reset(a, mark)
    ret result
}

fn main(a: *mem.Arena) -> err {
    let now = 1780272000000000000i64
    let expired = 2840140800000000000i64

    // 1-3: the PEM bundle. Three distinct roots, one unparsable block skipped, one duplicate dropped; the private
    // key and the comments are not certificates.
    let (set, set_error) = roots.from_pem(a, bundle_text(), 1048576usize)
    if set_error != ok { os.exit(1i32) }
    if set.count != 3usize { os.exit(2i32) }
    if set.skipped != 1usize || set.duplicates != 1usize { os.exit(3i32) }
    let (counted, count_error) = roots.count_der(a, set.der)
    if count_error != ok || counted != 3usize { os.exit(4i32) }
    // Order is first appearance: P-256 root, RSA root, Ed25519 root.
    let r1 = one(a, r1_pem())
    let r2 = one(a, r2_pem())
    let r3 = one(a, r3_pem())
    if !roots.contains(set.der, r1.der) || !roots.contains(set.der, r2.der) || !roots.contains(set.der, r3.der) { os.exit(5i32) }
    let i1 = one(a, i1_pem())
    if roots.contains(set.der, i1.der) { os.exit(6i32) }
    if !str.eq(r1.subject, "O=Neper Tests, CN=Neper Test Root P256") && !str.eq(r1.subject, "CN=Neper Test Root P256, O=Neper Tests") { os.exit(7i32) }
    if set.der.len < r1.der.len + r2.der.len + r3.der.len { os.exit(8i32) }
    if !str.eq(set.der[0usize..r1.der.len], r1.der) { os.exit(9i32) }

    // 10-12: nothing usable, and the other constructors.
    let (nothing, nothing_error) = roots.from_pem(a, junk_text(), 1048576usize)
    if nothing_error != roots.Empty { os.exit(10i32) }
    let (small, small_error) = roots.from_pem(a, bundle_text(), 100usize)
    if small_error != roots.TooLarge { os.exit(11i32) }
    let (again, again_error) = roots.from_der(a, set.der)
    if again_error != ok || again.count != 3usize || again.duplicates != 0usize || !str.eq(again.der, set.der) { os.exit(12i32) }
    let (doubled, doubled_error) = roots.merge(a, set.der, set.der)
    if doubled_error != ok || doubled.count != 3usize || doubled.duplicates != 3usize || !str.eq(doubled.der, set.der) { os.exit(13i32) }
    let (only_r1, only_r1_error) = roots.from_pem(a, r1_pem(), 1048576usize)
    let (only_r2, only_r2_error) = roots.from_pem(a, r2_pem(), 1048576usize)
    if only_r1_error != ok || only_r2_error != ok || only_r1.count != 1usize { os.exit(14i32) }
    let (joined, joined_error) = roots.merge(a, only_r1.der, only_r2.der)
    if joined_error != ok || joined.count != 2usize || joined.duplicates != 0usize { os.exit(15i32) }
    let (bad_der, bad_der_error) = roots.from_der(a, "\x30\x03\x02\x01\x00")
    if bad_der_error != roots.Empty { os.exit(16i32) }

    // 20-29: chains through the real client check, trust_roots from the provisioned bundle.
    let l1 = one(a, l1_pem())
    let l2 = one(a, l2_pem())
    let l3 = one(a, l3_pem())
    var via_i1: [1]x509.Certificate = zero
    via_i1[0usize] = i1
    var none: [1]x509.Certificate = zero
    if verify(a, l1, via_i1[0usize..], set.der, "leaf1.example.test", now) != ok { os.exit(20i32) }
    if verify(a, l1, via_i1[0usize..], set.der, "a.wild.example.test", now) != ok { os.exit(21i32) }
    if verify(a, l2, none[0usize..0usize], set.der, "leaf2.example.test", now) != ok { os.exit(22i32) }
    if verify(a, l3, none[0usize..0usize], set.der, "leaf3.example.test", now) != ok { os.exit(23i32) }
    // A root missing from the bundle, a name that is not the leaf's, a window that has closed, a chain without its
    // intermediate: each is refused.
    let (without_r1, without_r1_error) = roots.merge(a, only_r2.der, set.der[r1.der.len..])
    if without_r1_error != ok || without_r1.count != 2usize { os.exit(24i32) }
    if verify(a, l1, via_i1[0usize..], without_r1.der, "leaf1.example.test", now) == ok { os.exit(25i32) }
    if verify(a, l2, none[0usize..0usize], set.der, "other.example.test", now) == ok { os.exit(26i32) }
    if verify(a, l2, none[0usize..0usize], set.der, "leaf2.example.test", expired) == ok { os.exit(27i32) }
    if verify(a, l1, none[0usize..0usize], set.der, "leaf1.example.test", now) == ok { os.exit(28i32) }
    // The host-provisioned roots and the bundled set are unions: a caller's own root added to a large set still
    // anchors its leaf.
    let (moz, moz_error) = mozilla.bundle(a)
    if moz_error != ok { os.exit(30i32) }
    let (plus_own, plus_own_error) = roots.merge(a, moz.der, only_r1.der)
    if plus_own_error != ok || plus_own.count != moz.count + 1usize { os.exit(31i32) }
    if verify(a, l1, via_i1[0usize..], plus_own.der, "leaf1.example.test", now) != ok { os.exit(32i32) }
    if verify(a, l1, via_i1[0usize..], moz.der, "leaf1.example.test", now) == ok { os.exit(33i32) }

    // 40-46: the bundled Mozilla set against certifi.
    if moz.count != 121usize || moz.skipped != 0usize || moz.duplicates != 0usize { os.exit(40i32) }
    if mozilla.certificate_count() != 121usize { os.exit(41i32) }
    var digest = hash.sha256(moz.der)
    var hex_buffer: [64]u8 = zero
    let (hex_text, hex_error) = bytes.hex_encode(hex_buffer[0usize..], digest[0usize..], false)
    if hex_error != ok || !str.eq(hex_text, "ba8c78cf0cd7f8d14f47d53f71f7aae6fc9e9c5a3761eece1282ebd965e78fd4") || !str.eq(hex_text, mozilla.sha256_hex()) { os.exit(42i32) }
    var walk = asn1.reader(moz.der, 16u16)
    var self_ok = 0usize
    var seen = 0usize
    while walk.off < walk.data.len {
        let (value, present, walk_error) = asn1.reader_next_err(&walk)
        if walk_error != ok || !present { os.exit(43i32) }
        let mark = mem.mark(a)
        let (c, parse_error) = x509.parse(a, value.encoded)
        if parse_error != ok { os.exit(44i32) }
        if str.eq(c.subject, c.issuer) && x509.verify_signature(a, c, c) == ok { self_ok += 1usize }
        mem.reset(a, mark)
        seen += 1usize
    }
    if seen != moz.count { os.exit(45i32) }
    if self_ok != 117usize { os.exit(46i32) }

    // 50-57: files and the host store. A PEM file round-trips through the filesystem; the host store is only
    // checked for structure (a CI container may hold none).
    let (dir, dir_error) = fs.temp_dir(a)
    if dir_error != ok { os.exit(50i32) }
    let (path, handle, temp_error) = fs.temp_file(a, dir, "roots-")
    if temp_error != ok { os.exit(51i32) }
    if os.close(handle) != ok { os.exit(52i32) }
    if fs.write_file(a, path, bundle_text()) != ok { os.exit(53i32) }
    let (from_file, from_file_error) = roots.from_pem_file(a, path, 1048576usize)
    if from_file_error != ok || from_file.count != 3usize || !str.eq(from_file.der, set.der) { os.exit(54i32) }
    var candidates: [3]str = zero
    candidates[0usize] = "no-such-file-for-roots.pem"
    candidates[1usize] = path
    candidates[2usize] = "never-reached.pem"
    let (picked, picked_error) = hoststore.from_paths(a, candidates[0usize..], 1048576usize)
    if picked_error != ok || picked.count != 3usize { os.exit(55i32) }
    let (missing, missing_error) = hoststore.from_paths(a, candidates[0usize..1usize], 1048576usize)
    if missing_error != hoststore.NotFound { os.exit(56i32) }
    if fs.remove_file(a, path) != ok { os.exit(57i32) }
    let (host, host_error) = hoststore.system_roots(a, 16777216usize)
    if host_error == ok {
        let (host_counted, host_count_error) = roots.count_der(a, host.der)
        if host_count_error != ok || host_counted != host.count || host.count == 0usize { os.exit(58i32) }
    } else if host_error != hoststore.NotFound {
        os.exit(59i32)
    }
    ret ok
}
