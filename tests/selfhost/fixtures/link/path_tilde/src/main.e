fn run_text(text: str) -> u8 {
    var start = 0usize
    var i = 0usize
    while i < text.len {
        if text[i] == 10u8 {
            let code = check_line(text[start..i])
            if code != 0u8 {
                let shown = io.print(text[start..i])
                if shown != ok { ret code }
                ret code
            }
            start = i + 1usize
        }
        i += 1usize
    }
    ret 0u8
}

fn run_vectors() -> u8 {
    let r_v_0 = run_text(v_0())
    if r_v_0 != 0u8 { ret r_v_0 }
    let r_v_1 = run_text(v_1())
    if r_v_1 != 0u8 { ret r_v_1 }
    let r_v_2 = run_text(v_2())
    if r_v_2 != 0u8 { ret r_v_2 }
    ret 0u8
}

fn main(a: *mem.Arena, args: []str) -> err {
    var tiny: [3]u8 = zero
    var none: [0]tilde.UserHome = zero
    let (_, small) = tilde.expand("~/abc", "/home", none[0usize..0usize], tiny[0usize..3usize])
    if small != tilde.TooSmall { os.exit(101i32) }
    let r = run_vectors()
    if r != 0u8 { os.exit(i32(r)) }
    try io.print("path tilde ok")
    ret ok
}
