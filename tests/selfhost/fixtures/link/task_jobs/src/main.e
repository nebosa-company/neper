// `e.task.jobs`: the retry/quarantine state machine, backoff curves, cron-driven recurring
// schedules and persistence. The region between the generated markers is the output of
// scripts/gen_task_jobs_test.py: backoff vectors from an independent statement of the formulas,
// fire sequences for six cron expressions from croniter (the Python library, with offsets,
// day-of-month/day-of-week OR, a leap day and a second-resolution schedule), and the misfire
// policy counts. The hand sections cover the lifecycle (2xx), persistence through an e.store
// memory store including a flipped byte (3xx), idempotent ticks after a reload (4xx) and the
// refusals and the bounded catch-up (5xx). Every check has its own exit code.
use e.os
use e.mem
use e.str
use e.store
use e.task.jobs as jobs

fn exp_policy() -> jobs.Policy {
    ret jobs.Policy { kind: jobs.BACKOFF_EXPONENTIAL, base_ms: 1000i64, cap_ms: 60000i64, jitter_ms: 0i64 }
}

fn new_queue(a: *mem.Arena, max_jobs: usize) -> (jobs.Queue, err) {
    let (q, init_error) = jobs.init(a, max_jobs, 4usize, exp_policy())
    ret (q, init_error)
}

fn misfire_case(a: *mem.Arena, policy: u8, grace_ms: i64, start: i64, now: i64, want: usize, want_next: i64) -> i32 {
    let (q0, init_error) = new_queue(a, 32usize)
    if init_error != ok { ret 1i32 }
    var q = q0
    if jobs.recurring_set(&q, "m", "0 */5 * * * *", 0i32, "tick", "", 1u32, policy, grace_ms, start) != ok { ret 2i32 }
    let (n, tick_error) = jobs.tick(&q, now)
    if tick_error != ok || n != want { ret 3i32 }
    if jobs.count(&q, jobs.STATE_ENQUEUED) != want { ret 4i32 }
    if q.recs[0].next_fire != want_next { ret 5i32 }
    // The same tick again changes nothing: the fires are keyed.
    let (again, again_error) = jobs.tick(&q, now)
    if again_error != ok || again != 0usize { ret 6i32 }
    ret 0i32
}

