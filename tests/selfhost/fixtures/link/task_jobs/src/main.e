// 2xx: delivery, retries, poison quarantine, leases, priority, delay and keys.
fn lifecycle(a: *mem.Arena) -> i32 {
    let (q0, init_error) = new_queue(a, 16usize)
    if init_error != ok { ret 200i32 }
    var q = q0
    let t0 = 1000000000000i64
    let (id, enqueue_error) = jobs.enqueue(&q, "email", "to=ada", t0, 0i64, 3u32, 0i32, "")
    if enqueue_error != ok || id != 1u64 { ret 201i32 }
    // fetch: attempts counts the delivery, the lease is held
    let (j1, found1, fetch_error1) = jobs.fetch(&q, t0, 30000i64)
    if fetch_error1 != ok || !found1 || j1.id != 1u64 || j1.attempts != 1u32 || j1.state != jobs.STATE_PROCESSING { ret 202i32 }
    if !str.eq(j1.name, "email") || !str.eq(j1.payload, "to=ada") { ret 203i32 }
    let (none, found_none, none_error) = jobs.fetch(&q, t0, 30000i64)
    if none_error != ok || found_none { ret 204i32 }
    // fail once: Retry, due 1000 ms later
    let (s1, fail_error1) = jobs.fail(&q, 1u64, t0, "boom 1")
    if fail_error1 != ok || s1 != jobs.STATE_RETRY { ret 205i32 }
    let (early, found_early, early_error) = jobs.fetch(&q, t0 + 999000000i64, 30000i64)
    if early_error != ok || found_early { ret 206i32 }
    let (j2, found2, fetch_error2) = jobs.fetch(&q, t0 + 1000000000i64, 30000i64)
    if fetch_error2 != ok || !found2 || j2.attempts != 2u32 || !str.eq(j2.last_error, "boom 1") { ret 207i32 }
    // second failure: due 2000 ms later
    let t2 = t0 + 1000000000i64
    let (s2, fail_error2) = jobs.fail(&q, 1u64, t2, "boom 2")
    if fail_error2 != ok || s2 != jobs.STATE_RETRY { ret 208i32 }
    let (j3, found3, fetch_error3) = jobs.fetch(&q, t2 + 2000000000i64, 30000i64)
    if fetch_error3 != ok || !found3 || j3.attempts != 3u32 { ret 209i32 }
    // third failure reaches max_attempts: quarantined, no more deliveries
    let t3 = t2 + 2000000000i64
    let (s3, fail_error3) = jobs.fail(&q, 1u64, t3, "boom 3")
    if fail_error3 != ok || s3 != jobs.STATE_DEAD { ret 210i32 }
    let (dead_job, dead_found) = jobs.get(&q, 1u64)
    if !dead_found || !str.eq(dead_job.last_error, "boom 3") || jobs.count(&q, jobs.STATE_DEAD) != 1usize { ret 211i32 }
    let (after, found_after, after_error) = jobs.fetch(&q, t3 + 1000000000000i64, 30000i64)
    if after_error != ok || found_after { ret 212i32 }
    // requeue gives it a fresh count
    if jobs.requeue(&q, 1u64, t3) != ok { ret 213i32 }
    let (j4, found4, fetch_error4) = jobs.fetch(&q, t3, 30000i64)
    if fetch_error4 != ok || !found4 || j4.attempts != 1u32 { ret 214i32 }
    if jobs.complete(&q, 1u64) != ok { ret 215i32 }
    if jobs.count(&q, jobs.STATE_SUCCEEDED) != 1usize { ret 216i32 }
    if jobs.complete(&q, 1u64) != jobs.NotProcessing { ret 217i32 }
    if jobs.complete(&q, 99u64) != jobs.NotFound { ret 218i32 }
    if jobs.requeue(&q, 1u64, t3) != jobs.Invalid { ret 219i32 }
    ret 0i32
}

fn leases(a: *mem.Arena) -> i32 {
    let (q0, init_error) = new_queue(a, 16usize)
    if init_error != ok { ret 220i32 }
    var q = q0
    let t0 = 5000000000i64
    let (id, enqueue_error) = jobs.enqueue(&q, "crashy", "", t0, 0i64, 2u32, 0i32, "")
    if enqueue_error != ok { ret 221i32 }
    let (j1, found1, e1) = jobs.fetch(&q, t0, 10000i64)
    if e1 != ok || !found1 { ret 222i32 }
    // the worker dies; before the lease ends nothing is due
    let (n1, found_n1, en1) = jobs.fetch(&q, t0 + 9999000000i64, 10000i64)
    if en1 != ok || found_n1 { ret 223i32 }
    // a heartbeat extends it
    if jobs.heartbeat(&q, id, t0 + 9000000000i64, 10000i64) != ok { ret 224i32 }
    let (n2, found_n2, en2) = jobs.fetch(&q, t0 + 18999000000i64, 10000i64)
    if en2 != ok || found_n2 { ret 225i32 }
    // the lease runs out: a failed attempt, retried 1000 ms later and delivered again
    let t_expire = t0 + 19000000000i64
    let (n3, found_n3, en3) = jobs.fetch(&q, t_expire, 10000i64)
    if en3 != ok || found_n3 { ret 226i32 }
    let (back, found_back) = jobs.get(&q, id)
    if !found_back || back.state != jobs.STATE_RETRY || !str.eq(back.last_error, "lease expired") { ret 227i32 }
    let (j2, found2, e2) = jobs.fetch(&q, t_expire + 1000000000i64, 10000i64)
    if e2 != ok || !found2 || j2.attempts != 2u32 { ret 228i32 }
    // a second lost lease reaches max_attempts: poison
    let (n4, found_n4, en4) = jobs.fetch(&q, t_expire + 1000000000i64 + 10000000000i64, 10000i64)
    if en4 != ok || found_n4 { ret 229i32 }
    if jobs.count(&q, jobs.STATE_DEAD) != 1usize { ret 230i32 }
    ret 0i32
}

fn ordering(a: *mem.Arena) -> i32 {
    let (q0, init_error) = new_queue(a, 16usize)
    if init_error != ok { ret 240i32 }
    var q = q0
    let t0 = 1000i64
    let (low, e1) = jobs.enqueue(&q, "low", "", t0, 0i64, 1u32, 0i32, "")
    let (high, e2) = jobs.enqueue(&q, "high", "", t0, 0i64, 1u32, 5i32, "")
    let (later, e3) = jobs.enqueue(&q, "later", "", t0, 5000i64, 1u32, 9i32, "")
    let (low2, e4) = jobs.enqueue(&q, "low2", "", t0, 0i64, 1u32, 0i32, "")
    if e1 != ok || e2 != ok || e3 != ok || e4 != ok { ret 241i32 }
    if jobs.count(&q, jobs.STATE_SCHEDULED) != 1usize || jobs.count(&q, jobs.STATE_ENQUEUED) != 3usize { ret 242i32 }
    let (f1, ok1, ef1) = jobs.fetch(&q, t0, 1000i64)
    if ef1 != ok || !ok1 || f1.id != high { ret 243i32 }
    let (f2, ok2, ef2) = jobs.fetch(&q, t0, 1000i64)
    if ef2 != ok || !ok2 || f2.id != low { ret 244i32 }
    let (f3, ok3, ef3) = jobs.fetch(&q, t0, 1000i64)
    if ef3 != ok || !ok3 || f3.id != low2 { ret 245i32 }
    let (f4, ok4, ef4) = jobs.fetch(&q, t0, 1000i64)
    if ef4 != ok || ok4 { ret 246i32 }
    let (f5, ok5, ef5) = jobs.fetch(&q, t0 + 5000000000i64, 1000i64)
    if ef5 != ok || !ok5 || f5.id != later { ret 247i32 }
    // a key makes enqueue idempotent while the job is alive, and free again once it is dead
    let (k1, ke1) = jobs.enqueue(&q, "uniq", "", t0, 0i64, 1u32, 0i32, "once")
    let (k2, ke2) = jobs.enqueue(&q, "uniq", "", t0, 0i64, 1u32, 0i32, "once")
    if ke1 != ok || ke2 != ok || k1 != k2 { ret 248i32 }
    let (f6, ok6, ef6) = jobs.fetch(&q, t0, 1000i64)
    if ef6 != ok || !ok6 || f6.id != k1 { ret 249i32 }
    let (st, fe) = jobs.fail(&q, k1, t0, "x")
    if fe != ok || st != jobs.STATE_DEAD { ret 250i32 }
    let (k3, ke3) = jobs.enqueue(&q, "uniq", "", t0, 0i64, 1u32, 0i32, "once")
    if ke3 != ok || k3 == k1 { ret 251i32 }
    ret 0i32
}

// 3xx: save, reload, corrupt.
fn persistence(a: *mem.Arena) -> i32 {
    let (m0, mem_error) = store.memory(a, 8usize)
    if mem_error != ok { ret 300i32 }
    var m = m0
    var s = store.memory_store(&m)
    let (q0, init_error) = jobs.init(a, 16usize, 4usize, jobs.Policy { kind: jobs.BACKOFF_HANGFIRE, base_ms: 0i64, cap_ms: 0i64, jitter_ms: 0i64 })
    if init_error != ok { ret 301i32 }
    var q = q0
    let start = 1760266800000000000i64
    let (a1, e1) = jobs.enqueue(&q, "alpha", "p\x00q", start, 0i64, 4u32, 2i32, "k-a")
    let (a2, e2) = jobs.enqueue(&q, "beta", "", start, 60000i64, 2u32, 0i32, "")
    if e1 != ok || e2 != ok { ret 302i32 }
    if jobs.recurring_set(&q, "nightly", "0 0 3 * * *", 60i32, "report", "daily", 3u32, jobs.MISFIRE_ONE, 5000i64, start) != ok { ret 303i32 }
    let (j, found, fetch_error) = jobs.fetch(&q, start, 30000i64)
    if fetch_error != ok || !found || j.id != a1 { ret 304i32 }
    if jobs.save(&q, &s, a, "queues/main") != ok { ret 305i32 }
    // "after a crash": a new queue from the blob holds the same jobs, the lease included
    let (r0, load_error) = jobs.load(a, &s, "queues/main", 16usize, 4usize)
    if load_error != ok { ret 306i32 }
    var r = r0
    if r.n != 2usize || r.nrec != 1usize || r.next_id != q.next_id { ret 307i32 }
    if r.policy.kind != jobs.BACKOFF_HANGFIRE { ret 308i32 }
    let (rj, rfound) = jobs.get(&r, a1)
    if !rfound || rj.state != jobs.STATE_PROCESSING || rj.attempts != 1u32 || rj.priority != 2i32 { ret 309i32 }
    if rj.locked_until != start + 30000000000i64 || !str.eq(rj.key, "k-a") { ret 310i32 }
    if rj.payload.len != 3usize || rj.payload[1] != 0u8 { ret 311i32 }
    if r.recs[0].next_fire != q.recs[0].next_fire || !str.eq(r.recs[0].expr, "0 0 3 * * *") || r.recs[0].misfire != jobs.MISFIRE_ONE { ret 312i32 }
    // the lost lease is redelivered after it ends (Hangfire curve, attempt 1: 15 s + 30 s * seed % 30...)
    let (n0, found_n0, en0) = jobs.fetch(&r, start + 29999000000i64, 30000i64)
    if en0 != ok || found_n0 { ret 313i32 }
    let (n1, found_n1, en1) = jobs.fetch(&r, start + 30000000000i64, 30000i64)
    if en1 != ok || found_n1 { ret 314i32 }
    let (retry, retry_found) = jobs.get(&r, a1)
    let want_delay = jobs.retry_delay(r.policy, 1u32, a1) * 1000000i64
    if !retry_found || retry.state != jobs.STATE_RETRY || retry.run_at != start + 30000000000i64 + want_delay { ret 315i32 }
    // a flipped byte, a truncated blob, a missing key
    let (blob, get_error) = store.get(&s, a, "queues/main", 0usize)
    if get_error != ok { ret 316i32 }
    var damaged = blob
    damaged[20] = damaged[20] ^ 255u8
    if store.put(&s, a, "queues/bad", damaged) != ok { ret 317i32 }
    let (b0, bad_error) = jobs.load(a, &s, "queues/bad", 16usize, 4usize)
    if bad_error != jobs.Corrupt { ret 318i32 }
    if store.put(&s, a, "queues/short", blob[0..10]) != ok { ret 319i32 }
    let (b1, short_error) = jobs.load(a, &s, "queues/short", 16usize, 4usize)
    if short_error != jobs.Corrupt { ret 320i32 }
    let (b2, missing_error) = jobs.load(a, &s, "queues/none", 16usize, 4usize)
    if missing_error == ok { ret 321i32 }
    // capacities smaller than what was saved are refused, not truncated
    let (b3, small_error) = jobs.load(a, &s, "queues/main", 1usize, 4usize)
    if small_error != jobs.Corrupt { ret 322i32 }
    ret 0i32
}

// 4xx: a tick repeated after a reload enqueues nothing twice; purge frees room.
fn replay(a: *mem.Arena) -> i32 {
    let (m0, mem_error) = store.memory(a, 4usize)
    if mem_error != ok { ret 400i32 }
    var m = m0
    var s = store.memory_store(&m)
    let (q0, init_error) = new_queue(a, 8usize)
    if init_error != ok { ret 401i32 }
    var q = q0
    let start = 1760266800000000000i64
    if jobs.recurring_set(&q, "every", "0 * * * * *", 0i32, "beat", "", 1u32, jobs.MISFIRE_ALL, 0i64, start) != ok { ret 402i32 }
    let now = start + 180000000000i64
    let (n, tick_error) = jobs.tick(&q, now)
    if tick_error != ok || n != 3usize { ret 403i32 }
    if jobs.save(&q, &s, a, "q") != ok { ret 404i32 }
    let (r0, load_error) = jobs.load(a, &s, "q", 8usize, 4usize)
    if load_error != ok { ret 405i32 }
    var r = r0
    let (again, again_error) = jobs.tick(&r, now)
    if again_error != ok || again != 0usize || r.n != 3usize { ret 406i32 }
    // a rebuilt schedule with the old next_fire would re-fire the same keys: still nothing new
    r.recs[0].next_fire = start + 60000000000i64
    let (again2, again2_error) = jobs.tick(&r, now)
    if again2_error != ok || again2 != 0usize || r.n != 3usize { ret 407i32 }
    // finished jobs are purged; capacity returns
    var i = 0usize
    while i < 3usize {
        let (job, found, fetch_error) = jobs.fetch(&r, now, 1000i64)
        if fetch_error != ok || !found { ret 408i32 }
        if jobs.complete(&r, job.id) != ok { ret 409i32 }
        i += 1usize
    }
    if jobs.purge(&r) != 3usize || r.n != 0usize { ret 410i32 }
    // removed schedules stop firing
    if jobs.recurring_remove(&r, "every") != ok { ret 411i32 }
    if jobs.recurring_remove(&r, "nope") != jobs.NotFound { ret 412i32 }
    let (none, none_error) = jobs.tick(&r, now + 600000000000i64)
    if none_error != ok || none != 0usize { ret 413i32 }
    ret 0i32
}

// 5xx: refusals, capacity, and the bounded catch-up.
fn limits(a: *mem.Arena) -> i32 {
    let (q0, init_error) = new_queue(a, 2usize)
    if init_error != ok { ret 500i32 }
    var q = q0
    let (i1, e1) = jobs.enqueue(&q, "a", "", 0i64, 0i64, 1u32, 0i32, "")
    let (i2, e2) = jobs.enqueue(&q, "b", "", 0i64, 0i64, 1u32, 0i32, "")
    if e1 != ok || e2 != ok { ret 501i32 }
    let (i3, e3) = jobs.enqueue(&q, "c", "", 0i64, 0i64, 1u32, 0i32, "")
    if e3 != jobs.Full { ret 502i32 }
    let (i4, e4) = jobs.enqueue(&q, "", "", 0i64, 0i64, 1u32, 0i32, "")
    if e4 != jobs.Invalid { ret 503i32 }
    let (i5, e5) = jobs.enqueue(&q, "d", "", 0i64, 0i64, 0u32, 0i32, "")
    if e5 != jobs.Invalid { ret 504i32 }
    let (i6, e6) = jobs.enqueue(&q, "d", "", 0i64, -1i64, 1u32, 0i32, "")
    if e6 != jobs.Invalid { ret 505i32 }
    if jobs.recurring_set(&q, "bad", "not a cron", 0i32, "n", "", 1u32, jobs.MISFIRE_SKIP, 0i64, 0i64) != jobs.Invalid { ret 506i32 }
    if jobs.recurring_set(&q, "bad", "0 0 0 * * *", 2000i32, "n", "", 1u32, jobs.MISFIRE_SKIP, 0i64, 0i64) != jobs.Invalid { ret 507i32 }
    if jobs.recurring_set(&q, "bad", "0 0 0 * * *", 0i32, "n", "", 1u32, 9u8, 0i64, 0i64) != jobs.Invalid { ret 508i32 }
    // 2000 missed one-second fires under MISFIRE_ALL: 1000 jobs, then the schedule resumes after now
    let (big0, big_error) = jobs.init(a, 1100usize, 1usize, exp_policy())
    if big_error != ok { ret 509i32 }
    var big = big0
    if jobs.recurring_set(&big, "s", "* * * * * *", 0i32, "sec", "", 1u32, jobs.MISFIRE_ALL, 0i64, gen_bounded_start()) != ok { ret 510i32 }
    let (n, tick_error) = jobs.tick(&big, gen_bounded_now())
    if tick_error != ok || n != gen_bounded_count() { ret 511i32 }
    if big.recs[0].next_fire != gen_bounded_next() { ret 512i32 }
    ret 0i32
}

fn main(a: *mem.Arena) -> err {
    var code = gen_backoff()
    if code == 0i32 { code = gen_cron_0(a) }
    if code == 0i32 { code = gen_cron_1(a) }
    if code == 0i32 { code = gen_cron_2(a) }
    if code == 0i32 { code = gen_cron_3(a) }
    if code == 0i32 { code = gen_cron_4(a) }
    if code == 0i32 { code = gen_cron_5(a) }
    if code == 0i32 { code = gen_misfire(a) }
    if code == 0i32 { code = lifecycle(a) }
    if code == 0i32 { code = leases(a) }
    if code == 0i32 { code = ordering(a) }
    if code == 0i32 { code = persistence(a) }
    if code == 0i32 { code = replay(a) }
    if code == 0i32 { code = limits(a) }
    if code != 0i32 {
        // a status of 256, 512, ... would read as success on Linux, where it is taken mod 256
        var shown = code
        if shown % 256i32 == 0i32 { shown += 1i32 }
        os.exit(shown)
    }
    ret ok
}
