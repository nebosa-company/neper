fn storage(a: *mem.Arena, n: usize, path_bytes: usize) -> (tree.Storage, err) {
    let (nodes, e1) = mem.alloc[tree.Node](a, n)
    if e1 != ok { ret (zero, e1) }
    let (kids, e2) = mem.alloc[u32](a, n)
    if e2 != ok { ret (zero, e2) }
    let (paths, e3) = mem.alloc[u8](a, path_bytes)
    if e3 != ok { ret (zero, e3) }
    let (slots, e4) = mem.alloc[u32](a, n * 2usize + 1usize)
    if e4 != ok { ret (zero, e4) }
    let (by_path, e5) = mem.alloc[u32](a, n)
    if e5 != ok { ret (zero, e5) }
    let (order, e6) = mem.alloc[u32](a, n)
    if e6 != ok { ret (zero, e6) }
    let (scratch, e7) = mem.alloc[u8](a, 512usize)
    if e7 != ok { ret (zero, e7) }
    ret (tree.Storage { nodes: nodes, kids: kids, paths: paths, slots: slots, by_path: by_path, order: order, scratch: scratch }, ok)
}

fn kind_letter(k: tree.NodeKind) -> str {
    if k == .Folder { ret "D" }
    if k == .File { ret "F" }
    if k == .Loading { ret "L" }
    ret "X"
}

// Every node depth first, siblings in order: "depth kind name".
fn dump(b: *str.Builder, t: *const tree.Tree) -> err {
    var stack_at: [32]usize = zero
    var stack_end: [32]usize = zero
    var depth = 0usize
    stack_at[0usize] = t.root_first
    stack_end[0usize] = t.root_first + t.root_count
    while true {
        if stack_at[depth] >= stack_end[depth] {
            if depth == 0usize { break }
            depth -= 1usize
            continue
        }
        let node = usize(t.kids[stack_at[depth]])
        stack_at[depth] += 1usize
        try str.push_u64(b, u64(depth))
        try str.push(b, " ")
        try str.push(b, kind_letter(t.nodes[node].kind))
        if t.nodes[node].lazy {
            try str.push(b, "?")
        }
        try str.push(b, " ")
        let name = tree.name_of(t, node)
        var k = 0usize
        while k < name.len {
            if name[k] == 0u8 || name[k] == 1u8 || name[k] == 2u8 {
                try str.push(b, "~")
            } else {
                try str.push(b, name[k..k + 1usize])
            }
            k += 1usize
        }
        try str.push(b, "\n")
        if t.nodes[node].child_count > 0usize && depth + 1usize < 32usize {
            depth += 1usize
            stack_at[depth] = t.nodes[node].first_child
            stack_end[depth] = t.nodes[node].first_child + t.nodes[node].child_count
        }
    }
    ret ok
}

fn listing(a: *mem.Arena, t: *const tree.Tree) -> (str, err) {
    let (b, b_error) = str.builder(a, 8192usize)
    if b_error != ok { ret ("", b_error) }
    var bb = b
    let e = dump(&bb, t)
    if e != ok { ret ("", e) }
    ret (str.done(&bb), ok)
}


// The root's children, one name per line.
fn names_listing(a: *mem.Arena, t: *const tree.Tree) -> (str, err) {
    let (b, b_error) = str.builder(a, 4096usize)
    if b_error != ok { ret ("", b_error) }
    var bb = b
    var i = 0usize
    while i < t.root_count {
        let node = usize(t.kids[t.root_first + i])
        try str.push(&bb, tree.name_of(t, node))
        try str.push(&bb, "\n")
        i += 1usize
    }
    ret (str.done(&bb), ok)
}

// Fills `out` with one file per line of `text`.
fn entries_of(text: str, out: []tree.Entry) -> usize {
    var n = 0usize
    var start = 0usize
    var i = 0usize
    while i < text.len {
        if text[i] == 10u8 {
            out[n] = tree.Entry { path: text[start..i], dir: false, state: .Ready }
            n += 1usize
            start = i + 1usize
        }
        i += 1usize
    }
    ret n
}

fn main(a: *mem.Arena, args: []str) -> err {
    var raw: [64]tree.Entry = zero
    var none: tree.Tree = zero
    var none_renames: [1]tree.Rename = zero
    var l = 0usize
    var plain_differs = 0usize
    while l < lang_count() {
        let mark = mem.mark(a)
        let (st, st_error) = storage(a, 80usize, 2048usize)
        if st_error != ok { os.exit(1) }
        let n = entries_of(lang_names(l), raw[0..])
        let (t, build_error) = tree.build(raw[0usize..n], none_renames[0usize..0usize], &none, tree.policy_language(lang_tag(l), true), st)
        if build_error != ok { os.exit(2) }
        let (got, got_error) = names_listing(a, &t)
        if got_error != ok { os.exit(3) }
        if !str.eq(got, lang_want(l)) {
            try io.print(lang_tag(l))
            try io.print("\n")
            try io.print(got)
            os.exit(10 + i32(l))
        }
        // The same names under the language-free Unicode order.
        let (st2, st2_error) = storage(a, 80usize, 2048usize)
        if st2_error != ok { os.exit(4) }
        let (u, u_error) = tree.build(raw[0usize..n], none_renames[0usize..0usize], &none, tree.policy_unicode(true), st2)
        if u_error != ok { os.exit(5) }
        let (u_text, u_text_error) = names_listing(a, &u)
        if u_text_error != ok { os.exit(6) }
        if !str.eq(u_text, got) { plain_differs += 1usize }
        mem.reset(a, mark)
        l += 1usize
    }
    // Every tailored language but German and Spanish-with-few-names changes the order of its own list.
    if plain_differs < 7usize { os.exit(30) }
    // A tag with no tailoring (and an unknown one) is the plain Unicode order.
    if tree.tailoring_of("en-US") != 0u8 || tree.tailoring_of("xx") != 0u8 || tree.tailoring_of("zh-Hant") != 0u8 { os.exit(31) }
    if tree.tailoring_of("SV") != 1u8 || tree.tailoring_of("nb_NO") != 2u8 || tree.tailoring_of("nob") != 2u8 || tree.tailoring_of("de-AT") != 3u8 { os.exit(32) }
    try io.print("tree adapter tailored ok")
    ret ok
}
