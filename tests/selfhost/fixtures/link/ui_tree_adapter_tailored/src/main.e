fn lang_tag(i: usize) -> str {
    if i == 0usize { ret "sv" }
    if i == 1usize { ret "fi" }
    if i == 2usize { ret "da" }
    if i == 3usize { ret "nb" }
    if i == 4usize { ret "es" }
    if i == 5usize { ret "pl" }
    if i == 6usize { ret "cs" }
    if i == 7usize { ret "tr" }
    if i == 8usize { ret "de" }
    ret ""
}

