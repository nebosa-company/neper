    if rp_p_0 != 0u8 { os.exit(i32(rp_p_0) + 20i32) }
    let rp_p_1 = run_peer_chunk(p_1())
    if rp_p_1 != 0u8 { os.exit(i32(rp_p_1) + 20i32) }
    let rp_p_2 = run_peer_chunk(p_2())
    if rp_p_2 != 0u8 { os.exit(i32(rp_p_2) + 20i32) }
    let pr = patterns()
    if pr != 0u32 { os.exit(i32(pr)) }
    try io.print("net sp ok")
    ret ok
}
