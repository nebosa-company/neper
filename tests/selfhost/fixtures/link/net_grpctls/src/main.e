// `e.net.grpctls` over loopback against the TLS 1.3 server of `e.net.tls` (credentials of the `net_tls` fixture): the
// dial offers ALPN `h2` only, a server that selects `h2` is reached and carries a ping and a pong, one that offers only
// `http/1.1` or none is refused, and so is a certificate that does not name the host. Generated by
// scripts/grpctls_vectors.py from the credentials in tests/selfhost/fixtures/link/net_tls; do not edit.
use e.io
use e.mem
use e.net
use e.net.grpctls as grpctls
use e.net.tls as tls
use e.os
use e.str
use e.thread
use e.time

fn same_bytes(left: []const u8, right: []const u8) -> bool {
    if left.len != right.len { ret false }
    var at = 0usize
    while at < left.len {
        if left[at] != right[at] { ret false }
        at += 1usize
    }
    ret true
}

type ServerJob = struct { listener: net.Socket, config: tls.ServerConfig, served: bool }

// Accept one connection, handshake, answer "ping" with "pong".
fn serve(job: *ServerJob) {
    var storage: [262144]u8 = zero
    var arena = mem.arena_from(storage[0..])
    let (accepted, peer, accept_error) = net.tcp_accept(job.listener)
    if accept_error != ok { ret }
    var connection = accepted
    defer let _ = net.close(connection)
    let source = net.reader(&connection)
    let sink = net.writer(&connection)
    let (secure0, create_error) = tls.server(&arena, source, sink, job.config)
    if create_error != ok { ret }
    var secure = secure0
    if tls.handshake(&secure) != ok { ret }
    var secure_source = tls.reader(&secure)
    var request: [4]u8 = zero
    if io.read_exact(&secure_source, request[0..]) != ok || !same_bytes(request[0..], "ping") { ret }
    var secure_sink = tls.writer(&secure)
    if io.write_all(&secure_sink, "pong") != ok { ret }
    if tls.close(&secure) != ok { ret }
    job.served = true
}

fn fill(out: []u8, base: usize) {
    var at = 0usize
    while at < out.len {
        out[at] = u8(base + at)
        at += 1usize
    }
}

