// One attempt: a server with `server_alpn`, a client dialling `server_name`; the client's error and whether the server
// served.
fn attempt(a: *mem.Arena, server_alpn: []const str, server_name: str, seed: usize, client_error: *err, served: *bool, selected: *str) -> err {
    var result: err = ok
    let (loopback, loopback_error) = net.parse_ip("127.0.0.1")
    if loopback_error != ok { ret loopback_error }
    var endpoint = net.Endpoint { address: loopback, port: 0u16 }
    let (listener, listen_error) = net.tcp_listen(endpoint, 1u32)
    if listen_error != ok { ret listen_error }
    var server_entropy: [64]u8 = zero
    var client_entropy: [64]u8 = zero
    fill(server_entropy[0..], seed)
    fill(client_entropy[0..], seed + 100usize)
    let config = tls.ServerConfig { certificate_chain: credentials_leaf(), private_key: credentials_key(), alpn: server_alpn, entropy: server_entropy[0..] }
    var job = ServerJob { listener: listener, config: config, served: false }
    let (bound, bound_error) = os.socket_local_address(job.listener)
    if bound_error != ok {
        let closed = net.close(job.listener)
        ret bound_error
    }
    endpoint.port = bound.port
    let (handle, spawn_error) = thread.spawn[ServerJob](serve, &job, 8388608usize)
    if spawn_error != ok {
        let closed = net.close(job.listener)
        ret spawn_error
    }
    var channel: grpctls.Channel = zero
    let dial_error = grpctls.dial(&channel, a, endpoint, server_name, credentials_mid(), client_entropy[0..], time.Timestamp { nanos: 1780272000000000000i64 })
    *client_error = dial_error
    if dial_error == ok {
        var sink = grpctls.writer(&channel)
        var source = grpctls.reader(&channel)
        var reply: [4]u8 = zero
        if io.write_all(&sink, "ping") != ok || io.read_exact(&source, reply[0..]) != ok || !same_bytes(reply[0..], "pong") { *client_error = grpctls.NoH2 }
        *selected = "h2"
        let closed = grpctls.close(&channel)
        let closed_again = grpctls.close(&channel)
        if closed_again != ok { *client_error = closed_again }
    }
    let join_error = thread.join(handle)
    *served = job.served
    let closed_listener = net.close(job.listener)
    if join_error != ok { result = join_error }
    if result == ok { result = closed_listener }
    ret result
}

fn main(a: *mem.Arena, args: []str) -> err {
    var both: [2]str = [2]str{ "h2", "http/1.1" }
    var only_http: [1]str = [1]str{ "http/1.1" }
    var none: [0]str = zero
    var failure: err = ok
    var served = false
    var selected = ""
    // a server that selects h2
    let e1 = attempt(a, both[0..], "example.com", 7usize, &failure, &served, &selected)
    if e1 != ok || failure != ok || !served || !str.eq(selected, "h2") { os.exit(1) }
    // a server that offers only http/1.1
    selected = ""
    failure = ok
    served = false
    let e2 = attempt(a, only_http[0..], "example.com", 31usize, &failure, &served, &selected)
    if e2 != ok || failure == ok || served { os.exit(2) }
    // a server that does no ALPN at all
    failure = ok
    served = false
    let e3 = attempt(a, none[0..], "example.com", 53usize, &failure, &served, &selected)
    if e3 != ok || failure == ok || served { os.exit(3) }
    // a certificate that does not name the host
    failure = ok
    served = false
    let e4 = attempt(a, both[0..], "other.example", 71usize, &failure, &served, &selected)
    if e4 != ok || failure == ok || served { os.exit(4) }
    try io.print("net grpctls ok")
    ret ok
}
