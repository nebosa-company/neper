fn main(a: *mem.Arena, args: []str) -> err {
    if winzones.windows_zone_count() != 139usize { os.exit(101i32) }
    if winzones.iana_name_count() != 586usize { os.exit(102i32) }
    if winzones.territory_row_count() != 227usize { os.exit(103i32) }
    let r = run_vectors()
    if r != 0u8 { os.exit(i32(r)) }
    try io.print("tz windows ok")
    ret ok
}
