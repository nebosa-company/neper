fn error_name(e: err) -> str {
    if e == gzip.Invalid { ret "gzip.Invalid" }
    if e == gzip.Checksum { ret "gzip.Checksum" }
    if e == zlib.Invalid { ret "zlib.Invalid" }
    if e == zlib.Checksum { ret "zlib.Checksum" }
