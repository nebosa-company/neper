    if !expect_bad(f_code3_cbr_bad()) { os.exit(9i32) }
    // 10: framing, code3_vbr
    if !expect_frames(f_code3_vbr(), 3usize, 10usize, 30usize) { os.exit(10i32) }
    // 11: framing, code3_vbr_pad
    if !expect_frames(f_code3_vbr_pad(), 3usize, 10usize, 30usize) { os.exit(11i32) }
    // 12: framing, code3_pad255
    if !expect_frames(f_code3_pad255(), 2usize, 20usize, 20usize) { os.exit(12i32) }
    // 13: framing, code3_zero
    if !expect_bad(f_code3_zero()) { os.exit(13i32) }
    // 14: framing, code3_49
    if !expect_bad(f_code3_49()) { os.exit(14i32) }
    // 15: framing, code3_long
    if !expect_bad(f_code3_long()) { os.exit(15i32) }
    // 16: framing, code3_pad_past
    if !expect_bad(f_code3_pad_past()) { os.exit(16i32) }
    // 17: framing, code0_big
    if !expect_bad(f_code0_big()) { os.exit(17i32) }
    // 18: framing, empty
    if !expect_bad(f_empty()) { os.exit(18i32) }
    // 19: packet_samples
    let (ns, nse) = opus.packet_samples(f_code3_cbr(), 48000u32)
    if nse != ok || ns != 4usize * 960usize { os.exit(19i32) }
    let (ns2, nse2) = opus.packet_samples(f_code2(), 16000u32)
    if nse2 != ok || ns2 != 2usize * 320usize { os.exit(20i32) }
    // 21: the scripted range-coder symbol sequence, section 4.1
    var r = opus.range_init(rc_data())
    let kinds = rc_kind()
    let pa = rc_a()
    let pb = rc_b()
    let pv = rc_val()
    let pt = rc_tell()
    let pf = rc_frac()
    i = 0usize
    while i < 48usize {
        let kind = kinds[i]
        let av = u32(le16(pa, 2usize * i))
        let bv = i32(le16(pb, 2usize * i))
        var got = 0i32
        if kind == 0u8 {
            got = i32(opus.range_decode_bit_logp(&r, av))
        } else if kind == 1u8 {
            got = i32(opus.range_decode_icdf(&r, "\x19\x17\x02\x00", av))
        } else if kind == 2u8 {
            got = i32(opus.range_decode_raw_bits(&r, av))
        } else if kind == 3u8 {
            got = i32(opus.range_decode_uint(&r, av))
        } else if kind == 4u8 {
            let fm = opus.range_decode(&r, av)
            opus.range_update(&r, fm, fm + 1u32, av)
            got = i32(fm)
        } else {
            got = opus.laplace_decode(&r, i32(av), bv)
        }
        if got != le32(pv, 4usize * i) { os.exit(21i32) }
        if opus.range_tell(&r) != le32(pt, 4usize * i) { os.exit(22i32) }
        if opus.range_tell_frac(&r) != le32(pf, 4usize * i) { os.exit(23i32) }
        i += 1usize
    }
    // 24..: CELT decodes against libopus
    var worst = 0i64
    let e_1ch_2p5 = celt_check(a, p_1ch_2p5_0(), p_1ch_2p5_1(), p_1ch_2p5_2(), ref_1ch_2p5(), 1usize, 120usize)
    try report("1ch_2p5", e_1ch_2p5)
    if e_1ch_2p5 < 0i64 || e_1ch_2p5 > 30000i64 { os.exit(24i32) }
    if e_1ch_2p5 > worst { worst = e_1ch_2p5 }
    let e_1ch_5 = celt_check(a, p_1ch_5_0(), p_1ch_5_1(), p_1ch_5_2(), ref_1ch_5(), 1usize, 240usize)
    try report("1ch_5", e_1ch_5)
    if e_1ch_5 < 0i64 || e_1ch_5 > 30000i64 { os.exit(25i32) }
    if e_1ch_5 > worst { worst = e_1ch_5 }
    let e_1ch_10 = celt_check(a, p_1ch_10_0(), p_1ch_10_1(), p_1ch_10_2(), ref_1ch_10(), 1usize, 480usize)
    try report("1ch_10", e_1ch_10)
    if e_1ch_10 < 0i64 || e_1ch_10 > 30000i64 { os.exit(26i32) }
    if e_1ch_10 > worst { worst = e_1ch_10 }
    let e_1ch_20 = celt_check(a, p_1ch_20_0(), p_1ch_20_1(), p_1ch_20_2(), ref_1ch_20(), 1usize, 960usize)
    try report("1ch_20", e_1ch_20)
    if e_1ch_20 < 0i64 || e_1ch_20 > 30000i64 { os.exit(27i32) }
    if e_1ch_20 > worst { worst = e_1ch_20 }
    let e_2ch_2p5 = celt_check(a, p_2ch_2p5_0(), p_2ch_2p5_1(), p_2ch_2p5_2(), ref_2ch_2p5(), 2usize, 120usize)
    try report("2ch_2p5", e_2ch_2p5)
    if e_2ch_2p5 < 0i64 || e_2ch_2p5 > 30000i64 { os.exit(28i32) }
    if e_2ch_2p5 > worst { worst = e_2ch_2p5 }
    let e_2ch_5 = celt_check(a, p_2ch_5_0(), p_2ch_5_1(), p_2ch_5_2(), ref_2ch_5(), 2usize, 240usize)
    try report("2ch_5", e_2ch_5)
    if e_2ch_5 < 0i64 || e_2ch_5 > 30000i64 { os.exit(29i32) }
    if e_2ch_5 > worst { worst = e_2ch_5 }
    let e_2ch_10 = celt_check(a, p_2ch_10_0(), p_2ch_10_1(), p_2ch_10_2(), ref_2ch_10(), 2usize, 480usize)
    try report("2ch_10", e_2ch_10)
    if e_2ch_10 < 0i64 || e_2ch_10 > 30000i64 { os.exit(30i32) }
    if e_2ch_10 > worst { worst = e_2ch_10 }
    let e_2ch_20 = celt_check(a, p_2ch_20_0(), p_2ch_20_1(), p_2ch_20_2(), ref_2ch_20(), 2usize, 960usize)
    try report("2ch_20", e_2ch_20)
    if e_2ch_20 < 0i64 || e_2ch_20 > 30000i64 { os.exit(31i32) }
    if e_2ch_20 > worst { worst = e_2ch_20 }
    // 32: the same stereo stream decoded down to one channel
    let e_down = celt_check(a, p_2ch_20_0(), p_2ch_20_1(), p_2ch_20_2(), ref_down_20(), 1usize, 960usize)
    if e_down < 0i64 || e_down > 30000i64 { os.exit(32i32) }
    try report("down 20ms", e_down)
    // 33: a silence packet decodes to silence
    let (dq, dqe) = opus.decoder(a, 1usize)
    if dqe != ok { os.exit(33i32) }
    var dsil = dq
    let (sout, soe) = mem.alloc[f32](a, 960usize)
    if soe != ok { os.exit(33i32) }
    let (sn, se) = opus.decode(&dsil, p_silence(), 48000u32, sout)
    if se != ok || sn != 960usize { os.exit(33i32) }
    i = 0usize
    while i < 960usize {
        var v = f64(sout[i])
        if v < 0.0 { v = 0.0 - v }
        if v > 0.00001 { os.exit(33i32) }
        i += 1usize
    }
    // 34: a hybrid packet needs 48 kHz, and a rate Opus never answers is refused
    let (un1, ue1) = opus.decode(&dsil, p_hybrid(), 16000u32, sout)
    if ue1 != opus.Unsupported || un1 != 0usize { os.exit(34i32) }
    let (un2, ue2) = opus.decode(&dsil, p_silk(), 44100u32, sout)
    if ue2 != opus.Unsupported || un2 != 0usize { os.exit(34i32) }
    // 35: the CELT layer still has no decimator, so CELT-only is 48 kHz only
    let (un3, ue3) = opus.decode(&dsil, p_1ch_20_0(), 16000u32, sout)
    if ue3 != opus.Unsupported { os.exit(35i32) }
    // 36..: the SILK-only and hybrid paths against libopus
    let e_nb10m8 = lp_check(a, nb10m8_p0(), nb10m8_p1(), nb10m8_p2(), nb10m8_r(), 1usize, 8000u32, 80usize, 3usize)
    try report("nb 10ms mono 8k", e_nb10m8)
    if e_nb10m8 < 0i64 || e_nb10m8 > 0i64 { os.exit(36i32) }
    let e_nb20m12 = lp_check(a, nb20m12_p0(), nb20m12_p1(), nb20m12_p2(), nb20m12_r(), 1usize, 12000u32, 240usize, 3usize)
    try report("nb 20ms mono 12k", e_nb20m12)
    if e_nb20m12 < 0i64 || e_nb20m12 > 0i64 { os.exit(37i32) }
    let e_nb10s16 = lp_check(a, nb10s16_p0(), nb10s16_p1(), nb10s16_p2(), nb10s16_r(), 2usize, 16000u32, 160usize, 3usize)
    try report("nb 10ms stereo 16k", e_nb10s16)
    if e_nb10s16 < 0i64 || e_nb10s16 > 0i64 { os.exit(38i32) }
    let e_nb20s8 = lp_check(a, nb20s8_p0(), nb20s8_p1(), nb20s8_p2(), nb20s8_r(), 2usize, 8000u32, 160usize, 3usize)
    try report("nb 20ms stereo 8k", e_nb20s8)
    if e_nb20s8 < 0i64 || e_nb20s8 > 0i64 { os.exit(39i32) }
    let e_nb20m24 = lp_check(a, nb20m24_p0(), nb20m24_p1(), nb20m24_p2(), nb20m24_r(), 1usize, 24000u32, 480usize, 3usize)
    try report("nb 20ms mono 24k", e_nb20m24)
    if e_nb20m24 < 0i64 || e_nb20m24 > 0i64 { os.exit(40i32) }
    let e_nb10m48 = lp_check(a, nb10m48_p0(), nb10m48_p1(), nb10m48_p2(), nb10m48_r(), 1usize, 48000u32, 480usize, 3usize)
    try report("nb 10ms mono 48k", e_nb10m48)
    if e_nb10m48 < 0i64 || e_nb10m48 > 0i64 { os.exit(41i32) }
    let e_mb20m8 = lp_check(a, mb20m8_p0(), mb20m8_p1(), mb20m8_p2(), mb20m8_r(), 1usize, 8000u32, 160usize, 3usize)
    try report("mb 20ms mono 8k", e_mb20m8)
    if e_mb20m8 < 0i64 || e_mb20m8 > 0i64 { os.exit(42i32) }
    let e_mb20s12 = lp_check(a, mb20s12_p0(), mb20s12_p1(), mb20s12_p2(), mb20s12_r(), 2usize, 12000u32, 240usize, 3usize)
    try report("mb 20ms stereo 12k", e_mb20s12)
    if e_mb20s12 < 0i64 || e_mb20s12 > 0i64 { os.exit(43i32) }
    let e_mb20m16 = lp_check(a, mb20m16_p0(), mb20m16_p1(), mb20m16_p2(), mb20m16_r(), 1usize, 16000u32, 320usize, 3usize)
    try report("mb 20ms mono 16k", e_mb20m16)
    if e_mb20m16 < 0i64 || e_mb20m16 > 0i64 { os.exit(44i32) }
    let e_mb10m24 = lp_check(a, mb10m24_p0(), mb10m24_p1(), mb10m24_p2(), mb10m24_r(), 1usize, 24000u32, 240usize, 3usize)
    try report("mb 10ms mono 24k", e_mb10m24)
    if e_mb10m24 < 0i64 || e_mb10m24 > 0i64 { os.exit(45i32) }
    let e_mb10s48 = lp_check(a, mb10s48_p0(), mb10s48_p1(), mb10s48_p2(), mb10s48_r(), 2usize, 48000u32, 480usize, 3usize)
    try report("mb 10ms stereo 48k", e_mb10s48)
    if e_mb10s48 < 0i64 || e_mb10s48 > 0i64 { os.exit(46i32) }
    let e_wb10m8 = lp_check(a, wb10m8_p0(), wb10m8_p1(), wb10m8_p2(), wb10m8_r(), 1usize, 8000u32, 80usize, 3usize)
    try report("wb 10ms mono 8k", e_wb10m8)
    if e_wb10m8 < 0i64 || e_wb10m8 > 0i64 { os.exit(47i32) }
    let e_wb20m12 = lp_check(a, wb20m12_p0(), wb20m12_p1(), wb20m12_p2(), wb20m12_r(), 1usize, 12000u32, 240usize, 3usize)
    try report("wb 20ms mono 12k", e_wb20m12)
    if e_wb20m12 < 0i64 || e_wb20m12 > 0i64 { os.exit(48i32) }
    let e_wb20s16 = lp_check(a, wb20s16_p0(), wb20s16_p1(), wb20s16_p2(), wb20s16_r(), 2usize, 16000u32, 320usize, 3usize)
    try report("wb 20ms stereo 16k", e_wb20s16)
    if e_wb20s16 < 0i64 || e_wb20s16 > 0i64 { os.exit(49i32) }
    let e_wb10s24 = lp_check(a, wb10s24_p0(), wb10s24_p1(), wb10s24_p2(), wb10s24_r(), 2usize, 24000u32, 240usize, 3usize)
    try report("wb 10ms stereo 24k", e_wb10s24)
    if e_wb10s24 < 0i64 || e_wb10s24 > 0i64 { os.exit(50i32) }
    let e_wb20m48 = lp_check(a, wb20m48_p0(), wb20m48_p1(), wb20m48_p2(), wb20m48_r(), 1usize, 48000u32, 960usize, 3usize)
    try report("wb 20ms mono 48k", e_wb20m48)
    if e_wb20m48 < 0i64 || e_wb20m48 > 0i64 { os.exit(51i32) }
    let e_nb2x = lp_check(a, nb2x_p0(), nb2x_p1(), nb2x_p2(), nb2x_r(), 1usize, 12000u32, 480usize, 1usize)
    try report("nb 20ms code2 mono 12k", e_nb2x)
    if e_nb2x < 0i64 || e_nb2x > 0i64 { os.exit(52i32) }
    let e_hy15m = lp_check(a, hy15m_p0(), hy15m_p1(), hy15m_p2(), hy15m_r(), 1usize, 48000u32, 960usize, 3usize)
    try report("hybrid cfg15 mono 48k", e_hy15m)
    if e_hy15m < 0i64 || e_hy15m > 30000i64 { os.exit(53i32) }
    let e_hy15s = lp_check(a, hy15s_p0(), hy15s_p1(), hy15s_p2(), hy15s_r(), 2usize, 48000u32, 960usize, 3usize)
    try report("hybrid cfg15 stereo 48k", e_hy15s)
    if e_hy15s < 0i64 || e_hy15s > 30000i64 { os.exit(54i32) }
    let e_hy13m = lp_check(a, hy13m_p0(), hy13m_p1(), hy13m_p2(), hy13m_r(), 1usize, 48000u32, 960usize, 3usize)
    try report("hybrid cfg13 mono 48k", e_hy13m)
    if e_hy13m < 0i64 || e_hy13m > 30000i64 { os.exit(55i32) }
    let e_hy2x = lp_check(a, hy2x_p0(), hy2x_p1(), hy2x_p2(), hy2x_r(), 1usize, 48000u32, 1920usize, 1usize)
    try report("hybrid cfg15 code2 mono 48k", e_hy2x)
    if e_hy2x < 0i64 || e_hy2x > 30000i64 { os.exit(56i32) }
    try io.print("worst max err 1e-9 * ")
    try print_num(worst)
    try io.print("\n")
    try io.print("fmt opus ok\n")
    ret ok
}
