fn le16(s: str, at: usize) -> i32 {
    ret i32(s[at]) | (i32(s[at + 1usize]) << 8u32)
}
fn le16s(s: str, at: usize) -> i32 {
    var v = le16(s, at)
    if v >= 32768i32 { v -= 65536i32 }
    ret v
}
fn le32(s: str, at: usize) -> i32 {
    var v = i64(s[at]) | (i64(s[at + 1usize]) << 8u32) | (i64(s[at + 2usize]) << 16u32) | (i64(s[at + 3usize]) << 24u32)
    if v >= 2147483648i64 { v -= 4294967296i64 }
    ret i32(v)
}
fn mode_code(m: opus.Mode) -> i32 {
    if m == .Silk { ret 0i32 }
    if m == .Hybrid { ret 1i32 }
    ret 2i32
}
fn bw_code(b: opus.Bandwidth) -> i32 {
    if b == .Narrow { ret 0i32 }
    if b == .Medium { ret 1i32 }
    if b == .Wide { ret 2i32 }
    if b == .SuperWide { ret 3i32 }
    ret 4i32
}
fn expect_frames(pkt: str, want: usize, first: usize, last: usize) -> bool {
    var frames: [48]opus.Frame = zero
    let (n, e) = opus.packet_parse(pkt, frames[..])
    if e != ok { ret false }
    if n != want { ret false }
    if frames[0usize].data.len != first { ret false }
    if frames[n - 1usize].data.len != last { ret false }
    ret true
}
fn expect_bad(pkt: str) -> bool {
    var frames: [48]opus.Frame = zero
    let (n, e) = opus.packet_parse(pkt, frames[..])
    if n != 0usize { ret false }
    ret e == opus.Malformed
}
fn print_num(v: i64) -> err {
    var digits: [24]u8 = zero
    var out: [24]u8 = zero
    var n = 0usize
    var x = v
    if x < 0i64 { x = 0i64 - x }
    if x == 0i64 {
        digits[0usize] = 48u8
        n = 1usize
    }
    while x > 0i64 {
        digits[n] = 48u8 + u8(x % 10i64)
        x /= 10i64
        n += 1usize
    }
    var i = 0usize
    while i < n {
        out[i] = digits[n - 1usize - i]
        i += 1usize
    }
    try io.print(out[..n])
    ret ok
}
// Decodes three packets and answers the worst absolute sample error against the
// stored libopus PCM for the third frame, scaled by 1e9, or a negative code.
fn celt_check(a: *mem.Arena, p0: str, p1: str, p2: str, refpcm: str, channels: usize, n: usize) -> i64 {
    let (dd, e) = opus.decoder(a, channels)
    if e != ok { ret 0i64 - 1i64 }
    var d = dd
    let (out, oe) = mem.alloc[f32](a, n * channels)
    if oe != ok { ret 0i64 - 2i64 }
    let (c0, e0) = opus.decode(&d, p0, 48000u32, out)
    if e0 != ok || c0 != n { ret 0i64 - 3i64 }
    let (c1, e1) = opus.decode(&d, p1, 48000u32, out)
    if e1 != ok || c1 != n { ret 0i64 - 4i64 }
    let (c2, e2) = opus.decode(&d, p2, 48000u32, out)
    if e2 != ok || c2 != n { ret 0i64 - 5i64 }
    var worst = 0.0f64
    var i = 0usize
    while i < n * channels {
        let want = f64(le16s(refpcm, 2usize * i)) * 0.000030517578125
        var diff = f64(out[i]) - want
        if diff < 0.0 { diff = 0.0 - diff }
        if diff > worst { worst = diff }
        i += 1usize
    }
    ret i64(worst * 1000000000.0)
}
// Decodes `npk` of the three packets at `rate` and answers the worst absolute
// sample error of the last one against the stored libopus PCM, scaled by 1e9,
// or a negative code.  The SILK layer and its resampler are integer-exact, so a
// SILK-only case must answer 0.
fn lp_check(a: *mem.Arena, p0: str, p1: str, p2: str, refpcm: str, channels: usize, rate: u32, n: usize, npk: usize) -> i64 {
    let (dd, e) = opus.decoder(a, channels)
    if e != ok { ret 0i64 - 1i64 }
    var d = dd
    let (out, oe) = mem.alloc[f32](a, n * channels)
    if oe != ok { ret 0i64 - 2i64 }
    var k = 0usize
    while k < npk {
        var p = p0
        if k == 1usize { p = p1 }
        if k == 2usize { p = p2 }
        let (c, ce) = opus.decode(&d, p, rate, out)
        if ce != ok { ret 0i64 - 3i64 }
        if c != n { ret 0i64 - 4i64 }
        k += 1usize
    }
    var worst = 0.0f64
    var i = 0usize
    while i < n * channels {
        let want = f64(le16s(refpcm, 2usize * i)) * 0.000030517578125
        var diff = f64(out[i]) - want
        if diff < 0.0 { diff = 0.0 - diff }
        if diff > worst { worst = diff }
        i += 1usize
    }
    ret i64(worst * 1000000000.0)
}
fn report(label: str, scaled: i64) -> err {
    try io.print(label)
    try io.print(" max err 1e-9 * ")
    try print_num(scaled)
    try io.print("\n")
    ret ok
}

