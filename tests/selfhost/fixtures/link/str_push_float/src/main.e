// The float pushes. `{}` writes the shortest digit string that reads back as the
// same value, in fixed notation while the leading digit's exponent is in [-5, 15] and
// scientific otherwise; `{.N}` writes exactly N digits after the point, rounded half
// to even. Both expand the value to its exact decimal first, so the rounding reads
// digits rather than arithmetic. Expected text comes from an independent
// implementation, and every shortest case is also read back through `parse_f64` or
// `parse_f32` to confirm the round trip it claims.

use e.mem
use e.str

error Failed

fn short64(a: *mem.Arena, v: f64, text: str) -> err {
    var (b, builder_error) = str.builder(a, 64usize)
    if builder_error != ok { ret builder_error }
    try str.push_f64(&b, v)
    let written = str.done(&b)
    if !str.eq(written, text) { ret Failed }
    let (back, back_error) = str.parse_f64(written)
    if back_error != ok { ret back_error }
    if mem.bitcast[u64](back) != mem.bitcast[u64](v) { ret Failed }
    ret ok
}

fn short32(a: *mem.Arena, v: f32, text: str) -> err {
    var (b, builder_error) = str.builder(a, 64usize)
    if builder_error != ok { ret builder_error }
    try str.push_f32(&b, v)
    let written = str.done(&b)
    if !str.eq(written, text) { ret Failed }
    let (back, back_error) = str.parse_f32(written)
    if back_error != ok { ret back_error }
    if mem.bitcast[u32](back) != mem.bitcast[u32](v) { ret Failed }
    ret ok
}

fn fixed64(a: *mem.Arena, v: f64, precision: u8, text: str) -> err {
    var (b, builder_error) = str.builder(a, 160usize)
    if builder_error != ok { ret builder_error }
    try str.push_f64_fixed(&b, v, precision)
    if !str.eq(str.done(&b), text) { ret Failed }
    ret ok
}

fn fixed32(a: *mem.Arena, v: f32, precision: u8, text: str) -> err {
    var (b, builder_error) = str.builder(a, 160usize)
    if builder_error != ok { ret builder_error }
    try str.push_f32_fixed(&b, v, precision)
    if !str.eq(str.done(&b), text) { ret Failed }
    ret ok
}

fn main(a: *mem.Arena, args: []str) -> err {
    // Values whose shortest form is obvious, and the ones where it is not: 0.1 has no
    // exact binary form, and 0.1 + 0.2 needs all seventeen digits to say what it is.
    try short64(a, 0.0f64, "0")
    try short64(a, -0.0f64, "-0")
    try short64(a, 1.0f64, "1")
    try short64(a, -1.0f64, "-1")
    try short64(a, 0.5f64, "0.5")
    try short64(a, 1.5f64, "1.5")
    try short64(a, 3.75f64, "3.75")
    try short64(a, 100.0f64, "100")
    try short64(a, 0.1f64, "0.1")
    try short64(a, 0.2f64, "0.2")
    try short64(a, 0.3f64, "0.3")
    try short64(a, 123.456f64, "123.456")
    try short64(a, 0.1f64 + 0.2f64, "0.30000000000000004")

    // Section 4's notation rule is on the leading digit's exponent and holds fixed
    // notation over [-5, 15]: 1e15 is written out and 1e16 is not, 1e-5 is written out
    // and 1e-6 is not. The spec's own example, 1.5e-7, is on the far side.
    try short64(a, 1e15f64, "1000000000000000")
    try short64(a, 1e16f64, "1e16")
    try short64(a, 1e-5f64, "0.00001")
    try short64(a, 1e-6f64, "1e-6")
    try short64(a, 1e-7f64, "1e-7")
    try short64(a, 1.5e-7f64, "1.5e-7")
    try short64(a, 1e20f64, "1e20")
    try short64(a, 1e22f64, "1e22")
    try short64(a, 1e23f64, "1e23")

    // Both ends of the range and the smallest subnormal still round-trip.
    try short64(a, 1.7976931348623157e308f64, "1.7976931348623157e308")
    try short64(a, 2.2250738585072014e-308f64, "2.2250738585072014e-308")
    try short64(a, 5e-324f64, "5e-324")
    try short64(a, -5e-324f64, "-5e-324")

    // A float's shortest form is shorter than the same value read as a double, which
    // is the whole reason the two widths cannot share one routine.
    try short32(a, 0.1f32, "0.1")
    try short32(a, 1.0f32, "1")
    try short32(a, 3.4028235e38f32, "3.4028235e38")
    try short32(a, 1e-45f32, "1e-45")

    // The non-finite spellings, in both forms and both widths.
    try short64(a, 1.0f64 / 0.0f64, "inf")
    try short64(a, -1.0f64 / 0.0f64, "-inf")
    try short64(a, 0.0f64 / 0.0f64, "nan")
    try fixed64(a, 1.0f64 / 0.0f64, 3u8, "inf")
    try fixed64(a, -1.0f64 / 0.0f64, 3u8, "-inf")
    try fixed64(a, 0.0f64 / 0.0f64, 3u8, "nan")
    try short32(a, 1.0f32 / 0.0f32, "inf")
    try fixed32(a, 0.0f32 / 0.0f32, 2u8, "nan")

    // Fixed precision writes exactly N digits, pads on both sides, and keeps the sign
    // of a negative zero.
    try fixed64(a, 0.0f64, 0u8, "0")
    try fixed64(a, 0.0f64, 3u8, "0.000")
    try fixed64(a, -0.0f64, 2u8, "-0.00")
    try fixed64(a, 1.0f64, 0u8, "1")
    try fixed64(a, 1.5f64, 0u8, "2")
    try fixed64(a, 2.5f64, 0u8, "2")
    try fixed64(a, 3.5f64, 0u8, "4")
    try fixed64(a, 0.125f64, 2u8, "0.12")
    try fixed64(a, 0.375f64, 2u8, "0.38")
    try fixed64(a, 123.456f64, 2u8, "123.46")
    try fixed64(a, 123.456f64, 8u8, "123.45600000")
    try fixed64(a, 0.1f64, 20u8, "0.10000000000000000555")
    try fixed64(a, -1.25f64, 1u8, "-1.2")
    try fixed64(a, 1e-7f64, 3u8, "0.000")
    try fixed32(a, 2.5f32, 0u8, "2")
    try fixed32(a, 0.1f32, 10u8, "0.1000000015")

    // A precision past 99 is the one error a push can report for a well-formed value.
    var (probe, probe_error) = str.builder(a, 8usize)
    if probe_error != ok { ret probe_error }
    if str.push_f64_fixed(&probe, 1.0f64, 100u8) != str.BadNumber { ret Failed }
