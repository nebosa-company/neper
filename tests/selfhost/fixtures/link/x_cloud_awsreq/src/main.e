    ret "{\"apiVersion\":\"2014-10-31\",\"input\":\"CreateDBInstanceMessage\",\"inputRef\":{\"shape\":\"CreateDBInstanceMessage\"},\"jsonVersion\":\"\",\"method\":\"POST\",\"name\":\"CreateDBInstance\",\"protocol\":\"query\",\"requestUri\":\"/\",\"shapes\":{\"AdditionalStorageVolume\":{\"documentation\":\"<p>Contains details about an additional storage volume for a DB instance. RDS support additional storage volumes for RDS for Oracle and RDS for SQL Server.</p>\",\"members\":{\"AllocatedStorage\":{\"documentation\":\"<p>The amount of storage allocated for the additional storage volume, in gibibytes (GiB). The minimum is 20 GiB. The maximum is 65,536 GiB (64 TiB).</p>\",\"shape\":\"IntegerOptional\"},\"IOPS\":{\"documentation\":\"<p>The number of I/O operations per second (IOPS) provisioned for the additional storage volume.</p>\",\"shape\":\"IntegerOptional\"},\"MaxAllocatedStorage\":{\"documentation\":\"<p>The upper limit in gibibytes (GiB) to which RDS can automatically scale the storage of the additional storage volume.</p>\",\"shape\":\"IntegerOptional\"},\"StorageThroughput\":{\"documentation\":\"<p>The storage throughput value for the additional storage volume, in mebibytes per second (MiBps). This setting applies only to the General Purpose SSD (<code>gp3</code>) storage type.</p>\",\"shape\":\"IntegerOptional\"},\"StorageType\":{\"documentation\":\"<p>The storage type for the additional storage volume.</p> <p>Valid Values: <code>GP3 | IO2</code> </p>\",\"shape\":\"String\"},\"VolumeName\":{\"documentation\":\"<p>The name of the additional storage volume.</p> <p>Valid Values: <code>RDSDBDATA2 | RDSDBDATA3 | RDSDBDATA4</code> </p>\",\"shape\":\"String\"}},\"required\":[\"VolumeName\"],\"type\":\"structure\"},\"AdditionalStorageVolumesList\":{\"member\":{\"shape\":\"AdditionalStorageVolume\"},\"type\":\"list\"},\"BooleanOptional\":{\"box\":true,\"type\":\"boolean\"},\"CreateDBInstanceMessage\":{\"documentation\":\"<p/>\",\"members\":{\"AdditionalStorageVolumes