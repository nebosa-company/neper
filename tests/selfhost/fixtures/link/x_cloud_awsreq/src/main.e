\":{\"method\":\"POST\",\"path\":\"/\",\"headers\":[[\"Content-Type\",\"application/x-www-form-urlencoded; charset=utf-8\"]],\"body\":\"Action=SetTopicAttributes&Version=2010-03-31&AttributeName=arn%3Aaws%3Aiam%3A%3A123456789012%3Arole%2FRole&TopicArn=arn%3Aaws%3Aiam%3A%3A123456789012%3Arole%2FRole\"}}\n{\"params\":{\"TopicArn\":\"a&b=c\",\"AttributeName\":\"q?r#s\",\"AttributeValue\":\"caf\\u00e9\"},\"e\":{\"method\":\"POST\",\"path\":\"/\",\"headers\":[[\"Content-Type\",\"application/x-www-form-urlencoded; charset=utf-8\"]],\"body\":\"Action=SetTopicAttributes&Version=2010-03-31&TopicArn=a%26b%3Dc&AttributeName=q%3Fr%23s&AttributeValue=caf%C3%A9\"}}\n{\"params\":{\"TopicArn\":\"Gamma Delta\",\"AttributeName\":\"q?r#s\",\"AttributeValue\":\"alpha\"},\"e\":{\"method\":\"POST\",\"path\":\"/\",\"headers\":[[\"Content-Type\",\"application/x-www-form-urlencoded; charset=utf-8\"]],\"body\":\"Action=SetTopicAttributes&Version=2010-03-31&TopicArn=Gamma+Delta&AttributeName=q%3Fr%23s&AttributeValue=alpha\"}}\n{\"params\":{\"AttributeName\":\"alpha\",\"TopicArn\":\"a&b=c\",\"AttributeValue\":\"arn:aws:iam::123456789012:role/Role\"},\"e\":{\"method\":\"POST\",\"path\":\"/\",\"headers\":[[\"Content-Type\",\"application/x-www-form-urlencoded; charset=utf-8\"]],\"body\":\"Action=SetTopicAttributes&Version=2010-03-31&AttributeName=alpha&TopicArn=a%26b%3Dc&AttributeValue=arn%3Aaws%3Aiam%3A%3A123456789012%3Arole%2FRole\"}}\n"
