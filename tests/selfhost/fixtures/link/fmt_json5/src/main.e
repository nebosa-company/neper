    while i < text.len {
        if text[i] == 10u8 {
            let code = check_line(text[start..i])
            if code != 0u8 {
                let shown = io.print(text[start..i])
                if shown != ok { ret code }
                ret code
            }
            start = i + 1usize
        }
        i += 1usize
    }
    ret 0u8
}

fn run_vectors() -> u8 {
    let r_v_0 = run_text(v_0())
    if r_v_0 != 0u8 { ret r_v_0 }
    let r_v_1 = run_text(v_1())
    if r_v_1 != 0u8 { ret r_v_1 }
    let r_v_2 = run_text(v_2())
    if r_v_2 != 0u8 { ret r_v_2 }
    let r_v_3 = run_text(v_3())
    if r_v_3 != 0u8 { ret r_v_3 }
    let r_v_4 = run_text(v_4())
    if r_v_4 != 0u8 { ret r_v_4 }
    let r_v_5 = run_text(v_5())
    if r_v_5 != 0u8 { ret r_v_5 }
    let r_v_6 = run_text(v_6())
    if r_v_6 != 0u8 { ret r_v_6 }
    let r_v_7 = run_text(v_7())
    if r_v_7 != 0u8 { ret r_v_7 }
    let r_v_8 = run_text(v_8())
    if r_v_8 != 0u8 { ret r_v_8 }
    let r_v_9 = run_text(v_9())
    if r_v_9 != 0u8 { ret r_v_9 }
    let r_v_10 = run_text(v_10())
    if r_v_10 != 0u8 { ret r_v_10 }
    let r_v_11 = run_text(v_11())
    if r_v_11 != 0u8 { ret r_v_11 }
    ret 0u8
}

fn main(a: *mem.Arena, args: []str) -> err {
    // Exact writer output on a small tree.
    var arena_buf: [65536]u8 = zero
    var arena = mem.arena_from(arena_buf[0usize..65536usize])
    var options: json.Options = zero
    let (v, v_error) = json5.parse(&arena, "{a: [1, 'x', +2.5], 'two words': null, if: true, '7up': 0xA,}", options)
    if v_error != ok { os.exit(101i32) }
    // duplicate keys are the JSON module's decision: refused unless the options allow them
    let (_, dup_error) = json5.parse(&arena, "{a:1,'a':2}", options)
    if dup_error != json.DuplicateKey { os.exit(105i32) }
    var out: [1024]u8 = zero
    var sw: io.SliceWriter = zero
    sw.data = out[0usize..1024usize]
    var writer = io.slice_writer(&sw)
    if json5.write(&writer, &v) != ok { os.exit(103i32) }
    if !text_is(out[0usize..sw.off],"{a:[1,\"x\",2.5],\"two words\":null,if:true,\"7up\":10}") { os.exit(104i32) }
    let r = run_vectors()
    if r != 0u8 { os.exit(i32(r)) }
    try io.print("fmt json5 ok")
    ret ok
}
