// f16 and bf16 on the x64 and aarch64 code generators (D5913): widen to f32, operate,
// round once to nearest-even, in integer instructions. Every operation and conversion
// folds 2500 operands drawn from a fixed stream (zero and denormal, infinity and NaN,
// and exponents near 1 are over-represented) into an FNV-1a hash that
// scripts/narrow_float_vectors.py computes independently: numpy float32 for the f32
// operation, exact rational rounding for the narrow format. Generated by that script;
// do not edit. A failure exits with 1 + 20 * type + operation (f16 first), 100 and up
// for a literal, 250 and up for storage.

use e.gpu
use e.math
use e.mem
use e.os

fn next(s: *u64) -> u64 {
    *s = *s *% 6364136223846793005u64 +% 1442695040888963407u64
    ret *s
}

fn fold(h: u64, out: u64) -> u64 { ret (h ^ out) *% 1099511628211u64 }

fn compare_mask[T: type](x: T, y: T) -> u64 {
    var m = 0u64
    if x < y { m = m | 1u64 }
    if x <= y { m = m | 2u64 }
    if x > y { m = m | 4u64 }
    if x >= y { m = m | 8u64 }
    if x == y { m = m | 16u64 }
    if x != y { m = m | 32u64 }
    ret m
}

fn pick_h(s: *u64) -> u16 {
    let r = next(s)
    let k = (r >> 33u64) % 6u64
    let v = u16(r >> 48u64)
    let sign = v & 32768u16
    if k == 0u64 {
        if (r >> 20u64) % 2u64 == 0u64 { ret sign | 31744u16 }
        ret sign | 31744u16 | (v & 1023u16)
    }
    if k == 1u64 { ret v & 33791u16 }
    if k == 2u64 { ret (v & 33791u16) | u16((13u64 + (r >> 8u64) % 5u64) << 10u64) }
    ret v
}

fn pick_b(s: *u64) -> u16 {
    let r = next(s)
    let k = (r >> 33u64) % 6u64
    let v = u16(r >> 48u64)
    let sign = v & 32768u16
    if k == 0u64 {
        if (r >> 20u64) % 2u64 == 0u64 { ret sign | 32640u16 }
        ret sign | 32640u16 | (v & 127u16)
    }
    if k == 1u64 { ret v & 32895u16 }
    if k == 2u64 { ret (v & 32895u16) | u16((125u64 + (r >> 8u64) % 5u64) << 7u64) }
    ret v
}

fn add_h(x: f16, y: f16) -> f16 { ret x + y }

fn run_h(op: u64, seed: u64) -> u64 {
    var s = seed
    var h = 14695981039346656037u64
    var i = 0u64
    while i < 2500u64 {
        let x = mem.bitcast[f16](pick_h(&s))
        let y = mem.bitcast[f16](pick_h(&s))
        var out = 0u64
        if op == 0u64 { out = u64(mem.bitcast[u16](x + y)) }
        if op == 1u64 { out = u64(mem.bitcast[u16](x - y)) }
        if op == 2u64 { out = u64(mem.bitcast[u16](x * y)) }
        if op == 3u64 { out = u64(mem.bitcast[u16](x / y)) }
        if op == 4u64 { out = u64(mem.bitcast[u16](math.sqrt[f16](x))) }
        if op == 5u64 { out = u64(mem.bitcast[u16](-x)) }
        if op == 6u64 { out = compare_mask(x, y) }
        if op == 7u64 { out = u64(mem.bitcast[u32](f32(x))) }
        if op == 8u64 { out = mem.bitcast[u64](f64(x)) }
        if op == 9u64 {
            let n = next(&s)
            let k = (n >> 40u64) % 4u64
            var add = n >> 48u64
            if k == 1u64 { add = 4096u64 }
            if k == 2u64 { add = 4095u64 }
            if k == 3u64 { add = 4097u64 }
            let w = mem.bitcast[f32](u32.trunc(u64(mem.bitcast[u32](f32(x))) + add))
            out = u64(mem.bitcast[u16](f16(w)))
        }
        if op == 10u64 {
            let n = next(&s)
            let k = (n >> 40u64) % 4u64
            var add = n & 8796093022207u64
            if k == 1u64 { add = 2199023255552u64 }
            if k == 2u64 { add = 2199023255551u64 }
            if k == 3u64 { add = 2199023255553u64 }
            let w = mem.bitcast[f64](mem.bitcast[u64](f64(x)) +% add)
            out = u64(mem.bitcast[u16](f16(w)))
        }
        if op == 11u64 && (mem.bitcast[u16](x) & 32767u16) < 31744u16 { out = u64(mem.bitcast[u32](i32(x))) }
        if op == 12u64 && (mem.bitcast[u16](x) & 32767u16) < 31744u16 { out = mem.bitcast[u64](i64(x)) }
        if op >= 13u64 && op <= 15u64 {
            let n = next(&s)
            let q = n >> ((n >> 5u64) % 64u64)
            if op == 13u64 { out = u64(mem.bitcast[u16](f16(mem.bitcast[i32](u32.trunc(q))))) }
            if op == 14u64 { out = u64(mem.bitcast[u16](f16(mem.bitcast[i64](q)))) }
            if op == 15u64 { out = u64(mem.bitcast[u16](f16(q))) }
        }
        if op == 16u64 {
            let other = mem.bitcast[bf16](pick_b(&s))
            out = u64(mem.bitcast[u16](f16(other)))
        }
        if op == 17u64 { out = u64(mem.bitcast[u16](add_h(x, y))) }
        if op == 18u64 {
            let z = mem.bitcast[f16](pick_h(&s))
            out = u64(mem.bitcast[u16](math.fma[f16](x, y, z)))
        }
        h = fold(h, out)
        i += 1u64
    }
    ret h
}

fn add_b(x: bf16, y: bf16) -> bf16 { ret x + y }

fn run_b(op: u64, seed: u64) -> u64 {
    var s = seed
    var h = 14695981039346656037u64
    var i = 0u64
    while i < 2500u64 {
        let x = mem.bitcast[bf16](pick_b(&s))
        let y = mem.bitcast[bf16](pick_b(&s))
        var out = 0u64
        if op == 0u64 { out = u64(mem.bitcast[u16](x + y)) }
        if op == 1u64 { out = u64(mem.bitcast[u16](x - y)) }
        if op == 2u64 { out = u64(mem.bitcast[u16](x * y)) }
        if op == 3u64 { out = u64(mem.bitcast[u16](x / y)) }
        if op == 4u64 { out = u64(mem.bitcast[u16](math.sqrt[bf16](x))) }
        if op == 5u64 { out = u64(mem.bitcast[u16](-x)) }
        if op == 6u64 { out = compare_mask(x, y) }
        if op == 7u64 { out = u64(mem.bitcast[u32](f32(x))) }
        if op == 8u64 { out = mem.bitcast[u64](f64(x)) }
        if op == 9u64 {
            let n = next(&s)
            let k = (n >> 40u64) % 4u64
            var add = n >> 48u64
            if k == 1u64 { add = 32768u64 }
            if k == 2u64 { add = 32767u64 }
            if k == 3u64 { add = 32769u64 }
            let w = mem.bitcast[f32](u32.trunc(u64(mem.bitcast[u32](f32(x))) + add))
            out = u64(mem.bitcast[u16](bf16(w)))
        }
        if op == 10u64 {
            let n = next(&s)
            let k = (n >> 40u64) % 4u64
            var add = n & 70368744177663u64
            if k == 1u64 { add = 17592186044416u64 }
            if k == 2u64 { add = 17592186044415u64 }
            if k == 3u64 { add = 17592186044417u64 }
            let w = mem.bitcast[f64](mem.bitcast[u64](f64(x)) +% add)
            out = u64(mem.bitcast[u16](bf16(w)))
        }
        if op == 11u64 && (mem.bitcast[u16](x) & 32767u16) < 20096u16 { out = u64(mem.bitcast[u32](i32(x))) }
        if op == 12u64 && (mem.bitcast[u16](x) & 32767u16) < 20096u16 { out = mem.bitcast[u64](i64(x)) }
        if op >= 13u64 && op <= 15u64 {
            let n = next(&s)
            let q = n >> ((n >> 5u64) % 64u64)
            if op == 13u64 { out = u64(mem.bitcast[u16](bf16(mem.bitcast[i32](u32.trunc(q))))) }
            if op == 14u64 { out = u64(mem.bitcast[u16](bf16(mem.bitcast[i64](q)))) }
            if op == 15u64 { out = u64(mem.bitcast[u16](bf16(q))) }
        }
        if op == 16u64 {
            let other = mem.bitcast[f16](pick_h(&s))
            out = u64(mem.bitcast[u16](bf16(other)))
        }
        if op == 17u64 { out = u64(mem.bitcast[u16](add_b(x, y))) }
        if op == 18u64 {
            let z = mem.bitcast[bf16](pick_b(&s))
            out = u64(mem.bitcast[u16](math.fma[bf16](x, y, z)))
        }
        h = fold(h, out)
        i += 1u64
    }
    ret h
}

@gpu(16)
fn kernel_h(n: u32, x: []f16, y: []f16, out: []f16) {
    let i = usize(gpu.gid.x)
    if gpu.gid.x >= n { ret }
    out[i] = x[i] * y[i] + x[i]
}

// A kernel on the CPU backend computes in f16 the way the host does.
fn run_kernel_h(a: *mem.Arena) -> err {
    let (device, open_error) = gpu.open(a, .Cpu, 0u32)
    if open_error != ok { ret open_error }
    defer let _ = gpu.close(device)
    let (q, queue_error) = gpu.queue(device)
    if queue_error != ok { ret queue_error }
    let (x, x_error) = mem.alloc[f16](a, 16usize)
    if x_error != ok { ret x_error }
    let (y, y_error) = mem.alloc[f16](a, 16usize)
    if y_error != ok { ret y_error }
    let (got, got_error) = mem.alloc[f16](a, 16usize)
    if got_error != ok { ret got_error }
    var s = 99u64
    var at = 0usize
    while at < 16usize {
        x[at] = mem.bitcast[f16](pick_h(&s))
        y[at] = mem.bitcast[f16](pick_h(&s))
        at += 1usize
    }
    let (dx, dx_error) = gpu.upload[f16](q, x)
    if dx_error != ok { ret dx_error }
    defer let _ = gpu.release(q, dx)
    let (dy, dy_error) = gpu.upload[f16](q, y)
    if dy_error != ok { ret dy_error }
    defer let _ = gpu.release(q, dy)
    let (dout, dout_error) = gpu.alloc[f16](q, 16usize)
    if dout_error != ok { ret dout_error }
    defer let _ = gpu.release(q, dout)
    try gpu.launch[kernel_h](q, gpu.grid1(16usize), 16u32, dx, dy, dout)
    try gpu.download(q, dout, got)
    at = 0usize
    while at < 16usize {
        let want = x[at] * y[at] + x[at]
        if mem.bitcast[u16](got[at]) != mem.bitcast[u16](want) { ret mem.Exhausted }
        at += 1usize
    }
    ret ok
}

