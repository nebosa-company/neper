    // The mode from the environment is one of the three.
    let m = snap.mode_from_env(a)
    if m != snap.Mode.Ci && m != snap.Mode.Review && m != snap.Mode.Accept { ret 39i32 }
    ret 0i32
}

fn pretty_doc(a: *mem.Arena, width: usize) -> i32 {
    var docs: [16]pretty.Doc = zero
    let (p0, pe) = pretty.pool(docs[0..])
    var p = p0
    let (t1, e1) = pretty.text(&p, "alpha")
    let (ln, e2) = pretty.line(&p)
    let (t2, e3) = pretty.text(&p, "beta")
    let (c1, e4) = pretty.concat(&p, t1, ln)
    let (c2, e5) = pretty.concat(&p, c1, t2)
    let (g, e6) = pretty.group(&p, c2)
    clear(a, "doc_wide")
    clear(a, "doc_narrow")
    if snap.check_doc(a, "np-snapshot", "doc_wide", &p, g, 80usize, 256usize, snap.Mode.Accept) != ok { ret 60i32 }
    if snap.check_doc(a, "np-snapshot", "doc_narrow", &p, g, 4usize, 256usize, snap.Mode.Accept) != ok { ret 61i32 }
    let (sw, q1) = snap.path_of(a, "np-snapshot", "doc_wide", false)
    let (sn, q2) = snap.path_of(a, "np-snapshot", "doc_narrow", false)
    if !str.eq(snap.body_of(read_text(a, sw)), "alpha beta\n") { ret 62i32 }
    if !str.eq(snap.body_of(read_text(a, sn)), "alpha\nbeta\n") { ret 63i32 }
    if snap.check_doc(a, "np-snapshot", "doc_wide", &p, g, 80usize, 256usize, snap.Mode.Ci) != ok { ret 64i32 }
    if snap.check_doc(a, "np-snapshot", "doc_wide", &p, g, 4usize, 256usize, snap.Mode.Ci) != test.Failed { ret 65i32 }
    ret 0i32
}

fn vector_cases(a: *mem.Arena) -> i32 {
    var lines = str.lines(vectors())
    var n = 0i32
    var updates = 0i32
    while true {
        let (line, more) = str.split_next(&lines)
        if !more { break }
        if line.len == 0usize { continue }
        if str.starts_with(line, "@update~") {
            let (name, rest, found) = str.split_once(line[8..], "~")
            if !found { ret 70i32 }
            let content = unhex(a, rest)
            clear(a, name)
            let (path, pe) = snap.path_of(a, "np-snapshot", name, false)
            if pe != ok || snap.write_text(a, "np-snapshot", path, content) != ok { ret 71i32 }
            // What pytest-snapshot wrote for a candidate is matched by that candidate (header-less file).
            let (o, e) = snap.assert_text(a, "np-snapshot", name, content, snap.Mode.Ci)
            if e != ok || o != snap.Outcome.Matched { ret 72i32 }
            updates += 1i32
        } else {
            let (name, rest, found) = str.split_once(line, "~")
            let (stored_hex, rest2, found2) = str.split_once(rest, "~")
            let (cand_hex, verdict, found3) = str.split_once(rest2, "~")
            if !found || !found2 || !found3 { ret 73i32 }
            clear(a, name)
            if put(a, name, unhex(a, stored_hex)) != 0i32 { ret 74i32 }
            let (o, e) = snap.assert_text(a, "np-snapshot", name, unhex(a, cand_hex), snap.Mode.Ci)
            if e != ok { ret 75i32 }
            var want = snap.Outcome.Mismatch
            if str.eq(verdict, "m") { want = snap.Outcome.Matched }
            if o != want { ret 200i32 + n }
            n += 1i32
        }
    }
    if n != 60i32 || updates != 60i32 { ret 76i32 }
    ret 0i32
}

fn cleanup(a: *mem.Arena) {
    let (entries, e) = os.readdir(a, "np-snapshot")
    if e != ok { ret }
    var i = 0usize
    while i < entries.len {
        let (path, pe) = str.concat(a, "np-snapshot/", entries[i].name)
        let r = fs.remove_file(a, path)
        i += 1usize
    }
    let d = fs.remove_dir(a, "np-snapshot")
}

fn main(a: *mem.Arena, args: []str) -> err {
    cleanup(a)
    var code = workflow(a)
    if code == 0i32 { code = pretty_doc(a, 80usize) }
    if code == 0i32 { code = vector_cases(a) }
    cleanup(a)
    if code != 0i32 { os.exit(code) }
    let e = io.print("test snapshot ok")
    ret ok
}
