        let sel = term.Selection { mode: u32(arg(src, fs, fe, nf, 5usize)), a_line: arg(src, fs, fe, nf, 6usize), a_col: arg(src, fs, fe, nf, 7usize), h_line: arg(src, fs, fe, nf, 8usize), h_col: arg(src, fs, fe, nf, 9usize) }
        var buf: [4096]u8 = zero
        let n = term.selection_text(&t, &sel, buf[..])
        var i = 0usize
        while i < n {
            put(o, buf[i])
            i += 1usize
        }
    } else if op == 75u8 {
        var t = make(a, 80usize, 24usize, 0usize)
        if arg(src, fs, fe, nf, 3usize) == 1usize { term.feed(&t, "\x1b[?1h") }
        if arg(src, fs, fe, nf, 4usize) == 1usize { term.feed(&t, "\x1b[20h") }
        var buf: [48]u8 = zero
        let n = term.encode_key(&t, u32(arg(src, fs, fe, nf, 1usize)), u32(arg(src, fs, fe, nf, 2usize)), buf[..])
        put_hex_bytes(o, buf[..], n)
    } else if op == 77u8 {
        var t = make(a, 80usize, 24usize, 0usize)
        let mode = arg(src, fs, fe, nf, 1usize)
        if mode == 9usize { term.feed(&t, "\x1b[?9h") }
        if mode == 1000usize { term.feed(&t, "\x1b[?1000h") }
        if mode == 1002usize { term.feed(&t, "\x1b[?1002h") }
        if mode == 1003usize { term.feed(&t, "\x1b[?1003h") }
        if arg(src, fs, fe, nf, 2usize) == 1usize { term.feed(&t, "\x1b[?1006h") }
        var buf: [48]u8 = zero
        let n = term.encode_mouse(&t, u32(arg(src, fs, fe, nf, 3usize)), u32(arg(src, fs, fe, nf, 4usize)), u32(arg(src, fs, fe, nf, 5usize)), arg(src, fs, fe, nf, 6usize), arg(src, fs, fe, nf, 7usize), buf[..])
        put_hex_bytes(o, buf[..], n)
    } else if op == 70u8 {
        var t = make(a, 80usize, 24usize, 0usize)
        if arg(src, fs, fe, nf, 1usize) == 1usize { term.feed(&t, "\x1b[?1004h") }
        var buf: [8]u8 = zero
        let n = term.encode_focus(&t, arg(src, fs, fe, nf, 2usize) == 1usize, buf[..])
        put_hex_bytes(o, buf[..], n)
    } else if op == 80u8 {
        var t = make(a, 80usize, 24usize, 0usize)
        if arg(src, fs, fe, nf, 1usize) == 1usize { term.feed(&t, "\x1b[?2004h") }
        var buf: [256]u8 = zero
        var n = term.paste_begin(&t, buf[..])
        n += term.paste_filter(&t, src[fs[2usize]..fe[2usize]], buf[n..])
        n += term.paste_end(&t, buf[n..])
        put_hex_bytes(o, buf[..], n)
    } else if op == 74u8 {
        var sel = term.selection_start(term.SEL_CHAR, arg(src, fs, fe, nf, 1usize), arg(src, fs, fe, nf, 2usize))
        term.selection_extend(&sel, arg(src, fs, fe, nf, 3usize), arg(src, fs, fe, nf, 4usize))
        if term.selection_adjust(&sel, arg(src, fs, fe, nf, 5usize)) {
            put_num(o, sel.a_line)
            put(o, 44u8)
            put_num(o, sel.a_col)
            put(o, 44u8)
            put_num(o, sel.h_line)
            put(o, 44u8)
            put_num(o, sel.h_col)
        } else {
            put_str(o, "gone")
        }
    }
}

fn main(a: *mem.Arena, args: []str) -> err {
    let src = script()
    let want = expected()
    let base = a.off
    var out: Out = zero
    var wpos = 0usize
    var spos = 0usize
    var case_no = 0usize
    while case_no < CASES {
        var fs: [16]usize = zero
        var fe: [16]usize = zero
        var nf = 0usize
        var i = spos
        var start = spos
        var more = true
        while more {
            if i >= src.len || src[i] == 30u8 || src[i] == 31u8 {
                if nf < 16usize {
                    fs[nf] = start
                    fe[nf] = i
                    nf += 1usize
                }
                start = i + 1usize
                if i >= src.len || src[i] == 30u8 { more = false }
            }
            i += 1usize
        }
        spos = i
        var wend = wpos
        while wend < want.len && want[wend] != 30u8 { wend += 1usize }
        out.n = 0usize
        run_case(a, &out, fs[..], fe[..], nf, src)
        a.off = base
        var same = out.n == wend - wpos
        var k = 0usize
        while same && k < out.n {
            if out.buf[k] != want[wpos + k] { same = false }
            k += 1usize
        }
        if !same {
            var head: Out = zero
            put_str(&head, "case ")
            put_num(&head, case_no)
            put(&head, 32u8)
            put(&head, src[fs[0usize]])
            put_str(&head, "\n got: ")
            let (w1, e1) = os.write(os.stdout(), head.buf[0usize..head.n])
            let (w2, e2) = os.write(os.stdout(), out.buf[0usize..out.n])
            let (w3, e3) = os.write(os.stdout(), "\nwant: ")
            let (w4, e4) = os.write(os.stdout(), want[wpos..wend])
            let (w5, e5) = os.write(os.stdout(), "\n")
            os.exit(i32(1usize + case_no % 200usize))
        }
        wpos = wend + 1usize
        case_no += 1usize
    }
    let (w6, e6) = os.write(os.stdout(), "ui terminal ext ok\n")
    ret ok
}
