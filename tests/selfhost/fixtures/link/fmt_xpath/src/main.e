    if eval_error_3 != xp.TypeMismatch { try report("eval-refusal", 3usize) }
    let (_, eval_error_4) = xp.run(a, &parsed[0usize], "1 | 2", zero)
    if eval_error_4 != xp.TypeMismatch { try report("eval-refusal", 4usize) }
    let (_, eval_error_5) = xp.run(a, &parsed[0usize], "sum('a')", zero)
    if eval_error_5 != xp.TypeMismatch { try report("eval-refusal", 5usize) }
    let (_, eval_error_6) = xp.run(a, &parsed[0usize], "concat(1)", zero)
    if eval_error_6 != xp.WrongArity { try report("eval-refusal", 6usize) }
    let (_, eval_error_7) = xp.run(a, &parsed[0usize], "substring(1)", zero)
    if eval_error_7 != xp.WrongArity { try report("eval-refusal", 7usize) }
    let (_, eval_error_8) = xp.run(a, &parsed[0usize], "not()", zero)
    if eval_error_8 != xp.WrongArity { try report("eval-refusal", 8usize) }
    let (_, eval_error_9) = xp.run(a, &parsed[0usize], "true(1)", zero)
    if eval_error_9 != xp.WrongArity { try report("eval-refusal", 9usize) }
    let (_, eval_error_10) = xp.run(a, &parsed[0usize], "(1)[1]", zero)
    if eval_error_10 != xp.TypeMismatch { try report("eval-refusal", 10usize) }
    let (_, eval_error_11) = xp.run(a, &parsed[0usize], "string(1, 2)", zero)
    if eval_error_11 != xp.WrongArity { try report("eval-refusal", 11usize) }
    let (_, var_error) = xp.run(a, &parsed[0usize], "1 + 1", zero)
    if var_error != ok { try report("plain", 0usize) }
    var bound = [2]xp.Variable{ xp.Variable { name: "n", value: xp.number_value(3.0) }, xp.Variable { name: "s", value: xp.string_value("two") } }
    let vars = xp.Variables { items: bound[..], count: 2usize }
    let (var_expr, var_expr_error) = xp.compile(a, "$n + count(//a[. = $s])", zero)
    if var_expr_error != ok { try report("variable-compile", 0usize) }
    let none = xp.no_extensions()
    let no_vars = xp.no_variables()
    let (var_value, var_value_error) = xp.evaluate(a, &var_expr, &parsed[0usize], xp.Context { node: xp.XNode { id: parsed[0usize].root, attribute: 0u32 }, position: 1usize, size: 1usize }, &vars, &none)
    if var_value_error != ok || var_value.kind != xp.Kind.Number || var_value.number != 4.0 { try report("variable-value", 0usize) }
    let current_node = xp.XNode { id: 2u32, attribute: 0u32 }
    let with_current = xp.Extensions { current: current_node, has_current: true }
    let (current_expr, current_expr_error) = xp.compile(a, "name(current())", zero)
    if current_expr_error != ok { try report("current-compile", 0usize) }
    let (current_value, current_value_error) = xp.evaluate(a, &current_expr, &parsed[0usize], xp.Context { node: xp.XNode { id: parsed[0usize].root, attribute: 0u32 }, position: 1usize, size: 1usize }, &no_vars, &with_current)
    if current_value_error != ok || current_value.kind != xp.Kind.String || !same(current_value.text, "a") { try report("current-value", 0usize) }
    let (no_current, no_current_error) = xp.run(a, &parsed[0usize], "current()", zero)
    if no_current_error != xp.UnknownFunction { try report("current-absent", 0usize) }
    try io.print("fmt xpath ok\n")
    ret ok
}
