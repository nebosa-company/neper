// `e.crypto.hash`: SHA-256, SHA-512, SHA3-256, SHA3-512, SHA-1 and MD5 on four inputs
// each against Python's hashlib (vectors.py beside this fixture), the streaming forms
// fed in pieces that straddle every block boundary, and the constant-time compare.
// Every check has its own exit code.
use e.os
use e.mem
use e.crypto.hash as hash

fn same(a: []const u8, b: []const u8) -> bool {
    if a.len != b.len { ret false }
    var i = 0usize
    while i < a.len {
        if a[i] != b[i] { ret false }
        i += 1usize
    }
    ret true
}

fn main(a: *mem.Arena, args: []str) -> err {
    var long: [1000]u8 = zero
    var i = 0usize
    while i < 1000usize {
        long[i] = 97u8
        i += 1usize
    }
    let two = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    let none: [0]u8 = zero
    let sha256_abc: [32]u8 = [32]u8{ 186, 120, 22, 191, 143, 1, 207, 234, 65, 65, 64, 222, 93, 174, 34, 35, 176, 3, 97, 163, 150, 23, 122, 156, 180, 16, 255, 97, 242, 0, 21, 173 }
    let sha512_abc: [64]u8 = [64]u8{ 221, 175, 53, 161, 147, 97, 122, 186, 204, 65, 115, 73, 174, 32, 65, 49, 18, 230, 250, 78, 137, 169, 126, 162, 10, 158, 238, 230, 75, 85, 211, 154, 33, 146, 153, 42, 39, 79, 193, 168, 54, 186, 60, 35, 163, 254, 235, 189, 69, 77, 68, 35, 100, 60, 232, 14, 42, 154, 201, 79, 165, 76, 164, 159 }
    let sha3_256_abc: [32]u8 = [32]u8{ 58, 152, 93, 167, 79, 226, 37, 178, 4, 92, 23, 45, 107, 211, 144, 189, 133, 95, 8, 110, 62, 157, 82, 91, 70, 191, 226, 69, 17, 67, 21, 50 }
    let sha3_512_abc: [64]u8 = [64]u8{ 183, 81, 133, 11, 26, 87, 22, 138, 86, 147, 205, 146, 75, 107, 9, 110, 8, 246, 33, 130, 116, 68, 247, 13, 136, 79, 93, 2, 64, 210, 113, 46, 16, 225, 22, 233, 25, 42, 243, 201, 26, 126, 197, 118, 71, 227, 147, 64, 87, 52, 11, 76, 244, 8, 213, 165, 101, 146, 248, 39, 78, 236, 83, 240 }
    let sha1_abc: [20]u8 = [20]u8{ 169, 153, 62, 54, 71, 6, 129, 106, 186, 62, 37, 113, 120, 80, 194, 108, 156, 208, 216, 157 }
    let md5_abc: [16]u8 = [16]u8{ 144, 1, 80, 152, 60, 210, 79, 176, 214, 150, 63, 125, 40, 225, 127, 114 }
    let sha256_empty: [32]u8 = [32]u8{ 227, 176, 196, 66, 152, 252, 28, 20, 154, 251, 244, 200, 153, 111, 185, 36, 39, 174, 65, 228, 100, 155, 147, 76, 164, 149, 153, 27, 120, 82, 184, 85 }
    let sha512_empty: [64]u8 = [64]u8{ 207, 131, 225, 53, 126, 239, 184, 189, 241, 84, 40, 80, 214, 109, 128, 7, 214, 32, 228, 5, 11, 87, 21, 220, 131, 244, 169, 33, 211, 108, 233, 206, 71, 208, 209, 60, 93, 133, 242, 176, 255, 131, 24, 210, 135, 126, 236, 47, 99, 185, 49, 189, 71, 65, 122, 129, 165, 56, 50, 122, 249, 39, 218, 62 }
    let sha3_256_empty: [32]u8 = [32]u8{ 167, 255, 198, 248, 191, 30, 215, 102, 81, 193, 71, 86, 160, 97, 214, 98, 245, 128, 255, 77, 228, 59, 73, 250, 130, 216, 10, 75, 128, 248, 67, 74 }
    let sha3_512_empty: [64]u8 = [64]u8{ 166, 159, 115, 204, 162, 58, 154, 197, 200, 181, 103, 220, 24, 90, 117, 110, 151, 201, 130, 22, 79, 226, 88, 89, 224, 209, 220, 193, 71, 92, 128, 166, 21, 178, 18, 58, 241, 245, 249, 76, 17, 227, 233, 64, 44, 58, 197, 88, 245, 0, 25, 157, 149, 182, 211, 227, 1, 117, 133, 134, 40, 29, 205, 38 }
    let sha1_empty: [20]u8 = [20]u8{ 218, 57, 163, 238, 94, 107, 75, 13, 50, 85, 191, 239, 149, 96, 24, 144, 175, 216, 7, 9 }
    let md5_empty: [16]u8 = [16]u8{ 212, 29, 140, 217, 143, 0, 178, 4, 233, 128, 9, 152, 236, 248, 66, 126 }
    let sha256_long: [32]u8 = [32]u8{ 65, 237, 236, 228, 45, 99, 232, 217, 191, 81, 90, 155, 166, 147, 46, 28, 32, 203, 201, 245, 165, 209, 52, 100, 90, 219, 93, 177, 185, 115, 126, 163 }
    let sha512_long: [64]u8 = [64]u8{ 103, 186, 85, 53, 164, 110, 63, 134, 219, 251, 237, 140, 187, 175, 1, 37, 199, 110, 213, 73, 255, 139, 11, 158, 3, 224, 200, 140, 249, 15, 166, 52, 250, 123, 18, 180, 125, 119, 182, 148, 222, 72, 138, 206, 141, 154, 101, 150, 125, 201, 109, 245, 153, 114, 125, 50, 146, 168, 217, 212, 71, 112, 156, 151 }
    let sha3_256_long: [32]u8 = [32]u8{ 143, 57, 52, 230, 247, 161, 86, 152, 254, 15, 57, 107, 149, 216, 196, 68, 9, 41, 168, 250, 110, 174, 20, 1, 113, 192, 104, 180, 84, 159, 191, 129 }
    let sha3_512_long: [64]u8 = [64]u8{ 172, 126, 149, 204, 149, 170, 127, 36, 170, 169, 94, 4, 12, 160, 199, 155, 57, 205, 156, 200, 74, 16, 171, 184, 77, 221, 141, 213, 228, 180, 92, 249, 101, 67, 170, 167, 13, 14, 249, 159, 191, 141, 39, 105, 99, 153, 129, 238, 31, 208, 176, 39, 111, 71, 86, 185, 213, 4, 208, 183, 222, 25, 183, 0 }
    let sha1_long: [20]u8 = [20]u8{ 41, 30, 154, 108, 102, 153, 73, 73, 181, 123, 165, 230, 80, 54, 30, 152, 252, 54, 177, 186 }
    let md5_long: [16]u8 = [16]u8{ 202, 190, 69, 220, 201, 174, 91, 102, 186, 134, 96, 12, 202, 107, 139, 168 }
    let sha256_two: [32]u8 = [32]u8{ 36, 141, 106, 97, 210, 6, 56, 184, 229, 192, 38, 147, 12, 62, 96, 57, 163, 60, 228, 89, 100, 255, 33, 103, 246, 236, 237, 212, 25, 219, 6, 193 }
    let sha512_two: [64]u8 = [64]u8{ 32, 74, 143, 198, 221, 168, 47, 10, 12, 237, 123, 235, 142, 8, 164, 22, 87, 193, 110, 244, 104, 178, 40, 168, 39, 155, 227, 49, 167, 3, 195, 53, 150, 253, 21, 193, 59, 27, 7, 249, 170, 29, 59, 234, 87, 120, 156, 160, 49, 173, 133, 199, 167, 29, 215, 3, 84, 236, 99, 18, 56, 202, 52, 69 }
    let sha3_256_two: [32]u8 = [32]u8{ 65, 192, 219, 162, 169, 214, 36, 8, 73, 16, 3, 118, 168, 35, 94, 44, 130, 225, 185, 153, 138, 153, 158, 33, 219, 50, 221, 151, 73, 109, 51, 118 }
    let sha3_512_two: [64]u8 = [64]u8{ 4, 163, 113, 232, 78, 207, 181, 184, 183, 124, 180, 134, 16, 252, 168, 24, 45, 212, 87, 206, 111, 50, 106, 15, 211, 215, 236, 47, 30, 145, 99, 109, 238, 105, 31, 190, 12, 152, 83, 2, 186, 27, 13, 141, 199, 140, 8, 99, 70, 181, 51, 180, 156, 3, 13, 153, 162, 125, 175, 17, 57, 214, 231, 94 }
    let sha1_two: [20]u8 = [20]u8{ 132, 152, 62, 68, 28, 59, 210, 110, 186, 174, 74, 161, 249, 81, 41, 229, 229, 70, 112, 241 }
    let md5_two: [16]u8 = [16]u8{ 130, 21, 239, 7, 150, 162, 11, 202, 170, 225, 22, 211, 135, 108, 102, 74 }
    let d1 = hash.sha256("abc")
    if !same(d1[0..], sha256_abc[0..]) { os.exit(1) }
    let d2 = hash.sha256(none[0..])
    if !same(d2[0..], sha256_empty[0..]) { os.exit(2) }
    let d3 = hash.sha256(long[0..])
    if !same(d3[0..], sha256_long[0..]) { os.exit(3) }
    let d4 = hash.sha256(two)
    if !same(d4[0..], sha256_two[0..]) { os.exit(4) }
    let e1 = hash.sha512("abc")
    if !same(e1[0..], sha512_abc[0..]) { os.exit(5) }
    let e2 = hash.sha512(none[0..])
    if !same(e2[0..], sha512_empty[0..]) { os.exit(6) }
    let e3 = hash.sha512(long[0..])
    if !same(e3[0..], sha512_long[0..]) { os.exit(7) }
    let e4 = hash.sha512(two)
    if !same(e4[0..], sha512_two[0..]) { os.exit(8) }
    let f1 = hash.sha3_256("abc")
    if !same(f1[0..], sha3_256_abc[0..]) { os.exit(9) }
    let f2 = hash.sha3_256(none[0..])
    if !same(f2[0..], sha3_256_empty[0..]) { os.exit(10) }
    let f3 = hash.sha3_256(long[0..])
    if !same(f3[0..], sha3_256_long[0..]) { os.exit(11) }
    let f4 = hash.sha3_256(two)
    if !same(f4[0..], sha3_256_two[0..]) { os.exit(12) }
    let g1 = hash.sha3_512("abc")
    if !same(g1[0..], sha3_512_abc[0..]) { os.exit(13) }
    let g2 = hash.sha3_512(none[0..])
    if !same(g2[0..], sha3_512_empty[0..]) { os.exit(14) }
    let g3 = hash.sha3_512(long[0..])
    if !same(g3[0..], sha3_512_long[0..]) { os.exit(15) }
    let g4 = hash.sha3_512(two)
    if !same(g4[0..], sha3_512_two[0..]) { os.exit(16) }
    let h1 = hash.legacy_sha1("abc")
    if !same(h1[0..], sha1_abc[0..]) { os.exit(17) }
    let h2 = hash.legacy_sha1(none[0..])
    if !same(h2[0..], sha1_empty[0..]) { os.exit(18) }
    let h3 = hash.legacy_sha1(long[0..])
    if !same(h3[0..], sha1_long[0..]) { os.exit(19) }
    let h4 = hash.legacy_sha1(two)
    if !same(h4[0..], sha1_two[0..]) { os.exit(20) }
    let m1 = hash.legacy_md5("abc")
    if !same(m1[0..], md5_abc[0..]) { os.exit(21) }
    let m2 = hash.legacy_md5(none[0..])
    if !same(m2[0..], md5_empty[0..]) { os.exit(22) }
    let m3 = hash.legacy_md5(long[0..])
    if !same(m3[0..], md5_long[0..]) { os.exit(23) }
    let m4 = hash.legacy_md5(two)
    if !same(m4[0..], md5_two[0..]) { os.exit(24) }
    // Streaming in odd pieces gives the one-call digest.
    var s = hash.sha256_init()
    hash.sha256_update(&s, long[..3])
    hash.sha256_update(&s, long[3..700])
    hash.sha256_update(&s, long[700..])
    let streamed = hash.sha256_done(&s)
    if !same(streamed[0..], sha256_long[0..]) { os.exit(25) }
    var s5 = hash.sha512_init()
    hash.sha512_update(&s5, long[..129])
    hash.sha512_update(&s5, long[129..])
    let streamed5 = hash.sha512_done(&s5)
    if !same(streamed5[0..], sha512_long[0..]) { os.exit(26) }
    var s3 = hash.sha3_256_init()
    hash.sha3_256_update(&s3, long[..137])
    hash.sha3_256_update(&s3, long[137..])
    let streamed3 = hash.sha3_256_done(&s3)
    if !same(streamed3[0..], sha3_256_long[0..]) { os.exit(27) }
    var s35 = hash.sha3_512_init()
    hash.sha3_512_update(&s35, long[..73])
    hash.sha3_512_update(&s35, long[73..])
    let streamed35 = hash.sha3_512_done(&s35)
    if !same(streamed35[0..], sha3_512_long[0..]) { os.exit(28) }
    if !hash.equal_constant_time(d1[0..], sha256_abc[0..]) || hash.equal_constant_time(d1[0..], d2[0..]) || hash.equal_constant_time(d1[0..], h1[0..]) { os.exit(29) }
    os.exit(0)
    ret ok
}
