    if run_chunk(a, vectors_7()) != 0u8 { os.exit(107i32) }
    if run_chunk(a, vectors_8()) != 0u8 { os.exit(108i32) }
    if run_chunk(a, vectors_9()) != 0u8 { os.exit(109i32) }
    if run_chunk(a, vectors_10()) != 0u8 { os.exit(110i32) }
