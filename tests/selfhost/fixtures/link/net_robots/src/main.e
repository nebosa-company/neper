// e.net.robots against the protego package (RFC 9309): random documents with decorated field names,
// comments, CRLF, merged groups, wildcard and `$` patterns, and queries for allow/disallow, crawl delay
// and sitemaps; plus the RFC 9309 section 5.1 example (D2803). D document, Q query, C crawl delay, M
// sitemap. Generated by scripts/gen_robots_test.py.
use e.io
use e.mem
use e.os
use e.net.robots

fn text_is(a: str, b: str) -> bool {
    if a.len != b.len { ret false }
    var i = 0usize
    while i < a.len {
        if a[i] != b[i] { ret false }
        i += 1usize
    }
    ret true
}

fn tok(line: str, at: usize) -> (str, usize) {
    var p = at
    while p < line.len && line[p] == 32u8 { p += 1usize }
    let start = p
    while p < line.len && line[p] != 32u8 { p += 1usize }
    ret (line[start..p], p)
}

fn dec(s: str) -> i64 {
    var v = 0i64
    var neg = false
    var i = 0usize
    if s.len > 0usize && s[0usize] == 45u8 {
        neg = true
        i = 1usize
    }
    while i < s.len {
        v = v * 10i64 + i64(s[i] - 48u8)
        i += 1usize
    }
    if neg { ret 0i64 - v }
    ret v
}


fn hexval(c: u8) -> u8 {
    if c >= 97u8 { ret c - 87u8 }
    ret c - 48u8
}

fn unhex(s: str, out: []u8) -> usize {
    if s.len == 1usize && s[0usize] == 45u8 { ret 0usize }
    var i = 0usize
    while i + 1usize < s.len {
        out[i / 2usize] = hexval(s[i]) * 16u8 + hexval(s[i + 1usize])
        i += 2usize
    }
    ret s.len / 2usize
}

// The checker is stateful: a `D` line parses a document that the `Q`, `C` and `M` lines after
// it query, so the vectors are walked here rather than line by line.
type Ctx = struct { robots: robots.Robots, loaded: bool, sitemap_at: usize }

fn check_line(a: *mem.Arena, c: *Ctx, doc: []u8, line: str) -> u8 {
    var path: [256]u8 = zero
    let (kind, p0) = tok(line, 0usize)
    let k = kind[0usize]
    if k == 68u8 {
        let (h, p1) = tok(line, p0)
        let n = unhex(h, doc[0usize..16384usize])
        let (r, e) = robots.parse(a, doc[0usize..n])
        if e != ok { ret 1u8 }
        c.robots = r
        c.loaded = true
        c.sitemap_at = 0usize
        ret 0u8
    }
    if !c.loaded { ret 2u8 }
    if k == 81u8 {
        let (agent, p1) = tok(line, p0)
        let (h, p2) = tok(line, p1)
        let (want, p3) = tok(line, p2)
        let n = unhex(h, path[0usize..256usize])
        let got = robots.allowed(&c.robots, agent, path[0usize..n])
        if got != (want[0usize] == 49u8) { ret 11u8 }
        ret 0u8
    }
    if k == 67u8 {
        let (agent, p1) = tok(line, p0)
        let (want, p2) = tok(line, p1)
        let (ms, has) = robots.crawl_delay(&c.robots, agent)
        if dec(want) < 0i64 {
            if has { ret 21u8 }
            ret 0u8
        }
        if !has || i64(ms) != dec(want) { ret 22u8 }
        ret 0u8
    }
    // M: the next sitemap
    let (h, p1) = tok(line, p0)
    let n = unhex(h, path[0usize..256usize])
    if c.sitemap_at >= c.robots.sitemaps.len { ret 31u8 }
    if !text_is(c.robots.sitemaps[c.sitemap_at], path[0usize..n]) { ret 32u8 }
    c.sitemap_at += 1usize
    ret 0u8
}

fn run_chunk(a: *mem.Arena, c: *Ctx, doc: []u8, text: str) -> u8 {
    var start = 0usize
    var i = 0usize
    while i < text.len {
        if text[i] == 10u8 {
            let code = check_line(a, c, doc, text[start..i])
            if code != 0u8 {
                let shown = io.print(text[start..i])
                ret code
            }
            start = i + 1usize
        }
        i += 1usize
    }
    ret 0u8
}

