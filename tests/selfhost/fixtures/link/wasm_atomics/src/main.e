fn bump(p: *Atomic[u32], by: u32) -> u32 {
    ret atomic.add(p, by, .AcqRel)
}

fn run_places() {
    var pair: Pair = zero
    atomic.store(&pair.a, 65000u16, .Relaxed)
    let before = atomic.add(&pair.a, 600u16, .Relaxed)
    show_u("field u16 add", u64(before), u64(atomic.load(&pair.a, .Relaxed)), 65000u64, 64u64)
    atomic.store(&pair.b, -9000000000000000000i64, .Relaxed)
    let gave = atomic.max(&pair.b, -1i64, .SeqCst)
    show_i("field i64 max", i64(gave), i64(atomic.load(&pair.b, .Relaxed)), -9000000000000000000i64, -1i64)
    var spare: Atomic[u32] = zero
    let first = atomic.xchg(&spare, 4000000000u32, .AcqRel)
    show_u("local u32 xchg", u64(first), u64(atomic.load(&spare, .Acquire)), 0u64, 4000000000u64)
    let wrapped = atomic.add(&spare, 500000000u32, .Relaxed)
    show_u("local u32 add", u64(wrapped), u64(atomic.load(&spare, .Relaxed)), 4000000000u64, 205032704u64)
    var ring: [4]Atomic[u32] = zero
    var index = 0usize
    while index < 4usize {
        let from = bump(&ring[index], u32(index + 1usize) * 1000u32)
        show_u("ring u32 add", u64(from), u64(atomic.load(&ring[index], .Relaxed)), 0u64, u64(index + 1usize) * 1000u64)
        index += 1usize
    }
    atomic.fence(.Acquire)
    atomic.fence(.Release)
    atomic.fence(.AcqRel)
    atomic.fence(.SeqCst)
    say("fences done\n")
}

fn main() -> err {
    run_i8()
    run_u8()
    run_i16()
    run_u16()
    run_i32()
    run_u32()
    run_i64()
    run_u64()
    run_places()
    if bad != 0u32 {
        say("FAILED\n")
        ret Failed
    }
    say("atomics ok\n")
    ret ok
}
