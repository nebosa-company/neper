// Section 8's atomics at every width (C201, D5672): load, store, add, sub, and, or, xor,
// xchg, min and max (signed and unsigned) and compare-and-swap (success and failure) at 8,
// 16, 32 and 64 bits, a fence of each ordering, and the same through a field, a local, an
// array element and a pointer parameter. Each operation prints the value it gave back and
// the value the cell then holds, and the program exits 1 when either differs from the
// number worked out by two's complement arithmetic (generated, not hand-written). The same
// stdout on x64, on wasm32-wasi and on wasm32-wasi --threads, where the five opcodes are the
// threads proposal's instructions.
use e.atomic
use e.os

error Failed

type Pair = struct { a: Atomic[u16], b: Atomic[i64] }

var bad: u32 = 0u32

fn say(text: str) {
    let (written, write_error) = os.write(os.stdout(), text)
}

fn put_u(value: u64) {
    var digits: [20]u8 = zero
    var at = 20usize
    var rest = value
    if rest == 0u64 {
        at -= 1usize
        digits[at] = 48u8
    }
    while rest != 0u64 {
        at -= 1usize
        digits[at] = u8(48u64 + rest % 10u64)
        rest = rest / 10u64
    }
    let (written, write_error) = os.write(os.stdout(), digits[at..20usize])
}

fn put_i(value: i64) {
    if value < 0i64 {
        say("-")
        put_u(u64(-(value + 1i64)) + 1u64)
    } else {
        put_u(u64(value))
    }
}

fn show_i(label: str, old: i64, now: i64, want_old: i64, want_now: i64) {
    say(label)
    say(" ")
    put_i(old)
    say(" ")
    put_i(now)
    say("\n")
    if old != want_old || now != want_now { bad += 1u32 }
}

fn show_u(label: str, old: u64, now: u64, want_old: u64, want_now: u64) {
    say(label)
    say(" ")
    put_u(old)
    say(" ")
    put_u(now)
    say("\n")
    if old != want_old || now != want_now { bad += 1u32 }
}

fn expect(label: str, got: bool, want: bool) {
    say(label)
    if got { say(" won\n") } else { say(" lost\n") }
    if got != want { bad += 1u32 }
}

fn run_i8() {
    var cell: Atomic[i8] = zero
    var old: i8 = 0i8
    atomic.store(&cell, -67i8, .Release)
    old = atomic.load(&cell, .SeqCst)
    show_i("i8 store-load", i64(old), i64(atomic.load(&cell, .Relaxed)), -67i64, -67i64)
    old = atomic.add(&cell, 57i8, .Relaxed)
    show_i("i8 add", i64(old), i64(atomic.load(&cell, .Relaxed)), -67i64, -10i64)
    old = atomic.sub(&cell, -67i8, .AcqRel)
    show_i("i8 sub", i64(old), i64(atomic.load(&cell, .Relaxed)), -10i64, 57i64)
    old = atomic.xchg(&cell, 57i8, .SeqCst)
    show_i("i8 xchg", i64(old), i64(atomic.load(&cell, .Relaxed)), 57i64, 57i64)
    old = atomic.and(&cell, -67i8, .Acquire)
    show_i("i8 and", i64(old), i64(atomic.load(&cell, .Relaxed)), 57i64, 57i64)
    old = atomic.or(&cell, 3i8, .Release)
    show_i("i8 or", i64(old), i64(atomic.load(&cell, .Relaxed)), 57i64, 59i64)
    old = atomic.xor(&cell, -67i8, .Relaxed)
    show_i("i8 xor", i64(old), i64(atomic.load(&cell, .Relaxed)), 59i64, -122i64)
    old = atomic.add(&cell, 5i8, .AcqRel)
    show_i("i8 add", i64(old), i64(atomic.load(&cell, .Relaxed)), -122i64, -117i64)
    atomic.store(&cell, -67i8, .Relaxed)
    old = atomic.min(&cell, 57i8, .SeqCst)
    show_i("i8 min", i64(old), i64(atomic.load(&cell, .Relaxed)), -67i64, -67i64)
    old = atomic.max(&cell, 57i8, .Acquire)
    show_i("i8 max", i64(old), i64(atomic.load(&cell, .Relaxed)), -67i64, 57i64)
    old = atomic.min(&cell, -67i8, .Release)
    show_i("i8 min", i64(old), i64(atomic.load(&cell, .Relaxed)), 57i64, -67i64)
    old = atomic.max(&cell, -67i8, .Relaxed)
    show_i("i8 max", i64(old), i64(atomic.load(&cell, .Relaxed)), -67i64, -67i64)
    old = atomic.min(&cell, 5i8, .AcqRel)
    show_i("i8 min", i64(old), i64(atomic.load(&cell, .Relaxed)), -67i64, -67i64)
    old = atomic.max(&cell, 5i8, .SeqCst)
    show_i("i8 max", i64(old), i64(atomic.load(&cell, .Relaxed)), -67i64, 5i64)
    atomic.store(&cell, 57i8, .Relaxed)
    old = atomic.min(&cell, 57i8, .Acquire)
    show_i("i8 min", i64(old), i64(atomic.load(&cell, .Relaxed)), 57i64, 57i64)
    old = atomic.max(&cell, 57i8, .Release)
    show_i("i8 max", i64(old), i64(atomic.load(&cell, .Relaxed)), 57i64, 57i64)
    old = atomic.min(&cell, -67i8, .Relaxed)
    show_i("i8 min", i64(old), i64(atomic.load(&cell, .Relaxed)), 57i64, -67i64)
    old = atomic.max(&cell, -67i8, .AcqRel)
    show_i("i8 max", i64(old), i64(atomic.load(&cell, .Relaxed)), -67i64, -67i64)
    old = atomic.min(&cell, 5i8, .SeqCst)
    show_i("i8 min", i64(old), i64(atomic.load(&cell, .Relaxed)), -67i64, -67i64)
    old = atomic.max(&cell, 5i8, .Acquire)
    show_i("i8 max", i64(old), i64(atomic.load(&cell, .Relaxed)), -67i64, 5i64)
    atomic.store(&cell, -67i8, .Relaxed)
    let (won1, seen1) = atomic.cas(&cell, -67i8, 57i8, .AcqRel, .Acquire)
    expect("i8 cas-hit", won1, true)
    show_i("i8 cas-hit", i64(seen1), i64(atomic.load(&cell, .Relaxed)), -67i64, 57i64)
    let (won2, seen2) = atomic.cas(&cell, -67i8, 5i8, .SeqCst, .SeqCst)
    expect("i8 cas-miss", won2, false)
    show_i("i8 cas-miss", i64(seen2), i64(atomic.load(&cell, .Relaxed)), 57i64, 57i64)
    let (won3, seen3) = atomic.cas(&cell, -71i8, 5i8, .Release, .Relaxed)
    expect("i8 cas-top-bit", won3, false)
    show_i("i8 cas-top-bit", i64(seen3), i64(atomic.load(&cell, .Relaxed)), 57i64, 57i64)
}

