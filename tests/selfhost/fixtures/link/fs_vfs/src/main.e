    if !clean_is(a, ".//.../cc/b", "/.../cc/b") { ret 31i32 }
    if !clean_is(a, "/cc/b/./a", "/cc/b/a") { ret 32i32 }
    if !clean_is(a, "/a//b/../cc", "/a/cc") { ret 33i32 }
    if !clean_invalid(a, "./..//../././b") { ret 34i32 }
    if !clean_is(a, "/.../b/a//./", "/.../b/a") { ret 35i32 }
    if !clean_is(a, "cc/../.", "/") { ret 36i32 }
    if !clean_is(a, "/", "/") { ret 37i32 }
    if !clean_is(a, ".../.", "/...") { ret 38i32 }
    if !clean_invalid(a, "/../a/cc/a") { ret 39i32 }
