    if !step(a, v, 2u8, "/./c/./dd/./e.txt/./e.txt/./e.txt/", "", false, "", 0usize) { ret 434i32 }
    if !step(a, v, 5u8, "/c/e.txt/g", "", false, "", 0usize) { ret 435i32 }
    if !step(a, v, 2u8, "/zz/../b/dd/g", "", false, "", 0usize) { ret 436i32 }
    if !step(a, v, 0u8, "/c/dd/e.txt/e.txt/f/b", "\xffZfg\x00cdc\x0abg\xffY\x20\x00i\xffiZjjfa\x00dbZ\xffjgejfh\x0aefgg\x0a", true, "", 0usize) { ret 437i32 }
    if !step(a, v, 5u8, "/zz/../c/dd/e.txt/b/g/f", "", false, "", 0usize) { ret 438i32 }
    if !step(a, v, 2u8, "dd/dd", "", false, "", 0usize) { ret 439i32 }
    if !step(a, v, 1u8, "/a/b/g", "", false, "", 0usize) { ret 440i32 }
    if !step(a, v, 4u8, "/c/dd/e.txt/f/e.txt/dd", "", false, "", 0usize) { ret 441i32 }
    if !step(a, v, 4u8, "/a/dd/f", "", false, "", 0usize) { ret 442i32 }
    if !step(a, v, 0u8, "c/c/f/b", "d", true, "", 0usize) { ret 443i32 }
    if !step(a, v, 0u8, "/b/a/f", "g", false, "", 0usize) { ret 444i32 }
    if !step(a, v, 1u8, "c/dd/e.txt/b/g/f", "", false, "", 0usize) { ret 445i32 }
    if !step(a, v, 0u8, "/c/dd/e.txt/f/a/e.txt", "\x20b\xffeZ", false, "", 0usize) { ret 446i32 }
    if !step(a, v, 0u8, "/zz/../dd", "j\x20cf\xff", true, "", 0usize) { ret 447i32 }
    if !step(a, v, 1u8, "/a//e.txt", "", false, "", 0usize) { ret 448i32 }
    if !step(a, v, 1u8, "/b/dd/g", "", true, "", 0usize) { ret 449i32 }
    if !step(a, v, 0u8, "/c/a/f/e.txt", "hcfaabhfXYjagefdj", true, "", 0usize) { ret 450i32 }
    ret 0i32
}

fn clean_cases(a: *mem.Arena) -> i32 {
    if !clean_is(a, "", "/") { ret 1i32 }
    if !clean_is(a, "/", "/") { ret 2i32 }
    if !clean_is(a, ".", "/") { ret 3i32 }
    if !clean_invalid(a, "..") { ret 4i32 }
    if !clean_invalid(a, "/..") { ret 5i32 }
    if !clean_is(a, "a", "/a") { ret 6i32 }
    if !clean_is(a, "/a", "/a") { ret 7i32 }
    if !clean_is(a, "a/", "/a") { ret 8i32 }
    if !clean_is(a, "//a///b//", "/a/b") { ret 9i32 }
    if !clean_is(a, "/a/./b/.", "/a/b") { ret 10i32 }
    if !clean_is(a, "/a/b/../c", "/a/c") { ret 11i32 }
    if !clean_is(a, "a/b/../../c", "/c") { ret 12i32 }
    if !clean_invalid(a, "a/../..") { ret 13i32 }
    if !clean_is(a, "/a/b/c/../../..", "/") { ret 14i32 }
    if !clean_invalid(a, "/a/b/c/../../../..") { ret 15i32 }
    if !clean_is(a, "./././", "/") { ret 16i32 }
    if !clean_is(a, "/..a/b", "/..a/b") { ret 17i32 }
    if !clean_is(a, "/a/..b/c", "/a/..b/c") { ret 18i32 }
    if !clean_is(a, "/a/b..", "/a/b..") { ret 19i32 }
    if !clean_is(a, "a\x5cb", "/a\x5cb") { ret 20i32 }
    if !clean_is(a, "/.hidden/./x", "/.hidden/x") { ret 21i32 }
    if !clean_is(a, "b/../cc", "/cc") { ret 22i32 }
    if !clean_is(a, "...", "/...") { ret 23i32 }
    if !clean_is(a, "/a/", "/a") { ret 24i32 }
    if !clean_is(a, "/a", "/a") { ret 25i32 }
    if !clean_is(a, "/a/b/a/", "/a/b/a") { ret 26i32 }
    if !clean_is(a, "...", "/...") { ret 27i32 }
    if !clean_is(a, "cc/cc", "/cc/cc") { ret 28i32 }
    if !clean_invalid(a, "/../a/b/a") { ret 29i32 }
