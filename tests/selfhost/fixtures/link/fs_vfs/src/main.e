    if !clean_is(a, "/cc/cc/a/a", "/cc/cc/a/a") { ret 42i32 }
    if !clean_is(a, "//cc/.../.././cc", "/cc/cc") { ret 43i32 }
    if !clean_is(a, "./a/.././b/", "/b") { ret 44i32 }
    if !clean_is(a, "a/b/.../.", "/a/b/...") { ret 45i32 }
    if !clean_invalid(a, "b/../../.../../a") { ret 46i32 }
    if !clean_invalid(a, "/..//./b") { ret 47i32 }
    if !clean_is(a, "/./cc/.././cc/..", "/") { ret 48i32 }
    if !clean_is(a, "a/b", "/a/b") { ret 49i32 }
    if !clean_is(a, "cc/b", "/cc/b") { ret 50i32 }
    if !clean_is(a, "/...//b/.", "/.../b") { ret 51i32 }
    if !clean_is(a, "/b", "/b") { ret 52i32 }
    if !clean_is(a, ".///./b", "/b") { ret 53i32 }
    if !clean_is(a, "/.../.../.../cc", "/.../.../.../cc") { ret 54i32 }
    if !clean_invalid(a, "/../../a/..") { ret 55i32 }
    if !clean_is(a, "b", "/b") { ret 56i32 }
    if !clean_invalid(a, "../b") { ret 57i32 }
    if !clean_is(a, "/a/a", "/a/a") { ret 58i32 }
    if !clean_is(a, "b//a/./", "/b/a") { ret 59i32 }
    if !clean_is(a, "...", "/...") { ret 60i32 }
    if !clean_invalid(a, "/../b/cc/./.") { ret 61i32 }
    if !clean_is(a, "/a/a/.../..", "/a/a") { ret 62i32 }
    if !clean_invalid(a, ".././a/b") { ret 63i32 }
    if !clean_is(a, "./cc/./../.../cc", "/.../cc") { ret 64i32 }
    if !clean_is(a, "a/b//./b", "/a/b/b") { ret 65i32 }
    if !clean_is(a, "//./cc/.../a/cc/...", "/cc/.../a/cc/...") { ret 66i32 }
    if !clean_is(a, "/./b/./.../b", "/b/.../b") { ret 67i32 }
    if !clean_is(a, "b//.../.../.../...", "/b/.../.../.../...") { ret 68i32 }
    if !clean_is(a, "/b/.../../cc/.../b/b", "/b/cc/.../b/b") { ret 69i32 }
    if !clean_is(a, "/cc/a/a", "/cc/a/a") { ret 70i32 }
    if !clean_is(a, "/./b/cc/", "/b/cc") { ret 71i32 }
    if !clean_is(a, ".../cc/./.", "/.../cc") { ret 72i32 }
    if !clean_is(a, "/a/b", "/a/b") { ret 73i32 }
    if !clean_is(a, "/./b", "/b") { ret 74i32 }
    if !clean_is(a, "//.../a/../cc", "/.../cc") { ret 75i32 }
    if !clean_is(a, "cc/a/.../cc/a/../...", "/cc/a/.../cc/...") { ret 76i32 }
    if !clean_is(a, "/b/../.../cc", "/.../cc") { ret 77i32 }
    if !clean_is(a, "/...", "/...") { ret 78i32 }
    if !clean_invalid(a, "../cc/a/cc") { ret 79i32 }
    if !clean_is(a, "b/a", "/b/a") { ret 80i32 }
    if !clean_invalid(a, "/../.../cc/b/") { ret 81i32 }
    ret 0i32
}

// ---- helpers for the hand-written scenarios --------------------------------------------

fn put(a: *mem.Arena, v: *vfs.Vfs, path: str, data: str) -> bool { ret vfs.write_file(a, v, path, data) == ok }

fn dir(a: *mem.Arena, v: *vfs.Vfs, path: str) -> bool { ret vfs.make_dir(a, v, path) == ok }

fn reads(a: *mem.Arena, v: *vfs.Vfs, path: str, want: str) -> bool {
    let (bytes, failure) = vfs.read_file(a, v, path, 65536usize)
    ret failure == ok && same(bytes, want)
}

fn fails(a: *mem.Arena, v: *vfs.Vfs, path: str, want: err) -> bool {
    let (_, failure) = vfs.stat(a, v, path)
    ret failure == want
}

fn names(a: *mem.Arena, v: *vfs.Vfs, path: str, want: str) -> bool {
    var line: [1024]u8 = zero
    var n = 0usize
    let (entries, failure) = vfs.list(a, v, path)
    if failure != ok { ret false }
    var i = 0usize
    while i < entries.len {
        let name = vfs.base_of(entries[i].path)
        var k = 0usize
        while k < name.len {
            line[n] = name[k]
            n += 1usize
            k += 1usize
        }
        if entries[i].kind == .Directory {
            line[n] = 47u8
            n += 1usize
        }
        line[n] = 32u8
        n += 1usize
        i += 1usize
    }
    if n > 0usize { n -= 1usize }
    ret same(line[..n], want)
}

fn build_lower(a: *mem.Arena, v: *vfs.Vfs) -> bool {
    if !dir(a, v, "/etc") { ret false }
    if !put(a, v, "/etc/hosts", "lower hosts") { ret false }
    if !dir(a, v, "/etc/conf.d") { ret false }
    if !put(a, v, "/etc/conf.d/a", "A") { ret false }
    if !dir(a, v, "/var") { ret false }
    if !dir(a, v, "/var/log") { ret false }
    if !put(a, v, "/var/log/x.log", "log") { ret false }
    if !dir(a, v, "/bin") { ret false }
    if !put(a, v, "/bin/sh", "sh") { ret false }
    ret true
}

// Layering: copy-up of parent directories, whiteouts, opaque directories, composition.
fn overlay_scenarios(a: *mem.Arena) -> i32 {
    let (lower, lower_error) = vfs.mem_new(a, 4usize)
    if lower_error != ok { ret 1i32 }
    var lower_store = lower
    var lv = vfs.mem_vfs(&lower_store)
    if !build_lower(a, &lv) { ret 2i32 }
    let (upper, upper_error) = vfs.mem_new(a, 4usize)
    if upper_error != ok { ret 3i32 }
    var upper_store = upper
    var uv = vfs.mem_vfs(&upper_store)
    let (over, over_error) = vfs.overlay_new(a, uv, lv, 2usize)
    if over_error != ok { ret 4i32 }
    var o = over
    var ov = vfs.overlay_vfs(&o)
    // reads fall through; the upper stays empty
    if !reads(a, &ov, "/etc/hosts", "lower hosts") { ret 10i32 }
    if !names(a, &ov, "/", "bin/ etc/ var/") { ret 11i32 }
    if !names(a, &ov, "/etc", "conf.d/ hosts") { ret 12i32 }
    if !names(a, &uv, "/", "") { ret 13i32 }
    // a write lands in the upper and shadows the lower, which is untouched
    if !put(a, &ov, "/etc/hosts", "upper hosts") { ret 20i32 }
    if !reads(a, &ov, "/etc/hosts", "upper hosts") { ret 21i32 }
    if !reads(a, &lv, "/etc/hosts", "lower hosts") { ret 22i32 }
    if !reads(a, &uv, "/etc/hosts", "upper hosts") { ret 23i32 }
    if !names(a, &uv, "/", "etc/") { ret 24i32 }
    // a new file deep in a lower-only directory copies the parents up
    if !put(a, &ov, "/var/log/y.log", "y") { ret 30i32 }
    if !names(a, &ov, "/var/log", "x.log y.log") { ret 31i32 }
    if !names(a, &lv, "/var/log", "x.log") { ret 32i32 }
    if !names(a, &uv, "/var", "log/") { ret 33i32 }
    // remove a lower file: whiteout, and a rewrite brings it back
    if vfs.remove(a, &ov, "/etc/conf.d/a") != ok { ret 40i32 }
    if !fails(a, &ov, "/etc/conf.d/a", fs.NotFound) { ret 41i32 }
    if !reads(a, &lv, "/etc/conf.d/a", "A") { ret 42i32 }
    if !names(a, &ov, "/etc/conf.d", "") { ret 43i32 }
    // remove the now empty lower directory, then make it again: opaque, the old file stays gone
    if vfs.remove(a, &ov, "/etc/conf.d") != ok { ret 44i32 }
    if !fails(a, &ov, "/etc/conf.d", fs.NotFound) { ret 45i32 }
    if !names(a, &ov, "/etc", "hosts") { ret 46i32 }
    if !fails(a, &ov, "/etc/conf.d/a", fs.NotFound) { ret 47i32 }
    if !dir(a, &ov, "/etc/conf.d") { ret 48i32 }
    if !names(a, &ov, "/etc/conf.d", "") { ret 49i32 }
    if !put(a, &ov, "/etc/conf.d/b", "B") { ret 50i32 }
    if !names(a, &ov, "/etc/conf.d", "b") { ret 51i32 }
    if !fails(a, &ov, "/etc/conf.d/a", fs.NotFound) { ret 52i32 }
    if !reads(a, &lv, "/etc/conf.d/a", "A") { ret 53i32 }
    // a whiteout over a file and a rewrite of the same name
    if vfs.remove(a, &ov, "/bin/sh") != ok { ret 60i32 }
    if !names(a, &ov, "/bin", "") { ret 61i32 }
    if !put(a, &ov, "/bin/sh", "new sh") { ret 62i32 }
    if !reads(a, &ov, "/bin/sh", "new sh") { ret 63i32 }
    if !reads(a, &lv, "/bin/sh", "sh") { ret 64i32 }
    // refusals
    if vfs.remove(a, &ov, "/var") != vfs.NotEmpty { ret 70i32 }
    if vfs.remove(a, &ov, "/nope") != fs.NotFound { ret 71i32 }
    if vfs.remove(a, &ov, "/") != fs.Invalid { ret 72i32 }
    if vfs.make_dir(a, &ov, "/etc") != fs.Exists { ret 73i32 }
    if vfs.write_file(a, &ov, "/etc", "x") != vfs.IsDirectory { ret 74i32 }
    if vfs.write_file(a, &ov, "/etc/hosts/x", "x") != vfs.NotDirectory { ret 75i32 }
    if vfs.make_dir(a, &ov, "/q/r") != fs.NotFound { ret 76i32 }
    if vfs.write_file(a, &ov, "/q/r", "x") != fs.NotFound { ret 77i32 }
    if vfs.write_file(a, &ov, "/../x", "x") != fs.Invalid { ret 78i32 }
    let (_, dir_read) = vfs.read_file(a, &ov, "/etc", 100usize)
    if dir_read != vfs.IsDirectory { ret 79i32 }
    let (_, file_list) = vfs.list(a, &ov, "/etc/hosts")
    if file_list != vfs.NotDirectory { ret 80i32 }
    let (_, over_limit) = vfs.read_file(a, &ov, "/etc/hosts", 3usize)
    if over_limit != vfs.TooLarge { ret 81i32 }
    // moving a directory moves its merged contents and leaves the lower intact
    if vfs.move(a, &ov, "/etc", "/etc2", 4096usize) != ok { ret 90i32 }
    if !names(a, &ov, "/", "bin/ etc2/ var/") { ret 91i32 }
    if !names(a, &ov, "/etc2", "conf.d/ hosts") { ret 92i32 }
    if !reads(a, &ov, "/etc2/hosts", "upper hosts") { ret 93i32 }
    if !reads(a, &ov, "/etc2/conf.d/b", "B") { ret 94i32 }
    if !fails(a, &ov, "/etc2/conf.d/a", fs.NotFound) { ret 95i32 }
    if !fails(a, &ov, "/etc", fs.NotFound) { ret 96i32 }
    if vfs.move(a, &ov, "/var", "/var/inner", 4096usize) != fs.Invalid { ret 97i32 }
    if vfs.move(a, &ov, "/bin", "/etc2", 4096usize) != fs.Exists { ret 98i32 }
    // the lower is exactly what it was
    if !names(a, &lv, "/", "bin/ etc/ var/") { ret 100i32 }
    if !names(a, &lv, "/etc", "conf.d/ hosts") { ret 101i32 }
    if !names(a, &lv, "/etc/conf.d", "a") { ret 102i32 }
    if !reads(a, &lv, "/etc/hosts", "lower hosts") { ret 103i32 }
    if !names(a, &lv, "/var/log", "x.log") { ret 104i32 }
    if !reads(a, &lv, "/bin/sh", "sh") { ret 105i32 }
    // composition: an overlay over an overlay sees the inner merged view
    let (top, top_error) = vfs.mem_new(a, 4usize)
    if top_error != ok { ret 110i32 }
    var top_store = top
    var tv = vfs.mem_vfs(&top_store)
    let (outer, outer_error) = vfs.overlay_new(a, tv, ov, 2usize)
    if outer_error != ok { ret 111i32 }
    var o2 = outer
    var o2v = vfs.overlay_vfs(&o2)
    if !reads(a, &o2v, "/etc2/hosts", "upper hosts") { ret 112i32 }
    if vfs.remove(a, &o2v, "/etc2/hosts") != ok { ret 113i32 }
    if !fails(a, &o2v, "/etc2/hosts", fs.NotFound) { ret 114i32 }
    if !reads(a, &ov, "/etc2/hosts", "upper hosts") { ret 115i32 }
    if !put(a, &o2v, "/var/log/z.log", "z") { ret 116i32 }
    if !names(a, &o2v, "/var/log", "x.log y.log z.log") { ret 117i32 }
    if !names(a, &ov, "/var/log", "x.log y.log") { ret 118i32 }
    ret 0i32
}

fn flatten_check(a: *mem.Arena, wide: *vfs.Vfs, flat: *vfs.Vfs, dir_path: str) -> bool {
    let (entries, failure) = vfs.list(a, wide, dir_path)
    if failure != ok { ret false }
    let (flat_entries, flat_failure) = vfs.list(a, flat, dir_path)
    if flat_failure != ok || flat_entries.len != entries.len { ret false }
    var i = 0usize
    while i < entries.len {
        if !same(entries[i].path, flat_entries[i].path) || entries[i].kind != flat_entries[i].kind || entries[i].size != flat_entries[i].size { ret false }
        if entries[i].kind == .Directory {
            if !flatten_check(a, wide, flat, entries[i].path) { ret false }
        } else {
            let (x, x_error) = vfs.read_file(a, wide, entries[i].path, 65536usize)
            let (y, y_error) = vfs.read_file(a, flat, entries[i].path, 65536usize)
            if x_error != ok || y_error != ok || !same(x, y) { ret false }
        }
        i += 1usize
    }
    ret true
}

fn union_scenarios(a: *mem.Arena) -> i32 {
    let (m0, m0_error) = vfs.mem_new(a, 2usize)
    let (m1, m1_error) = vfs.mem_new(a, 2usize)
    let (m2, m2_error) = vfs.mem_new(a, 2usize)
    if m0_error != ok || m1_error != ok || m2_error != ok { ret 1i32 }
    var s0 = m0
    var s1 = m1
    var s2 = m2
    var v0 = vfs.mem_vfs(&s0)
    var v1 = vfs.mem_vfs(&s1)
    var v2 = vfs.mem_vfs(&s2)
    if !dir(a, &v0, "/d") || !put(a, &v0, "/d/shared", "from 0") || !put(a, &v0, "/only0", "o0") { ret 2i32 }
    if !dir(a, &v1, "/d") || !put(a, &v1, "/d/shared", "from 1") || !put(a, &v1, "/d/one", "o1") { ret 3i32 }
    if !dir(a, &v2, "/d") || !dir(a, &v2, "/e") || !put(a, &v2, "/d/shared", "from 2") || !put(a, &v2, "/d/two", "o2") || !put(a, &v2, "/e/x", "ex") { ret 4i32 }
    if !put(a, &v2, "/only0", "shadowed") { ret 5i32 }
    let branches = [3]vfs.Vfs{ v0, v1, v2 }
    let (merged, merged_error) = vfs.union_new(a, branches[0..])
    if merged_error != ok { ret 6i32 }
    var u = merged
    var uv = vfs.union_vfs(&u)
    if !reads(a, &uv, "/d/shared", "from 0") { ret 10i32 }
    if !reads(a, &uv, "/d/two", "o2") { ret 11i32 }
    if !reads(a, &uv, "/only0", "o0") { ret 12i32 }
    if !names(a, &uv, "/", "d/ e/ only0") { ret 13i32 }
    if !names(a, &uv, "/d", "one shared two") { ret 14i32 }
    if !fails(a, &uv, "/none", fs.NotFound) { ret 15i32 }
    if vfs.write_file(a, &uv, "/d/new", "x") != fs.Denied { ret 20i32 }
    if vfs.make_dir(a, &uv, "/z") != fs.Denied { ret 21i32 }
    if vfs.remove(a, &uv, "/only0") != fs.Denied { ret 22i32 }
    let (_, file_list) = vfs.list(a, &uv, "/only0")
    if file_list != vfs.NotDirectory { ret 23i32 }
    // the union lists as the same tree a plain Mem holds after the branches are copied in
    // from the last to the first
    let (flat0, flat_error) = vfs.mem_new(a, 2usize)
    if flat_error != ok { ret 30i32 }
    var flat_store = flat0
    var fv = vfs.mem_vfs(&flat_store)
    if !dir(a, &fv, "/d") || !dir(a, &fv, "/e") { ret 31i32 }
    if !put(a, &fv, "/d/shared", "from 0") || !put(a, &fv, "/d/one", "o1") || !put(a, &fv, "/d/two", "o2") { ret 32i32 }
    if !put(a, &fv, "/e/x", "ex") || !put(a, &fv, "/only0", "o0") { ret 33i32 }
    if !flatten_check(a, &uv, &fv, "/") { ret 34i32 }
    // a union of one is a read-only view
    let one = [1]vfs.Vfs{ v1 }
    let (single, single_error) = vfs.union_new(a, one[0..])
    if single_error != ok { ret 40i32 }
    var su = single
    var suv = vfs.union_vfs(&su)
    if vfs.write_file(a, &suv, "/d/one", "x") != fs.Denied { ret 41i32 }
    if !reads(a, &suv, "/d/one", "o1") { ret 42i32 }
    let (_, empty_error) = vfs.union_new(a, branches[..0usize])
    if empty_error != fs.Invalid { ret 43i32 }
    ret 0i32
}

fn sub_scenarios(a: *mem.Arena) -> i32 {
    let (base, base_error) = vfs.mem_new(a, 4usize)
    if base_error != ok { ret 1i32 }
    var store = base
    var bv = vfs.mem_vfs(&store)
    if !dir(a, &bv, "/jail") || !dir(a, &bv, "/jail/in") || !put(a, &bv, "/secret", "outside") || !put(a, &bv, "/jail/in/f", "inside") { ret 2i32 }
    let (s, s_error) = vfs.sub_new(a, bv, "/jail/")
    if s_error != ok { ret 3i32 }
    var sub = s
    var sv = vfs.sub_vfs(&sub)
    if !reads(a, &sv, "/in/f", "inside") { ret 10i32 }
    if !names(a, &sv, "/", "in/") { ret 11i32 }
    if !names(a, &sv, "/in", "f") { ret 12i32 }
    let (e, e_error) = vfs.stat(a, &sv, "/in/f")
    if e_error != ok || !same(e.path, "/in/f") || e.size != 6u64 { ret 13i32 }
    // an escape is refused by every operation, and the outside is untouched
    if vfs.write_file(a, &sv, "/../secret", "pwned") != fs.Invalid { ret 20i32 }
    if vfs.write_file(a, &sv, "in/../../secret", "pwned") != fs.Invalid { ret 21i32 }
    if vfs.make_dir(a, &sv, "../x") != fs.Invalid { ret 22i32 }
    if vfs.remove(a, &sv, "../secret") != fs.Invalid { ret 23i32 }
    let (_, read_escape) = vfs.read_file(a, &sv, "../secret", 100usize)
    if read_escape != fs.Invalid { ret 24i32 }
    let (_, list_escape) = vfs.list(a, &sv, "/in/../..")
    if list_escape != fs.Invalid { ret 25i32 }
    if !reads(a, &bv, "/secret", "outside") { ret 26i32 }
    // an inner `..` that stays inside is fine, and an absolute path means the sub's root
    if !reads(a, &sv, "in/../in/f", "inside") { ret 30i32 }
    if !put(a, &sv, "/top", "t") { ret 31i32 }
    if !reads(a, &bv, "/jail/top", "t") { ret 32i32 }
    if vfs.remove(a, &sv, "/") != fs.Invalid { ret 33i32 }
    // a sub of a sub
    let (s2, s2_error) = vfs.sub_new(a, sv, "/in")
    if s2_error != ok { ret 40i32 }
    var sub2 = s2
    var sv2 = vfs.sub_vfs(&sub2)
    if !reads(a, &sv2, "/f", "inside") { ret 41i32 }
    if vfs.write_file(a, &sv2, "/../top", "pwned") != fs.Invalid { ret 42i32 }
    if !reads(a, &bv, "/jail/top", "t") { ret 43i32 }
    ret 0i32
}

// The differential run: an Overlay over a random lower against a plain Mem copy of it.
fn pick_name(r: u64) -> str {
    let n = r % 6u64
    if n == 0u64 { ret "etc" }
    if n == 1u64 { ret "var" }
    if n == 2u64 { ret "a" }
    if n == 3u64 { ret "b.txt" }
    if n == 4u64 { ret "conf.d" }
    ret "log"
}

fn next_random(state: *u64) -> u64 {
    *state = *state *% 6364136223846793005u64 +% 1442695040888963407u64
    ret (*state >> 33u32)
}

fn pick_path(a: *mem.Arena, state: *u64) -> str {
    let depth = 1u64 + next_random(state) % 3u64
    var buf: [128]u8 = zero
    var n = 0usize
    var d = 0u64
    while d < depth {
        buf[n] = 47u8
        n += 1usize
        let name = pick_name(next_random(state))
        var k = 0usize
        while k < name.len {
            buf[n] = name[k]
            n += 1usize
            k += 1usize
        }
        d += 1u64
    }
    let (out, out_error) = mem.alloc[u8](a, n)
    if out_error != ok { ret "/" }
    mem.copy[u8](out, buf[..n])
    ret out
}

fn pick_data(r: u64) -> str {
    let n = r % 5u64
    if n == 0u64 { ret "" }
    if n == 1u64 { ret "x" }
    if n == 2u64 { ret "hello" }
    if n == 3u64 { ret "line\nline\n" }
    ret "0123456789abcdef"
}

// Runs one random operation on both and compares everything observable.
fn paired_step(a: *mem.Arena, left: *vfs.Vfs, right: *vfs.Vfs, state: *u64) -> bool {
    let path = pick_path(a, state)
    let op = next_random(state) % 7u64
    if op <= 1u64 {
        let data = pick_data(next_random(state))
        ret vfs.write_file(a, left, path, data) == vfs.write_file(a, right, path, data)
    }
    if op == 2u64 { ret vfs.make_dir(a, left, path) == vfs.make_dir(a, right, path) }
    if op == 3u64 { ret vfs.remove(a, left, path) == vfs.remove(a, right, path) }
    if op == 4u64 {
        let (x, x_error) = vfs.read_file(a, left, path, 1024usize)
        let (y, y_error) = vfs.read_file(a, right, path, 1024usize)
        if x_error != y_error { ret false }
        ret x_error != ok || same(x, y)
    }
    if op == 5u64 {
        let (x, x_error) = vfs.stat(a, left, path)
        let (y, y_error) = vfs.stat(a, right, path)
        if x_error != y_error { ret false }
        ret x_error != ok || (x.kind == y.kind && x.size == y.size && same(x.path, y.path))
    }
    let (x, x_error) = vfs.list(a, left, path)
    let (y, y_error) = vfs.list(a, right, path)
    if x_error != y_error { ret false }
    if x_error != ok { ret true }
    if x.len != y.len { ret false }
    var i = 0usize
    while i < x.len {
        if !same(x[i].path, y[i].path) || x[i].kind != y[i].kind || x[i].size != y[i].size { ret false }
        i += 1usize
    }
    ret true
}

fn differential(a: *mem.Arena, seed: u64, steps: usize) -> i32 {
    let (lower, lower_error) = vfs.mem_new(a, 4usize)
    let (plain, plain_error) = vfs.mem_new(a, 4usize)
    let (upper, upper_error) = vfs.mem_new(a, 4usize)
    if lower_error != ok || plain_error != ok || upper_error != ok { ret 1i32 }
    var lower_store = lower
    var plain_store = plain
    var upper_store = upper
    var lv = vfs.mem_vfs(&lower_store)
    var pv = vfs.mem_vfs(&plain_store)
    var uv = vfs.mem_vfs(&upper_store)
    var state = seed
    // a random lower, built identically in the lower and in the plain copy
    var i = 0usize
    while i < 90usize {
        let path = pick_path(a, &state)
        let data = pick_data(next_random(&state))
        if next_random(&state) % 3u64 == 0u64 {
            if vfs.make_dir(a, &lv, path) != vfs.make_dir(a, &pv, path) { ret 2i32 }
        } else {
            if vfs.write_file(a, &lv, path, data) != vfs.write_file(a, &pv, path, data) { ret 3i32 }
        }
        i += 1usize
    }
    let (over, over_error) = vfs.overlay_new(a, uv, lv, 2usize)
    if over_error != ok { ret 4i32 }
    var o = over
    var ov = vfs.overlay_vfs(&o)
    var n = 0usize
    while n < steps {
        if !paired_step(a, &ov, &pv, &state) { ret i32(10usize + n) }
        n += 1usize
    }
    // the lower is what a plain Mem holds when nothing was done to it: rebuild it again
    // from the same seed and compare the trees
    let (again, again_error) = vfs.mem_new(a, 4usize)
    if again_error != ok { ret 5i32 }
    var again_store = again
    var av = vfs.mem_vfs(&again_store)
    var replay = seed
    i = 0usize
    while i < 90usize {
        let path = pick_path(a, &replay)
        let data = pick_data(next_random(&replay))
        if next_random(&replay) % 3u64 == 0u64 {
            let _ = vfs.make_dir(a, &av, path)
        } else {
            let _ = vfs.write_file(a, &av, path, data)
        }
        i += 1usize
    }
    if !flatten_check(a, &lv, &av, "/") { ret 6i32 }
    // and the merged view agrees with the plain copy as a whole tree
    if !flatten_check(a, &ov, &pv, "/") { ret 7i32 }
    ret 0i32
}

// ---- Host -------------------------------------------------------------------------------

fn wipe(a: *mem.Arena, v: *vfs.Vfs, path: str) {
    let (entries, failure) = vfs.list(a, v, path)
    if failure != ok { ret }
    var i = 0usize
    while i < entries.len {
        if entries[i].kind == .Directory { wipe(a, v, entries[i].path) }
        let _ = vfs.remove(a, v, entries[i].path)
        i += 1usize
    }
}

fn host_dir(a: *mem.Arena, leaf: str) -> (str, i32) {
    let (tmp, tmp_error) = fs.temp_dir(a)
    if tmp_error != ok { ret ("", 1i32) }
    let (joined, join_error) = vfs.join_path(a, tmp, leaf)
    if join_error != ok { ret ("", 2i32) }
    // join_path puts a root slash in front of a root `dir` only; tmp is not the root
    let made = fs.make_dir(a, joined)
    if made != ok && made != fs.Exists { ret ("", 3i32) }
    ret (joined, 0i32)
}

fn host_trace(a: *mem.Arena, number: i32) -> i32 {
    var leaf: [24]u8 = zero
    let stem = "neper_fs_vfs_t"
    mem.copy[u8](leaf[..stem.len], stem)
    leaf[stem.len] = u8(48i32 + number)
    let (root, setup) = host_dir(a, leaf[..stem.len + 1usize])
    if setup != 0i32 { ret 500i32 + setup }
    var host = vfs.host_new(root)
    var hv = vfs.host_vfs(&host)
    wipe(a, &hv, "/")
    var code = 0i32
    if number == 1i32 { code = trace_1(a, &hv) }
    if number == 2i32 { code = trace_2(a, &hv) }
    if number == 3i32 { code = trace_3(a, &hv) }
    if number == 4i32 { code = trace_4(a, &hv) }
    wipe(a, &hv, "/")
    let _ = fs.remove_dir(a, root)
    ret code
}

fn host_scenarios(a: *mem.Arena) -> i32 {
    let (root, setup) = host_dir(a, "neper_fs_vfs_scenario")
    if setup != 0i32 { ret setup }
    var host = vfs.host_new(root)
    var hv = vfs.host_vfs(&host)
    wipe(a, &hv, "/")
    var code = 0i32
    if !dir(a, &hv, "/d") || !put(a, &hv, "/d/f.txt", "on disk") { code = 10i32 }
    if code == 0i32 && !names(a, &hv, "/", "d/") { code = 11i32 }
    if code == 0i32 && !names(a, &hv, "/d", "f.txt") { code = 12i32 }
    if code == 0i32 {
        // the bytes are really where the host says, below the root
        let (full, full_error) = vfs.join_path(a, root, "d")
        if full_error != ok { code = 13i32 } else {
            let (inner, inner_error) = vfs.join_path(a, full, "f.txt")
            let (bytes, read_error) = fs.read_file(a, inner, 100usize)
            if inner_error != ok || read_error != ok || !same(bytes, "on disk") { code = 14i32 }
        }
    }
    if code == 0i32 && vfs.write_file(a, &hv, "/../escape.txt", "x") != fs.Invalid { code = 20i32 }
    if code == 0i32 && vfs.write_file(a, &hv, "d/../../escape.txt", "x") != fs.Invalid { code = 21i32 }
    if code == 0i32 && vfs.write_file(a, &hv, "/d\\..\\x", "x") != fs.Invalid { code = 22i32 }
    if code == 0i32 && vfs.write_file(a, &hv, "/c:evil", "x") != fs.Invalid { code = 23i32 }
    if code == 0i32 && vfs.remove(a, &hv, "/") != fs.Invalid { code = 24i32 }
    if code == 0i32 && vfs.make_dir(a, &hv, "/d") != fs.Exists { code = 25i32 }
    if code == 0i32 && vfs.remove(a, &hv, "/d") == ok { code = 26i32 }
    if code == 0i32 && vfs.remove(a, &hv, "/d/f.txt") != ok { code = 27i32 }
    if code == 0i32 && vfs.remove(a, &hv, "/d") != ok { code = 28i32 }
    if code == 0i32 && !fails(a, &hv, "/d", fs.NotFound) { code = 29i32 }
    // an overlay can sit on the real directory as its lower layer and keep it unchanged
    if code == 0i32 {
        if !dir(a, &hv, "/base") || !put(a, &hv, "/base/keep.txt", "keep") { code = 30i32 }
    }
    if code == 0i32 {
        let (upper, upper_error) = vfs.mem_new(a, 4usize)
        if upper_error != ok { code = 31i32 } else {
            var upper_store = upper
            var uv = vfs.mem_vfs(&upper_store)
            let (over, over_error) = vfs.overlay_new(a, uv, hv, 2usize)
            if over_error != ok { code = 32i32 } else {
                var o = over
                var ov = vfs.overlay_vfs(&o)
                if !reads(a, &ov, "/base/keep.txt", "keep") { code = 33i32 }
                if code == 0i32 && !put(a, &ov, "/base/keep.txt", "changed") { code = 34i32 }
                if code == 0i32 && !reads(a, &ov, "/base/keep.txt", "changed") { code = 35i32 }
                if code == 0i32 && !reads(a, &hv, "/base/keep.txt", "keep") { code = 36i32 }
                if code == 0i32 && vfs.remove(a, &ov, "/base/keep.txt") != ok { code = 37i32 }
                if code == 0i32 && !reads(a, &hv, "/base/keep.txt", "keep") { code = 38i32 }
                if code == 0i32 && !fails(a, &ov, "/base/keep.txt", fs.NotFound) { code = 39i32 }
            }
        }
    }
    wipe(a, &hv, "/")
    let _ = fs.remove_dir(a, root)
    ret code
}

fn main(a: *mem.Arena, args: []str) -> err {
    var code = clean_cases(a)
    if code != 0i32 {
        report("clean", code)
        os.exit(1i32)
    }
    let start = mem.mark(a)
    var number = 1i32
    while number <= 4i32 {
        let (base, base_error) = vfs.mem_new(a, 4usize)
        if base_error != ok { os.exit(2i32) }
        var store = base
        var v = vfs.mem_vfs(&store)
        if number == 1i32 { code = trace_1(a, &v) }
        if number == 2i32 { code = trace_2(a, &v) }
        if number == 3i32 { code = trace_3(a, &v) }
        if number == 4i32 { code = trace_4(a, &v) }
        if code != 0i32 {
            report("mem trace", code + number * 1000i32)
            os.exit(3i32)
        }
        // the same trace through a Sub with a prefix and through an Overlay over an empty lower
        let (inner, inner_error) = vfs.mem_new(a, 4usize)
        if inner_error != ok { os.exit(2i32) }
        var inner_store = inner
        var iv = vfs.mem_vfs(&inner_store)
        if !dir(a, &iv, "/p") || !dir(a, &iv, "/p/q") { os.exit(4i32) }
        let (sub0, sub_error) = vfs.sub_new(a, iv, "/p/q/../q")
        if sub_error != ok { os.exit(5i32) }
        var sub = sub0
        var sv = vfs.sub_vfs(&sub)
        if number == 1i32 { code = trace_1(a, &sv) }
        if number == 2i32 { code = trace_2(a, &sv) }
        if number == 3i32 { code = trace_3(a, &sv) }
        if number == 4i32 { code = trace_4(a, &sv) }
        if code != 0i32 {
            report("sub trace", code + number * 1000i32)
            os.exit(6i32)
        }
        let (up, up_error) = vfs.mem_new(a, 4usize)
        let (low, low_error) = vfs.mem_new(a, 4usize)
        if up_error != ok || low_error != ok { os.exit(2i32) }
        var up_store = up
        var low_store = low
        var upv = vfs.mem_vfs(&up_store)
        var lowv = vfs.mem_vfs(&low_store)
        let (over, over_error) = vfs.overlay_new(a, upv, lowv, 2usize)
        if over_error != ok { os.exit(7i32) }
        var o = over
        var ov = vfs.overlay_vfs(&o)
        if number == 1i32 { code = trace_1(a, &ov) }
        if number == 2i32 { code = trace_2(a, &ov) }
        if number == 3i32 { code = trace_3(a, &ov) }
        if number == 4i32 { code = trace_4(a, &ov) }
        if code != 0i32 {
            report("overlay trace", code + number * 1000i32)
            os.exit(8i32)
        }
        let hosted = host_trace(a, number)
        if hosted != 0i32 {
            report("host trace", hosted + number * 1000i32)
            os.exit(9i32)
        }
        mem.reset(a, start)
        number += 1i32
    }
    code = overlay_scenarios(a)
    if code != 0i32 {
        report("overlay", code)
        os.exit(10i32)
    }
    code = union_scenarios(a)
    if code != 0i32 {
        report("union", code)
        os.exit(11i32)
    }
    code = sub_scenarios(a)
    if code != 0i32 {
        report("sub", code)
        os.exit(12i32)
    }
    var seed = 1u64
    while seed <= 5u64 {
        let before = mem.mark(a)
        code = differential(a, seed * 7919u64, 700usize)
        if code != 0i32 {
            report("differential", code + i32(seed) * 10000i32)
            os.exit(13i32)
        }
        mem.reset(a, before)
        seed += 1u64
    }
    code = host_scenarios(a)
    if code != 0i32 {
        report("host", code)
        os.exit(14i32)
    }
    try io.print("fs vfs ok\n")
    ret ok
}
