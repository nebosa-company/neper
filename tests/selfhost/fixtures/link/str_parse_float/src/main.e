// `parse_f64` and `parse_f32` read back exactly what the float pushes write, and
// nothing else. The fixture pins the grammar, the non-finite tokens, both ends of
// each range, and the rounding -- including the exact ties, where the digits stop
// deciding and round-half-even does. Expected bit patterns come from rounding an
// exact rational, never from this implementation, and are compared as patterns so a
// signed zero and a NaN payload are covered too.

use e.mem
use e.str

error Failed

fn want64(text: str, pattern: u64) -> err {
    let (value, value_error) = str.parse_f64(text)
    if value_error != ok { ret value_error }
    if mem.bitcast[u64](value) != pattern { ret Failed }
    ret ok
}

fn want32(text: str, pattern: u32) -> err {
    let (value, value_error) = str.parse_f32(text)
    if value_error != ok { ret value_error }
    if mem.bitcast[u32](value) != pattern { ret Failed }
    ret ok
}

fn bad64(text: str) -> err {
    let (_, value_error) = str.parse_f64(text)
    if value_error != str.BadNumber { ret Failed }
    ret ok
}

fn bad32(text: str) -> err {
    let (_, value_error) = str.parse_f32(text)
    if value_error != str.BadNumber { ret Failed }
    ret ok
}

fn main(a: *mem.Arena, args: []str) -> err {
    // Ordinary values, and the classic decimals with no exact binary form.
    try want64("0.0", 0u64)
    try want64("1.0", 4607182418800017408u64)
    try want64("-1.0", 13830554455654793216u64)
    try want64("0.5", 4602678819172646912u64)
    try want64("123.456", 4638387860618067575u64)
    try want64("0.1", 4591870180066957722u64)
    try want64("0.2", 4596373779694328218u64)
    try want64("0.3", 4599075939470750515u64)
    try want64("1e-7", 4502148214488346440u64)
    try want64("1e22", 4936209963552724370u64)
    try want64("1e23", 4950912855330343670u64)
    try want64("-123.456e-7", 13756777218318488724u64)

    // A signed zero is preserved, and it is the only zero a parse may return.
    try want64("-0.0", 9223372036854775808u64)
    try want64("0e0", 0u64)
    try want64("-0e300", 9223372036854775808u64)
    try want32("-0.0", 2147483648u32)

    // The non-finite spellings are exact lowercase tokens, and the NaN handed back is
    // section 11's canonical quiet one rather than whatever an operation produced.
    try want64("inf", 9218868437227405312u64)
    try want64("-inf", 18442240474082181120u64)
    try want64("nan", 9221120237041090560u64)
    try want32("inf", 2139095040u32)
    try want32("-inf", 4286578688u32)
    try want32("nan", 2143289344u32)

    // Both ends of each range, and the two smallest subnormals.
    try want64("1.7976931348623157e308", 9218868437227405311u64)
    try want64("2.2250738585072014e-308", 4503599627370496u64)
    try want64("5e-324", 1u64)
    try want64("4.9e-324", 1u64)
    try want64("1e-323", 2u64)
    try want64("-5e-324", 9223372036854775809u64)
    try want32("3.4028235e38", 2139095039u32)
    try want32("1.1754944e-38", 8388608u32)
    try want32("1e-45", 1u32)

