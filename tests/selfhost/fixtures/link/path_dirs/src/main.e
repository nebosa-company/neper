// e.path.dirs against platformdirs 4.x: Linux (XDG), macOS and Windows (environment-variable route) directories for
// seeded environments, applications (names with spaces, authors, versions, escaping names), kinds and flags.
// A line is `PLATFORM|KIND|FLAGS|NAME|AUTHOR|VERSION|` the 18 Env fields in declaration order, then the expected
// answer (`-` is empty, `I` is Invalid, `U` is Unset); FLAGS letters are roaming, opinion, multipath, no-author.
use e.io
use e.mem
use e.os
use e.path
use e.path.dirs
use e.str

fn field(line: str, index: usize) -> str {
    var at = 0usize
    var current = 0usize
    var start = 0usize
    while at <= line.len {
        if at == line.len || line[at] == 124u8 {
            if current == index {
                let value = line[start..at]
                if value.len == 1usize && value[0usize] == 45u8 { ret "" }
                ret value
            }
            current += 1usize
            start = at + 1usize
        }
        at += 1usize
    }
    ret ""
}

fn has_flag(flags: str, c: u8) -> bool {
    var i = 0usize
    while i < flags.len {
        if flags[i] == c { ret true }
        i += 1usize
    }
    ret false
}

fn kind_of(name: str) -> dirs.Kind {
    if str.eq(name, "Data") { ret .Data }
    if str.eq(name, "Config") { ret .Config }
    if str.eq(name, "Cache") { ret .Cache }
    if str.eq(name, "State") { ret .State }
    if str.eq(name, "Log") { ret .Log }
    if str.eq(name, "Runtime") { ret .Runtime }
    if str.eq(name, "SiteData") { ret .SiteData }
    if str.eq(name, "SiteConfig") { ret .SiteConfig }
    if str.eq(name, "SiteCache") { ret .SiteCache }
    if str.eq(name, "SiteState") { ret .SiteState }
    if str.eq(name, "SiteLog") { ret .SiteLog }
    if str.eq(name, "Documents") { ret .Documents }
    if str.eq(name, "Downloads") { ret .Downloads }
    if str.eq(name, "Desktop") { ret .Desktop }
    if str.eq(name, "Pictures") { ret .Pictures }
    if str.eq(name, "Videos") { ret .Videos }
    ret .Music
}

fn answer(a: *mem.Arena, line: str) -> str {
    let platform_text = field(line, 0usize)
    var platform: dirs.Platform = .Linux
    if str.eq(platform_text, "MacOs") { platform = .MacOs }
    if str.eq(platform_text, "Windows") { platform = .Windows }
    let flags = field(line, 2usize)
    var app = dirs.app_named(field(line, 3usize))
    app.author = field(line, 4usize)
    app.version = field(line, 5usize)
    app.roaming = has_flag(flags, 114u8)
    app.opinion = has_flag(flags, 111u8)
    app.multipath = has_flag(flags, 109u8)
    app.no_author = has_flag(flags, 110u8)
    var env: dirs.Env = zero
    env.home = field(line, 6usize)
    env.user_profile = field(line, 7usize)
    env.app_data = field(line, 8usize)
    env.local_app_data = field(line, 9usize)
    env.all_users_profile = field(line, 10usize)
    env.xdg_data_home = field(line, 11usize)
    env.xdg_config_home = field(line, 12usize)
    env.xdg_cache_home = field(line, 13usize)
    env.xdg_state_home = field(line, 14usize)
    env.xdg_runtime_dir = field(line, 15usize)
    env.xdg_data_dirs = field(line, 16usize)
    env.xdg_config_dirs = field(line, 17usize)
    env.xdg_documents_dir = field(line, 18usize)
    env.xdg_download_dir = field(line, 19usize)
    env.xdg_desktop_dir = field(line, 20usize)
    env.xdg_pictures_dir = field(line, 21usize)
    env.xdg_videos_dir = field(line, 22usize)
    env.xdg_music_dir = field(line, 23usize)
    let (result, result_error) = dirs.dir(a, platform, env, kind_of(field(line, 1usize)), app)
    if result_error == dirs.Invalid { ret "I" }
    if result_error == dirs.Unset { ret "U" }
    if result_error != ok { ret "?" }
    ret result
}

fn run(a: *mem.Arena, text: str) -> u8 {
    var start = 0usize
    var i = 0usize
    while i < text.len {
        if text[i] == 10u8 {
            let line = text[start..i]
            let mark = mem.mark(a)
            let got = answer(a, line)
            let want = field(line, 24usize)
            if !str.eq(got, want) {
                try_print(line)
                ret 1u8
            }
            mem.reset(a, mark)
            start = i + 1usize
        }
        i += 1usize
    }
    ret 0u8
}

fn try_print(line: str) {
    let shown = io.print(line)
}
