fn fail(line: str) {
    let shown = io.print(line)
}

fn run_chunk(a: *mem.Arena, body: str) -> u8 {
    var start = 0usize
    var i = 0usize
    while i < body.len {
        if body[i] == 10u8 {
            let mark = mem.mark(a)
            let line = body[start..i]
            if !run_one(a, line) {
                fail(line)
                ret 1u8
            }
            mem.reset(a, mark)
            start = i + 1usize
        }
        i += 1usize
    }
    ret 0u8
}

fn main(a: *mem.Arena, args: []str) -> err {
    if run_chunk(a, vectors_0()) != 0u8 { os.exit(100i32) }
    if run_chunk(a, vectors_1()) != 0u8 { os.exit(101i32) }
    if run_chunk(a, vectors_2()) != 0u8 { os.exit(102i32) }
    if run_chunk(a, vectors_3()) != 0u8 { os.exit(103i32) }
    if run_chunk(a, vectors_4()) != 0u8 { os.exit(104i32) }
    if run_chunk(a, vectors_5()) != 0u8 { os.exit(105i32) }
    if run_chunk(a, vectors_6()) != 0u8 { os.exit(106i32) }
    if run_chunk(a, vectors_7()) != 0u8 { os.exit(107i32) }
