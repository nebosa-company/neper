    s = cat(a, cat(a, s, ":"), dec(a, u64(r.value)))
    s = cat(a, cat(a, s, ":"), dec(a, u64(r.and_mask)))
    s = cat(a, cat(a, s, ":"), dec(a, u64(r.or_mask)))
    s = cat(a, cat(a, s, ":"), hex(a, r.data))
    ret s
}

