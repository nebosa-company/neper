}

fn round_trip(a: *mem.Arena, source: image.ConstImage, expected: str, base: i32) -> i32 {
    let (buffer, buffer_error) = mem.alloc[u8](a, 65536usize)
    if buffer_error != ok { ret base + 1i32 }
    var sink = io.SliceWriter { data: buffer, off: 0usize }
    var w = io.slice_writer(&sink)
    if webp.encode(&w, source, webp.EncodeOptions { quality: 100.0, lossless: true }) != ok { ret base + 2i32 }
    var state: io.SliceReader = zero
    let (info, inspect_error) = webp.inspect(reader_of(&state, buffer[..sink.off]))
    if inspect_error != ok || info.width != source.width || info.height != source.height { ret base + 3i32 }
    let (decoded, decode_error) = webp.decode(a, reader_of(&state, buffer[..sink.off]), options())
    if decode_error != ok { ret base + 4i32 }
    if decoded.format != .Rgba8 || decoded.width != source.width || decoded.height != source.height { ret base + 5i32 }
    if worst(decoded, expected) != 0i32 { ret base + 6i32 }
    ret 0i32
}

fn main(a: *mem.Arena, args: []str) -> err {
    let c1 = check(a, lossless_webp(), lossless_pixels(), 23u32, 17u32, .Straight, 1u32, 0i32, 10i32)
    if c1 != 0i32 { os.exit(c1) }
    let c2 = check(a, lossless_small_webp(), lossless_small_pixels(), 23u32, 17u32, .Straight, 1u32, 0i32, 20i32)
    if c2 != 0i32 { os.exit(c2) }
    let c3 = check(a, lossy_webp(), lossy_pixels(), 23u32, 17u32, .Opaque, 1u32, 8i32, 30i32)
    if c3 != 0i32 { os.exit(c3) }
    let c4 = check(a, lossy_alpha_webp(), lossy_alpha_pixels(), 23u32, 17u32, .Straight, 1u32, 8i32, 40i32)
    if c4 != 0i32 { os.exit(c4) }
    let c5 = check(a, lossy_big_webp(), lossy_big_pixels(), 40u32, 33u32, .Opaque, 1u32, 8i32, 50i32)
    if c5 != 0i32 { os.exit(c5) }
    let c6 = check(a, animated_webp(), animated_pixels(), 9u32, 7u32, .Straight, 3u32, 0i32, 60i32)
    if c6 != 0i32 { os.exit(c6) }

    // Encoding: the libwebp-decoded lossless pixels as the source.
    let (rgba, rgba_error) = image.make_const(lossless_pixels(), 23u32, 17u32, 92usize, .Rgba8, .Straight)
    if rgba_error != ok { os.exit(70i32) }
    let r1 = round_trip(a, rgba, lossless_pixels(), 80i32)
    if r1 != 0i32 { os.exit(r1) }
    let (bgra_bytes, bgra_alloc) = mem.alloc[u8](a, lossless_pixels().len)
    if bgra_alloc != ok { os.exit(90i32) }
    var i = 0usize
    while i < bgra_bytes.len {
        bgra_bytes[i] = lossless_pixels()[i + 2usize]
        bgra_bytes[i + 1usize] = lossless_pixels()[i + 1usize]
        bgra_bytes[i + 2usize] = lossless_pixels()[i]
        bgra_bytes[i + 3usize] = lossless_pixels()[i + 3usize]
        i += 4usize
    }
    let (bgra, bgra_error) = image.make_const(bgra_bytes, 23u32, 17u32, 92usize, .Bgra8, .Straight)
    if bgra_error != ok { os.exit(91i32) }
    let r2 = round_trip(a, bgra, lossless_pixels(), 100i32)
    if r2 != 0i32 { os.exit(r2) }
    let (grey_bytes, grey_alloc) = mem.alloc[u8](a, 23usize * 17usize)
    let (grey_expected, grey_expected_alloc) = mem.alloc[u8](a, 23usize * 17usize * 4usize)
    if grey_alloc != ok || grey_expected_alloc != ok { os.exit(110i32) }
    i = 0usize
    while i < grey_bytes.len {
        grey_bytes[i] = lossless_pixels()[i * 4usize + 1usize]
        grey_expected[i * 4usize] = grey_bytes[i]
        grey_expected[i * 4usize + 1usize] = grey_bytes[i]
        grey_expected[i * 4usize + 2usize] = grey_bytes[i]
        grey_expected[i * 4usize + 3usize] = 255u8
        i += 1usize
    }
    let (grey, grey_error) = image.make_const(grey_bytes, 23u32, 17u32, 23usize, .R8, .Opaque)
    if grey_error != ok { os.exit(111i32) }
    let r3 = round_trip(a, grey, grey_expected, 120i32)
    if r3 != 0i32 { os.exit(r3) }

    // Refusals.
    var state: io.SliceReader = zero
    let (_, signature_error) = webp.decode(a, reader_of(&state, "RIFF definitely not a webp stream at all"), options())
    if signature_error != webp.Invalid { os.exit(140i32) }
    let (_, bounded_error) = webp.decode(a, reader_of(&state, lossless_webp()), webp.DecodeOptions { max_width: 16u32, max_height: 0u32, max_pixels: 0u64, first_frame_only: false })
    if bounded_error != webp.TooLarge { os.exit(141i32) }
    let (_, frames_error) = webp.decode(a, reader_of(&state, animated_webp()), options())
    if frames_error != webp.Unsupported { os.exit(142i32) }
    let (scratch, scratch_alloc) = mem.alloc[u8](a, 4096usize)
    if scratch_alloc != ok { os.exit(143i32) }
    var sink = io.SliceWriter { data: scratch, off: 0usize }
    var w = io.slice_writer(&sink)
    if webp.encode(&w, rgba, webp.EncodeOptions { quality: 80.0, lossless: false }) != webp.Unsupported { os.exit(144i32) }
    let (halves, halves_error) = image.allocate(a, 2u32, 2u32, .Rgba16Float, .Straight)
    let (half_view, half_view_error) = image.make_const(halves.pixels, 2u32, 2u32, 16usize, .Rgba16Float, .Straight)
    if halves_error != ok || half_view_error != ok { os.exit(145i32) }
    if webp.encode(&w, half_view, webp.EncodeOptions { quality: 80.0, lossless: true }) != webp.Unsupported { os.exit(146i32) }

    try io.print("fmt webp ok\n")
    ret ok
}
