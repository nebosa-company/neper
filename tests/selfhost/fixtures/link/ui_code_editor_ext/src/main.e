    ret v
}

fn has_flag(f: str, c: u8) -> bool {
    var i = 0usize
    while i < f.len {
        if f[i] == c { ret true }
        i += 1usize
    }
    ret false
}

// Numbers of `s` separated by `sep`, into out; returns how many.
fn split_nums(s: str, sep: u8, out: []usize) -> usize {
    var n = 0usize
    var start = 0usize
    var i = 0usize
    while i <= s.len {
        if i == s.len || s[i] == sep {
            if i > start && n < out.len {
                out[n] = parse_num(s[start..i])
                n += 1usize
            }
            start = i + 1usize
        }
        i += 1usize
    }
    ret n
}

fn rx_options(flags: str) -> rx.Options {
    ret rx.Options { case_insensitive: has_flag(flags, 105u8), multiline: has_flag(flags, 109u8), dot_matches_newline: false }
}

fn put_sels(o: *Out, e: *const ce.Editor) {
    var i = 0usize
    while i < e.nsel {
        if i > 0usize { put(o, 44u8) }
        put_num(o, e.sels[i].anchor)
        put(o, 46u8)
        put_num(o, e.sels[i].head)
        i += 1usize
    }
    put(o, 47u8)
    put_num(o, e.primary)
}

fn run_multi(o: *Out, e: *ce.Editor, fs: []const usize, fe: []const usize, nf: usize, src: str) {
    var f = 3usize
    while f < nf {
        let cmd = src[fs[f]..fe[f]]
        if f > 3usize { put(o, 124u8) }
        var res = ok
        let op = cmd[0usize]
        var nums: [64]usize = zero
        var nn = 0usize
        if cmd.len > 2usize { nn = split_nums(cmd[2usize..cmd.len], 32u8, nums[..]) }
        if op == 83u8 {
            var rs: [16]ce.Range = zero
            var k = 0usize
            while k + 1usize < nn && k / 2usize < 16usize {
                rs[k / 2usize] = ce.Range { anchor: nums[k], head: nums[k + 1usize], goal: ce.NO_GOAL }
                k += 2usize
            }
            res = ce.set_selection(e, rs[0usize..nn / 2usize], 0usize)
        } else if op == 85u8 {
            res = ce.add_cursor_vertical(e, true)
        } else if op == 68u8 {
            res = ce.add_cursor_vertical(e, false)
        } else if op == 82u8 {
            res = ce.select_rect(e, nums[0usize], nums[1usize])
        } else if op == 78u8 {
            res = ce.select_next_occurrence(e, ce.SearchOpts { case_sensitive: nums[0usize] == 1usize, whole_word: nums[1usize] == 1usize })
        } else if op == 65u8 {
            res = ce.select_all_occurrences(e, ce.SearchOpts { case_sensitive: nums[0usize] == 1usize, whole_word: nums[1usize] == 1usize })
        } else if op == 76u8 {
            res = ce.split_selection_by_line(e)
        }
        if res != ok { put(o, 33u8) }
        put_sels(o, e)
        f += 1usize
    }
}

fn run_case(a: *mem.Arena, e: *ce.Editor, o: *Out, fs: []const usize, fe: []const usize, nf: usize, src: str) {
    let doc = src[fs[0usize]..fe[0usize]]
    let suffix = src[fs[1usize]..fe[1usize]]
    let op = src[fs[2usize]]
    if ce.load(e, doc) != ok { os.exit(250i32) }
    ce.set_language(e, ce.lang_for_suffix(suffix))
    e.tab_width = 4usize
    if op == 84u8 {
        var toks: [128]ce.Token = zero
        var ln = 0usize
        while ln < ce.line_count(e) {
            if ln > 0usize { put(o, 124u8) }
            let n = ce.tokens(e, ln, toks[..])
            var t = 0usize
            while t < n && t < 128usize {
                if t > 0usize { put(o, 32u8) }
                put_num(o, usize(toks[t].kind))
                put(o, 58u8)
                put_num(o, toks[t].start)
                put(o, 45u8)
                put_num(o, toks[t].end)
                t += 1usize
            }
            ln += 1usize
        }
    } else if op == 66u8 {
        var first = true
        var pos = 0usize
        while pos <= ce.len(e) {
            if pos == ce.len(e) || (ce.byte_at(e, pos) & 192u8) != 128u8 {
                let (b, m, found) = ce.match_bracket(e, pos)
                if found {
                    if !first { put(o, 32u8) }
                    first = false
                    put_num(o, pos)
                    put(o, 58u8)
                    put_num(o, b)
                    put(o, 62u8)
                    put_num(o, m)
                }
            }
            pos += 1usize
        }
    } else if op == 70u8 {
        var out: [64]ce.Fold = zero
        let n = ce.fold_all(e, out[..])
        var k = 0usize
        while k < n && k < 64usize {
            if k > 0usize { put(o, 32u8) }
            put_num(o, out[k].from)
            put(o, 45u8)
            put_num(o, out[k].to)
            k += 1usize
        }
    } else if op == 87u8 {
        let width = parse_num(src[fs[3usize]..fe[3usize]])
        e.tab_width = parse_num(src[fs[4usize]..fe[4usize]])
        var ln = 0usize
        while ln < ce.line_count(e) {
            if ln > 0usize { put(o, 59u8) }
            let rows = ce.wrap_rows(e, ln, width)
            put_num(o, rows)
            put(o, 58u8)
            var r = 0usize
            while r < rows {
                if r > 0usize { put(o, 44u8) }
                put_num(o, ce.wrap_row_start(e, ln, width, r))
                r += 1usize
            }
            ln += 1usize
        }
        put(o, 124u8)
        var pos_list: [256]usize = zero
        let np = split_nums(src[fs[5usize]..fe[5usize]], 44u8, pos_list[..])
        var k = 0usize
        while k < np {
            if k > 0usize { put(o, 32u8) }
            let (row, col) = ce.wrap_locate(e, pos_list[k], width)
            put_num(o, pos_list[k])
            put(o, 58u8)
            put_num(o, row)
            put(o, 46u8)
            put_num(o, col)
            k += 1usize
        }
        put(o, 124u8)
        put_num(o, ce.wrap_total_rows(e, width))
    } else if op == 88u8 || op == 67u8 || op == 80u8 {
        let pattern = src[fs[3usize]..fe[3usize]]
        let flags = src[fs[4usize]..fe[4usize]]
        let mark = a.off
        let (prog, ce0) = rx.compile_backtracking(a, pattern, rx_options(flags))
        if ce0 != ok { os.exit(251i32) }
        if op == 88u8 {
            let from = parse_num(src[fs[5usize]..fe[5usize]])
            let fwd = src[fs[6usize]] == 102u8
            let (s, f, found) = ce.find_regex(e, &prog, from, fwd)
            if found {
                put_num(o, s)
                put(o, 45u8)
                put_num(o, f)
            } else {
                put(o, 45u8)
            }
        } else if op == 67u8 {
            let (n, capped) = ce.count_regex(e, &prog, parse_num(src[fs[5usize]..fe[5usize]]))
            put_num(o, n)
            put(o, 44u8)
            if capped { put(o, 49u8) } else { put(o, 48u8) }
        } else {
            let (n, re) = ce.replace_regex_all(a, e, &prog, src[fs[5usize]..fe[5usize]])
            if re != ok { os.exit(252i32) }
            put_num(o, n)
            put(o, 124u8)
            var i = 0usize
            while i < ce.len(e) {
                put(o, ce.byte_at(e, i))
                i += 1usize
            }
        }
        a.off = mark
    } else if op == 77u8 {
        run_multi(o, e, fs, fe, nf, src)
    }
}

fn main(a: *mem.Arena, args: []str) -> err {
    let (e0, oe) = ce.open(a, 4096usize, 200usize, 12usize, 8usize, 64usize, 2048usize)
    if oe != ok { os.exit(250i32) }
    var ed = e0
    let src = script()
    let want = expected()
    let base = a.off
    var out: Out = zero
    var wpos = 0usize
    var spos = 0usize
    var case_no = 0usize
    while case_no < CASES {
        var fs: [32]usize = zero
        var fe: [32]usize = zero
        var nf = 0usize
        var i = spos
        var start = spos
        var more = true
        while more {
            if i >= src.len || src[i] == 30u8 || src[i] == 31u8 {
                if nf < 32usize {
                    fs[nf] = start
                    fe[nf] = i
                    nf += 1usize
                }
                start = i + 1usize
                if i >= src.len || src[i] == 30u8 { more = false }
            }
            i += 1usize
        }
        spos = i
        var wend = wpos
        while wend < want.len && want[wend] != 30u8 { wend += 1usize }
        out.n = 0usize
        run_case(a, &ed, &out, fs[..], fe[..], nf, src)
        a.off = base
        var same = out.n == wend - wpos
        var k = 0usize
        while same && k < out.n {
            if out.buf[k] != want[wpos + k] { same = false }
            k += 1usize
        }
        if !same {
            var head: Out = zero
            put_str(&head, "case ")
            put_num(&head, case_no)
            put(&head, 32u8)
            put(&head, src[fs[2usize]])
            put_str(&head, "\n got: ")
            let (w1, e1) = os.write(os.stdout(), head.buf[0usize..head.n])
            let (w2, e2) = os.write(os.stdout(), out.buf[0usize..out.n])
            let (w3, e3) = os.write(os.stdout(), "\nwant: ")
            let (w4, e4) = os.write(os.stdout(), want[wpos..wend])
            let (w5, e5) = os.write(os.stdout(), "\n")
            os.exit(i32(1usize + case_no % 200usize))
        }
        wpos = wend + 1usize
        case_no += 1usize
    }
    let (w6, e6) = os.write(os.stdout(), "ui code editor ext ok\n")
    ret ok
}
