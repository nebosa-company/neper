        let want = field(&rest)
        var buf: [512]u8 = zero
        let (n, e) = nats.encode_sub(buf[0usize..], subject, queue, sid)
        ret e == ok && str.eq(hex(a, buf[0usize..n]), want)
    }
    if str.eq(kind, "N") {
        let sid = num(field(&rest))
        let max = num(field(&rest))
        let want = field(&rest)
        var buf: [64]u8 = zero
        let (n, e) = nats.encode_unsub(buf[0usize..], sid, max)
        ret e == ok && str.eq(hex(a, buf[0usize..n]), want)
    }
    if str.eq(kind, "D") {
