use e.fmt.dom as dom
use e.fmt.html as html
use e.mem
use e.os
use e.web.script as script

fn main(a: *mem.Arena, args: []str) -> err {
    let options = html.Options { max_bytes: 1048576usize, max_nodes: 4096usize, max_attributes: 64usize, max_depth: 64u16, preserve_comments: false }
    let (parsed, parse_error) = dom.parse(a, "<!doctype html><html><body></body></html>", options, 32usize)
    if parse_error != ok { os.exit(1i32) }
    var tree = parsed
    let (context, context_error) = script.new_context(a, &tree, "https://text-decoder-stream.test/")
    if context_error != ok { os.exit(2i32) }
    let setup = "window.streamChunks = []; window.streamDone = false; window.streamError = null; const source = new ReadableStream({ start(controller) { controller.enqueue(new Uint8Array([195])); controller.enqueue(new Uint8Array([169])); controller.close(); } }); source.pipeThrough(new TextDecoderStream()).pipeTo(new WritableStream({ write(chunk) { window.streamChunks.push(chunk); } })).then(() => { window.streamDone = true; }, error => { window.streamError = error; }); const split = new TextDecoder(); window.splitA = split.decode(new Uint8Array([195]), { stream: true }); window.splitB = split.decode(new Uint8Array([169]), { stream: true }); window.splitFlush = split.decode(); const bom = new TextDecoder(); window.bomA = bom.decode(new Uint8Array([239]), { stream: true }); window.bomB = bom.decode(new Uint8Array([187]), { stream: true }); window.bomC = bom.decode(new Uint8Array([191, 65]), { stream: true }); window.bomD = bom.decode(new Uint8Array([239, 187, 191, 66])); const ignored = new TextDecoder('utf-8', { ignoreBOM: true }); window.ignored = ignored.decode(new Uint8Array([239, 187, 191, 65])); const malformed = new TextDecoder(); window.malformedA = malformed.decode(new Uint8Array([225, 128]), { stream: true }); window.malformedB = malformed.decode(new Uint8Array([65])); const fatal = new TextDecoder('utf-8', { fatal: true }); window.fatalReplacement = fatal.decode(new Uint8Array([239, 191, 189])); const fatalIncomplete = new TextDecoder('utf-8', { fatal: true }); fatalIncomplete.decode(new Uint8Array([195]), { stream: true }); window.fatalCaught = false; try { fatalIncomplete.decode(); } catch (error) { window.fatalCaught = error instanceof TypeError; }"
    if !script.run_script(context, setup, "text-decoder-stream-setup.js") { os.exit(3i32) }
    let boundary_setup = "const terminal = new TextDecoder(); window.terminalA = terminal.decode(new Uint8Array([195]), { stream: true }); window.terminalB = terminal.decode(new Uint8Array([169])); const snapshot = new TextDecoder(); const snapshotInput = new Uint8Array([195]); window.snapshotA = snapshot.decode(snapshotInput, { stream: true }); snapshotInput[0] = 65; window.snapshotB = snapshot.decode(new Uint8Array([169])); const invalid = new TextDecoder(); window.invalidFirst = invalid.decode(new Uint8Array([240, 128]), { stream: true }); const invalidFatal = new TextDecoder('utf-8', { fatal: true }); window.invalidFatalCaught = false; try { invalidFatal.decode(new Uint8Array([240, 128]), { stream: true }); } catch (error) { window.invalidFatalCaught = error instanceof TypeError; }"
    if !script.run_script(context, boundary_setup, "text-decoder-stream-boundaries.js") { os.exit(5i32) }
    script.pump(context, 0.0f64)
    let check = "if (window.streamError !== null || window.streamDone !== true || window.streamChunks.length !== 1 || window.streamChunks[0].length !== 1 || window.streamChunks[0].charCodeAt(0) !== 233) throw new Error('TextDecoderStream did not preserve split UTF-8'); if (window.splitA !== '' || window.splitB.length !== 1 || window.splitB.charCodeAt(0) !== 233 || window.splitFlush !== '') throw new Error('streaming decode did not preserve split UTF-8'); if (window.bomA !== '' || window.bomB !== '' || window.bomC !== 'A' || window.bomD.length !== 2 || window.bomD.charCodeAt(0) !== 65279 || window.bomD.charCodeAt(1) !== 66) throw new Error('BOM state is wrong'); if (window.ignored.length !== 2 || window.ignored.charCodeAt(0) !== 65279 || window.ignored.charCodeAt(1) !== 65) throw new Error('ignoreBOM is wrong'); if (window.malformedA !== '' || window.malformedB.length !== 2 || window.malformedB.charCodeAt(0) !== 65533 || window.malformedB.charCodeAt(1) !== 65) throw new Error('invalid split UTF-8 recovery is wrong'); if (window.fatalReplacement.length !== 1 || window.fatalReplacement.charCodeAt(0) !== 65533 || window.fatalCaught !== true) throw new Error('fatal decoding is wrong');"
    if !script.run_script(context, check, "text-decoder-stream-check.js") { os.exit(4i32) }
    let boundary_check = "if (window.terminalA !== '' || window.terminalB.length !== 1 || window.terminalB.charCodeAt(0) !== 233) throw new Error('terminal chunk did not join streaming sequence'); if (window.snapshotA !== '' || window.snapshotB.length !== 1 || window.snapshotB.charCodeAt(0) !== 233) throw new Error('streaming decode retained mutable input'); if (window.invalidFirst.length !== 2 || window.invalidFirst.charCodeAt(0) !== 65533 || window.invalidFirst.charCodeAt(1) !== 65533 || window.invalidFatalCaught !== true) throw new Error('invalid first continuation was not rejected immediately');"
    if !script.run_script(context, boundary_check, "text-decoder-stream-boundary-check.js") { os.exit(6i32) }
    ret ok
}
