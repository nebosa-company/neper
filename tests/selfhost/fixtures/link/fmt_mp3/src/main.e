fn reference_sample(pcm: str, index: usize) -> i32 {
    let v = u32(pcm[2usize * index]) | (u32(pcm[2usize * index + 1usize]) << 8u32)
    if v >= 32768u32 { ret i32(v) - 65536i32 }
    ret i32(v)
}

// The largest distance between `out[..count]` and the reference from PCM frame `from`.
fn worst(out: audio.Frames, count: usize, pcm: str, from: usize) -> i32 {
    var worst_seen = 0i32
    let nch = usize(out.format.channels)
    var frame = 0usize
    while frame < count {
        var ch = 0usize
        while ch < nch {
            let (sample, sample_error) = audio.sample_i32(out, frame, u8(ch))
            if sample_error != ok { ret 99999i32 }
            var d = (sample >> 16u32) - reference_sample(pcm, (from + frame) * nch + ch)
            if d < 0i32 { d = 0i32 - d }
            if d > worst_seen { worst_seen = d }
            ch += 1usize
        }
        frame += 1usize
    }
    ret worst_seen
}

fn buffer(a: *mem.Arena, f: audio.Format, count: usize) -> (audio.Frames, err) {
    let (bytes, bytes_error) = mem.alloc[u8](a, count * audio.frame_bytes(f))
    if bytes_error != ok { ret (zero, bytes_error) }
    let (view, view_error) = audio.view(bytes, f)
    ret (view, view_error)
}

// Whole, chunked and seeked decodes of one stream against its reference.
fn check_stream(a: *mem.Arena, stream: str, pcm: str, channels: u8, rate: u32, base: i32) -> i32 {
    let (opened, open_error) = mp3.open(a, stream)
    if open_error != ok { ret base + 1i32 }
    var d = opened
    let f = mp3.format(d)
    let total = pcm.len / (2usize * usize(channels))
    if f.rate != rate || f.channels != channels || f.sample != .I16 || mp3.frame_count(d) != total { ret base + 2i32 }
    let (whole_view, whole_error) = buffer(a, f, total + 100usize)
    if whole_error != ok { ret base + 3i32 }
    var whole = whole_view
    let (written, decode_error) = mp3.decode_into(&d, &whole)
    if decode_error != ok || written != total || d.granule != total { ret base + 4i32 }
    if worst(whole, total, pcm, 0usize) > 2i32 { ret base + 5i32 }
    let (_, tail_error) = mp3.decode_into(&d, &whole)
    let (more, more_error) = mp3.decode_into(&d, &whole)
    if tail_error != ok || more_error != ok || more != 0usize { ret base + 6i32 }

    // Chunks of 1000 frames from a fresh decoder agree with the whole decode.
    let (again, again_error) = mp3.open(a, stream)
    if again_error != ok { ret base + 7i32 }
    var chunked = again
    let (chunk_view, chunk_error) = buffer(a, f, 1000usize)
    if chunk_error != ok { ret base + 8i32 }
    var chunk = chunk_view
    var at = 0usize
    while true {
        let (got, got_error) = mp3.decode_into(&chunked, &chunk)
        if got_error != ok { ret base + 9i32 }
        if got == 0usize { break }
        if worst(chunk, got, pcm, at) > 2i32 { ret base + 10i32 }
        at += got
    }
    if at != total { ret base + 11i32 }

    // A seek into the middle lands on the reference, and past the end refuses.
    let goal = total / 2usize + 37usize
    if mp3.seek(&chunked, goal) != ok || chunked.granule != goal { ret base + 12i32 }
    let (after_seek, seek_decode_error) = mp3.decode_into(&chunked, &chunk)
    if seek_decode_error != ok || after_seek != 1000usize || worst(chunk, 1000usize, pcm, goal) > 2i32 { ret base + 13i32 }
    if mp3.seek(&chunked, total + 1usize) != mp3.Invalid || mp3.seek(&chunked, 0usize) != ok || chunked.granule != 0usize { ret base + 14i32 }
    let (from_start, restart_error) = mp3.decode_into(&chunked, &chunk)
    if restart_error != ok || from_start != 1000usize || worst(chunk, 1000usize, pcm, 0usize) > 2i32 { ret base + 15i32 }
    ret 0i32
}

fn main(a: *mem.Arena, args: []str) -> err {
    let mono_code = check_stream(a, mono_mp3(), mono_pcm(), 1u8, 44100u32, 0i32)
    if mono_code != 0i32 { os.exit(mono_code) }
    let stereo_code = check_stream(a, stereo_mp3(), stereo_pcm(), 2u8, 44100u32, 20i32)
    if stereo_code != 0i32 { os.exit(stereo_code) }
    let lsf_code = check_stream(a, lsf_mp3(), lsf_pcm(), 1u8, 22050u32, 40i32)
    if lsf_code != 0i32 { os.exit(lsf_code) }

    // Refusals: no frame at all, and a buffer in another format.
    let (_, garbage_error) = mp3.open(a, "not an mpeg stream at all, just text")
    if garbage_error != mp3.Invalid { os.exit(61i32) }
    let (opened, open_error) = mp3.open(a, mono_mp3())
    if open_error != ok { os.exit(62i32) }
    var d = opened
    let wrong = audio.Format { rate: 48000u32, channels: 1u8, sample: .I16 }
    let (wrong_view, wrong_error) = buffer(a, wrong, 16usize)
    if wrong_error != ok { os.exit(63i32) }
    var wrong_out = wrong_view
    let (_, mismatch) = mp3.decode_into(&d, &wrong_out)
    if mismatch != mp3.Unsupported { os.exit(64i32) }

    // A stream cut mid-frame still decodes every whole frame before the cut.
    let cut = mono_mp3()[..mono_mp3().len - 50usize]
    let (short, short_error) = mp3.open(a, cut)
    if short_error != ok || mp3.frame_count(short) != mp3.frame_count(d) - 1152usize { os.exit(65i32) }

    // An ID3v2 header in front is skipped.
    let (tagged_bytes, tagged_alloc) = mem.alloc[u8](a, mono_mp3().len + 20usize)
    if tagged_alloc != ok { os.exit(66i32) }
    var z = 0usize
    while z < 20usize {
        tagged_bytes[z] = 0u8
        z += 1usize
    }
    tagged_bytes[0] = 73u8
    tagged_bytes[1] = 68u8
    tagged_bytes[2] = 51u8
    tagged_bytes[3] = 4u8
    tagged_bytes[9] = 10u8
    mem.copy[u8](tagged_bytes[20usize..], mono_mp3())
    let (tagged, tagged_error) = mp3.open(a, tagged_bytes)
    if tagged_error != ok || mp3.frame_count(tagged) != mp3.frame_count(d) || tagged.at != d.at + 20usize { os.exit(67i32) }

    try io.print("fmt mp3 ok\n")
    ret ok
}
