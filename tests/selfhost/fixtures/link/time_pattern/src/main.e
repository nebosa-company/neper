fn run_text(text: str) -> u8 {
    var start = 0usize
    var i = 0usize
    while i < text.len {
        if text[i] == 10u8 {
            let code = check_line(text[start..i])
            if code != 0u8 {
                let shown = io.print(text[start..i])
                if shown != ok { ret code }
                ret code
            }
            start = i + 1usize
        }
        i += 1usize
    }
    ret 0u8
}

fn run_vectors() -> u8 {
    let r_v_0 = run_text(v_0())
    if r_v_0 != 0u8 { ret r_v_0 }
    let r_v_1 = run_text(v_1())
    if r_v_1 != 0u8 { ret r_v_1 }
    let r_v_2 = run_text(v_2())
    if r_v_2 != 0u8 { ret r_v_2 }
    let r_v_3 = run_text(v_3())
    if r_v_3 != 0u8 { ret r_v_3 }
    let r_v_4 = run_text(v_4())
    if r_v_4 != 0u8 { ret r_v_4 }
    let r_v_5 = run_text(v_5())
    if r_v_5 != 0u8 { ret r_v_5 }
    let r_v_6 = run_text(v_6())
