fn text_is(a: str, b: str) -> bool {
    if a.len != b.len { ret false }
    var i = 0usize
    while i < a.len {
        if a[i] != b[i] { ret false }
        i += 1usize
    }
    ret true
}

fn tok(line: str, at: usize) -> (str, usize) {
    var p = at
    while p < line.len && line[p] == 32u8 { p += 1usize }
    let start = p
    while p < line.len && line[p] != 32u8 { p += 1usize }
    ret (line[start..p], p)
}

fn dec(s: str) -> i64 {
    var v = 0i64
    var neg = false
    var i = 0usize
    if s.len > 0usize && s[0usize] == 45u8 {
        neg = true
        i = 1usize
    }
    while i < s.len {
        v = v * 10i64 + i64(s[i] - 48u8)
        i += 1usize
    }
    if neg { ret 0i64 - v }
    ret v
}


fn bar(line: str, at: usize) -> (str, usize) {
    var p = at
    while p < line.len && line[p] != 124u8 { p += 1usize }
    let piece = line[at..p]
    if p < line.len { p += 1usize }
    ret (piece, p)
}

fn same_dt(v: calendar.DateTime, y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, n: i64) -> bool {
