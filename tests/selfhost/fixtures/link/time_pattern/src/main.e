fn main(a: *mem.Arena, args: []str) -> err {
    var buf: [64]u8 = zero
    var at: calendar.DateTime = zero
    at.date.year = 2024i32
    at.date.month = 3u8
    at.date.day = 5u8
    // Output buffer too small is refused, not truncated.
    let (_, small) = pattern_api.format("yyyy-MM-dd", at, buf[0usize..5usize])
    if small == ok { os.exit(110i32) }
    let (_, r0) = pattern_api.format("yyy", at, buf[0usize..64usize])
    if r0 == ok { os.exit(120i32) }
    let (_, r1) = pattern_api.format("'open", at, buf[0usize..64usize])
    if r1 == ok { os.exit(121i32) }
    let (_, r2) = pattern_api.format("abc\\", at, buf[0usize..64usize])
    if r2 == ok { os.exit(122i32) }
    let (_, r3) = pattern_api.format("MMMMM", at, buf[0usize..64usize])
    if r3 == ok { os.exit(123i32) }
    let (_, r4) = pattern_api.format("ddddd", at, buf[0usize..64usize])
    if r4 == ok { os.exit(124i32) }
    let (_, r5) = pattern_api.format("HHH", at, buf[0usize..64usize])
    if r5 == ok { os.exit(125i32) }
    let (_, r6) = pattern_api.format("ffffffffff", at, buf[0usize..64usize])
    if r6 == ok { os.exit(126i32) }
    let r = run_vectors()
    if r != 0u8 { os.exit(i32(r)) }
    try io.print("time pattern ok")
    ret ok
}
