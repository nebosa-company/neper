    if no_word_pictures_error != ok || no_word_pictures.len != 0usize { os.exit(44) }
    // (D4802) Slide shapes: sizes, fills (the run's colour and the line's are not the fill), text, a picture.
    let (slide_one, slide_one_error) = ooxml.slide_layout(a, deck_pics[0..], 1usize)
    if slide_one_error != ok || slide_one.width != 12192000usize || slide_one.height != 6858000usize { os.exit(45) }
    if slide_one.shapes.len != 3usize || slide_one.pictures.len != 1usize { os.exit(46) }
    let slide_box = slide_one.shapes[0]
    if slide_box.kind != ooxml.SHAPE_RECT || slide_box.x != 914400usize || slide_box.y != 457200usize || slide_box.cx != 2743200usize || slide_box.cy != 914400usize { os.exit(47) }
    if slide_box.fill != 16711680u32 || !str.eq(slide_box.text, "Box") { os.exit(48) }
    let slide_disc = slide_one.shapes[1]
    if slide_disc.kind != ooxml.SHAPE_ELLIPSE || slide_disc.x != 4572000usize || slide_disc.cx != 1828800usize || slide_disc.fill != 255u32 || !str.eq(slide_disc.text, "A\nB") { os.exit(49) }
    let slide_photo = slide_one.shapes[2]
    if slide_photo.kind != ooxml.SHAPE_PICTURE || slide_photo.picture != 0usize || slide_photo.x != 100usize || slide_photo.cy != 400usize { os.exit(50) }
    if !str.eq(slide_one.pictures[0].name, "ppt/media/image2.png") || slide_one.pictures[0].data[0usize] != 137u8 { os.exit(51) }
    let (deck_two, deck_two_error) = ooxml.slide_layout(a, deck_pics[0..], 2usize)
    if deck_two_error != ok || deck_two.shapes.len != 1usize || deck_two.shapes[0].fill != ooxml.NO_COLOR || deck_two.shapes[0].picture != ooxml.NO_PICTURE { os.exit(52) }
    let (absent_slide, absent_slide_error) = ooxml.slide_layout(a, deck_pics[0..], 3usize)
    if absent_slide_error != ooxml.NoMainPart { os.exit(53) }
    ret ok
}
