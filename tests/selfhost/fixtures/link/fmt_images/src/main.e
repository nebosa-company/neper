// ---- GIF -------------------------------------------------------------------------------

fn gif_options() -> gif.DecodeOptions {
    ret gif.DecodeOptions { max_width: 0u32, max_height: 0u32, max_pixels: 0u64, max_frames: 0u32, max_bytes: 0u64 }
}

// `record` is seven bytes a frame: the CRC-32 of its RGBA canvas, the delay and the disposal.
fn gif_ok(a: *mem.Arena, blob: str, w: u32, h: u32, count: u32, record: str) -> bool {
    let m = mem.mark(a)
    var s = io.SliceReader { data: blob, off: 0usize }
    let (frames, failure) = gif.decode_frames(a, io.slice_reader(&s), gif_options())
    if failure != ok { ret false }
    var good = frames.len == usize(count)
    var i = 0usize
    while good && i < frames.len {
        let at = i * 7usize
        let delay = u32(record[at + 4usize]) | (u32(record[at + 5usize]) << 8u32)
        good = frames[i].image.width == w && frames[i].image.height == h && crc_of(frames[i].image) == le32(record, at) && frames[i].delay == delay && frames[i].disposal == record[at + 6usize]
        i += 1usize
    }
    mem.reset(a, m)
    ret good
}

fn gif_toolarge(a: *mem.Arena, blob: str) -> bool {
    let m = mem.mark(a)
    var s = io.SliceReader { data: blob, off: 0usize }
    let (_, failure) = gif.decode_frames(a, io.slice_reader(&s), gif_options())
    mem.reset(a, m)
    ret failure == gif.TooLarge
}

// ---- EXIF ------------------------------------------------------------------------------

fn block_for(data: str, kind: u8) -> ([]const u8, err) {
    if kind == 0u8 {
        let (b, e) = exif.block_of_jpeg(data)
        ret (b, e)
    }
    if kind == 1u8 {
        let (b, e) = exif.block_of_png(data)
        ret (b, e)
    }
    if kind == 2u8 {
        let (b, e) = exif.block_of_webp(data)
        ret (b, e)
    }
    ret (data, ok)
}

fn tag_of(a: *mem.Arena, data: str, kind: u8, ifd: u8, tag: u16, found: *exif.Exif, out: *exif.Tag) -> bool {
    let (block, block_error) = block_for(data, kind)
    if block_error != ok { ret false }
    let (e, open_error) = exif.open(block)
    if open_error != ok { ret false }
    *found = e
    let (all, tags_error) = exif.tags(a, found, 512usize)
    if tags_error != ok { ret false }
    let (t, there) = exif.find(all, ifd, tag)
    if !there { ret false }
    *out = t
    ret true
}

fn exif_text(a: *mem.Arena, data: str, kind: u8, ifd: u8, tag: u16, want: str) -> bool {
    let m = mem.mark(a)
    var e: exif.Exif = zero
    var t: exif.Tag = zero
    if !tag_of(a, data, kind, ifd, tag, &e, &t) { ret false }
    let (text, failure) = exif.value_text(&e, t)
    let good = failure == ok && same(text, want)
    mem.reset(a, m)
    ret good
}

fn exif_u32(a: *mem.Arena, data: str, kind: u8, ifd: u8, tag: u16, index: usize, want: u32) -> bool {
    let m = mem.mark(a)
    var e: exif.Exif = zero
    var t: exif.Tag = zero
    if !tag_of(a, data, kind, ifd, tag, &e, &t) { ret false }
    let (v, failure) = exif.value_u32(&e, t, index)
    let good = failure == ok && v == want
    mem.reset(a, m)
    ret good
}

// By value: a rational is the same number however it is written (56/10 is 28/5).
fn exif_rational(a: *mem.Arena, data: str, kind: u8, ifd: u8, tag: u16, index: usize, num: u32, den: u32) -> bool {
    let m = mem.mark(a)
    var e: exif.Exif = zero
    var t: exif.Tag = zero
    if !tag_of(a, data, kind, ifd, tag, &e, &t) { ret false }
    let (n, d, failure) = exif.value_rational(&e, t, index)
    let good = failure == ok && d != 0u32 && u64(n) * u64(den) == u64(num) * u64(d)
    mem.reset(a, m)
    ret good
}

fn exif_orientation(a: *mem.Arena, data: str, kind: u8, want: u32) -> bool {
    let (block, block_error) = block_for(data, kind)
    if block_error != ok { ret want == 1u32 }
    let m = mem.mark(a)
    let v = exif.orientation(a, block)
    mem.reset(a, m)
    ret v == want
}

fn exif_absent(a: *mem.Arena, data: str) -> bool {
    let (_, failure) = exif.block_of_jpeg(data)
    ret failure == exif.NotFound
}

fn exif_tags_fail(a: *mem.Arena, block: str) -> bool {
    let m = mem.mark(a)
    let (e, open_error) = exif.open(block)
    if open_error != ok { ret true }
    var x = e
    let (_, failure) = exif.tags(a, &x, 64usize)
    mem.reset(a, m)
    ret failure != ok
}

// ---- hostile input ---------------------------------------------------------------------

// One decode of `bytes` as `kind` (0 QOI, 1 BMP, 2 GIF, 3 TIFF, 4 a bare EXIF block) under small
// limits; only that it returns matters.
fn try_one(a: *mem.Arena, kind: u8, bytes: []const u8) {
    let m = mem.mark(a)
    var s = io.SliceReader { data: bytes, off: 0usize }
    if kind == 0u8 {
        let (_, qoi_failure) = qoi.decode(a, io.slice_reader(&s), qoi.DecodeOptions { max_width: 512u32, max_height: 512u32, max_pixels: 65536u64 })
    } else if kind == 1u8 {
        let (_, bmp_failure) = bmp.decode(a, io.slice_reader(&s), bmp.DecodeOptions { max_width: 512u32, max_height: 512u32, max_pixels: 65536u64 })
    } else if kind == 2u8 {
        let (_, gif_failure) = gif.decode_frames(a, io.slice_reader(&s), gif.DecodeOptions { max_width: 512u32, max_height: 512u32, max_pixels: 65536u64, max_frames: 16u32, max_bytes: 4194304u64 })
    } else if kind == 3u8 {
        let (_, tiff_failure) = tiff.decode(a, io.slice_reader(&s), tiff.DecodeOptions { max_width: 512u32, max_height: 512u32, max_pixels: 65536u64 })
    } else {
        let (e, open_error) = exif.open(bytes)
        if open_error == ok {
            var x = e
            let (_, tags_failure) = exif.tags(a, &x, 128usize)
        }
    }
    mem.reset(a, m)
}

fn survive(a: *mem.Arena, kind: u8, blob: str) -> bool {
    var buf: [2048]u8 = zero
    if blob.len > buf.len { ret false }
    var n = 0usize
    while n < blob.len {
        buf[n] = blob[n]
        n += 1usize
    }
    var cut = 0usize
    while cut <= blob.len {
        try_one(a, kind, buf[..cut])
        cut += 1usize
    }
    var pos = 0usize
    while pos < blob.len {
        var mask = 1u8
        while mask != 0u8 {
            buf[pos] = blob[pos] ^ mask
            try_one(a, kind, buf[..blob.len])
            mask = mask << 1u32
        }
        buf[pos] = blob[pos]
        pos += 1usize
    }
    ret true
}

fn survive_qoi(a: *mem.Arena, blob: str) -> bool { ret survive(a, 0u8, blob) }

fn survive_bmp(a: *mem.Arena, blob: str) -> bool { ret survive(a, 1u8, blob) }

fn survive_gif(a: *mem.Arena, blob: str) -> bool { ret survive(a, 2u8, blob) }

fn survive_tiff(a: *mem.Arena, blob: str) -> bool { ret survive(a, 3u8, blob) }

fn survive_exif(a: *mem.Arena, blob: str) -> bool { ret survive(a, 4u8, blob) }

