// e.fmt.qoi, e.fmt.bmp, e.fmt.gif, e.fmt.tiff and e.fmt.exif (L124, D2524): images written by Pillow
// and the qoi package (and, for BMP variants Pillow cannot write, a small Python writer) decode to the
// RGBA bytes Pillow itself decodes from the same file, compared by CRC-32; GIF animation frames agree
// with the composition model of the format; EXIF tags written by Pillow are read back from JPEG, PNG,
// WebP and TIFF containers. Hostile input -- dimensions past the limits, every truncation and one-byte
// change of small files, cyclic or wild IFDs -- must be refused or decoded without a trap.
// Generated by scripts/image_vectors.py; a failing check prints its number.
use e.algo.hash as hash
use e.io
use e.mem
use e.os
use e.gfx.image
use e.fmt.qoi as qoi
use e.fmt.bmp as bmp
use e.fmt.gif as gif
use e.fmt.tiff as tiff
use e.fmt.exif as exif

fn die(number: i32) {
    let _ = io.print("fmt images: check ")
    var digits: [4]u8 = zero
    digits[0] = u8(48i32 + (number / 1000i32) % 10i32)
    digits[1] = u8(48i32 + (number / 100i32) % 10i32)
    digits[2] = u8(48i32 + (number / 10i32) % 10i32)
    digits[3] = u8(48i32 + number % 10i32)
    let _ = io.print(digits[0..])
    let _ = io.print(" failed\n")
    os.exit(1i32)
}

fn same(x: []const u8, y: []const u8) -> bool {
    if x.len != y.len { ret false }
    var i = 0usize
    while i < x.len {
        if x[i] != y[i] { ret false }
        i += 1usize
    }
    ret true
}

fn le32(text: str, at: usize) -> u32 {
    ret u32(text[at]) | (u32(text[at + 1usize]) << 8u32) | (u32(text[at + 2usize]) << 16u32) | (u32(text[at + 3usize]) << 24u32)
}

fn crc_of(img: image.Image) -> u32 {
    var state = hash.crc32_init()
    var y = 0usize
    while y < usize(img.height) {
        let start = y * img.stride
        hash.crc32_update(&state, img.pixels[start..start + usize(img.width) * 4usize])
        y += 1usize
    }
    ret hash.crc32_done(&state)
}

// ---- QOI -------------------------------------------------------------------------------

fn qoi_ok(a: *mem.Arena, blob: str, w: u32, h: u32, want: u32) -> bool {
    let m = mem.mark(a)
    var s = io.SliceReader { data: blob, off: 0usize }
    let (img, failure) = qoi.decode(a, io.slice_reader(&s), qoi.DecodeOptions { max_width: 0u32, max_height: 0u32, max_pixels: 0u64 })
    let good = failure == ok && img.width == w && img.height == h && crc_of(img) == want
    mem.reset(a, m)
    ret good
}

fn qoi_toolarge(a: *mem.Arena, blob: str) -> bool {
    let m = mem.mark(a)
    var s = io.SliceReader { data: blob, off: 0usize }
    let (_, failure) = qoi.decode(a, io.slice_reader(&s), qoi.DecodeOptions { max_width: 0u32, max_height: 0u32, max_pixels: 0u64 })
    mem.reset(a, m)
    ret failure == qoi.TooLarge
}

