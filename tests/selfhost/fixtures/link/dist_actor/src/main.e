type Counters = struct { activations: u32, deactivations: u32 }

fn dec_text(a: *mem.Arena, v: i64) -> str {
    var digits: [24]u8 = zero
    var n = 0usize
    var t = v
    if t == 0i64 {
        digits[0] = 48u8
        n = 1usize
    }
    while t > 0i64 {
        digits[n] = 48u8 + u8(t % 10i64)
        t = t / 10i64
        n += 1usize
    }
    let (buf, alloc_error) = mem.alloc[u8](a, n + 1usize)
    if alloc_error != ok { ret "" }
    var j = 0usize
    while j < n {
        buf[j] = digits[n - 1usize - j]
        j += 1usize
    }
    ret buf[0..n]
}

fn parse_dec(s: str) -> i64 {
    var v = 0i64
    var i = 0usize
    while i < s.len {
        v = v * 10i64 + i64(s[i] - 48u8)
        i += 1usize
    }
    ret v
}

fn on_activate(ctx: *void, t: *actor.Turn) -> err {
    var c = mem.cast[*Counters](ctx)
    c.activations += 1u32
    ret ok
}

fn on_deactivate(ctx: *void, t: *actor.Turn) -> err {
    var c = mem.cast[*Counters](ctx)
    c.deactivations += 1u32
    ret ok
}

fn bump(t: *actor.Turn, by: i64) -> err {
    let next = parse_dec(t.state) + by
    actor.set_state(t, dec_text(t.sys.a, next))
    ret ok
}

fn on_handle(ctx: *void, t: *actor.Turn) -> err {
    if str.eq(t.kind, "add") {
        try bump(t, parse_dec(t.payload))
        actor.set_reply(t, t.state)
        ret ok
    }
    if str.eq(t.kind, "get") {
        actor.set_reply(t, t.state)
        ret ok
    }
    if str.eq(t.kind, "forward") {
        let (r, call_error) = actor.call_from(t, t.payload, "add", "1")
        if call_error != ok { ret call_error }
        actor.set_reply(t, r)
        ret ok
    }
    if str.eq(t.kind, "self") {
        let (r, call_error) = actor.call_from(t, t.grain, "get", "")
        if call_error == actor.Reentrancy {
            actor.set_reply(t, "refused")
            ret ok
        }
        actor.set_reply(t, "ran")
        ret ok
    }
    if str.eq(t.kind, "cycle") {
        // a -> b -> a: the callee asks the caller back; the refusal reaches the first caller
        let (r, call_error) = actor.call_from(t, t.payload, "cycle-back", t.grain)
        if call_error != ok { ret call_error }
        actor.set_reply(t, r)
        ret ok
    }
    if str.eq(t.kind, "cycle-back") {
        let (r, call_error) = actor.call_from(t, t.payload, "get", "")
        if call_error == actor.Reentrancy {
            actor.set_reply(t, "cycle-refused")
            ret ok
        }
        actor.set_reply(t, "cycle-ran")
        ret ok
    }
    if str.eq(t.kind, "fail") {
        actor.set_state(t, "changed")
        ret actor.Invalid
    }
    if str.eq(t.kind, "timer-on") {
        try actor.timer_start(t, "t", t.now + 100i64, 100i64)
        ret ok
    }
    if str.eq(t.kind, "timer:t") {
        try bump(t, 1i64)
        ret ok
    }
    if str.eq(t.kind, "remind") {
        try actor.reminder_set(t.sys, t.grain, "r", t.now + 500i64, 1000i64)
        ret ok
    }
    if str.eq(t.kind, "reminder:r") {
        try bump(t, 10i64)
        ret ok
    }
    ret actor.Invalid
}

fn behavior(c: *Counters) -> actor.Behavior {
    ret actor.Behavior { ctx: mem.cast[*void](c), activate: on_activate, handle: on_handle, deactivate: on_deactivate }
}

fn grain_name(a: *mem.Arena, k: usize) -> str {
    let digits = dec_text(a, i64(k))
    let (buf, alloc_error) = mem.alloc[u8](a, 6usize + digits.len)
    if alloc_error != ok { ret "" }
    let prefix = "grain-"
    var i = 0usize
    while i < 6usize {
        buf[i] = prefix[i]
        i += 1usize
    }
    var j = 0usize
    while j < digits.len {
        buf[6usize + j] = digits[j]
        j += 1usize
    }
    ret buf[0..6usize + digits.len]
}

fn cluster(a: *mem.Arena, c: *Counters, db: *ds.Db) -> (actor.System, err) {
    let (sys0, create_error) = actor.create(a, db, behavior(c), 8usize, 64usize, 16usize)
    if create_error != ok { ret (sys0, create_error) }
    var sys = sys0
    let (s0, e0) = actor.add_silo(&sys, "silo-a")
    let (s1, e1) = actor.add_silo(&sys, "silo-b")
    let (s2, e2) = actor.add_silo(&sys, "silo-c")
    let (s3, e3) = actor.add_silo(&sys, "silo-d")
    if e0 != ok || e1 != ok || e2 != ok || e3 != ok { ret (sys, actor.Full) }
    ret (sys, ok)
}

fn new_db(a: *mem.Arena) -> (ds.Db, err) {
    let (db, create_error) = ds.create(a, ds.Limits { log: 65536usize, docs: 64usize, events: 4usize, marks: 2usize, streams: 2usize })
    ret (db, create_error)
}

// 1xx
fn activation(a: *mem.Arena) -> i32 {
    var c = Counters { activations: 0u32, deactivations: 0u32 }
    let (db0, db_error) = new_db(a)
    if db_error != ok { ret 100i32 }
    var db = db0
    let (sys0, sys_error) = cluster(a, &c, &db)
    if sys_error != ok { ret 101i32 }
    var sys = sys0
    var k = 0usize
    while k < 16usize {
        let g = grain_name(a, k)
        let (r, e) = actor.call(&sys, g, "add", "5", 1000i64)
        if e != ok || !str.eq(r, "5") { ret 102i32 }
        let (silo, found) = actor.silo_of(&sys, g)
        if !found || silo != gen_before(k) { ret 103i32 }
        k += 1usize
    }
    if c.activations != 16u32 || actor.active_count(&sys) != 16usize { ret 104i32 }
    // a second call reuses the activation and builds on the state
    let (r2, e2) = actor.call(&sys, "grain-3", "add", "7", 1100i64)
    if e2 != ok || !str.eq(r2, "12") || c.activations != 16u32 { ret 105i32 }
    // the state is already in the store
    let (stored, has) = actor.stored_state(&sys, "grain-3")
    if !has || !str.eq(stored, "12") { ret 106i32 }
    // idle collection: grain-3 was used at 1100, the rest at 1000
    let (n, collect_error) = actor.collect(&sys, 2000i64, 950i64)
    if collect_error != ok || n != 15usize || c.deactivations != 15u32 { ret 107i32 }
    if !actor.is_active(&sys, "grain-3") || actor.is_active(&sys, "grain-4") { ret 108i32 }
    // a collected grain reactivates with its state intact
    let (r3, e3) = actor.call(&sys, "grain-4", "add", "1", 2100i64)
    if e3 != ok || !str.eq(r3, "6") || c.activations != 17u32 { ret 109i32 }
    // the fixed placement function says the same silo again
    let (silo4, found4) = actor.silo_of(&sys, "grain-4")
    if !found4 || silo4 != gen_before(4usize) { ret 110i32 }
    if actor.deactivate(&sys, "nobody", 2200i64) != actor.NotFound { ret 111i32 }
    ret 0i32
}

// 2xx
fn failure(a: *mem.Arena) -> i32 {
    var c = Counters { activations: 0u32, deactivations: 0u32 }
    let (db0, db_error) = new_db(a)
    if db_error != ok { ret 200i32 }
    var db = db0
    let (sys0, sys_error) = cluster(a, &c, &db)
    if sys_error != ok { ret 201i32 }
    var sys = sys0
    var k = 0usize
    while k < 16usize {
        let (r, e) = actor.call(&sys, grain_name(a, k), "add", "3", 10i64)
        if e != ok { ret 202i32 }
        k += 1usize
    }
    let lost = actor.fail_silo(&sys, 1usize)
    if lost != gen_on_silo1() { ret 203i32 }
    if c.deactivations != 0u32 { ret 204i32 }
    if actor.active_count(&sys) != 16usize - lost { ret 205i32 }
    // each grain answers again, with the state it had committed, on a surviving silo
    k = 0usize
    while k < 16usize {
        let g = grain_name(a, k)
        let (r, e) = actor.call(&sys, g, "add", "1", 20i64)
        if e != ok || !str.eq(r, "4") { ret 206i32 }
        let (silo, found) = actor.silo_of(&sys, g)
        if !found || silo == 1usize || silo != gen_after(k) { ret 207i32 }
        k += 1usize
    }
    if actor.live_silos(&sys) != 3usize { ret 208i32 }
    // every silo down: no placement
    let _ = actor.fail_silo(&sys, 0usize)
    let _ = actor.fail_silo(&sys, 2usize)
    let _ = actor.fail_silo(&sys, 3usize)
    let (r9, e9) = actor.call(&sys, "grain-0", "get", "", 30i64)
    if e9 != actor.NoSilo { ret 209i32 }
    ret 0i32
}

// 3xx
fn reentrancy(a: *mem.Arena) -> i32 {
    var c = Counters { activations: 0u32, deactivations: 0u32 }
    let (db0, db_error) = new_db(a)
    if db_error != ok { ret 300i32 }
    var db = db0
    let (sys0, sys_error) = cluster(a, &c, &db)
    if sys_error != ok { ret 301i32 }
    var sys = sys0
    let (r1, e1) = actor.call(&sys, "alice", "self", "", 1i64)
    if e1 != ok || !str.eq(r1, "refused") { ret 302i32 }
    // a call to another grain is fine and runs its turn
    let (r2, e2) = actor.call(&sys, "alice", "forward", "bob", 2i64)
    if e2 != ok || !str.eq(r2, "1") { ret 303i32 }
    let (r3, e3) = actor.call(&sys, "bob", "get", "", 3i64)
    if e3 != ok || !str.eq(r3, "1") { ret 304i32 }
    // a cycle a -> b -> a is refused where it closes, not deadlocked
    let (r4, e4) = actor.call(&sys, "alice", "cycle", "bob", 4i64)
    if e4 != ok || !str.eq(r4, "cycle-refused") { ret 305i32 }
    // a failing handler commits nothing
    let (r5, e5) = actor.call(&sys, "alice", "fail", "", 5i64)
    if e5 != actor.Invalid { ret 306i32 }
    let (s5, has5) = actor.stored_state(&sys, "alice")
    if has5 && s5.len != 0usize { ret 307i32 }
    // and the grain is usable afterwards: no turn is left open
    let (r6, e6) = actor.call(&sys, "alice", "add", "2", 6i64)
    if e6 != ok || !str.eq(r6, "2") { ret 308i32 }
    ret 0i32
}

// 4xx
fn timers(a: *mem.Arena) -> i32 {
    var c = Counters { activations: 0u32, deactivations: 0u32 }
    let (db0, db_error) = new_db(a)
    if db_error != ok { ret 400i32 }
    var db = db0
    let (sys0, sys_error) = cluster(a, &c, &db)
    if sys_error != ok { ret 401i32 }
    var sys = sys0
    let (r, e) = actor.call(&sys, "clock", "timer-on", "", 1000i64)
    if e != ok || actor.timer_count(&sys) != 1usize { ret 402i32 }
    let (n0, t0) = actor.tick(&sys, 1099i64)
    if t0 != ok || n0 != 0usize { ret 403i32 }
    let (n1, t1) = actor.tick(&sys, 1100i64)
    if t1 != ok || n1 != 1usize { ret 404i32 }
    let (s1, f1) = actor.stored_state(&sys, "clock")
    if !f1 || !str.eq(s1, "1") { ret 405i32 }
    // a long gap is one firing, not a burst: due 1200 -> next after 1450 is 1500
    let (n2, t2) = actor.tick(&sys, 1450i64)
    if t2 != ok || n2 != 1usize { ret 406i32 }
    let (n3, t3) = actor.tick(&sys, 1499i64)
    if t3 != ok || n3 != 0usize { ret 407i32 }
    let (n4, t4) = actor.tick(&sys, 1500i64)
    if t4 != ok || n4 != 1usize { ret 408i32 }
    let (s4, f4) = actor.stored_state(&sys, "clock")
    if !f4 || !str.eq(s4, "3") { ret 409i32 }
    // deactivation takes the timer with it
    if actor.deactivate(&sys, "clock", 1600i64) != ok { ret 410i32 }
    if actor.timer_count(&sys) != 0usize { ret 411i32 }
    let (n5, t5) = actor.tick(&sys, 9000i64)
    if t5 != ok || n5 != 0usize { ret 412i32 }
    // the schedule arithmetic against the generated vectors
    var k = 0usize
    while k < gen_cases() {
        if actor.next_due(gen_due_in(k), gen_period_in(k), gen_now_in(k)) != gen_next_due(k) { ret 413i32 }
        k += 1usize
    }
    ret 0i32
}

// 5xx
fn reminders(a: *mem.Arena) -> i32 {
    var c = Counters { activations: 0u32, deactivations: 0u32 }
    let (db0, db_error) = new_db(a)
    if db_error != ok { ret 500i32 }
    var db = db0
    let (sys0, sys_error) = cluster(a, &c, &db)
    if sys_error != ok { ret 501i32 }
    var sys = sys0
    let (r, e) = actor.call(&sys, "pager", "remind", "", 1000i64)
    if e != ok || actor.reminder_count(&sys) != 1usize { ret 502i32 }
    // the grain is deactivated; the reminder still fires and activates it
    if actor.deactivate(&sys, "pager", 1100i64) != ok { ret 503i32 }
    let acts = c.activations
    let (n0, t0) = actor.tick(&sys, 1499i64)
    if t0 != ok || n0 != 0usize { ret 504i32 }
    let (n1, t1) = actor.tick(&sys, 1500i64)
    if t1 != ok || n1 != 1usize || c.activations != acts + 1u32 { ret 505i32 }
    let (s1, f1) = actor.stored_state(&sys, "pager")
    if !f1 || !str.eq(s1, "10") { ret 506i32 }
    // next due: 1500 + 1000 = 2500; a late tick at 5000 is one firing and moves to 5500
    let (v1, g1) = ds.get(&db, "reminders", "pager\x1Fr")
    if !g1 || !str.eq(v1, "2500,1000") { ret 507i32 }
    let (n2, t2) = actor.tick(&sys, 5000i64)
    if t2 != ok || n2 != 1usize { ret 508i32 }
    let (v2, g2) = ds.get(&db, "reminders", "pager\x1Fr")
    if !g2 || !str.eq(v2, "5500,1000") { ret 509i32 }
    // restart: the same file, a new process image; the reminder and the state are both there
    let (db2a, dropped, restore_error) = ds.restore(a, ds.bytes(&db), ds.Limits { log: 65536usize, docs: 64usize, events: 4usize, marks: 2usize, streams: 2usize })
    if restore_error != ok || dropped != 0usize { ret 510i32 }
    var db2 = db2a
    var c2 = Counters { activations: 0u32, deactivations: 0u32 }
    let (sys2a, sys2_error) = cluster(a, &c2, &db2)
    if sys2_error != ok { ret 511i32 }
    var sys2 = sys2a
    if actor.reminder_count(&sys2) != 1usize || actor.is_active(&sys2, "pager") { ret 512i32 }
    let (n3, t3) = actor.tick(&sys2, 5500i64)
    if t3 != ok || n3 != 1usize || c2.activations != 1u32 { ret 513i32 }
    let (s3, f3) = actor.stored_state(&sys2, "pager")
    if !f3 || !str.eq(s3, "30") { ret 514i32 }
    // cancelling stops it
    let (gone, cancel_error) = actor.reminder_cancel(&sys2, "pager", "r")
    if cancel_error != ok || !gone || actor.reminder_count(&sys2) != 0usize { ret 515i32 }
    let (n4, t4) = actor.tick(&sys2, 99999i64)
    if t4 != ok || n4 != 0usize { ret 516i32 }
    let (gone2, cancel_error2) = actor.reminder_cancel(&sys2, "pager", "r")
    if cancel_error2 != ok || gone2 { ret 517i32 }
    ret 0i32
}

// 6xx
fn refusals(a: *mem.Arena) -> i32 {
    var c = Counters { activations: 0u32, deactivations: 0u32 }
    let (db0, db_error) = new_db(a)
    if db_error != ok { ret 600i32 }
    var db = db0
    let (sys0, create_error) = actor.create(a, &db, behavior(&c), 1usize, 2usize, 1usize)
    if create_error != ok { ret 601i32 }
    var sys = sys0
    let (r0, e0) = actor.call(&sys, "g", "get", "", 1i64)
    if e0 != actor.NoSilo { ret 602i32 }
    let (idx, silo_error) = actor.add_silo(&sys, "only")
    if silo_error != ok { ret 603i32 }
    let (idx2, silo_error2) = actor.add_silo(&sys, "second")
    if silo_error2 != actor.Full { ret 604i32 }
    let (r1, e1) = actor.call(&sys, "", "get", "", 1i64)
    if e1 != actor.Invalid { ret 605i32 }
    let (r2, e2) = actor.call(&sys, "x", "add", "1", 1i64)
    let (r3, e3) = actor.call(&sys, "y", "add", "1", 1i64)
    if e2 != ok || e3 != ok { ret 606i32 }
    let (r4, e4) = actor.call(&sys, "z", "add", "1", 1i64)
    if e4 != actor.Full { ret 607i32 }
    // a refused handler kind leaves the grain active and its state alone
    let (r5, e5) = actor.call(&sys, "x", "no-such-kind", "", 2i64)
    if e5 != actor.Invalid { ret 608i32 }
    let (r6, e6) = actor.call(&sys, "x", "get", "", 3i64)
    if e6 != ok || !str.eq(r6, "1") { ret 609i32 }
    if actor.reminder_set(&sys, "x", "r", 5i64, -1i64) != actor.Invalid { ret 610i32 }
    ret 0i32
}

fn main(a: *mem.Arena) -> err {
    var code = activation(a)
    if code == 0i32 { code = failure(a) }
    if code == 0i32 { code = reentrancy(a) }
    if code == 0i32 { code = timers(a) }
    if code == 0i32 { code = reminders(a) }
    if code == 0i32 { code = refusals(a) }
    if code != 0i32 { os.exit(code) }
    ret ok
}
