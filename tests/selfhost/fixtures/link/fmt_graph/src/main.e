fn same_attr(a: gr.Attr, name: str, kind: gr.AttrKind, value: str) -> bool {
    ret str.eq(a.name, name) && a.kind == kind && str.eq(a.value, value)
}

fn same_bytes(x: str, y: str) -> bool {
