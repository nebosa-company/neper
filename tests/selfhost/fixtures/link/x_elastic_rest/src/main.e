    if run_chunk(a, vectors_1()) != 0u8 { os.exit(101i32) }
    if run_chunk(a, vectors_2()) != 0u8 { os.exit(102i32) }
    if run_chunk(a, vectors_3()) != 0u8 { os.exit(103i32) }
    if run_chunk(a, vectors_4()) != 0u8 { os.exit(104i32) }
    if run_chunk(a, vectors_5()) != 0u8 { os.exit(105i32) }
