    var y = 0usize
    while y < usize(source.height) {
        let row = decoded.pixels[y * decoded.stride..y * decoded.stride + usize(source.width) * bpp]
        if !mem.eq[u8](row, expected[y * usize(source.width) * bpp..(y + 1usize) * usize(source.width) * bpp]) { ret base + 5i32 }
        y += 1usize
    }
    ret 0i32
}

fn main(a: *mem.Arena, args: []str) -> err {
    let c1 = check(a, rgba8_png(), rgba8_pixels(), 9u32, 7u32, .Rgba8, 10i32)
    if c1 != 0i32 { os.exit(c1) }
    let c2 = check(a, rgb8_png(), rgb8_pixels(), 9u32, 7u32, .Rgba8, 20i32)
    if c2 != 0i32 { os.exit(c2) }
    let c3 = check(a, gray8_png(), gray8_pixels(), 9u32, 7u32, .R8, 30i32)
    if c3 != 0i32 { os.exit(c3) }
    let c4 = check(a, gray1_png(), gray1_pixels(), 9u32, 7u32, .R8, 40i32)
    if c4 != 0i32 { os.exit(c4) }
    let c5 = check(a, gray4_png(), gray4_pixels(), 9u32, 7u32, .R8, 50i32)
    if c5 != 0i32 { os.exit(c5) }
    let c6 = check(a, indexed4_png(), indexed4_pixels(), 9u32, 7u32, .Rgba8, 60i32)
    if c6 != 0i32 { os.exit(c6) }
    let c7 = check(a, indexed_trns_png(), indexed_trns_pixels(), 9u32, 7u32, .Rgba8, 70i32)
    if c7 != 0i32 { os.exit(c7) }
    let c8 = check(a, gray_alpha_png(), gray_alpha_pixels(), 9u32, 7u32, .Rgba8, 80i32)
    if c8 != 0i32 { os.exit(c8) }
    let c9 = check(a, interlaced_png(), interlaced_pixels(), 9u32, 7u32, .Rgba8, 90i32)
    if c9 != 0i32 { os.exit(c9) }
    let c10 = check(a, gray16_png(), gray16_pixels(), 6u32, 4u32, .R8, 100i32)
    if c10 != 0i32 { os.exit(c10) }

    // Encoding: RGBA straight, RGB from an opaque view, greyscale, BGRA, interlaced.
    let (rgba, rgba_error) = image.make_const(rgba8_pixels(), 9u32, 7u32, 36usize, .Rgba8, .Straight)
    if rgba_error != ok { os.exit(110i32) }
    let r1 = round_trip(a, rgba, rgba8_pixels(), .Rgba8, .Balanced, false, 120i32)
    if r1 != 0i32 { os.exit(r1) }
    let r2 = round_trip(a, rgba, rgba8_pixels(), .Rgba8, .Best, true, 130i32)
    if r2 != 0i32 { os.exit(r2) }
    let (opaque, opaque_error) = image.make_const(rgb8_pixels(), 9u32, 7u32, 36usize, .Rgba8, .Opaque)
    if opaque_error != ok { os.exit(140i32) }
    let r3 = round_trip(a, opaque, rgb8_pixels(), .Rgba8, .Fast, false, 150i32)
    if r3 != 0i32 { os.exit(r3) }
    let (grey, grey_error) = image.make_const(gray8_pixels(), 9u32, 7u32, 9usize, .R8, .Opaque)
    if grey_error != ok { os.exit(160i32) }
    let r4 = round_trip(a, grey, gray8_pixels(), .R8, .Balanced, true, 170i32)
    if r4 != 0i32 { os.exit(r4) }
    let (bgra_bytes, bgra_alloc) = mem.alloc[u8](a, rgba8_pixels().len)
    if bgra_alloc != ok { os.exit(180i32) }
    var i = 0usize
    while i < bgra_bytes.len {
        bgra_bytes[i] = rgba8_pixels()[i + 2usize]
        bgra_bytes[i + 1usize] = rgba8_pixels()[i + 1usize]
        bgra_bytes[i + 2usize] = rgba8_pixels()[i]
        bgra_bytes[i + 3usize] = rgba8_pixels()[i + 3usize]
        i += 4usize
    }
    let (bgra, bgra_error) = image.make_const(bgra_bytes, 9u32, 7u32, 36usize, .Bgra8, .Straight)
    if bgra_error != ok { os.exit(190i32) }
    let r5 = round_trip(a, bgra, rgba8_pixels(), .Rgba8, .Balanced, false, 200i32)
    if r5 != 0i32 { os.exit(r5) }

    // Refusals.
    var state: io.SliceReader = zero
    let (_, signature_error) = png.decode(a, reader_of(&state, "not a png at all, not even close"), options())
    if signature_error != png.Invalid { os.exit(210i32) }
    let (corrupt, corrupt_alloc) = mem.alloc[u8](a, rgba8_png().len)
    if corrupt_alloc != ok { os.exit(211i32) }
    mem.copy[u8](corrupt, rgba8_png())
    corrupt[40] = corrupt[40] ^ 255u8
    let (_, crc_error) = png.decode(a, reader_of(&state, corrupt), options())
    if crc_error != png.Checksum { os.exit(212i32) }
    let (_, bounded_error) = png.decode(a, reader_of(&state, rgba8_png()), png.DecodeOptions { max_width: 8u32, max_height: 0u32, max_pixels: 0u64, verify_crc: true })
    let (_, pixel_bounded_error) = png.decode(a, reader_of(&state, rgba8_png()), png.DecodeOptions { max_width: 0u32, max_height: 0u32, max_pixels: 62u64, verify_crc: true })
    if bounded_error != png.TooLarge || pixel_bounded_error != png.TooLarge { os.exit(213i32) }
    let (halves, halves_error) = image.allocate(a, 2u32, 2u32, .Rgba16Float, .Straight)
    if halves_error != ok { os.exit(214i32) }
    let (half_view, half_view_error) = image.make_const(halves.pixels, 2u32, 2u32, 16usize, .Rgba16Float, .Straight)
    let (scratch, scratch_alloc) = mem.alloc[u8](a, 1024usize)
    if half_view_error != ok || scratch_alloc != ok { os.exit(215i32) }
    var sink = io.SliceWriter { data: scratch, off: 0usize }
    var w = io.slice_writer(&sink)
    if png.encode(&w, half_view, png.EncodeOptions { compression: .Fast, interlace: false }) != png.Unsupported { os.exit(216i32) }

    try io.print("fmt png ok\n")
    ret ok
}
