    if client_error3 != ok { ret 2313i32 }
    var small = t0
    if report.capture(&small, &ev0, zero, 1i64) != report.TooLarge { ret 2314i32 }
    // capture from the running program: a backtrace becomes an event
    var frames: [16]debug.Frame = zero
    if report.capture_here(&c, "error", "Panic", "boom", id_n(3usize), "app@0", 5i64, frames[0..]) != ok { ret 2315i32 }
    if report.pending(&c) != 2usize { ret 2316i32 }
    let (bad_client, bad_error) = report.client(a, "nonsense", transport(&f), "x", 1usize, 1usize)
    if bad_error != report.Invalid { ret 2317i32 }
    ret 0i32
}

fn main(a: *mem.Arena) -> err {
    var code = gen_dsn(a)
    if code == 0i32 { code = gen_envelope_0(a) }
    if code == 0i32 { code = gen_envelope_1(a) }
    if code == 0i32 { code = gen_envelope_2(a) }
    if code == 0i32 { code = gen_rate_limits() }
    if code == 0i32 { code = delivery(a) }
    if code == 0i32 { code = outage(a) }
    if code == 0i32 { code = rate_limited(a) }
    if code == 0i32 { code = queue(a) }
    if code != 0i32 {
        // a status of 256, 512, ... would read as success on Linux, where it is taken mod 256
        var shown = code
        if shown % 256i32 == 0i32 { shown += 1i32 }
        os.exit(shown)
    }
    ret ok
}
