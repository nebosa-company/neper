// `e.gfx.image.phash256` against mtg.studio's card-scan hash: eight real card arts from
// its Dart-emitted parity vectors, each 64x64 grayscale rebuilt as Rgba8 pixels that gray
// to exactly those bytes, and four LCG-noise images in every 8-bit format, with a padded
// stride, enlarged and shrunk, hashed by its JS port. Generated by generate.mjs
// beside this file. Every check has its own exit code.
use e.bytes
use e.gfx.image
use e.mem
use e.os

fn same(hash: [32]u8, expected: str) -> bool {
    var want: [32]u8 = zero
    let (decoded, e) = bytes.hex_decode(want[..], expected)
    if e != ok || decoded.len != 32usize { ret false }
    var i = 0usize
    while i < 32usize {
        if hash[i] != want[i] { ret false }
        i += 1usize
    }
    ret true
}

// A 64x64 grayscale as Rgba8 pixels, each byte through its triple.
fn real(rgba: []u8, triples: []const u8, gray: str, expected: str, code: i32) {
    var raw: [4096]u8 = zero
    let (decoded, e) = bytes.hex_decode(raw[..], gray)
    if e != ok || decoded.len != 4096usize { os.exit(code) }
    var i = 0usize
    while i < 4096usize {
        let t = usize(raw[i]) * 3usize
        rgba[i * 4usize] = triples[t]
        rgba[i * 4usize + 1usize] = triples[t + 1usize]
        rgba[i * 4usize + 2usize] = triples[t + 2usize]
        rgba[i * 4usize + 3usize] = 255u8
        i += 1usize
    }
    let (img, img_error) = image.make_const(rgba[..16384usize], 64u32, 64u32, 256usize, .Rgba8, .Opaque)
    if img_error != ok { os.exit(code) }
    let (hash, hash_error) = image.phash256(img)
    if hash_error != ok || !same(hash, expected) { os.exit(code + 1i32) }
}

fn synthetic(a: *mem.Arena, width: u32, height: u32, stride: usize, format: image.Format, seed: u32, expected: str, code: i32) {
    let (raw, alloc_error) = mem.alloc[u8](a, stride * usize(height))
    if alloc_error != ok { os.exit(code) }
    var s = seed
    var i = 0usize
    while i < raw.len {
        s = s *% 1664525u32 +% 1013904223u32
        raw[i] = u8(s >> 24u32)
        i += 1usize
    }
    let (img, img_error) = image.make_const(raw, width, height, stride, format, .Opaque)
    if img_error != ok { os.exit(code) }
    let (hash, hash_error) = image.phash256(img)
    if hash_error != ok || !same(hash, expected) { os.exit(code + 1i32) }
}

fn main(a: *mem.Arena, args: []str) -> err {
    var triples: [768]u8 = zero
    let (decoded, e) = bytes.hex_decode(triples[..], "")
    if e != ok || decoded.len != 768usize { os.exit(1i32) }
    var rgba: [16384]u8 = zero
    // Alpha/Ancestral Recall.full.jpg, 312x445
    real(rgba[..], triples[..], "", "02455c40bc72833ff923315c7ea63971383b1e5f765e0f6d431ec6528d2de630", 10i32)
    // Beta/Black Lotus.full.jpg, 312x445
    real(rgba[..], triples[..], "", "54892124a964ce5beb66d07beb067c078f2b740dd973662b0e7d1a56f027461e", 12i32)
    // Unlimited/Shivan Dragon.full.jpg, 312x445
    real(rgba[..], triples[..], "", "ddfd9df8e686e2c733e217abc3d8708c0b8ec0e3c7e102fe08846c9c188ece43", 14i32)
    // Bloomburrow/Agate Assault.full.jpg, 488x680
    real(rgba[..], triples[..], "", "5601e722b9ee0d4ef9a2d87cf97a1c17e9863105e9f8e3410e87713889fb860b", 16i32)
    // Duskmourn House of Horror/Abandoned Campground.full.jpg, 488x680
    real(rgba[..], triples[..], "", "55157644ba08c94f896f7e18f82e8b3bb9a6817f8b7e3e00a8ffc049e2d10734", 18i32)
    // Throne of Eldraine/Oko, Thief of Crowns.full.jpg, 672x936
    real(rgba[..], triples[..], "", "56018b76897ef911b97e612aab7cec4aa9cd140feaf89609a8ef4234fab81813", 20i32)
    // Secret Lair Drop/20 Ways/Approach of the Second Sun [20 Ways].full.jpg, 488x680
    real(rgba[..], triples[..], "", "15d1f1607eea907181988d21632eda4e7262773e1cbce3b2e99443f2e7c8f413", 22i32)
    // Kaladesh/Aether Hub.full.jpg, 312x445
    real(rgba[..], triples[..], "", "5615ee4abb6a3933d9e8c14db92a237f192e0e7de9608671a13e061fc9231e4c", 24i32)
    // Rgba8 137x191, shrunk by a non-integer ratio
    synthetic(a, 137u32, 191u32, 548usize, .Rgba8, 1u32, "2fe638054f55d14f4fb565f031a6bf017ac1024395417f3598d03de93d9d4d60", 40i32)
    // Bgra8 50x37 with a padded stride, enlarged
    synthetic(a, 50u32, 37u32, 212usize, .Bgra8, 2u32, "6d3d1128f81274363faffc6d1422fda2d8ce1dbaaefe052a4a3143b64151961c", 42i32)
    // R8 312x445, the old-frame card size
    synthetic(a, 312u32, 445u32, 312usize, .R8, 3u32, "9fb02419c62d154be9e29c6b2577754a8675e6a9a73ce6cb514282323d778f01", 44i32)
    // Rgba8 3x2, enlarged from almost nothing
    synthetic(a, 3u32, 2u32, 12usize, .Rgba8, 4u32, "ff77008008c8e0fc800cc8c4ff7388b348fc60fc805d8cffce3d88b9ccfc6e7c", 46i32)
    // One pixel hashes; a flat image's bits are rounding noise (D1570), so no expectation.
    var one: [4]u8 = zero
    let (px, px_error) = image.make_const(one[..], 1u32, 1u32, 4usize, .Rgba8, .Opaque)
    if px_error != ok { os.exit(58i32) }
    let (_, one_error) = image.phash256(px)
    if one_error != ok { os.exit(59i32) }
    // A half-float view and an empty one have no hash.
    var half: [8]u8 = zero
    let (hf, hf_error) = image.make_const(half[..], 1u32, 1u32, 8usize, .Rgba16Float, .Opaque)
    if hf_error != ok { os.exit(60i32) }
    let (_, half_error) = image.phash256(hf)
    if half_error != image.Invalid { os.exit(61i32) }
    let (empty, empty_error) = image.make_const(half[..0usize], 0u32, 0u32, 0usize, .Rgba8, .Opaque)
    if empty_error != ok { os.exit(62i32) }
    let (_, none_error) = image.phash256(empty)
    if none_error != image.Invalid { os.exit(63i32) }
    ret ok
}
