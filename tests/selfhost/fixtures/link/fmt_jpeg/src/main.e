fn reader_of(state: *io.SliceReader, data: str) -> io.Reader {
    state.data = data
    state.off = 0usize
    ret io.slice_reader(state)
}

fn options() -> jpeg.DecodeOptions {
    ret jpeg.DecodeOptions { max_width: 0u32, max_height: 0u32, max_pixels: 0u64 }
}

// The largest per-sample distance between the decoded image and `pixels`.
fn worst(decoded: image.Image, pixels: str) -> i32 {
    let bpp = image.bytes_per_pixel(decoded.format)
    var worst_seen = 0i32
    var y = 0usize
    while y < usize(decoded.height) {
        var x = 0usize
        while x < usize(decoded.width) {
            var c = 0usize
            while c < bpp {
                if !(bpp == 4usize && c == 3usize) {
                    var d = i32(decoded.pixels[y * decoded.stride + x * bpp + c]) - i32(pixels[(y * usize(decoded.width) + x) * bpp + c])
                    if d < 0i32 { d = 0i32 - d }
                    if d > worst_seen { worst_seen = d }
                }
                c += 1usize
            }
            x += 1usize
        }
        y += 1usize
    }
    ret worst_seen
}

fn check(a: *mem.Arena, data: str, pixels: str, width: u32, height: u32, format: image.Format, tolerance: i32, base: i32) -> i32 {
    var state: io.SliceReader = zero
    let (info, inspect_error) = jpeg.inspect(reader_of(&state, data))
    if inspect_error != ok { ret base + 1i32 }
    if info.width != width || info.height != height || info.format != format || info.frames != 1u32 { ret base + 2i32 }
    let (decoded, decode_error) = jpeg.decode(a, reader_of(&state, data), options())
    if decode_error != ok { ret base + 3i32 }
    if decoded.width != width || decoded.height != height || decoded.format != format { ret base + 4i32 }
    if pixels.len != usize(width) * usize(height) * image.bytes_per_pixel(format) { ret base + 5i32 }
    if worst(decoded, pixels) > tolerance { ret base + 6i32 }
    ret 0i32
}

fn round_trip(a: *mem.Arena, source: image.ConstImage, expected: str, expected_format: image.Format, quality: u8, tolerance: i32, base: i32) -> i32 {
    let (buffer, buffer_error) = mem.alloc[u8](a, 65536usize)
    if buffer_error != ok { ret base + 1i32 }
    var sink = io.SliceWriter { data: buffer, off: 0usize }
    var w = io.slice_writer(&sink)
    if jpeg.encode(&w, source, jpeg.EncodeOptions { quality: quality, progressive: false }) != ok { ret base + 2i32 }
    var state: io.SliceReader = zero
    let (decoded, decode_error) = jpeg.decode(a, reader_of(&state, buffer[..sink.off]), options())
    if decode_error != ok { ret base + 3i32 }
    if decoded.format != expected_format || decoded.width != source.width || decoded.height != source.height { ret base + 4i32 }
    if worst(decoded, expected) > tolerance { ret base + 5i32 }
    ret 0i32
}

fn main(a: *mem.Arena, args: []str) -> err {
    let c1 = check(a, baseline444_jpg(), baseline444_pixels(), 23u32, 17u32, .Rgba8, 3i32, 10i32)
    if c1 != 0i32 { os.exit(c1) }
    let c2 = check(a, baseline420_jpg(), baseline420_pixels(), 23u32, 17u32, .Rgba8, 6i32, 20i32)
    if c2 != 0i32 { os.exit(c2) }
    let c3 = check(a, progressive_jpg(), progressive_pixels(), 23u32, 17u32, .Rgba8, 6i32, 30i32)
    if c3 != 0i32 { os.exit(c3) }
    let c4 = check(a, gray_jpg(), gray_pixels(), 23u32, 17u32, .R8, 2i32, 40i32)
    if c4 != 0i32 { os.exit(c4) }
    let c5 = check(a, gray_progressive_jpg(), gray_progressive_pixels(), 23u32, 17u32, .R8, 2i32, 50i32)
    if c5 != 0i32 { os.exit(c5) }
    let c6 = check(a, restarts_jpg(), restarts_pixels(), 23u32, 17u32, .Rgba8, 3i32, 60i32)
    if c6 != 0i32 { os.exit(c6) }

    // Encoding: the libjpeg-decoded baseline 4:4:4 pixels as the source.
    let (rgba, rgba_error) = image.make_const(baseline444_pixels(), 23u32, 17u32, 92usize, .Rgba8, .Opaque)
    if rgba_error != ok { os.exit(70i32) }
    let r1 = round_trip(a, rgba, baseline444_pixels(), .Rgba8, 95u8, 24i32, 80i32)
    if r1 != 0i32 { os.exit(r1) }
    let r2 = round_trip(a, rgba, baseline444_pixels(), .Rgba8, 50u8, 110i32, 90i32)
    if r2 != 0i32 { os.exit(r2) }
    let (bgra_bytes, bgra_alloc) = mem.alloc[u8](a, baseline444_pixels().len)
    if bgra_alloc != ok { os.exit(100i32) }
    var i = 0usize
    while i < bgra_bytes.len {
        bgra_bytes[i] = baseline444_pixels()[i + 2usize]
        bgra_bytes[i + 1usize] = baseline444_pixels()[i + 1usize]
        bgra_bytes[i + 2usize] = baseline444_pixels()[i]
        bgra_bytes[i + 3usize] = 255u8
        i += 4usize
    }
    let (bgra, bgra_error) = image.make_const(bgra_bytes, 23u32, 17u32, 92usize, .Bgra8, .Opaque)
    if bgra_error != ok { os.exit(101i32) }
    let r3 = round_trip(a, bgra, baseline444_pixels(), .Rgba8, 95u8, 24i32, 110i32)
    if r3 != 0i32 { os.exit(r3) }
    let (grey, grey_error) = image.make_const(gray_pixels(), 23u32, 17u32, 23usize, .R8, .Opaque)
    if grey_error != ok { os.exit(120i32) }
    let r4 = round_trip(a, grey, gray_pixels(), .R8, 95u8, 24i32, 130i32)
    if r4 != 0i32 { os.exit(r4) }

    // Refusals.
    var state: io.SliceReader = zero
    let (_, signature_error) = jpeg.decode(a, reader_of(&state, "definitely not a jpeg stream"), options())
    if signature_error != jpeg.Invalid { os.exit(140i32) }
    let (_, bounded_error) = jpeg.decode(a, reader_of(&state, baseline444_jpg()), jpeg.DecodeOptions { max_width: 16u32, max_height: 0u32, max_pixels: 0u64 })
    if bounded_error != jpeg.TooLarge { os.exit(141i32) }
    let (scratch, scratch_alloc) = mem.alloc[u8](a, 4096usize)
    if scratch_alloc != ok { os.exit(142i32) }
    var sink = io.SliceWriter { data: scratch, off: 0usize }
    var w = io.slice_writer(&sink)
    if jpeg.encode(&w, rgba, jpeg.EncodeOptions { quality: 80u8, progressive: true }) != jpeg.Unsupported { os.exit(143i32) }
    let (halves, halves_error) = image.allocate(a, 2u32, 2u32, .Rgba16Float, .Straight)
    let (half_view, half_view_error) = image.make_const(halves.pixels, 2u32, 2u32, 16usize, .Rgba16Float, .Straight)
    if halves_error != ok || half_view_error != ok { os.exit(144i32) }
    if jpeg.encode(&w, half_view, jpeg.EncodeOptions { quality: 80u8, progressive: false }) != jpeg.Unsupported { os.exit(145i32) }

    try io.print("fmt jpeg ok\n")
    ret ok
}
