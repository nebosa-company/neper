// The scripted ten operations; the database they leave is the model's image.
fn script(db: *ds.Db) -> i32 {
    if ds.put(db, "users", "u1", "{\"name\":\"ada\",\"age\":36}") != ok { ret 101i32 }
    if ds.put(db, "users", "u2", "{\"name\":\"bob\"}") != ok { ret 102i32 }
    if ds.put(db, "orders", "o1", "{\"total\":0}") != ok { ret 103i32 }
    if ds.put(db, "users", "u1", "{\"name\":\"ada\",\"age\":37}") != ok { ret 104i32 }
    let (gone, delete_error) = ds.delete(db, "users", "u2")
    if delete_error != ok || !gone { ret 105i32 }
    let (s1, e1) = ds.append(db, "order-1", "OrderPlaced", "{\"customer\":\"u1\"}", 1000i64, 0i64)
    if e1 != ok || s1 != 1u64 { ret 106i32 }
    let (s2, e2) = ds.append(db, "order-1", "ItemAdded", "2", 1001i64, 1i64)
    if e2 != ok || s2 != 2u64 { ret 107i32 }
    let (s3, e3) = ds.append(db, "order-2", "OrderPlaced", "{}", 1002i64, ds.ANY_VERSION)
    if e3 != ok || s3 != 3u64 { ret 108i32 }
    let (s4, e4) = ds.append(db, "order-1", "ItemAdded", "3", 1003i64, 2i64)
    if e4 != ok || s4 != 4u64 { ret 109i32 }
    if ds.ack(db, "mailer", 2u64) != ok { ret 110i32 }
    ret 0i32
}

fn same_state(x: *ds.Db, y: *ds.Db) -> bool {
    if ds.count(x, "users") != ds.count(y, "users") || ds.count(x, "orders") != ds.count(y, "orders") { ret false }
    if ds.event_count(x) != ds.event_count(y) { ret false }
    if ds.stream_version(x, "order-1") != ds.stream_version(y, "order-1") { ret false }
    if ds.position(x, "mailer") != ds.position(y, "mailer") { ret false }
    let (d1, f1) = ds.get(x, "users", "u1")
    let (d2, f2) = ds.get(y, "users", "u1")
    ret f1 == f2 && str.eq(d1, d2)
}

// 1xx
fn image_and_state(a: *mem.Arena) -> i32 {
    let (db0, create_error) = ds.create(a, limits())
    if create_error != ok { ret 100i32 }
    var db = db0
    let code = script(&db)
    if code != 0i32 { ret code }
    if !str.eq(ds.bytes(&db), gen_image()) { ret 111i32 }
    if ds.bytes(&db).len != gen_len() { ret 112i32 }
    if ds.count(&db, "users") != 1usize || ds.count(&db, "orders") != 1usize { ret 113i32 }
    let (u1, found1) = ds.get(&db, "users", "u1")
    if !found1 || !str.eq(u1, "{\"name\":\"ada\",\"age\":37}") { ret 114i32 }
    let (u2, found2) = ds.get(&db, "users", "u2")
    if found2 { ret 115i32 }
    if ds.event_count(&db) != 4usize { ret 116i32 }
    if ds.stream_version(&db, "order-1") != 3u32 || ds.stream_version(&db, "order-2") != 1u32 || ds.stream_version(&db, "nope") != 0u32 { ret 117i32 }
    var evs: [8]ds.Event = zero
    let n = ds.read_stream(&db, "order-1", 2u32, evs[0..])
    if n != 2usize || !str.eq(evs[0].kind, "ItemAdded") || evs[0].version != 2u32 || evs[1].seq != 4u64 || evs[1].at != 1003i64 { ret 118i32 }
    let m = ds.read_all(&db, 1u64, evs[0..])
    if m != 3usize || evs[0].seq != 2u64 || !str.eq(evs[1].stream, "order-2") { ret 119i32 }
    let (id0, data0, at0) = ds.doc_at(&db, "users", 0usize)
    if !at0 || !str.eq(id0, "u1") { ret 120i32 }
    let (id1, data1, at1) = ds.doc_at(&db, "users", 1usize)
    if at1 { ret 121i32 }
    if ds.position(&db, "mailer") != 2u64 || ds.position(&db, "other") != 0u64 { ret 122i32 }
    // replaying the whole image reaches the same state and drops nothing
    let (r0, dropped, restore_error) = ds.restore(a, ds.bytes(&db), limits())
    if restore_error != ok || dropped != 0usize { ret 123i32 }
    var r = r0
    if !same_state(&db, &r) { ret 124i32 }
    if !str.eq(ds.bytes(&r), gen_image()) { ret 125i32 }
    ret 0i32
}

// 2xx
fn concurrency(a: *mem.Arena) -> i32 {
    let (db0, create_error) = ds.create(a, limits())
    if create_error != ok { ret 200i32 }
    var db = db0
    let code = script(&db)
    if code != 0i32 { ret code }
    let before = ds.bytes(&db).len
    let (n1, e1) = ds.append(&db, "order-1", "ItemAdded", "9", 1i64, 2i64)
    if e1 != ds.Concurrency || n1 != 0u64 { ret 201i32 }
    let (n2, e2) = ds.append(&db, "order-1", "OrderPlaced", "", 1i64, 0i64)
    if e2 != ds.Concurrency { ret 202i32 }
    let (n3, e3) = ds.append(&db, "brand-new", "OrderPlaced", "", 1i64, 1i64)
    if e3 != ds.Concurrency { ret 203i32 }
    if ds.bytes(&db).len != before || ds.event_count(&db) != 4usize { ret 204i32 }
    let (n4, e4) = ds.append(&db, "order-1", "ItemAdded", "9", 1i64, 3i64)
    if e4 != ok || n4 != 5u64 || ds.stream_version(&db, "order-1") != 4u32 { ret 205i32 }
    let (n5, e5) = ds.append(&db, "", "x", "", 1i64, -1i64)
    if e5 != ds.Invalid { ret 206i32 }
    let (n6, e6) = ds.append(&db, "s", "x", "", 1i64, -2i64)
    if e6 != ds.Invalid { ret 207i32 }
    if ds.put(&db, "", "id", "x") != ds.Invalid { ret 208i32 }
    ret 0i32
}

// 3xx: every prefix of the log, cut partway into the next frame, recovers to the model's state.
fn recovery(a: *mem.Arena) -> i32 {
    let image = gen_image()
    var k = 0usize
    while k <= gen_ops() {
        let cut_at = gen_end(k)
        // clean boundary
        let (c0, dropped0, err0) = ds.restore(a, image[0..cut_at], limits())
        if err0 != ok || dropped0 != 0usize { ret 301i32 }
        var c = c0
        let live = ds.count(&c, "users") + ds.count(&c, "orders")
        let ev = ds.event_count(&c)
        let mk = c.nmarks
        if live != gen_docs(k) || ev != gen_events(k) || mk != gen_marks(k) { ret 302i32 }
        // a torn next frame: five bytes of it present
        if k < gen_ops() {
            let torn_at = cut_at + 5usize
            let (t0, dropped1, err1) = ds.restore(a, image[0..torn_at], limits())
            if err1 != ok || dropped1 != 5usize { ret 303i32 }
            var t = t0
            if ds.count(&t, "users") + ds.count(&t, "orders") != gen_docs(k) || ds.event_count(&t) != gen_events(k) { ret 304i32 }
            if ds.bytes(&t).len != cut_at { ret 305i32 }
            // appending after a torn recovery continues cleanly from the sound prefix
            if ds.put(&t, "users", "after", "1") != ok { ret 306i32 }
            let (t2a, dropped2, err2) = ds.restore(a, ds.bytes(&t), limits())
            var t2 = t2a
            if err2 != ok || dropped2 != 0usize || ds.count(&t2, "users") != ds.count(&t, "users") { ret 307i32 }
        }
        k += 1usize
    }
    // one flipped payload byte in frame 5 (the delete): everything from there is dropped
    var damaged: [512]u8 = zero
    var i = 0usize
    while i < image.len {
        damaged[i] = image[i]
        i += 1usize
    }
    damaged[gen_end(4usize) + 10usize] = damaged[gen_end(4usize) + 10usize] ^ 255u8
    let (d0, dropped3, err3) = ds.restore(a, damaged[0..image.len], limits())
    if err3 != ok || dropped3 != image.len - gen_end(4usize) { ret 308i32 }
    var d = d0
    if ds.count(&d, "users") != 2usize || ds.event_count(&d) != 0usize { ret 309i32 }
    // a wrong magic is refused outright
    let (w0, dropped4, err4) = ds.restore(a, "XDS1", limits())
    if err4 != ds.Corrupt { ret 310i32 }
    ret 0i32
}

// 4xx: a projection of ItemAdded quantities into `order_items`.
fn parse_dec(s: str) -> i64 {
    var v = 0i64
    var i = 0usize
    while i < s.len {
        v = v * 10i64 + i64(s[i] - 48u8)
        i += 1usize
    }
    ret v
}

fn apply_items(ctx: *void, db: *ds.Db, ev: ds.Event) -> err {
    if !str.eq(ev.kind, "ItemAdded") { ret ok }
    let (cur, found) = ds.get(db, "order_items", ev.stream)
    var total = 0i64
    if found { total = parse_dec(cur) }
    total += parse_dec(ev.data)
    // decimal text of total, up to 6 digits, built in a small array that the document copies
    var digits: [8]u8 = zero
    var n = 0usize
    var t = total
    if t == 0i64 {
        digits[0] = 48u8
        n = 1usize
    }
    while t > 0i64 {
        digits[n] = 48u8 + u8(t % 10i64)
        t = t / 10i64
        n += 1usize
    }
    var text: [8]u8 = zero
    var j = 0usize
    while j < n {
        text[j] = digits[n - 1usize - j]
        j += 1usize
    }
    ret ds.put(db, "order_items", ev.stream, text[0..n])
}

fn projections(a: *mem.Arena) -> i32 {
    let (db0, create_error) = ds.create(a, limits())
    if create_error != ok { ret 400i32 }
    var db = db0
    let code = script(&db)
    if code != 0i32 { ret code }
    let p = ds.Projection { name: "items", ctx: nil, apply: apply_items }
    let (n, e) = ds.project(&db, p, 100usize)
    if e != ok || n != 4usize { ret 401i32 }
    let (v1, f1) = ds.get(&db, "order_items", "order-1")
    if !f1 || !str.eq(v1, "5") { ret 402i32 }
    let (v2, f2) = ds.get(&db, "order_items", "order-2")
    if f2 { ret 403i32 }
    // caught up: nothing more to apply
    let (n2, e2) = ds.project(&db, p, 100usize)
    if e2 != ok || n2 != 0usize { ret 404i32 }
    // new events are applied incrementally, in batches
    let (s5, a5) = ds.append(&db, "order-2", "ItemAdded", "7", 2000i64, 1i64)
    let (s6, a6) = ds.append(&db, "order-1", "ItemAdded", "10", 2001i64, 3i64)
    let (s7, a7) = ds.append(&db, "order-2", "ItemAdded", "1", 2002i64, 2i64)
    if a5 != ok || a6 != ok || a7 != ok { ret 405i32 }
    let (n3, e3) = ds.project(&db, p, 2usize)
    if e3 != ok || n3 != 2usize { ret 406i32 }
    let (n4, e4) = ds.project(&db, p, 2usize)
    if e4 != ok || n4 != 1usize { ret 407i32 }
    let (w1, g1) = ds.get(&db, "order_items", "order-1")
    let (w2, g2) = ds.get(&db, "order_items", "order-2")
    if !g1 || !str.eq(w1, "15") || !g2 || !str.eq(w2, "8") { ret 408i32 }
    // a rebuild folds the whole journal again to the same documents
    let (n5, e5) = ds.rebuild(&db, p, "order_items")
    if e5 != ok || n5 != 7usize { ret 409i32 }
    let (x1, h1) = ds.get(&db, "order_items", "order-1")
    let (x2, h2) = ds.get(&db, "order_items", "order-2")
    if !h1 || !str.eq(x1, "15") || !h2 || !str.eq(x2, "8") { ret 410i32 }
    if ds.count(&db, "order_items") != 2usize { ret 411i32 }
    // the projection's mark survives a reopen: nothing is re-applied
    let (r0, dropped, restore_error) = ds.restore(a, ds.bytes(&db), limits())
    if restore_error != ok || dropped != 0usize { ret 412i32 }
    var r = r0
    let (n6, e6) = ds.project(&r, p, 100usize)
    if e6 != ok || n6 != 0usize { ret 413i32 }
    ret 0i32
}

// 5xx
fn subscriptions(a: *mem.Arena) -> i32 {
    let (db0, create_error) = ds.create(a, limits())
    if create_error != ok { ret 500i32 }
    var db = db0
    let code = script(&db)
    if code != 0i32 { ret code }
    var evs: [8]ds.Event = zero
    // "mailer" acknowledged up to 2: events 3 and 4 are what is left
    let n = ds.poll(&db, "mailer", evs[0..])
    if n != 2usize || evs[0].seq != 3u64 || evs[1].seq != 4u64 { ret 501i32 }
    // a new subscription starts at the beginning
    if ds.poll(&db, "audit", evs[0..]) != 4usize { ret 502i32 }
    if ds.ack(&db, "mailer", 1u64) != ds.Invalid { ret 503i32 }
    if ds.ack(&db, "mailer", 5u64) != ds.Invalid { ret 504i32 }
    if ds.ack(&db, "mailer", 4u64) != ok { ret 505i32 }
    if ds.poll(&db, "mailer", evs[0..]) != 0usize { ret 506i32 }
    // the position is in the file: a reopened database resumes there and sees only what is new
    let (r0, dropped, restore_error) = ds.restore(a, ds.bytes(&db), limits())
    if restore_error != ok || dropped != 0usize { ret 507i32 }
    var r = r0
    if ds.position(&r, "mailer") != 4u64 { ret 508i32 }
    let (s5, a5) = ds.append(&r, "order-2", "ItemAdded", "7", 3000i64, 1i64)
    if a5 != ok || s5 != 5u64 { ret 509i32 }
    let m = ds.poll(&r, "mailer", evs[0..])
    if m != 1usize || evs[0].seq != 5u64 || !str.eq(evs[0].data, "7") { ret 510i32 }
    // a small out buffer pages the catch-up
    var one: [1]ds.Event = zero
    if ds.poll(&r, "audit", one[0..]) != 1usize || one[0].seq != 1u64 { ret 511i32 }
    ret 0i32
}

// 6xx
fn compaction(a: *mem.Arena) -> i32 {
    let (db0, create_error) = ds.create(a, limits())
    if create_error != ok { ret 600i32 }
    var db = db0
    let code = script(&db)
    if code != 0i32 { ret code }
    var i = 0usize
    while i < 6usize {
        if ds.put(&db, "users", "u1", "{\"name\":\"ada\",\"age\":38}") != ok { ret 601i32 }
        i += 1usize
    }
    let (gone, delete_error) = ds.delete(&db, "orders", "o1")
    if delete_error != ok || !gone { ret 602i32 }
    let before = ds.bytes(&db).len
    let (c0, compact_error) = ds.compact(&db, a, limits())
    if compact_error != ok { ret 603i32 }
    var c = c0
    if ds.bytes(&c).len >= before { ret 604i32 }
    if !same_state(&db, &c) || ds.count(&c, "orders") != 0usize { ret 605i32 }
    var evs: [8]ds.Event = zero
    let n = ds.read_all(&c, 0u64, evs[0..])
    if n != 4usize || evs[0].seq != 1u64 || evs[3].version != 3u32 || evs[3].at != 1003i64 { ret 606i32 }
    // the compacted file is itself a valid file
    let (r0, dropped, restore_error) = ds.restore(a, ds.bytes(&c), limits())
    if restore_error != ok || dropped != 0usize { ret 607i32 }
    var r = r0
    if !same_state(&c, &r) { ret 608i32 }
    // through a store: save, open
    let (m0, mem_error) = store.memory(a, 4usize)
    if mem_error != ok { ret 609i32 }
    var m = m0
    var s = store.memory_store(&m)
    if ds.save(&c, &s, "db/main.nds") != ok { ret 610i32 }
    let (o0, dropped2, open_error) = ds.open(a, &s, "db/main.nds", limits())
    if open_error != ok || dropped2 != 0usize { ret 611i32 }
    var o = o0
    if !same_state(&c, &o) { ret 612i32 }
    let (n0, dropped3, missing_error) = ds.open(a, &s, "db/none.nds", limits())
    if missing_error == ok { ret 613i32 }
    ret 0i32
}

// 7xx: a frame that does not fit, or a table that is full, changes nothing.
fn capacity(a: *mem.Arena) -> i32 {
    let tiny = ds.Limits { log: 90usize, docs: 2usize, events: 2usize, marks: 1usize, streams: 1usize }
    let (db0, create_error) = ds.create(a, tiny)
    if create_error != ok { ret 700i32 }
    var db = db0
    if ds.put(&db, "c", "a", "1") != ok { ret 701i32 }
    if ds.put(&db, "c", "b", "2") != ok { ret 702i32 }
    let used = ds.bytes(&db).len
    if ds.put(&db, "c", "x", "3") != ds.Full { ret 703i32 }
    if ds.bytes(&db).len != used || ds.count(&db, "c") != 2usize { ret 704i32 }
    // replacing an existing id needs no new row
    if ds.put(&db, "c", "a", "9") != ok { ret 705i32 }
    // events: the stream table has one row; a second stream is refused and the log is rolled back
    let (s1, e1) = ds.append(&db, "s", "k", "", 0i64, 0i64)
    let after_first = ds.bytes(&db).len
    if e1 != ok && e1 != ds.Full { ret 706i32 }
    if e1 == ok {
        let (s2, e2) = ds.append(&db, "t", "k", "", 0i64, 0i64)
        if e2 != ds.Full || ds.bytes(&db).len != after_first || ds.event_count(&db) != 1usize { ret 707i32 }
    }
    ret 0i32
}

fn main(a: *mem.Arena) -> err {
    var code = image_and_state(a)
    if code == 0i32 { code = concurrency(a) }
    if code == 0i32 { code = recovery(a) }
    if code == 0i32 { code = projections(a) }
    if code == 0i32 { code = subscriptions(a) }
    if code == 0i32 { code = compaction(a) }
    if code == 0i32 { code = capacity(a) }
    if code != 0i32 {
        // a status of 256, 512, ... would read as success on Linux, where it is taken mod 256
        var shown = code
        if shown % 256i32 == 0i32 { shown += 1i32 }
        os.exit(shown)
    }
    ret ok
}
