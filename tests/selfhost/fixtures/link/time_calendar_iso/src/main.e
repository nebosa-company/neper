fn main(a: *mem.Arena, args: []str) -> err {
    // Year 0 is a leap year of the proleptic calendar: 0000-02-28 is two days before 0000-03-01, and a year
    // from 0000-03-01 to 0001-03-01 is 365 days (its 29 February came first).
    let (leap, leap_error) = calendar.age_days("0000-03-01", "0000-02-28")
    if leap_error != ok || leap != 2i64 { os.exit(100i32) }
    let (year_zero, year_zero_error) = calendar.age_days("0001-03-01", "0000-03-01")
    if year_zero_error != ok || year_zero != 365i64 { os.exit(102i32) }
    let (one, one_error) = calendar.iso_day_count("1970-01-02")
    if one_error != ok || one != 1i64 { os.exit(101i32) }
    if run(vectors_0()) != 0u8 { os.exit(1i32) }
    if run(vectors_1()) != 0u8 { os.exit(2i32) }
    if run(vectors_2()) != 0u8 { os.exit(3i32) }
    if run(vectors_3()) != 0u8 { os.exit(4i32) }
    if run(vectors_4()) != 0u8 { os.exit(5i32) }
    if run(vectors_5()) != 0u8 { os.exit(6i32) }
    if run(vectors_6()) != 0u8 { os.exit(7i32) }
    if run(vectors_7()) != 0u8 { os.exit(8i32) }
    try io.print("time calendar iso ok")
    ret ok
}
