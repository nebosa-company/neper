// `e.cli.complete`: the bash, zsh and fish completion scripts and the man pages for three command specs against
// goldens. The goldens were produced by this module and then held to behaviour by real shells and groff
// (scripts/gen_complete_test.py, which also writes this file): bash and fish by asking them for completions,
// zsh by `zsh -n`, the man pages by `groff -ww`. With an argument the fixture prints every output between
// markers instead of comparing, which is how the goldens are made. Every check has its own exit code.
use e.cli
use e.cli.complete as complete
use e.io
use e.mem
use e.os
use e.str

fn show(got: str, want: str) {
    let p = io.print("\nGOT  ")
    let q = io.print(got)
    let r = io.print("\nWANT ")
    let s = io.print(want)
}

fn dump(name: str, body: str) {
    let p = io.print("@@@ ")
    let q = io.print(name)
    let r = io.print("\n")
    let s = io.print(body)
    let t = io.print("@@@ end\n")
}

fn opt(long: str, short: u8, kind: cli.ValueKind, required: bool, repeated: bool, env: str, help: str) -> cli.Option {
    ret cli.Option{ long: long, short: short, kind: kind, required: required, repeated: repeated, env: env, help: help }
}

fn main(a: *mem.Arena, args: []str) -> err {
    let dumping = args.len > 1usize
    var none_c: [1]cli.Command = zero
    var none_o: [1]cli.Option = zero
    // solo: no subcommands, one valued option and one flag
    var solo_o: [2]cli.Option = zero
    solo_o[0] = opt("out", 111u8, .String, false, false, "SOLO_OUT", "Where to write")
    solo_o[1] = opt("quiet", 0u8, .Bool, false, false, "", "")
    let solo = cli.Command{ name: "solo", help: "A single command", options: solo_o[0usize..2usize], subcommands: none_c[0usize..0usize] }
    // tool: options, a subcommand with options, and a nested pair
    var add_o: [1]cli.Option = zero
    add_o[0] = opt("fetch", 102u8, .Bool, false, false, "", "Fetch after adding")
    var remote_s: [2]cli.Command = zero
    remote_s[0] = cli.Command{ name: "add", help: "Add a remote", options: add_o[0usize..1usize], subcommands: none_c[0usize..0usize] }
    remote_s[1] = cli.Command{ name: "remove", help: "Remove a remote", options: none_o[0usize..0usize], subcommands: none_c[0usize..0usize] }
    var build_o: [2]cli.Option = zero
    build_o[0] = opt("release", 0u8, .Bool, false, false, "", "Optimised build")
    build_o[1] = opt("target-dir", 0u8, .String, false, true, "", "Path with 'quotes', [brackets], back\\slash and a: colon")
    var tool_s: [2]cli.Command = zero
    tool_s[0] = cli.Command{ name: "build", help: "Build the project", options: build_o[0usize..2usize], subcommands: none_c[0usize..0usize] }
    tool_s[1] = cli.Command{ name: "remote", help: "Manage remotes", options: none_o[0usize..0usize], subcommands: remote_s[0usize..2usize] }
    var tool_o: [3]cli.Option = zero
    tool_o[0] = opt("verbose", 118u8, .Bool, false, false, "", "Chatty output")
    tool_o[1] = opt("config", 99u8, .String, false, false, "", "Config file")
    tool_o[2] = opt("count", 0u8, .I64, true, false, "TOOL_COUNT", "How many")
    let tool = cli.Command{ name: "tool", help: "A tool with subcommands", options: tool_o[0usize..3usize], subcommands: tool_s[0usize..2usize] }
    // invalid: a name that cannot be written into shell syntax unquoted
    var bad_o: [1]cli.Option = zero
    bad_o[0] = opt("bad name", 0u8, .Bool, false, false, "", "")
    let bad = cli.Command{ name: "bad", help: "", options: bad_o[0usize..1usize], subcommands: none_c[0usize..0usize] }

    let (solo_bash, e1) = complete.bash(a, &solo)
    let (solo_zsh, e2) = complete.zsh(a, &solo)
    let (solo_fish, e3) = complete.fish(a, &solo)
    let (solo_man, e4) = complete.man_page(a, &solo, "solo", 49u8, "2026-10-12", "solo 1.0")
    let (tool_bash, e5) = complete.bash(a, &tool)
    let (tool_zsh, e6) = complete.zsh(a, &tool)
    let (tool_fish, e7) = complete.fish(a, &tool)
    let (tool_man, e8) = complete.man_page(a, &tool, "tool", 49u8, "2026-10-12", "tool 2.3")
    let (build_man, e9) = complete.man_page(a, &tool_s[0], "tool build", 49u8, "2026-10-12", "tool 2.3")
    if e1 != ok || e2 != ok || e3 != ok || e4 != ok || e5 != ok || e6 != ok || e7 != ok || e8 != ok || e9 != ok { os.exit(1i32) }
    if dumping {
        dump("solo.bash", solo_bash)
        dump("solo.zsh", solo_zsh)
        dump("solo.fish", solo_fish)
        dump("solo.1", solo_man)
        dump("tool.bash", tool_bash)
        dump("tool.zsh", tool_zsh)
        dump("tool.fish", tool_fish)
        dump("tool.1", tool_man)
        dump("tool-build.1", build_man)
        ret ok
    }
    if !str.eq(solo_bash, "# bash completion for solo (generated by e.cli.complete)\n_solo() {\n    local cur prev cmd i opts\n    COMPREPLY=()\n    cur=\"${COMP_WORDS[COMP_CWORD]}\"\n    prev=\"\"\n    if [ \"$COMP_CWORD\" -gt 0 ]; then prev=\"${COMP_WORDS[COMP_CWORD-1]}\"; fi\n    cmd=\"solo\"\n    for ((i = 1; i < COMP_CWORD; i++)); do\n        case \"$cmd:${COMP_WORDS[i]}\" in\n        esac\n    done\n    case \"$cmd:$prev\" in\n        \"solo:--out\"|\"solo:-o\")\n            COMPREPLY=($(compgen -f -- \"$cur\"))\n            return 0\n            ;;\n    esac\n    case \"$cmd\" in\n        \"solo\") opts=\"--out -o --quiet\" ;;\n    esac\n    COMPREPLY=($(compgen -W \"$opts\" -- \"$cur\"))\n    return 0\n}\ncomplete -F _solo -o bashdefault -o default solo\n") { show(solo_bash, "# bash completion for solo (generated by e.cli.complete)\n_solo() {\n    local cur prev cmd i opts\n    COMPREPLY=()\n    cur=\"${COMP_WORDS[COMP_CWORD]}\"\n    prev=\"\"\n    if [ \"$COMP_CWORD\" -gt 0 ]; then prev=\"${COMP_WORDS[COMP_CWORD-1]}\"; fi\n    cmd=\"solo\"\n    for ((i = 1; i < COMP_CWORD; i++)); do\n        case \"$cmd:${COMP_WORDS[i]}\" in\n        esac\n    done\n    case \"$cmd:$prev\" in\n        \"solo:--out\"|\"solo:-o\")\n            COMPREPLY=($(compgen -f -- \"$cur\"))\n            return 0\n            ;;\n    esac\n    case \"$cmd\" in\n        \"solo\") opts=\"--out -o --quiet\" ;;\n    esac\n    COMPREPLY=($(compgen -W \"$opts\" -- \"$cur\"))\n    return 0\n}\ncomplete -F _solo -o bashdefault -o default solo\n")
        os.exit(2i32) }
    if !str.eq(solo_zsh, "#compdef solo\n# zsh completion for solo (generated by e.cli.complete)\n_solo() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n        '(-o --out){-o,--out}[Where to write]:value:_files' \\\n        '(--quiet)--quiet[]' \\\n        '*:: :_files'\n}\n\n_solo \"$@\"\n") { show(solo_zsh, "#compdef solo\n# zsh completion for solo (generated by e.cli.complete)\n_solo() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n        '(-o --out){-o,--out}[Where to write]:value:_files' \\\n        '(--quiet)--quiet[]' \\\n        '*:: :_files'\n}\n\n_solo \"$@\"\n")
        os.exit(3i32) }
    if !str.eq(solo_fish, "# fish completion for solo (generated by e.cli.complete)\ncomplete -c solo -s o -l out -r -d 'Where to write'\ncomplete -c solo -l quiet\n") { show(solo_fish, "# fish completion for solo (generated by e.cli.complete)\ncomplete -c solo -s o -l out -r -d 'Where to write'\ncomplete -c solo -l quiet\n")
        os.exit(4i32) }
    if !str.eq(solo_man, ".TH SOLO 1 \"2026\\-10\\-12\" \"solo 1.0\"\n.SH NAME\nsolo \\- A single command\n.SH SYNOPSIS\n\\fBsolo\\fR [\\fIOPTIONS\\fR]\n.SH DESCRIPTION\nA single command\n.SH OPTIONS\n.TP\n\\fB\\-o\\fR, \\fB\\-\\-out\\fR=\\fIVALUE\\fR\nWhere to write\n.TP\n\\fB\\-\\-quiet\\fR\n.SH ENVIRONMENT\n.TP\n\\fBSOLO_OUT\\fR\nRead for \\fB\\-\\-out\\fR when the option is absent.\n") { show(solo_man, ".TH SOLO 1 \"2026\\-10\\-12\" \"solo 1.0\"\n.SH NAME\nsolo \\- A single command\n.SH SYNOPSIS\n\\fBsolo\\fR [\\fIOPTIONS\\fR]\n.SH DESCRIPTION\nA single command\n.SH OPTIONS\n.TP\n\\fB\\-o\\fR, \\fB\\-\\-out\\fR=\\fIVALUE\\fR\nWhere to write\n.TP\n\\fB\\-\\-quiet\\fR\n.SH ENVIRONMENT\n.TP\n\\fBSOLO_OUT\\fR\nRead for \\fB\\-\\-out\\fR when the option is absent.\n")
        os.exit(5i32) }
    if !str.eq(tool_bash, "# bash completion for tool (generated by e.cli.complete)\n_tool() {\n    local cur prev cmd i opts\n    COMPREPLY=()\n    cur=\"${COMP_WORDS[COMP_CWORD]}\"\n    prev=\"\"\n    if [ \"$COMP_CWORD\" -gt 0 ]; then prev=\"${COMP_WORDS[COMP_CWORD-1]}\"; fi\n    cmd=\"tool\"\n    for ((i = 1; i < COMP_CWORD; i++)); do\n        case \"$cmd:${COMP_WORDS[i]}\" in\n            \"tool:build\") cmd=\"tool build\" ;;\n            \"tool:remote\") cmd=\"tool remote\" ;;\n            \"tool remote:add\") cmd=\"tool remote add\" ;;\n            \"tool remote:remove\") cmd=\"tool remote remove\" ;;\n        esac\n    done\n    case \"$cmd:$prev\" in\n        \"tool:--config\"|\"tool:-c\")\n            COMPREPLY=($(compgen -f -- \"$cur\"))\n            return 0\n            ;;\n        \"tool:--count\")\n            COMPREPLY=($(compgen -f -- \"$cur\"))\n            return 0\n            ;;\n        \"tool build:--target-dir\")\n            COMPREPLY=($(compgen -f -- \"$cur\"))\n            return 0\n            ;;\n    esac\n    case \"$cmd\" in\n        \"tool\") opts=\"--verbose -v --config -c --count build remote\" ;;\n        \"tool build\") opts=\"--release --target-dir\" ;;\n        \"tool remote\") opts=\"add remove\" ;;\n        \"tool remote add\") opts=\"--fetch -f\" ;;\n        \"tool remote remove\") opts=\"\" ;;\n    esac\n    COMPREPLY=($(compgen -W \"$opts\" -- \"$cur\"))\n    return 0\n}\ncomplete -F _tool -o bashdefault -o default tool\n") { show(tool_bash, "# bash completion for tool (generated by e.cli.complete)\n_tool() {\n    local cur prev cmd i opts\n    COMPREPLY=()\n    cur=\"${COMP_WORDS[COMP_CWORD]}\"\n    prev=\"\"\n    if [ \"$COMP_CWORD\" -gt 0 ]; then prev=\"${COMP_WORDS[COMP_CWORD-1]}\"; fi\n    cmd=\"tool\"\n    for ((i = 1; i < COMP_CWORD; i++)); do\n        case \"$cmd:${COMP_WORDS[i]}\" in\n            \"tool:build\") cmd=\"tool build\" ;;\n            \"tool:remote\") cmd=\"tool remote\" ;;\n            \"tool remote:add\") cmd=\"tool remote add\" ;;\n            \"tool remote:remove\") cmd=\"tool remote remove\" ;;\n        esac\n    done\n    case \"$cmd:$prev\" in\n        \"tool:--config\"|\"tool:-c\")\n            COMPREPLY=($(compgen -f -- \"$cur\"))\n            return 0\n            ;;\n        \"tool:--count\")\n            COMPREPLY=($(compgen -f -- \"$cur\"))\n            return 0\n            ;;\n        \"tool build:--target-dir\")\n            COMPREPLY=($(compgen -f -- \"$cur\"))\n            return 0\n            ;;\n    esac\n    case \"$cmd\" in\n        \"tool\") opts=\"--verbose -v --config -c --count build remote\" ;;\n        \"tool build\") opts=\"--release --target-dir\" ;;\n        \"tool remote\") opts=\"add remove\" ;;\n        \"tool remote add\") opts=\"--fetch -f\" ;;\n        \"tool remote remove\") opts=\"\" ;;\n    esac\n    COMPREPLY=($(compgen -W \"$opts\" -- \"$cur\"))\n    return 0\n}\ncomplete -F _tool -o bashdefault -o default tool\n")
        os.exit(6i32) }
    if !str.eq(tool_zsh, "#compdef tool\n# zsh completion for tool (generated by e.cli.complete)\n_tool() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n        '(-v --verbose){-v,--verbose}[Chatty output]' \\\n        '(-c --config){-c,--config}[Config file]:value:_files' \\\n        '(--count)--count[How many]:value:_files' \\\n        '1: :->subcommand' \\\n        '*:: :->args' && return 0\n    case $state in\n        subcommand)\n            local -a commands\n            commands=(\n                'build:Build the project'\n                'remote:Manage remotes'\n            )\n            _describe -t commands 'command' commands\n            ;;\n        args)\n            case $line[1] in\n                build) _tool_build ;;\n                remote) _tool_remote ;;\n            esac\n            ;;\n    esac\n}\n\n_tool_build() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n        '(--release)--release[Optimised build]' \\\n        '--target-dir[Path with '\\''quotes'\\'', \\[brackets\\], back\\\\slash and a\\: colon]:value:_files' \\\n        '*:: :_files'\n}\n\n_tool_remote() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n        '1: :->subcommand' \\\n        '*:: :->args' && return 0\n    case $state in\n        subcommand)\n            local -a commands\n            commands=(\n                'add:Add a remote'\n                'remove:Remove a remote'\n            )\n            _describe -t commands 'command' commands\n            ;;\n        args)\n            case $line[1] in\n                add) _tool_remote_add ;;\n                remove) _tool_remote_remove ;;\n            esac\n            ;;\n    esac\n}\n\n_tool_remote_add() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n        '(-f --fetch){-f,--fetch}[Fetch after adding]' \\\n        '*:: :_files'\n}\n\n_tool_remote_remove() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n        '*:: :_files'\n}\n\n_tool \"$@\"\n") { show(tool_zsh, "#compdef tool\n# zsh completion for tool (generated by e.cli.complete)\n_tool() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n        '(-v --verbose){-v,--verbose}[Chatty output]' \\\n        '(-c --config){-c,--config}[Config file]:value:_files' \\\n        '(--count)--count[How many]:value:_files' \\\n        '1: :->subcommand' \\\n        '*:: :->args' && return 0\n    case $state in\n        subcommand)\n            local -a commands\n            commands=(\n                'build:Build the project'\n                'remote:Manage remotes'\n            )\n            _describe -t commands 'command' commands\n            ;;\n        args)\n            case $line[1] in\n                build) _tool_build ;;\n                remote) _tool_remote ;;\n            esac\n            ;;\n    esac\n}\n\n_tool_build() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n        '(--release)--release[Optimised build]' \\\n        '--target-dir[Path with '\\''quotes'\\'', \\[brackets\\], back\\\\slash and a\\: colon]:value:_files' \\\n        '*:: :_files'\n}\n\n_tool_remote() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n        '1: :->subcommand' \\\n        '*:: :->args' && return 0\n    case $state in\n        subcommand)\n            local -a commands\n            commands=(\n                'add:Add a remote'\n                'remove:Remove a remote'\n            )\n            _describe -t commands 'command' commands\n            ;;\n        args)\n            case $line[1] in\n                add) _tool_remote_add ;;\n                remove) _tool_remote_remove ;;\n            esac\n            ;;\n    esac\n}\n\n_tool_remote_add() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n        '(-f --fetch){-f,--fetch}[Fetch after adding]' \\\n        '*:: :_files'\n}\n\n_tool_remote_remove() {\n    local context state state_descr line\n    typeset -A opt_args\n    _arguments -C \\\n        '*:: :_files'\n}\n\n_tool \"$@\"\n")
        os.exit(7i32) }
    if !str.eq(tool_fish, "# fish completion for tool (generated by e.cli.complete)\ncomplete -c tool -n \"not __fish_seen_subcommand_from build remote\" -s v -l verbose -d 'Chatty output'\ncomplete -c tool -n \"not __fish_seen_subcommand_from build remote\" -s c -l config -r -d 'Config file'\ncomplete -c tool -n \"not __fish_seen_subcommand_from build remote\" -l count -r -d 'How many'\ncomplete -c tool -n \"not __fish_seen_subcommand_from build remote\" -f -a 'build' -d 'Build the project'\ncomplete -c tool -n \"not __fish_seen_subcommand_from build remote\" -f -a 'remote' -d 'Manage remotes'\ncomplete -c tool -n \"__fish_seen_subcommand_from build\" -l release -d 'Optimised build'\ncomplete -c tool -n \"__fish_seen_subcommand_from build\" -l target-dir -r -d 'Path with \\'quotes\\', [brackets], back\\\\slash and a: colon'\ncomplete -c tool -n \"__fish_seen_subcommand_from remote; and not __fish_seen_subcommand_from add remove\" -f -a 'add' -d 'Add a remote'\ncomplete -c tool -n \"__fish_seen_subcommand_from remote; and not __fish_seen_subcommand_from add remove\" -f -a 'remove' -d 'Remove a remote'\ncomplete -c tool -n \"__fish_seen_subcommand_from remote; and __fish_seen_subcommand_from add\" -s f -l fetch -d 'Fetch after adding'\n") { show(tool_fish, "# fish completion for tool (generated by e.cli.complete)\ncomplete -c tool -n \"not __fish_seen_subcommand_from build remote\" -s v -l verbose -d 'Chatty output'\ncomplete -c tool -n \"not __fish_seen_subcommand_from build remote\" -s c -l config -r -d 'Config file'\ncomplete -c tool -n \"not __fish_seen_subcommand_from build remote\" -l count -r -d 'How many'\ncomplete -c tool -n \"not __fish_seen_subcommand_from build remote\" -f -a 'build' -d 'Build the project'\ncomplete -c tool -n \"not __fish_seen_subcommand_from build remote\" -f -a 'remote' -d 'Manage remotes'\ncomplete -c tool -n \"__fish_seen_subcommand_from build\" -l release -d 'Optimised build'\ncomplete -c tool -n \"__fish_seen_subcommand_from build\" -l target-dir -r -d 'Path with \\'quotes\\', [brackets], back\\\\slash and a: colon'\ncomplete -c tool -n \"__fish_seen_subcommand_from remote; and not __fish_seen_subcommand_from add remove\" -f -a 'add' -d 'Add a remote'\ncomplete -c tool -n \"__fish_seen_subcommand_from remote; and not __fish_seen_subcommand_from add remove\" -f -a 'remove' -d 'Remove a remote'\ncomplete -c tool -n \"__fish_seen_subcommand_from remote; and __fish_seen_subcommand_from add\" -s f -l fetch -d 'Fetch after adding'\n")
        os.exit(8i32) }
    if !str.eq(tool_man, ".TH TOOL 1 \"2026\\-10\\-12\" \"tool 2.3\"\n.SH NAME\ntool \\- A tool with subcommands\n.SH SYNOPSIS\n\\fBtool\\fR [\\fIOPTIONS\\fR] [\\fICOMMAND\\fR]\n.SH DESCRIPTION\nA tool with subcommands\n.SH OPTIONS\n.TP\n\\fB\\-v\\fR, \\fB\\-\\-verbose\\fR\nChatty output\n.TP\n\\fB\\-c\\fR, \\fB\\-\\-config\\fR=\\fIVALUE\\fR\nConfig file\n.TP\n\\fB\\-\\-count\\fR=\\fIVALUE\\fR\nHow many\nRequired.\n.SH COMMANDS\n.TP\n\\fBbuild\\fR\nBuild the project\n.TP\n\\fBremote\\fR\nManage remotes\n.SH ENVIRONMENT\n.TP\n\\fBTOOL_COUNT\\fR\nRead for \\fB\\-\\-count\\fR when the option is absent.\n") { show(tool_man, ".TH TOOL 1 \"2026\\-10\\-12\" \"tool 2.3\"\n.SH NAME\ntool \\- A tool with subcommands\n.SH SYNOPSIS\n\\fBtool\\fR [\\fIOPTIONS\\fR] [\\fICOMMAND\\fR]\n.SH DESCRIPTION\nA tool with subcommands\n.SH OPTIONS\n.TP\n\\fB\\-v\\fR, \\fB\\-\\-verbose\\fR\nChatty output\n.TP\n\\fB\\-c\\fR, \\fB\\-\\-config\\fR=\\fIVALUE\\fR\nConfig file\n.TP\n\\fB\\-\\-count\\fR=\\fIVALUE\\fR\nHow many\nRequired.\n.SH COMMANDS\n.TP\n\\fBbuild\\fR\nBuild the project\n.TP\n\\fBremote\\fR\nManage remotes\n.SH ENVIRONMENT\n.TP\n\\fBTOOL_COUNT\\fR\nRead for \\fB\\-\\-count\\fR when the option is absent.\n")
        os.exit(9i32) }
    if !str.eq(build_man, ".TH TOOL-BUILD 1 \"2026\\-10\\-12\" \"tool 2.3\"\n.SH NAME\ntool build \\- Build the project\n.SH SYNOPSIS\n\\fBtool build\\fR [\\fIOPTIONS\\fR]\n.SH DESCRIPTION\nBuild the project\n.SH OPTIONS\n.TP\n\\fB\\-\\-release\\fR\nOptimised build\n.TP\n\\fB\\-\\-target\\-dir\\fR=\\fIVALUE\\fR\nPath with 'quotes', [brackets], back\\\\slash and a: colon\nMay be given more than once.\n") { show(build_man, ".TH TOOL-BUILD 1 \"2026\\-10\\-12\" \"tool 2.3\"\n.SH NAME\ntool build \\- Build the project\n.SH SYNOPSIS\n\\fBtool build\\fR [\\fIOPTIONS\\fR]\n.SH DESCRIPTION\nBuild the project\n.SH OPTIONS\n.TP\n\\fB\\-\\-release\\fR\nOptimised build\n.TP\n\\fB\\-\\-target\\-dir\\fR=\\fIVALUE\\fR\nPath with 'quotes', [brackets], back\\\\slash and a: colon\nMay be given more than once.\n")
        os.exit(10i32) }
    let (_, ie) = complete.bash(a, &bad)
    if ie != complete.Invalid { os.exit(11i32) }
    let (_, ie2) = complete.fish(a, &bad)
    if ie2 != complete.Invalid { os.exit(12i32) }
    try io.print("cli complete ok")
    ret ok
}
