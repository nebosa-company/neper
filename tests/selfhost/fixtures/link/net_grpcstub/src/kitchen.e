    if m.in_.len > 0usize {
        try rt.put_bytes(o, 2u32, m.in_)
    }
    if m.error_ {
        try rt.put_bool(o, 3u32, m.error_)
    }
    if rt.f64_bits(m.zero_) != 0u64 {
        try rt.put_fixed64(o, 4u32, rt.f64_bits(m.zero_))
    }
    ret ok
}

