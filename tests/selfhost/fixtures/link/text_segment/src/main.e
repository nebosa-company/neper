// `e.text.segment`: Word_Break and Line_Break properties against the 15.0 data files,
// Extended_Pictographic, 120 lines of WordBreakTest.txt (every 19th of the generated
// grid plus the 30 hand-written samples at the end) as boundary bitmasks, 120 lines of
// LineBreakTest.txt (likewise) as two bits per position, `words` and `line_breaks`
// on an ASCII sentence against the Python replica, `next_word`/`next_line_break`
// agreeing with them, and TooSmall. Case data is a byte string from the generator:
// count, 3-byte code points, 8-byte expected mask. Property checks exit 1..53; a
// failing word case prints its index and exits 50, a line case 51.
use e.io
use e.mem
use e.os
use e.text.segment as seg

fn print_number(v: usize) -> err {
    var buf: [24]u8 = zero
    var pos = 24usize
    var x = v
    if x == 0usize {
        pos -= 1usize
        buf[pos] = 48u8
    }
    while x > 0usize {
        pos -= 1usize
        buf[pos] = u8(48usize + x % 10usize)
        x /= 10usize
    }
    ret io.print(buf[pos..])
}

fn read_case(data: str, pos: usize, text: []u32) -> (usize, usize, u64) {
    let n = usize(data[pos])
    var p = pos + 1usize
    var i = 0usize
    while i < n {
        text[i] = u32(data[p]) | (u32(data[p + 1usize]) << 8u32) | (u32(data[p + 2usize]) << 16u32)
        p += 3usize
        i += 1usize
    }
    var mask = 0u64
    i = 0usize
    while i < 8usize {
        mask |= u64(data[p + i]) << u32(8usize * i)
        i += 1usize
    }
    ret (n, p + 8usize, mask)
}

fn main(a: *mem.Arena, args: []str) -> err {
    if seg.word_break_property(65u32) != .ALetter { os.exit(1i32) }
    if seg.word_break_property(1488u32) != .HebrewLetter { os.exit(2i32) }
    if seg.word_break_property(48u32) != .Numeric { os.exit(3i32) }
    if seg.word_break_property(39u32) != .SingleQuote { os.exit(4i32) }
    if seg.word_break_property(34u32) != .DoubleQuote { os.exit(5i32) }
    if seg.word_break_property(46u32) != .MidNumLet { os.exit(6i32) }
    if seg.word_break_property(58u32) != .MidLetter { os.exit(7i32) }
    if seg.word_break_property(44u32) != .MidNum { os.exit(8i32) }
    if seg.word_break_property(95u32) != .ExtendNumLet { os.exit(9i32) }
    if seg.word_break_property(12450u32) != .Katakana { os.exit(10i32) }
    if seg.word_break_property(768u32) != .Extend { os.exit(11i32) }
    if seg.word_break_property(173u32) != .Format { os.exit(12i32) }
    if seg.word_break_property(8205u32) != .ZWJ { os.exit(13i32) }
    if seg.word_break_property(127462u32) != .RegionalIndicator { os.exit(14i32) }
    if seg.word_break_property(32u32) != .WSegSpace { os.exit(15i32) }
    if seg.word_break_property(13u32) != .CR { os.exit(16i32) }
    if seg.word_break_property(10u32) != .LF { os.exit(17i32) }
    if seg.word_break_property(133u32) != .Newline { os.exit(18i32) }
    if seg.word_break_property(43u32) != .Other { os.exit(19i32) }
    if seg.word_break_property(128512u32) != .Other { os.exit(20i32) }
    if seg.line_break_class(65u32) != .AL { os.exit(21i32) }
    if seg.line_break_class(1488u32) != .HL { os.exit(22i32) }
    if seg.line_break_class(48u32) != .NU { os.exit(23i32) }
    if seg.line_break_class(40u32) != .OP { os.exit(24i32) }
    if seg.line_break_class(41u32) != .CP { os.exit(25i32) }
    if seg.line_break_class(44u32) != .IS { os.exit(26i32) }
    if seg.line_break_class(46u32) != .IS { os.exit(27i32) }
    if seg.line_break_class(45u32) != .HY { os.exit(28i32) }
    if seg.line_break_class(36u32) != .PR { os.exit(29i32) }
    if seg.line_break_class(37u32) != .PO { os.exit(30i32) }
    if seg.line_break_class(32u32) != .SP { os.exit(31i32) }
    if seg.line_break_class(13u32) != .CR { os.exit(32i32) }
    if seg.line_break_class(10u32) != .LF { os.exit(33i32) }
    if seg.line_break_class(133u32) != .NL { os.exit(34i32) }
    if seg.line_break_class(8203u32) != .ZW { os.exit(35i32) }
    if seg.line_break_class(8205u32) != .ZWJ { os.exit(36i32) }
    if seg.line_break_class(768u32) != .CM { os.exit(37i32) }
    if seg.line_break_class(12354u32) != .ID { os.exit(38i32) }
    if seg.line_break_class(12353u32) != .CJ { os.exit(39i32) }
    if seg.line_break_class(4352u32) != .JL { os.exit(40i32) }
    if seg.line_break_class(44032u32) != .H2 { os.exit(41i32) }
    if seg.line_break_class(44033u32) != .H3 { os.exit(42i32) }
    if seg.line_break_class(127462u32) != .RI { os.exit(43i32) }
    if seg.line_break_class(128102u32) != .EB { os.exit(44i32) }
    if seg.line_break_class(127995u32) != .EM { os.exit(45i32) }
    if seg.line_break_class(8212u32) != .B2 { os.exit(46i32) }
    if seg.line_break_class(8230u32) != .IN { os.exit(47i32) }
    if seg.line_break_class(160u32) != .GL { os.exit(48i32) }
    if seg.line_break_class(33u32) != .EX { os.exit(49i32) }
    if seg.line_break_class(8288u32) != .WJ { os.exit(50i32) }
    if seg.line_break_class(57344u32) != .XX { os.exit(51i32) }
    if seg.line_break_class(128496u32) != .ID { os.exit(52i32) }
    if !seg.is_extended_pictographic(128512u32) || seg.is_extended_pictographic(65u32) { os.exit(53i32) }
    var text: [128]u32 = zero
    var bounds: [129]usize = zero
    var ops: [129]u8 = zero
    // 2: WordBreakTest lines
    let wdata = word_cases()
    var pos = 0usize
    var k = 0usize
    while pos < wdata.len {
        let (n, after, expect) = read_case(wdata, pos, text[..])
        pos = after
        let (count, e) = seg.words(text[..n], bounds[..])
        var mask = 0u64
        var i = 0usize
        while i < count {
            mask |= 1u64 << u32(bounds[i])
            i += 1usize
        }
        if e != ok || mask != expect {
            try io.print("word case ")
            try print_number(k)
            try io.print("\n")
            os.exit(50i32)
        }
        k += 1usize
    }
    if k != 120usize { os.exit(98i32) }
    // 3: LineBreakTest lines
    let ldata = line_cases()
    pos = 0usize
    k = 0usize
    while pos < ldata.len {
        let (n, after, expect) = read_case(ldata, pos, text[..])
        pos = after
        let e = seg.line_breaks(text[..n], ops[..n + 1usize])
        var mask = 0u64
        var i = 0usize
        while i <= n {
            mask |= u64(ops[i]) << u32(2usize * i)
            i += 1usize
        }
        if e != ok || mask != expect {
            try io.print("line case ")
            try print_number(k)
            try io.print("\n")
            os.exit(51i32)
        }
        k += 1usize
    }
    if k != 120usize { os.exit(97i32) }
    // 4: an ASCII sentence
    let sentence = "Hello, world! It's 3.14 or 1,000 items; mail me at john.doe@example.com today."
    var i = 0usize
    while i < sentence.len {
        text[i] = u32(sentence[i])
        i += 1usize
    }
    let n = sentence.len
    let expected_words = [30]usize{ 0usize, 5usize, 6usize, 7usize, 12usize, 13usize, 14usize, 18usize, 19usize, 23usize, 24usize, 26usize, 27usize, 32usize, 33usize, 38usize, 39usize, 40usize, 44usize, 45usize, 47usize, 48usize, 50usize, 51usize, 59usize, 60usize, 71usize, 72usize, 77usize, 78usize }
    let (count, words_error) = seg.words(text[..n], bounds[..])
    if words_error != ok || count != expected_words.len { os.exit(60i32) }
    i = 0usize
    while i < count {
        if bounds[i] != expected_words[i] { os.exit(61i32) }
        i += 1usize
    }
    var from = 0usize
    i = 1usize
    while i < count {
        from = seg.next_word(text[..n], from)
        if from != expected_words[i] { os.exit(62i32) }
        i += 1usize
    }
    if seg.next_word(text[..n], n) != n { os.exit(63i32) }
    let expected_lines = [12]usize{ 7usize, 14usize, 19usize, 24usize, 27usize, 33usize, 40usize, 45usize, 48usize, 51usize, 72usize, 78usize }
    if seg.line_breaks(text[..n], ops[..n + 1usize]) != ok { os.exit(64i32) }
    var seen = 0usize
    i = 0usize
    while i <= n {
        if ops[i] != 0u8 {
            if seen >= expected_lines.len || expected_lines[seen] != i { os.exit(65i32) }
            if (i == n) != (ops[i] == 2u8) { os.exit(66i32) }
            seen += 1usize
        }
        i += 1usize
    }
    if seen != expected_lines.len { os.exit(67i32) }
    from = 0usize
    i = 0usize
    while i < expected_lines.len {
        let (position, mandatory) = seg.next_line_break(text[..n], from)
        if position != expected_lines[i] || mandatory != (position == n) { os.exit(68i32) }
        from = position
        i += 1usize
    }
    // 5: TooSmall
    let (_, small) = seg.words(text[..n], bounds[..2usize])
    if small != seg.TooSmall { os.exit(70i32) }
    if seg.line_breaks(text[..n], ops[..n]) != seg.TooSmall { os.exit(71i32) }
    let (empty_count, empty_error) = seg.words(text[..0usize], bounds[..])
    if empty_error != ok || empty_count != 1usize || bounds[0usize] != 0usize { os.exit(72i32) }
    try io.print("text segment ok\n")
    ret ok
}

