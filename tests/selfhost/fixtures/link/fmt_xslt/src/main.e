    let terminate_sheet = "<xsl:stylesheet version=\"1.0\" xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\" ><xsl:output method=\"xml\" omit-xml-declaration=\"yes\"/><xsl:template match=\"/\"><xsl:message terminate=\"yes\">stop</xsl:message></xsl:template></xsl:stylesheet>"
    let (terminate_ss, terminate_load) = xs.load(a, terminate_sheet)
    let (_, terminate_error) = xs.transform(a, &terminate_ss, &override_doc, zero)
    if terminate_load != ok || terminate_error != xs.Terminated { try report("terminate", 0usize) }
    let missing_sheet = "<xsl:stylesheet version=\"1.0\" xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\" ><xsl:output method=\"xml\" omit-xml-declaration=\"yes\"/><xsl:template match=\"/\"><xsl:call-template name=\"nothing\"/></xsl:template></xsl:stylesheet>"
    let (missing_ss, missing_load) = xs.load(a, missing_sheet)
    let (_, missing_error) = xs.transform(a, &missing_ss, &override_doc, zero)
    if missing_load != ok || missing_error != xs.NoRule { try report("call-missing", 0usize) }
    try io.print("fmt xslt ok\n")
    ret ok
}
