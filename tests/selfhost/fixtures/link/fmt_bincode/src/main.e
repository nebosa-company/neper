fn run_text(text: str) -> u8 {
    var start = 0usize
    var i = 0usize
    while i < text.len {
        if text[i] == 10u8 {
            let code = check_line(text[start..i])
            if code != 0u8 {
                let shown = io.print(text[start..i])
                if shown != ok { ret code }
                ret code
            }
            start = i + 1usize
        }
        i += 1usize
    }
    ret 0u8
}

