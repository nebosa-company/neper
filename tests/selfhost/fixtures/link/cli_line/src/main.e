    if e != ok { os.exit(90i32) }
    var i = 0usize
    while i + 1usize < h.len {
        out[i / 2usize] = (nibble(h[i]) << 4u8) | nibble(h[i + 1usize])
        i += 2usize
    }
    ret out[0..h.len / 2usize]
}

fn hex_of(b: *str.Builder, s: str) -> bool {
    var i = 0usize
    while i < s.len {
        let hi = s[i] >> 4u8
        let lo = s[i] & 15u8
        var c1 = 48u8 + hi
        if hi > 9u8 { c1 = 87u8 + hi }
        var c2 = 48u8 + lo
        if lo > 9u8 { c2 = 87u8 + lo }
        if str.push_byte(b, c1) != ok || str.push_byte(b, c2) != ok { ret false }
        i += 1usize
    }
    ret true
}

fn words() -> str {
    ret "help,hello,helmet,history,exit,export,quit,ls,list,listen,cat,cd"
}

// The completer: the table words that start with the token, in table order.
fn complete(ctx: *u8, word: str, out: []str) -> usize {
    let table = words()
    var n = 0usize
    var start = 0usize
    var i = 0usize
    while i <= table.len {
        if i == table.len || table[i] == 44u8 {
            let w = table[start..i]
            if str.starts_with(w, word) && n < out.len {
                out[n] = w
                n += 1usize
            }
            start = i + 1usize
        }
        i += 1usize
    }
    ret n
}

type Store = struct {
    buf: [96]u8,
    draft: [96]u8,
    kill: [96]u8,
    hist: [120]u8,
    starts: [6]usize,
    lens: [6]usize,
    cands: [8]str
}

fn codepoints_before(s: str, n: usize) -> usize {
    var count = 0usize
    var i = 0usize
    while i < n {
        if s[i] < 128u8 || s[i] >= 192u8 { count += 1usize }
        i += 1usize
    }
    ret count
}

fn check_vectors(a: *mem.Arena) -> i32 {
    var store: Store = zero
    var lines = str.lines(vectors())
    var n = 0i32
    var sink = 0u8
    while true {
        let (record, more) = str.split_next(&lines)
        if !more { break }
        if record.len == 0usize { continue }
        let (session_hex, r1, g1) = str.split_once(record, "~")
        let (history_hex, r2, g2) = str.split_once(r1, "~")
        let (outputs_want, r3, g3) = str.split_once(r2, "~")
        let (final_hex, r4, g4) = str.split_once(r3, "~")
        let (cursor_text, r5, g5) = str.split_once(r4, "~")
        let (kill_hex, render_hex, g6) = str.split_once(r5, "~")
        if !g1 || !g2 || !g3 || !g4 || !g5 || !g6 { ret 10i32 }
        var e = line.editor(store.buf[0..], store.draft[0..], store.kill[0..], store.hist[0..], store.starts[0..], store.lens[0..], store.cands[0..])
        // History seed: comma separated hex lines.
        if history_hex.len > 0usize {
            var rest = history_hex
            while true {
                let (head, tail, found) = str.split_once(rest, ",")
                if !found {
                    line.history_add(&e, unhex(a, rest))
                    break
                }
                line.history_add(&e, unhex(a, head))
                rest = tail
            }
        }
        let session = unhex(a, session_hex)
        let (ob, oe) = str.builder(a, 1024usize)
        if oe != ok { ret 11i32 }
        var outputs = ob
        var at = 0usize
        var first = true
        var finished = false
        while at < session.len && !finished {
            let (used, action) = line.feed[u8](&e, session[at..], &sink, complete)
            if used == 0usize { break }
            at += used
            var marker = ""
            if action == line.Action.Accept {
                let submitted = line.submit(&e)
                if !first { if str.push(&outputs, ",") != ok { ret 12i32 } }
                if !hex_of(&outputs, submitted) { ret 13i32 }
                first = false
            } else if action == line.Action.Interrupt {
                line.clear(&e)
                marker = "c"
            } else if action == line.Action.ClearScreen {
                marker = "l"
            } else if action == line.Action.Eof {
                marker = "d"
                finished = true
            }
            if marker.len > 0usize {
                if !first { if str.push(&outputs, ",") != ok { ret 12i32 } }
                if str.push(&outputs, marker) != ok { ret 12i32 }
                first = false
            }
        }
        if !str.eq(str.done(&outputs), outputs_want) { ret 100i32 + n }
        // Final state.
        let (fb, fe) = str.builder(a, 512usize)
        if fe != ok { ret 14i32 }
        var fin = fb
        if !hex_of(&fin, line.text(&e)) { ret 15i32 }
        if !str.eq(str.done(&fin), final_hex) { ret 300i32 + n }
        let (want_cursor, ce) = str.parse_u64(cursor_text)
        if ce != ok || codepoints_before(line.text(&e), e.cursor) != usize(want_cursor) { ret 500i32 + n }
        let (kb, ke) = str.builder(a, 512usize)
        if ke != ok { ret 16i32 }
        var kb2 = kb
        if !hex_of(&kb2, e.kill[0..e.kill_len]) { ret 17i32 }
        if !str.eq(str.done(&kb2), kill_hex) { ret 700i32 + n }
        // Redraw bytes.
        let (rb, re) = str.builder(a, 1024usize)
        if re != ok { ret 18i32 }
        var render = rb
        if line.render(&render, &e, "> ", 2usize, line.history_hint(&e)) != ok { ret 19i32 }
        let (xb, xe) = str.builder(a, 2048usize)
        if xe != ok { ret 20i32 }
        var rendered_hex = xb
        if !hex_of(&rendered_hex, str.done(&render)) { ret 21i32 }
        if !str.eq(str.done(&rendered_hex), render_hex) { ret 900i32 + n }
        n += 1i32
    }
    if n != 120i32 { ret 22i32 }
    ret 0i32
}

fn act(e: *line.Editor, keys: str) -> line.Action {
    var sink = 0u8
    let (used, action) = line.feed[u8](e, keys, &sink, complete)
    ret action
}

fn press(e: *line.Editor, keys: str) {
    let action = act(e, keys)
}

fn check_hand() -> i32 {
    var store: Store = zero
    var e = line.editor(store.buf[0..], store.draft[0..], store.kill[0..], store.hist[0..], store.starts[0..], store.lens[0..], store.cands[0..])
    // Typing, moving, deleting by code point.
    press(&e, "caf\xC3\xA9")
    if !str.eq(line.text(&e), "caf\xC3\xA9") || e.cursor != 5usize { ret 40i32 }
    press(&e, "\x1B[D")
    if e.cursor != 3usize { ret 41i32 }
    press(&e, "\x7F")
    if !str.eq(line.text(&e), "ca\xC3\xA9") { ret 42i32 }
    // A kill and a yank restore it elsewhere; consecutive kills join.
    line.clear(&e)
    press(&e, "one two three")
    press(&e, "\x17\x17")
    if !str.eq(line.text(&e), "one ") || !str.eq(e.kill[0..e.kill_len], "two three") { ret 43i32 }
    press(&e, "\x01\x19")
    if !str.eq(line.text(&e), "two threeone ") { ret 44i32 }
    // Enter is Accept and leaves the text for the caller's validator.
    let accepted = act(&e, "\r")
    if accepted != line.Action.Accept || !str.eq(line.text(&e), "two threeone ") { ret 45i32 }
    // A multi-line entry: the caller continues with a newline at the end of the line.
    press(&e, "\x05")
    if !line.insert_newline(&e) { ret 46i32 }
    press(&e, "x")
    if !str.eq(line.text(&e), "two threeone \nx") { ret 47i32 }
    let submitted = line.submit(&e)
    if !str.eq(submitted, "two threeone \nx") || e.len != 0usize || e.hist_count != 1usize { ret 48i32 }
    // History: Up recalls, Down returns to the draft; a duplicate is not added twice.
    press(&e, "draft")
    press(&e, "\x1B[A")
    if !str.eq(line.text(&e), "two threeone \nx") { ret 49i32 }
    press(&e, "\x1B[B")
    if !str.eq(line.text(&e), "draft") { ret 50i32 }
    line.history_add(&e, "two threeone \nx")
    if e.hist_count != 1usize { ret 51i32 }
    // The hint is the rest of the newest matching entry; accepting it appends.
    line.clear(&e)
    line.history_add(&e, "list files")
    press(&e, "list")
    let hint = line.history_hint(&e)
    if !str.eq(hint, " files") { ret 52i32 }
    if !line.accept_hint(&e, hint) || !str.eq(line.text(&e), "list files") { ret 53i32 }
    // Completion: a unique match completes, an ambiguous one extends to the common prefix and then cycles.
    line.clear(&e)
    press(&e, "qu\t")
    if !str.eq(line.text(&e), "quit") { ret 54i32 }
    line.clear(&e)
    press(&e, "he\t")
    if !str.eq(line.text(&e), "hel") { ret 55i32 }
    press(&e, "\t")
    if !str.eq(line.text(&e), "help") { ret 56i32 }
    press(&e, "\t")
    if !str.eq(line.text(&e), "hello") { ret 57i32 }
    press(&e, "x")
    if !str.eq(line.text(&e), "hellox") { ret 58i32 }
    // Interrupt, Eof on an empty line, and a clear request.
    line.clear(&e)
    if act(&e, "\x03") != line.Action.Interrupt { ret 59i32 }
    if act(&e, "\x04") != line.Action.Eof { ret 60i32 }
    if act(&e, "\x0C") != line.Action.ClearScreen { ret 61i32 }
    // The buffer is bounded: text past the capacity is ignored, nothing is overrun.
    line.clear(&e)
    var long: [100]u8 = zero
    var i = 0usize
    while i < 100usize {
        long[i] = 97u8
        i += 1usize
    }
    press(&e, long[0..])
    if e.len != 96usize { ret 62i32 }
    ret 0i32
}

fn main(a: *mem.Arena, args: []str) -> err {
    var code = check_vectors(a)
    if code == 0i32 { code = check_hand() }
    if code != 0i32 { os.exit(code) }
    let e = io.print("cli line ok")
    ret ok
}
