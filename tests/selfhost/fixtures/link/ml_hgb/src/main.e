// `e.ml.hgb` against scikit-learn's HistGradientBoosting (scripts/gen_hgb_test.py): midpoint and quantile bin thresholds,
// leaf-wise growth with min_samples_leaf, depth and L2 limits, missing values in training and at prediction time, and the
// regression and binary log-loss objectives.
use e.io
use e.mem
use e.ml.hgb as hgb
use e.os
use e.str

fn near(x: f64, want: f64, eps: f64) -> bool {
    if x != x || want != want { ret x != x && want != want }
    var d = x - want
    if d < 0.0f64 { d = 0.0f64 - d }
    var scale = want
    if scale < 0.0f64 { scale = 0.0f64 - scale }
    if scale < 1.0f64 { scale = 1.0f64 }
    ret d <= eps * scale
}

// Parses a field of space-separated numbers into `out` and answers how many.
fn nums(field: str, out: []f64) -> usize {
    var count = 0usize
    let (it0, e0) = str.split(str.trim(field), " ")
    if e0 != ok { ret 0usize }
    var it = it0
    while true {
        let (piece, more) = str.split_next(&it)
        if !more { break }
        if piece.len == 0usize { continue }
        let (v, pe) = str.parse_f64(piece)
        if pe != ok { os.exit(97i32) }
        if count < out.len {
            out[count] = v
            count += 1usize
        }
    }
    ret count
}

fn load(field: str, out: []f64) {
    let loaded = nums(field, out)
}

fn run_chunk(a: *mem.Arena, block: str) -> u32 {
    let (lines0, le) = str.split(block, "\n")
    if le != ok { ret 99u32 }
    var lines = lines0
    var failed = 0u32
    while true {
        let (line, more) = str.split_next(&lines)
        if !more { break }
        if line.len == 0usize { continue }
        let (parts0, pe) = str.split(line, "|")
        if pe != ok { ret 98u32 }
        var parts = parts0
        var fields: [12]str = zero
        var nf = 0usize
        while nf < 12usize {
            let (piece, got) = str.split_next(&parts)
            if !got { break }
            fields[nf] = piece
            nf += 1usize
        }
        let mark = mem.mark(a)
        let passed = check(a, fields[..], nf)
        mem.reset(a, mark)
        if !passed {
            let shown = io.print(line)
            let nl = io.print("\n")
            failed += 1u32
        }
    }
    ret failed
}

fn check(a: *mem.Arena, f: []str, nf: usize) -> bool {
    var head: [12]f64 = zero
    load(f[1usize], head[..])
    let n = usize(head[0usize])
    let d = usize(head[1usize])
    let (x, xe) = mem.alloc[f64](a, n * d + 1usize)
    let (y, ye) = mem.alloc[f64](a, n + 1usize)
    let (xt, xte) = mem.alloc[f64](a, 14usize * d + 1usize)
    let (want, we) = mem.alloc[f64](a, 15usize)
    if xe != ok || ye != ok || xte != ok || we != ok { ret false }
    let nx = nums(f[2usize], x)
    let ny = nums(f[3usize], y)
    let nt = nums(f[4usize], xt)
    let nw = nums(f[5usize], want)
    if nx != n * d || ny != n || nt != 14usize * d || nw != 14usize { ret false }
    var p = hgb.default_params()
    p.rounds = usize(head[2usize])
    p.learning_rate = head[3usize]
    p.max_leaf_nodes = usize(head[4usize])
    p.max_depth = usize(head[5usize])
    p.min_samples_leaf = usize(head[6usize])
    p.l2 = head[7usize]
    p.max_bins = usize(head[8usize])
    p.logistic = head[9usize] != 0.0f64
    let (m, e) = hgb.fit(a, x[..nx], y[..ny], n, d, p)
    if e != ok { ret false }
    var i = 0usize
    while i < 14usize {
        let got = hgb.predict(&m, xt[i * d..i * d + d])
        var scale = want[i]
        if scale < 0.0f64 { scale = 0.0f64 - scale }
        if scale < 1.0f64 { scale = 1.0f64 }
        var diff = got - want[i]
        if diff < 0.0f64 { diff = 0.0f64 - diff }
        if diff > 0.0001f64 * scale {
            let (sb, sbe) = str.builder(a, 96usize)
            var out_text = sb
            let p1 = str.push_f64(&out_text, got)
            let p2 = str.push_byte(&out_text, 32u8)
            let p3 = str.push_f64(&out_text, want[i])
            let shown = io.print(str.done(&out_text))
            let nl = io.print("|")
            ret false
        }
        i += 1usize
    }
    ret true
}

