fn lcg(state: *u64) -> u64 {
    *state = *state *% 6364136223846793005u64 +% 1442695040888963407u64
    ret *state >> 33u32
}

// sig_mono in gen.py.
fn gen_mono(out: []i32) {
    var state = 7u64
    var i = 0usize
    while i < 2000usize {
        let r = lcg(&state)
        let s = i32(8000.0f64 * math.sin[f64](f64(i) * 0.12566370614359174f64))
        out[i] = s + i32(r % 257u64) - 128i32
        i += 1usize
    }
}

// sig_stereo in gen.py: interleaved; the right channel copies the left or takes its own sine.
fn gen_stereo(out: []i32, noise_left: u64, noise_right: u64, copy_left: bool) {
    var state = 11u64
    var i = 0usize
    while i < 1500usize {
        let r = lcg(&state)
        let base = i32(6000.0f64 * math.sin[f64](f64(i) * 0.15707963267948966f64))
        let l = base + i32(r % noise_left) - i32(noise_left / 2u64)
        let r2 = lcg(&state)
        var right = base
        if copy_left { right = l }
        out[i * 2usize] = l
        out[i * 2usize + 1usize] = right + i32(r2 % noise_right) - i32(noise_right / 2u64)
        i += 1usize
    }
}

// sig_noise in gen.py.
fn gen_noise(out: []i32) {
    var state = 3u64
    var i = 0usize
    while i < 400usize {
        let r = lcg(&state)
        out[i] = i32(r % 65536u64) - 32768i32
        i += 1usize
    }
}

// sig_ramp in gen.py (24-bit).
fn gen_ramp(out: []i32) {
    var i = 0usize
    while i < 1200usize {
        out[i] = i32(i) * 3001i32 - 1800000i32
        i += 1usize
    }
}

fn gen_const(out: []i32) {
    var i = 0usize
    while i < 5000usize {
        out[i] = 1234i32
        i += 1usize
    }
}

// 0 when `src` decodes to exactly `expect` and its MD5 verifies; 1..4 name the failure.
fn check(src: []const u8, expect: []const i32, per_channel: usize, out: []i32, scratch: []i64, bytes: []u8) -> i32 {
    let (info, ie) = flac.stream_info(src)
    if ie != ok || info.total != u64(per_channel) { ret 1i32 }
    let (n, e) = flac.decode(src, out, scratch)
    if e != ok { ret 1i32 }
    if n != per_channel { ret 2i32 }
    if !mem.eq[i32](out[..expect.len], expect) { ret 3i32 }
    if !flac.md5_check(out[..expect.len], info, bytes) { ret 4i32 }
    ret 0i32
}

fn main(a: *mem.Arena, args: []str) -> err {
    var out: [5000]i32 = zero
    var expect: [5000]i32 = zero
    var scratch: [4096]i64 = zero
    var bytes: [10000]u8 = zero
    var copy: [2400]u8 = zero

    // 1: STREAMINFO of the mono stream matches soundfile's metadata.
    let (info, ie) = flac.stream_info(mono_flac())
    if ie != ok || info.rate != 8000u32 || info.channels != 1u32 || info.bits != 16u32 || info.total != 2000u64 { os.exit(1i32) }
    if info.min_block != 4096u32 || info.max_block != 4096u32 || info.min_frame != 2221u32 || info.max_frame != 2221u32 { os.exit(1i32) }

    // 2: the first frame header (after a 44-byte VORBIS_COMMENT block, at byte 86).
    let (h, he) = flac.frame_header(mono_flac(), 86usize)
    if he != ok || h.block_size != 2000u32 || h.rate != 8000u32 || h.channels != 1u32 || h.bits != 16u32 { os.exit(2i32) }
    if h.number != 0u64 || h.size != 8usize || h.variable || h.assignment != .Independent { os.exit(2i32) }

    // 3: the two CRCs against the check values of CRC-8 (0x07) and CRC-16/BUYPASS.
    if flac.crc8("123456789") != 244u8 || flac.crc16("123456789") != 65256u16 { os.exit(3i32) }

    // 10+: mono, LPC order 8.
    gen_mono(expect[..])
    let c1 = check(mono_flac(), expect[..2000], 2000usize, out[..], scratch[..], bytes[..])
    if c1 != 0i32 { os.exit(10i32 + c1) }

    // 20+: stereo left/side.
    gen_stereo(expect[..], 65u64, 33u64, true)
    let c2 = check(ls_flac(), expect[..3000], 1500usize, out[..], scratch[..], bytes[..])
    if c2 != 0i32 { os.exit(20i32 + c2) }

    // 30+: stereo mid/side.
    gen_stereo(expect[..], 9u64, 9u64, false)
    let c3 = check(ms_flac(), expect[..3000], 1500usize, out[..], scratch[..], bytes[..])
    if c3 != 0i32 { os.exit(30i32 + c3) }

    // 40+: stereo right/side.
    gen_stereo(expect[..], 65u64, 3u64, false)
    let c4 = check(rs_flac(), expect[..3000], 1500usize, out[..], scratch[..], bytes[..])
    if c4 != 0i32 { os.exit(40i32 + c4) }

    // 50+: full-range noise, verbatim.
    gen_noise(expect[..])
    let c5 = check(noise_flac(), expect[..400], 400usize, out[..], scratch[..], bytes[..])
    if c5 != 0i32 { os.exit(50i32 + c5) }

    // 60+: 24-bit ramp, fixed order 2.
    let (ramp_info, re) = flac.stream_info(ramp_flac())
    if re != ok || ramp_info.bits != 24u32 || ramp_info.rate != 48000u32 { os.exit(60i32) }
    gen_ramp(expect[..])
    let c6 = check(ramp_flac(), expect[..1200], 1200usize, out[..], scratch[..], bytes[..])
    if c6 != 0i32 { os.exit(60i32 + c6) }

    // 70+: constant samples in two frames, driven frame by frame.
    gen_const(expect[..])
    let (d0, de) = flac.decoder(const_flac())
    if de != ok || d0.pos != 86usize { os.exit(70i32) }
    var d = d0
    let (n1, e1) = flac.decode_frame(&d, out[..], scratch[..])
    if e1 != ok || n1 != 4096usize || d.pos != 97usize { os.exit(71i32) }
    let (n2, e2) = flac.decode_frame(&d, out[4096usize..], scratch[..])
    if e2 != ok || n2 != 904usize || !flac.at_end(d) { os.exit(72i32) }
    let (n3, e3) = flac.decode_frame(&d, out[..], scratch[..])
    if e3 != ok || n3 != 0usize { os.exit(73i32) }
    if !mem.eq[i32](out[..5000], expect[..5000]) { os.exit(74i32) }
    let c7 = check(const_flac(), expect[..5000], 5000usize, out[..], scratch[..], bytes[..])
    if c7 != 0i32 { os.exit(75i32) }

    // 80: a flipped byte inside the mono frame fails the CRC-16 (or the parse).
    let mono = mono_flac()
    mem.copy[u8](copy[..], mono)
    copy[600] = copy[600] ^ 85u8
    let (_, fe) = flac.decode(copy[..mono.len], out[..], scratch[..])
    if fe != flac.Checksum && fe != flac.Malformed { os.exit(80i32) }

    // 81: a frame cut short is Malformed, with or without its footer.
    let (_, te) = flac.decode(mono[..1500], out[..], scratch[..])
    if te != flac.Malformed { os.exit(81i32) }
    let (_, te2) = flac.decode(mono[..mono.len - 1usize], out[..], scratch[..])
    if te2 != flac.Malformed { os.exit(81i32) }

    // 82: a header cut inside the metadata is TooSmall; a wrong marker is Malformed.
    let (_, se) = flac.stream_info(mono[..40])
    if se != flac.TooSmall { os.exit(82i32) }
    let (_, me) = flac.stream_info("fLaX\x00\x00\x00\x22")
    if me != flac.Malformed { os.exit(82i32) }

    try io.print("fmt flac ok\n")
    ret ok
}
