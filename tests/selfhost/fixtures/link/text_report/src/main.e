fn nibble(c: u8) -> u8 {
    if c >= 97u8 { ret c - 87u8 }
    ret c - 48u8
}

fn unhex(a: *mem.Arena, h: str) -> str {
    let (out, e) = mem.alloc[u8](a, h.len / 2usize + 1usize)
    if e != ok { os.exit(90i32) }
    var i = 0usize
    while i + 1usize < h.len {
        out[i / 2usize] = (nibble(h[i]) << 4u8) | nibble(h[i + 1usize])
        i += 2usize
    }
    ret out[0..h.len / 2usize]
}

fn count_of(s: str, sep: str) -> usize {
    if s.len == 0usize { ret 0usize }
    ret str.count(s, sep) + 1usize
}

fn check_vectors(a: *mem.Arena) -> i32 {
    var lines = str.lines(vectors())
    var n = 0i32
    while true {
        let (record, more) = str.split_next(&lines)
        if !more { break }
        if record.len == 0usize { continue }
        let (spec, want_hex, g0) = str.split_once(record, "~")
        if !g0 { ret 10i32 }
        let (sev, r1, g1) = str.split_once(spec, "|")
        let (code_hex, r2, g2) = str.split_once(r1, "|")
        let (message_hex, r3, g3) = str.split_once(r2, "|")
        let (name_hex, r4, g4) = str.split_once(r3, "|")
        let (source_hex, r5, g5) = str.split_once(r4, "|")
        let (label_text, note_text, g6) = str.split_once(r5, "|")
        if !g1 || !g2 || !g3 || !g4 || !g5 || !g6 { ret 11i32 }
        var severity = report.Severity.Error
        if str.eq(sev, "w") { severity = report.Severity.Warning }
        if str.eq(sev, "a") { severity = report.Severity.Advice }
        let label_n = count_of(label_text, ";")
        let note_n = count_of(note_text, ";")
        let (labels, le) = mem.alloc[report.Label](a, label_n + 1usize)
        if le != ok { ret 12i32 }
        let (notes, ne) = mem.alloc[report.Note](a, note_n + 1usize)
        if ne != ok { ret 13i32 }
        var i = 0usize
        var rest = label_text
        while i < label_n {
            let (item, tail, more_items) = str.split_once(rest, ";")
            var one = item
            if !more_items { one = rest }
            let (s_text, q1, h1) = str.split_once(one, ":")
            let (e_text, q2, h2) = str.split_once(q1, ":")
            let (p_text, m_hex, h3) = str.split_once(q2, ":")
            if !h1 || !h2 || !h3 { ret 14i32 }
            let (start, se) = str.parse_u64(s_text)
            let (end, ee) = str.parse_u64(e_text)
            if se != ok || ee != ok { ret 15i32 }
            labels[i] = report.Label { start: usize(start), end: usize(end), message: unhex(a, m_hex), primary: str.eq(p_text, "p") }
            if more_items { rest = tail }
            i += 1usize
        }
        i = 0usize
        rest = note_text
        while i < note_n {
            let (item, tail, more_items) = str.split_once(rest, ";")
            var one = item
            if !more_items { one = rest }
            let (k_hex, t_hex, h1) = str.split_once(one, "=")
            if !h1 { ret 16i32 }
            notes[i] = report.Note { kind: unhex(a, k_hex), text: unhex(a, t_hex) }
            if more_items { rest = tail }
            i += 1usize
        }
        let r = report.Report { severity: severity, code: unhex(a, code_hex), message: unhex(a, message_hex), source_name: unhex(a, name_hex), source: unhex(a, source_hex), labels: labels[0..label_n], notes: notes[0..note_n] }
        let (got, re) = report.render(a, &r, report.options_default())
        if re != ok { ret 17i32 }
        let want = unhex(a, want_hex)
        if !str.eq(got, want) { ret 100i32 + n }
        n += 1i32
    }
    if n != 150i32 { ret 18i32 }
    ret 0i32
}

fn check_hand(a: *mem.Arena) -> i32 {
    var labels: [4]report.Label = zero
    var notes: [2]report.Note = zero
    labels[0] = report.Label { start: 24usize, end: 25usize, message: "expected an expression", primary: true }
    notes[0] = report.Note { kind: "help", text: "write a value after `=`" }
    var r = report.Report { severity: report.Severity.Error, code: "E0001", message: "unexpected token", source_name: "main.e", source: "fn main() {\n    let x = ;\n}\n", labels: labels[0..1], notes: notes[0..1] }
    let (got, e) = report.render(a, &r, report.options_default())
    let want = "error[E0001]: unexpected token\n --> main.e:2:13\n  |\n1 | fn main() {\n2 |     let x = ;\n  |             ^ expected an expression\n3 | }\n  |\n  = help: write a value after `=`\n"
    if e != ok || !str.eq(got, want) { ret 40i32 }
    // Two labels on one line: the rightmost message inline, the other hanging under a connector.
    r.source = "let total = price * qty;\n"
    r.code = ""
    r.message = "mismatch"
    r.labels = labels[0..2]
    labels[0] = report.Label { start: 12usize, end: 17usize, message: "price", primary: false }
    labels[1] = report.Label { start: 20usize, end: 23usize, message: "qty", primary: true }
    r.notes = notes[0..0]
    let (two, e2) = report.render(a, &r, report.options_default())
    let want2 = "error: mismatch\n --> main.e:1:21\n  |\n1 | let total = price * qty;\n  |             -----   ^^^ qty\n  |             |\n  |             price\n2 | \n  |\n"
    if e2 != ok || !str.eq(two, want2) { ret 41i32 }
    // Context 0 and a gap: only the labelled lines, `...` between them.
    r.source = "a\nb\nc\nd\ne\n"
    labels[0] = report.Label { start: 0usize, end: 1usize, message: "first", primary: true }
    labels[1] = report.Label { start: 8usize, end: 9usize, message: "last", primary: false }
    var o = report.options_default()
    o.context = 0usize
    let (gap, e3) = report.render(a, &r, o)
    let want3 = "error: mismatch\n --> main.e:1:1\n  |\n1 | a\n  | ^ first\n...\n5 | e\n  | - last\n  |\n"
    if e3 != ok || !str.eq(gap, want3) { ret 42i32 }
    // A label across lines marks the rest of the first and the start of the last.
    r.source = "call(\n    arg,\n    other)\n"
    labels[0] = report.Label { start: 4usize, end: 22usize, message: "arguments", primary: true }
    r.labels = labels[0..1]
    o = report.options_default()
    let (span, e4) = report.render(a, &r, o)
    let want4 = "error: mismatch\n --> main.e:1:5\n  |\n1 | call(\n  |     ^\n2 |     arg,\n3 |     other)\n  |     ^^^ arguments\n4 | \n  |\n"
    if e4 != ok || !str.eq(span, want4) { ret 43i32 }
    // Colour wraps the header and marks; the plain text inside is unchanged.
    r.source = "x = ;\n"
    labels[0] = report.Label { start: 4usize, end: 5usize, message: "here", primary: true }
    o.color = true
    let (colored, e5) = report.render(a, &r, o)
    if e5 != ok { ret 44i32 }
    // The coloured text with the escape sequences removed is the plain rendering.
    var plain = report.options_default()
    let (flat, e6) = report.render(a, &r, plain)
    if e6 != ok { ret 45i32 }
    var stripped = 0usize
    var i = 0usize
    var plain_bytes: [512]u8 = zero
    while i < colored.len {
        if colored[i] == 27u8 {
            while i < colored.len && colored[i] != 109u8 { i += 1usize }
            i += 1usize
        } else {
            plain_bytes[stripped] = colored[i]
            stripped += 1usize
            i += 1usize
        }
    }
    if !str.eq(plain_bytes[0..stripped], flat) { ret 46i32 }
    if str.count(colored, "\x1B[1;31m") < 2usize { ret 47i32 }
    // Refusals: past the source, not on a UTF-8 boundary, reversed.
    var bad = report.Report { severity: report.Severity.Error, code: "", message: "m", source_name: "n", source: "h\xC3\xA9llo", labels: labels[0..1], notes: notes[0..0] }
    labels[0] = report.Label { start: 0usize, end: 99usize, message: "", primary: true }
    let (x1, f1) = report.render(a, &bad, report.options_default())
    if f1 != report.Invalid { ret 50i32 }
    labels[0] = report.Label { start: 2usize, end: 3usize, message: "", primary: true }
    let (x2, f2) = report.render(a, &bad, report.options_default())
    if f2 != report.Invalid { ret 51i32 }
    labels[0] = report.Label { start: 3usize, end: 1usize, message: "", primary: true }
    let (x3, f3) = report.render(a, &bad, report.options_default())
    if f3 != report.Invalid { ret 52i32 }
    // No labels: the header and notes only.
    bad.labels = labels[0..0]
    bad.notes = notes[0..1]
    let (bare, f4) = report.render(a, &bad, report.options_default())
    if f4 != ok || !str.eq(bare, "error: m\n  = help: write a value after `=`\n") { ret 53i32 }
    ret 0i32
}

fn main(a: *mem.Arena, args: []str) -> err {
    var code = check_vectors(a)
    if code == 0i32 { code = check_hand(a) }
    if code != 0i32 { os.exit(code) }
    let e = io.print("text report ok")
    ret ok
}
