// e.time.recur against python-dateutil rrule (an RFC 5545 expander; its plain/ordinal BYDAY
// intersection is replaced by the RFC union via two single-kind rules), and e.time.parse against
// dateutil's isoparse and parser.parse (strict then lenient, both day orders) and an independent
// humantime unit table for durations. A recurrence line is `R START N RULE => COUNT HASH` (HASH is
// the rolling 31-hash of the first N occurrences' YYYYMMDDHHMMSS keys), a parse line is
// `P DAYFIRST KEY NANOS OFFSET TEXT` (KEY E: refused; OFFSET 99999: none), a duration line is
// `D NANOS|E TEXT`.
use e.io
use e.mem
use e.os
use e.time
use e.time.calendar
use e.time.parse
use e.time.recur

fn tok(line: str, at: usize) -> (str, usize) {
    var p = at
    while p < line.len && line[p] == 32u8 { p += 1usize }
    let start = p
    while p < line.len && line[p] != 32u8 { p += 1usize }
    ret (line[start..p], p)
}

fn dec(s: str) -> i64 {
    var v = 0i64
    var neg = false
    var i = 0usize
    if s.len > 0usize && s[0usize] == 45u8 {
        neg = true
        i = 1usize
    }
    while i < s.len {
        v = v * 10i64 + i64(s[i] - 48u8)
        i += 1usize
    }
    if neg { ret 0i64 - v }
    ret v
}

fn recur_key(d: calendar.DateTime) -> i64 {
    ret i64(d.date.year) * 10000000000i64 + i64(d.date.month) * 100000000i64 + i64(d.date.day) * 1000000i64 + i64(d.time.hour) * 10000i64 + i64(d.time.minute) * 100i64 + i64(d.time.second)
}

fn check_recur_line(line: str, out: []calendar.DateTime) -> bool {
    let (t0, p0) = tok(line, 0usize)
    let (start_text, p1) = tok(line, p0)
    let (n_text, p2) = tok(line, p1)
    let (rule_text, p3) = tok(line, p2)
    let (arrow, p4) = tok(line, p3)
    let (count_text, p5) = tok(line, p4)
    let (hash_text, p6) = tok(line, p5)
    let (start, start_error) = recur.parse_stamp(start_text)
    if start_error != ok { ret false }
    let (rule, rule_error) = recur.parse_rule(rule_text)
    if rule_error != ok { ret false }
    let limit = usize(dec(n_text))
    let (got, expand_error) = recur.expand(rule, start, out[0usize..limit])
    if expand_error != ok { ret false }
    var h = 0i64
    var i = 0usize
    while i < got {
        h = (h * 31i64 + recur_key(out[i])) % 1000000007i64
        i += 1usize
    }
    ret i64(got) == dec(count_text) && h == dec(hash_text)
}

fn run_recur(text: str, out: []calendar.DateTime) -> u8 {
    var start = 0usize
    var i = 0usize
    while i < text.len {
        if text[i] == 10u8 {
            if !check_recur_line(text[start..i], out) { ret 1u8 }
            start = i + 1usize
        }
        i += 1usize
    }
    ret 0u8
}

fn parse_key(p: parse.Parsed) -> i64 {
    let d = p.value
    ret i64(d.date.year) * 10000000000i64 + i64(d.date.month) * 100000000i64 + i64(d.date.day) * 1000000i64 + i64(d.time.hour) * 10000i64 + i64(d.time.minute) * 100i64 + i64(d.time.second)
}

fn offset_of(p: parse.Parsed) -> i64 {
    if !p.has_offset { ret 99999i64 }
    ret i64(p.offset_minutes)
}

fn run_parse(text: str) -> u8 {
    var start = 0usize
    var i = 0usize
    while i < text.len {
        if text[i] == 10u8 {
            let line = text[start..i]
            let (t0, q0) = tok(line, 0usize)
            let (flag, q1) = tok(line, q0)
            let (key, q2) = tok(line, q1)
            let (nanos, q3) = tok(line, q2)
            let (off, q4) = tok(line, q3)
            var body = q4
            if body < line.len { body += 1usize }
            let (got, got_error) = parse.parse_date(line[body..line.len], flag[0usize] == 49u8)
            if key[0usize] == 69u8 {
                if got_error == ok { ret 1u8 }
            } else {
                if got_error != ok { ret 2u8 }
                if parse_key(got) != dec(key) || i64(got.value.time.nanos) != dec(nanos) || offset_of(got) != dec(off) { ret 3u8 }
            }
            start = i + 1usize
        }
        i += 1usize
    }
    ret 0u8
}

fn run_durations(text: str) -> u8 {
    var start = 0usize
    var i = 0usize
    while i < text.len {
        if text[i] == 10u8 {
            let line = text[start..i]
            let (t0, q0) = tok(line, 0usize)
            let (want, q1) = tok(line, q0)
            var body = q1
            if body < line.len { body += 1usize }
            let (got, got_error) = parse.parse_duration(line[body..line.len])
            if want[0usize] == 69u8 {
                if got_error == ok { ret 1u8 }
            } else {
                if got_error != ok { ret 2u8 }
                if got.nanos != dec(want) { ret 3u8 }
            }
            start = i + 1usize
        }
        i += 1usize
    }
    ret 0u8
}

