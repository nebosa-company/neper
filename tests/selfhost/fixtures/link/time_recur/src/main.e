fn main(a: *mem.Arena, args: []str) -> err {
    var out: [64]calendar.DateTime = zero
    // The refusals the rule text can earn.
    let (_, no_freq) = recur.parse_rule("COUNT=3")
    let (_, weekno) = recur.parse_rule("FREQ=YEARLY;BYWEEKNO=20")
    let (_, bad_ordinal) = recur.parse_rule("FREQ=WEEKLY;BYDAY=1MO")
    let (_, bad_month) = recur.parse_rule("FREQ=MONTHLY;BYMONTH=13")
    let (_, zero_interval) = recur.parse_rule("FREQ=DAILY;INTERVAL=0")
    if no_freq != recur.Invalid || weekno != recur.Invalid || bad_ordinal != recur.Invalid || bad_month != recur.Invalid || zero_interval != recur.Invalid { os.exit(90i32) }
    // A leading RRULE: and lower case are read; the start itself is produced when it matches.
    let (r, r_error) = recur.parse_rule("RRULE:freq=daily;count=3")
    let (start, start_error) = recur.parse_stamp("20240228T093000")
    if r_error != ok || start_error != ok { os.exit(91i32) }
    let (n, n_error) = recur.expand(r, start, out[0usize..64usize])
    if n_error != ok || n != 3usize || out[2usize].date.month != 3u8 || out[2usize].date.day != 1u8 { os.exit(92i32) }
    // expand_from drops what is before `from` but counts it toward COUNT.
    let (m, m_error) = recur.expand_from(r, start, out[1usize], out[0usize..64usize])
    if m_error != ok || m != 2usize || out[0usize].date.day != 29u8 { os.exit(93i32) }
    // An invalid start is refused.
    var bad_start = start
    bad_start.date.month = 13u8
    let (_, bad_error) = recur.expand(r, bad_start, out[0usize..64usize])
    if bad_error != recur.Invalid { os.exit(94i32) }
    if run_recur(recur_vectors_0(), out[0usize..64usize]) != 0u8 { os.exit(1i32) }
    if run_recur(recur_vectors_1(), out[0usize..64usize]) != 0u8 { os.exit(2i32) }
    if run_recur(recur_vectors_2(), out[0usize..64usize]) != 0u8 { os.exit(3i32) }
    if run_recur(recur_vectors_3(), out[0usize..64usize]) != 0u8 { os.exit(4i32) }
    if run_recur(recur_vectors_4(), out[0usize..64usize]) != 0u8 { os.exit(5i32) }
    if run_recur(recur_vectors_5(), out[0usize..64usize]) != 0u8 { os.exit(6i32) }
    if run_parse(parse_vectors_0()) != 0u8 { os.exit(41i32) }
    if run_parse(parse_vectors_1()) != 0u8 { os.exit(42i32) }
    if run_parse(parse_vectors_2()) != 0u8 { os.exit(43i32) }
