// `e.math`'s sin, cos and tan, against a 200-bit reference. The inputs reach the direct kernel, the three steps of the Cody-Waite
// reduction and the Payne-Hanek one past 2^19 * pi/4 -- the double that cancels the most
// bits of any among them -- so the reduction is checked as much as the kernels.
//
// `close` is one representable value: the result is within 1 ULP of the correctly rounded
// answer, so within 1.5 ULP of the true one, inside section 11's 2. That is the measured bound
// and this file is what keeps it measured. The references were computed with mpmath at 200
// bits and rounded once, with the IEEE answers written in where mpmath has none -- the signed
// zeros and infinite quadrants of `atan2`, the signs and zeros of `pow`. Exit codes name the
// function; the input is the line.

use e.mem
use e.os
use e.math

fn f64_of(bits: u64) -> f64 { ret mem.bitcast[f64](bits) }

fn close(got: f64, want_bits: u64) -> bool {
    let want = f64_of(want_bits)
    if got != got && want != want { ret true }
    if got != got || want != want { ret false }
    let g = mem.bitcast[u64](got)
    if g == want_bits { ret true }
    if (g >> 63u32) != (want_bits >> 63u32) {
        // Across zero: the two magnitudes are the distance.
        let g_mag = g & 9223372036854775807u64
        let w_mag = want_bits & 9223372036854775807u64
        ret g_mag + w_mag <= 1u64
    }
    if g > want_bits { ret g - want_bits <= 1u64 }
    ret want_bits - g <= 1u64
}

