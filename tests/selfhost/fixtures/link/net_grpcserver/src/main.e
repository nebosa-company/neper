// `e.net.grpcserver` over `e.net.http2` against grpcio (L164): scripts/grpcserver_vectors.py compiles the echo service
// (scripts/grpcserver_app.e) into a live server, calls it with a grpcio client through a recording proxy, asserts every
// outcome the client saw, and keeps each call's bytes in both directions. The expected request events come from an
// independent decode of the client's bytes (hyperframe, hpack, the message prefix); the expected response from the same
// decode of what the Neper server answered, which grpcio accepted. This fixture replays the client bytes at several chunk
// sizes into a server running the same service and compares the request events and the response, the response being read
// back with `e.net.grpc`'s client (itself checked against grpcio's server in net_grpc).
// Generated from scripts/grpcserver_fixture_template.e; do not edit.
use e.io
use e.mem
use e.net.grpc as grpc
use e.net.grpcserver as gs
use e.net.http2 as h2
use e.os
use e.str

fn nibble(c: u8) -> u8 {
    if c >= 97u8 { ret c - 87u8 }
    ret c - 48u8
}

fn unhex(a: *mem.Arena, h: str) -> []u8 {
    let (out, e) = mem.alloc[u8](a, h.len / 2usize + 1usize)
    if e != ok { os.exit(90i32) }
    var i = 0usize
    while i + 1usize < h.len {
        out[i / 2usize] = (nibble(h[i]) << 4u8) | nibble(h[i + 1usize])
        i += 2usize
    }
    ret out[0usize..h.len / 2usize]
}

fn hex(a: *mem.Arena, b: []const u8) -> str {
    let digits = "0123456789abcdef"
    let (out, e) = mem.alloc[u8](a, b.len * 2usize + 1usize)
    if e != ok { os.exit(91i32) }
    var i = 0usize
    while i < b.len {
        out[i * 2usize] = digits[usize(b[i] >> 4u8)]
        out[i * 2usize + 1usize] = digits[usize(b[i] & 15u8)]
        i += 1usize
    }
    ret out[0usize..b.len * 2usize]
}

fn cat(a: *mem.Arena, x: str, y: str) -> str {
    let (out, e) = str.concat(a, x, y)
    if e != ok { os.exit(92i32) }
    ret out
}

fn dec(a: *mem.Arena, n: u64) -> str {
    var buf: [24]u8 = zero
    var at = 24usize
    var v = n
    if v == 0u64 {
        at -= 1usize
        buf[at] = 48u8
    }
    while v > 0u64 {
        at -= 1usize
        buf[at] = 48u8 + u8(v % 10u64)
        v = v / 10u64
    }
    let (out, e) = mem.alloc[u8](a, 24usize - at)
    if e != ok { os.exit(93i32) }
    mem.copy[u8](out, buf[at..24usize])
    ret out
}

fn num(s: str) -> u64 {
    var v = 0u64
    var i = 0usize
    while i < s.len {
        v = v * 10u64 + u64(s[i] - 48u8)
        i += 1usize
    }
    ret v
}

fn field(rest: *str) -> str {
    let (head, tail, found) = str.split_once(*rest, "\t")
    if !found {
        let all = *rest
        *rest = ""
        ret all
    }
    *rest = tail
    ret head
}

// A payload as text: its hex, or for a large one `L<length>.<hash>` (h = h * 31 + byte, 32 bits).
fn pay(a: *mem.Arena, p: []const u8) -> str {
    if p.len <= 1024usize { ret hex(a, p) }
    var h = 0u64
    var i = 0usize
    while i < p.len {
        h = (h * 31u64 + u64(p[i])) & 4294967295u64
        i += 1usize
    }
    ret cat(a, cat(a, cat(a, "L", dec(a, u64(p.len))), "."), dec(a, h))
}

fn standard_name(name: str) -> bool {
    if name.len > 0usize && name[0usize] == 58u8 { ret true }
    if str.eq(name, "content-type") || str.eq(name, "grpc-status") || str.eq(name, "grpc-message") || str.eq(name, "grpc-encoding") { ret true }
    if str.eq(name, "grpc-accept-encoding") || str.eq(name, "user-agent") || str.eq(name, "server") || str.eq(name, "date") || str.eq(name, "accept-encoding") { ret true }
    if str.eq(name, "te") || str.eq(name, "grpc-timeout") { ret true }
    ret false
}

// The custom metadata of a header list as `hexname=hexvalue,...` (`-bin` values decoded), or `-`.
fn custom(a: *mem.Arena, headers: []const h2.Header) -> str {
    var text = ""
    var first = true
    var i = 0usize
    while i < headers.len {
        let name = headers[i].name
        if !standard_name(name) {
            var value: str = headers[i].value
            if grpc.ends_with_bin(name) {
                let (buf, e) = mem.alloc[u8](a, value.len + 4usize)
                if e != ok { os.exit(94i32) }
                let (n, decode_error) = grpc.binary_value_decode(buf, value)
                if decode_error != ok { os.exit(95i32) }
                value = buf[0usize..n]
            }
            if !first { text = cat(a, text, ",") }
            first = false
            text = cat(a, cat(a, cat(a, text, hex(a, name)), "="), hex(a, value))
        }
        i += 1usize
    }
    if first { ret "-" }
    ret text
}

fn render_client_event(a: *mem.Arena, ev: grpc.Event) -> str {
    if ev.kind == grpc.EVENT_HEADERS { ret cat(a, "H:", custom(a, ev.headers)) }
    if ev.kind == grpc.EVENT_MESSAGE {
        var flag = "0"
        if ev.compressed { flag = "1" }
        ret cat(a, cat(a, cat(a, "M:", pay(a, ev.payload)), ":"), flag)
    }
    if ev.kind == grpc.EVENT_TRAILERS {
        var s = cat(a, "T:", dec(a, u64(ev.code)))
        s = cat(a, cat(a, s, ":"), hex(a, ev.text))
        s = cat(a, cat(a, s, ":"), custom(a, ev.headers))
        ret s
    }
    ret "?"
}

fn render_server_event(a: *mem.Arena, ev: gs.Event) -> str {
    if ev.kind == gs.EVENT_REQUEST {
        var s = cat(a, "R:", hex(a, ev.text))
        s = cat(a, cat(a, s, ":"), dec(a, ev.nanos))
        s = cat(a, cat(a, s, ":"), custom(a, ev.headers))
        ret s
    }
    if ev.kind == gs.EVENT_MESSAGE {
        var flag = "0"
        if ev.compressed { flag = "1" }
        ret cat(a, cat(a, cat(a, "M:", pay(a, ev.payload)), ":"), flag)
    }
    if ev.kind == gs.EVENT_HALF_CLOSE { ret "C" }
    if ev.kind == gs.EVENT_RESET { ret cat(a, "X:", dec(a, u64(ev.code))) }
    if ev.kind == gs.EVENT_GOAWAY { ret cat(a, "G:", dec(a, u64(ev.code))) }
    ret "?"
}

fn new_client(a: *mem.Arena) -> grpc.Conn {
    let (streams, streams_error) = mem.alloc[grpc.Stream](a, 4usize)
    let (enc_data, e1) = mem.alloc[u8](a, 4096usize)
    let (enc_lens, e2) = mem.alloc[u32](a, 256usize)
    let (dec_data, e3) = mem.alloc[u8](a, 4096usize)
    let (dec_lens, e4) = mem.alloc[u32](a, 256usize)
    let (block, e5) = mem.alloc[u8](a, 16384usize)
    if streams_error != ok || e1 != ok || e2 != ok || e3 != ok || e4 != ok || e5 != ok { os.exit(97i32) }
    ret grpc.conn_new(streams, h2.table_new(enc_data, enc_lens, 4096usize), h2.table_new(dec_data, dec_lens, 4096usize), block, 1048576u32, 4194304u32)
}

// The server's bytes as the Neper client reads them, rendered: `H:..|M:..|T:..`.
fn read_back(a: *mem.Arena, path: str, data: []const u8) -> str {
    var conn = new_client(a)
    var out: [4096]u8 = zero
    let (started, start_error) = grpc.conn_start(&conn, out[0usize..])
    if start_error != ok { ret "!start" }
    let (buf, buf_error) = mem.alloc[u8](a, 262144usize)
    if buf_error != ok { os.exit(98i32) }
    var none: [1]h2.Header = zero
    let (id, written, call_error) = grpc.call_start(&conn, out[0usize..], "localhost", path, 0u64, none[0usize..0usize], buf)
    if call_error != ok || id != 1u32 { ret "!call" }
    var text = ""
    var first = true
    var saw_headers = false
    var start = 0usize
    var events: [16]grpc.Event = zero
    var hdr: [64]h2.Header = zero
    var scratch: [8192]u8 = zero
    var reply: [1024]u8 = zero
    while true {
        let (used, replied, count, e) = grpc.conn_receive(&conn, data[start..], reply[0usize..], events[0usize..], hdr[0usize..], scratch[0usize..])
        if e != ok { ret cat(a, text, "!err") }
        var k = 0usize
        while k < count {
            if !first { text = cat(a, text, "|") }
            first = false
            text = cat(a, text, render_client_event(a, events[k]))
            if events[k].kind == grpc.EVENT_HEADERS { saw_headers = true }
            if events[k].kind == grpc.EVENT_TRAILERS && saw_headers {
                // trailers after initial headers carry no pseudo-header
                var h = 0usize
                while h < events[k].headers.len {
                    if events[k].headers[h].name.len > 0usize && events[k].headers[h].name[0usize] == 58u8 { text = cat(a, text, "!pseudo") }
                    h += 1usize
                }
            }
            k += 1usize
        }
        start += used
        if used == 0usize { break }
    }
    ret text
}

// The echo service both the live interop server and the replay fixture of `e.net.grpcserver` run (L164): a fragment
// concatenated after the `use` lines of scripts/grpcserver_interop_template.e and scripts/grpcserver_fixture_template.e by
// scripts/grpcserver_vectors.py, so the server that grpcio called and the server the fixture replays are one piece of code.
// Methods of `test.Echo`: Unary reverses the request, Empty answers an empty message, Fail and StatusMessage end with a
// status and a non-ASCII message, Meta carries initial and trailing metadata (a `-bin` value too), Big answers 70000 bytes
// (more than a flow-control window, so the write is resumed after WINDOW_UPDATEs), Gzip answers a message flagged
// compressed under `grpc-encoding: gzip`, ServerStream sends three messages, ClientStream joins what it is sent, Bidi
// upper-cases each message, BigRequest answers the byte count of what it was sent, Deadline answers DEADLINE_EXCEEDED when
// the call carried a deadline, Slow never answers; anything else is UNIMPLEMENTED.

const K_UNIMPL: u8 = 0u8
const K_UNARY: u8 = 1u8
const K_EMPTY: u8 = 2u8
const K_FAIL: u8 = 3u8
const K_META: u8 = 4u8
const K_BIG: u8 = 5u8
const K_GZIP: u8 = 6u8
const K_STATUS: u8 = 7u8
const K_SSTREAM: u8 = 8u8
const K_CSTREAM: u8 = 9u8
const K_BIDI: u8 = 10u8
const K_BIGREQ: u8 = 11u8
const K_DEADLINE: u8 = 12u8
const K_SLOW: u8 = 13u8

type Slot = struct { id: u32, used: bool, kind: u8, acc_len: usize, big_len: usize, big_at: usize, pending: bool }

type App = struct { srv: *gs.Server, slots: []Slot, acc: []u8, big: []u8 }

fn kind_of(path: str) -> u8 {
    if str.eq(path, "/test.Echo/Unary") { ret K_UNARY }
    if str.eq(path, "/test.Echo/Empty") { ret K_EMPTY }
    if str.eq(path, "/test.Echo/Fail") { ret K_FAIL }
    if str.eq(path, "/test.Echo/Meta") { ret K_META }
    if str.eq(path, "/test.Echo/Big") { ret K_BIG }
    if str.eq(path, "/test.Echo/Gzip") { ret K_GZIP }
    if str.eq(path, "/test.Echo/StatusMessage") { ret K_STATUS }
    if str.eq(path, "/test.Echo/ServerStream") { ret K_SSTREAM }
    if str.eq(path, "/test.Echo/ClientStream") { ret K_CSTREAM }
    if str.eq(path, "/test.Echo/Bidi") { ret K_BIDI }
    if str.eq(path, "/test.Echo/BigRequest") { ret K_BIGREQ }
    if str.eq(path, "/test.Echo/Deadline") { ret K_DEADLINE }
    if str.eq(path, "/test.Echo/Slow") { ret K_SLOW }
    ret K_UNIMPL
}

fn app_slot(app: *App, id: u32) -> usize {
    var i = 0usize
    while i < app.slots.len {
        if app.slots[i].used && app.slots[i].id == id { ret i }
        i += 1usize
    }
    ret app.slots.len
}

fn hex_nibble(c: u8) -> u8 {
    if c >= 97u8 { ret c - 87u8 }
    ret c - 48u8
}

// The canned gzip body of the Gzip method, as hex written by the generator.
fn gzip_hex() -> str { ret "1f8b080000000000020a4bcecf2d284a2d2e56c84d55481e650f3b36005276160ae0010000" }

fn gzip_body(dst: []u8) -> usize {
    let text = gzip_hex()
    var n = 0usize
    while n * 2usize + 1usize < text.len && n < dst.len {
        dst[n] = (hex_nibble(text[n * 2usize]) << 4u8) | hex_nibble(text[n * 2usize + 1usize])
        n += 1usize
    }
    ret n
}

// A whole small message: headers if not yet sent, then the DATA, appended to `out`.
fn say(app: *App, out: []u8, at: *usize, id: u32, payload: []const u8, compressed: bool) -> err {
    let (n, e) = gs.response_message(app.srv, out[*at..], id, payload, compressed)
    if e != ok { ret e }
    *at += n
    ret ok
}

fn finish(app: *App, out: []u8, at: *usize, id: u32, status: u32, message: str, meta: []const h2.Header) -> err {
    let (n, e) = gs.response_finish(app.srv, out[*at..], id, status, message, meta)
    if e != ok { ret e }
    *at += n
    ret ok
}

// Resume a pending Big answer: write what the windows allow, finish when all of it is out.
fn pump(app: *App, out: []u8, at: *usize, j: usize) -> err {
    let slot = &app.slots[j]
    if !slot.pending { ret ok }
    let (taken, written, e) = gs.response_write(app.srv, out[*at..], slot.id, app.big[slot.big_at..slot.big_len])
    if e != ok { ret e }
    *at += written
    slot.big_at += taken
    if slot.big_at == slot.big_len {
        slot.pending = false
        let none: []const h2.Header = zero
        ret finish(app, out, at, slot.id, grpc.OK, "", none)
    }
    ret ok
}

fn pump_all(app: *App, out: []u8, at: *usize) -> err {
    var j = 0usize
    while j < app.slots.len {
        if app.slots[j].used && app.slots[j].pending {
            let e = pump(app, out, at, j)
            if e != ok { ret e }
        }
        j += 1usize
    }
    ret ok
}

fn upper_into(dst: []u8, src: []const u8) {
    var i = 0usize
    while i < src.len {
        var c = src[i]
        if c >= 97u8 && c <= 122u8 { c = c - 32u8 }
        dst[i] = c
        i += 1usize
    }
}

fn decimal_into(dst: []u8, value: usize) -> usize {
    var digits: [20]u8 = zero
    var n = 0usize
    var v = value
    if v == 0usize {
        digits[0usize] = 48u8
        n = 1usize
    }
    while v > 0usize {
        digits[n] = 48u8 + u8(v % 10usize)
        v = v / 10usize
        n += 1usize
    }
    var i = 0usize
    while i < n {
        dst[i] = digits[n - 1usize - i]
        i += 1usize
    }
    ret n
}

// One event of the connection: what the service does about it, written to `out` at `at`.
fn app_event(app: *App, ev: gs.Event, out: []u8, at: *usize) -> err {
    let none: []const h2.Header = zero
    if ev.kind == gs.EVENT_REQUEST {
        var j = 0usize
        while j < app.slots.len && app.slots[j].used { j += 1usize }
        if j == app.slots.len { ret grpc.TooSmall }
        app.slots[j] = Slot { id: ev.stream, used: true, kind: kind_of(ev.text), acc_len: 0usize, big_len: 0usize, big_at: 0usize, pending: false }
        let kind = app.slots[j].kind
        if kind == K_UNIMPL { ret finish(app, out, at, ev.stream, grpc.UNIMPLEMENTED, "Method not found!", none) }
        if kind == K_DEADLINE && ev.nanos > 0u64 {
            let (n, e) = gs.response_deadline_exceeded(app.srv, out[*at..], ev.stream)
            if e != ok { ret e }
            *at += n
        }
        ret ok
    }
    let j = app_slot(app, ev.stream)
    if j == app.slots.len { ret ok }
    let slot = &app.slots[j]
    if ev.kind == gs.EVENT_RESET {
        slot.used = false
        ret ok
    }
    if ev.kind == gs.EVENT_MESSAGE {
        let id = ev.stream
        if slot.kind == K_UNARY {
            var reply: [512]u8 = zero
            var i = 0usize
            while i < ev.payload.len && i < reply.len {
                reply[i] = ev.payload[ev.payload.len - 1usize - i]
                i += 1usize
            }
            let e = say(app, out, at, id, reply[0usize..ev.payload.len], false)
            if e != ok { ret e }
            ret finish(app, out, at, id, grpc.OK, "", none)
        }
        if slot.kind == K_EMPTY {
            let e = say(app, out, at, id, "", false)
            if e != ok { ret e }
            ret finish(app, out, at, id, grpc.OK, "", none)
        }
        if slot.kind == K_FAIL { ret finish(app, out, at, id, grpc.NOT_FOUND, "no such thing: café 100% done", none) }
        if slot.kind == K_META {
            var meta: [2]h2.Header = zero
            var bin_text: [16]u8 = zero
            var raw_init: [4]u8 = zero
            raw_init[1usize] = 1u8
            raw_init[2usize] = 254u8
            raw_init[3usize] = 255u8
            let (bn, be) = grpc.binary_value_encode(bin_text[0usize..], raw_init[0usize..4usize])
            let bin_value: str = bin_text[0usize..bn]
            meta[0usize] = h2.Header { name: "x-init", value: "first" }
            meta[1usize] = h2.Header { name: "x-init-bin", value: bin_value }
            let (hn, he) = gs.response_headers(app.srv, out[*at..], id, meta[0usize..2usize])
            if he != ok { ret he }
            *at += hn
            var body: [128]u8 = zero
            body[0usize] = 109u8
            body[1usize] = 101u8
            body[2usize] = 116u8
            body[3usize] = 97u8
            body[4usize] = 58u8
            var i = 0usize
            while i < ev.payload.len && i + 5usize < body.len {
                body[5usize + i] = ev.payload[i]
                i += 1usize
            }
            let e = say(app, out, at, id, body[0usize..5usize + ev.payload.len], false)
            if e != ok { ret e }
            var trail: [2]h2.Header = zero
            var trail_bin: [16]u8 = zero
            var raw_trail: [3]u8 = zero
            raw_trail[0usize] = 255u8
            raw_trail[2usize] = 16u8
            let (tn, te) = grpc.binary_value_encode(trail_bin[0usize..], raw_trail[0usize..3usize])
            let trail_value: str = trail_bin[0usize..tn]
            trail[0usize] = h2.Header { name: "x-trail", value: "last" }
            trail[1usize] = h2.Header { name: "x-trail-bin", value: trail_value }
            ret finish(app, out, at, id, grpc.OK, "", trail[0usize..2usize])
        }
        if slot.kind == K_BIG {
            var i = 0usize
            let n = 70000usize

            app.big[0usize] = 0u8
            app.big[1usize] = u8((n >> 24usize) & 255usize)
            app.big[2usize] = u8((n >> 16usize) & 255usize)
            app.big[3usize] = u8((n >> 8usize) & 255usize)
            app.big[4usize] = u8(n & 255usize)
            while i < n {
                app.big[5usize + i] = u8((i * 7usize) & 255usize)
                i += 1usize
            }
            slot.big_len = 5usize + n
            slot.big_at = 0usize
            slot.pending = true
            ret pump(app, out, at, j)
        }
        if slot.kind == K_GZIP {
            var meta: [1]h2.Header = zero
            meta[0usize] = h2.Header { name: "grpc-encoding", value: "gzip" }
            let (hn, he) = gs.response_headers(app.srv, out[*at..], id, meta[0usize..1usize])
            if he != ok { ret he }
            *at += hn
            var body: [256]u8 = zero
            let n = gzip_body(body[0usize..])
            let e = say(app, out, at, id, body[0usize..n], true)
            if e != ok { ret e }
            ret finish(app, out, at, id, grpc.OK, "", none)
        }
        if slot.kind == K_STATUS {
            let e = say(app, out, at, id, "partial", false)
            if e != ok { ret e }
            ret finish(app, out, at, id, grpc.RESOURCE_EXHAUSTED, "quota ☃ exceeded", none)
        }
        if slot.kind == K_SSTREAM {
            var k = 0usize
            while k < 3usize {
                var body: [128]u8 = zero
                var i = 0usize
                while i < ev.payload.len && i + 1usize < body.len {
                    body[i] = ev.payload[i]
                    i += 1usize
                }
                body[ev.payload.len] = u8(k)
                let e = say(app, out, at, id, body[0usize..ev.payload.len + 1usize], false)
                if e != ok { ret e }
                k += 1usize
            }
            ret finish(app, out, at, id, grpc.OK, "", none)
        }
        if slot.kind == K_CSTREAM {
            if slot.acc_len > 0usize {
                app.acc[slot.acc_len] = 124u8
                slot.acc_len += 1usize
            }
            var i = 0usize
            while i < ev.payload.len {
                app.acc[slot.acc_len + i] = ev.payload[i]
                i += 1usize
            }
            slot.acc_len += ev.payload.len
            ret ok
        }
        if slot.kind == K_BIDI {
            var body: [256]u8 = zero
            upper_into(body[0usize..], ev.payload)
            ret say(app, out, at, id, body[0usize..ev.payload.len], false)
        }
        if slot.kind == K_BIGREQ {
            var body: [20]u8 = zero
            let n = decimal_into(body[0usize..], ev.payload.len)
            let e = say(app, out, at, id, body[0usize..n], false)
            if e != ok { ret e }
            ret finish(app, out, at, id, grpc.OK, "", none)
        }
        ret ok
    }
    if ev.kind == gs.EVENT_HALF_CLOSE {
        if slot.kind == K_CSTREAM {
            let e = say(app, out, at, ev.stream, app.acc[0usize..slot.acc_len], false)
            if e != ok { ret e }
            ret finish(app, out, at, ev.stream, grpc.OK, "", none)
        }
        if slot.kind == K_BIDI { ret finish(app, out, at, ev.stream, grpc.OK, "", none) }
        ret ok
    }
    ret ok
}


type Replay = struct { requests: str, response: []u8 }

// Run the service over the client's bytes, delivered `chunk` at a time.
fn replay(a: *mem.Arena, chunk: usize, data: []const u8) -> Replay {
    let (calls, ce) = mem.alloc[gs.Call](a, 4usize)
    if ce != ok { os.exit(100i32) }
    var c = 0usize
    while c < calls.len {
        let (buf, be) = mem.alloc[u8](a, 131072usize)
        if be != ok { os.exit(101i32) }
        calls[c].buf = buf
        c += 1usize
    }
    let (enc_data, e1) = mem.alloc[u8](a, 8192usize)
    let (enc_lens, e2) = mem.alloc[u32](a, 256usize)
    let (dec_data, e3) = mem.alloc[u8](a, 8192usize)
    let (dec_lens, e4) = mem.alloc[u32](a, 256usize)
    let (block, e5) = mem.alloc[u8](a, 16384usize)
    let (out, e6) = mem.alloc[u8](a, 262144usize)
    let (total, e7) = mem.alloc[u8](a, 400000usize)
    let (scratch, e8) = mem.alloc[u8](a, 16384usize)
    let (events, e9) = mem.alloc[gs.Event](a, 32usize)
    let (hdr, e10) = mem.alloc[h2.Header](a, 128usize)
    let (acc, e11) = mem.alloc[u8](a, 4096usize)
    let (big, e12) = mem.alloc[u8](a, 70016usize)
    let (slots, e13) = mem.alloc[Slot](a, 6usize)
    if e1 != ok || e2 != ok || e3 != ok || e4 != ok || e5 != ok || e6 != ok || e7 != ok || e8 != ok || e9 != ok || e10 != ok || e11 != ok || e12 != ok || e13 != ok { os.exit(102i32) }
    var s = gs.server_new(calls, h2.table_new(enc_data, enc_lens, 4096usize), h2.table_new(dec_data, dec_lens, 4096usize), block, 65535u32, 16384u32)
    var z = 0usize
    while z < slots.len {
        slots[z].used = false
        z += 1usize
    }
    var app = App { srv: &s, slots: slots, acc: acc, big: big }
    var total_len = 0usize
    let (start_len, start_error) = gs.server_start(&s, out)
    if start_error != ok { os.exit(103i32) }
    mem.copy[u8](total[0usize..start_len], out[0usize..start_len])
    total_len = start_len
    var text = ""
    var first = true
    var start = 0usize
    var have = 0usize
    while true {
        have += chunk
        if have > data.len { have = data.len }
        while true {
            let (used, out_n, count, rx) = gs.server_receive(&s, data[start..have], out, events, hdr, scratch)
            if rx != ok {
                text = cat(a, text, "!rx")
                have = data.len
                break
            }
            var at = out_n
            var k = 0usize
            while k < count {
                if !first { text = cat(a, text, "|") }
                first = false
                text = cat(a, text, render_server_event(a, events[k]))
                let ae = app_event(&app, events[k], out, &at)
                if ae != ok { text = cat(a, text, "!app") }
                k += 1usize
            }
            let pe = pump_all(&app, out, &at)
            if pe != ok { text = cat(a, text, "!pump") }
            if total_len + at > total.len { os.exit(104i32) }
            mem.copy[u8](total[total_len..total_len + at], out[0usize..at])
            total_len += at
            start += used
            if used == 0usize && count == 0usize { break }
        }
        if have == data.len { break }
    }
    ret Replay { requests: text, response: total[0usize..total_len] }
}

fn run_one(a: *mem.Arena, line: str) -> bool {
    var rest = line
    let kind = field(&rest)
    if str.eq(kind, "S") {
        let name = field(&rest)
        let path = unhex(a, field(&rest))
        let chunk = usize(num(field(&rest)))
        let data = unhex(a, field(&rest))
        let want_requests = field(&rest)
        let want_response = field(&rest)
        let r = replay(a, chunk, data)
        let got_response = read_back(a, path, r.response)
        var good = true
        if !str.eq(r.requests, want_requests) {
            good = false
            var n = r.requests.len
            if n > 120usize { n = 120usize }
            let shown = io.print(cat(a, cat(a, cat(a, name, " requests: "), r.requests[0usize..n]), "\n"))
        }
        if !str.eq(got_response, want_response) {
            good = false
            var n = got_response.len
            if n > 160usize { n = 160usize }
            let shown = io.print(cat(a, cat(a, cat(a, name, " response: "), got_response[0usize..n]), "\n"))
        }
        ret good
    }
    ret false
}

