// `e.fmt.brotli`: streams from the reference encoder (Python `brotli`, mirrored in
// gen_fixture.py beside ref.py in the scratch directory) decoded back over caller
// storage: a 296-byte English text at quality 11 (29 static-dictionary references
// through 13 transforms) at the default window and at WBITS 10, a 4 KB LCG buffer
// with runs and repeats at quality 5, 512 incompressible bytes at quality 0 (an
// uncompressed meta-block), the empty stream, a 19,490-byte counted text in five
// flush-separated meta-blocks at quality 9 with WBITS 18, and two 20-24 KB mixed
// texts at quality 11 whose encodings switch literal and command block types. Then
// the refusals: a truncated stream and a trailing byte are `Malformed`, a short
// destination or scratch is `TooSmall`. Every check has its own exit code.
use e.fmt.brotli as brotli
use e.io
use e.mem
use e.os

fn bytes_equal(a: []const u8, b: []const u8) -> bool {
    if a.len != b.len { ret false }
    var i = 0usize
    while i < a.len {
        if a[i] != b[i] { ret false }
        i += 1usize
    }
    ret true
}

fn fnv1a(data: []const u8) -> u32 {
    var h = 2166136261u32
    var i = 0usize
    while i < data.len {
        h = (h ^ u32(data[i])) *% 16777619u32
        i += 1usize
    }
    ret h
}

fn lcg(state: *u64) -> u64 {
    *state = *state *% 6364136223846793005u64 +% 1442695040888963407u64
    ret *state >> 33u32
}

// Mirrors lcg_gen(n): runs, copies of earlier bytes, and literals.
fn generate(out: []u8, n: usize) -> usize {
    var len = 0usize
    var state = 42u64
    while len < n {
        let r = lcg(&state)
        let kind = r % 4u64
        if kind == 0u64 {
            let v = u8(lcg(&state) & 255u64)
            let count = 8usize + usize(r % 40u64)
            var k = 0usize
            while k < count {
                out[len + k] = v
                k += 1usize
            }
            len += count
        } else if kind == 1u64 && len > 16usize {
            let start = usize((r >> 8u32) % u64(len - 8usize))
            var count = 16usize + usize((r >> 4u32) % 48u64)
            if start + count > len { count = len - start }
            var k = 0usize
            while k < count {
                out[len + k] = out[start + k]
                k += 1usize
            }
            len += count
        } else {
            let count = 1usize + usize(r % 3u64)
            var k = 0usize
            while k < count {
                out[len + k] = u8(lcg(&state) & 15u64)
                k += 1usize
            }
            len += count
        }
    }
    ret n
}

// Mirrors lcgbytes(n, seed).
fn noise(out: []u8, n: usize, seed: u64) {
    var state = seed
    var i = 0usize
    while i < n {
        out[i] = u8(lcg(&state) & 255u64)
        i += 1usize
    }
}

fn put_text(out: []u8, n0: usize, s: str) -> usize {
    var n = n0
    var i = 0usize
    while i < s.len {
        out[n] = s[i]
        n += 1usize
        i += 1usize
    }
    ret n
}

fn put_dec(out: []u8, n0: usize, v0: usize) -> usize {
    var digits: [8]u8 = zero
    var k = 0usize
    var v = v0
    if v == 0usize {
        digits[0] = 48u8
        k = 1usize
    }
    while v > 0usize {
        digits[k] = u8(48usize + v % 10usize)
        k += 1usize
        v = v / 10usize
    }
    var n = n0
    while k > 0usize {
        k -= 1usize
        out[n] = digits[k]
        n += 1usize
    }
    ret n
}

// "sentence %d of the long text says brotli works. " for 0..399: 19,490 bytes.
fn sentences(out: []u8) -> usize {
    var n = 0usize
    var i = 0usize
    while i < 400usize {
        n = put_text(out, n, "sentence ")
        n = put_dec(out, n, i)
        n = put_text(out, n, " of the long text says brotli works. ")
        i += 1usize
    }
    ret n
}

// Six 3,000-byte slices of the sentences, each followed by `nq` bytes of 4-valued
// noise (quad, seed i+1) or by 1,000 bytes of the LCG buffer.
fn mixed(out: []u8, big: []const u8, buf: []const u8, quad: bool) -> usize {
    var n = 0usize
    var i = 0usize
    var tmp: [400]u8 = zero
    while i < 6usize {
        var k = 0usize
        while k < 3000usize {
            out[n] = big[i * 3000usize + k]
            n += 1usize
            k += 1usize
        }
        if quad {
            noise(tmp[..], 400usize, u64(i) + 1u64)
            k = 0usize
            while k < 400usize {
                out[n] = tmp[k] & 3u8
                n += 1usize
                k += 1usize
            }
        } else {
            k = 0usize
            while k < 1000usize {
                out[n] = buf[i * 1000usize + k]
                n += 1usize
                k += 1usize
            }
        }
        i += 1usize
    }
    ret n
}

fn main(a: *mem.Arena, args: []str) -> err {
    let (scratch, ea) = mem.alloc[u8](a, brotli.decode_scratch_required())
    let (out, eb) = mem.alloc[u8](a, 32768usize)
    let (expect, ec) = mem.alloc[u8](a, 32768usize)
    let (big, ed) = mem.alloc[u8](a, 32768usize)
    let (buf, ee) = mem.alloc[u8](a, 8192usize)
    if ea != ok || eb != ok || ec != ok || ed != ok || ee != ok { os.exit(99i32) }

    // 1: window bits.
    let (w1, e1) = brotli.window_bits(stream_text())
    if e1 != ok || w1 != 22u32 { os.exit(1i32) }
    let (w1b, e1b) = brotli.window_bits(stream_text_w10())
    if e1b != ok || w1b != 10u32 { os.exit(1i32) }
    let (w1c, e1c) = brotli.window_bits(stream_big())
    if e1c != ok || w1c != 18u32 { os.exit(1i32) }

    // 2, 3: the text through the dictionary at two windows.
    let (n2, e2) = brotli.decode(stream_text(), out, scratch)
    if e2 != ok || !bytes_equal(out[..n2], text()) { os.exit(2i32) }
    let (n3, e3) = brotli.decode(stream_text_w10(), out, scratch)
    if e3 != ok || !bytes_equal(out[..n3], text()) { os.exit(3i32) }

    // 4: the LCG buffer.
    let _ = generate(buf, 8192usize)
    if fnv1a(buf[..4096usize]) != 421437064u32 { os.exit(4i32) }
    let (n4, e4) = brotli.decode(stream_lcg(), out, scratch)
    if e4 != ok || !bytes_equal(out[..n4], buf[..4096usize]) { os.exit(5i32) }

    // 5: an uncompressed meta-block.
    noise(expect, 512usize, 7u64)
    if fnv1a(expect[..512usize]) != 1579702930u32 { os.exit(6i32) }
    let (n5, e5) = brotli.decode(stream_rnd(), out, scratch)
    if e5 != ok || !bytes_equal(out[..n5], expect[..512usize]) { os.exit(7i32) }

    // 6: the empty stream.
    let (n6, e6) = brotli.decode(stream_empty(), out, scratch)
    if e6 != ok || n6 != 0usize { os.exit(8i32) }

    // 7: five meta-blocks.
    let nb = sentences(big)
    if nb != 19490usize || fnv1a(big[..nb]) != 3896476999u32 { os.exit(9i32) }
    let (n7, e7) = brotli.decode(stream_big(), out, scratch)
    if e7 != ok || !bytes_equal(out[..n7], big[..nb]) { os.exit(10i32) }

    // 8, 9: block switches.
    let na = mixed(expect, big[..nb], buf, true)
    if na != 20400usize || fnv1a(expect[..na]) != 2980514622u32 { os.exit(11i32) }
    let (n8, e8) = brotli.decode(stream_mixed_a(), out, scratch)
    if e8 != ok || !bytes_equal(out[..n8], expect[..na]) { os.exit(12i32) }
    let nc = mixed(expect, big[..nb], buf, false)
    if nc != 24000usize || fnv1a(expect[..nc]) != 3565025410u32 { os.exit(13i32) }
    let (n9, e9) = brotli.decode(stream_mixed_b(), out, scratch)
    if e9 != ok || !bytes_equal(out[..n9], expect[..nc]) { os.exit(14i32) }

    // 10: refusals.
    let (_, e10) = brotli.decode(stream_text()[..60usize], out, scratch)
    if e10 != brotli.Malformed { os.exit(15i32) }
    let (_, e11) = brotli.decode(stream_text(), out[..100usize], scratch)
    if e11 != brotli.TooSmall { os.exit(16i32) }
    let (_, e12) = brotli.decode(stream_text(), out, scratch[..1000usize])
    if e12 != brotli.TooSmall { os.exit(17i32) }
    var trailing: [2]u8 = zero
    let se = stream_empty()
    trailing[0] = se[0]
    let (_, e13) = brotli.decode(trailing[..], out, scratch)
    if e13 != brotli.Malformed { os.exit(18i32) }
    let (_, e14) = brotli.decode(out[..0usize], out, scratch)
    if e14 != brotli.Malformed { os.exit(19i32) }

    try io.print("fmt brotli ok\n")
    ret ok
}

