fn text_is(a: str, b: str) -> bool {
    if a.len != b.len { ret false }
    var i = 0usize
    while i < a.len {
        if a[i] != b[i] { ret false }
        i += 1usize
    }
    ret true
}

fn tok(line: str, at: usize) -> (str, usize) {
    var p = at
    while p < line.len && line[p] == 32u8 { p += 1usize }
    let start = p
    while p < line.len && line[p] != 32u8 { p += 1usize }
    ret (line[start..p], p)
}

fn dec(s: str) -> i64 {
    var v = 0i64
    var neg = false
    var i = 0usize
    if s.len > 0usize && s[0usize] == 45u8 {
        neg = true
        i = 1usize
    }
    while i < s.len {
        v = v * 10i64 + i64(s[i] - 48u8)
        i += 1usize
    }
    if neg { ret 0i64 - v }
    ret v
}


fn hexval(c: u8) -> u8 {
    if c >= 97u8 { ret c - 87u8 }
    ret c - 48u8
}

fn unhex(s: str, out: []u8) -> usize {
    if s.len == 1usize && s[0usize] == 45u8 { ret 0usize }
    var i = 0usize
    while i + 1usize < s.len {
        out[i / 2usize] = hexval(s[i]) * 16u8 + hexval(s[i + 1usize])
        i += 2usize
    }
    ret s.len / 2usize
}

fn same_bytes(got: str, want: []const u8) -> bool {
    if got.len != want.len { ret false }
    var i = 0usize
    while i < got.len {
        if got[i] != want[i] { ret false }
        i += 1usize
    }
    ret true
}

fn check_line(line: str) -> u8 {
    var input: [256]u8 = zero
    var buf: [512]u8 = zero
    var words: [16]str = zero
    var tmp: [512]u8 = zero
