    if tight != bidi.TooSmall { os.exit(32i32) }
    let (_, bad) = bidi.resolve_levels(probe[..], 2i8, levels[..], scratch[..])
    if bad != bidi.Invalid { os.exit(33i32) }
    if bidi.reorder(levels[..3usize], 0usize, 3usize, order[..2usize]) != bidi.TooSmall { os.exit(34i32) }
    if bidi.reorder(levels[..3usize], 2usize, 1usize, order[..]) != bidi.Invalid { os.exit(35i32) }
    let data = cases()
    var pos = 0usize
    var k = 0i32
    while pos < data.len {
        let n = usize(data[pos])
        let direction = data[pos + 1usize]
        let expect_para = data[pos + 2usize]
        pos += 3usize
        var i = 0usize
        while i < n {
            text[i] = u32(data[pos]) | (u32(data[pos + 1usize]) << 8u32) | (u32(data[pos + 2usize]) << 16u32)
            pos += 3usize
            i += 1usize
        }
        var expect_hash = 0u64
        i = 0usize
        while i < 8usize {
            expect_hash |= u64(data[pos + i]) << u32(8usize * i)
            i += 1usize
        }
        pos += 8usize
        var base_level = -1i8
        if direction == 0u8 { base_level = 0i8 }
        if direction == 1u8 { base_level = 1i8 }
        let (para, resolve_error) = bidi.resolve_levels(text[..n], base_level, levels[..n], scratch[..6usize * n])
        if resolve_error != ok || para != expect_para { os.exit(100i32 + k) }
        if bidi.reorder_line(text[..n], levels[..n], para, 0usize, n, order[..n]) != ok { os.exit(100i32 + k) }
        var h = 14695981039346656037u64
        i = 0usize
        while i < n {
            if !removed(bidi.class_of(text[i])) { h = fnv(h, levels[i]) }
            i += 1usize
        }
        h = fnv(h, 255u8)
        i = 0usize
        while i < n {
            let logical = order[i]
            if !removed(bidi.class_of(text[logical])) { h = fnv(h, u8(logical & 255usize)) }
            i += 1usize
