const OUT_CAP: usize = 24576usize
type Out = struct { buf: [24576]u8, n: usize }

fn put(o: *Out, c: u8) {
    if o.n < OUT_CAP {
        o.buf[o.n] = c
        o.n += 1usize
    }
}

fn put_str(o: *Out, s: str) {
    var i = 0usize
    while i < s.len {
        put(o, s[i])
        i += 1usize
    }
}

fn put_bytes(o: *Out, s: []const u8) {
    var i = 0usize
    while i < s.len {
        put(o, s[i])
        i += 1usize
    }
}

fn put_num(o: *Out, v: usize) {
    var digits: [20]u8 = zero
    var n = 0usize
    var x = v
    if x == 0usize {
        digits[0usize] = 48u8
        n = 1usize
    }
    while x > 0usize {
        digits[n] = 48u8 + u8(x % 10usize)
        n += 1usize
        x = x / 10usize
    }
    while n > 0usize {
        n -= 1usize
        put(o, digits[n])
    }
}

fn parse_num(s: str) -> usize {
    var v = 0usize
    var i = 0usize
    while i < s.len {
        if s[i] >= 48u8 && s[i] <= 57u8 { v = v * 10usize + usize(s[i] - 48u8) }
        i += 1usize
    }
    ret v
}

// Splits `s` at `sep` into pieces (start, end) of the original; returns how many.
fn split(s: str, sep: u8, ps: []usize, pe: []usize) -> usize {
    var n = 0usize
    var start = 0usize
    var i = 0usize
    while i <= s.len {
        if i == s.len || s[i] == sep {
            if n < ps.len {
                ps[n] = start
                pe[n] = i
                n += 1usize
            }
            start = i + 1usize
        }
        i += 1usize
    }
    ret n
}

fn put_tokens(o: *Out, e: *ce.Editor) {
    var toks: [128]ce.Token = zero
    var ln = 0usize
    while ln < ce.line_count(e) {
        if ln > 0usize { put(o, 124u8) }
        let n = ce.tokens(e, ln, toks[..])
        var t = 0usize
        while t < n && t < 128usize {
            if t > 0usize { put(o, 32u8) }
            put_num(o, usize(toks[t].kind))
            put(o, 58u8)
            put_num(o, toks[t].start)
            put(o, 45u8)
            put_num(o, toks[t].end)
            t += 1usize
        }
        ln += 1usize
    }
}

fn put_folds(o: *Out, e: *const ce.Editor, view: usize) {
    let n = ce.fold_count(e, view)
    if n == 0usize { put(o, 45u8) }
    var k = 0usize
    while k < n {
        if k > 0usize { put(o, 44u8) }
        let f = ce.fold_get(e, view, k)
        put_num(o, f.from)
        put(o, 45u8)
        put_num(o, f.to)
        k += 1usize
    }
}

fn put_hidden(o: *Out, e: *const ce.Editor, view: usize) {
    var any = false
    var ln = 0usize
    while ln < ce.line_count(e) {
        if ce.line_hidden(e, view, ln) {
            if any { put(o, 44u8) }
            any = true
            put_num(o, ln)
        }
        ln += 1usize
    }
    if !any { put(o, 45u8) }
}

fn put_set(o: *Out, s: *const ce.CompletionSet) {
    put_num(o, s.n)
    if s.incomplete { put(o, 105u8) }
    if s.valid { put(o, 118u8) }
    put(o, 124u8)
    var i = 0usize
    while i < s.n {
        if i > 0usize { put(o, 32u8) }
        put_bytes(o, ce.completion_label(s, i))
        put(o, 47u8)
        put_num(o, usize(s.items[i].score))
        put(o, 47u8)
        put_num(o, usize(s.items[i].kind))
        i += 1usize
    }
}

fn put_diags(o: *Out, e: *const ce.Editor) {
    let (er, wa, ot) = ce.diag_counts(e)
    put_num(o, ce.diag_count(e))
    put(o, 47u8)
    put_num(o, er)
    put(o, 47u8)
    put_num(o, wa)
    put(o, 47u8)
    put_num(o, ot)
    put(o, 124u8)
    var i = 0usize
    while i < ce.diag_count(e) {
        if i > 0usize { put(o, 32u8) }
        let d = ce.diag_get(e, i)
        put_num(o, d.from)
        put(o, 45u8)
        put_num(o, d.to)
        put(o, 58u8)
        put_num(o, usize(d.severity))
        put(o, 58u8)
        put_num(o, usize(d.code))
        put(o, 58u8)
        put_num(o, usize(d.source))
        put(o, 58u8)
        put_bytes(o, ce.diag_message(e, i))
        i += 1usize
    }
}

fn put_index(o: *Out, i: usize) {
    if i == ce.NO_GOAL { put(o, 45u8) } else { put_num(o, i) }
}

fn run_wrap(a: *mem.Arena, e: *ce.Editor, o: *Out, src: str, fs: []const usize, fe: []const usize) {
    let width = parse_num(src[fs[3usize]..fe[3usize]])
    e.tab_width = parse_num(src[fs[4usize]..fe[4usize]])
    let start = parse_num(src[fs[5usize]..fe[5usize]])
    if ce.attach_views(e, a, 1usize, 8usize) != ok { os.exit(253i32) }
    let fl = src[fs[6usize]..fe[6usize]]
    var ps: [16]usize = zero
    var pe: [16]usize = zero
    let nf = split(fl, 44u8, ps[..], pe[..])
    var k = 0usize
    while k < nf {
        if pe[k] > ps[k] && fl[ps[k]] != 45u8 {
            if ce.fold_collapse(e, 0usize, parse_num(fl[ps[k]..pe[k]])) != ok { put(o, 33u8) }
        }
        k += 1usize
    }
    var one: [1]ce.Range = zero
    one[0usize] = ce.Range { anchor: start, head: start, goal: ce.NO_GOAL }
    if ce.set_selection(e, one[0usize..1usize], 0usize) != ok { os.exit(254i32) }
    let moves = src[fs[7usize]..fe[7usize]]
    var m = 0usize
    while m < moves.len {
        let c = moves[m]
        var lower = c
        var extend = false
        if c >= 65u8 && c <= 90u8 {
            lower = c + 32u8
            extend = true
        }
        var dir = 0u32
        if lower == 117u8 { dir = ce.MOVE_UP }
        if lower == 100u8 { dir = ce.MOVE_DOWN }
        if lower == 115u8 { dir = ce.MOVE_ROW_START }
        if lower == 101u8 { dir = ce.MOVE_ROW_END }
        if lower == 108u8 { dir = ce.MOVE_LEFT }
        if lower == 114u8 { dir = ce.MOVE_RIGHT }
        if ce.move_wrapped(e, dir, extend, width, 0usize) != ok { put(o, 33u8) }
        if m > 0usize { put(o, 32u8) }
        put_num(o, e.sels[0usize].head)
        put(o, 46u8)
        put_num(o, e.sels[0usize].anchor)
        m += 1usize
    }
}

// Edits "E<at>:<remove>:<text>" (the text is the rest of the field).
fn edit_of(o: *Out, e: *ce.Editor, f: str) -> err {
    var c1 = 1usize
    while c1 < f.len && f[c1] != 58u8 { c1 += 1usize }
    var c2 = c1 + 1usize
    while c2 < f.len && f[c2] != 58u8 { c2 += 1usize }
    let at = parse_num(f[1usize..c1])
    let rem = parse_num(f[c1 + 1usize..c2])
    var text: str = ""
    if c2 + 1usize <= f.len { text = f[c2 + 1usize..f.len] }
    var ed: [1]ce.Edit = zero
    ed[0usize] = ce.Edit { at: at, remove: rem, text_off: 0usize, text_len: text.len }
    ret ce.apply_edits(e, ed[0usize..1usize], text)
}

fn run_folds(a: *mem.Arena, e: *ce.Editor, o: *Out, src: str, fs: []const usize, fe: []const usize, nf: usize) {
    if ce.attach_views(e, a, 2usize, 6usize) != ok { os.exit(253i32) }
    var f = 3usize
    while f < nf {
        let op = src[fs[f]..fe[f]]
        var res = ok
        var dropped = 0usize
        if op.len > 0usize {
            let c = op[0usize]
            if c == 67u8 {
                // C<view>.<line>
                res = ce.fold_collapse(e, parse_num(op[1usize..2usize]), parse_num(op[3usize..op.len]))
            } else if c == 88u8 {
                if !ce.fold_expand(e, parse_num(op[1usize..2usize]), parse_num(op[3usize..op.len])) { res = ce.NoFold }
            } else if c == 69u8 {
                res = edit_of(o, e, op)
            } else if c == 90u8 {
                res = ce.undo(e)
            } else if c == 89u8 {
                res = ce.redo(e)
            } else if c == 82u8 {
                dropped = ce.fold_refresh(e, parse_num(op[1usize..op.len]))
            } else if c == 65u8 {
                res = ce.fold_collapse_all(e, parse_num(op[1usize..op.len]))
            }
        }
        if f > 3usize { put(o, 124u8) }
        if dropped > 0usize { put(o, 100u8) }
        if res != ok { put(o, 33u8) }
        put_folds(o, e, 0usize)
        put(o, 59u8)
        put_folds(o, e, 1usize)
        put(o, 59u8)
        put_hidden(o, e, 0usize)
        f += 1usize
    }
}

