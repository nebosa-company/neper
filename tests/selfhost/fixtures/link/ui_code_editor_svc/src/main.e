    var k = 0usize
    while k < np {
        let rp = parse_num(refines[ps[k]..pe[k]])
        put(o, 62u8)
        let good = ce.completion_refine(e, &set, rp)
        if !good { put(o, 126u8) }
        put_set(o, &set)
        k += 1usize
    }
}

fn run_diag(a: *mem.Arena, e: *ce.Editor, o: *Out, src: str, fs: []const usize, fe: []const usize, nf: usize) {
    if ce.attach_diagnostics(e, a, 12usize, 256usize) != ok { os.exit(253i32) }
    var f = 3usize
    while f < nf {
        let op = src[fs[f]..fe[f]]
        var res = ok
        var query = false
        var qv = 0usize
        if op.len > 0usize {
            let c = op[0usize]
            if c == 80u8 {
                // P<source>:<stale>:<from>-<to>-<sev>-<code>-<msg>;...
                var c1 = 1usize
                while c1 < op.len && op[c1] != 58u8 { c1 += 1usize }
                var c2 = c1 + 1usize
                while c2 < op.len && op[c2] != 58u8 { c2 += 1usize }
                let source = u32(parse_num(op[1usize..c1]))
                let stale = parse_num(op[c1 + 1usize..c2])
                var items: [12]ce.Diagnostic = zero
                var text: [256]u8 = zero
                var nt = 0usize
                var ni = 0usize
                if c2 + 1usize < op.len {
                    let body = op[c2 + 1usize..op.len]
                    var ips: [12]usize = zero
                    var ipe: [12]usize = zero
                    let cnt = split(body, 59u8, ips[..], ipe[..])
                    var q = 0usize
                    while q < cnt {
                        let it = body[ips[q]..ipe[q]]
                        var dp: [5]usize = zero
                        var de: [5]usize = zero
                        let nd = split(it, 45u8, dp[..], de[..])
                        if nd >= 5usize {
                            let msg = it[dp[4usize]..it.len]
                            var m = 0usize
                            while m < msg.len {
                                text[nt + m] = msg[m]
                                m += 1usize
                            }
                            items[ni] = ce.Diagnostic { from: parse_num(it[dp[0usize]..de[0usize]]), to: parse_num(it[dp[1usize]..de[1usize]]), severity: u32(parse_num(it[dp[2usize]..de[2usize]])), code: u32(parse_num(it[dp[3usize]..de[3usize]])), source: 0u32, msg_off: nt, msg_len: msg.len }
                            nt += msg.len
                            ni += 1usize
                        }
                        q += 1usize
                    }
                }
                res = ce.diag_publish(e, source, e.revision - u64(stale), items[0usize..ni], text[0usize..nt])
            } else if c == 69u8 {
                res = edit_of(o, e, op)
            } else if c == 67u8 {
                if op.len > 1usize && op[1usize] == 42u8 {
                    let dropped = ce.diag_clear(e, ce.NO_SOURCE)
                } else {
                    let dropped2 = ce.diag_clear(e, u32(parse_num(op[1usize..op.len])))
                }
            } else if c == 90u8 {
                res = ce.undo(e)
            } else if c == 89u8 {
                res = ce.redo(e)
            } else if c == 66u8 {
                var out: [12]ce.Diagnostic = zero
                let n = ce.lint_brackets(e, out[..])
                if n > 12usize {
                    res = ce.TooLarge
                } else {
                    var none: [1]u8 = zero
                    res = ce.diag_publish(e, ce.SRC_BRACKETS, e.revision, out[0usize..n], none[0usize..0usize])
                }
            } else if c == 74u8 {
                let (pos, bad) = ce.lint_json(e)
                var one: [1]ce.Diagnostic = zero
                var n = 0usize
                if bad {
                    var to = pos + 1usize
                    if to > ce.len(e) { to = pos }
                    one[0usize] = ce.Diagnostic { from: pos, to: to, severity: ce.SEV_ERROR, code: ce.LINT_JSON, source: ce.SRC_JSON, msg_off: 0usize, msg_len: 0usize }
                    n = 1usize
                }
                var none2: [1]u8 = zero
                res = ce.diag_publish(e, ce.SRC_JSON, e.revision, one[0usize..n], none2[0usize..0usize])
            } else if c == 81u8 {
                query = true
                qv = ce.diag_at(e, parse_num(op[1usize..op.len]))
            } else if c == 78u8 {
                var c1 = 1usize
                while c1 < op.len && op[c1] != 58u8 { c1 += 1usize }
                var c2 = c1 + 1usize
                while c2 < op.len && op[c2] != 58u8 { c2 += 1usize }
                query = true
                qv = ce.diag_next(e, parse_num(op[1usize..c1]), parse_num(op[c1 + 1usize..c2]) == 1usize, parse_num(op[c2 + 1usize..op.len]) == 1usize)
            }
        }
        if f > 3usize { put(o, 124u8) }
        if res != ok { put(o, 33u8) }
        if query {
            put(o, 113u8)
            put_index(o, qv)
            put(o, 59u8)
        }
        put_diags(o, e)
        f += 1usize
    }
}

fn run_case(a: *mem.Arena, e: *ce.Editor, o: *Out, fs: []const usize, fe: []const usize, nf: usize, src: str) {
    let doc = src[fs[0usize]..fe[0usize]]
    let id = src[fs[1usize]..fe[1usize]]
    let op = src[fs[2usize]]
    // Views and markers of the previous case lived in the arena the harness has since reset.
    var no_views: [1]ce.FoldView = zero
    var no_diags: [1]ce.Diagnostic = zero
    var no_bytes: [1]u8 = zero
    e.views = no_views[0usize..0usize]
    e.diag = ce.DiagSet { items: no_diags[0usize..0usize], n: 0usize, text: no_bytes[0usize..0usize], ntext: 0usize }
    if ce.load(e, doc) != ok { os.exit(250i32) }
    ce.set_language(e, ce.lang_by_id(id))
    e.tab_width = 4usize
    if op == 76u8 {
        put_tokens(o, e)
    } else if op == 73u8 {
        let r = ce.lang_id_for_suffix(id)
        if r.len == 0usize { put(o, 45u8) } else { put_str(o, r) }
    } else if op == 78u8 {
        let r2 = ce.lang_id_for_file_name(doc)
        if r2.len == 0usize { put(o, 45u8) } else { put_str(o, r2) }
    } else if op == 65u8 {
        if ce.lang_suffix_ambiguous(id) { put(o, 49u8) } else { put(o, 48u8) }
    } else if op == 86u8 {
        run_wrap(a, e, o, src, fs, fe)
    } else if op == 70u8 {
        run_folds(a, e, o, src, fs, fe, nf)
    } else if op == 75u8 {
        run_complete(a, e, o, src, fs, fe)
    } else if op == 71u8 {
        run_diag(a, e, o, src, fs, fe, nf)
    } else if op == 74u8 {
        let (pos, bad) = ce.lint_json(e)
        if bad { put_num(o, pos) } else { put(o, 45u8) }
    } else if op == 66u8 {
        var out: [64]ce.Diagnostic = zero
        let n = ce.lint_brackets(e, out[..])
        put_num(o, n)
        put(o, 124u8)
        var k = 0usize
        while k < n && k < 64usize {
            if k > 0usize { put(o, 32u8) }
            put_num(o, out[k].from)
            put(o, 58u8)
            put_num(o, usize(out[k].code))
            k += 1usize
        }
    }
}

fn main(a: *mem.Arena, args: []str) -> err {
    let (e0, oe) = ce.open(a, 4096usize, 200usize, 12usize, 8usize, 64usize, 2048usize)
    if oe != ok { os.exit(250i32) }
    var ed = e0
    let src = script()
    let want = expected()
    let base = a.off
    var out: Out = zero
    var wpos = 0usize
    var spos = 0usize
    var case_no = 0usize
    while case_no < CASES {
        var fs: [32]usize = zero
        var fe: [32]usize = zero
        var nf = 0usize
        var i = spos
        var start = spos
        var more = true
        while more {
            if i >= src.len || src[i] == 30u8 || src[i] == 31u8 {
                if nf < 32usize {
                    fs[nf] = start
                    fe[nf] = i
                    nf += 1usize
                }
                start = i + 1usize
                if i >= src.len || src[i] == 30u8 { more = false }
            }
            i += 1usize
        }
        spos = i
        var wend = wpos
        while wend < want.len && want[wend] != 30u8 { wend += 1usize }
        out.n = 0usize
        run_case(a, &ed, &out, fs[..], fe[..], nf, src)
        a.off = base
        var same = out.n == wend - wpos
        var k = 0usize
        while same && k < out.n {
            if out.buf[k] != want[wpos + k] { same = false }
            k += 1usize
        }
        if !same {
            var head: Out = zero
            put_str(&head, "case ")
            put_num(&head, case_no)
            put(&head, 32u8)
            put(&head, src[fs[2usize]])
            put_str(&head, "\n got: ")
            let (w1, e1) = os.write(os.stdout(), head.buf[0usize..head.n])
            let (w2, e2) = os.write(os.stdout(), out.buf[0usize..out.n])
            let (w3, e3) = os.write(os.stdout(), "\nwant: ")
            let (w4, e4) = os.write(os.stdout(), want[wpos..wend])
            let (w5, e5) = os.write(os.stdout(), "\n")
            os.exit(i32(1usize + case_no % 200usize))
        }
        wpos = wend + 1usize
        case_no += 1usize
    }
    let (w6, e6) = os.write(os.stdout(), "ui code editor svc ok\n")
    ret ok
}
