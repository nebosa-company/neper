// `e.fmt.mp4`: a four-sample av01 track built by hand (two chunks of two samples, stco and co64,
// composition offsets, sync samples 1 and 3) read back field by field, and the refusals: a
// fragmented file and an audio-only file (Unsupported), a missing moov, a truncated moov and a
// sample table pointing past the data (Invalid). Every check has its own exit code.
use e.os
use e.mem
use e.fmt.mp4 as mp4

fn same(a: []const u8, b: []const u8) -> bool {
    if a.len != b.len { ret false }
    var i = 0usize
    while i < a.len {
        if a[i] != b[i] { ret false }
        i += 1usize
    }
    ret true
}

// Checks one well-formed file: codec, picture, clock, four samples with their times, delays and sync marks.
fn check(a: *mem.Arena, d: []const u8, base: i32) -> i32 {
    let (v, e) = mp4.parse(a, d)
    if e != ok { ret base + 1i32 }
    if v.codec != mp4.fourcc(97u8, 118u8, 48u8, 49u8) { ret base + 2i32 }
    if v.width != 64u32 || v.height != 48u32 { ret base + 3i32 }
    if v.timescale != 1000u32 || v.duration != 4000u64 { ret base + 4i32 }
    if v.config.len != 4usize || v.config[0] != 129u8 { ret base + 5i32 }
    if v.samples.len != 4usize { ret base + 6i32 }
    let sizes: [4]u32 = [4]u32{ 4, 3, 5, 2 }
    var i = 0usize
    while i < 4usize {
        if v.samples[i].size != sizes[i] { ret base + 7i32 }
        if v.samples[i].time != u64(i) * 1000u64 { ret base + 8i32 }
        i += 1usize
    }
    if v.samples[3].delay != 2000i32 || v.samples[0].delay != 0i32 { ret base + 9i32 }
    if !v.samples[0].sync || v.samples[1].sync || !v.samples[2].sync || v.samples[3].sync { ret base + 10i32 }
    let (s0, e0) = mp4.bytes_of(d, &v, 0usize)
    if e0 != ok || !same(s0, "AAAA") { ret base + 11i32 }
    let (s2, e2) = mp4.bytes_of(d, &v, 2usize)
    if e2 != ok || !same(s2, "CCCCC") { ret base + 12i32 }
    let (s3, e3) = mp4.bytes_of(d, &v, 3usize)
    if e3 != ok || !same(s3, "DD") { ret base + 13i32 }
    let (none, en) = mp4.bytes_of(d, &v, 4usize)
    if en != mp4.Invalid || none.len != 0usize { ret base + 14i32 }
    ret 0i32
}

