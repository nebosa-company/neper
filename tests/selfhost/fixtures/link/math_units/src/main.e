    if count_6_error != ok || count_6 != 15usize { try report("family-count", 6usize) }
    let (_, small_count_error) = units.family_units(&reg, units.LENGTH, members[..5usize])
    if small_count_error != units.TooSmall { try report("family-units-room", 0usize) }
    let (no_count, no_count_error) = units.family_units(&reg, 99u32, members[..])
    if no_count_error != ok || no_count != 0usize { try report("family-none", 0usize) }
    if !units.same(units.family_name(units.TEMPERATURE), "temperature") || !units.same(units.family_name(units.DATA), "data") || units.family_name(55u32).len != 0usize { try report("family-name", 0usize) }
    let pi = 3.141592653589793f64
    let custom_ok = units.register(&reg, units.Unit { symbol: "rad", name: "radian", family: 101u32, scale: 1.0f64, offset: 0.0f64 })
    let custom_deg = units.register(&reg, units.Unit { symbol: "deg", name: "degree", family: 101u32, scale: pi / 180.0f64, offset: 0.0f64 })
    let custom_grad = units.register(&reg, units.Unit { symbol: "grad", name: "gradian", family: 101u32, scale: pi / 200.0f64, offset: 0.0f64 })
    if custom_ok != ok || custom_deg != ok || custom_grad != ok || reg.count != 82usize { try report("register", 0usize) }
    let (deg_rad, deg_rad_error) = units.convert(&reg, 180.0f64, "deg", "rad")
    let (grad_deg, grad_deg_error) = units.convert(&reg, 100.0f64, "grad", "deg")
    if deg_rad_error != ok || !close(deg_rad, pi, 0.0f64) || grad_deg_error != ok || !close(grad_deg, 90.0f64, 0.0f64) { try report("custom-convert", 0usize) }
    let (angle_count, angle_error) = units.family_units(&reg, 101u32, members[..])
    if angle_error != ok || angle_count != 3usize || members[0usize] != 79usize { try report("custom-family", 0usize) }
    let (_, angle_length) = units.convert(&reg, 1.0f64, "deg", "m")
    let (_, length_angle) = units.convert(&reg, 1.0f64, "m", "rad")
    if angle_length != units.Incompatible || length_angle != units.Incompatible { try report("incompatible", 0usize) }
    let (_, mass_time) = units.convert(&reg, 1.0f64, "kg", "s")
    let (_, temp_data) = units.convert(&reg, 1.0f64, "C", "B")
    if mass_time != units.Incompatible || temp_data != units.Incompatible { try report("incompatible", 1usize) }
    let dup = units.register(&reg, units.Unit { symbol: "m", name: "again", family: 1u32, scale: 1.0f64, offset: 0.0f64 })
    let dup_custom = units.register(&reg, units.Unit { symbol: "rad", name: "again", family: 101u32, scale: 1.0f64, offset: 0.0f64 })
    if dup != units.Duplicate || dup_custom != units.Duplicate { try report("duplicate", 0usize) }
    let nan = 0.0f64 / zero_f64()
    let inf = 1.0f64 / zero_f64()
    let bad_0 = units.register(&reg, units.Unit { symbol: "", name: "x", family: 9u32, scale: 1.0f64, offset: 0.0f64 })
    if bad_0 != units.Invalid { try report("empty-symbol", 0usize) }
    let bad_1 = units.register(&reg, units.Unit { symbol: "z1", name: "x", family: 0u32, scale: 1.0f64, offset: 0.0f64 })
    if bad_1 != units.Invalid { try report("family-zero", 0usize) }
    let bad_2 = units.register(&reg, units.Unit { symbol: "z2", name: "x", family: 9u32, scale: 0.0f64, offset: 0.0f64 })
    if bad_2 != units.Invalid { try report("scale-zero", 0usize) }
    let bad_3 = units.register(&reg, units.Unit { symbol: "z3", name: "x", family: 9u32, scale: nan, offset: 0.0f64 })
    if bad_3 != units.Invalid { try report("scale-nan", 0usize) }
    let bad_4 = units.register(&reg, units.Unit { symbol: "z4", name: "x", family: 9u32, scale: inf, offset: 0.0f64 })
    if bad_4 != units.Invalid { try report("scale-inf", 0usize) }
    let bad_5 = units.register(&reg, units.Unit { symbol: "z5", name: "x", family: 9u32, scale: 1.0f64, offset: nan })
    if bad_5 != units.Invalid { try report("offset-nan", 0usize) }
    let bad_6 = units.register(&reg, units.Unit { symbol: "z6", name: "x", family: 9u32, scale: 1.0f64, offset: inf })
    if bad_6 != units.Invalid { try report("offset-inf", 0usize) }
    if reg.count != 82usize { try report("register-rejected-grew", 0usize) }
    let (_, unknown_from) = units.convert(&reg, 1.0f64, "parsecs", "m")
    let (_, unknown_to) = units.convert(&reg, 1.0f64, "m", "furlong")
    let (_, unknown_case) = units.convert(&reg, 1.0f64, "M", "m")
    let (_, unknown_empty) = units.convert(&reg, 1.0f64, "", "m")
    if unknown_from != units.Unknown || unknown_to != units.Unknown || unknown_case != units.Unknown || unknown_empty != units.Unknown { try report("unknown", 0usize) }
    let (_, value_nan) = units.convert(&reg, nan, "m", "ft")
    let (_, value_inf) = units.convert(&reg, inf, "m", "ft")
    let (_, value_overflow) = units.convert(&reg, 1.0e308f64, "PB", "bit")
    let (_, value_overflow_c) = units.convert(&reg, 1.7e308f64, "Re", "K")
    if value_nan != units.Invalid || value_inf != units.Invalid || value_overflow != units.Invalid || value_overflow_c != units.Invalid { try report("non-finite", 0usize) }
    var tiny: [78]units.Unit = zero
    let (_, tiny_error) = units.registry(tiny[..])
    if tiny_error != units.TooSmall { try report("registry-room", 0usize) }
    var snug: [80]units.Unit = zero
    let (snug_made, snug_error) = units.registry(snug[..])
    var snug_reg = snug_made
    let snug_one = units.register(&snug_reg, units.Unit { symbol: "a1", name: "x", family: 9u32, scale: 2.0f64, offset: 0.0f64 })
    let snug_two = units.register(&snug_reg, units.Unit { symbol: "a2", name: "x", family: 9u32, scale: 3.0f64, offset: 0.0f64 })
    if snug_error != ok || snug_one != ok || snug_two != units.TooSmall || snug_reg.count != 80usize { try report("register-room", 0usize) }
    let (a1_a1, a1_error) = units.convert(&snug_reg, 6.0f64, "a1", "a1")
    if a1_error != ok || a1_a1 != 6.0f64 { try report("custom-same", 0usize) }
    try io.print("math units ok\n")
    ret ok
}
