// `e.ml.linear` regularized and robust regression against scikit-learn and statsmodels (scripts/gen_linear_test.py): elastic net,
// polynomial features, quantile regression (the HiGHS LP optimum) and Huber M-estimation.
use e.io
use e.mem
use e.ml.linear as linear
use e.os
use e.str

fn near(x: f64, want: f64, eps: f64) -> bool {
    if x != x || want != want { ret x != x && want != want }
    var d = x - want
    if d < 0.0f64 { d = 0.0f64 - d }
    var scale = want
    if scale < 0.0f64 { scale = 0.0f64 - scale }
    if scale < 1.0f64 { scale = 1.0f64 }
    ret d <= eps * scale
}

// Parses a field of space-separated numbers into `out` and answers how many.
fn nums(field: str, out: []f64) -> usize {
    var count = 0usize
    let (it0, e0) = str.split(str.trim(field), " ")
    if e0 != ok { ret 0usize }
    var it = it0
    while true {
        let (piece, more) = str.split_next(&it)
        if !more { break }
        if piece.len == 0usize { continue }
        let (v, pe) = str.parse_f64(piece)
        if pe != ok { os.exit(97i32) }
        if count < out.len {
            out[count] = v
            count += 1usize
        }
    }
    ret count
}

fn load(field: str, out: []f64) {
    let loaded = nums(field, out)
}

fn run_chunk(block: str) -> u32 {
    let (lines0, le) = str.split(block, "\n")
    if le != ok { ret 99u32 }
    var lines = lines0
    var failed = 0u32
    while true {
        let (line, more) = str.split_next(&lines)
        if !more { break }
        if line.len == 0usize { continue }
        let (parts0, pe) = str.split(line, "|")
        if pe != ok { ret 98u32 }
        var parts = parts0
        var fields: [8]str = zero
        var nf = 0usize
        while nf < 8usize {
            let (piece, got) = str.split_next(&parts)
            if !got { break }
            fields[nf] = piece
            nf += 1usize
        }
        if !check(fields[..], nf) {
            let shown = io.print(line)
            let nl = io.print("\n")
            failed += 1u32
        }
    }
    ret failed
}

fn check(f: []str, nf: usize) -> bool {
    let op = f[0usize]
    var head: [8]f64 = zero
    var x: [640]f64 = zero
    var y: [160]f64 = zero
    var want: [640]f64 = zero
    var got: [640]f64 = zero
    var scratch: [4000]f64 = zero
    load(f[1usize], head[..])
    let n = usize(head[0usize])
    let d = usize(head[1usize])
    let k = d + 1usize
    if str.eq(op, "poly") {
        let nx = nums(f[2usize], x[..])
        let nw = nums(f[3usize], want[..])
        let (width, e) = linear.polynomial_features(x[..nx], n, d, usize(head[2usize]), head[3usize] != 0.0f64, head[4usize] != 0.0f64, got[..])
        if e != ok || width != usize(head[5usize]) || nw != n * width { ret false }
        if linear.polynomial_width(d, usize(head[2usize]), head[3usize] != 0.0f64, head[4usize] != 0.0f64) != width { ret false }
        var i = 0usize
        while i < nw {
            if !near(got[i], want[i], 0.000000000001f64) { ret false }
            i += 1usize
        }
        ret true
    }
    let nx = nums(f[2usize], x[..])
    let ny = nums(f[3usize], y[..])
    load(f[4usize], want[..])
    if nx != n * d || ny != n { ret false }
    var i = 0usize
    if str.eq(op, "enet") {
        if linear.elastic_net(x[..nx], y[..ny], n, d, head[2usize], head[3usize], 0.0000000000001f64, 1000000u32, got[..], scratch[..]) != ok { ret false }
        while i < k {
            if !near(got[i], want[i], 0.000001f64) { ret false }
            i += 1usize
        }
        ret true
    }
    if str.eq(op, "qr") {
        let (iterations, e) = linear.quantile_regression(x[..nx], y[..ny], n, d, head[2usize], 0.000000001f64, 500u32, got[..], scratch[..])
        if e != ok { ret false }
        let have = linear.pinball_loss(x[..nx], y[..ny], n, d, head[2usize], got[..k])
        let best = linear.pinball_loss(x[..nx], y[..ny], n, d, head[2usize], want[..k])
        if !near(have, best, 0.000000001f64) { ret false }
        while i < k {
            if !near(got[i], want[i], 0.000001f64) { ret false }
            i += 1usize
        }
        ret true
    }
    if str.eq(op, "hub") {
        let (iterations, e) = linear.huber(x[..nx], y[..ny], n, d, head[2usize], 0.00000000001f64, 1000u32, got[..], scratch[..])
        if e != ok { ret false }
        while i < k {
            if !near(got[i], want[i], 0.000001f64) { ret false }
            i += 1usize
        }
        ret true
    }
    ret false
}

