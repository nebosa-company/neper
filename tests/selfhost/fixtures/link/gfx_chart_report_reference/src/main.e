fn abs64(v: f64) -> f64 {
    if v < 0.0f64 { ret 0.0f64 - v }
    ret v
}

fn close(got: f64, want: f64) -> bool {
    ret abs64(got - want) <= 0.0005f64 * (1.0f64 + abs64(want))
}

fn closef(got: f32, want: f64) -> bool { ret close(f64(got), want) }

