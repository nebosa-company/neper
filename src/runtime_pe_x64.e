    if index == 11usize { ret "ReadFile" }
    if index == 12usize { ret "CloseHandle" }
    if index == 13usize { ret "SetFilePointerEx" }
    if index == 14usize { ret "GetSystemTimeAsFileTime" }
    if index == 15usize { ret "QueryPerformanceCounter" }
    if index == 16usize { ret "QueryPerformanceFrequency" }
    if index == 17usize { ret "MultiByteToWideChar" }
    if index == 18usize { ret "CreateFileW" }
    if index == 19usize { ret "FindFirstFileW" }
    if index == 20usize { ret "FindNextFileW" }
    if index == 21usize { ret "FindClose" }
    if index == 22usize { ret "CreateThread" }
    if index == 23usize { ret "WaitForSingleObject" }
    if index == 24usize { ret "CreateMutexW" }
    if index == 25usize { ret "SetHandleInformation" }
