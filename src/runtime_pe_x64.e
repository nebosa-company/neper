    if index == 13usize { ret "MultiByteToWideChar" }
    if index == 14usize { ret "CreateFileW" }
    if index == 15usize { ret "FindFirstFileW" }
    if index == 16usize { ret "FindNextFileW" }
    if index == 17usize { ret "FindClose" }
    if index == 18usize { ret "CreateThread" }
    if index == 19usize { ret "WaitForSingleObject" }
    if index == 20usize { ret "SetHandleInformation" }
    if index == 21usize { ret "CreateProcessW" }
    if index == 22usize { ret "GetExitCodeProcess" }
    if index == 23usize { ret "GetModuleHandleW" }
    if index == 24usize { ret "GetProcAddress" }
    ret ""
}

// How many imports the first `limit` bytes of the runtime reach.
fn imports_within(limit: usize) -> usize {
    if 5815usize < limit { ret 25usize }
    if 5798usize < limit { ret 24usize }
    if 5726usize < limit { ret 23usize }
    if 5390usize < limit { ret 22usize }
    if 5184usize < limit { ret 21usize }
    if 4501usize < limit { ret 20usize }
    if 4432usize < limit { ret 19usize }
    if 3473usize < limit { ret 18usize }
    if 3445usize < limit { ret 17usize }
    if 3381usize < limit { ret 16usize }
    if 3183usize < limit { ret 15usize }
    if 2946usize < limit { ret 14usize }
    if 2541usize < limit { ret 13usize }
    if 2526usize < limit { ret 12usize }
    if 2486usize < limit { ret 11usize }
    if 2297usize < limit { ret 10usize }
    if 2233usize < limit { ret 9usize }
    if 2174usize < limit { ret 8usize }
    if 1448usize < limit { ret 7usize }
    if 1430usize < limit { ret 6usize }
    if 1327usize < limit { ret 5usize }
    if 798usize < limit { ret 4usize }
    if 494usize < limit { ret 3usize }
    if 133usize < limit { ret 2usize }
    if 36usize < limit { ret 1usize }
    ret 0usize
}

fn patch_import(output: *emit_x64.Buffer, runtime_file: usize, runtime_rva: usize, displacement_at: usize, iat_rva: usize, import_index: usize) -> err {
    let next_rva = runtime_rva + displacement_at + 4usize
    let target_rva = iat_rva + import_index * 8usize
    if target_rva < next_rva { ret InvalidRuntime }
    ret emit_x64.patch_little_u32(output, runtime_file + displacement_at, target_rva - next_rva)
}

