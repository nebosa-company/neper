    if 512usize < limit { try emit_x64.patch_relative32(output, runtime_file + 512usize, main_file) }
    if 526usize < limit { try patch_import(output, runtime_file, runtime_rva, 526usize, iat_rva, 3usize) }
    if 537usize < limit { try patch_import(output, runtime_file, runtime_rva, 537usize, iat_rva, 3usize) }
