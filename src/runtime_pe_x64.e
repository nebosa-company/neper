// The KERNEL32 imports, in the order the runtime first reaches them: the linker lays the
// import tables out from this list, and a runtime cut at `limit` needs only a prefix of it.
fn import_count() -> usize { ret 31usize }

fn import_name(index: usize) -> str {
    if index == 0usize { ret "VirtualAlloc" }
    if index == 1usize { ret "AddVectoredExceptionHandler" }
    if index == 2usize { ret "ExitProcess" }
    if index == 3usize { ret "GetStdHandle" }
    if index == 4usize { ret "WriteFile" }
