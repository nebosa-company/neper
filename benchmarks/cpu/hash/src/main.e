// H25's CPU program workload (D943): 64 MB of generated bytes hashed with 32-bit FNV-1a
// four times over, each pass seeded by the last; prints the final hash.
use e.mem
use e.io
use e.str

fn main(a: *mem.Arena, args: []str) -> err {
    let size = 67108864usize
    let (bytes, bytes_error) = mem.alloc[u8](a, size)
    if bytes_error != ok { ret bytes_error }
    var state = 7u64
    var at = 0usize
    while at < bytes.len {
        state = (state * 1103515245u64 + 12345u64) & 2147483647u64
        bytes[at] = u8((state >> 16u64) & 255u64)
        at += 1usize
    }
    var hash = 2166136261u64
    var pass = 0usize
    while pass < 4usize {
        at = 0usize
        while at < bytes.len {
            hash = ((hash ^ u64(bytes[at])) * 16777619u64) & 4294967295u64
            at += 1usize
        }
        pass += 1usize
    }
    let (b0, b0_error) = str.builder(a, 64usize)
    if b0_error != ok { ret b0_error }
    var b = b0
    try str.push_i64(&b, i64(hash))
    try str.push(&b, "\n")
    try io.print(str.done(&b))
    ret ok
}
