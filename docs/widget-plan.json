          ],
          "delivered": [
            "TypedAction",
            "ActionGestureRegion",
            "GestureArena"
          ],
          "evidence": "lib/e/ui/widget.e (D806): Change[T] and Submit with fire_change/fire_submit as no-ops when unset; Region with a gesture mask and GestureAction; the runtime arena settling tap, drag start/move/end and hover enter/leave from raw pointer events with an 8 px slop; tests/selfhost/fixtures/link/ui_gesture on both hosts"
        },
