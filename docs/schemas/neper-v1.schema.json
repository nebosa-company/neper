    "modulePlan": {
      "type":"object","required":["schema","version","status","qualifier_policy","api_catalog","tiers","layers","modules","packages"],
      "properties":{
        "schema":{"const":"neper-module-plan"},"version":{"const":1},
        "status":{"const":"design"},"qualifier_policy":{"const":"last-segment-or-explicit-alias"},
