    "result": {
      "type":"object","additionalProperties":false,"required":["record","ok","exit_code","data"],
      "properties":{"record":{"const":"result"},"ok":{"type":"boolean"},"exit_code":{"enum":[0,1,2,3]},"data":{"type":"object","additionalProperties":{"type":["string","number","integer","boolean","null"]}}}
    },
    "info": {
      "type":"object","additionalProperties":false,"required":["record","tool_version","language_profiles","commands","host_target","build_targets","cpu_levels","features"],
      "properties":{"record":{"const":"info"},"tool_version":{"type":"string"},"language_profiles":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["language_version","grammar_revision","stream_version","experimental"],"properties":{"language_version":{"type":"string"},"grammar_revision":{"type":"integer","minimum":1},"stream_version":{"type":"integer","minimum":1},"experimental":{"type":"boolean"}}}},"commands":{"type":"array","items":{"type":"string"}},"host_target":{"type":"string"},"build_targets":{"type":"array","items":{"type":"string"}},"cpu_levels":{"type":"array","items":{"type":"string"}},"features":{"type":"array","items":{"type":"string"}}}
    },
    "impact": {
      "type":"object","additionalProperties":false,
      "required":["record","test","affected","span"],
