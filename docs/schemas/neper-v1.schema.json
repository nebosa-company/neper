    },
    "sourceMap": {
      "type":"object","required":["schema","version","generated","generated_sha256","mappings"],
      "properties":{
        "schema":{"const":"neper-source-map"},"version":{"enum":[1,2]},
        "generated":{"$ref":"#/$defs/source"},"generated_sha256":{"$ref":"#/$defs/sha256"},
        "generator":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string"},"input":{"type":"string"},"input_sha256":{"$ref":"#/$defs/sha256"},"inputs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string"},"sha256":{"$ref":"#/$defs/sha256"}}}}}},
        "mappings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["generated_span","original_span","name"],"properties":{"generated_span":{"$ref":"#/$defs/span"},"original_span":{"$ref":"#/$defs/span"},"name":{"type":["string","null"]},"edit":{"enum":["direct","generator","unknown"]}}}}
      },
      "additionalProperties":false
    },
    "buildManifest": {
      "type":"object","required":["schema","version","tool_version","language_version","grammar_revision","target","mode","root_module","inputs","dependencies","libraries","assets","artifacts","unsafe","incremental","options","work"],
      "properties":{
        "schema":{"const":"neper-build-manifest"},"version":{"const":1},
        "tool_version":{"type":"string"},"language_version":{"type":"string"},
        "grammar_revision":{"type":"integer","minimum":1},"target":{"type":"string"},
        "mode":{"enum":["debug","release"]},"root_module":{"type":["string","null"]},
        "inputs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["source","sha256"],"properties":{"source":{"$ref":"#/$defs/source"},"sha256":{"$ref":"#/$defs/sha256"},"kind":{"enum":["source-map"]}}}},
        "dependencies":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["module","interface_sha256","body_sha256"],"properties":{"module":{"type":"string"},"interface_sha256":{"$ref":"#/$defs/sha256"},"body_sha256":{"$ref":"#/$defs/sha256"}}}},
        "libraries":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["requested","search_roots","resolved","sha256"],"properties":{"requested":{"type":"string"},"search_roots":{"type":"array","items":{"type":"string"}},"resolved":{"oneOf":[{"$ref":"#/$defs/source"},{"type":"string"}]},"sha256":{"$ref":"#/$defs/sha256"}}}},
        "assets":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","source","media_type","attributes","size","sha256"],"properties":{"name":{"type":"string"},"source":{"$ref":"#/$defs/source"},"media_type":{"type":"string"},"attributes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","value"],"properties":{"name":{"type":"string"},"value":{"type":"string"}}}},"size":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha256"}}}},
        "artifacts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","kind","target","sha256"],"properties":{"path":{"type":"string"},"kind":{"type":"string"},"target":{"type":"string"},"sha256":{"$ref":"#/$defs/sha256"}}}},
        "unsafe":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["kind","provenance","module","function","line"],"properties":{"kind":{"enum":["unsafe","nocheck","extern","cast","bitcast","union"]},"provenance":{"enum":["declared","trusted"]},"module":{"type":"string"},"function":{"type":"string"},"line":{"type":"integer","minimum":0}}}},
        "incremental":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["module","decision","reason"],"properties":{"module":{"type":"string"},"decision":{"enum":["kept","rebuilt"]},"reason":{"enum":["no-artifact","invalid-artifact","source-changed","mode-changed","compiler-changed","options-changed","stable","edges-hold","edge-changed"]}}}},
        "options":{"type":"object","required":["checks"],"properties":{"checks":{"enum":["retained","off"]}}},
        "work":{"type":"object","additionalProperties":false,"required":["bodies_checked","modules_lowered","functions_lowered","declarations_checked"],"properties":{"bodies_checked":{"type":"integer","minimum":0},"modules_lowered":{"type":"integer","minimum":0},"functions_lowered":{"type":"integer","minimum":0},"declarations_checked":{"type":"integer","minimum":0}}}
      },
      "additionalProperties":false
