    "run": {
      "type":"object","additionalProperties":false,"required":["record","process_exit_code","stdout","stderr","trap"],
      "properties":{"record":{"const":"run"},"process_exit_code":{"type":"integer"},"stdout":{"$ref":"#/$defs/captured"},"stderr":{"$ref":"#/$defs/captured"},"trap":{"oneOf":[{"$ref":"#/$defs/trapPayload"},{"type":"null"}]}}
    },
    "disassembly": {
