    "root": {
      "type":"object","additionalProperties":false,
      "required":["record","kind","value"],
      "properties":{"record":{"const":"root"},"kind":{"enum":["entry","test","export"]},"value":{"type":"string"}}
    },
    "precondition": {
      "type":"object","additionalProperties":false,
      "required":["record","source","sha256"],
      "properties":{"record":{"const":"precondition"},"source":{"$ref":"#/$defs/source"},"sha256":{"$ref":"#/$defs/sha256"}}
    },
    "planEdit": {
