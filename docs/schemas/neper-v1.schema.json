    "instance": {
      "type":"object","additionalProperties":false,
      "required":["record","template","arguments","span"],
      "properties":{
        "record":{"const":"instance"},"template":{"type":"string"},
        "arguments":{"type":"array","items":{"type":"string"}},
        "span":{"$ref":"#/$defs/span"}
