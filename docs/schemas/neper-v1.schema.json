      "properties":{"record":{"const":"test"},"name":{"type":"string"},"module":{"type":"string"},"file":{"$ref":"#/$defs/source"},"line":{"type":"integer","minimum":1},"outcome":{"enum":["passed","failed","crashed","timeout"]},"error":{"type":["string","null"]},"message":{"type":["string","null"]},"duration_ms":{"type":"integer","minimum":0},"timeout_s":{"type":"number","exclusiveMinimum":0},"stdout":{"$ref":"#/$defs/captured"},"stderr":{"$ref":"#/$defs/captured"},"trap":{"oneOf":[{"$ref":"#/$defs/trapPayload"},{"type":"null"}]}}
    },
    "captured": {
      "oneOf":[{"type":"string"},{"type":"object","additionalProperties":false,"required":["encoding","data"],"properties":{"encoding":{"const":"base64"},"data":{"type":"string","contentEncoding":"base64","pattern":"^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}}}]
