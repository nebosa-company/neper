    "header": {
      "type":"object","additionalProperties":false,
      "required":["schema","version","record","command","tool_version","language_version","grammar_revision"],
      "properties":{
        "schema":{"const":"neper-stream"},"version":{"const":1},"record":{"const":"header"},
        "command":{"enum":["plan-add-parameter","plan-replace-expression","plan-change-signature","test-impact","build","check","run","test","fmt","tokens","parse","index","dis","info","explain","context","uses","plan-rename"]},"tool_version":{"type":"string"},
        "language_version":{"type":"string"},"grammar_revision":{"type":"integer","minimum":1}
      }
    },
    "diagnostic": {
      "type":"object","additionalProperties":false,
      "required":["record","severity","code","message","span","related","fixes","parent"],
      "properties":{
        "record":{"const":"diagnostic"},"severity":{"enum":["error","note"]},
        "code":{"type":"string","pattern":"^E-[A-Z]+-[0-9]{4}$"},"message":{"type":"string"},
        "expected":{"type":"string"},"actual":{"type":"string"},
        "span":{"oneOf":[{"$ref":"#/$defs/span"},{"type":"null"}]},
        "related":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["message","span"],"properties":{"message":{"type":"string"},"span":{"$ref":"#/$defs/span"}}}},
        "fixes":{"type":"array","items":{"$ref":"#/$defs/fix"}},
        "parent":{"type":["integer","null"],"minimum":0}
      }
    },
    "token": {
      "type":"object","additionalProperties":false,
      "required":["record","index","kind","lexeme","span","leading_trivia"],
      "properties":{
        "record":{"const":"token"},"index":{"type":"integer","minimum":0},
        "kind":{"$ref":"#/$defs/tokenKind"},"lexeme":{"$ref":"#/$defs/captured"},"span":{"$ref":"#/$defs/span"},
        "leading_trivia":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["kind","text","span"],"properties":{"kind":{"enum":["space","comment","bom"]},"text":{"type":"string"},"span":{"$ref":"#/$defs/span"}}}}
      }
    },
    "syntaxChild": {
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["token"],"properties":{"token":{"type":"integer","minimum":0}}},
        {"type":"object","additionalProperties":false,"required":["node"],"properties":{"node":{"$ref":"#/$defs/syntaxNode"}}}
      ]
