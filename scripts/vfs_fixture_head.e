// e.fs.vfs (L119, D2522). Four traces of random write, mkdir, remove, read, stat and list steps,
// recorded against a real directory by scripts/vfs_vectors.py (the oracle is the host's own
// filesystem), are replayed on Mem, on Sub over Mem with a prefix, on Overlay over an empty
// lower, and on Host over a real directory through e.fs; path cleaning is checked against
// posixpath.normpath. Hand-written scenarios then pin copy-up, whiteouts, opaque directories,
// union priority, read-only refusal and the isolation of Sub and Host, and a deterministic
// differential run requires an Overlay over a random lower to answer every operation, error
// for error, as a plain Mem that started as a copy of that lower, leaving the lower untouched.
// Generated by scripts/vfs_vectors.py; a failure prints which check and exits non-zero.
use e.io
use e.mem
use e.os
use e.fs
use e.fs.vfs as vfs

fn same(x: []const u8, y: []const u8) -> bool {
    if x.len != y.len { ret false }
    var i = 0usize
    while i < x.len {
        if x[i] != y[i] { ret false }
        i += 1usize
    }
    ret true
}

fn report(label: str, number: i32) {
    let _ = io.print("fs vfs: ")
    let _ = io.print(label)
    let _ = io.print(" failed at ")
    var digits: [5]u8 = zero
    digits[0] = u8(48i32 + (number / 10000i32) % 10i32)
    digits[1] = u8(48i32 + (number / 1000i32) % 10i32)
    digits[2] = u8(48i32 + (number / 100i32) % 10i32)
    digits[3] = u8(48i32 + (number / 10i32) % 10i32)
    digits[4] = u8(48i32 + number % 10i32)
    let _ = io.print(digits[0..])
    let _ = io.print("\n")
}

// One recorded step: op 0 write, 1 mkdir, 2 remove, 3 read, 4 stat, 5 list.
fn step(a: *mem.Arena, v: *vfs.Vfs, op: u8, path: str, data: str, want_ok: bool, want: str, want_size: usize) -> bool {
    if op == 0u8 { ret (vfs.write_file(a, v, path, data) == ok) == want_ok }
    if op == 1u8 { ret (vfs.make_dir(a, v, path) == ok) == want_ok }
    if op == 2u8 { ret (vfs.remove(a, v, path) == ok) == want_ok }
    if op == 3u8 {
        let (bytes, failure) = vfs.read_file(a, v, path, 1048576usize)
        if (failure == ok) != want_ok { ret false }
        if !want_ok { ret true }
        ret same(bytes, want)
    }
    if op == 4u8 {
        let (entry, failure) = vfs.stat(a, v, path)
        if (failure == ok) != want_ok { ret false }
        if !want_ok { ret true }
        if entry.kind == .Directory { ret same("D", want) }
        ret same("F", want) && entry.size == u64(want_size)
    }
    let (entries, failure) = vfs.list(a, v, path)
    if (failure == ok) != want_ok { ret false }
    if !want_ok { ret true }
    var text: [1024]u8 = zero
    var n = 0usize
    var i = 0usize
    while i < entries.len {
        if i > 0usize {
            text[n] = 44u8
            n += 1usize
        }
        let name = vfs.base_of(entries[i].path)
        var k = 0usize
        while k < name.len {
            text[n] = name[k]
            n += 1usize
            k += 1usize
        }
        text[n] = 58u8
        text[n + 1usize] = 70u8
        if entries[i].kind == .Directory { text[n + 1usize] = 68u8 }
        n += 2usize
        i += 1usize
    }
    ret same(text[..n], want)
}

fn clean_is(a: *mem.Arena, source: str, want: str) -> bool {
    let (p, failure) = vfs.clean(a, source)
    ret failure == ok && same(p, want)
}

fn clean_invalid(a: *mem.Arena, source: str) -> bool {
    let (_, failure) = vfs.clean(a, source)
    ret failure == fs.Invalid
}

