// e.fmt.sevenzip and e.fmt.rar (L120, D2523): archives written by py7zr and by a small Python
// writer (7z) and by a RAR5 encoder checked with bsdtar (RAR) are listed and extracted, and every
// expected size and CRC-32 comes from the data the writer was given. Hostile headers (counts and
// sizes past the data, unsafe names, a wrong size for a coder, a flipped byte under a CRC) must be
// refused before their declared sizes are allocated; every truncation and every one-byte change of
// two small archives must end in an error or in data that still matches its CRC.
// Generated by scripts/archive_vectors.py; every check has its own exit code.
use e.algo.hash as hash
use e.io
use e.mem
use e.os
use e.fmt.sevenzip as sevenzip
use e.fmt.rar as rar

fn same(x: []const u8, y: []const u8) -> bool {
    if x.len != y.len { ret false }
    var i = 0usize
    while i < x.len {
        if x[i] != y[i] { ret false }
        i += 1usize
    }
    ret true
}

fn le32(text: str) -> u32 {
    ret u32(text[0]) | (u32(text[1]) << 8u32) | (u32(text[2]) << 16u32) | (u32(text[3]) << 24u32)
}

fn die(number: i32) {
    let _ = io.print("fmt archive: check ")
    var digits: [4]u8 = zero
    digits[0] = u8(48i32 + (number / 1000i32) % 10i32)
    digits[1] = u8(48i32 + (number / 100i32) % 10i32)
    digits[2] = u8(48i32 + (number / 10i32) % 10i32)
    digits[3] = u8(48i32 + number % 10i32)
    let _ = io.print(digits[0..])
    let _ = io.print(" failed\n")
    os.exit(1i32)
}

fn kind_checksum() -> err { ret sevenzip.Checksum }

fn kind_toolarge() -> err { ret sevenzip.TooLarge }

fn kind_unsafe() -> err { ret sevenzip.Unsafe }

fn kind_invalid() -> err { ret sevenzip.Invalid }

// ---- 7z --------------------------------------------------------------------------------

fn open_ok(a: *mem.Arena, blob: str) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = sevenzip.open(a, blob, sevenzip.default_limits())
    let good = failure == ok
    mem.reset(a, m)
    ret good
}

fn entry_is(a: *mem.Arena, blob: str, index: u32, name: str, size: usize, crc: u32, directory: bool) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = sevenzip.open(a, blob, sevenzip.default_limits())
    if failure != ok { ret false }
    let listed = sevenzip.entries(&archive)
    if usize(index) >= listed.len { ret false }
    let e = listed[usize(index)]
    var good = same(e.name, name) && e.directory == directory && e.size == u64(size)
    if !directory && size > 0usize { good = good && e.has_crc && e.crc32 == crc }
    mem.reset(a, m)
    ret good
}

fn extract_is(a: *mem.Arena, blob: str, index: u32, crc: u32, size: usize) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = sevenzip.open(a, blob, sevenzip.default_limits())
    if failure != ok { ret false }
    var ar = archive
    let (data, extract_error) = sevenzip.extract(a, &ar, usize(index))
    var good = extract_error == ok && data.len == size
    if good && size > 0usize { good = hash.crc32(data) == crc }
    mem.reset(a, m)
    ret good
}

fn refused(a: *mem.Arena, blob: str) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = sevenzip.open(a, blob, sevenzip.default_limits())
    mem.reset(a, m)
    ret failure != ok
}

fn refused_with(a: *mem.Arena, blob: str, want: err) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = sevenzip.open(a, blob, sevenzip.default_limits())
    mem.reset(a, m)
    ret failure == want
}

fn extract_fails(a: *mem.Arena, blob: str) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = sevenzip.open(a, blob, sevenzip.default_limits())
    if failure != ok { ret false }
    var ar = archive
    let (_, extract_error) = sevenzip.extract(a, &ar, 0usize)
    mem.reset(a, m)
    ret extract_error != ok
}

fn extract_fails_with(a: *mem.Arena, blob: str, want: err) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = sevenzip.open(a, blob, sevenzip.default_limits())
    if failure != ok { ret false }
    var ar = archive
    let (_, extract_error) = sevenzip.extract(a, &ar, 0usize)
    mem.reset(a, m)
    ret extract_error == want
}

// Opens and extracts the first file of `text`; true unless it yields data that is not
// `want_crc`'s.
fn outcome_sound(a: *mem.Arena, text: []const u8, want_crc: u32) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = sevenzip.open(a, text, sevenzip.default_limits())
    if failure != ok {
        mem.reset(a, m)
        ret true
    }
    var ar = archive
    let listed = sevenzip.entries(&ar)
    var i = 0usize
    var good = true
    while i < listed.len {
        if !listed[i].directory {
            let (data, extract_error) = sevenzip.extract(a, &ar, i)
            if extract_error == ok && i == 0usize && data.len > 0usize && hash.crc32(data) != want_crc { good = false }
        }
        i += 1usize
    }
    mem.reset(a, m)
    ret good
}

fn never_wrong(a: *mem.Arena, blob: str, crc_text: str) -> bool {
    let want = le32(crc_text)
    var buf: [2048]u8 = zero
    if blob.len > buf.len { ret false }
    var n = 0usize
    while n < blob.len {
        buf[n] = blob[n]
        n += 1usize
    }
    var cut = 0usize
    while cut < blob.len {
        if !outcome_sound(a, buf[..cut], want) { ret false }
        cut += 1usize
    }
    var pos = 0usize
    while pos < blob.len {
        var mask = 1u8
        while mask != 0u8 {
            buf[pos] = blob[pos] ^ mask
            if !outcome_sound(a, buf[..blob.len], want) { ret false }
            mask = mask << 1u32
        }
        buf[pos] = blob[pos]
        pos += 1usize
    }
    ret true
}


// ---- RAR5 ------------------------------------------------------------------------------

fn rar_kind_checksum() -> err { ret rar.Checksum }

fn rar_kind_unsupported() -> err { ret rar.Unsupported }

fn rar_kind_unsafe() -> err { ret rar.Unsafe }

fn rar_kind_toolarge() -> err { ret rar.TooLarge }

fn rar_open_ok(a: *mem.Arena, blob: str) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = rar.open(a, blob, rar.default_limits())
    mem.reset(a, m)
    ret failure == ok
}

fn rar_entry_is(a: *mem.Arena, blob: str, index: u32, name: str, size: usize, directory: bool) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = rar.open(a, blob, rar.default_limits())
    if failure != ok { ret false }
    let listed = rar.entries(&archive)
    if usize(index) >= listed.len { ret false }
    let e = listed[usize(index)]
    let good = same(e.name, name) && e.directory == directory && e.size == u64(size)
    mem.reset(a, m)
    ret good
}

fn rar_extract_is(a: *mem.Arena, blob: str, index: u32, crc: u32, size: usize) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = rar.open(a, blob, rar.default_limits())
    if failure != ok { ret false }
    var ar = archive
    let (data, extract_error) = rar.extract(a, &ar, usize(index))
    var good = extract_error == ok && data.len == size
    if good && size > 0usize { good = hash.crc32(data) == crc }
    mem.reset(a, m)
    ret good
}

fn rar_refused_with(a: *mem.Arena, blob: str, want: err) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = rar.open(a, blob, rar.default_limits())
    mem.reset(a, m)
    ret failure == want
}

fn rar_extract_fails_with(a: *mem.Arena, blob: str, index: u32, want: err) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = rar.open(a, blob, rar.default_limits())
    if failure != ok { ret false }
    var ar = archive
    let (_, extract_error) = rar.extract(a, &ar, usize(index))
    mem.reset(a, m)
    ret extract_error == want
}

fn rar_outcome_sound(a: *mem.Arena, text: []const u8, want_crc: u32) -> bool {
    let m = mem.mark(a)
    let (archive, failure) = rar.open(a, text, rar.default_limits())
    if failure != ok {
        mem.reset(a, m)
        ret true
    }
    var ar = archive
    let listed = rar.entries(&ar)
    var i = 0usize
    var good = true
    while i < listed.len {
        if !listed[i].directory {
            let (data, extract_error) = rar.extract(a, &ar, i)
            if extract_error == ok && i == 0usize && data.len > 0usize && hash.crc32(data) != want_crc { good = false }
        }
        i += 1usize
    }
    mem.reset(a, m)
    ret good
}

fn rar_never_wrong(a: *mem.Arena, blob: str, crc_text: str) -> bool {
    let want = le32(crc_text)
    var buf: [4096]u8 = zero
    if blob.len > buf.len { ret false }
    var n = 0usize
    while n < blob.len {
        buf[n] = blob[n]
        n += 1usize
    }
    var cut = 0usize
    while cut < blob.len {
        if !rar_outcome_sound(a, buf[..cut], want) { ret false }
        cut += 1usize
    }
    var pos = 0usize
    while pos < blob.len {
        var mask = 1u8
        while mask != 0u8 {
            buf[pos] = blob[pos] ^ mask
            if !rar_outcome_sound(a, buf[..blob.len], want) { ret false }
            mask = mask << 1u32
        }
        buf[pos] = blob[pos]
        pos += 1usize
    }
    ret true
}

