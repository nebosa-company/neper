// `e.crypto.kdf`'s Argon2d/i/id, PHC strings and bcrypt/scrypt verification against
// argon2-cffi, hashlib.scrypt and the bcrypt package (L117, D2520). Generated by
// scripts/kdf_phc_vectors.py; every check has its own exit code.
use e.io
use e.os
use e.mem
use e.crypto.kdf as kdf

fn same(a: []const u8, b: []const u8) -> bool {
    if a.len != b.len { ret false }
    var i = 0usize
    while i < a.len {
        if a[i] != b[i] { ret false }
        i += 1usize
    }
    ret true
}

fn argon_ok(pw: str, phc: str, memory: []u8) -> bool {
    let (matched, failure) = kdf.argon2_verify(pw, phc, memory)
    ret failure == ok && matched
}

fn argon_false(pw: str, phc: str, memory: []u8) -> bool {
    let (matched, failure) = kdf.argon2_verify(pw, phc, memory)
    ret failure == ok && !matched
}

fn argon_err(pw: str, phc: str, memory: []u8, want: err) -> bool {
    let (matched, failure) = kdf.argon2_verify(pw, phc, memory)
    ret failure == want && !matched
}

fn argon_roundtrip(kind: kdf.Argon2Kind, pw: str, salt: str, t: u32, m_kib: u32, p: u32, taglen: usize, expected: str, memory: []u8) -> bool {
    var tag: [64]u8 = zero
    if kdf.argon2(kind, pw, salt, t, m_kib, p, tag[..taglen], memory) != ok { ret false }
    var out: [256]u8 = zero
    let (n, failure) = kdf.argon2_encode(out[0..], kind, t, m_kib, p, salt, tag[..taglen])
    if failure != ok { ret false }
    ret same(out[..n], expected)
}

fn rfc_ok(kind: kdf.Argon2Kind, expected: str, memory: []u8) -> bool {
    var password: [32]u8 = zero
    var salt: [16]u8 = zero
    var secret: [8]u8 = zero
    var ad: [12]u8 = zero
    var tag: [32]u8 = zero
    var i = 0usize
    while i < 32usize {
        password[i] = 1u8
        i += 1usize
    }
    i = 0usize
    while i < 16usize {
        salt[i] = 2u8
        i += 1usize
    }
    i = 0usize
    while i < 8usize {
        secret[i] = 3u8
        i += 1usize
    }
    i = 0usize
    while i < 12usize {
        ad[i] = 4u8
        i += 1usize
    }
    if kdf.argon2_run(kind, 19u32, password[0..], salt[0..], secret[0..], ad[0..], 3u32, 32u32, 4u32, tag[0..], memory) != ok { ret false }
    ret same(tag[0..], expected)
}

fn argon_mutations(good: str, memory: []u8) -> bool {
    var buf: [256]u8 = zero
    var n = 0usize
    while n < good.len {
        buf[n] = good[n]
        n += 1usize
    }
    var cut = 0usize
    while cut < good.len {
        let (matched, failure) = kdf.argon2_verify("password", buf[..cut], memory)
        if matched && failure == ok { ret false }
        cut += 1usize
    }
    var pos = 0usize
    while pos < good.len {
        var mask = 1u8
        while mask <= 4u8 {
            buf[pos] = good[pos] ^ mask
            let (matched, failure) = kdf.argon2_verify("password", buf[..good.len], memory)
            if matched && failure == ok { ret false }
            mask = mask << 1u32
        }
        buf[pos] = good[pos]
        pos += 1usize
    }
    let (matched, failure) = kdf.argon2_verify("password", buf[..good.len], memory)
    ret matched && failure == ok
}

fn scrypt_ok(pw: str, phc: str, scratch: []u8) -> bool {
    let (matched, failure) = kdf.scrypt_verify(pw, phc, scratch)
    ret failure == ok && matched
}

fn scrypt_false(pw: str, phc: str, scratch: []u8) -> bool {
    let (matched, failure) = kdf.scrypt_verify(pw, phc, scratch)
    ret failure == ok && !matched
}

fn scrypt_err(pw: str, phc: str, scratch: []u8, want: err) -> bool {
    let (matched, failure) = kdf.scrypt_verify(pw, phc, scratch)
    ret failure == want && !matched
}

fn scrypt_roundtrip(n: usize, r: usize, p: usize, pw: str, salt: str, taglen: usize, expected: str, scratch: []u8) -> bool {
    var tag: [64]u8 = zero
    if kdf.scrypt(pw, salt, n, r, p, tag[..taglen], scratch) != ok { ret false }
    var out: [256]u8 = zero
    let (written, failure) = kdf.scrypt_encode(out[0..], n, r, p, salt, tag[..taglen])
    if failure != ok { ret false }
    ret same(out[..written], expected)
}

fn scrypt_mutations(good: str, scratch: []u8) -> bool {
    var buf: [256]u8 = zero
    var n = 0usize
    while n < good.len {
        buf[n] = good[n]
        n += 1usize
    }
    var cut = 0usize
    while cut < good.len {
        let (matched, failure) = kdf.scrypt_verify("password", buf[..cut], scratch)
        if matched && failure == ok { ret false }
        cut += 1usize
    }
    var pos = 0usize
    while pos < good.len {
        var mask = 1u8
        while mask <= 4u8 {
            buf[pos] = good[pos] ^ mask
            let (matched, failure) = kdf.scrypt_verify("password", buf[..good.len], scratch)
            if matched && failure == ok { ret false }
            mask = mask << 1u32
        }
        buf[pos] = good[pos]
        pos += 1usize
    }
    ret true
}

fn bcrypt_ok(pw: str, text: str) -> bool { ret kdf.bcrypt_verify(pw, text) }

fn bcrypt_false(pw: str, text: str) -> bool { ret !kdf.bcrypt_verify(pw, text) }

fn bcrypt_roundtrip(pw: str, text: str, cost: u32) -> bool {
    let (salt, salt_ok) = kdf.bcrypt_decode_salt(text[7..29])
    if !salt_ok { ret false }
    let (made, failure) = kdf.bcrypt_hash_text(pw, salt, cost)
    if failure != ok { ret false }
    ret same(made[0..], text)
}

// Every prefix and every one-bit change of the text is refused; the salt's last
// character carries four unused bits, so a change there that keeps its data bits is the
// same salt (as in OpenBSD) and is not asked about; the two cost digits are skipped
// because a one-bit change there is a legal, far more expensive cost.
fn bcrypt_mutations(good: str) -> bool {
    var buf: [60]u8 = zero
    var n = 0usize
    while n < good.len {
        buf[n] = good[n]
        n += 1usize
    }
    var cut = 0usize
    while cut < good.len {
        if kdf.bcrypt_verify("hunter2", buf[..cut]) { ret false }
        cut += 1usize
    }
    var pos = 0usize
    while pos < good.len {
        if pos != 28usize && pos != 4usize && pos != 5usize {
            var mask = 1u8
            while mask <= 4u8 {
                buf[pos] = good[pos] ^ mask
                if kdf.bcrypt_verify("hunter2", buf[..good.len]) { ret false }
                mask = mask << 1u32
            }
            buf[pos] = good[pos]
        }
        pos += 1usize
    }
    ret true
}

