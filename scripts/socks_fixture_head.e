// e.net.socks (L121, D2521): the SOCKS5 client against PySocks' own bytes. `scenario` replays
// a scripted proxy's replies into negotiate and a CONNECT over slice readers and writers and
// requires the same request bytes and the same class of outcome PySocks produced (success with
// the bound address, a refusal with its code, a failed or unsupported authentication, a
// malformed or truncated reply); the UDP checks compare the datagram header against PySocks'
// sendto and recvfrom. Five live sessions then run the client over loopback TCP and UDP against
// a SOCKS5 server thread written here: CONNECT with no authentication and with username and
// password, a refused CONNECT, a wrong password, and UDP ASSOCIATE through a relay.
// Generated by scripts/socks_vectors.py; every check has its own exit code.
use e.io
use e.mem
use e.net
use e.net.socks as socks
use e.os
use e.thread

fn same(a: []const u8, b: []const u8) -> bool {
    if a.len != b.len { ret false }
    var i = 0usize
    while i < a.len {
        if a[i] != b[i] { ret false }
        i += 1usize
    }
    ret true
}

fn address_of(ip: str) -> net.Address {
    var four: [4]u8 = zero
    var six: [16]u8 = zero
    var i = 0usize
    if ip.len == 4usize {
        while i < 4usize {
            four[i] = ip[i]
            i += 1usize
        }
        ret net.Address{ Ip4: net.Ip4{ bytes: four } }
    }
    while i < 16usize && i < ip.len {
        six[i] = ip[i]
        i += 1usize
    }
    ret net.Address{ Ip6: net.Ip6{ bytes: six, scope: 0u32 } }
}

fn kind_of(failure: err) -> u8 {
    if failure == ok { ret 0u8 }
    if failure == socks.Rejected { ret 1u8 }
    if failure == socks.AuthFailed { ret 2u8 }
    if failure == socks.Unsupported { ret 3u8 }
    if failure == socks.Protocol { ret 4u8 }
    if failure == socks.Closed { ret 5u8 }
    ret 99u8
}

fn scenario(kind: u8, user: str, password: str, host: str, port: u16, ip: str, replies: str, request: str, want: u8, code: u8, atyp: u8, bound: str, bound_port: u16) -> bool {
    var out: [1024]u8 = zero
    var written = io.SliceWriter { data: out[0..], off: 0usize }
    var scripted = io.SliceReader { data: replies, off: 0usize }
    var source = io.slice_reader(&scripted)
    var sink = io.slice_writer(&written)
    var reply: socks.Reply = zero
    var failure = socks.negotiate(&source, &sink, user, password)
    if failure == ok {
        if kind == 0u8 {
            let (r, f) = socks.connect_domain(&source, &sink, host, port)
            reply = r
            failure = f
        } else {
            let (r, f) = socks.connect_address(&source, &sink, address_of(ip), port)
            reply = r
            failure = f
        }
    }
    if kind_of(failure) != want { ret false }
    if !same(out[..written.off], request) { ret false }
    if want == 1u8 && reply.code != code { ret false }
    if want == 0u8 {
        if reply.atyp != atyp || reply.port != bound_port { ret false }
        if atyp == 3u8 { ret same(reply.name[..reply.name_len], bound) }
        var bytes: [16]u8 = zero
        let n = net.address_bytes(reply.address, bytes[0..])
        ret same(bytes[..n], bound)
    }
    ret true
}

fn udp_encode_domain_ok(host: str, port: u16, payload: str, expected: str) -> bool {
    var out: [600]u8 = zero
    let (n, failure) = socks.udp_encode_domain(out[0..], host, port, payload)
    if failure != ok { ret false }
    if !same(out[..n], expected) { ret false }
    let (d, decode_error) = socks.udp_decode(out[..n])
    if decode_error != ok || d.atyp != 3u8 || d.port != port || d.fragment != 0u8 { ret false }
    ret same(d.name[..d.name_len], host) && same(out[d.payload..n], payload)
}

fn udp_encode_ok(ip: str, port: u16, payload: str, expected: str) -> bool {
    var out: [600]u8 = zero
    let (n, failure) = socks.udp_encode(out[0..], address_of(ip), port, payload)
    if failure != ok { ret false }
    if !same(out[..n], expected) { ret false }
    let (d, decode_error) = socks.udp_decode(out[..n])
    if decode_error != ok || d.port != port { ret false }
    var bytes: [16]u8 = zero
    let count = net.address_bytes(d.address, bytes[0..])
    ret same(bytes[..count], ip) && same(out[d.payload..n], payload)
}

fn udp_decode_ok(datagram: str, ip: str, port: u16, payload: str) -> bool {
    let (d, failure) = socks.udp_decode(datagram)
    if failure != ok || d.fragment != 0u8 || d.port != port { ret false }
    var bytes: [16]u8 = zero
    let count = net.address_bytes(d.address, bytes[0..])
    if !same(bytes[..count], ip) { ret false }
    ret same(datagram[d.payload..], payload)
}

fn udp_decode_name(datagram: str, name: str, port: u16, payload: str) -> bool {
    let (d, failure) = socks.udp_decode(datagram)
    if failure != ok || d.atyp != 3u8 || d.fragment != 0u8 || d.port != port { ret false }
    ret same(d.name[..d.name_len], name) && same(datagram[d.payload..], payload)
}

// A datagram PySocks refuses: a decode error, or a fragment the caller is told of and drops.
fn udp_decode_refused(datagram: str) -> bool {
    let (d, failure) = socks.udp_decode(datagram)
    if failure != ok { ret true }
    ret d.fragment != 0u8
}

fn long_name(n: usize) -> str {
    ret "@@LONG@@"[..n]
}

// Hostile input that must be refused before a byte is written or read.
fn refusals() -> bool {
    var out: [1024]u8 = zero
    var written = io.SliceWriter { data: out[0..], off: 0usize }
    var scripted = io.SliceReader { data: "", off: 0usize }
    var source = io.slice_reader(&scripted)
    var sink = io.slice_writer(&written)
    let (r1, f1) = socks.connect_domain(&source, &sink, long_name(256usize), 80u16)
    if f1 != socks.Invalid || written.off != 0usize || r1.code != 0u8 { ret false }
    let (r2, f2) = socks.connect_domain(&source, &sink, "", 80u16)
    if f2 != socks.Invalid || written.off != 0usize || r2.code != 0u8 { ret false }
    if socks.negotiate(&source, &sink, long_name(256usize), "x") != socks.Invalid || written.off != 0usize { ret false }
    if socks.negotiate(&source, &sink, "x", long_name(256usize)) != socks.Invalid || written.off != 0usize { ret false }
    var small: [6]u8 = zero
    let (n1, e1) = socks.udp_encode_domain(small[0..], "example.com", 53u16, "x")
    if e1 != socks.TooSmall || n1 != 0usize { ret false }
    let (n2, e2) = socks.udp_encode_domain(small[0..], "", 53u16, "x")
    if e2 != socks.Invalid || n2 != 0usize { ret false }
    let (n3, e3) = socks.udp_encode(small[0..], address_of("\x01\x02\x03\x04"), 53u16, "xyz")
    if e3 != socks.TooSmall || n3 != 0usize { ret false }
    ret true
}

// ---- the live server -----------------------------------------------------------------------

type Job = struct { listener: net.Socket, mode: u8, failure: i32, seen: [1024]u8, seen_len: usize, udp_seen: [64]u8, udp_len: usize }

fn note(job: *Job, data: []const u8) {
    var i = 0usize
    while i < data.len && job.seen_len < job.seen.len {
        job.seen[job.seen_len] = data[i]
        job.seen_len += 1usize
        i += 1usize
    }
}

fn serve(job: *Job) {
    let (accepted, peer, accept_error) = net.tcp_accept(job.listener)
    if accept_error != ok {
        job.failure = 101i32
        ret
    }
    var connection = accepted
    defer let _ = net.close(connection)
    var source = net.reader(&connection)
    var sink = net.writer(&connection)
    var head: [262]u8 = zero
    if io.read_exact(&source, head[..2]) != ok {
        job.failure = 102i32
        ret
    }
    let methods = usize(head[1])
    if io.read_exact(&source, head[2..2usize + methods]) != ok {
        job.failure = 103i32
        ret
    }
    note(job, head[..2usize + methods])
    var wants_auth = false
    var m = 0usize
    while m < methods {
        if head[2usize + m] == 2u8 { wants_auth = true }
        m += 1usize
    }
    if job.mode == 1u8 || job.mode == 4u8 {
        if !wants_auth {
            job.failure = 104i32
            ret
        }
        if io.write_all(&sink, "\x05\x02") != ok {
            job.failure = 105i32
            ret
        }
        var sub: [2]u8 = zero
        if io.read_exact(&source, sub[0..]) != ok {
            job.failure = 106i32
            ret
        }
        note(job, sub[0..])
        var name: [255]u8 = zero
        if io.read_exact(&source, name[..usize(sub[1])]) != ok {
            job.failure = 107i32
            ret
        }
        note(job, name[..usize(sub[1])])
        var plen: [1]u8 = zero
        if io.read_exact(&source, plen[0..]) != ok {
            job.failure = 108i32
            ret
        }
        note(job, plen[0..])
        var word: [255]u8 = zero
        if io.read_exact(&source, word[..usize(plen[0])]) != ok {
            job.failure = 109i32
            ret
        }
        note(job, word[..usize(plen[0])])
        var verdict = "\x01\x00"
        if !same(name[..usize(sub[1])], "alice") || !same(word[..usize(plen[0])], "s3cret") { verdict = "\x01\x01" }
        if io.write_all(&sink, verdict) != ok {
            job.failure = 110i32
            ret
        }
        if job.mode == 4u8 { ret }
    } else {
        if io.write_all(&sink, "\x05\x00") != ok {
            job.failure = 111i32
            ret
        }
    }
    if io.read_exact(&source, head[..4]) != ok {
        job.failure = 112i32
        ret
    }
    note(job, head[..4])
    var rest = 6usize
    if head[3] == 4u8 { rest = 18usize }
    if head[3] == 3u8 {
        if io.read_exact(&source, head[4..5]) != ok {
            job.failure = 113i32
            ret
        }
        note(job, head[4..5])
        rest = usize(head[4]) + 2usize
        if io.read_exact(&source, head[5..5usize + rest]) != ok {
            job.failure = 114i32
            ret
        }
        note(job, head[5..5usize + rest])
    } else {
        if io.read_exact(&source, head[4..4usize + rest]) != ok {
            job.failure = 115i32
            ret
        }
        note(job, head[4..4usize + rest])
    }
    if job.mode == 2u8 {
        let _ = io.write_all(&sink, "\x05\x05\x00\x01\x00\x00\x00\x00\x00\x00")
        ret
    }
    if head[1] == 3u8 {
        let (loopback, ip_error) = net.parse_ip("127.0.0.1")
        if ip_error != ok {
            job.failure = 116i32
            ret
        }
        let (udp0, udp_error) = net.udp_bind(net.Endpoint { address: loopback, port: 0u16 })
        if udp_error != ok {
            job.failure = 117i32
            ret
        }
        var relay = udp0
        defer let _ = net.close(relay)
        let (bound, bound_error) = os.socket_local_address(relay)
        if bound_error != ok {
            job.failure = 118i32
            ret
        }
        var answer: [10]u8 = zero
        answer[0] = 5u8
        answer[3] = 1u8
        answer[4] = 127u8
        answer[7] = 1u8
        answer[8] = u8(bound.port >> 8u32)
        answer[9] = u8(bound.port & 255u16)
        if io.write_all(&sink, answer[0..]) != ok {
            job.failure = 119i32
            ret
        }
        var packet: [128]u8 = zero
        let (got, from, receive_error) = net.receive_from(relay, packet[0..])
        if receive_error != ok {
            job.failure = 120i32
            ret
        }
        let (d, decode_error) = socks.udp_decode(packet[..got])
        if decode_error != ok {
            job.failure = 121i32
            ret
        }
        var k = 0usize
        while k < got - d.payload && k < job.udp_seen.len {
            job.udp_seen[k] = packet[d.payload + k]
            k += 1usize
        }
        job.udp_len = k
        var upper: [64]u8 = zero
        k = 0usize
        while k < got - d.payload && k < 64usize {
            var ch = packet[d.payload + k]
            if ch >= 97u8 && ch <= 122u8 { ch = ch - 32u8 }
            upper[k] = ch
            k += 1usize
        }
        var reply: [128]u8 = zero
        let (n, encode_error) = socks.udp_encode(reply[0..], address_of("\x09\x09\x09\x09"), 5300u16, upper[..k])
        if encode_error != ok {
            job.failure = 122i32
            ret
        }
        let (sent, send_error) = net.send_to(relay, from, reply[..n])
        if send_error != ok || sent != n {
            job.failure = 123i32
            ret
        }
        var tail: [1]u8 = zero
        let (_, tail_error) = io.read(&source, tail[0..])
        if tail_error != ok { ret }
        ret
    }
    var answer: [10]u8 = zero
    answer[0] = 5u8
    answer[3] = 1u8
    answer[4] = 10u8
    answer[7] = 1u8
    answer[8] = 16u8
    answer[9] = 146u8
    if io.write_all(&sink, answer[0..]) != ok {
        job.failure = 124i32
        ret
    }
    var hello: [5]u8 = zero
    if io.read_exact(&source, hello[0..]) != ok {
        job.failure = 125i32
        ret
    }
    note(job, hello[0..])
    if io.write_all(&sink, "world") != ok { job.failure = 126i32 }
}

// The datagram leg: through the relay a reply names, send "ping" for a name and read back
// the upper-cased answer the server addressed from 9.9.9.9:5300.
fn udp_session(loopback: net.Address, reply: socks.Reply) -> i32 {
    if reply.code != 0u8 { ret 20i32 }
    let (relay, usable) = socks.relay_endpoint(reply, loopback)
    if !usable { ret 21i32 }
    let (udp0, udp_error) = net.udp_bind(net.Endpoint { address: loopback, port: 0u16 })
    if udp_error != ok { ret 22i32 }
    var udp = udp0
    var code = 0i32
    var packet: [128]u8 = zero
    let (n, encode_error) = socks.udp_encode_domain(packet[0..], "dns.example", 53u16, "ping")
    if encode_error != ok { code = 23i32 }
    if code == 0i32 {
        let (sent, send_error) = net.send_to(udp, relay, packet[..n])
        if send_error != ok || sent != n { code = 24i32 }
    }
    var back: [128]u8 = zero
    if code == 0i32 {
        let (got, _, receive_error) = net.receive_from(udp, back[0..])
        if receive_error != ok {
            code = 25i32
        } else {
            let (d, decode_error) = socks.udp_decode(back[..got])
            if decode_error != ok || d.port != 5300u16 || !same(back[d.payload..got], "PING") { code = 26i32 }
        }
    }
    let _ = net.close(udp)
    ret code
}

fn live(mode: u8, user: str, password: str) -> i32 {
    let (loopback, ip_error) = net.parse_ip("127.0.0.1")
    if ip_error != ok { ret 1i32 }
    let (listener, listen_error) = net.tcp_listen(net.Endpoint { address: loopback, port: 0u16 }, 1u32)
    if listen_error != ok { ret 2i32 }
    var job: Job = zero
    job.listener = listener
    defer let _ = net.close(job.listener)
    job.mode = mode
    let (bound, bound_error) = os.socket_local_address(job.listener)
    if bound_error != ok { ret 3i32 }
    let (server_thread, thread_error) = thread.spawn[Job](serve, &job, 8388608usize)
    if thread_error != ok { ret 4i32 }
    let proxy = net.Endpoint { address: loopback, port: bound.port }
    var code = 0i32
    if mode == 0u8 || mode == 1u8 {
        let (tunnel, reply, failure) = socks.dial(proxy, user, password, "example.com", 80u16)
        if failure != ok {
            code = 5i32
        } else {
            var connection = tunnel
            if reply.code != 0u8 || reply.port != 4242u16 { code = 6i32 }
            var talk: [5]u8 = zero
            let (_, send_error) = net.send(connection, "hello")
            if send_error != ok { code = 7i32 }
            var got = 0usize
            while code == 0i32 && got < 5usize {
                let (n, receive_error) = net.receive(connection, talk[got..])
                if receive_error != ok || n == 0usize { code = 8i32 } else { got += n }
            }
            if code == 0i32 && !same(talk[0..], "world") { code = 9i32 }
            let _ = net.close(connection)
        }
    } else if mode == 2u8 {
        let (_, reply, failure) = socks.dial(proxy, "", "", "example.com", 80u16)
        if failure != socks.Rejected || reply.code != 5u8 { code = 10i32 }
    } else if mode == 4u8 {
        let (_, reply, failure) = socks.dial(proxy, user, password, "example.com", 80u16)
        if failure != socks.AuthFailed { code = 11i32 }
    } else {
        let (control, reply, failure) = socks.dial_udp(proxy, "", "")
        if failure != ok {
            code = 12i32
        } else {
            code = udp_session(loopback, reply)
            let _ = net.close(control)
        }
    }
    let join_error = thread.join(server_thread)
    if code != 0i32 { ret code }
    if join_error != ok { ret 17i32 }
    if job.failure != 0i32 { ret job.failure }
    let seen = job.seen[..job.seen_len]
    if mode == 0u8 {
        if !same(seen, "\x05\x01\x00\x05\x01\x00\x03\x0bexample.com\x00\x50hello") { ret 18i32 }
    } else if mode == 1u8 {
        if !same(seen, "\x05\x02\x00\x02\x01\x05alice\x06s3cret\x05\x01\x00\x03\x0bexample.com\x00\x50hello") { ret 19i32 }
    } else if mode == 2u8 {
        if !same(seen, "\x05\x01\x00\x05\x01\x00\x03\x0bexample.com\x00\x50") { ret 20i32 }
    } else if mode == 4u8 {
        if !same(seen, "\x05\x02\x00\x02\x01\x05alice\x04nope") { ret 21i32 }
    } else {
        if !same(seen, "\x05\x01\x00\x05\x03\x00\x01\x00\x00\x00\x00\x00\x00") { ret 22i32 }
        if !same(job.udp_seen[..job.udp_len], "ping") { ret 23i32 }
    }
    ret 0i32
}

fn main(a: *mem.Arena, args: []str) -> err {
@@CHECKS@@
    if !refusals() { os.exit(200i32) }
    var code = live(0u8, "", "")
    if code != 0i32 { os.exit(code) }
    code = live(1u8, "alice", "s3cret")
    if code != 0i32 { os.exit(code) }
    code = live(2u8, "", "")
    if code != 0i32 { os.exit(code) }
    code = live(4u8, "alice", "nope")
    if code != 0i32 { os.exit(code) }
    code = live(3u8, "", "")
    if code != 0i32 { os.exit(code) }
    try io.print("net socks ok\n")
    ret ok
}
